fn read_be_u32(bytes: &[u8], at: u64) -> result: u32 reads(bytes) {
  doc "Reads the big-endian u32 that starts at index at of bytes; a byte past the end reads as zero.";
  let length = bytes^.len;
  let value = 0_u32;
  let offset = 0_u64;
  loop @be_bytes {
    let done = offset == 4_u64;
    if done {
      break @be_bytes;
    }
    let index = at +wrap offset;
    let inside = index < length;
    let byte = 0_u8;
    if inside {
      set byte = bytes^[index];
    }
    let widened = cvt::<u8, u32>(byte);
    let shifted = ishl.wrap(value, 8_u32);
    set value = ior(shifted, widened);
    set offset = offset +wrap 1_u64;
  }
  return value;
}

fn zlib_decompress(out: &[u8], stream: &[u8]) -> result: Result<u64, PngError> reads(stream), writes(out) {
  doc "Validates the RFC 1950 zlib header, inflates the DEFLATE body into out, and checks the trailing Adler-32 against the decompressed bytes.";
  let length = stream^.len;
  let enough = length >= 6_u64;
  if enough {
  } else {
    let error = PngError::Malformed();
    return Err<u64, PngError>(error: error);
  }
  let cmf = stream^[0_u64];
  let flg = stream^[1_u64];
  let cm = iand(cmf, 15_u8);
  let cm_ok = cm == 8_u8;
  let cmf_word = cvt::<u8, u32>(cmf);
  let flg_word = cvt::<u8, u32>(flg);
  let cmf_shifted = ishl.wrap(cmf_word, 8_u32);
  let combined = ior(cmf_shifted, flg_word);
  let check_value = combined % 31_u32;
  let check_ok = check_value == 0_u32;
  let fdict_bit = iand(flg, 32_u8);
  let fdict_ok = fdict_bit == 0_u8;
  let cm_and_check = band(cm_ok, check_ok);
  let header_ok = band(cm_and_check, fdict_ok);
  if header_ok {
  } else {
    let error = PngError::Malformed();
    return Err<u64, PngError>(error: error);
  }
  let body = &stream^[2_u64..length];
  let expected = out^.len;
  match inflate(out: out, input: body) {
    Ok(value: written) => {
      let complete = written == expected;
      if complete {
      } else {
        let error = PngError::Malformed();
        return Err<u64, PngError>(error: error);
      }
      let computed = adler32(data: out, start: 0_u64, end: written);
      let trailer_at = length -wrap 4_u64;
      let stored = read_be_u32(bytes: stream, at: trailer_at);
      let matches = computed == stored;
      if matches {
        return Ok<u64, PngError>(value: written);
      } else {
        let error = PngError::Malformed();
        return Err<u64, PngError>(error: error);
      }
    }
    Err(error: reason) => {
      let error = PngError::Malformed();
      return Err<u64, PngError>(error: error);
    }
  }
}
