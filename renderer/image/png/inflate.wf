const code_length_order: Array<u8, 19> =[16_u8, 17_u8, 18_u8, 0_u8, 8_u8, 7_u8, 9_u8, 6_u8, 10_u8, 5_u8, 11_u8, 4_u8, 12_u8, 3_u8, 13_u8, 2_u8, 14_u8, 1_u8, 15_u8];

fn copy_stored(reader: &BitReader, input: &[u8], end: u64, out: &[u8], written: u64) -> result: Result<u64, InflateError> reads(input), writes(reader), writes(out) contract {
  requires end <= input^.len;
  requires written <= out^.len;
  ensures when Ok(value: total): total <= out^.len;
} {
  doc "Copies a stored block: skips to the next byte boundary, reads LEN and its complement NLEN, and copies LEN bytes from input to out after the written bytes, returning the new written count. Bytes of the stream end at end.";
  let bits = reader^.bits;
  let partial = iand(bits, 7_u32);
  let aligned = bits - partial;
  let buffered_bytes = ishr(aligned, 3_u32);
  let buffered = cvt::<u32, u64>(buffered_bytes);
  let position = reader^.position;
  if buffered <= position {
  } else {
    let error = InflateError::Truncated();
    return Err<u64, InflateError>(error: error);
  }
  let start = position - buffered;
  if start <= end {
  } else {
    let error = InflateError::Truncated();
    return Err<u64, InflateError>(error: error);
  }
  let available = end - start;
  if available < 4_u64 {
    let error = InflateError::Truncated();
    return Err<u64, InflateError>(error: error);
  }
  let at1 = start + 1_u64;
  let at2 = start + 2_u64;
  let at3 = start + 3_u64;
  let length_low = cvt::<u8, u16>(input^[start]);
  let length_high = cvt::<u8, u16>(input^[at1]);
  let complement_low = cvt::<u8, u16>(input^[at2]);
  let complement_high = cvt::<u8, u16>(input^[at3]);
  let length_top = ishl(length_high, 8_u32);
  let complement_top = ishl(complement_high, 8_u32);
  let length_word = ior(length_low, length_top);
  let complement = ior(complement_low, complement_top);
  let expected = inot(length_word);
  if complement == expected {
  } else {
    let error = InflateError::InvalidStoredLength();
    return Err<u64, InflateError>(error: error);
  }
  let length = cvt::<u16, u64>(length_word);
  let data_start = start + 4_u64;
  let data_available = end - data_start;
  if length <= data_available {
  } else {
    let error = InflateError::Truncated();
    return Err<u64, InflateError>(error: error);
  }
  let room = out^.len - written;
  if length <= room {
  } else {
    let error = InflateError::OutputFull();
    return Err<u64, InflateError>(error: error);
  }
  for (offset in 0_u64..length) {
    let from = data_start + offset;
    let to = written + offset;
    set out^[to] = input^[from];
  }
  set reader^.position = data_start + length;
  set reader^.hold = 0_u64;
  set reader^.bits = 0_u32;
  let total = written + length;
  return Ok<u64, InflateError>(value: total);
}

fn read_code_lengths(reader: &BitReader, input: &[u8], lengths: &[u8], table: &[u32]) -> result: Result<u64, InflateError> reads(input), writes(reader), writes(lengths), writes(table) contract {
  requires lengths^.len >= 320_u64;
  requires table^.len >= 32768_u64;
  ensures when Ok(value: literal_count): literal_count >= 257_u64;
  ensures when Ok(value: literal_count): literal_count <= 286_u64;
} {
  doc "Reads a dynamic block's header: the literal/length and distance code counts, the code-length code, and through it the run-length-coded code lengths, stored in lengths as the literal/length lengths followed directly by the distance lengths, with every later entry zero up to 320. Returns the literal/length count; the distance lengths are the 30 entries after it, since a distance count above 30 is rejected like zlib and the rest stay zero. The code-length code's table is built in table.";
  let literal_bits = take_bits(reader: reader, input: input, count: 5_u32, mask: 31_u64);
  let distance_bits = take_bits(reader: reader, input: input, count: 5_u32, mask: 31_u64);
  let code_length_bits = take_bits(reader: reader, input: input, count: 4_u32, mask: 15_u64);
  let literal_count = literal_bits + 257_u64;
  let distance_count = distance_bits + 1_u64;
  let code_length_count = code_length_bits + 4_u64;
  let literals_ok = literal_count <= 286_u64;
  let distances_ok = distance_count <= 30_u64;
  let counts_ok = band(literals_ok, distances_ok);
  if counts_ok {
  } else {
    let error = InflateError::InvalidHuffmanTree();
    return Err<u64, InflateError>(error: error);
  }
  let code_lengths = array_filled::<u8, 256>(value: 0_u8);
  for (index in 0_u64..code_length_count) {
    let length = take_bits(reader: reader, input: input, count: 3_u32, mask: 7_u64);
    let symbol = cvt::<u8, u64>(code_length_order[index]);
    set code_lengths[symbol] = cvt::<u64, u8>(length);
  }
  let code_view = &code_lengths[0_u64..19_u64];
  let alphabet = Alphabet::CodeLengths();
  let code_bits = propagate build_table(lengths: code_view, alphabet: alphabet, table: table);
  for (index in 0_u64..320_u64) {
    set lengths^[index] = 0_u8;
  }
  let total = literal_count + distance_count;
  let position = 0_u64;
  let previous = 0_u8;
  loop @lengths (
    invariant filled: position <= total
  ) {
    if position == total {
      break @lengths;
    }
    let symbol = propagate decode_symbol(reader: reader, input: input, table: table, table_bits: code_bits);
    let repeat = 1_u64;
    let value = 0_u8;
    if symbol <= 15_u64 {
      set value = cvt::<u64, u8>(symbol);
      set previous = value;
    } else if symbol == 16_u64 {
      if position == 0_u64 {
        let error = InflateError::InvalidHuffmanTree();
        return Err<u64, InflateError>(error: error);
      }
      let extra = take_bits(reader: reader, input: input, count: 2_u32, mask: 3_u64);
      set repeat = extra + 3_u64;
      set value = previous;
    } else if symbol == 17_u64 {
      let extra = take_bits(reader: reader, input: input, count: 3_u32, mask: 7_u64);
      set repeat = extra + 3_u64;
      set previous = 0_u8;
    } else if symbol == 18_u64 {
      let extra = take_bits(reader: reader, input: input, count: 7_u32, mask: 127_u64);
      set repeat = extra + 11_u64;
      set previous = 0_u8;
    } else {
      let error = InflateError::InvalidHuffmanTree();
      return Err<u64, InflateError>(error: error);
    }
    let remaining = total - position;
    if repeat <= remaining {
    } else {
      let error = InflateError::InvalidHuffmanTree();
      return Err<u64, InflateError>(error: error);
    }
    let run_end = position + repeat;
    invariant run_inside: run_end <= total;
    for (at in position..run_end) {
      set lengths^[at] = value;
    }
    set position = run_end;
  }
  if lengths^[256_u64] == 0_u8 {
    let error = InflateError::InvalidHuffmanTree();
    return Err<u64, InflateError>(error: error);
  }
  return Ok<u64, InflateError>(value: literal_count);
}

fn fixed_lengths(lengths: &[u8]) -> result: unit writes(lengths) contract {
  requires lengths^.len >= 320_u64;
} {
  doc "Stores the code lengths of the fixed Huffman codes of RFC 1951 section 3.2.6: literal/length symbols 0..143 take 8 bits, 144..255 take 9, 256..279 take 7 and 280..287 take 8, followed at index 288 by the 32 distance symbols at 5 bits each.";
  for (symbol in 0_u64..320_u64) {
    let length = 5_u8;
    if symbol < 144_u64 {
      set length = 8_u8;
    } else if symbol < 256_u64 {
      set length = 9_u8;
    } else if symbol < 280_u64 {
      set length = 7_u8;
    } else if symbol < 288_u64 {
      set length = 8_u8;
    }
    set lengths^[symbol] = length;
  }
  return unit;
}

fn inflate(out: &[u8], input: &[u8], end: u64) -> result: Result<u64, InflateError> reads(input), writes(out) contract {
  requires end + 16_u64 <= input^.len;
  requires input^.len <= 2147483648_u64;
  requires out^.len <= 4294967296_u64;
} {
  doc "Decodes the raw DEFLATE (RFC 1951) stream in the first end bytes of input into out and returns the number of bytes written. input carries at least 16 bytes past end for the bit reader to load ahead; decoding that reaches into them is Truncated.";
  let reader = BitReader(position: 0_u64, hold: 0_u64, bits: 0_u32);
  let literal_cell = box_array_filled::<u32>(count: 32768_u64, value: 0_u32);
  let distance_cell = box_array_filled::<u32>(count: 32768_u64, value: 0_u32);
  let lengths = array_filled::<u8, 320>(value: 0_u8);
  let written = 0_u64;
  let final_seen = False();
  loop @blocks (
    invariant inside: written <= out^.len
  ) {
    if final_seen {
      break @blocks;
    }
    let header = take_bits(reader: &reader, input: input, count: 3_u32, mask: 7_u64);
    let final_bit = iand(header, 1_u64);
    set final_seen = final_bit == 1_u64;
    let block_type = ishr(header, 1_u32);
    let literal_table = &literal_cell.inner[0_u64..32768_u64];
    let distance_table = &distance_cell.inner[0_u64..32768_u64];
    let length_view = &lengths[0_u64..320_u64];
    if block_type == 0_u64 {
      let total = propagate copy_stored(reader: &reader, input: input, end: end, out: out, written: written);
      set written = total;
    } else if block_type == 1_u64 {
      fixed_lengths(lengths: length_view);
      let literal_lengths = &lengths[0_u64..288_u64];
      let literal_alphabet = Alphabet::LiteralLength();
      let literal_bits = propagate build_table(lengths: literal_lengths, alphabet: literal_alphabet, table: literal_table);
      let distance_lengths = &lengths[288_u64..320_u64];
      let distance_alphabet = Alphabet::Distance();
      let distance_bits = propagate build_table(lengths: distance_lengths, alphabet: distance_alphabet, table: distance_table);
      let total = propagate inflate_codes(reader: &reader, input: input, out: out, written: written, literal_table: literal_table, literal_bits: literal_bits, distance_table: distance_table, distance_bits: distance_bits);
      set written = total;
    } else if block_type == 2_u64 {
      let literal_count = propagate read_code_lengths(reader: &reader, input: input, lengths: length_view, table: literal_table);
      let literal_lengths = &lengths[0_u64..literal_count];
      let literal_alphabet = Alphabet::LiteralLength();
      let literal_bits = propagate build_table(lengths: literal_lengths, alphabet: literal_alphabet, table: literal_table);
      let distance_end = literal_count + 30_u64;
      let distance_lengths = &lengths[literal_count..distance_end];
      let distance_alphabet = Alphabet::Distance();
      let distance_bits = propagate build_table(lengths: distance_lengths, alphabet: distance_alphabet, table: distance_table);
      let total = propagate inflate_codes(reader: &reader, input: input, out: out, written: written, literal_table: literal_table, literal_bits: literal_bits, distance_table: distance_table, distance_bits: distance_bits);
      set written = total;
    } else {
      let error = InflateError::InvalidBlockType();
      return Err<u64, InflateError>(error: error);
    }
  }
  let position = reader.position;
  if position > end {
    let over = position - end;
    if over >= 8_u64 {
      let error = InflateError::Truncated();
      return Err<u64, InflateError>(error: error);
    }
    let over_bits = over * 8_u64;
    let buffered = cvt::<u32, u64>(reader.bits);
    if over_bits > buffered {
      let error = InflateError::Truncated();
      return Err<u64, InflateError>(error: error);
    }
  }
  return Ok<u64, InflateError>(value: written);
}
