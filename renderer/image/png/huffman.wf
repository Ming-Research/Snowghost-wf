enum Alphabet {
  CodeLengths();
  LiteralLength();
  Distance();
}

const length_bases: Array<u16, 29> =[3_u16, 4_u16, 5_u16, 6_u16, 7_u16, 8_u16, 9_u16, 10_u16, 11_u16, 13_u16, 15_u16, 17_u16, 19_u16, 23_u16, 27_u16, 31_u16, 35_u16, 43_u16, 51_u16, 59_u16, 67_u16, 83_u16, 99_u16, 115_u16, 131_u16, 163_u16, 195_u16, 227_u16, 258_u16];

const length_extras: Array<u8, 29> =[0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 1_u8, 1_u8, 1_u8, 1_u8, 2_u8, 2_u8, 2_u8, 2_u8, 3_u8, 3_u8, 3_u8, 3_u8, 4_u8, 4_u8, 4_u8, 4_u8, 5_u8, 5_u8, 5_u8, 5_u8, 0_u8];

const distance_bases: Array<u16, 30> =[1_u16, 2_u16, 3_u16, 4_u16, 5_u16, 7_u16, 9_u16, 13_u16, 17_u16, 25_u16, 33_u16, 49_u16, 65_u16, 97_u16, 129_u16, 193_u16, 257_u16, 385_u16, 513_u16, 769_u16, 1025_u16, 1537_u16, 2049_u16, 3073_u16, 4097_u16, 6145_u16, 8193_u16, 12289_u16, 16385_u16, 24577_u16];

const distance_extras: Array<u8, 30> =[0_u8, 0_u8, 0_u8, 0_u8, 1_u8, 1_u8, 2_u8, 2_u8, 3_u8, 3_u8, 4_u8, 4_u8, 5_u8, 5_u8, 6_u8, 6_u8, 7_u8, 7_u8, 8_u8, 8_u8, 9_u8, 9_u8, 10_u8, 10_u8, 11_u8, 11_u8, 12_u8, 12_u8, 13_u8, 13_u8];

const entry_value: u32 = 0_u32;

const entry_base: u32 = 1_u32;

const entry_end: u32 = 2_u32;

const entry_invalid: u32 = 3_u32;

fn pack_entry(kind: u32, extra: u8, value: u16) -> result: u32 pure contract {
  requires kind <= 3_u32;
} {
  doc "Packs what one decoded symbol means into a table entry, below the code length build_table adds in bits 0..3: bits 4..7 hold the count of extra bits that follow the code, bits 8..9 the kind (entry_value: a literal byte or code-length symbol in bits 16..31; entry_base: a length or distance base in bits 16..31; entry_end: the end of the block; entry_invalid: a symbol the format reserves), and bits 16..31 the value.";
  let extra_bits = cvt::<u8, u32>(extra);
  let extra_low = iand(extra_bits, 15_u32);
  let extra_field = ishl(extra_low, 4_u32);
  let kind_field = ishl(kind, 8_u32);
  let wide_value = cvt::<u16, u32>(value);
  let value_field = ishl(wide_value, 16_u32);
  let low = ior(extra_field, kind_field);
  return ior(low, value_field);
}

fn symbol_entry(alphabet: Alphabet, symbol: u64) -> result: u32 pure {
  doc "Returns the table entry, without its code length, of symbol in alphabet: code-length symbols and literal bytes are values, literal/length symbols 257..285 and distance symbols 0..29 carry their base and extra-bit count, 256 ends the block, and the reserved literal/length symbols 286 and 287 and distance symbols 30 and 31 are invalid.";
  match alphabet {
    CodeLengths() => {
      let value = cvt.wrap::<u64, u16>(symbol);
      return pack_entry(kind: entry_value, extra: 0_u8, value: value);
    }
    LiteralLength() => {
      if symbol < 256_u64 {
        let value = cvt::<u64, u16>(symbol);
        return pack_entry(kind: entry_value, extra: 0_u8, value: value);
      }
      if symbol == 256_u64 {
        return pack_entry(kind: entry_end, extra: 0_u8, value: 0_u16);
      }
      let index = symbol - 257_u64;
      if index < 29_u64 {
        return pack_entry(kind: entry_base, extra: length_extras[index], value: length_bases[index]);
      }
      return pack_entry(kind: entry_invalid, extra: 0_u8, value: 0_u16);
    }
    Distance() => {
      if symbol < 30_u64 {
        return pack_entry(kind: entry_base, extra: distance_extras[symbol], value: distance_bases[symbol]);
      }
      return pack_entry(kind: entry_invalid, extra: 0_u8, value: 0_u16);
    }
  }
}

fn reverse_bits(code: u32, length: u32) -> result: u32 pure {
  doc "Reverses the low length bits of code: DEFLATE sends Huffman codes most significant bit first into a least-significant-first bit stream.";
  let reversed = 0_u32;
  let rest = code;
  let width = cvt::<u32, u64>(length);
  for (bit in 0_u64..width) {
    let low = iand(rest, 1_u32);
    let shifted = ishl.wrap(reversed, 1_u32);
    set reversed = ior(shifted, low);
    set rest = ishr(rest, 1_u32);
  }
  return reversed;
}

fn longest_length(counts: &Array<u32, 256>) -> result: u32 reads(counts) contract {
  ensures result >= 1_u32;
  ensures result <= 15_u32;
} {
  doc "Returns the longest code length 1..15 that counts records a code of, or 1 when there is none.";
  for (step in 0_u64..14_u64) {
    let length = 15_u64 - step;
    if counts^[length] > 0_u32 {
      let longest = cvt::<u64, u32>(length);
      return longest;
    }
  }
  return 1_u32;
}

fn build_table(lengths: &[u8], alphabet: Alphabet, table: &[u32]) -> result: Result<u32, InflateError> reads(lengths), writes(table) contract {
  requires table^.len >= 32768_u64;
  ensures when Ok(value: table_bits): table_bits >= 1_u32;
  ensures when Ok(value: table_bits): table_bits <= 15_u32;
} {
  doc "Builds the single-level decoding table of the canonical Huffman code whose code lengths (0 for an unused symbol) are lengths, following RFC 1951 section 3.2.2, and returns its index width: the longest code length, at least 1. The entry at every index whose low bits start with a symbol's code, read least significant bit first, is that symbol's symbol_entry with its code length in bits 0..3; an index no code covers holds 0. An over-subscribed code is InvalidHuffmanTree, and so is an incomplete one, except a single one-bit code and, for distances, no code at all, which RFC 1951 permits; decoding a missing code then fails.";
  let counts = array_filled::<u32, 256>(value: 0_u32);
  let used = 0_u64;
  let sole_length = 0_u32;
  let symbol_count = lengths^.len;
  for (symbol in 0_u64..symbol_count) {
    let length = cvt::<u8, u64>(lengths^[symbol]);
    if length > 15_u64 {
      let error = InflateError::InvalidHuffmanTree();
      return Err<u32, InflateError>(error: error);
    }
    if length > 0_u64 {
      set counts[length] = counts[length] +wrap 1_u32;
      set used = used +wrap 1_u64;
      set sole_length = cvt::<u64, u32>(length);
    }
  }
  let left = 1_i64;
  let next_codes = array_filled::<u32, 256>(value: 0_u32);
  let code = 0_u32;
  for (length in 1_u64..16_u64) {
    let count = cvt::<u32, i64>(counts[length]);
    let doubled = left *wrap 2_i64;
    set left = doubled -wrap count;
    if left < 0_i64 {
      let error = InflateError::InvalidHuffmanTree();
      return Err<u32, InflateError>(error: error);
    }
    let shorter = length - 1_u64;
    let shorter_count = counts[shorter];
    let advanced = code +wrap shorter_count;
    set code = ishl.wrap(advanced, 1_u32);
    set next_codes[length] = code;
  }
  if left > 0_i64 {
    let single = used == 1_u64;
    let one_bit = sole_length == 1_u32;
    let single_one_bit = band(single, one_bit);
    let empty = used == 0_u64;
    let permitted = False();
    match alphabet {
      CodeLengths() => {
      }
      LiteralLength() => {
        set permitted = single_one_bit;
      }
      Distance() => {
        set permitted = bor(single_one_bit, empty);
      }
    }
    if permitted {
    } else {
      let error = InflateError::InvalidHuffmanTree();
      return Err<u32, InflateError>(error: error);
    }
  }
  let longest = longest_length(counts: &counts);
  let size = ishl(1_u64, longest);
  for (index in 0_u64..size) {
    set table^[index] = 0_u32;
  }
  for (symbol in 0_u64..symbol_count) {
    let length_byte = lengths^[symbol];
    let length = cvt::<u8, u64>(length_byte);
    if length > 0_u64 {
      let symbol_code = next_codes[length];
      set next_codes[length] = symbol_code +wrap 1_u32;
      let length32 = cvt::<u64, u32>(length);
      let reversed = reverse_bits(code: symbol_code, length: length32);
      let meaning = symbol_entry(alphabet: alphabet, symbol: symbol);
      let packed = ior(meaning, length32);
      let step = ishl.wrap(1_u64, length32);
      let slot = cvt::<u32, u64>(reversed);
      loop @fill {
        if slot < size {
        } else {
          break @fill;
        }
        set table^[slot] = packed;
        set slot = slot +wrap step;
      }
    }
  }
  return Ok<u32, InflateError>(value: longest);
}
