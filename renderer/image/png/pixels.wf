struct RgbKey {
  red: u16;
  green: u16;
  blue: u16;
}

enum RowFormat {
  Indexed8();
  Indexed1();
  Indexed2();
  Indexed4();
  Gray16();
  GrayAlpha8();
  GrayAlpha16();
  Rgb8();
  Rgb16();
  Rgba8();
  Rgba16();
}

struct PixelFormat {
  row: RowFormat;
  table: Array<u8, 1024>;
  table_count: u64;
  gray_key: Option<u16>;
  rgb_key: Option<RgbKey>;
}

fn packed_format(bit_depth: u8) -> result: RowFormat pure {
  doc "Returns the table-lookup row format of 1-, 2- or 4-bit samples; any other depth reads as 4-bit, which the caller never passes.";
  if bit_depth == 1_u8 {
    return RowFormat::Indexed1();
  }
  if bit_depth == 2_u8 {
    return RowFormat::Indexed2();
  }
  return RowFormat::Indexed4();
}

fn row_format(color: ColorType, bit_depth: u8) -> result: RowFormat pure {
  doc "Chooses how one reconstructed scanline of color and bit_depth expands to RGBA. Grayscale up to 8 bits and palette images both go through the color table, one table entry per sample value.";
  let wide = bit_depth == 16_u8;
  let byte = bit_depth == 8_u8;
  let packed = packed_format(bit_depth: bit_depth);
  match color {
    Gray() => {
      if wide {
        return RowFormat::Gray16();
      }
      if byte {
        return RowFormat::Indexed8();
      }
      return packed;
    }
    Palette() => {
      if byte {
        return RowFormat::Indexed8();
      }
      return packed;
    }
    GrayAlpha() => {
      if wide {
        return RowFormat::GrayAlpha16();
      }
      return RowFormat::GrayAlpha8();
    }
    Rgb() => {
      if wide {
        return RowFormat::Rgb16();
      }
      return RowFormat::Rgb8();
    }
    Rgba() => {
      if wide {
        return RowFormat::Rgba16();
      }
      return RowFormat::Rgba8();
    }
  }
}

fn be_u16(bytes: &[u8], at: u64) -> result: u16 reads(bytes) contract {
  define length = bytes^.len;
  requires at + 2_u64 <= length;
} {
  doc "Reads the big-endian u16 that starts at index at of bytes.";
  let high = cvt::<u8, u16>(bytes^[at]);
  let low_at = at + 1_u64;
  let low = cvt::<u8, u16>(bytes^[low_at]);
  let shifted = ishl(high, 8_u32);
  return ior(shifted, low);
}

fn palette_table(palette: &[u8], trns: &[u8]) -> table: Array<u8, 1024> reads(palette), reads(trns) {
  doc "Builds the RGBA color table of a palette image: entry i holds PLTE entry i with alpha from tRNS entry i, or 255 past the end of the tRNS table. Entries past the PLTE table stay zero; decoding rejects an index that reaches them.";
  let table = array_filled::<u8, 1024>(value: 0_u8);
  let palette_length = palette^.len;
  let trns_length = trns^.len;
  for (index in 0_u64..256_u64) {
    let source = index * 3_u64;
    let source_end = source + 3_u64;
    if source_end <= palette_length {
      let target = index * 4_u64;
      let green_at = source + 1_u64;
      let blue_at = source + 2_u64;
      let target_green = target + 1_u64;
      let target_blue = target + 2_u64;
      let target_alpha = target + 3_u64;
      set table[target] = palette^[source];
      set table[target_green] = palette^[green_at];
      set table[target_blue] = palette^[blue_at];
      let alpha = 255_u8;
      if index < trns_length {
        set alpha = trns^[index];
      }
      set table[target_alpha] = alpha;
    }
  }
  return table;
}

fn gray_scale(bit_depth: u8) -> result: u32 pure {
  doc "Returns 255 / (2^bit_depth - 1), the factor that spreads gray levels of bit_depth bits over 0..255: 255, 85 and 17 for 1, 2 and 4 bits, and 1 for 8 bits.";
  if bit_depth == 1_u8 {
    return 255_u32;
  }
  if bit_depth == 2_u8 {
    return 85_u32;
  }
  if bit_depth == 4_u8 {
    return 17_u32;
  }
  return 1_u32;
}

fn gray_table(bit_depth: u8, key: Option<u16>) -> table: Array<u8, 1024> pure {
  doc "Builds the RGBA color table of a grayscale image of at most 8 bits: entry i is gray level i scaled by 255 / (2^bit_depth - 1), opaque unless i equals the tRNS key. Entries past 2^bit_depth are unused.";
  let table = array_filled::<u8, 1024>(value: 0_u8);
  let scale = gray_scale(bit_depth: bit_depth);
  for (index in 0_u64..256_u64) {
    let level = cvt::<u64, u32>(index);
    let scaled = level *wrap scale;
    let gray = cvt.wrap::<u32, u8>(scaled);
    let alpha = 255_u8;
    match key {
      Some(value: sample) => {
        let wide_sample = cvt::<u16, u32>(sample);
        if level == wide_sample {
          set alpha = 0_u8;
        }
      }
      None() => {
      }
    }
    let target = index * 4_u64;
    let target_green = target + 1_u64;
    let target_blue = target + 2_u64;
    let target_alpha = target + 3_u64;
    set table[target] = gray;
    set table[target_green] = gray;
    set table[target_blue] = gray;
    set table[target_alpha] = alpha;
  }
  return table;
}

fn pixel_format(header: Header, palette: &[u8], trns: &[u8]) -> result: PixelFormat reads(palette), reads(trns) {
  doc "Gathers everything row expansion needs for one image: its row format, the color table for palette and low-depth grayscale images, and the tRNS key of a grayscale or truecolor image. A tRNS chunk whose length does not fit the color type carries no key and is ignored.";
  let bit_depth = header.bit_depth;
  let color = header.color;
  let row = row_format(color: color, bit_depth: bit_depth);
  let trns_length = trns^.len;
  let gray_key = None<u16>();
  if trns_length == 2_u64 {
    let sample = be_u16(bytes: trns, at: 0_u64);
    set gray_key = Some<u16>(value: sample);
  }
  let rgb_key = None<RgbKey>();
  if trns_length == 6_u64 {
    let red = be_u16(bytes: trns, at: 0_u64);
    let green = be_u16(bytes: trns, at: 2_u64);
    let blue = be_u16(bytes: trns, at: 4_u64);
    let key = RgbKey(red: red, green: green, blue: blue);
    set rgb_key = Some<RgbKey>(value: key);
  }
  let no_gray_key = None<u16>();
  let no_rgb_key = None<RgbKey>();
  let unused = array_filled::<u8, 1024>(value: 0_u8);
  match color {
    Palette() => {
      let table = palette_table(palette: palette, trns: trns);
      let palette_length = palette^.len;
      let count = palette_length / 3_u64;
      let format = PixelFormat(row: row, table: table, table_count: count, gray_key: no_gray_key, rgb_key: no_rgb_key);
      return format;
    }
    Gray() => {
      if bit_depth <= 8_u8 {
        let table = gray_table(bit_depth: bit_depth, key: gray_key);
        let depth = cvt::<u8, u32>(bit_depth);
        let levels = ishl(1_u64, depth);
        let format = PixelFormat(row: row, table: table, table_count: levels, gray_key: no_gray_key, rgb_key: no_rgb_key);
        return format;
      }
      let format = PixelFormat(row: row, table: unused, table_count: 0_u64, gray_key: gray_key, rgb_key: no_rgb_key);
      return format;
    }
    Rgb() => {
      let format = PixelFormat(row: row, table: unused, table_count: 0_u64, gray_key: no_gray_key, rgb_key: rgb_key);
      return format;
    }
    GrayAlpha() => {
      let format = PixelFormat(row: row, table: unused, table_count: 0_u64, gray_key: no_gray_key, rgb_key: no_rgb_key);
      return format;
    }
    Rgba() => {
      let format = PixelFormat(row: row, table: unused, table_count: 0_u64, gray_key: no_gray_key, rgb_key: no_rgb_key);
      return format;
    }
  }
}
