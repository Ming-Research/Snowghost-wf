public struct UrlSpan {
  public start: u32;
  public end: u32;
}

public enum HostKind {
  Absent();
  Domain();
  Ipv4();
  Ipv6();
  Opaque();
  Empty();
}

public struct Url {
  public readonly href: Box<Slots<u8>>;
  public readonly scheme: UrlSpan;
  public readonly username: UrlSpan;
  public readonly password: UrlSpan;
  public readonly host: UrlSpan;
  public readonly host_kind: HostKind;
  public readonly port: Option<u16>;
  public readonly path: UrlSpan;
  public readonly opaque_path: Bool;
  public readonly query: Option<UrlSpan>;
  public readonly fragment: Option<UrlSpan>;
}

public enum UrlError {
  Failure();
  TooLarge();
}

public fn parse_url(input: &[u8]) -> result: Result<Url, UrlError> reads(input) contract {
  requires input^.len <= 268435456_u64;
} doc "Runs the basic URL parser of the WHATWG URL Living Standard on input with no base, as WPT's url tests at revision b48a5c3f expect: Failure where the parser returns failure. Input is WTF-8: each lone surrogate, and each maximal ill-formed subsequence as the WHATWG UTF-8 decoder finds it, reads as U+FFFD. The encoding is UTF-8 throughout. Domains go through the domain parser with beStrict false, using pkg::text::idna for Unicode ToASCII. Href holds the URL serializer's output, fragment included, and every span indexes href: scheme without its colon; username and password percent-encoded as serialized; host as the host serializer writes it, IPv6 addresses in brackets, empty when host_kind is Absent or Empty; path as the URL path serializer writes it, without the /. that the serializer adds for a path starting with an empty segment when host_kind is Absent; query and fragment without their ? and #, None where the record's is null. Opaque_path is True for a URL with an opaque path. The spans appear in href in that order and do not overlap. TooLarge when href would pass a storage limit.";

public fn parse_url_with_base(input: &[u8], base: &Url) -> result: Result<Url, UrlError> reads(input), reads(base) contract {
  requires input^.len <= 268435456_u64;
} doc "Runs the basic URL parser on input with base as its base URL, with input, the result and its errors as parse_url describes.";
