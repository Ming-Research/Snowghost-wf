const scheme_ftp: Array<u8, 3> =[102_u8, 116_u8, 112_u8];

const scheme_file: Array<u8, 4> =[102_u8, 105_u8, 108_u8, 101_u8];

const scheme_http: Array<u8, 4> =[104_u8, 116_u8, 116_u8, 112_u8];

const scheme_https: Array<u8, 5> =[104_u8, 116_u8, 116_u8, 112_u8, 115_u8];

const scheme_ws: Array<u8, 2> =[119_u8, 115_u8];

const scheme_wss: Array<u8, 3> =[119_u8, 115_u8, 115_u8];

const literal_localhost: Array<u8, 9> =[108_u8, 111_u8, 99_u8, 97_u8, 108_u8, 104_u8, 111_u8, 115_u8, 116_u8];

enum SpecialScheme {
  NotSpecial();
  Ftp();
  File();
  Http();
  Https();
  Ws();
  Wss();
}

fn bytes_equal(a: &[u8], b: &[u8]) -> result: Bool reads(a), reads(b) {
  doc "True when a and b hold the same bytes in the same order.";
  let la = a^.len;
  let lb = b^.len;
  let same_len = la == lb;
  if same_len {
  } else {
    return False();
  }
  for (at in 0_u64..la) {
    let x = a^[at];
    let y = b^[at];
    let eq = x == y;
    if eq {
    } else {
      return False();
    }
  }
  return True();
}

fn classify_scheme(scheme: &[u8]) -> result: SpecialScheme reads(scheme) {
  doc "Classifies scheme, already-lowercased ASCII, as one of the six special schemes or NotSpecial.";
  let ftp = &scheme_ftp[0_u64..scheme_ftp.len];
  if bytes_equal(a: scheme, b: ftp) {
    return SpecialScheme::Ftp();
  }
  let file = &scheme_file[0_u64..scheme_file.len];
  if bytes_equal(a: scheme, b: file) {
    return SpecialScheme::File();
  }
  let http = &scheme_http[0_u64..scheme_http.len];
  if bytes_equal(a: scheme, b: http) {
    return SpecialScheme::Http();
  }
  let https = &scheme_https[0_u64..scheme_https.len];
  if bytes_equal(a: scheme, b: https) {
    return SpecialScheme::Https();
  }
  let ws = &scheme_ws[0_u64..scheme_ws.len];
  if bytes_equal(a: scheme, b: ws) {
    return SpecialScheme::Ws();
  }
  let wss = &scheme_wss[0_u64..scheme_wss.len];
  if bytes_equal(a: scheme, b: wss) {
    return SpecialScheme::Wss();
  }
  return SpecialScheme::NotSpecial();
}

fn scheme_is_special(kind: SpecialScheme) -> result: Bool pure {
  doc "True for every SpecialScheme variant but NotSpecial.";
  match kind {
    NotSpecial() => {
      return False();
    }
    Ftp() => {
      return True();
    }
    File() => {
      return True();
    }
    Http() => {
      return True();
    }
    Https() => {
      return True();
    }
    Ws() => {
      return True();
    }
    Wss() => {
      return True();
    }
  }
}

fn scheme_is_file(kind: SpecialScheme) -> result: Bool pure {
  doc "True for the File variant.";
  match kind {
    File() => {
      return True();
    }
    NotSpecial() => {
      return False();
    }
    Ftp() => {
      return False();
    }
    Http() => {
      return False();
    }
    Https() => {
      return False();
    }
    Ws() => {
      return False();
    }
    Wss() => {
      return False();
    }
  }
}

fn scheme_default_port(kind: SpecialScheme) -> result: Option<u16> pure {
  doc "The default port for kind: 21 for ftp, 80 for http and ws, 443 for https and wss, null for file and for a non-special scheme.";
  match kind {
    Ftp() => {
      return Some<u16>(value: 21_u16);
    }
    Http() => {
      return Some<u16>(value: 80_u16);
    }
    Https() => {
      return Some<u16>(value: 443_u16);
    }
    Ws() => {
      return Some<u16>(value: 80_u16);
    }
    Wss() => {
      return Some<u16>(value: 443_u16);
    }
    File() => {
      return None<u16>();
    }
    NotSpecial() => {
      return None<u16>();
    }
  }
}

fn scan_scheme(input: &[u8]) -> result: Option<u64> reads(input) {
  doc "Scans input for a URL-scheme string followed by U+003A: one ASCII alpha then zero or more ASCII alphanumeric, U+002B, U+002D or U+002E, immediately followed by a colon. Returns the colon's index, or None when input does not start with such a scheme.";
  let length = input^.len;
  let has_first = length > 0_u64;
  if has_first {
  } else {
    return None<u64>();
  }
  let first = input^[0_u64];
  let first_alpha = is_ascii_alpha(byte: first);
  if first_alpha {
  } else {
    return None<u64>();
  }
  let pos = 1_u64;
  loop @scan (
    invariant pos_bounded: pos <= length
  ) {
    let more = pos < length;
    if more {
    } else {
      break @scan;
    }
    let byte = input^[pos];
    let alnum = is_ascii_alphanumeric(byte: byte);
    let plus = byte == 43_u8;
    let minus = byte == 45_u8;
    let dot = byte == 46_u8;
    let a = bor(alnum, plus);
    let b = bor(a, minus);
    let scheme_char = bor(b, dot);
    if scheme_char {
    } else {
      break @scan;
    }
    let next = pos +wrap 1_u64;
    invariant next_bounded: next <= length;
    set pos = next;
  }
  let has_colon = pos < length;
  if has_colon {
  } else {
    return None<u64>();
  }
  let terminator = input^[pos];
  let is_colon = terminator == 58_u8;
  if is_colon {
    return Some<u64>(value: pos);
  }
  return None<u64>();
}

fn is_windows_drive_letter(input: &[u8]) -> result: Bool reads(input) {
  doc "True when input is exactly two code points, an ASCII alpha followed by U+003A or U+007C.";
  let length = input^.len;
  let two = length == 2_u64;
  if two {
  } else {
    return False();
  }
  let first = input^[0_u64];
  let second = input^[1_u64];
  let alpha = is_ascii_alpha(byte: first);
  let colon = second == 58_u8;
  let pipe = second == 124_u8;
  let mark = bor(colon, pipe);
  return band(alpha, mark);
}

fn starts_with_windows_drive_letter(input: &[u8]) -> result: Bool reads(input) {
  doc "True when input's length is at least 2, its first two code points are a Windows drive letter, and its length is 2 or its third code point is U+002F, U+005C, U+003F or U+0023.";
  let length = input^.len;
  let has_two = length >= 2_u64;
  if has_two {
  } else {
    return False();
  }
  let first_two = &input^[0_u64..2_u64];
  let drive = is_windows_drive_letter(input: first_two);
  if drive {
  } else {
    return False();
  }
  let exactly_two = length == 2_u64;
  if exactly_two {
    return True();
  }
  let third = input^[2_u64];
  let slash = third == 47_u8;
  let backslash = third == 92_u8;
  let question = third == 63_u8;
  let hash = third == 35_u8;
  let a = bor(slash, backslash);
  let b = bor(a, question);
  return bor(b, hash);
}

fn is_localhost(input: &[u8]) -> result: Bool reads(input) {
  doc "True when input is exactly the bytes of \"localhost\".";
  let literal = &literal_localhost[0_u64..literal_localhost.len];
  let eq = bytes_equal(a: input, b: literal);
  return eq;
}

fn set_scheme_to_file(b: &Builder) -> result: Result<unit, UrlError> writes(b) {
  doc "Resets b's scheme to the literal \"file\" and reclassifies it, per the file state's first step.";
  truncate_bytes_to(buffer: &b^.scheme, length: 0_u64);
  let file_name = &scheme_file[0_u64..scheme_file.len];
  let pushed = propagate push_bytes(buffer: &b^.scheme, bytes: file_name);
  let finished = finish_scheme(b: b);
  return Ok<unit, UrlError>(value: unit);
}
