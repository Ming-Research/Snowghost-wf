public struct Span {
  public start: u32;
  public end: u32;
}

public enum NumberKind {
  Integer();
  Number();
}

public struct Numeric {
  public value: f64;
  public kind: NumberKind;
  public representation: Span;
}

public enum HashKind {
  Id();
  Unrestricted();
}

public enum ParseError {
  BadString();
  BadUrl();
  EofInString();
  EofInUrl();
  UnmatchedParenthesis();
  UnmatchedBracket();
  UnmatchedBrace();
}

public enum Component {
  Ident(public name: Span);
  Function(public name: Span, public end: u32);
  AtKeyword(public name: Span);
  Hash(public name: Span, public kind: HashKind);
  QuotedString(public value: Span);
  Url(public value: Span);
  Delim(public code_point: u32);
  Number(public number: Numeric);
  Percentage(public number: Numeric);
  Dimension(public number: Numeric, public unit_name: Span);
  UnicodeRange(public start: u32, public end: u32);
  IncludeMatch();
  DashMatch();
  PrefixMatch();
  SuffixMatch();
  SubstringMatch();
  Column();
  Whitespace();
  Cdo();
  Cdc();
  Colon();
  Semicolon();
  Comma();
  ParenthesisBlock(public end: u32);
  BracketBlock(public end: u32);
  BraceBlock(public end: u32);
  Error(public error: ParseError);
}

public struct ComponentList {
  public readonly components: Box<Slots<Component>>;
  public readonly text: Box<Slots<u8>>;
}

public fn parse_component_values(source: &[u8]) -> list: ComponentList reads(source) contract {
  requires source^.len <= 16777216_u64;
} doc "Parses source as a list of component values under CSS Syntax Module Level 3, Candidate Recommendation Draft of 24 December 2021, with the tokens and error reports of css-parsing-tests at revision 203ce36b: unicode-range, include-match, dash-match, prefix-match, suffix-match, substring-match and column tokens, and an Error component wherever that suite reports an error, in the same position. Source is UTF-8; each maximal ill-formed subsequence decodes to U+FFFD, as the WHATWG UTF-8 decoder does, before input preprocessing. The components are in preorder: a Function or block component is followed by its contents, and its end is the index after its last content component. Comments produce no component. Every Span indexes text, which holds as UTF-8 each decoded name, string value, URL value and unit, and each number's representation, the preprocessed source characters that spelled the number. A Delim carries its code point.";
