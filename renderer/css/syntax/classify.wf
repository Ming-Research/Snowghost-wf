fn digit_byte(b: u8) -> result: Bool pure {
  doc "True when b is an ASCII digit 0-9.";
  let result_l = b >= 48_u8;
  let result_r = b <= 57_u8;
  let result = band(result_l, result_r);
  return result;
}

fn is_whitespace_byte(b: u8) -> result: Bool pure {
  doc "True when b is one of the raw bytes that input preprocessing and the tokenizer both treat as whitespace: tab, LF, FF, CR, or space. CR, FF and CRLF each preprocess to one LF, so this raw check agrees with a preprocessed-whitespace check at every position.";
  let tab = b == 9_u8;
  let lf = b == 10_u8;
  let ff = b == 12_u8;
  let cr = b == 13_u8;
  let space = b == 32_u8;
  let a = bor(tab, lf);
  let c = bor(ff, cr);
  let d = bor(a, c);
  let result = bor(d, space);
  return result;
}

fn is_whitespace_cp(cp: u32) -> result: Bool pure {
  doc "True for a preprocessed whitespace code point: tab, LF, or space.";
  let tab = cp == 9_u32;
  let lf = cp == 10_u32;
  let space = cp == 32_u32;
  let a = bor(tab, lf);
  let result = bor(a, space);
  return result;
}

fn hex_digit_cp(cp: u32) -> result: Bool pure {
  doc "True when cp is an ASCII hex digit.";
  let d_l = cp >= 48_u32;
  let d_r = cp <= 57_u32;
  let d = band(d_l, d_r);
  let lo_l = cp >= 97_u32;
  let lo_r = cp <= 102_u32;
  let lo = band(lo_l, lo_r);
  let hi_l = cp >= 65_u32;
  let hi_r = cp <= 70_u32;
  let hi = band(hi_l, hi_r);
  let a = bor(d, lo);
  let result = bor(a, hi);
  return result;
}

fn hex_value_cp(cp: u32) -> result: u32 pure {
  doc "The hexadecimal value of an ASCII hex digit code point. Callers use it only after hex_digit_cp(cp: cp) holds.";
  let is_digit_l = cp >= 48_u32;
  let is_digit_r = cp <= 57_u32;
  let is_digit = band(is_digit_l, is_digit_r);
  if is_digit {
    let value = cp -wrap 48_u32;
    return value;
  }
  let is_lower_l = cp >= 97_u32;
  let is_lower_r = cp <= 102_u32;
  let is_lower = band(is_lower_l, is_lower_r);
  if is_lower {
    let base = cp -wrap 97_u32;
    let value = base +wrap 10_u32;
    return value;
  }
  let base = cp -wrap 65_u32;
  let value = base +wrap 10_u32;
  return value;
}

fn name_start_cp(cp: u32) -> result: Bool pure {
  doc "True for a name-start code point: an ASCII letter, U+005F LOW LINE, or any code point at or above U+0080.";
  let upper_l = cp >= 65_u32;
  let upper_r = cp <= 90_u32;
  let upper = band(upper_l, upper_r);
  let lower_l = cp >= 97_u32;
  let lower_r = cp <= 122_u32;
  let lower = band(lower_l, lower_r);
  let letter = bor(upper, lower);
  let underscore = cp == 95_u32;
  let nonascii = cp >= 128_u32;
  let a = bor(letter, underscore);
  let result = bor(a, nonascii);
  return result;
}

fn name_char_cp(cp: u32) -> result: Bool pure {
  doc "True for a name code point: a name-start code point, an ASCII digit, or U+002D HYPHEN-MINUS.";
  let start = name_start_cp(cp: cp);
  let digit_l = cp >= 48_u32;
  let digit_r = cp <= 57_u32;
  let digit = band(digit_l, digit_r);
  let dash = cp == 45_u32;
  let a = bor(start, digit);
  let result = bor(a, dash);
  return result;
}

fn ascii_hex_byte(b: u8) -> result: Bool pure {
  doc "True when b is an ASCII hex digit. A raw byte and its preprocessed code point are the same value for every ASCII byte, so this delegates to hex_digit_cp rather than repeating its range checks at the u8 width.";
  let cp = cvt::<u8, u32>(b);
  let result = hex_digit_cp(cp: cp);
  return result;
}

fn ascii_hex_value(b: u8) -> result: u32 pure {
  doc "The hexadecimal value of an ASCII hex digit byte. Callers use it only after ascii_hex_byte(b: b) holds. Delegates to hex_value_cp for the same reason as ascii_hex_byte.";
  let cp = cvt::<u8, u32>(b);
  let result = hex_value_cp(cp: cp);
  return result;
}

fn non_printable_cp(cp: u32) -> result: Bool pure {
  doc "True for a non-printable code point: U+0000 through U+0008, U+000B, U+000E through U+001F, or U+007F.";
  let low_l = cp >= 0_u32;
  let low_r = cp <= 8_u32;
  let low = band(low_l, low_r);
  let vt = cp == 11_u32;
  let mid_l = cp >= 14_u32;
  let mid_r = cp <= 31_u32;
  let mid = band(mid_l, mid_r);
  let del = cp == 127_u32;
  let a = bor(low, vt);
  let b = bor(mid, del);
  let result = bor(a, b);
  return result;
}
