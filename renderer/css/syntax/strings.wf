fn consume_string_contents(source: &[u8], length: u64, start: u64, quote: u32, text: &Box<Slots<u8>>) -> (span: Span, next: u64, bad: Bool, hit_eof: Bool) reads(source), writes(text) contract {
  requires length == source^.len;
} {
  doc "Consumes string content from start up to quote (not itself part of the ending quote), per CSS Syntax 4.3.5. bad is true on an unescaped newline, whose position next does not advance past; hit_eof is true when input ran out before the ending quote.";
  let text_start = text^.inner.len;
  let pos = start;
  loop @content {
    let has = pos < length;
    if has {
    } else {
      let text_end = text^.inner.len;
      let start32 = cvt.wrap::<u64, u32>(text_start);
      let end32 = cvt.wrap::<u64, u32>(text_end);
      let span = Span(start: start32, end: end32);
      return span, pos, False(), True();
    }
    let (cp, after) = peek_pp(source: source, length: length, pos: pos);
    let is_quote = cp == quote;
    if is_quote {
      let text_end = text^.inner.len;
      let start32 = cvt.wrap::<u64, u32>(text_start);
      let end32 = cvt.wrap::<u64, u32>(text_end);
      let span = Span(start: start32, end: end32);
      return span, after, False(), False();
    }
    let is_newline = cp == 10_u32;
    if is_newline {
      let text_end = text^.inner.len;
      let start32 = cvt.wrap::<u64, u32>(text_start);
      let end32 = cvt.wrap::<u64, u32>(text_end);
      let span = Span(start: start32, end: end32);
      return span, pos, True(), False();
    }
    let is_bs = cp == 92_u32;
    if is_bs {
      let has_next = after < length;
      if has_next {
        let (cn, afternext) = peek_pp(source: source, length: length, pos: after);
        let next_is_newline = cn == 10_u32;
        if next_is_newline {
          set pos = afternext;
        } else {
          let (ecp, eafter) = consume_escape(source: source, length: length, pos: after);
          push_code_point(text: text, cp: ecp);
          set pos = eafter;
        }
      } else {
        set pos = after;
      }
    } else {
      push_code_point(text: text, cp: cp);
      set pos = after;
    }
  }
  let text_end = text^.inner.len;
  let start32 = cvt.wrap::<u64, u32>(text_start);
  let end32 = cvt.wrap::<u64, u32>(text_end);
  let span = Span(start: start32, end: end32);
  return span, pos, False(), False();
}

fn consume_string_token(source: &[u8], length: u64, start: u64, quote: u32, text: &Box<Slots<u8>>, components: &Box<Slots<Component>>) -> next: u64 reads(source), writes(text), writes(components) contract {
  requires length == source^.len;
} {
  doc "Consumes a string token from start, the position right after its opening quote, and appends its component plus a trailing eof-in-string error on unterminated input, or a lone bad-string error on an unescaped newline.";
  let (span, after, bad, hit_eof) = consume_string_contents(source: source, length: length, start: start, quote: quote, text: text);
  if bad {
    let comp_err = ParseError::BadString();
    let comp = Component::Error(error: comp_err);
    push_component(components: components, value: comp);
    return after;
  }
  let comp = Component::QuotedString(value: span);
  push_component(components: components, value: comp);
  if hit_eof {
    let err_err = ParseError::EofInString();
    let err = Component::Error(error: err_err);
    push_component(components: components, value: err);
  }
  return after;
}

fn consume_bad_url_remnants(source: &[u8], length: u64, start: u64) -> next: u64 reads(source) contract {
  requires length == source^.len;
} {
  doc "Consumes and discards code points from start up to and including the closing parenthesis, or up to EOF, honoring escapes, per CSS Syntax 4.3.14.";
  let pos = start;
  loop @remnant {
    let has = pos < length;
    if has {
    } else {
      break @remnant;
    }
    let (cp, after) = peek_pp(source: source, length: length, pos: pos);
    let is_close = cp == 41_u32;
    if is_close {
      set pos = after;
      break @remnant;
    }
    let is_bs = cp == 92_u32;
    if is_bs {
      let esc_ok = would_start_valid_escape(source: source, length: length, pos: pos);
      if esc_ok {
        let (ecp, eafter) = consume_escape(source: source, length: length, pos: after);
        set pos = eafter;
      } else {
        set pos = after;
      }
    } else {
      set pos = after;
    }
  }
  return pos;
}

fn consume_url_token(source: &[u8], length: u64, start: u64, text: &Box<Slots<u8>>, components: &Box<Slots<Component>>) -> next: u64 reads(source), writes(text), writes(components) contract {
  requires length == source^.len;
} {
  doc "Consumes an unquoted url token's value from start, the position right after url( and any leading whitespace already known not to lead into a string, per CSS Syntax 4.3.6.";
  let text_start = text^.inner.len;
  let pos = start;
  loop @ws {
    let has = pos < length;
    if has {
      let b = source^[pos];
      let ws = is_whitespace_byte(b: b);
      if ws {
        let next_pos = pos +wrap 1_u64;
        set pos = next_pos;
      }
      if ws {
      } else {
        break @ws;
      }
    } else {
      break @ws;
    }
  }
  loop @body {
    let has = pos < length;
    if has {
    } else {
      let text_end = text^.inner.len;
      let start32 = cvt.wrap::<u64, u32>(text_start);
      let end32 = cvt.wrap::<u64, u32>(text_end);
      let span = Span(start: start32, end: end32);
      let comp = Component::Url(value: span);
      push_component(components: components, value: comp);
      let err_err = ParseError::EofInUrl();
      let err = Component::Error(error: err_err);
      push_component(components: components, value: err);
      return pos;
    }
    let (cp, after) = peek_pp(source: source, length: length, pos: pos);
    let is_close = cp == 41_u32;
    if is_close {
      let text_end = text^.inner.len;
      let start32 = cvt.wrap::<u64, u32>(text_start);
      let end32 = cvt.wrap::<u64, u32>(text_end);
      let span = Span(start: start32, end: end32);
      let comp = Component::Url(value: span);
      push_component(components: components, value: comp);
      return after;
    }
    let is_ws = is_whitespace_cp(cp: cp);
    if is_ws {
      let wpos = after;
      loop @tail_ws {
        let has2 = wpos < length;
        if has2 {
          let b2 = source^[wpos];
          let ws2 = is_whitespace_byte(b: b2);
          if ws2 {
            let next_pos = wpos +wrap 1_u64;
            set wpos = next_pos;
          }
          if ws2 {
          } else {
            break @tail_ws;
          }
        } else {
          break @tail_ws;
        }
      }
      let has3 = wpos < length;
      if has3 {
        let b3 = source^[wpos];
        let closes = b3 == 41_u8;
        if closes {
          let text_end = text^.inner.len;
          let start32 = cvt.wrap::<u64, u32>(text_start);
          let end32 = cvt.wrap::<u64, u32>(text_end);
          let span = Span(start: start32, end: end32);
          let comp = Component::Url(value: span);
          push_component(components: components, value: comp);
          let after_close = wpos +wrap 1_u64;
          return after_close;
        }
      } else {
        let text_end = text^.inner.len;
        let start32 = cvt.wrap::<u64, u32>(text_start);
        let end32 = cvt.wrap::<u64, u32>(text_end);
        let span = Span(start: start32, end: end32);
        let comp = Component::Url(value: span);
        push_component(components: components, value: comp);
        let err_err = ParseError::EofInUrl();
        let err = Component::Error(error: err_err);
        push_component(components: components, value: err);
        return wpos;
      }
      let remnant_end = consume_bad_url_remnants(source: source, length: length, start: wpos);
      let comp_err = ParseError::BadUrl();
      let comp = Component::Error(error: comp_err);
      push_component(components: components, value: comp);
      return remnant_end;
    }
    let is_quote_char_l = cp == 34_u32;
    let is_quote_char_r = cp == 39_u32;
    let is_quote_char = bor(is_quote_char_l, is_quote_char_r);
    let is_open_paren = cp == 40_u32;
    let non_printable = non_printable_cp(cp: cp);
    let bad_a = bor(is_quote_char, is_open_paren);
    let is_bad_char = bor(bad_a, non_printable);
    if is_bad_char {
      let remnant_end = consume_bad_url_remnants(source: source, length: length, start: after);
      let comp_err = ParseError::BadUrl();
      let comp = Component::Error(error: comp_err);
      push_component(components: components, value: comp);
      return remnant_end;
    }
    let is_bs = cp == 92_u32;
    if is_bs {
      let esc_ok = would_start_valid_escape(source: source, length: length, pos: pos);
      if esc_ok {
        let (ecp, eafter) = consume_escape(source: source, length: length, pos: after);
        push_code_point(text: text, cp: ecp);
        set pos = eafter;
      } else {
        let remnant_end = consume_bad_url_remnants(source: source, length: length, start: after);
        let comp_err = ParseError::BadUrl();
        let comp = Component::Error(error: comp_err);
        push_component(components: components, value: comp);
        return remnant_end;
      }
    } else {
      push_code_point(text: text, cp: cp);
      set pos = after;
    }
  }
  return pos;
}
