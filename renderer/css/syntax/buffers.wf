const text_capacity_seed: u64 = 4096_u64;

const text_capacity_ceiling: u64 = 134217728_u64;

const component_capacity_seed: u64 = 1024_u64;

const component_capacity_ceiling: u64 = 33554432_u64;

fn push_raw_byte(text: &Box<Slots<u8>>, value: u8) -> result: unit writes(text) {
  doc "Appends one byte to text, doubling its capacity within text_capacity_ceiling.";
  let length = text^.inner.len;
  let capacity = text^.inner.cap;
  let full = length >= capacity;
  if full {
    let empty = capacity == 0_u64;
    let doubled = if empty {
      give text_capacity_seed;
    } else {
      give capacity +wrap capacity;
    }
    let bounded = doubled <= text_capacity_ceiling;
    let larger = doubled >= capacity;
    if bounded {
      if larger {
        grow(cell: text, capacity: doubled);
      }
    }
  }
  let room = text^.inner.len < text^.inner.cap;
  if room {
    place_back(window: &text^.inner, value: value);
  }
  return unit;
}

fn push_component(components: &Box<Slots<Component>>, value: Component) -> result: unit writes(components) {
  doc "Appends one component to components, doubling its capacity within component_capacity_ceiling.";
  let length = components^.inner.len;
  let capacity = components^.inner.cap;
  let full = length >= capacity;
  if full {
    let empty = capacity == 0_u64;
    let doubled = if empty {
      give component_capacity_seed;
    } else {
      give capacity +wrap capacity;
    }
    let bounded = doubled <= component_capacity_ceiling;
    let larger = doubled >= capacity;
    if bounded {
      if larger {
        grow(cell: components, capacity: doubled);
      }
    }
  }
  let room = components^.inner.len < components^.inner.cap;
  if room {
    place_back(window: &components^.inner, value: value);
  }
  return unit;
}

fn utf8_lead_byte(code_point: u32, shift: u32, marker: u32) -> result: u8 pure {
  doc "Returns the lead byte of a UTF-8 sequence: the bits of code_point from shift upward, joined with marker.";
  let high = ishr.wrap(code_point, shift);
  let joined = ior(high, marker);
  let byte = cvt.wrap::<u32, u8>(joined);
  return byte;
}

fn utf8_continuation_byte(code_point: u32, shift: u32) -> result: u8 pure {
  doc "Returns the UTF-8 continuation byte that carries the six bits of code_point starting at shift.";
  let moved = ishr.wrap(code_point, shift);
  let bits = iand(moved, 63_u32);
  let joined = ior(bits, 128_u32);
  let byte = cvt.wrap::<u32, u8>(joined);
  return byte;
}

fn push_code_point(text: &Box<Slots<u8>>, cp: u32) -> result: unit writes(text) {
  doc "Appends cp to text as UTF-8: one to four bytes depending on its magnitude.";
  let one_byte = cp < 128_u32;
  let two_bytes = cp < 2048_u32;
  let three_bytes = cp < 65536_u32;
  if one_byte {
    let byte = cvt.wrap::<u32, u8>(cp);
    push_raw_byte(text: text, value: byte);
    return unit;
  }
  if two_bytes {
    let lead = utf8_lead_byte(code_point: cp, shift: 6_u32, marker: 192_u32);
    let last = utf8_continuation_byte(code_point: cp, shift: 0_u32);
    push_raw_byte(text: text, value: lead);
    push_raw_byte(text: text, value: last);
    return unit;
  }
  if three_bytes {
    let lead = utf8_lead_byte(code_point: cp, shift: 12_u32, marker: 224_u32);
    let middle = utf8_continuation_byte(code_point: cp, shift: 6_u32);
    let last = utf8_continuation_byte(code_point: cp, shift: 0_u32);
    push_raw_byte(text: text, value: lead);
    push_raw_byte(text: text, value: middle);
    push_raw_byte(text: text, value: last);
    return unit;
  }
  let lead = utf8_lead_byte(code_point: cp, shift: 18_u32, marker: 240_u32);
  let upper = utf8_continuation_byte(code_point: cp, shift: 12_u32);
  let middle = utf8_continuation_byte(code_point: cp, shift: 6_u32);
  let last = utf8_continuation_byte(code_point: cp, shift: 0_u32);
  push_raw_byte(text: text, value: lead);
  push_raw_byte(text: text, value: upper);
  push_raw_byte(text: text, value: middle);
  push_raw_byte(text: text, value: last);
  return unit;
}
