alias ComponentList = pkg::css::syntax::ComponentList;

fn parse_one_rule(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItem, OneError> reads(values) {
  doc "Parses range of values as exactly one rule surrounded by optional whitespace, per CSS Syntax 5.3.5.";
  let (start, limit) = clamp_range(values: values, range: range);
  let pos = skip_ws(values: values, at: start, limit: limit);
  let has = pos < limit;
  if has {
  } else {
    let empty = OneError::Empty();
    return Err<RuleItem, OneError>(error: empty);
  }
  let c = values^.components.inner[pos];
  let step = classify_step(c: c, at: pos);
  let at_name = step_at_keyword_name(step: step);
  match at_name {
    Some(value: named) => {
      let after_name = step_advance(step: step, at: pos, limit: limit);
      let (item, reached) = consume_at_rule(values: values, name: named, start: after_name, limit: limit);
      let trailing = skip_ws(values: values, at: reached, limit: limit);
      let extra = trailing < limit;
      if extra {
        let err = OneError::ExtraInput();
        return Err<RuleItem, OneError>(error: err);
      }
      return Ok<RuleItem, OneError>(value: item);
    }
    None() => {
      let (maybe_item, reached) = consume_qualified_rule(values: values, start: pos, limit: limit);
      match maybe_item {
        Some(value: item) => {
          let trailing = skip_ws(values: values, at: reached, limit: limit);
          let extra = trailing < limit;
          if extra {
            let err = OneError::ExtraInput();
            return Err<RuleItem, OneError>(error: err);
          }
          return Ok<RuleItem, OneError>(value: item);
        }
        None() => {
          let err = OneError::Invalid();
          return Err<RuleItem, OneError>(error: err);
        }
      }
    }
  }
}

fn parse_one_declaration(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItem, OneError> reads(values) {
  doc "Parses range of values as exactly one declaration surrounded by optional leading whitespace, per CSS Syntax 5.3.6.";
  let (start, limit) = clamp_range(values: values, range: range);
  let pos = skip_ws(values: values, at: start, limit: limit);
  let has = pos < limit;
  if has {
  } else {
    let empty = OneError::Empty();
    return Err<RuleItem, OneError>(error: empty);
  }
  let parsed = consume_declaration(values: values, start: pos, limit: limit);
  match parsed {
    Some(value: decl) => {
      let item = RuleItem::Declaration(name: decl.name, value: decl.value, important: decl.important);
      return Ok<RuleItem, OneError>(value: item);
    }
    None() => {
      let err = OneError::Invalid();
      return Err<RuleItem, OneError>(error: err);
    }
  }
}
