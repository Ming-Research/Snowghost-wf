fn step_at_keyword_name(step: Step) -> result: Option<Span> pure {
  doc "The at-keyword's name when step classifies an AtKeyword component, and None otherwise.";
  match step {
    Whitespace() => {
      return None<Span>();
    }
    Semicolon() => {
      return None<Span>();
    }
    Colon() => {
      return None<Span>();
    }
    Delim(code_point: cp) => {
      return None<Span>();
    }
    AtKeyword(name: nm) => {
      return Some<Span>(value: nm);
    }
    Ident(name: nm) => {
      return None<Span>();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return None<Span>();
    }
    Nested(end: e) => {
      return None<Span>();
    }
    Cdo() => {
      return None<Span>();
    }
    Cdc() => {
      return None<Span>();
    }
    Other() => {
      return None<Span>();
    }
  }
}

fn step_ident_name(step: Step) -> result: Option<Span> pure {
  doc "The ident's name when step classifies an Ident component, and None otherwise.";
  match step {
    Whitespace() => {
      return None<Span>();
    }
    Semicolon() => {
      return None<Span>();
    }
    Colon() => {
      return None<Span>();
    }
    Delim(code_point: cp) => {
      return None<Span>();
    }
    AtKeyword(name: nm) => {
      return None<Span>();
    }
    Ident(name: nm) => {
      return Some<Span>(value: nm);
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return None<Span>();
    }
    Nested(end: e) => {
      return None<Span>();
    }
    Cdo() => {
      return None<Span>();
    }
    Cdc() => {
      return None<Span>();
    }
    Other() => {
      return None<Span>();
    }
  }
}

fn step_brace(step: Step) -> result: Option<BraceBounds> pure {
  doc "The block's declared content bounds when step classifies a Brace component, and None otherwise. A caller reading them still proves them against its own limit before trusting them as a range.";
  match step {
    Whitespace() => {
      return None<BraceBounds>();
    }
    Semicolon() => {
      return None<BraceBounds>();
    }
    Colon() => {
      return None<BraceBounds>();
    }
    Delim(code_point: cp) => {
      return None<BraceBounds>();
    }
    AtKeyword(name: nm) => {
      return None<BraceBounds>();
    }
    Ident(name: nm) => {
      return None<BraceBounds>();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      let bounds = BraceBounds(start: cs, end: ce);
      return Some<BraceBounds>(value: bounds);
    }
    Nested(end: e) => {
      return None<BraceBounds>();
    }
    Cdo() => {
      return None<BraceBounds>();
    }
    Cdc() => {
      return None<BraceBounds>();
    }
    Other() => {
      return None<BraceBounds>();
    }
  }
}
