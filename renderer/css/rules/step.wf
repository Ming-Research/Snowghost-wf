alias Component = pkg::css::syntax::Component;
alias Span = pkg::css::syntax::Span;

enum Step {
  Whitespace();
  Semicolon();
  Colon();
  Delim(code_point: u32);
  AtKeyword(name: Span);
  Ident(name: Span);
  Brace(contents_start: u64, contents_end: u64);
  Nested(end: u64);
  Cdo();
  Cdc();
  Other();
}

struct BraceBounds {
  start: u64;
  end: u64;
}

fn classify_step(c: Component, at: u64) -> result: Step pure {
  doc "Classifies the component value c found at index at for rules parsing. A BraceBlock carries its own declared content bounds, since a caller may need to read them; a Function, ParenthesisBlock or BracketBlock carries only its declared end, since a caller only ever skips over one whole; every other component is a leaf, whose caller advances by one.";
  match c {
    Ident(name: n) => {
      return Step::Ident(name: n);
    }
    Function(name: n, end: e) => {
      let wide = cvt::<u32, u64>(e);
      return Step::Nested(end: wide);
    }
    AtKeyword(name: n) => {
      return Step::AtKeyword(name: n);
    }
    Hash(name: n, kind: k) => {
      return Step::Other();
    }
    QuotedString(value: v) => {
      return Step::Other();
    }
    Url(value: v) => {
      return Step::Other();
    }
    Delim(code_point: cp) => {
      return Step::Delim(code_point: cp);
    }
    Number(number: n) => {
      return Step::Other();
    }
    Percentage(number: n) => {
      return Step::Other();
    }
    Dimension(number: n, unit_name: u) => {
      return Step::Other();
    }
    UnicodeRange(start: s, end: e) => {
      return Step::Other();
    }
    IncludeMatch() => {
      return Step::Other();
    }
    DashMatch() => {
      return Step::Other();
    }
    PrefixMatch() => {
      return Step::Other();
    }
    SuffixMatch() => {
      return Step::Other();
    }
    SubstringMatch() => {
      return Step::Other();
    }
    Column() => {
      return Step::Other();
    }
    Whitespace() => {
      return Step::Whitespace();
    }
    Cdo() => {
      return Step::Cdo();
    }
    Cdc() => {
      return Step::Cdc();
    }
    Colon() => {
      return Step::Colon();
    }
    Semicolon() => {
      return Step::Semicolon();
    }
    Comma() => {
      return Step::Other();
    }
    ParenthesisBlock(end: e) => {
      let wide = cvt::<u32, u64>(e);
      return Step::Nested(end: wide);
    }
    BracketBlock(end: e) => {
      let wide = cvt::<u32, u64>(e);
      return Step::Nested(end: wide);
    }
    BraceBlock(end: e) => {
      let contents_end = cvt::<u32, u64>(e);
      let contents_start = at +wrap 1_u64;
      return Step::Brace(contents_start: contents_start, contents_end: contents_end);
    }
    Error(error: er) => {
      return Step::Other();
    }
  }
}

fn bound_next(candidate: u64, at: u64, limit: u64) -> result: u64 pure contract {
  requires at < limit;
  ensures result > at;
  ensures result <= limit;
} {
  doc "Clamps candidate, a Function or block's own declared end, to a proven range: greater than at and at most limit. Every admitted source keeps a nested end inside its parent, so this only ever guards against it; it never truncates a well-formed nesting.";
  let above = candidate > at;
  if above {
    if candidate <= limit {
      return candidate;
    }
    return limit;
  }
  let fallback = at +wrap 1_u64;
  if fallback <= limit {
    return fallback;
  }
  return limit;
}

fn step_advance(step: Step, at: u64, limit: u64) -> result: u64 pure contract {
  requires at < limit;
  ensures result > at;
  ensures result <= limit;
} {
  doc "The sibling following step's component, found at at, at most limit: a Nested or Brace component's own declared end, proven with bound_next, and at + 1 for every leaf.";
  match step {
    Whitespace() => {
      let n = at +wrap 1_u64;
      return n;
    }
    Semicolon() => {
      let n = at +wrap 1_u64;
      return n;
    }
    Colon() => {
      let n = at +wrap 1_u64;
      return n;
    }
    Delim(code_point: cp) => {
      let n = at +wrap 1_u64;
      return n;
    }
    AtKeyword(name: nm) => {
      let n = at +wrap 1_u64;
      return n;
    }
    Ident(name: nm) => {
      let n = at +wrap 1_u64;
      return n;
    }
    Brace(contents_start: cs, contents_end: ce) => {
      let n = bound_next(candidate: ce, at: at, limit: limit);
      return n;
    }
    Nested(end: e) => {
      let n = bound_next(candidate: e, at: at, limit: limit);
      return n;
    }
    Cdo() => {
      let n = at +wrap 1_u64;
      return n;
    }
    Cdc() => {
      let n = at +wrap 1_u64;
      return n;
    }
    Other() => {
      let n = at +wrap 1_u64;
      return n;
    }
  }
}

fn step_is_whitespace(step: Step) -> result: Bool pure {
  doc "True when step classifies a Whitespace component.";
  match step {
    Whitespace() => {
      return True();
    }
    Semicolon() => {
      return False();
    }
    Colon() => {
      return False();
    }
    Delim(code_point: cp) => {
      return False();
    }
    AtKeyword(name: nm) => {
      return False();
    }
    Ident(name: nm) => {
      return False();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return False();
    }
    Nested(end: e) => {
      return False();
    }
    Cdo() => {
      return False();
    }
    Cdc() => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn step_is_semicolon(step: Step) -> result: Bool pure {
  doc "True when step classifies a Semicolon component.";
  match step {
    Whitespace() => {
      return False();
    }
    Semicolon() => {
      return True();
    }
    Colon() => {
      return False();
    }
    Delim(code_point: cp) => {
      return False();
    }
    AtKeyword(name: nm) => {
      return False();
    }
    Ident(name: nm) => {
      return False();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return False();
    }
    Nested(end: e) => {
      return False();
    }
    Cdo() => {
      return False();
    }
    Cdc() => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn step_is_colon(step: Step) -> result: Bool pure {
  doc "True when step classifies a Colon component.";
  match step {
    Whitespace() => {
      return False();
    }
    Semicolon() => {
      return False();
    }
    Colon() => {
      return True();
    }
    Delim(code_point: cp) => {
      return False();
    }
    AtKeyword(name: nm) => {
      return False();
    }
    Ident(name: nm) => {
      return False();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return False();
    }
    Nested(end: e) => {
      return False();
    }
    Cdo() => {
      return False();
    }
    Cdc() => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn step_is_bang(step: Step) -> result: Bool pure {
  doc "True when step classifies a Delim component whose code point is U+0021 EXCLAMATION MARK.";
  match step {
    Whitespace() => {
      return False();
    }
    Semicolon() => {
      return False();
    }
    Colon() => {
      return False();
    }
    Delim(code_point: cp) => {
      let bang = cp == 33_u32;
      return bang;
    }
    AtKeyword(name: nm) => {
      return False();
    }
    Ident(name: nm) => {
      return False();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return False();
    }
    Nested(end: e) => {
      return False();
    }
    Cdo() => {
      return False();
    }
    Cdc() => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn step_is_cdo(step: Step) -> result: Bool pure {
  doc "True when step classifies a Cdo component.";
  match step {
    Whitespace() => {
      return False();
    }
    Semicolon() => {
      return False();
    }
    Colon() => {
      return False();
    }
    Delim(code_point: cp) => {
      return False();
    }
    AtKeyword(name: nm) => {
      return False();
    }
    Ident(name: nm) => {
      return False();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return False();
    }
    Nested(end: e) => {
      return False();
    }
    Cdo() => {
      return True();
    }
    Cdc() => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn step_is_cdc(step: Step) -> result: Bool pure {
  doc "True when step classifies a Cdc component.";
  match step {
    Whitespace() => {
      return False();
    }
    Semicolon() => {
      return False();
    }
    Colon() => {
      return False();
    }
    Delim(code_point: cp) => {
      return False();
    }
    AtKeyword(name: nm) => {
      return False();
    }
    Ident(name: nm) => {
      return False();
    }
    Brace(contents_start: cs, contents_end: ce) => {
      return False();
    }
    Nested(end: e) => {
      return False();
