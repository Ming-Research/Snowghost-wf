alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

public struct ComponentRange {
  public start: u32;
  public end: u32;
}

public enum RuleItem {
  QualifiedRule(public prelude: ComponentRange, public block: ComponentRange);
  AtRule(public name: Span, public prelude: ComponentRange, public block: Option<ComponentRange>);
  Declaration(public name: Span, public value: ComponentRange, public important: Bool);
  Invalid();
}

public enum OneError {
  Empty();
  ExtraInput();
  Invalid();
}

public enum RulesError {
  TooLarge();
}

public struct RuleItems {
  public readonly items: Box<Slots<RuleItem>>;
}

public fn parse_stylesheet(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItems, RulesError> reads(values) doc "Parses the component values of values in range as a stylesheet: a list of rules at the top level, where CDO and CDC components are skipped. Ranges name component values of values.components from start to end: a sequence of siblings with their contents, in the preorder pkg::css::syntax produces, so a range starts at a sibling and ends just after the last content of a sibling. Every range an item holds names the same list: a QualifiedRule's prelude is the siblings before its brace block and its block the contents of that block; an AtRule's name is its at-keyword's name, its prelude the siblings after the at-keyword, and its block the contents of its brace block or None when a semicolon ends it; a Declaration's name is its ident's name and its value the siblings after the colon without surrounding whitespace and without a trailing !important, which sets important. Invalid stands where the suite reports an invalid rule or declaration. The algorithms are CSS Syntax Module Level 3's as css-parsing-tests at revision 203ce36b represents them. TooLarge when the items would pass a storage limit.";

public fn parse_rule_list(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItems, RulesError> reads(values) doc "Parses the component values in range as a list of rules that is not at the top level, so CDO and CDC begin qualified rules, with ranges and items as parse_stylesheet describes.";

public fn parse_declaration_list(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItems, RulesError> reads(values) doc "Parses the component values in range as a list of declarations and at-rules, with ranges and items as parse_stylesheet describes.";

public fn parse_block_contents(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItems, RulesError> reads(values) doc "Parses the component values in range as a block's contents: declarations, at-rules and nested qualified rules, with ranges and items as parse_stylesheet describes.";

public fn parse_one_rule(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItem, OneError> reads(values) doc "Parses the component values in range as exactly one rule, surrounded by optional whitespace: Empty when there is none, ExtraInput when anything follows it, and Invalid when it is invalid; ranges and items as parse_stylesheet describes.";

public fn parse_one_declaration(values: &ComponentList, range: ComponentRange) -> result: Result<RuleItem, OneError> reads(values) doc "Parses the component values in range as exactly one declaration, surrounded by optional whitespace, with the same errors as parse_one_rule.";
