const items_capacity_seed: u64 = 64_u64;

const items_growth_limit: u64 = 16777216_u64;

fn push_item(items: &Box<Slots<RuleItem>>, value: RuleItem) -> result: Result<unit, RulesError> writes(items) {
  doc "Appends value to items. A full cell grows to items_capacity_seed, or doubles while its capacity is at most items_growth_limit, so its capacity never passes the larger of the two; a push past that refuses with TooLarge. There is at most one item per component consumed, so the same order of magnitude as pkg::css::syntax's own component ceiling bounds it.";
  let length = items^.inner.len;
  let capacity = items^.inner.cap;
  let full = length >= capacity;
  if full {
    let small = capacity < items_capacity_seed;
    if small {
      grow(cell: items, capacity: items_capacity_seed);
    } else {
      let within = capacity <= items_growth_limit;
      if within {
      } else {
        let refusal = RulesError::TooLarge();
        return Err<unit, RulesError>(error: refusal);
      }
      let doubled = capacity + capacity;
      grow(cell: items, capacity: doubled);
    }
  }
  place_back(window: &items^.inner, value: value);
  return Ok<unit, RulesError>(value: unit);
}
