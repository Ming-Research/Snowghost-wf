alias ComponentList = pkg::css::syntax::ComponentList;
alias Numeric = pkg::css::syntax::Numeric;
alias Span = pkg::css::syntax::Span;

fn ident_at(values: &ComponentList, at: u64) -> found: Option<Span> reads(values) contract {
  requires at < values^.components.inner.len;
} {
  doc "The name of the identifier at at, or None.";
  match values^.components.inner[at] {
    Ident(name: n) => {
      return Some<Span>(value: n^);
    }
    Function(..) => {
      return None<Span>();
    }
    AtKeyword(..) => {
      return None<Span>();
    }
    Hash(..) => {
      return None<Span>();
    }
    QuotedString(..) => {
      return None<Span>();
    }
    Url(..) => {
      return None<Span>();
    }
    Delim(..) => {
      return None<Span>();
    }
    Number(..) => {
      return None<Span>();
    }
    Percentage(..) => {
      return None<Span>();
    }
    Dimension(..) => {
      return None<Span>();
    }
    UnicodeRange(..) => {
      return None<Span>();
    }
    IncludeMatch() => {
      return None<Span>();
    }
    DashMatch() => {
      return None<Span>();
    }
    PrefixMatch() => {
      return None<Span>();
    }
    SuffixMatch() => {
      return None<Span>();
    }
    SubstringMatch() => {
      return None<Span>();
    }
    Column() => {
      return None<Span>();
    }
    Whitespace() => {
      return None<Span>();
    }
    Cdo() => {
      return None<Span>();
    }
    Cdc() => {
      return None<Span>();
    }
    Colon() => {
      return None<Span>();
    }
    Semicolon() => {
      return None<Span>();
    }
    Comma() => {
      return None<Span>();
    }
    ParenthesisBlock(..) => {
      return None<Span>();
    }
    BracketBlock(..) => {
      return None<Span>();
    }
    BraceBlock(..) => {
      return None<Span>();
    }
    Error(..) => {
      return None<Span>();
    }
  }
}

