alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

const k_ident: u8 = 0_u8;

const k_function: u8 = 1_u8;

const k_hash: u8 = 2_u8;

const k_string: u8 = 3_u8;

const k_delim: u8 = 4_u8;

const k_number: u8 = 5_u8;

const k_percentage: u8 = 6_u8;

const k_dimension: u8 = 7_u8;

const k_whitespace: u8 = 8_u8;

const k_comma: u8 = 9_u8;

const k_paren: u8 = 10_u8;

const k_other: u8 = 11_u8;

const k_bad: u8 = 12_u8;

fn kind_of(component: Component) -> kind: u8 pure {
  doc "Classifies a component value for the value parsers: identifiers, functions, hashes, strings, delimiters, the three numeric kinds, whitespace, commas and parenthesis blocks have their own kind; every other well-formed component is k_other, and an error, a bad string or bad URL is k_bad.";
  match component {
    Ident(..) => {
      return k_ident;
    }
    Function(..) => {
      return k_function;
    }
    AtKeyword(..) => {
      return k_other;
    }
    Hash(..) => {
      return k_hash;
    }
    QuotedString(..) => {
      return k_string;
    }
    Url(..) => {
      return k_other;
    }
    Delim(..) => {
      return k_delim;
    }
    Number(..) => {
      return k_number;
    }
    Percentage(..) => {
      return k_percentage;
    }
    Dimension(..) => {
      return k_dimension;
    }
    UnicodeRange(..) => {
      return k_other;
    }
    IncludeMatch() => {
      return k_other;
    }
    DashMatch() => {
      return k_other;
    }
    PrefixMatch() => {
      return k_other;
    }
    SuffixMatch() => {
      return k_other;
    }
    SubstringMatch() => {
      return k_other;
    }
    Column() => {
      return k_other;
    }
    Whitespace() => {
      return k_whitespace;
    }
    Cdo() => {
      return k_other;
    }
    Cdc() => {
      return k_other;
    }
    Colon() => {
      return k_other;
    }
    Semicolon() => {
      return k_other;
    }
    Comma() => {
      return k_comma;
    }
    ParenthesisBlock(..) => {
      return k_paren;
    }
    BracketBlock(..) => {
      return k_other;
    }
    BraceBlock(..) => {
      return k_other;
    }
    Error(..) => {
      return k_bad;
    }
  }
}

fn sibling_after(values: &ComponentList, at: u64, limit: u64) -> next: u64 reads(values) contract {
  requires at < limit;
  requires limit <= values^.components.inner.len;
  ensures next > at;
  ensures next <= limit;
} {
  doc "Returns the index of the sibling after the component at at, skipping a function's or block's contents, clamped to limit.";
  let one = at + 1_u64;
  let component = values^.components.inner[at];
  let end = match component {
    Function(name: n, end: e) => {
      give e;
    }
    ParenthesisBlock(end: e) => {
      give e;
    }
    BracketBlock(end: e) => {
      give e;
    }
    BraceBlock(end: e) => {
      give e;
    }
    Ident(..) => {
      give 0_u32;
    }
    AtKeyword(..) => {
      give 0_u32;
    }
    Hash(..) => {
      give 0_u32;
    }
    QuotedString(..) => {
      give 0_u32;
    }
    Url(..) => {
      give 0_u32;
    }
    Delim(..) => {
      give 0_u32;
    }
    Number(..) => {
      give 0_u32;
    }
    Percentage(..) => {
      give 0_u32;
    }
    Dimension(..) => {
      give 0_u32;
    }
    UnicodeRange(..) => {
      give 0_u32;
    }
    IncludeMatch() => {
      give 0_u32;
    }
    DashMatch() => {
      give 0_u32;
    }
    PrefixMatch() => {
      give 0_u32;
    }
    SuffixMatch() => {
      give 0_u32;
    }
    SubstringMatch() => {
      give 0_u32;
    }
    Column() => {
      give 0_u32;
    }
    Whitespace() => {
      give 0_u32;
    }
    Cdo() => {
      give 0_u32;
    }
    Cdc() => {
      give 0_u32;
    }
    Colon() => {
      give 0_u32;
    }
    Semicolon() => {
      give 0_u32;
    }
    Comma() => {
      give 0_u32;
    }
    Error(..) => {
      give 0_u32;
    }
  }
  let wide = cvt::<u32, u64>(end);
  if wide > at {
    if wide < limit {
      return wide;
    }
    return limit;
  }
  return one;
}

fn skip_space(values: &ComponentList, at: u64, limit: u64) -> next: u64 reads(values) contract {
  requires limit <= values^.components.inner.len;
  ensures next >= at;
} {
  doc "Returns the first index at or after at, before limit, that is no whitespace component, or the larger of at and limit when there is none.";
  if at >= limit {
    return at;
  }
  let span = limit - at;
  let cursor = at;
  for (step in 0_u64..span) {
    let here = at + step;
    let kind = kind_of(component: values^.components.inner[here]);
    if kind == k_whitespace {
      set cursor = here + 1_u64;
    } else {
      return here;
    }
  }
  return limit;
}

fn trim_end(values: &ComponentList, start: u64, end: u64) -> last: u64 reads(values) contract {
  requires start <= end;
  requires end <= values^.components.inner.len;
  ensures last >= start;
  ensures last <= end;
} {
  doc "Returns end moved back over trailing whitespace components, not below start.";
  let span = end - start;
  let last_seen = end;
  for (step in 0_u64..span) {
    let back = end - step;
    let at = back - 1_u64;
    let kind = kind_of(component: values^.components.inner[at]);
    if kind == k_whitespace {
      set last_seen = at;
    } else {
      break;
    }
  }
  if last_seen < start {
    return start;
  }
  if last_seen > end {
    return end;
  }
  return last_seen;
}

fn text_of(values: &ComponentList, span: Span) -> (start: u64, end: u64) reads(values) contract {
  ensures start <= end;
  ensures end <= values^.text.inner.len;
} {
  doc "Returns span's byte bounds in values.text, empty when the span is reversed or out of the text.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = values^.text.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
    return start, end;
  }
  return 0_u64, 0_u64;
}

fn lower_byte(byte: u8) -> lower: u8 pure {
  doc "Lowers an ASCII upper-case letter.";
  let from_a = byte >= 65_u8;
  let to_z = byte <= 90_u8;
  let upper = band(from_a, to_z);
  if upper {
    let lowered = byte + 32_u8;
    return lowered;
  }
  return byte;
}

fn find_word(list: &[u8], text: &[u8]) -> found: Option<u64> reads(list), reads(text) {
  doc "Returns the number of the space-separated word of list equal to text, ASCII case-insensitively (list is lower case), or None.";
  let length = list^.len;
  let size = text^.len;
  if size == 0_u64 {
    return None<u64>();
  }
  let word = 0_u64;
  let start = 0_u64;
  for (at in 0_u64..length) {
    let space = list^[at] == 32_u8;
    if space {
      let matched = word_matches(list: list, start: start, end: at, text: text);
      if matched {
        return Some<u64>(value: word);
      }
      set word = word +sat 1_u64;
      set start = at +sat 1_u64;
    }
  }
  let last = word_matches(list: list, start: start, end: length, text: text);
  if last {
    return Some<u64>(value: word);
  }
  return None<u64>();
}

fn word_matches(list: &[u8], start: u64, end: u64, text: &[u8]) -> same: Bool reads(list), reads(text) {
  doc "True when list[start..end] equals text ASCII case-insensitively, list being lower case.";
  let ordered = start <= end;
  let inside = end <= list^.len;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return False();
  }
  let width = end - start;
  let size = text^.len;
  if width != size {
    return False();
  }
  for (k in 0_u64..size) {
    let index = start + k;
    let a = list^[index];
    let b = lower_byte(byte: text^[k]);
    if a != b {
      return False();
    }
  }
  return True();
}

fn same_lower(text: &[u8], word: &[u8]) -> same: Bool reads(text), reads(word) {
  doc "True when text equals word (lower case) ASCII case-insensitively.";
  let size = word^.len;
  if text^.len != size {
    return False();
  }
  for (k in 0_u64..size) {
    let a = lower_byte(byte: text^[k]);
    if a != word^[k] {
      return False();
    }
  }
  return True();
}

fn ident_is(values: &ComponentList, at: u64, word: &[u8]) -> same: Bool reads(values), reads(word) contract {
  requires at < values^.components.inner.len;
} {
  doc "True when the component at at is an identifier equal to word ASCII case-insensitively.";
  match values^.components.inner[at] {
    Ident(name: n) => {
      let (start, end) = text_of(values: values, span: n^);
      let same = same_lower(text: &values^.text.inner[start..end], word: word);
      return same;
    }
    Function(..) => {
      return False();
    }
    AtKeyword(..) => {
      return False();
    }
    Hash(..) => {
      return False();
    }
    QuotedString(..) => {
      return False();
    }
    Url(..) => {
      return False();
    }
    Delim(..) => {
      return False();
    }
    Number(..) => {
      return False();
    }
    Percentage(..) => {
      return False();
    }
    Dimension(..) => {
      return False();
    }
    UnicodeRange(..) => {
      return False();
    }
    IncludeMatch() => {
      return False();
    }
    DashMatch() => {
      return False();
    }
    PrefixMatch() => {
      return False();
    }
    SuffixMatch() => {
      return False();
    }
    SubstringMatch() => {
      return False();
    }
    Column() => {
      return False();
    }
    Whitespace() => {
      return False();
    }
    Cdo() => {
      return False();
    }
    Cdc() => {
      return False();
    }
    Colon() => {
      return False();
    }
    Semicolon() => {
      return False();
    }
    Comma() => {
      return False();
    }
    ParenthesisBlock(..) => {
      return False();
    }
    BracketBlock(..) => {
      return False();
    }
    BraceBlock(..) => {
      return False();
    }
    Error(..) => {
      return False();
    }
  }
}
