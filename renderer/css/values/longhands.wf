alias Atom = pkg::base::atom::Atom;

const longhand_names: Array<u8, 1252> = "display position float clear overflow-x overflow-y box-sizing visibility z-index width height min-width min-height max-width max-height top right bottom left margin-top margin-right margin-bottom margin-left padding-top padding-right padding-bottom padding-left border-top-width border-right-width border-bottom-width border-left-width border-top-style border-right-style border-bottom-style border-left-style border-top-color border-right-color border-bottom-color border-left-color font-family font-size font-weight font-style line-height color text-align text-indent text-transform white-space letter-spacing word-spacing vertical-align text-decoration-line list-style-type background-color flex-direction flex-wrap justify-content align-items align-content justify-items row-gap column-gap grid-template-columns grid-template-rows grid-template-areas grid-auto-flow grid-auto-columns grid-auto-rows order flex-grow flex-shrink flex-basis align-self justify-self grid-row-start grid-row-end grid-column-start grid-column-end aspect-ratio border-collapse border-spacing table-layout caption-side content counter-reset counter-increment counter-set quotes list-style-position overflow-wrap word-break column-count column-width column-fill break-inside";

const display_words: Array<u8, 284> = "inline block none contents list-item inline-block flow-root table inline-table table-row-group table-header-group table-footer-group table-row table-cell table-column-group table-column table-caption flex inline-flex grid inline-grid ruby ruby-text math -webkit-box -webkit-inline-box";

const position_words: Array<u8, 37> = "static relative absolute fixed sticky";

const float_words: Array<u8, 39> = "none left right inline-start inline-end";

const clear_words: Array<u8, 44> = "none left right both inline-start inline-end";

const overflow_words: Array<u8, 31> = "visible hidden clip scroll auto";

const box_sizing_words: Array<u8, 22> = "content-box border-box";

const visibility_words: Array<u8, 23> = "visible hidden collapse";

const border_style_words: Array<u8, 64> = "none hidden dotted dashed solid double groove ridge inset outset";

const font_style_words: Array<u8, 21> = "normal italic oblique";

const text_align_words: Array<u8, 90> = "start end left right center justify match-parent -webkit-left -webkit-right -webkit-center";

const text_transform_words: Array<u8, 61> = "none capitalize uppercase lowercase full-width full-size-kana";

const white_space_words: Array<u8, 48> = "normal pre nowrap pre-wrap pre-line break-spaces";

const vertical_align_words: Array<u8, 57> = "baseline sub super text-top text-bottom middle top bottom";

const size_words: Array<u8, 58> = "min-content max-content fit-content -webkit-fill-available";

const font_size_words: Array<u8, 77> = "xx-small x-small small medium large x-large xx-large xxx-large larger smaller";

const alias_names: Array<u8, 99> = "word-wrap grid-row-gap grid-column-gap -webkit-column-count -webkit-column-width -webkit-column-gap";

const flex_direction_words: Array<u8, 37> = "row row-reverse column column-reverse";

const flex_wrap_words: Array<u8, 24> = "nowrap wrap wrap-reverse";

const border_collapse_words: Array<u8, 17> = "separate collapse";

const table_layout_words: Array<u8, 10> = "auto fixed";

const caption_side_words: Array<u8, 10> = "top bottom";

const list_position_words_long: Array<u8, 14> = "outside inside";

const overflow_wrap_words: Array<u8, 26> = "normal break-word anywhere";

const word_break_words: Array<u8, 36> = "normal break-all keep-all break-word";

const column_fill_words: Array<u8, 24> = "balance auto balance-all";

const break_inside_words: Array<u8, 34> = "auto avoid avoid-page avoid-column";

const flex_basis_words: Array<u8, 66> = "min-content max-content fit-content -webkit-fill-available content";

const align_words: Array<u8, 157> = "normal stretch start end center flex-start flex-end self-start self-end left right baseline last-baseline space-between space-around space-evenly auto legacy";

const g_keyword: u8 = 0_u8;

const g_z_index: u8 = 1_u8;

const g_size: u8 = 2_u8;

const g_max_size: u8 = 3_u8;

const g_inset: u8 = 4_u8;

const g_margin: u8 = 5_u8;

const g_padding: u8 = 6_u8;

const g_border_width: u8 = 7_u8;

const g_color: u8 = 8_u8;

const g_family: u8 = 9_u8;

const g_font_size: u8 = 10_u8;

const g_font_weight: u8 = 11_u8;

const g_line_height: u8 = 12_u8;

const g_length_percentage: u8 = 13_u8;

const g_spacing: u8 = 14_u8;

const g_vertical_align: u8 = 15_u8;

const g_decoration: u8 = 16_u8;

const g_list_style: u8 = 17_u8;

const g_align: u8 = 18_u8;

const g_gap: u8 = 19_u8;

const g_tracks: u8 = 20_u8;

const g_areas: u8 = 21_u8;

const g_flow: u8 = 22_u8;

const g_auto_tracks: u8 = 23_u8;

const g_order: u8 = 24_u8;

const g_factor: u8 = 25_u8;

const g_basis: u8 = 26_u8;

const g_line: u8 = 27_u8;

const g_ratio: u8 = 28_u8;

const g_spacing_pair: u8 = 29_u8;

const g_content: u8 = 30_u8;

const g_counters: u8 = 31_u8;

const g_quotes: u8 = 32_u8;

const g_column_count: u8 = 33_u8;

const g_column_width: u8 = 34_u8;

fn declaration_store_new() -> made: DeclarationStore pure {
  doc "Returns an empty store.";
  let declarations = box_slots_new::<Declaration>(capacity: 0_u64);
  let families = box_slots_new::<Family>(capacity: 0_u64);
  let tracks = box_slots_new::<DeclaredTrack>(capacity: 0_u64);
  let track_lists = box_slots_new::<TrackList>(capacity: 0_u64);
  let line_names = box_slots_new::<Atom>(capacity: 0_u64);
  let area_maps = box_slots_new::<AreaMap>(capacity: 0_u64);
  let named_areas = box_slots_new::<NamedArea>(capacity: 0_u64);
  let grid_lines = box_slots_new::<GridLine>(capacity: 0_u64);
  let content_lists = box_slots_new::<ContentList>(capacity: 0_u64);
  let content_items = box_slots_new::<ContentItem>(capacity: 0_u64);
  let counter_lists = box_slots_new::<CounterList>(capacity: 0_u64);
  let counter_changes = box_slots_new::<CounterChange>(capacity: 0_u64);
  let quote_lists = box_slots_new::<QuoteList>(capacity: 0_u64);
  let quote_pairs = box_slots_new::<QuotePair>(capacity: 0_u64);
  let text = box_slots_new::<u8>(capacity: 0_u64);
  let spacings = box_slots_new::<Lengths>(capacity: 0_u64);
  return DeclarationStore(declarations: move declarations, families: move families, tracks: move tracks, track_lists: move track_lists, line_names: move line_names, area_maps: move area_maps, named_areas: move named_areas, grid_lines: move grid_lines, content_lists: move content_lists, content_items: move content_items, counter_lists: move counter_lists, counter_changes: move counter_changes, quote_lists: move quote_lists, quote_pairs: move quote_pairs, text: move text, spacings: move spacings);
}

fn shorthand_none() -> code: u8 pure {
  doc "The shorthand number of a longhand declared by itself.";
  return 255_u8;
}

fn longhand_of(name: &[u8]) -> found: Option<u8> reads(name) {
  doc "Looks name up among the longhand names, which are in longhand order, then among the aliases Chromium keeps: word-wrap for overflow-wrap, grid-row-gap and grid-column-gap for row-gap and column-gap, and -webkit-column-count, -webkit-column-width and -webkit-column-gap for column-count, column-width and column-gap.";
  let count = longhand_names.len;
  let index = find_word(list: &longhand_names[0_u64..count], text: name);
  match index {
    Some(value: i) => {
      let small = i < longhand_count;
      if small {
        let code = cvt::<u64, u8>(i);
        return Some<u8>(value: code);
      }
      return None<u8>();
    }
    None() => {
    }
  }
  let alias_count = alias_names.len;
  let aliased = find_word(list: &alias_names[0_u64..alias_count], text: name);
  match aliased {
    Some(value: a) => {
      if a == 0_u64 {
        return Some<u8>(value: lh_overflow_wrap);
      }
      if a == 1_u64 {
        return Some<u8>(value: lh_row_gap);
      }
      if a == 3_u64 {
        return Some<u8>(value: lh_column_count);
      }
      if a == 4_u64 {
        return Some<u8>(value: lh_column_width);
      }
      return Some<u8>(value: lh_column_gap);
    }
    None() => {
      return None<u8>();
    }
  }
}

fn longhand_inherited(longhand: u8) -> inherited: Bool pure {
  doc "Visibility, the font longhands, the text longhands but vertical-align and text-decoration-line, list-style-type, border-collapse, border-spacing, caption-side, quotes, list-style-position, overflow-wrap and word-break are inherited.";
  if longhand == lh_visibility {
    return True();
  }
  let from_font = longhand >= lh_font_family;
  let to_white = longhand <= lh_word_spacing;
  let text = band(from_font, to_white);
  if text {
    return True();
  }
  if longhand == lh_list_style_type {
    return True();
  }
  let collapse = longhand == lh_border_collapse;
  let spacing = longhand == lh_border_spacing;
  let caption = longhand == lh_caption_side;
  let quotes = longhand == lh_quotes;
  let table = bor(collapse, spacing);
  let generated = bor(caption, quotes);
  let some = bor(table, generated);
  if some {
    return True();
  }
  let from_position = longhand >= lh_list_style_position;
  let to_break = longhand <= lh_word_break;
  let wrapping = band(from_position, to_break);
  return wrapping;
}

fn grammar_of(longhand: u8) -> grammar: u8 pure {
  doc "Returns the value grammar the longhand's declarations follow.";
  if longhand <= lh_visibility {
    return g_keyword;
  }
  if longhand == lh_z_index {
    return g_z_index;
  }
  if longhand <= lh_min_height {
    return g_size;
  }
  if longhand <= lh_max_height {
    return g_max_size;
  }
  if longhand <= lh_left {
    return g_inset;
  }
  if longhand <= lh_margin_left {
    return g_margin;
  }
  if longhand <= lh_padding_left {
    return g_padding;
  }
  if longhand <= lh_border_left_width {
    return g_border_width;
  }
  if longhand <= lh_border_left_style {
    return g_keyword;
  }
  if longhand <= lh_border_left_color {
    return g_color;
  }
  if longhand == lh_font_family {
    return g_family;
  }
  if longhand == lh_font_size {
    return g_font_size;
  }
  if longhand == lh_font_weight {
    return g_font_weight;
  }
  if longhand == lh_font_style {
    return g_keyword;
  }
  if longhand == lh_line_height {
    return g_line_height;
  }
  if longhand == lh_color {
    return g_color;
  }
  if longhand == lh_text_align {
    return g_keyword;
  }
  if longhand == lh_text_indent {
    return g_length_percentage;
  }
  if longhand == lh_text_transform {
    return g_keyword;
  }
  if longhand == lh_white_space {
    return g_keyword;
  }
  if longhand <= lh_word_spacing {
    return g_spacing;
  }
  if longhand == lh_vertical_align {
    return g_vertical_align;
  }
  if longhand == lh_text_decoration_line {
    return g_decoration;
  }
  if longhand == lh_list_style_type {
    return g_list_style;
  }
  if longhand == lh_background_color {
    return g_color;
  }
  let new_grammar = grammar_of_second(longhand: longhand);
  return new_grammar;
}

fn grammar_of_second(longhand: u8) -> grammar: u8 pure {
  doc "Returns the value grammar of a longhand of the second batch, from flex-direction to break-inside.";
  if longhand <= lh_flex_wrap {
    return g_keyword;
  }
  if longhand <= lh_justify_items {
    return g_align;
  }
  if longhand <= lh_column_gap {
    return g_gap;
  }
  if longhand <= lh_grid_template_rows {
    return g_tracks;
  }
  if longhand == lh_grid_template_areas {
    return g_areas;
  }
  if longhand == lh_grid_auto_flow {
    return g_flow;
  }
  if longhand <= lh_grid_auto_rows {
    return g_auto_tracks;
  }
  if longhand == lh_order {
    return g_order;
  }
  if longhand <= lh_flex_shrink {
    return g_factor;
  }
  if longhand == lh_flex_basis {
    return g_basis;
  }
  if longhand <= lh_justify_self {
    return g_align;
  }
  if longhand <= lh_grid_column_end {
    return g_line;
  }
  if longhand == lh_aspect_ratio {
    return g_ratio;
  }
  if longhand == lh_border_spacing {
    return g_spacing_pair;
  }
  if longhand == lh_content {
    return g_content;
  }
  let counters_from = longhand >= lh_counter_reset;
  let counters_to = longhand <= lh_counter_set;
  let counters = band(counters_from, counters_to);
  if counters {
    return g_counters;
  }
  if longhand == lh_quotes {
    return g_quotes;
  }
  if longhand == lh_column_count {
    return g_column_count;
  }
  if longhand == lh_column_width {
    return g_column_width;
  }
  return g_keyword;
}

fn second_lookup(longhand: u8, text: &[u8]) -> found: Option<u64> reads(text) {
  doc "Looks text up in the keyword list of a longhand of the second batch; the alignment longhands share align_words, numbered as the align_ constants, and flex-basis has the size keywords then content.";
  if longhand == lh_flex_direction {
    let n = flex_direction_words.len;
    let found = find_word(list: &flex_direction_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_flex_wrap {
    let n = flex_wrap_words.len;
    let found = find_word(list: &flex_wrap_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_border_collapse {
    let n = border_collapse_words.len;
    let found = find_word(list: &border_collapse_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_table_layout {
    let n = table_layout_words.len;
    let found = find_word(list: &table_layout_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_caption_side {
    let n = caption_side_words.len;
    let found = find_word(list: &caption_side_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_list_style_position {
    let n = list_position_words_long.len;
    let found = find_word(list: &list_position_words_long[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_overflow_wrap {
    let n = overflow_wrap_words.len;
    let found = find_word(list: &overflow_wrap_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_word_break {
    let n = word_break_words.len;
    let found = find_word(list: &word_break_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_column_fill {
    let n = column_fill_words.len;
    let found = find_word(list: &column_fill_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_break_inside {
    let n = break_inside_words.len;
    let found = find_word(list: &break_inside_words[0_u64..n], text: text);
    return found;
  }
  if longhand == lh_flex_basis {
    let n = flex_basis_words.len;
    let found = find_word(list: &flex_basis_words[0_u64..n], text: text);
    return found;
  }
  let grammar = grammar_of(longhand: longhand);
  if grammar == g_align {
    let n = align_words.len;
    let found = find_word(list: &align_words[0_u64..n], text: text);
    return found;
  }
  return None<u64>();
}

fn keyword_lookup(longhand: u8, text: &[u8]) -> found: Option<u8> reads(text) {
  doc "Returns the number of text in the longhand's keyword list, ASCII case-insensitively, or None.";
  let second = longhand >= lh_flex_direction;
  if second {
    let looked = second_lookup(longhand: longhand, text: text);
    match looked {
      Some(value: i) => {
        let small = i < 256_u64;
        if small {
          let code = cvt::<u64, u8>(i);
          return Some<u8>(value: code);
        }
        return None<u8>();
      }
      None() => {
        return None<u8>();
      }
    }
  }
  let index = if longhand == lh_display {
    let n = display_words.len;
    give find_word(list: &display_words[0_u64..n], text: text);
  } else if longhand == lh_position {
    let n = position_words.len;
    give find_word(list: &position_words[0_u64..n], text: text);
  } else if longhand == lh_float {
    let n = float_words.len;
    give find_word(list: &float_words[0_u64..n], text: text);
  } else if longhand == lh_clear {
    let n = clear_words.len;
    give find_word(list: &clear_words[0_u64..n], text: text);
  } else if longhand == lh_overflow_x {
    let n = overflow_words.len;
    give find_word(list: &overflow_words[0_u64..n], text: text);
  } else if longhand == lh_overflow_y {
    let n = overflow_words.len;
    give find_word(list: &overflow_words[0_u64..n], text: text);
  } else if longhand == lh_box_sizing {
    let n = box_sizing_words.len;
    give find_word(list: &box_sizing_words[0_u64..n], text: text);
  } else if longhand == lh_visibility {
    let n = visibility_words.len;
    give find_word(list: &visibility_words[0_u64..n], text: text);
  } else if longhand == lh_font_style {
    let n = font_style_words.len;
    give find_word(list: &font_style_words[0_u64..n], text: text);
  } else if longhand == lh_text_align {
    let n = text_align_words.len;
    give find_word(list: &text_align_words[0_u64..n], text: text);
  } else if longhand == lh_text_transform {
    let n = text_transform_words.len;
    give find_word(list: &text_transform_words[0_u64..n], text: text);
  } else if longhand == lh_white_space {
    let n = white_space_words.len;
    give find_word(list: &white_space_words[0_u64..n], text: text);
  } else if longhand == lh_vertical_align {
    let n = vertical_align_words.len;
    give find_word(list: &vertical_align_words[0_u64..n], text: text);
  } else if longhand == lh_font_size {
    let n = font_size_words.len;
    give find_word(list: &font_size_words[0_u64..n], text: text);
  } else {
    let style_from = longhand >= lh_border_top_style;
    let style_to = longhand <= lh_border_left_style;
    let border = band(style_from, style_to);
    if border {
      let n = border_style_words.len;
      give find_word(list: &border_style_words[0_u64..n], text: text);
    } else {
      let n = size_words.len;
      give find_word(list: &size_words[0_u64..n], text: text);
    }
  }
  match index {
    Some(value: i) => {
      let small = i < 256_u64;
      if small {
        let code = cvt::<u64, u8>(i);
        return Some<u8>(value: code);
      }
      return None<u8>();
    }
    None() => {
      return None<u8>();
    }
  }
}

fn keyword_count(longhand: u8) -> count: u64 pure {
  doc "Counts the words of the longhand's keyword list.";
  let out = box_slots_new::<u8>(capacity: 0_u64);
  let total = 0_u64;
  for (k in 0_u64..255_u64) {
    let code = cvt::<u64, u8>(k);
    let before = out.inner.len;
    put_keyword(out: &out, longhand: longhand, keyword: code);
    let after = out.inner.len;
    if after == before {
      return total;
    }
    set total = total +sat 1_u64;
  }
  return total;
}

fn put_word(out: &Box<Slots<u8>>, list: &[u8], index: u64) -> result: unit reads(list), writes(out) {
  doc "Appends word number index of the space-separated list to out, or nothing when list has fewer words.";
  let length = list^.len;
  let word = 0_u64;
  let start = 0_u64;
  let stop = length +sat 1_u64;
  for (at in 0_u64..stop) {
    let boundary = at >= length;
    let space = if boundary {
      give True();
    } else {
      give list^[at] == 32_u8;
    }
    if space {
      if word == index {
        for (k in start..at) {
          let inside = k < length;
          if inside {
            let byte = list^[k];
            append_byte(out: out, value: byte);
          }
        }
        return unit;
      }
      set word = word +sat 1_u64;
      set start = at +sat 1_u64;
    }
  }
  return unit;
}

fn append_byte(out: &Box<Slots<u8>>, value: u8) -> result: unit writes(out) {
  doc "Appends one byte to out, doubling its capacity when full, and drops it past 2^32 bytes.";
  let length = out^.inner.len;
  let capacity = out^.inner.cap;
  if length >= capacity {
    let small = capacity < 16_u64;
    if small {
      grow(cell: out, capacity: 16_u64);
    } else {
      let limit = capacity < 2147483648_u64;
      if limit {
        let doubled = capacity + capacity;
        grow(cell: out, capacity: doubled);
      } else {
        return unit;
      }
    }
  }
  let room = out^.inner.len < out^.inner.cap;
  if room {
    place_back(window: &out^.inner, value: value);
  }
  return unit;
}

const last_baseline_text: Array<u8, 13> = "last baseline";

const flow_words: Array<u8, 23> = "row column dense column";

fn put_second_keyword(out: &Box<Slots<u8>>, longhand: u8, keyword: u8) -> result: unit writes(out) {
  doc "Appends the spelling of a keyword of a longhand of the second batch: last baseline in two words, and grid-auto-flow's bits as row, column, dense or column dense, as Chromium serializes them.";
  let index = cvt::<u8, u64>(keyword);
  if longhand == lh_flex_direction {
    let n = flex_direction_words.len;
    put_word(out: out, list: &flex_direction_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_flex_wrap {
    let n = flex_wrap_words.len;
    put_word(out: out, list: &flex_wrap_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_border_collapse {
    let n = border_collapse_words.len;
    put_word(out: out, list: &border_collapse_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_table_layout {
    let n = table_layout_words.len;
    put_word(out: out, list: &table_layout_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_caption_side {
    let n = caption_side_words.len;
    put_word(out: out, list: &caption_side_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_list_style_position {
    let n = list_position_words_long.len;
    put_word(out: out, list: &list_position_words_long[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_overflow_wrap {
    let n = overflow_wrap_words.len;
    put_word(out: out, list: &overflow_wrap_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_word_break {
    let n = word_break_words.len;
    put_word(out: out, list: &word_break_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_column_fill {
    let n = column_fill_words.len;
    put_word(out: out, list: &column_fill_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_break_inside {
    let n = break_inside_words.len;
    put_word(out: out, list: &break_inside_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_flex_basis {
    let n = flex_basis_words.len;
    put_word(out: out, list: &flex_basis_words[0_u64..n], index: index);
    return unit;
  }
  if longhand == lh_grid_auto_flow {
    let flow_n = flow_words.len;
    if index > 3_u64 {
      return unit;
    }
    let column_bit = iand(keyword, flow_column);
    let dense_bit = iand(keyword, flow_dense);
    let column = column_bit != 0_u8;
    let dense = dense_bit != 0_u8;
    if column {
      put_word(out: out, list: &flow_words[0_u64..flow_n], index: 1_u64);
      if dense {
        append_byte(out: out, value: 32_u8);
        put_word(out: out, list: &flow_words[0_u64..flow_n], index: 2_u64);
      }
      return unit;
    }
    if dense {
      put_word(out: out, list: &flow_words[0_u64..flow_n], index: 2_u64);
      return unit;
    }
    put_word(out: out, list: &flow_words[0_u64..flow_n], index: 0_u64);
    return unit;
  }
  let grammar = grammar_of(longhand: longhand);
  if grammar == g_align {
    if keyword == align_last_baseline {
      let n = last_baseline_text.len;
      for (k in 0_u64..n) {
        let byte = last_baseline_text[k];
        append_byte(out: out, value: byte);
      }
      return unit;
    }
    let n = align_words.len;
    put_word(out: out, list: &align_words[0_u64..n], index: index);
  }
  return unit;
}

fn put_keyword(out: &Box<Slots<u8>>, longhand: u8, keyword: u8) -> result: unit writes(out) {
  doc "Appends the keyword's spelling from the longhand's list.";
  let index = cvt::<u8, u64>(keyword);
  let second = longhand >= lh_flex_direction;
  if second {
    put_second_keyword(out: out, longhand: longhand, keyword: keyword);
    return unit;
  }
  if longhand == lh_display {
    let n = display_words.len;
    put_word(out: out, list: &display_words[0_u64..n], index: index);
  } else if longhand == lh_position {
    let n = position_words.len;
    put_word(out: out, list: &position_words[0_u64..n], index: index);
  } else if longhand == lh_float {
    let n = float_words.len;
    put_word(out: out, list: &float_words[0_u64..n], index: index);
  } else if longhand == lh_clear {
    let n = clear_words.len;
    put_word(out: out, list: &clear_words[0_u64..n], index: index);
  } else if longhand == lh_overflow_x {
    let n = overflow_words.len;
    put_word(out: out, list: &overflow_words[0_u64..n], index: index);
  } else if longhand == lh_overflow_y {
    let n = overflow_words.len;
    put_word(out: out, list: &overflow_words[0_u64..n], index: index);
  } else if longhand == lh_box_sizing {
    let n = box_sizing_words.len;
    put_word(out: out, list: &box_sizing_words[0_u64..n], index: index);
  } else if longhand == lh_visibility {
    let n = visibility_words.len;
    put_word(out: out, list: &visibility_words[0_u64..n], index: index);
  } else if longhand == lh_font_style {
    let n = font_style_words.len;
    put_word(out: out, list: &font_style_words[0_u64..n], index: index);
  } else if longhand == lh_text_align {
    let n = text_align_words.len;
    put_word(out: out, list: &text_align_words[0_u64..n], index: index);
  } else if longhand == lh_text_transform {
    let n = text_transform_words.len;
    put_word(out: out, list: &text_transform_words[0_u64..n], index: index);
  } else if longhand == lh_white_space {
    let n = white_space_words.len;
    put_word(out: out, list: &white_space_words[0_u64..n], index: index);
  } else if longhand == lh_vertical_align {
    let n = vertical_align_words.len;
    put_word(out: out, list: &vertical_align_words[0_u64..n], index: index);
  } else if longhand == lh_font_size {
    let n = font_size_words.len;
    put_word(out: out, list: &font_size_words[0_u64..n], index: index);
  } else {
    let style_from = longhand >= lh_border_top_style;
    let style_to = longhand <= lh_border_left_style;
    let border = band(style_from, style_to);
    if border {
      let n = border_style_words.len;
      put_word(out: out, list: &border_style_words[0_u64..n], index: index);
    } else {
      let n = size_words.len;
      put_word(out: out, list: &size_words[0_u64..n], index: index);
    }
  }
  return unit;
}
