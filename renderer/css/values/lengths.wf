}

fn number_at(values: &ComponentList, at: u64, limit: u64) -> parsed: Option<Parsed> reads(values) contract {
  requires at < limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses one <number> at at: a number component or a calc() whose result is a number.";
  let next = sibling_after(values: values, at: at, limit: limit);
  match values^.components.inner[at] {
    Number(number: n) => {
      let made = calc_number(value: n^.value);
      let made_value = Parsed(value: made, next: next);
      return Some<Parsed>(value: made_value);
    }
    Function(name: f, end: e) => {
      let calc = is_calc_name(values: values, name: f^);
      if calc {
      } else {
        return None<Parsed>();
      }
      let inner_start = at + 1_u64;
      match sum_in(values: values, start: inner_start, end: next, depth: 0_u64) {
        Some(value: v) => {
          if v.is_number {
            let made_value = Parsed(value: v, next: next);
            return Some<Parsed>(value: made_value);
          }
          return None<Parsed>();
        }
        None() => {
          return None<Parsed>();
        }
      }
    }
    Ident(..) => {
      return None<Parsed>();
    }
    AtKeyword(..) => {
      return None<Parsed>();
    }
    Hash(..) => {
      return None<Parsed>();
    }
    QuotedString(..) => {
      return None<Parsed>();
    }
    Url(..) => {
      return None<Parsed>();
    }
    Delim(..) => {
      return None<Parsed>();
    }
    Percentage(..) => {
      return None<Parsed>();
    }
    Dimension(..) => {
      return None<Parsed>();
    }
    UnicodeRange(..) => {
      return None<Parsed>();
    }
    IncludeMatch() => {
      return None<Parsed>();
    }
    DashMatch() => {
      return None<Parsed>();
    }
    PrefixMatch() => {
      return None<Parsed>();
    }
    SuffixMatch() => {
      return None<Parsed>();
    }
    SubstringMatch() => {
      return None<Parsed>();
    }
    Column() => {
      return None<Parsed>();
    }
    Whitespace() => {
      return None<Parsed>();
    }
    Cdo() => {
      return None<Parsed>();
    }
    Cdc() => {
      return None<Parsed>();
    }
    Colon() => {
      return None<Parsed>();
    }
    Semicolon() => {
      return None<Parsed>();
    }
    Comma() => {
      return None<Parsed>();
    }
    ParenthesisBlock(..) => {
      return None<Parsed>();
    }
    BracketBlock(..) => {
      return None<Parsed>();
    }
    BraceBlock(..) => {
      return None<Parsed>();
    }
    Error(..) => {
      return None<Parsed>();
    }
  }
}

fn compute_length(lengths: Lengths, font_size: f32, ex: f32, ch: f32, environment: Environment) -> computed: LengthPercentage pure {
  doc "Folds every absolute and font- or viewport-relative part into px and keeps the percentage.";
  let w = fdiv.strict(environment.width, 1.0e2_f32);
  let h = fdiv.strict(environment.height, 1.0e2_f32);
  let small = if flt(w, h) {
    give w;
  } else {
    give h;
  }
  let large = if flt(w, h) {
    give h;
  } else {
    give w;
  }
  let a = fmul.strict(lengths.em, font_size);
  let b = fmul.strict(lengths.rem, environment.root_font_size);
  let c = fmul.strict(lengths.ex, ex);
  let d = fmul.strict(lengths.ch, ch);
  let e = fmul.strict(lengths.vw, w);
  let f = fmul.strict(lengths.vh, h);
  let g = fmul.strict(lengths.vmin, small);
  let i = fmul.strict(lengths.vmax, large);
  let s1 = fadd.strict(lengths.px, a);
  let s2 = fadd.strict(s1, b);
  let s3 = fadd.strict(s2, c);
  let s4 = fadd.strict(s3, d);
  let s5 = fadd.strict(s4, e);
  let s6 = fadd.strict(s5, f);
  let s7 = fadd.strict(s6, g);
  let px = fadd.strict(s7, i);
  let has_percent = fne(lengths.percent, 0.0_f32);
  return LengthPercentage(px: px, percent: lengths.percent, has_percent: has_percent);
}
