public struct Lengths {
  public px: f32;
  public em: f32;
  public rem: f32;
  public ex: f32;
  public ch: f32;
  public vw: f32;
  public vh: f32;
  public vmin: f32;
  public vmax: f32;
  public percent: f32;
}

public enum Declared {
  Keyword(public keyword: u8);
  Length(public value: Lengths);
  Number(public value: f32);
  Integer(public value: i32);
  ColorValue(public color: Color);
  CurrentColor();
  Families(public start: u32, public end: u32);
  ListStyle(public name: Atom);
  Wide(public keyword: u8);
  Pending(public sheet: u32, public start: u32, public end: u32, public shorthand: u8);
}

public struct Declaration {
  public longhand: u8;
  public important: Bool;
  public value: Declared;
}

public struct Family {
  public name: Atom;
  public generic: Bool;
}

public struct DeclarationStore {
  public readonly declarations: Box<Slots<Declaration>>;
  public readonly families: Box<Slots<Family>>;
}

public enum ValuesError {
  TooLarge();
}

public struct Environment {
  public width: f32;
  public height: f32;
  public root_font_size: f32;
}

public struct LengthPercentage {
  public px: f32;
  public percent: f32;
  public has_percent: Bool;
}

public struct Sizing {
  public kind: u8;
  public keyword: u8;
  public value: LengthPercentage;
}

public struct ColorRef {
  public current: Bool;
  public color: Color;
}

public struct BoxGroup {
  public display: u8;
  public position: u8;
  public float: u8;
  public clear: u8;
  public overflow_x: u8;
  public overflow_y: u8;
  public box_sizing: u8;
  public visibility: u8;
  public z_auto: Bool;
  public z_index: i32;
}

public struct SizeGroup {
  public width: Sizing;
  public height: Sizing;
  public min_width: Sizing;
  public min_height: Sizing;
  public max_width: Sizing;
  public max_height: Sizing;
  public top: Sizing;
  public right: Sizing;
  public bottom: Sizing;
  public left: Sizing;
}

public struct SpacingGroup {
  public margin_top: Sizing;
  public margin_right: Sizing;
  public margin_bottom: Sizing;
  public margin_left: Sizing;
  public padding_top: LengthPercentage;
  public padding_right: LengthPercentage;
  public padding_bottom: LengthPercentage;
  public padding_left: LengthPercentage;
}

public struct BorderGroup {
  public top_width: f32;
  public right_width: f32;
  public bottom_width: f32;
  public left_width: f32;
  public top_style: u8;
  public right_style: u8;
  public bottom_style: u8;
  public left_style: u8;
  public top_color: ColorRef;
  public right_color: ColorRef;
  public bottom_color: ColorRef;
  public left_color: ColorRef;
}

public struct FontGroup {
  public families_start: u32;
  public families_end: u32;
  public size: f32;
  public weight: f32;
  public style: u8;
  public line_height: Sizing;
}

public struct TextGroup {
  public color: Color;
  public text_align: u8;
  public text_indent: LengthPercentage;
  public text_transform: u8;
  public white_space: u8;
  public letter_spacing: Sizing;
  public word_spacing: Sizing;
  public vertical_align: Sizing;
  public decoration_line: u8;
  public list_style_type: Atom;
  public visibility: u8;
}

public struct BackgroundGroup {
  public color: ColorRef;
}

public fn declaration_store_new() -> made: DeclarationStore pure doc "Returns a store that holds no declaration and no family name.";

public fn longhand_of(name: &[u8]) -> found: Option<u8> reads(name) doc "Returns the longhand whose CSS name is name, ASCII case-insensitively, or None for a name that is no longhand in scope.";

public fn longhand_inherited(longhand: u8) -> inherited: Bool pure doc "Returns whether the longhand is inherited: visibility, the font longhands, color, text-align, text-indent, text-transform, white-space, letter-spacing, word-spacing and list-style-type.";

public fn keyword_count(longhand: u8) -> count: u64 pure doc "Returns how many keywords the longhand's keyword list holds, 0 for a longhand with none.";

public fn put_keyword(out: &Box<Slots<u8>>, longhand: u8, keyword: u8) -> result: unit writes(out) doc "Appends the CSS spelling of keyword number keyword of the longhand's keyword list to out, as Chromium serializes it; appends nothing for a keyword out of the list.";

public fn parse_declaration(values: &ComponentList, name: Span, range: ComponentRange, important: Bool, sheet: u32, atoms: &AtomTable, store: &DeclarationStore) -> result: Result<u64, ValuesError> reads(values), writes(atoms), writes(store) doc "Parses one declaration of a style rule or style attribute whose name is name and whose value is the component values of values in range, as pkg::css::rules gives it, and appends a Declaration for each longhand it sets: one for a longhand in scope, one per longhand for a shorthand in scope (margin, padding, border, border-top, border-right, border-bottom, border-left, border-width, border-style, border-color, font, background, overflow, list-style, text-decoration, inset), each with important. Keywords are numbered by the longhand's keyword list, with keyword_auto, keyword_none, keyword_normal, keyword_bolder and keyword_lighter for those words where a grammar mixes them with lengths or numbers; text-decoration-line is a Keyword holding its decoration bits; font-weight normal and bold are the Numbers 400 and 700; font-size keywords are numbered by their list, xx-small to smaller; thin, medium and thick border widths are 1, 3 and 5 px. A value that holds a var() function is not parsed: every longhand it sets gets Pending with its sheet and range and the shorthand's number (255 for a longhand), to be substituted and parsed per element. initial, inherit and unset give Wide; revert is taken as unset. Returns the number of declarations appended, 0 for an unknown name or an invalid value. TooLarge when the store would pass 2^32 - 1 entries.";

public fn parse_pending(values: &ComponentList, range: ComponentRange, shorthand: u8, longhand: u8) -> result: Option<Declared> reads(values) doc "Parses the component values in range, a var()-free value after substitution, as the shorthand numbered shorthand (255 for the longhand itself) and returns the declared value it gives longhand, or None when the value is invalid, which makes the declaration invalid at computed-value time. It reads nothing shared, so the parallel loops call it per element; font-family and list-style-type, whose values name atoms, give None here and are parsed by parse_pending_named.";

public fn parse_pending_named(values: &ComponentList, range: ComponentRange, shorthand: u8, longhand: u8, atoms: &AtomTable, store: &DeclarationStore) -> result: Result<Option<Declared>, ValuesError> reads(values), writes(atoms), writes(store) doc "Parses as parse_pending does for every longhand, interning the names of font-family and list-style-type in atoms and appending font-family lists to store; the pass in document order calls it, since both longhands are inherited. TooLarge when the store or atoms would pass 2^32 - 1 entries.";

public fn shorthand_none() -> code: u8 pure doc "Returns the shorthand number that names no shorthand, 255.";

public fn compute_length(lengths: Lengths, font_size: f32, environment: Environment) -> computed: LengthPercentage pure doc "Resolves the em, rem, ex, ch and viewport parts of lengths against font_size, the root font size and the viewport of environment, ex and ch as half an em, and keeps the percentage part unresolved.";
