public struct Lengths {
  public px: f32;
  public em: f32;
  public rem: f32;
  public ex: f32;
  public ch: f32;
  public vw: f32;
  public vh: f32;
  public vmin: f32;
  public vmax: f32;
  public percent: f32;
}

public enum Declared {
  Keyword(public keyword: u8);
  Length(public value: Lengths);
  Number(public value: f32);
  Integer(public value: i32);
  ColorValue(public color: Color);
  CurrentColor();
  Families(public start: u32, public end: u32);
  ListStyle(public name: Atom);
  Wide(public keyword: u8);
  Pending(public sheet: u32, public start: u32, public end: u32, public shorthand: u8);
  Ratio(public auto: Bool, public width: f32, public height: f32);
  Stored(public kind: u8, public index: u32);
}

public struct Declaration {
  public longhand: u8;
  public important: Bool;
  public value: Declared;
}

public struct Family {
  public name: Atom;
  public generic: Bool;
}

public struct DeclaredBreadth {
  public kind: u8;
  public value: Lengths;
  public flex: f32;
}

public struct DeclaredTrack {
  public min: DeclaredBreadth;
  public max: DeclaredBreadth;
  public fit_content: Bool;
  public names_before: LineNames;
}

public struct DeclarationStore {
  public readonly declarations: Box<Slots<Declaration>>;
  public readonly families: Box<Slots<Family>>;
  public readonly tracks: Box<Slots<DeclaredTrack>>;
  public readonly track_lists: Box<Slots<TrackList>>;
  public readonly line_names: Box<Slots<Atom>>;
  public readonly area_maps: Box<Slots<AreaMap>>;
  public readonly named_areas: Box<Slots<NamedArea>>;
  public readonly grid_lines: Box<Slots<GridLine>>;
  public readonly content_lists: Box<Slots<ContentList>>;
  public readonly content_items: Box<Slots<ContentItem>>;
  public readonly counter_lists: Box<Slots<CounterList>>;
  public readonly counter_changes: Box<Slots<CounterChange>>;
  public readonly quote_lists: Box<Slots<QuoteList>>;
  public readonly quote_pairs: Box<Slots<QuotePair>>;
  public readonly text: Box<Slots<u8>>;
  public readonly spacings: Box<Slots<Lengths>>;
}

public enum ValuesError {
  TooLarge();
}

