fn span_ci_equals(values: &ComponentList, span: Span, literal: &[u8]) -> result: Bool reads(values), reads(literal) {
  doc "True when span names, in values.text, exactly literal's bytes, ASCII case-insensitively.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let text_len = values^.text.inner.len;
  let ordered = start <= end;
  let within = end <= text_len;
  let located = band(ordered, within);
  if located {
  } else {
    return False();
  }
  let size = literal^.len;
  let span_len = end -wrap start;
  if span_len == size {
  } else {
    return False();
  }
  for (at in 0_u64..size) {
    let idx = start +wrap at;
    let in_bounds = idx < text_len;
    if in_bounds {
    } else {
      return False();
    }
    let have_raw = values^.text.inner[idx];
    let have = ascii_lower_byte(byte: have_raw);
    let want_raw = literal^[at];
    let want = ascii_lower_byte(byte: want_raw);
    if have == want {
    } else {
      return False();
    }
  }
  return True();
}

fn span_value_of_u64(values: &ComponentList, start: u64, end: u64) -> result: u64 reads(values) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "Parses values.text from start to end as an unbounded sequence of ASCII digits, saturating at u64's maximum; the range must already be known to hold only digits.";
  let acc = 0_u64;
  let ceiling = 18446744073709551615_u64;
  for (at in start..end) {
    let byte = values^.text.inner[at];
    let wide = cvt::<u8, u64>(byte);
    let digit = wide -wrap 48_u64;
    let headroom = ceiling -wrap digit;
    let room_limit = headroom / 10_u64;
    let room = acc <= room_limit;
    if room {
      let scaled = acc *wrap 10_u64;
      let advanced = scaled +wrap digit;
      set acc = advanced;
    } else {
      set acc = ceiling;
    }
  }
  return acc;
}

fn digits_span_to_i32_negated(values: &ComponentList, start: u64, end: u64) -> result: Option<i32> reads(values) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "True when [start, end) of values.text is one or more ASCII digits; on success returns the negation of that magnitude, clamped to i32 (so 2147483648 or more clamps to the least i32).";
  let empty = start == end;
  if empty {
    return None<i32>();
  }
  for (at in start..end) {
    let byte = values^.text.inner[at];
    let ok = is_ascii_digit(byte: byte);
    if ok {
    } else {
      return None<i32>();
    }
  }
  let magnitude = span_value_of_u64(values: values, start: start, end: end);
  let bound = 2147483648_u64;
  let over = magnitude > bound;
  if over {
    return Some<i32>(value: -2147483648_i32);
  }
  let result = classify_negated_digits(magnitude: magnitude);
  return result;
}

fn classify_negated_digits(magnitude: u64) -> result: Option<i32> pure {
  doc "Negates a nonnegative magnitude known to be at most 2147483648, returning the least i32 for exactly that bound.";
  let at_bound = magnitude == 2147483648_u64;
  if at_bound {
    return Some<i32>(value: -2147483648_i32);
  }
  let narrowed = cvt.wrap::<u64, i32>(magnitude);
  let negated = negate_i32(value: narrowed);
  return Some<i32>(value: negated);
}

fn if_first_is_minus(values: &ComponentList, start: u64, end: u64) -> result: Bool reads(values) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "True when [start, end) is nonempty and its first byte is the ASCII hyphen-minus.";
  let has = start < end;
  if has {
  } else {
    return False();
  }
  let byte = values^.text.inner[start];
  let is_minus = byte == 45_u8;
  return is_minus;
}

fn span_sign(values: &ComponentList, span: Span) -> result: Option<i32> reads(values) {
  doc "When span is nonempty and its first byte in values.text is an ASCII sign, returns +1 for '+' and -1 for '-'; None when unsigned or out of bounds.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let has = start < end;
  if has {
  } else {
    return None<i32>();
  }
  let within = end <= values^.text.inner.len;
  if within {
  } else {
    return None<i32>();
  }
  let byte = values^.text.inner[start];
  let is_plus = byte == 43_u8;
  if is_plus {
    return Some<i32>(value: 1_i32);
  }
  let is_minus = byte == 45_u8;
  if is_minus {
    return Some<i32>(value: -1_i32);
  }
  return None<i32>();
}

fn classify_n_text(values: &ComponentList, start: u64, end: u64) -> result: NKind reads(values) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "Classifies [start, end) of values.text as one of the identifier/unit shapes the <an+b> grammar admits after any leading sign: plain \"n\" (ASCII case-insensitive) or \"n-\" followed by one or more ASCII digits, each optionally preceded by one '-' sign byte, which additionally selects DashB's sign.";
  let sign = 1_i32;
  let body_start = start;
  let has_minus = if_first_is_minus(values: values, start: start, end: end);
  if has_minus {
    set sign = -1_i32;
    let advanced = start +wrap 1_u64;
    set body_start = advanced;
  }
  let has_n = body_start < end;
  if has_n {
  } else {
    return NKind::NoMatch();
  }
  let n_raw = values^.text.inner[body_start];
  let n_byte = ascii_lower_byte(byte: n_raw);
  let is_n = n_byte == 110_u8;
  if is_n {
  } else {
    return NKind::NoMatch();
  }
  let rest_start = body_start +wrap 1_u64;
  let rest_empty = rest_start == end;
  if rest_empty {
    return NKind::PlainN(sign: sign);
  }
  let dash_byte = values^.text.inner[rest_start];
  let dash = dash_byte == 45_u8;
  if dash {
  } else {
    return NKind::NoMatch();
  }
  let digits_start = rest_start +wrap 1_u64;
  match digits_span_to_i32_negated(values: values, start: digits_start, end: end) {
    Some(value: b) => {
      return NKind::DashB(sign: sign, b: b);
    }
    None() => {
      return NKind::NoMatch();
    }
  }
}

fn skip_ws_components(values: &ComponentList, at: u64, limit: u64) -> result: u64 reads(values) contract {
  requires at <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Advances at past every Whitespace component up to limit; the an+b grammar has no nested block to skip over.";
  let pos = at;
  loop @ws {
    let more = pos < limit;
    if more {
    } else {
      break @ws;
    }
    let c = values^.components.inner[pos];
    let is_ws = component_is_whitespace(c: c);
    if is_ws {
      let next = pos +wrap 1_u64;
      set pos = next;
    } else {
      break @ws;
    }
  }
  return pos;
}

fn component_bare_integer(c: Component) -> result: Option<i32> pure {
  doc "When c is an integer Number component, returns its clamped value regardless of sign.";
  match as_number(c: c) {
    Some(value: n) => {
      let is_int = number_kind_is_integer(kind: n.kind);
      if is_int {
      } else {
        return None<i32>();
      }
      let value = clamp_i32_from_f64(value: n.value);
      return Some<i32>(value: value);
    }
    None() => {
      return None<i32>();
    }
  }
}

fn component_signed_integer(values: &ComponentList, c: Component) -> result: Option<i32> reads(values) {
  doc "When c is an integer Number component whose representation begins with an explicit sign, returns its clamped value.";
  match as_number(c: c) {
    Some(value: n) => {
      let is_int = number_kind_is_integer(kind: n.kind);
      if is_int {
      } else {
        return None<i32>();
      }
      match span_sign(values: values, span: n.representation) {
        Some(value: ignored) => {
          let value = clamp_i32_from_f64(value: n.value);
          return Some<i32>(value: value);
        }
        None() => {
          return None<i32>();
        }
      }
    }
    None() => {
      return None<i32>();
    }
  }
}

fn component_unsigned_integer(values: &ComponentList, c: Component) -> result: Option<i32> reads(values) {
  doc "When c is an integer Number component whose representation carries no explicit sign, returns its clamped value.";
  match as_number(c: c) {
    Some(value: n) => {
      let is_int = number_kind_is_integer(kind: n.kind);
      if is_int {
      } else {
        return None<i32>();
      }
      match span_sign(values: values, span: n.representation) {
        Some(value: ignored) => {
          return None<i32>();
        }
        None() => {
          let value = clamp_i32_from_f64(value: n.value);
          return Some<i32>(value: value);
        }
      }
    }
    None() => {
      return None<i32>();
    }
  }
}

fn component_sign_delim(c: Component) -> result: Option<i32> pure {
  doc "When c is a Delim of '+' or '-', returns +1 or -1.";
  match as_delim(c: c) {
    Some(value: cp) => {
      let is_plus = cp == 43_u32;
      if is_plus {
        return Some<i32>(value: 1_i32);
      }
      let is_minus = cp == 45_u32;
      if is_minus {
        return Some<i32>(value: -1_i32);
      }
      return None<i32>();
    }
    None() => {
      return None<i32>();
    }
  }
}

fn component_leading_plus(c: Component) -> result: Bool pure {
  doc "True when c is a Delim of '+'.";
  match as_delim(c: c) {
    Some(value: cp) => {
      let is_plus = cp == 43_u32;
      return is_plus;
    }
    None() => {
      return False();
    }
  }
}

fn clamp_an_plus_b_range(values: &ComponentList, range: ComponentRange) -> (start: u64, limit: u64) reads(values) contract {
  ensures start <= limit;
  ensures limit <= values^.components.inner.len;
} {
  doc "Widens range to u64 and clamps it to values.components' length.";
  let count = values^.components.inner.len;
  let end_wide = cvt::<u32, u64>(range.end);
  let start_wide = cvt::<u32, u64>(range.start);
  let end_ok = end_wide <= count;
  if end_ok {
    let start_ok = start_wide <= end_wide;
    if start_ok {
      return start_wide, end_wide;
    }
    return end_wide, end_wide;
  }
  let start_within = start_wide <= count;
  if start_within {
    return start_wide, count;
  }
  return count, count;
}

fn parse_b_after(values: &ComponentList, pos: u64, limit: u64, a: i32) -> result: Option<AnbResult> reads(values) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses the optional B term of an an+b after A has been read, starting at pos; returns the value and the position after it (past any trailing whitespace), or B=0 at pos itself when nothing follows.";
  let after_a = skip_ws_components(values: values, at: pos, limit: limit);
  let more = after_a < limit;
  if more {
  } else {
    let made = AnPlusB(a: a, b: 0_i32);
    let result = AnbResult(value: made, pos: after_a);
    return Some<AnbResult>(value: result);
  }
  let c = values^.components.inner[after_a];
  match component_signed_integer(values: values, c: c) {
    Some(value: b) => {
      let advanced = after_a +wrap 1_u64;
      let ended = skip_ws_components(values: values, at: advanced, limit: limit);
      let made = AnPlusB(a: a, b: b);
      let result = AnbResult(value: made, pos: ended);
      return Some<AnbResult>(value: result);
    }
    None() => {
    }
  }
  match component_sign_delim(c: c) {
    Some(value: sign) => {
      let after_sign = after_a +wrap 1_u64;
      let before_number = skip_ws_components(values: values, at: after_sign, limit: limit);
      let has_more = before_number < limit;
      if has_more {
      } else {
        return None<AnbResult>();
      }
      let nc = values^.components.inner[before_number];
      match component_unsigned_integer(values: values, c: nc) {
        Some(value: magnitude) => {
          let b = select_signed(sign: sign, magnitude: magnitude);
          let advanced = before_number +wrap 1_u64;
          let ended = skip_ws_components(values: values, at: advanced, limit: limit);
          let made = AnPlusB(a: a, b: b);
          let result = AnbResult(value: made, pos: ended);
          return Some<AnbResult>(value: result);
        }
        None() => {
          return None<AnbResult>();
        }
      }
    }
    None() => {
      return None<AnbResult>();
    }
  }
}

fn consume_an_plus_b(values: &ComponentList, start: u64, limit: u64) -> result: Option<AnbResult> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes one <an+b> from start, surrounded by optional leading whitespace, per the css-parsing-tests An+B grammar; returns the value and the position just after it (past any trailing whitespace), or None when start does not begin one.";
  let pos = skip_ws_components(values: values, at: start, limit: limit);
  let has = pos < limit;
  if has {
  } else {
    return None<AnbResult>();
  }
  let c = values^.components.inner[pos];
  match component_bare_integer(c: c) {
    Some(value: b) => {
      let advanced = pos +wrap 1_u64;
      let ended = skip_ws_components(values: values, at: advanced, limit: limit);
      let made = AnPlusB(a: 0_i32, b: b);
      let result = AnbResult(value: made, pos: ended);
      return Some<AnbResult>(value: result);
    }
    None() => {
    }
  }
  match as_ident(c: c) {
    Some(value: n) => {
      let is_odd = span_ci_equals(values: values, span: n, literal: &odd_letters[0_u64..odd_letters.len]);
      if is_odd {
        let advanced = pos +wrap 1_u64;
        let ended = skip_ws_components(values: values, at: advanced, limit: limit);
        let made = AnPlusB(a: 2_i32, b: 1_i32);
        let result = AnbResult(value: made, pos: ended);
        return Some<AnbResult>(value: result);
      }
      let is_even = span_ci_equals(values: values, span: n, literal: &even_letters[0_u64..even_letters.len]);
      if is_even {
        let advanced = pos +wrap 1_u64;
        let ended = skip_ws_components(values: values, at: advanced, limit: limit);
        let made = AnPlusB(a: 2_i32, b: 0_i32);
        let result = AnbResult(value: made, pos: ended);
        return Some<AnbResult>(value: result);
      }
      let name_start = cvt::<u32, u64>(n.start);
      let name_end = cvt::<u32, u64>(n.end);
      let name_ordered = name_start <= name_end;
      if name_ordered {
        let name_within = name_end <= values^.text.inner.len;
        if name_within {
          match classify_n_text(values: values, start: name_start, end: name_end) {
            PlainN(sign: a) => {
              let advanced = pos +wrap 1_u64;
              let tail = parse_b_after(values: values, pos: advanced, limit: limit, a: a);
              return tail;
            }
            DashB(sign: a, b: bval) => {
              let advanced = pos +wrap 1_u64;
              let ended = skip_ws_components(values: values, at: advanced, limit: limit);
              let made = AnPlusB(a: a, b: bval);
              let result = AnbResult(value: made, pos: ended);
              return Some<AnbResult>(value: result);
            }
            NoMatch() => {
              return None<AnbResult>();
            }
          }
        } else {
          return None<AnbResult>();
        }
      } else {
        return None<AnbResult>();
      }
    }
    None() => {
    }
  }
  match as_dimension(c: c) {
    Some(value: info) => {
      let is_int = number_kind_is_integer(kind: info.number.kind);
      if is_int {
      } else {
        return None<AnbResult>();
      }
      let a = clamp_i32_from_f64(value: info.number.value);
      let unit_start = cvt::<u32, u64>(info.unit_span.start);
      let unit_end = cvt::<u32, u64>(info.unit_span.end);
      let unit_ordered = unit_start <= unit_end;
      if unit_ordered {
        let unit_within = unit_end <= values^.text.inner.len;
        if unit_within {
          match classify_n_text(values: values, start: unit_start, end: unit_end) {
            PlainN(sign: ignored) => {
              let advanced = pos +wrap 1_u64;
              let tail = parse_b_after(values: values, pos: advanced, limit: limit, a: a);
              return tail;
            }
            DashB(sign: unit_sign, b: bval) => {
              let unit_has_minus = if_first_is_minus(values: values, start: unit_start, end: unit_end);
              if unit_has_minus {
                return None<AnbResult>();
              }
              let advanced = pos +wrap 1_u64;
              let ended = skip_ws_components(values: values, at: advanced, limit: limit);
              let made = AnPlusB(a: a, b: bval);
              let result = AnbResult(value: made, pos: ended);
              return Some<AnbResult>(value: result);
            }
            NoMatch() => {
              return None<AnbResult>();
            }
          }
        } else {
          return None<AnbResult>();
        }
      } else {
        return None<AnbResult>();
      }
    }
    None() => {
    }
  }
  let leading_plus = component_leading_plus(c: c);
  if leading_plus {
  } else {
    return None<AnbResult>();
  }
  let next = pos +wrap 1_u64;
  let has_next = next < limit;
  if has_next {
  } else {
    return None<AnbResult>();
  }
  let nc = values^.components.inner[next];
  match as_ident(c: nc) {
    Some(value: n) => {
      let name_start = cvt::<u32, u64>(n.start);
      let name_end = cvt::<u32, u64>(n.end);
      let name_ordered = name_start <= name_end;
      if name_ordered {
        let name_within = name_end <= values^.text.inner.len;
        if name_within {
          match classify_n_text(values: values, start: name_start, end: name_end) {
            PlainN(sign: s) => {
              let only_plus = s == 1_i32;
              if only_plus {
              } else {
                return None<AnbResult>();
              }
              let advanced = next +wrap 1_u64;
              let tail = parse_b_after(values: values, pos: advanced, limit: limit, a: 1_i32);
              return tail;
            }
            DashB(sign: s, b: bval) => {
              let only_plus = s == 1_i32;
              if only_plus {
              } else {
                return None<AnbResult>();
              }
              let advanced = next +wrap 1_u64;
              let ended = skip_ws_components(values: values, at: advanced, limit: limit);
              let made = AnPlusB(a: 1_i32, b: bval);
              let result = AnbResult(value: made, pos: ended);
              return Some<AnbResult>(value: result);
            }
            NoMatch() => {
              return None<AnbResult>();
            }
          }
        } else {
          return None<AnbResult>();
        }
      } else {
        return None<AnbResult>();
      }
    }
    None() => {
      return None<AnbResult>();
    }
  }
}

fn parse_an_plus_b(values: &ComponentList, range: ComponentRange) -> result: Option<AnPlusB> reads(values) {
  doc "Parses range, surrounded by optional whitespace, as exactly one <an+b>.";
  let (start, limit) = clamp_an_plus_b_range(values: values, range: range);
  match consume_an_plus_b(values: values, start: start, limit: limit) {
    Some(value: found) => {
      let complete = found.pos == limit;
      if complete {
        return Some<AnPlusB>(value: found.value);
      }
      return None<AnPlusB>();
    }
    None() => {
      return None<AnPlusB>();
    }
  }
}
