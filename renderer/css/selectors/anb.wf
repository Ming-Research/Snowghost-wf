alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias ComponentRange = pkg::css::rules::ComponentRange;
alias NumberKind = pkg::css::syntax::NumberKind;
alias Numeric = pkg::css::syntax::Numeric;
alias Span = pkg::css::syntax::Span;

const odd_letters: Array<u8, 3> = "odd";

const even_letters: Array<u8, 4> = "even";

enum NKind {
  PlainN(sign: i32);
  DashB(sign: i32, b: i32);
  NoMatch();
}

struct AnbResult {
  value: AnPlusB;
  pos: u64;
}

struct DimInfo {
  number: Numeric;
  unit_span: Span;
}

fn clamp_i32_from_f64(value: f64) -> result: i32 pure {
  doc "Converts value to i32, saturating by sign when it is out of range or not integral; NaN takes zero.";
  match cvt.checked::<f64, i32>(value) {
    Ok(value: raw) => {
      return raw;
    }
    Err(error: outside) => {
      let above = fgt(value, 0.0_f64);
      if above {
        return 2147483647_i32;
      }
      let below = flt(value, 0.0_f64);
      if below {
        return -2147483648_i32;
      }
      return 0_i32;
    }
  }
}

fn negate_i32(value: i32) -> result: i32 pure {
  doc "Negates value, saturating at the positive bound when value is the least i32 (whose magnitude has no positive counterpart).";
  let least = value == -2147483648_i32;
  if least {
    return 2147483647_i32;
  }
  let negated = ineg.wrap(value);
  return negated;
}

fn select_signed(sign: i32, magnitude: i32) -> result: i32 pure {
  doc "Returns magnitude when sign is +1 and its negation when sign is -1.";
  let positive = sign == 1_i32;
  if positive {
    return magnitude;
  }
  let negated = negate_i32(value: magnitude);
  return negated;
}

fn is_ascii_digit(byte: u8) -> result: Bool pure {
  doc "True when byte is one of the ten ASCII digits.";
  let low = byte >= 48_u8;
  let high = byte <= 57_u8;
  let both = band(low, high);
  return both;
}

fn ascii_lower_byte(byte: u8) -> result: u8 pure {
  doc "Lowercases byte when it is an ASCII upper-case letter.";
  let low = byte >= 65_u8;
  let high = byte <= 90_u8;
  let upper = band(low, high);
  if upper {
    let widened = cvt::<u8, u32>(byte);
    let shifted = widened +wrap 32_u32;
    let narrowed = cvt.wrap::<u32, u8>(shifted);
    return narrowed;
  }
  return byte;
}

fn number_kind_is_integer(kind: NumberKind) -> result: Bool pure {
  doc "True when kind is Integer.";
  match kind {
    Integer() => {
      return True();
    }
    Number() => {
      return False();
    }
  }
}

fn as_number(c: Component) -> result: Option<Numeric> pure {
  doc "The Numeric payload when c is a Number component, and None otherwise.";
  match c {
    Number(number: n) => {
      return Some<Numeric>(value: n);
    }
    Ident(name: n) => {
      return None<Numeric>();
    }
    Function(name: n, end: e) => {
      return None<Numeric>();
    }
    AtKeyword(name: n) => {
      return None<Numeric>();
    }
    Hash(name: n, kind: k) => {
