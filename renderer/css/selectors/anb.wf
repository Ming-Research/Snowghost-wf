      return None<Numeric>();
    }
    Percentage(number: n) => {
      return None<Numeric>();
    }
    Dimension(number: n, unit_name: u) => {
      return None<Numeric>();
    }
    UnicodeRange(start: s, end: e) => {
      return None<Numeric>();
    }
    IncludeMatch() => {
      return None<Numeric>();
    }
    DashMatch() => {
      return None<Numeric>();
    }
    PrefixMatch() => {
      return None<Numeric>();
    }
    SuffixMatch() => {
      return None<Numeric>();
