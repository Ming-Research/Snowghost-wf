alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Namespace = pkg::dom::Namespace;
alias TextSpan = pkg::dom::TextSpan;
alias atom_class = pkg::base::static_atoms::atom_class;

const class_table_limit: u64 = 4294967296_u64;

const no_class_index: u64 = 18446744073709551615_u64;

fn empty_positions() -> made: Positions pure {
  doc "Positions that cover no node, so every count scans.";
  let table = box_slots_new::<u64>(capacity: 0_u64);
  return Positions(table: move table);
}

fn namespace_slot(namespace: Namespace) -> slot: u64 pure {
  doc "0 for HTML, 1 for SVG, 2 for MathML.";
  match namespace {
    Html() => {
      return 0_u64;
    }
    Svg() => {
      return 1_u64;
    }
    MathMl() => {
      return 2_u64;
    }
  }
}

fn element_key(document: &Document, node: u64) -> key: Option<u64> reads(document) {
  doc "The namespace and local name pair of the element at node, as namespace_slot plus three times the name's atom index; None for a node that is no element.";
  let count = document^.nodes.inner.len;
  let inside = node < count;
  if inside {
  } else {
    return None<u64>();
  }
  let data = &document^.nodes.inner[node].data;
  match data^ {
    Element(namespace: space, local_name: name, attributes: attrs, template_contents: contents) => {
      let slot = namespace_slot(namespace: space^);
      let index = cvt::<u32, u64>(name^.index);
      let scaled = index * 3_u64;
      let key = scaled +wrap slot;
      return Some<u64>(value: key);
    }
    DocumentRoot(..) => {
      return None<u64>();
    }
    DocumentType(..) => {
      return None<u64>();
    }
    Text(..) => {
      return None<u64>();
    }
    Comment(..) => {
      return None<u64>();
    }
    Fragment() => {
      return None<u64>();
    }
  }
}

fn sibling_positions(document: &Document) -> made: Positions reads(document) {
  doc "Writes the node count first; then, for each node, walks its children twice: first numbering the element children and, per namespace and name pair, the ones of each pair, then writing each child's totals, four words per node after the count; then a head per node and the records of its class words (index_classes).";
  let count = document^.nodes.inner.len;
  let small = count < 4294967294_u64;
  if small {
  } else {
    return empty_positions();
  }
  let keys = 0_u64;
  for (node in 0_u64..count) {
    match element_key(document: document, node: node) {
      Some(value: key) => {
        let above = key >= keys;
        if above {
          set keys = key +wrap 1_u64;
        }
      }
      None() => {
      }
    }
  }
  let few = keys <= 4294967296_u64;
  if few {
  } else {
    return empty_positions();
  }
  let unseen = 4294967295_u64;
  let sibling_words = count * 4_u64;
  let heads_start = sibling_words + 1_u64;
  let words = heads_start + count;
  let table = box_slots_new::<u64>(capacity: words);
  for (
    index in 0_u64..words,
    invariant filled: table.inner.len == index
  ) {
    place_back(window: &table.inner, value: 0_u64);
  }
  if 0_u64 < table.inner.len {
    set table.inner[0_u64] = count;
  }
  let counter = box_array_filled::<u64>(count: keys, value: 0_u64);
  let stamp = box_array_filled::<u64>(count: keys, value: unseen);
  for (parent in 0_u64..count) {
    let elements = 0_u64;
    let cursor = document^.nodes.inner[parent].links.first_child;
    let step = 0_u64;
    loop @first {
      let bounded = step < count;
      if bounded {
      } else {
        break @first;
      }
      match cursor {
        Some(value: child) => {
          let at = cvt::<u32, u64>(child.index);
          let listed = at < count;
          if listed {
            match element_key(document: document, node: at) {
              Some(value: key) => {
                set elements = elements +wrap 1_u64;
                let slot_0_scaled = at * 4_u64;
                let slot_0 = slot_0_scaled + 1_u64;
                let fits_0 = slot_0 < table.inner.len;
                if fits_0 {
                  set table.inner[slot_0] = elements;
                }
                let known = key < keys;
                if known {
                  let fresh = stamp.inner[key] == parent;
                  if fresh {
                  } else {
                    set stamp.inner[key] = parent;
                    set counter.inner[key] = 0_u64;
                  }
                  let typed = counter.inner[key] +wrap 1_u64;
                  set counter.inner[key] = typed;
                  let base_2_scaled = at * 4_u64;
                  let base_2 = base_2_scaled + 1_u64;
                  let slot_2 = base_2 + 2_u64;
                  let fits_2 = slot_2 < table.inner.len;
                  if fits_2 {
                    set table.inner[slot_2] = typed;
                  }
                }
              }
              None() => {
              }
            }
            set cursor = document^.nodes.inner[at].links.next_sibling;
          } else {
            break @first;
          }
        }
        None() => {
          break @first;
        }
      }
      set step = step +wrap 1_u64;
    }
    let again = document^.nodes.inner[parent].links.first_child;
    let back = 0_u64;
    loop @second {
      let bounded = back < count;
      if bounded {
      } else {
        break @second;
      }
      match again {
        Some(value: child) => {
          let at = cvt::<u32, u64>(child.index);
          let listed = at < count;
          if listed {
            match element_key(document: document, node: at) {
              Some(value: key) => {
                let base_1_scaled = at * 4_u64;
                let base_1 = base_1_scaled + 1_u64;
                let slot_1 = base_1 + 1_u64;
                let fits_1 = slot_1 < table.inner.len;
                if fits_1 {
                  set table.inner[slot_1] = elements;
                }
                let known = key < keys;
                if known {
                  let base_3_scaled = at * 4_u64;
                  let base_3 = base_3_scaled + 1_u64;
                  let slot_3 = base_3 + 3_u64;
                  let fits_3 = slot_3 < table.inner.len;
                  if fits_3 {
                    set table.inner[slot_3] = counter.inner[key];
                  }
                }
              }
              None() => {
              }
            }
            set again = document^.nodes.inner[at].links.next_sibling;
          } else {
            break @second;
          }
        }
        None() => {
          break @second;
        }
      }
      set back = back +wrap 1_u64;
    }
  }
  for (node in 0_u64..count) {
    let indexed = index_classes(table: &table, document: document, node: node, count: count);
  }
  return Positions(table: move table);
}

fn class_value(document: &Document, node: u64) -> value: Option<TextSpan> reads(document) {
  doc "The value of the element's first class attribute in no namespace, as the matcher's Class test finds it, or None.";
  let count = document^.nodes.inner.len;
  if node < count {
  } else {
    return None<TextSpan>();
  }
  let data = &document^.nodes.inner[node].data;
  match data^ {
    Element(namespace: space, local_name: name, attributes: attrs, template_contents: contents) => {
      let listed = attrs^.inner.len;
      for (k in 0_u64..listed) {
        let attribute = attrs^.inner[k];
        let plain = match attribute.namespace {
          NoNamespace() => {
            give True();
          }
          XLink() => {
            give False();
          }
          Xml() => {
            give False();
          }
          XmlNs() => {
            give False();
          }
        }
        let named = attribute.name.index == atom_class;
        let found = band(plain, named);
        if found {
          return Some<TextSpan>(value: attribute.value);
        }
      }
      return None<TextSpan>();
    }
    DocumentRoot(..) => {
      return None<TextSpan>();
    }
    DocumentType(..) => {
      return None<TextSpan>();
    }
    Text(..) => {
      return None<TextSpan>();
    }
    Comment(..) => {
      return None<TextSpan>();
    }
    Fragment() => {
      return None<TextSpan>();
    }
  }
}

fn push_word(table: &Box<Slots<u64>>, value: u64) -> pushed: Bool writes(table) {
  doc "Appends one word, doubling the table while within class_table_limit; False when full.";
  let length = table^.inner.len;
  let capacity = table^.inner.cap;
  if length >= capacity {
    let doubled = capacity *sat 2_u64;
    let wanted = imax(doubled, 64_u64);
    if wanted > class_table_limit {
      return False();
    }
    if wanted >= capacity {
      grow(cell: table, capacity: wanted);
    } else {
      return False();
    }
  }
  let room = table^.inner.len < table^.inner.cap;
  if room {
    place_back(window: &table^.inner, value: value);
    return True();
  }
  return False();
}

fn index_classes(table: &Box<Slots<u64>>, document: &Document, node: u64, count: u64) -> indexed: Bool reads(document), writes(table) {
  doc "Appends a record for each ASCII-whitespace-separated word of node's class value, its name_hash (for consumers that compare many words) and its span in the document text (start in the high half, end in the low), and points node's head (count, the table's node count, gives its place) at them: the first record's index in the high half and the number of records in the low. A node without a class value keeps the head 0, no records. False when the table is full or node is past count; the head is then left as it was and the Class test scans.";
  let heads = count *sat 4_u64;
  let heads_from = heads +sat 1_u64;
  let head_at = heads_from +sat node;
  let head_known = head_at < table^.inner.len;
  let in_document = node < count;
  let usable = band(head_known, in_document);
  if usable {
  } else {
    return False();
  }
  let value = match class_value(document: document, node: node) {
    Some(value: span) => {
      give span;
    }
    None() => {
      set table^.inner[head_at] = 0_u64;
      return True();
    }
  }
  let start = cvt::<u32, u64>(value.start);
  let end = cvt::<u32, u64>(value.end);
  let ordered = start <= end;
  let inside = end <= document^.text.inner.len;
  let readable = band(ordered, inside);
  if readable {
  } else {
    return False();
  }
  let first = table^.inner.len;
  let small = first < 4294967295_u64;
  if small {
  } else {
    return False();
  }
  let hay = &document^.text.inner[start..end];
  let length = hay^.len;
  let records = 0_u64;
  let pos = 0_u64;
  for (step in 0_u64..length) {
    if pos >= length {
      break;
    }
    let word_start = skip_ws_bytes(hay: hay, at: pos, limit: length);
    if word_start >= length {
      break;
    }
    let word_end = word_end_bytes(hay: hay, at: word_start, limit: length);
    let ordered_word = word_start <= word_end;
    if ordered_word {
    } else {
      return False();
    }
    let within = word_end <= hay^.len;
    if within {
    } else {
      return False();
    }
    let hash = name_hash(bytes: &hay^[word_start..word_end]);
    let absolute_start = start + word_start;
    let absolute_end = start + word_end;
    let high = ishl.wrap(absolute_start, 32_u32);
    let low = iand(absolute_end, 4294967295_u64);
    let packed = ior(high, low);
    let pushed_hash = push_word(table: table, value: hash);
    let pushed_span = push_word(table: table, value: packed);
    let pushed = band(pushed_hash, pushed_span);
    if pushed {
    } else {
      return False();
    }
    set records = records +sat 1_u64;
    set pos = word_end;
  }
  let head_high = ishl.wrap(first, 32_u32);
  let head_low = iand(records, 4294967295_u64);
  let head = ior(head_high, head_low);
  if head_at < table^.inner.len {
    set table^.inner[head_at] = head;
  }
  return True();
}

fn class_attribute_changed(positions: &Positions, document: &Document, node: NodeId) -> result: unit reads(document), writes(positions) {
  doc "Indexes node's class value again after it changed, appending its records and pointing its head at them; the old records stay unread.";
  let length = positions^.table.inner.len;
  if length == 0_u64 {
    return unit;
  }
  let count = positions^.table.inner[0_u64];
  let at = cvt::<u32, u64>(node.index);
  let indexed = index_classes(table: &positions^.table, document: document, node: at, count: count);
  if indexed {
  } else {
    let heads = count *sat 4_u64;
    let heads_from = heads +sat 1_u64;
    let head_at = heads_from +sat at;
    if head_at < positions^.table.inner.len {
      set positions^.table.inner[head_at] = no_class_index;
    }
  }
  return unit;
}

fn class_records(positions: &[u64], document: &Document, node: NodeId) -> (indexed: Bool, first: u64, count: u64) reads(positions), reads(document) {
  doc "Where node's class records lie in positions, when positions covers this document (its node count is the document's) and indexed node: indexed False when the Class test must scan.";
  let length = positions^.len;
  if length == 0_u64 {
    return False(), 0_u64, 0_u64;
  }
  let count = positions^[0_u64];
  let same = count == document^.nodes.inner.len;
  if same {
  } else {
    return False(), 0_u64, 0_u64;
  }
  let at = cvt::<u32, u64>(node.index);
  if at < count {
  } else {
    return False(), 0_u64, 0_u64;
  }
  let heads = count *sat 4_u64;
  let heads_from = heads +sat 1_u64;
  let head_at = heads_from +sat at;
  if head_at < length {
  } else {
    return False(), 0_u64, 0_u64;
  }
  let head = positions^[head_at];
  if head == no_class_index {
    return False(), 0_u64, 0_u64;
  }
  let first = ishr(head, 32_u32);
  let records = iand(head, 4294967295_u64);
  return True(), first, records;
}

fn positioned_scan(positions: &[u64], node: NodeId, same_type: Bool) -> scan: Option<NthScan> reads(positions) {
  doc "The count nth_scan would return for node, from positions, four words per node: position and total among the element siblings, then among those of its type; None when positions does not cover node.";
  let at = cvt::<u32, u64>(node.index);
  let base_scaled = at * 4_u64;
  let base = base_scaled + 1_u64;
  let last = base + 3_u64;
  let covered = last < positions^.len;
  if covered {
  } else {
    return None<NthScan>();
  }
  let offset = if same_type {
    give 2_u64;
  } else {
    give 0_u64;
  }
  let first = base + offset;
  let second = first + 1_u64;
  let within = second < positions^.len;
  if within {
  } else {
    return None<NthScan>();
  }
  let position = positions^[first];
  let total = positions^[second];
  let found = position > 0_u64;
  let scan = NthScan(position: position, total: total, found: found);
  return Some<NthScan>(value: scan);
}
