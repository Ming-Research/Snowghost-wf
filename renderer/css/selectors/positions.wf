alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Namespace = pkg::dom::Namespace;

fn empty_positions() -> made: Positions pure {
  doc "Positions that cover no node, so every count scans.";
  let table = box_array_filled::<u64>(count: 0_u64, value: 0_u64);
  return Positions(table: move table);
}

fn namespace_slot(namespace: Namespace) -> slot: u64 pure {
  doc "0 for HTML, 1 for SVG, 2 for MathML.";
  match namespace {
    Html() => {
      return 0_u64;
    }
    Svg() => {
      return 1_u64;
    }
    MathMl() => {
      return 2_u64;
    }
  }
}

fn element_key(document: &Document, node: u64) -> key: Option<u64> reads(document) {
  doc "The namespace and local name pair of the element at node, as namespace_slot plus three times the name's atom index; None for a node that is no element.";
  let count = document^.nodes.inner.len;
  let inside = node < count;
  if inside {
  } else {
    return None<u64>();
  }
  let data = &document^.nodes.inner[node].data;
  match data^ {
    Element(namespace: space, local_name: name, attributes: attrs, template_contents: contents) => {
      let slot = namespace_slot(namespace: space^);
      let index = cvt::<u32, u64>(name^.index);
      let scaled = index * 3_u64;
      let key = scaled +wrap slot;
      return Some<u64>(value: key);
    }
    DocumentRoot(..) => {
      return None<u64>();
    }
    DocumentType(..) => {
      return None<u64>();
    }
    Text(..) => {
      return None<u64>();
    }
    Comment(..) => {
      return None<u64>();
    }
    Fragment() => {
      return None<u64>();
    }
  }
}

fn sibling_positions(document: &Document) -> made: Positions reads(document) {
  doc "For each node, walks its children twice: first numbering the element children and, per namespace and name pair, the ones of each pair, then writing each child's totals.";
  let count = document^.nodes.inner.len;
  let small = count < 4294967294_u64;
  if small {
  } else {
    return empty_positions();
  }
  let keys = 0_u64;
  for (node in 0_u64..count) {
    match element_key(document: document, node: node) {
      Some(value: key) => {
        let above = key >= keys;
        if above {
          set keys = key +wrap 1_u64;
        }
      }
      None() => {
      }
    }
  }
  let few = keys <= 4294967296_u64;
  if few {
  } else {
    return empty_positions();
  }
  let unseen = 4294967295_u64;
  let words = count * 4_u64;
  let table = box_array_filled::<u64>(count: words, value: 0_u64);
  let counter = box_array_filled::<u64>(count: keys, value: 0_u64);
  let stamp = box_array_filled::<u64>(count: keys, value: unseen);
  for (parent in 0_u64..count) {
    let elements = 0_u64;
    let cursor = document^.nodes.inner[parent].links.first_child;
    let step = 0_u64;
    loop @first {
      let bounded = step < count;
      if bounded {
      } else {
        break @first;
      }
      match cursor {
        Some(value: child) => {
          let at = cvt::<u32, u64>(child.index);
          let listed = at < count;
          if listed {
            match element_key(document: document, node: at) {
              Some(value: key) => {
                set elements = elements +wrap 1_u64;
                let slot_0 = at * 4_u64;
                let fits_0 = slot_0 < table.inner.len;
                if fits_0 {
                  set table.inner[slot_0] = elements;
                }
                let known = key < keys;
                if known {
                  let fresh = stamp.inner[key] == parent;
                  if fresh {
                  } else {
                    set stamp.inner[key] = parent;
                    set counter.inner[key] = 0_u64;
                  }
                  let typed = counter.inner[key] +wrap 1_u64;
                  set counter.inner[key] = typed;
                  let base_2 = at * 4_u64;
                  let slot_2 = base_2 + 2_u64;
                  let fits_2 = slot_2 < table.inner.len;
                  if fits_2 {
                    set table.inner[slot_2] = typed;
                  }
                }
              }
              None() => {
              }
            }
            set cursor = document^.nodes.inner[at].links.next_sibling;
          } else {
            break @first;
          }
        }
        None() => {
          break @first;
        }
      }
      set step = step +wrap 1_u64;
    }
    let again = document^.nodes.inner[parent].links.first_child;
    let back = 0_u64;
    loop @second {
      let bounded = back < count;
      if bounded {
      } else {
        break @second;
      }
      match again {
        Some(value: child) => {
          let at = cvt::<u32, u64>(child.index);
          let listed = at < count;
          if listed {
            match element_key(document: document, node: at) {
              Some(value: key) => {
                let base_1 = at * 4_u64;
                let slot_1 = base_1 + 1_u64;
                let fits_1 = slot_1 < table.inner.len;
                if fits_1 {
                  set table.inner[slot_1] = elements;
                }
                let known = key < keys;
                if known {
                  let base_3 = at * 4_u64;
                  let slot_3 = base_3 + 3_u64;
                  let fits_3 = slot_3 < table.inner.len;
                  if fits_3 {
                    set table.inner[slot_3] = counter.inner[key];
                  }
                }
              }
              None() => {
              }
            }
            set again = document^.nodes.inner[at].links.next_sibling;
          } else {
            break @second;
          }
        }
        None() => {
          break @second;
        }
      }
      set back = back +wrap 1_u64;
    }
  }
  return Positions(table: move table);
}

fn positioned_scan(positions: &[u64], node: NodeId, same_type: Bool) -> scan: Option<NthScan> reads(positions) {
  doc "The count nth_scan would return for node, from positions, four words per node: position and total among the element siblings, then among those of its type; None when positions does not cover node.";
  let at = cvt::<u32, u64>(node.index);
  let base = at * 4_u64;
  let last = base + 3_u64;
  let covered = last < positions^.len;
  if covered {
  } else {
    return None<NthScan>();
  }
  let offset = if same_type {
    give 2_u64;
  } else {
    give 0_u64;
  }
  let first = base + offset;
  let second = first + 1_u64;
  let within = second < positions^.len;
  if within {
  } else {
    return None<NthScan>();
  }
  let position = positions^[first];
  let total = positions^[second];
  let found = position > 0_u64;
  let scan = NthScan(position: position, total: total, found: found);
  return Some<NthScan>(value: scan);
}
