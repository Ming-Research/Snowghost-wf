alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Namespace = pkg::dom::Namespace;

fn empty_positions() -> made: Positions pure {
  doc "Positions that cover no node, so every count scans.";
  let child_position = box_array_filled::<u64>(count: 0_u64, value: 0_u64);
  let child_total = box_array_filled::<u64>(count: 0_u64, value: 0_u64);
  let type_position = box_array_filled::<u64>(count: 0_u64, value: 0_u64);
  let type_total = box_array_filled::<u64>(count: 0_u64, value: 0_u64);
  return Positions(child_position: move child_position, child_total: move child_total, type_position: move type_position, type_total: move type_total);
}

fn namespace_slot(namespace: Namespace) -> slot: u64 pure {
  doc "0 for HTML, 1 for SVG, 2 for MathML.";
  match namespace {
    Html() => {
      return 0_u64;
    }
    Svg() => {
      return 1_u64;
    }
    MathMl() => {
      return 2_u64;
    }
  }
}

fn element_key(document: &Document, node: u64) -> key: Option<u64> reads(document) {
  doc "The namespace and local name pair of the element at node, as namespace_slot plus three times the name's atom index; None for a node that is no element.";
  let count = document^.nodes.inner.len;
  let inside = node < count;
  if inside {
  } else {
    return None<u64>();
  }
  let data = &document^.nodes.inner[node].data;
  match data^ {
    Element(namespace: space, local_name: name, attributes: attrs, template_contents: contents) => {
      let slot = namespace_slot(namespace: space^);
      let index = cvt::<u32, u64>(name^.index);
      let scaled = index * 3_u64;
      let key = scaled +wrap slot;
      return Some<u64>(value: key);
    }
    DocumentRoot(..) => {
      return None<u64>();
    }
    DocumentType(..) => {
      return None<u64>();
    }
    Text(..) => {
      return None<u64>();
    }
    Comment(..) => {
      return None<u64>();
    }
    Fragment() => {
      return None<u64>();
    }
  }
}

fn sibling_positions(document: &Document) -> made: Positions reads(document) {
  doc "For each node, walks its children twice: first numbering the element children and, per namespace and name pair, the ones of each pair, then writing each child's totals.";
  let count = document^.nodes.inner.len;
  let small = count < 4294967294_u64;
  if small {
  } else {
    return empty_positions();
  }
  let keys = 0_u64;
  for (node in 0_u64..count) {
    match element_key(document: document, node: node) {
      Some(value: key) => {
        let above = key >= keys;
        if above {
          set keys = key +wrap 1_u64;
        }
      }
      None() => {
      }
    }
  }
  let few = keys <= 4294967296_u64;
  if few {
  } else {
    return empty_positions();
  }
  let unseen = 4294967295_u64;
  let child_position = box_array_filled::<u64>(count: count, value: 0_u64);
  let child_total = box_array_filled::<u64>(count: count, value: 0_u64);
  let type_position = box_array_filled::<u64>(count: count, value: 0_u64);
  let type_total = box_array_filled::<u64>(count: count, value: 0_u64);
  let counter = box_array_filled::<u64>(count: keys, value: 0_u64);
  let stamp = box_array_filled::<u64>(count: keys, value: unseen);
  for (parent in 0_u64..count) {
    let elements = 0_u64;
    let cursor = document^.nodes.inner[parent].links.first_child;
    for (step in 0_u64..count) {
      match cursor {
        Some(value: child) => {
          let at = cvt::<u32, u64>(child.index);
          let listed = at < count;
          if listed {
            match element_key(document: document, node: at) {
              Some(value: key) => {
                set elements = elements +wrap 1_u64;
                set child_position.inner[at] = elements;
                let known = key < keys;
                if known {
                  let fresh = stamp.inner[key] == parent;
                  if fresh {
                  } else {
                    set stamp.inner[key] = parent;
                    set counter.inner[key] = 0_u64;
                  }
                  let typed = counter.inner[key] +wrap 1_u64;
                  set counter.inner[key] = typed;
                  set type_position.inner[at] = typed;
                }
              }
              None() => {
              }
            }
            set cursor = document^.nodes.inner[at].links.next_sibling;
          } else {
            set cursor = None<NodeId>();
          }
        }
        None() => {
        }
      }
    }
    let again = document^.nodes.inner[parent].links.first_child;
    for (step in 0_u64..count) {
      match again {
        Some(value: child) => {
          let at = cvt::<u32, u64>(child.index);
          let listed = at < count;
          if listed {
            match element_key(document: document, node: at) {
              Some(value: key) => {
                set child_total.inner[at] = elements;
                let known = key < keys;
                if known {
                  set type_total.inner[at] = counter.inner[key];
                }
              }
              None() => {
              }
            }
            set again = document^.nodes.inner[at].links.next_sibling;
          } else {
            set again = None<NodeId>();
          }
        }
        None() => {
        }
      }
    }
  }
  return Positions(child_position: move child_position, child_total: move child_total, type_position: move type_position, type_total: move type_total);
}

fn positioned_scan(positions: &Positions, node: NodeId, same_type: Bool) -> scan: Option<NthScan> reads(positions) {
  doc "The count nth_scan would return for node, from positions; None when positions does not cover node.";
  let at = cvt::<u32, u64>(node.index);
  let a = at < positions^.child_position.inner.len;
  let b = at < positions^.child_total.inner.len;
  let c = at < positions^.type_position.inner.len;
  let d = at < positions^.type_total.inner.len;
  let first = band(a, b);
  let second = band(c, d);
  let covered = band(first, second);
  if covered {
  } else {
    return None<NthScan>();
  }
  if same_type {
    let position = positions^.type_position.inner[at];
    let total = positions^.type_total.inner[at];
    let found = position > 0_u64;
    let scan = NthScan(position: position, total: total, found: found);
    return Some<NthScan>(value: scan);
  }
  let position = positions^.child_position.inner[at];
  let total = positions^.child_total.inner[at];
  let found = position > 0_u64;
  let scan = NthScan(position: position, total: total, found: found);
  return Some<NthScan>(value: scan);
}
