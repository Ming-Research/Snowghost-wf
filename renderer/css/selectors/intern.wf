alias Atom = pkg::base::atom::Atom;
alias AtomError = pkg::base::atom::AtomError;
alias AtomTable = pkg::base::atom::AtomTable;
alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;
alias atom_intern = pkg::base::atom::atom_intern;

const intern_ceiling: u64 = 65536_u64;

struct AtomPair {
  exact: Atom;
  lower: Atom;
}

fn intern_exact(atoms: &AtomTable, values: &ComponentList, start: u64, end: u64) -> result: Result<Atom, SelectorError> reads(values), writes(atoms) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "Interns values.text[start, end) as written; TooLarge past atom_intern's length limit or when interning refuses.";
  let slice = &values^.text.inner[start..end];
  let fits = slice^.len <= intern_ceiling;
  if fits {
  } else {
    let refusal = SelectorError::TooLarge();
    return Err<Atom, SelectorError>(error: refusal);
  }
  match atom_intern(table: atoms, name: slice) {
    Ok(value: atom) => {
      return Ok<Atom, SelectorError>(value: atom);
    }
    Err(error: overflow) => {
      let refusal = SelectorError::TooLarge();
      return Err<Atom, SelectorError>(error: refusal);
    }
  }
}

fn intern_lowered(atoms: &AtomTable, values: &ComponentList, start: u64, end: u64) -> result: Result<Atom, SelectorError> reads(values), writes(atoms) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "Interns an ASCII-lowercased copy of values.text[start, end); TooLarge past atom_intern's length limit or when interning refuses.";
  let size = end -wrap start;
  let buffer = box_slots_new::<u8>(capacity: size);
  for (at in start..end) {
    let byte = values^.text.inner[at];
    let lowered = ascii_lower_byte(byte: byte);
    let room = buffer.inner.len < buffer.inner.cap;
    if room {
      place_back(window: &buffer.inner, value: lowered);
    }
  }
  let filled = buffer.inner.len;
  let slice = &buffer.inner[0_u64..filled];
  let fits = slice^.len <= intern_ceiling;
  if fits {
  } else {
    let refusal = SelectorError::TooLarge();
    return Err<Atom, SelectorError>(error: refusal);
  }
  match atom_intern(table: atoms, name: slice) {
    Ok(value: atom) => {
      return Ok<Atom, SelectorError>(value: atom);
    }
    Err(error: overflow) => {
      let refusal = SelectorError::TooLarge();
      return Err<Atom, SelectorError>(error: refusal);
    }
  }
}

fn intern_pair(atoms: &AtomTable, values: &ComponentList, start: u64, end: u64) -> result: Result<AtomPair, SelectorError> reads(values), writes(atoms) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "Interns both the exact-case and ASCII-lowercased forms of values.text[start, end).";
  match intern_exact(atoms: atoms, values: values, start: start, end: end) {
    Ok(value: exact) => {
      match intern_lowered(atoms: atoms, values: values, start: start, end: end) {
        Ok(value: lower) => {
          let made = AtomPair(exact: exact, lower: lower);
          return Ok<AtomPair, SelectorError>(value: made);
        }
        Err(error: refusal) => {
          return Err<AtomPair, SelectorError>(error: refusal);
        }
      }
    }
    Err(error: refusal) => {
      return Err<AtomPair, SelectorError>(error: refusal);
    }
  }
}

fn intern_pair_span(atoms: &AtomTable, values: &ComponentList, span: Span) -> result: Result<AtomPair, SelectorError> reads(values), writes(atoms) {
  doc "Widens span to u64, checks it against values.text, and interns both case forms of it; a malformed span (never produced by pkg::css::syntax) reports Invalid defensively.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let ordered = start <= end;
  if ordered {
    let within = end <= values^.text.inner.len;
    if within {
      let result = intern_pair(atoms: atoms, values: values, start: start, end: end);
      return result;
    }
    let refusal = SelectorError::Invalid();
    return Err<AtomPair, SelectorError>(error: refusal);
  }
  let refusal = SelectorError::Invalid();
  return Err<AtomPair, SelectorError>(error: refusal);
}
