fn is_default_ci_attribute(values: &ComponentList, start: u64, end: u64) -> result: Bool reads(values) contract {
  requires start <= end;
  requires end <= values^.text.inner.len;
} {
  doc "True when values.text[start, end) names, ASCII case-insensitively, one of the attributes the HTML Standard lists as having case-insensitive values.";
  let start32 = cvt.wrap::<u64, u32>(start);
  let end32 = cvt.wrap::<u64, u32>(end);
  let span = Span(start: start32, end: end32);
  let hit = ci_equals_any(values: values, span: span);
  return hit;
}

fn ci_equals_any(values: &ComponentList, span: Span) -> result: Bool reads(values) {
  doc "True when span names, ASCII case-insensitively, one of the fixed case-insensitive HTML attribute names.";
  if span_ci_equals(values: values, span: span, literal: &ci_accept[0_u64..ci_accept.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_accept_charset[0_u64..ci_accept_charset.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_align[0_u64..ci_align.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_alink[0_u64..ci_alink.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_axis[0_u64..ci_axis.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_bgcolor[0_u64..ci_bgcolor.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_charset[0_u64..ci_charset.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_checked[0_u64..ci_checked.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_clear[0_u64..ci_clear.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_codetype[0_u64..ci_codetype.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_color[0_u64..ci_color.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_compact[0_u64..ci_compact.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_declare[0_u64..ci_declare.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_defer[0_u64..ci_defer.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_dir[0_u64..ci_dir.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_direction[0_u64..ci_direction.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_disabled[0_u64..ci_disabled.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_enctype[0_u64..ci_enctype.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_face[0_u64..ci_face.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_frame[0_u64..ci_frame.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_hreflang[0_u64..ci_hreflang.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_http_equiv[0_u64..ci_http_equiv.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_lang[0_u64..ci_lang.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_language[0_u64..ci_language.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_link[0_u64..ci_link.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_media[0_u64..ci_media.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_method[0_u64..ci_method.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_multiple[0_u64..ci_multiple.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_nohref[0_u64..ci_nohref.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_noresize[0_u64..ci_noresize.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_noshade[0_u64..ci_noshade.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_nowrap[0_u64..ci_nowrap.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_readonly[0_u64..ci_readonly.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_rel[0_u64..ci_rel.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_rev[0_u64..ci_rev.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_rules[0_u64..ci_rules.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_scope[0_u64..ci_scope.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_scrolling[0_u64..ci_scrolling.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_selected[0_u64..ci_selected.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_shape[0_u64..ci_shape.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_target[0_u64..ci_target.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_text[0_u64..ci_text.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_type[0_u64..ci_type.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_valign[0_u64..ci_valign.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_valuetype[0_u64..ci_valuetype.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &ci_vlink[0_u64..ci_vlink.len]) {
    return True();
  }
  return False();
}
