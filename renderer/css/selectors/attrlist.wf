alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

const ci_accept: Array<u8, 6> = "accept";

const ci_accept_charset: Array<u8, 14> = "accept-charset";

const ci_align: Array<u8, 5> = "align";

const ci_alink: Array<u8, 5> = "alink";

const ci_axis: Array<u8, 4> = "axis";

const ci_bgcolor: Array<u8, 7> = "bgcolor";

const ci_charset: Array<u8, 7> = "charset";

const ci_checked: Array<u8, 7> = "checked";

const ci_clear: Array<u8, 5> = "clear";

const ci_codetype: Array<u8, 8> = "codetype";

const ci_color: Array<u8, 5> = "color";

