const ci_rev: Array<u8, 3> = "rev";

const ci_rules: Array<u8, 5> = "rules";

const ci_scope: Array<u8, 5> = "scope";

const ci_scrolling: Array<u8, 9> = "scrolling";

const ci_selected: Array<u8, 8> = "selected";

const ci_shape: Array<u8, 5> = "shape";

const ci_target: Array<u8, 6> = "target";

const ci_text: Array<u8, 4> = "text";

