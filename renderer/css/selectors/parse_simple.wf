alias AtomTable = pkg::base::atom::AtomTable;
alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

struct SimpleStep {
  pos: u64;
  is_pseudo_element: Bool;
}

fn delim_is(c: Component, wanted: u32) -> result: Bool pure {
  doc "True when c is a Delim component whose code point is wanted.";
  match as_delim(c: c) {
    Some(value: cp) => {
      let same = cp == wanted;
      return same;
    }
    None() => {
      return False();
    }
  }
}

fn push_type_or_universal(instrs: &Box<Slots<Instr>>, ns: NsConstraint, atoms: &AtomTable, values: &ComponentList, name: Option<Span>) -> result: Result<unit, SelectorError> reads(values), writes(atoms), writes(instrs) {
  doc "Pushes Instr::Universal(ns) when name is None, otherwise interns name and pushes Instr::Type(ns, exact, lower); skips the push entirely for a plain unprefixed universal, which needs no instruction.";
  match name {
    Some(value: span) => {
      match intern_pair_span(atoms: atoms, values: values, span: span) {
        Ok(value: pair) => {
          let made = Instr::Type(ns: ns, exact: pair.exact, lower: pair.lower);
          match push_instr(instrs: instrs, value: made) {
            Ok(value: idx) => {
              return Ok<unit, SelectorError>(value: unit);
            }
            Err(error: refusal) => {
              return Err<unit, SelectorError>(error: refusal);
            }
          }
        }
        Err(error: refusal) => {
          return Err<unit, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let plain = match ns {
        AnyNs() => {
          give True();
        }
        NoNs() => {
          give False();
        }
      }
      if plain {
        return Ok<unit, SelectorError>(value: unit);
      }
      let made = Instr::Universal(ns: ns);
      match push_instr(instrs: instrs, value: made) {
        Ok(value: idx) => {
          return Ok<unit, SelectorError>(value: unit);
        }
        Err(error: refusal) => {
          return Err<unit, SelectorError>(error: refusal);
        }
      }
    }
  }
}

fn try_type_or_universal(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, pos: u64, limit: u64) -> result: Result<Option<u64>, SelectorError> reads(values), writes(atoms), writes(instrs) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes a type or universal selector at pos, with an optional *| or | namespace prefix (never another prefix); None when pos does not begin one.";
  let has = pos < limit;
  if has {
  } else {
    let step_opt_1 = None<u64>();
    return Ok<Option<u64>, SelectorError>(value: step_opt_1);
  }
  let c = values^.components.inner[pos];
  let star = delim_is(c: c, wanted: 42_u32);
  if star {
    let after_star = pos +wrap 1_u64;
    let has_bar = after_star < limit;
    let bar_here = if has_bar {
      let c2 = values^.components.inner[after_star];
      give delim_is(c: c2, wanted: 124_u32);
    } else {
      give False();
    }
    if bar_here {
      let after_bar = after_star +wrap 1_u64;
      let has_name = after_bar < limit;
      if has_name {
      } else {
        let refusal = SelectorError::Invalid();
        return Err<Option<u64>, SelectorError>(error: refusal);
      }
      let c3 = values^.components.inner[after_bar];
      let star2 = delim_is(c: c3, wanted: 42_u32);
      if star2 {
        let next = after_bar +wrap 1_u64;
        let ns = NsConstraint::AnyNs();
        let none_name = None<Span>();
        match push_type_or_universal(instrs: instrs, ns: ns, atoms: atoms, values: values, name: none_name) {
          Ok(value: done) => {
            let step_val_2 = next;
            let step_opt_2 = Some<u64>(value: step_val_2);
            return Ok<Option<u64>, SelectorError>(value: step_opt_2);
          }
          Err(error: refusal) => {
            return Err<Option<u64>, SelectorError>(error: refusal);
          }
        }
      }
      match as_ident(c: c3) {
        Some(value: name_span) => {
          let next = after_bar +wrap 1_u64;
          let ns = NsConstraint::AnyNs();
          let some_name = Some<Span>(value: name_span);
          match push_type_or_universal(instrs: instrs, ns: ns, atoms: atoms, values: values, name: some_name) {
            Ok(value: done) => {
              let step_val_3 = next;
              let step_opt_3 = Some<u64>(value: step_val_3);
              return Ok<Option<u64>, SelectorError>(value: step_opt_3);
            }
            Err(error: refusal) => {
              return Err<Option<u64>, SelectorError>(error: refusal);
            }
          }
        }
        None() => {
          let refusal = SelectorError::Invalid();
          return Err<Option<u64>, SelectorError>(error: refusal);
        }
      }
    }
    let step_val_4 = after_star;
    let step_opt_4 = Some<u64>(value: step_val_4);
    return Ok<Option<u64>, SelectorError>(value: step_opt_4);
  }
  let bar = delim_is(c: c, wanted: 124_u32);
  if bar {
    let after_bar = pos +wrap 1_u64;
    let has_name = after_bar < limit;
    if has_name {
    } else {
      let refusal = SelectorError::Invalid();
      return Err<Option<u64>, SelectorError>(error: refusal);
    }
    let c2 = values^.components.inner[after_bar];
    let star2 = delim_is(c: c2, wanted: 42_u32);
    if star2 {
      let next = after_bar +wrap 1_u64;
      let ns = NsConstraint::NoNs();
      let none_name = None<Span>();
      match push_type_or_universal(instrs: instrs, ns: ns, atoms: atoms, values: values, name: none_name) {
        Ok(value: done) => {
          let step_val_5 = next;
          let step_opt_5 = Some<u64>(value: step_val_5);
          return Ok<Option<u64>, SelectorError>(value: step_opt_5);
        }
        Err(error: refusal) => {
          return Err<Option<u64>, SelectorError>(error: refusal);
        }
      }
    }
    match as_ident(c: c2) {
      Some(value: name_span) => {
        let next = after_bar +wrap 1_u64;
        let ns = NsConstraint::NoNs();
        let some_name = Some<Span>(value: name_span);
        match push_type_or_universal(instrs: instrs, ns: ns, atoms: atoms, values: values, name: some_name) {
          Ok(value: done) => {
            let step_val_6 = next;
            let step_opt_6 = Some<u64>(value: step_val_6);
            return Ok<Option<u64>, SelectorError>(value: step_opt_6);
          }
          Err(error: refusal) => {
            return Err<Option<u64>, SelectorError>(error: refusal);
          }
        }
      }
      None() => {
        let refusal = SelectorError::Invalid();
        return Err<Option<u64>, SelectorError>(error: refusal);
      }
    }
  }
  match as_ident(c: c) {
    Some(value: name_span) => {
      let after_name = pos +wrap 1_u64;
      let has_bar2 = after_name < limit;
      let followed_by_bar = if has_bar2 {
        let c2 = values^.components.inner[after_name];
        give delim_is(c: c2, wanted: 124_u32);
      } else {
        give False();
      }
      if followed_by_bar {
        let refusal = SelectorError::Invalid();
        return Err<Option<u64>, SelectorError>(error: refusal);
      }
      let ns = NsConstraint::AnyNs();
      let some_name = Some<Span>(value: name_span);
      match push_type_or_universal(instrs: instrs, ns: ns, atoms: atoms, values: values, name: some_name) {
        Ok(value: done) => {
          let step_val_7 = after_name;
          let step_opt_7 = Some<u64>(value: step_val_7);
          return Ok<Option<u64>, SelectorError>(value: step_opt_7);
        }
        Err(error: refusal) => {
          return Err<Option<u64>, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let step_opt_8 = None<u64>();
      return Ok<Option<u64>, SelectorError>(value: step_opt_8);
    }
  }
}

fn try_id(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, pos: u64, limit: u64) -> result: Result<Option<u64>, SelectorError> reads(values), writes(atoms), writes(instrs) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes an id selector (a Hash component) at pos; None when pos does not begin one.";
  let has = pos < limit;
  if has {
  } else {
    let step_opt_9 = None<u64>();
    return Ok<Option<u64>, SelectorError>(value: step_opt_9);
  }
  let c = values^.components.inner[pos];
  match as_hash(c: c) {
    Some(value: info) => {
      match intern_pair_span(atoms: atoms, values: values, span: info.name) {
        Ok(value: pair) => {
          let made = Instr::Id(exact: pair.exact, lower: pair.lower);
          match push_instr(instrs: instrs, value: made) {
            Ok(value: idx) => {
              let next = pos +wrap 1_u64;
              let step_val_10 = next;
              let step_opt_10 = Some<u64>(value: step_val_10);
              return Ok<Option<u64>, SelectorError>(value: step_opt_10);
            }
            Err(error: refusal) => {
              return Err<Option<u64>, SelectorError>(error: refusal);
            }
          }
        }
        Err(error: refusal) => {
          return Err<Option<u64>, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let step_opt_11 = None<u64>();
      return Ok<Option<u64>, SelectorError>(value: step_opt_11);
    }
  }
}

fn try_class(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, pos: u64, limit: u64) -> result: Result<Option<u64>, SelectorError> reads(values), writes(atoms), writes(instrs) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes a class selector, a Delim '.' immediately followed by an Ident, at pos; None when pos does not begin with '.', and Invalid when '.' is not immediately followed by an Ident.";
  let has = pos < limit;
  if has {
  } else {
    let step_opt_12 = None<u64>();
    return Ok<Option<u64>, SelectorError>(value: step_opt_12);
  }
  let c = values^.components.inner[pos];
  let dot = delim_is(c: c, wanted: 46_u32);
  if dot {
  } else {
    let step_opt_13 = None<u64>();
    return Ok<Option<u64>, SelectorError>(value: step_opt_13);
  }
  let after_dot = pos +wrap 1_u64;
  let has_name = after_dot < limit;
  if has_name {
  } else {
    let refusal = SelectorError::Invalid();
    return Err<Option<u64>, SelectorError>(error: refusal);
  }
  let c2 = values^.components.inner[after_dot];
  match as_ident(c: c2) {
    Some(value: name_span) => {
      match intern_pair_span(atoms: atoms, values: values, span: name_span) {
        Ok(value: pair) => {
          let made = Instr::Class(exact: pair.exact, lower: pair.lower);
          match push_instr(instrs: instrs, value: made) {
            Ok(value: idx) => {
              let next = after_dot +wrap 1_u64;
              let step_val_14 = next;
              let step_opt_14 = Some<u64>(value: step_val_14);
              return Ok<Option<u64>, SelectorError>(value: step_opt_14);
            }
            Err(error: refusal) => {
              return Err<Option<u64>, SelectorError>(error: refusal);
            }
          }
        }
        Err(error: refusal) => {
          return Err<Option<u64>, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let refusal = SelectorError::Invalid();
      return Err<Option<u64>, SelectorError>(error: refusal);
    }
  }
}
