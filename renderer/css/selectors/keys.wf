alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;

fn alternative_count(list: &SelectorList) -> count: u64 reads(list) {
  doc "The top-level alternatives of list, none when its bounds are reversed.";
  let start = cvt::<u32, u64>(list^.top_start);
  let end = cvt::<u32, u64>(list^.top_end);
  let ordered = start <= end;
  if ordered {
    return end - start;
  }
  return 0_u64;
}

fn name_hash(bytes: &[u8]) -> hash: u64 reads(bytes) {
  doc "FNV-1a over bytes, each ASCII upper-case letter folded to lower case first.";
  let count = bytes^.len;
  let hash = 14695981039346656037_u64;
  for (at in 0_u64..count) {
    let byte = bytes^[at];
    let upper_from = byte >= 65_u8;
    let upper_to = byte <= 90_u8;
    let upper = band(upper_from, upper_to);
    let folded = if upper {
      give byte +wrap 32_u8;
    } else {
      give byte;
    }
    let wide = cvt::<u8, u64>(folded);
    let mixed = ixor(hash, wide);
    set hash = mixed *wrap 1099511628211_u64;
  }
  return hash;
}

fn atom_hash(atoms: &AtomTable, atom: Atom) -> hash: u64 reads(atoms) {
  doc "name_hash of atom's text.";
  let (start, end) = atom_bounds(atoms: atoms, atom: atom);
  let hash = name_hash(bytes: &atoms^.text.inner[start..end]);
  return hash;
}

fn subject_key(list: &SelectorList, atoms: &AtomTable, alternative: u64) -> key: SubjectKey reads(list), reads(atoms) {
  doc "Reads the rightmost compound of the alternative, as match_complex starts from it, and keys it by its first id, else its first class, else its type selector.";
  let anything = SubjectKey::Anything();
  let nothing = SubjectKey::Nothing();
  let start = cvt::<u32, u64>(list^.top_start);
  let count = alternative_count(list: list);
  let inside = alternative < count;
  if inside {
  } else {
    return anything;
  }
  let position = start +wrap alternative;
  let order_ok = position < list^.alt_order.inner.len;
  if order_ok {
  } else {
    return anything;
  }
  let actual = cvt::<u32, u64>(list^.alt_order.inner[position]);
  let alt_ok = actual < list^.alts.inner.len;
  if alt_ok {
  } else {
    return anything;
  }
  let alt = list^.alts.inner[actual];
  if alt.never_matches {
    return nothing;
  }
  let has_compound = alt.compound_start < alt.compound_end;
  if has_compound {
  } else {
    return nothing;
  }
  let last_narrow = alt.compound_end -wrap 1_u32;
  let last = cvt::<u32, u64>(last_narrow);
  let last_ok = last < list^.compound_order.inner.len;
  if last_ok {
  } else {
    return anything;
  }
  let compound_at = cvt::<u32, u64>(list^.compound_order.inner[last]);
  let compound_ok = compound_at < list^.compounds.inner.len;
  if compound_ok {
  } else {
    return anything;
  }
  let compound = list^.compounds.inner[compound_at];
  let first = cvt::<u32, u64>(compound.simple_start);
  let end = cvt::<u32, u64>(compound.simple_end);
  let found = anything;
  let has_class = False();
  let has_type = False();
  for (k in first..end) {
    let order_in = k < list^.instr_order.inner.len;
    if order_in {
      let at = cvt::<u32, u64>(list^.instr_order.inner[k]);
      let instr_in = at < list^.instrs.inner.len;
      if instr_in {
        let instr = list^.instrs.inner[at];
        match instr {
          Id(exact: ex, lower: lo) => {
            let hash = atom_hash(atoms: atoms, atom: lo);
            return SubjectKey::Id(hash: hash);
          }
          Class(exact: ex, lower: lo) => {
            if has_class {
            } else {
              let hash = atom_hash(atoms: atoms, atom: lo);
              set found = SubjectKey::Class(hash: hash);
              set has_class = True();
            }
          }
          Type(ns: constraint, exact: ex, lower: lo) => {
            let untyped = bnot(has_class);
            let first_type = bnot(has_type);
            let usable = band(untyped, first_type);
            if usable {
              let hash = atom_hash(atoms: atoms, atom: lo);
              set found = SubjectKey::Type(hash: hash);
              set has_type = True();
            }
          }
          Universal(..) => {
          }
          AttrPresence(..) => {
          }
          AttrMatch(..) => {
          }
          Root() => {
          }
          Empty() => {
          }
          FirstChild() => {
          }
          LastChild() => {
          }
          OnlyChild() => {
          }
          FirstOfType() => {
          }
          LastOfType() => {
          }
          OnlyOfType() => {
          }
          NthChild(..) => {
          }
          NthLastChild(..) => {
          }
          NthOfType(..) => {
          }
          NthLastOfType(..) => {
          }
          Not(..) => {
          }
          Is(..) => {
          }
          Where(..) => {
          }
          Link() => {
          }
          AnyLink() => {
          }
          Visited() => {
          }
          Checked() => {
          }
          Enabled() => {
          }
          Disabled() => {
          }
          Lang(..) => {
          }
          Target() => {
          }
          Scope() => {
          }
          Defined() => {
          }
          Hover() => {
          }
          Active() => {
          }
          Focus() => {
          }
          FocusWithin() => {
          }
          FocusVisible() => {
          }
        }
      }
    }
  }
  return found;
}
