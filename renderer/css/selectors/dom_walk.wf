alias Atom = pkg::base::atom::Atom;
alias Attribute = pkg::dom::Attribute;
alias AttributeNamespace = pkg::dom::AttributeNamespace;
alias Document = pkg::dom::Document;
alias Links = pkg::dom::Links;
alias Namespace = pkg::dom::Namespace;
alias NodeData = pkg::dom::NodeData;
alias NodeId = pkg::dom::NodeId;
alias QuirksMode = pkg::dom::QuirksMode;
alias TextSpan = pkg::dom::TextSpan;

struct ElemInfo {
  namespace: Namespace;
  local_name: Atom;
}

fn node_links(document: &Document, node: NodeId) -> result: Option<Links> reads(document) {
  doc "The links of node, or None when it names no node.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  let within = index < count;
  if within {
  } else {
    return None<Links>();
  }
  let links = document^.nodes.inner[index].links;
  return Some<Links>(value: links);
}

fn element_info(document: &Document, node: NodeId) -> result: Option<ElemInfo> reads(document) {
  doc "The namespace and local name of node when it is an Element, and None otherwise.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  let within = index < count;
  if within {
  } else {
    return None<ElemInfo>();
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(namespace: ns, local_name: name, attributes: attrs, template_contents: tc) => {
      let made = ElemInfo(namespace: ns^, local_name: name^);
      return Some<ElemInfo>(value: made);
    }
    DocumentRoot(quirks: q) => {
      return None<ElemInfo>();
    }
    DocumentType(name: n, public_id: p, system_id: s) => {
      return None<ElemInfo>();
    }
    Text(data: d) => {
      return None<ElemInfo>();
    }
    Comment(data: d) => {
      return None<ElemInfo>();
    }
    Fragment() => {
      return None<ElemInfo>();
    }
  }
}

fn is_element_node(document: &Document, node: NodeId) -> result: Bool reads(document) {
  doc "True when node names an Element node.";
  match element_info(document: document, node: node) {
    Some(value: info) => {
      return True();
    }
    None() => {
      return False();
    }
  }
}

fn same_node(first: NodeId, second: NodeId) -> result: Bool pure {
  doc "True when first and second name the same node.";
  let same = first.index == second.index;
  return same;
}

fn quirks_mode_of(document: &Document) -> result: QuirksMode reads(document) {
  doc "The document's quirks mode, read from the DocumentRoot at node index 0; NoQuirks when the document is malformed.";
  let count = document^.nodes.inner.len;
  let has_root = count > 0_u64;
  if has_root {
  } else {
    let mode = QuirksMode::NoQuirks();
    return mode;
  }
  let data = &document^.nodes.inner[0_u64].data;
  match data^ {
    DocumentRoot(quirks: q) => {
      return q^;
    }
    Element(namespace: ns, local_name: n, attributes: a, template_contents: t) => {
      let mode = QuirksMode::NoQuirks();
      return mode;
    }
    DocumentType(name: n, public_id: p, system_id: s) => {
      let mode = QuirksMode::NoQuirks();
      return mode;
    }
    Text(data: d) => {
      let mode = QuirksMode::NoQuirks();
      return mode;
    }
    Comment(data: d) => {
      let mode = QuirksMode::NoQuirks();
      return mode;
    }
    Fragment() => {
      let mode = QuirksMode::NoQuirks();
      return mode;
    }
  }
}

fn is_quirks(document: &Document) -> result: Bool reads(document) {
  doc "True when the document's quirks mode is Quirks (not NoQuirks or LimitedQuirks).";
  match quirks_mode_of(document: document) {
    Quirks() => {
      return True();
    }
    NoQuirks() => {
      return False();
    }
    LimitedQuirks() => {
      return False();
    }
  }
}

fn parent_of(document: &Document, node: NodeId) -> result: Option<NodeId> reads(document) {
  doc "The parent of node, or None when node has none or names no node.";
  match node_links(document: document, node: node) {
    Some(value: links) => {
      return links.parent;
    }
    None() => {
      return None<NodeId>();
    }
  }
}

fn previous_element_sibling(document: &Document, node: NodeId) -> result: Option<NodeId> reads(document) {
  doc "The nearest previous sibling of node that is an Element, or None; bounded by the document's node count.";
  let count = document^.nodes.inner.len;
  let cursor = node;
  for (step in 0_u64..count) {
    match node_links(document: document, node: cursor) {
      Some(value: links) => {
        match links.previous_sibling {
          Some(value: sib) => {
            let is_elem = is_element_node(document: document, node: sib);
            if is_elem {
              return Some<NodeId>(value: sib);
            }
            set cursor = sib;
          }
          None() => {
            return None<NodeId>();
          }
        }
      }
      None() => {
        return None<NodeId>();
      }
    }
  }
  return None<NodeId>();
}

fn next_element_sibling(document: &Document, node: NodeId) -> result: Option<NodeId> reads(document) {
  doc "The nearest next sibling of node that is an Element, or None; bounded by the document's node count.";
  let count = document^.nodes.inner.len;
  let cursor = node;
  for (step in 0_u64..count) {
    match node_links(document: document, node: cursor) {
      Some(value: links) => {
        match links.next_sibling {
          Some(value: sib) => {
            let is_elem = is_element_node(document: document, node: sib);
            if is_elem {
              return Some<NodeId>(value: sib);
            }
            set cursor = sib;
          }
          None() => {
            return None<NodeId>();
          }
        }
      }
      None() => {
        return None<NodeId>();
      }
    }
  }
  return None<NodeId>();
}

fn is_root_element(document: &Document, node: NodeId) -> result: Bool reads(document) {
  doc "True when node is an Element with no Element ancestor.";
  let is_elem = is_element_node(document: document, node: node);
  if is_elem {
  } else {
    return False();
  }
  let count = document^.nodes.inner.len;
  let cursor = node;
  for (step in 0_u64..count) {
    match parent_of(document: document, node: cursor) {
      Some(value: p) => {
        let p_is_elem = is_element_node(document: document, node: p);
        if p_is_elem {
          return False();
        }
        set cursor = p;
      }
      None() => {
        return True();
      }
    }
  }
  return True();
}

fn is_empty_element(document: &Document, node: NodeId) -> result: Bool reads(document) {
  doc "True when node has no Element or Text child.";
  match node_links(document: document, node: node) {
    Some(value: links) => {
      let count = document^.nodes.inner.len;
      let cursor_opt = links.first_child;
      for (step in 0_u64..count) {
        match cursor_opt {
          Some(value: c) => {
            let non_empty = child_blocks_empty(document: document, node: c);
            if non_empty {
              return False();
            }
            match node_links(document: document, node: c) {
              Some(value: cl) => {
                set cursor_opt = cl.next_sibling;
              }
              None() => {
                return True();
              }
            }
          }
          None() => {
            return True();
          }
        }
      }
      return True();
    }
    None() => {
      return True();
    }
  }
}

fn child_blocks_empty(document: &Document, node: NodeId) -> result: Bool reads(document) {
  doc "True when node is an Element or Text node, the two kinds :empty counts.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  let within = index < count;
  if within {
  } else {
    return False();
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(namespace: ns, local_name: n, attributes: a, template_contents: t) => {
      return True();
    }
    Text(data: d) => {
      return True();
    }
    DocumentRoot(quirks: q) => {
      return False();
    }
    DocumentType(name: n, public_id: p, system_id: s) => {
      return False();
    }
    Comment(data: d) => {
      return False();
    }
    Fragment() => {
      return False();
    }
  }
}

fn attribute_namespace_matches(attr_ns: AttributeNamespace, constraint: NsConstraint) -> result: Bool pure {
  doc "True when attr_ns satisfies constraint: AnyNs matches every attribute namespace, NoNs only NoNamespace.";
  match constraint {
    AnyNs() => {
      return True();
    }
    NoNs() => {
      match attr_ns {
        NoNamespace() => {
          return True();
        }
        XLink() => {
          return False();
        }
        Xml() => {
          return False();
        }
        XmlNs() => {
          return False();
        }
      }
    }
  }
}

fn find_attribute(document: &Document, node: NodeId, ns: NsConstraint, exact: Atom, lower: Atom, is_html: Bool) -> result: Option<TextSpan> reads(document) {
  doc "The value span of the first attribute of node whose namespace satisfies ns and whose name equals exact (case-sensitive elements) or lower (HTML elements); None when node is no Element or has no such attribute.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  let within = index < count;
  if within {
  } else {
    return None<TextSpan>();
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(namespace: elem_ns, local_name: elem_name, attributes: attrs, template_contents: tc) => {
      let want = if is_html {
        give lower;
      } else {
        give exact;
      }
      let acount = attrs^.inner.len;
      for (at in 0_u64..acount) {
        let attr = attrs^.inner[at];
        let ns_ok = attribute_namespace_matches(attr_ns: attr.namespace, constraint: ns);
        if ns_ok {
          let name_ok = attr.name.index == want.index;
          if name_ok {
            return Some<TextSpan>(value: attr.value);
          }
        }
      }
      return None<TextSpan>();
    }
    DocumentRoot(quirks: q) => {
      return None<TextSpan>();
    }
    DocumentType(name: n, public_id: p, system_id: s) => {
      return None<TextSpan>();
    }
    Text(data: d) => {
      return None<TextSpan>();
    }
    Comment(data: d) => {
      return None<TextSpan>();
    }
    Fragment() => {
      return None<TextSpan>();
    }
  }
}
