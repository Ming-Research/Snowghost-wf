fn bytes_eq(hay: &[u8], needle: &[u8], ci: Bool) -> result: Bool reads(hay), reads(needle) {
  doc "True when hay and needle hold the same bytes, ASCII case-insensitively when ci.";
  let same_len = hay^.len == needle^.len;
  if same_len {
  } else {
    return False();
  }
  let size = hay^.len;
  for (at in 0_u64..size) {
    let a = hay^[at];
    let b = needle^[at];
    let ok = byte_eq(a: a, b: b, ci: ci);
    if ok {
    } else {
      return False();
    }
  }
  return True();
}

fn byte_eq(a: u8, b: u8, ci: Bool) -> result: Bool pure {
  doc "True when a and b are the same byte, ASCII case-insensitively when ci.";
  if ci {
    let la = ascii_lower_byte(byte: a);
    let lb = ascii_lower_byte(byte: b);
    let same = la == lb;
    return same;
  }
  let same = a == b;
  return same;
}

fn bytes_prefix(hay: &[u8], needle: &[u8], ci: Bool) -> result: Bool reads(hay), reads(needle) {
  doc "True when hay begins with needle, ASCII case-insensitively when ci; False when needle is empty.";
  let n = needle^.len;
  let has_needle = n > 0_u64;
  if has_needle {
  } else {
    return False();
  }
  let long_enough = hay^.len >= n;
  if long_enough {
  } else {
    return False();
  }
  let window = &hay^[0_u64..n];
  let same = bytes_eq(hay: window, needle: needle, ci: ci);
  return same;
}

fn bytes_suffix(hay: &[u8], needle: &[u8], ci: Bool) -> result: Bool reads(hay), reads(needle) {
  doc "True when hay ends with needle, ASCII case-insensitively when ci; False when needle is empty.";
  let n = needle^.len;
  let has_needle = n > 0_u64;
  if has_needle {
  } else {
    return False();
  }
  let h = hay^.len;
  let long_enough = h >= n;
  if long_enough {
  } else {
    return False();
  }
  let start = h -wrap n;
  let start_ok = start <= h;
  if start_ok {
  } else {
    return False();
  }
  let window = &hay^[start..h];
  let same = bytes_eq(hay: window, needle: needle, ci: ci);
  return same;
}

fn bytes_contains(hay: &[u8], needle: &[u8], ci: Bool) -> result: Bool reads(hay), reads(needle) {
  doc "True when needle occurs somewhere in hay, ASCII case-insensitively when ci; False when needle is empty.";
  let n = needle^.len;
  let has_needle = n > 0_u64;
  if has_needle {
  } else {
    return False();
  }
  let h = hay^.len;
  let long_enough = h >= n;
  if long_enough {
  } else {
    return False();
  }
  let span = h -wrap n;
  let last_start = span +wrap 1_u64;
  for (at in 0_u64..last_start) {
    let ending = at +wrap n;
    let order_ok = at <= ending;
    if order_ok {
    } else {
      return False();
    }
    let bound_ok = ending <= h;
    if bound_ok {
    } else {
      return False();
    }
    let window = &hay^[at..ending];
    let same = bytes_eq(hay: window, needle: needle, ci: ci);
    if same {
      return True();
    }
  }
  return False();
}

fn is_ascii_space(byte: u8) -> result: Bool pure {
  doc "True when byte is an ASCII whitespace character the CSS list-attribute matchers split on.";
  let is_space = byte == 32_u8;
  if is_space {
    return True();
  }
  let is_tab = byte == 9_u8;
  if is_tab {
    return True();
  }
  let is_lf = byte == 10_u8;
  if is_lf {
    return True();
  }
  let is_ff = byte == 12_u8;
  if is_ff {
    return True();
  }
  let is_cr = byte == 13_u8;
  return is_cr;
}

fn bytes_word_contains(hay: &[u8], needle: &[u8], ci: Bool) -> result: Bool reads(hay), reads(needle) {
  doc "True when needle equals one of hay's ASCII-whitespace-separated words, ASCII case-insensitively when ci; False when needle is empty.";
  let n = needle^.len;
  let has_needle = n > 0_u64;
  if has_needle {
  } else {
    return False();
  }
  let h = hay^.len;
  let pos = 0_u64;
  loop @words {
    let skip_start = pos;
    let at_end0 = skip_start >= h;
    if at_end0 {
      break @words;
    }
    let word_start = skip_ws_bytes(hay: hay, at: skip_start, limit: h);
    let at_end1 = word_start >= h;
    if at_end1 {
      break @words;
    }
    let word_end = word_end_bytes(hay: hay, at: word_start, limit: h);
    let order_ok = word_start <= word_end;
    if order_ok {
    } else {
      return False();
    }
    let bound_ok = word_end <= hay^.len;
    if bound_ok {
    } else {
      return False();
    }
    let window = &hay^[word_start..word_end];
    let same = bytes_eq(hay: window, needle: needle, ci: ci);
    if same {
      return True();
    }
    set pos = word_end;
  }
  return False();
}

fn skip_ws_bytes(hay: &[u8], at: u64, limit: u64) -> result: u64 reads(hay) contract {
  requires at <= limit;
  requires limit <= hay^.len;
} {
  doc "Advances at past ASCII whitespace bytes up to limit.";
  let pos = at;
  loop @skip {
    let more = pos < limit;
    if more {
    } else {
      break @skip;
    }
    let byte = hay^[pos];
    let is_ws = is_ascii_space(byte: byte);
    if is_ws {
      let next = pos +wrap 1_u64;
      set pos = next;
    } else {
      break @skip;
    }
  }
  return pos;
}

fn word_end_bytes(hay: &[u8], at: u64, limit: u64) -> result: u64 reads(hay) contract {
  requires at <= limit;
  requires limit <= hay^.len;
} {
  doc "Advances at past non-whitespace bytes up to limit.";
  let pos = at;
  loop @scan {
    let more = pos < limit;
    if more {
    } else {
      break @scan;
    }
    let byte = hay^[pos];
    let is_ws = is_ascii_space(byte: byte);
    if is_ws {
      break @scan;
    }
    let next = pos +wrap 1_u64;
    set pos = next;
  }
  return pos;
}

fn bytes_dash_match(hay: &[u8], needle: &[u8], ci: Bool) -> result: Bool reads(hay), reads(needle) {
  doc "True when hay equals needle or begins with needle followed immediately by a hyphen-minus, ASCII case-insensitively when ci.";
  let equal = bytes_eq(hay: hay, needle: needle, ci: ci);
  if equal {
    return True();
  }
  let n = needle^.len;
  let h = hay^.len;
  let room = h > n;
  if room {
  } else {
    return False();
  }
  let prefix_window = &hay^[0_u64..n];
  let prefix_same = bytes_eq(hay: prefix_window, needle: needle, ci: ci);
  if prefix_same {
  } else {
    return False();
  }
  let dash = hay^[n];
  let is_dash = dash == 45_u8;
  return is_dash;
}
