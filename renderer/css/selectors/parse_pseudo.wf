alias AtomTable = pkg::base::atom::AtomTable;
alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

const pc_root: Array<u8, 4> = "root";

const pc_empty: Array<u8, 5> = "empty";

const pc_first_child: Array<u8, 11> = "first-child";

const pc_last_child: Array<u8, 10> = "last-child";

const pc_only_child: Array<u8, 10> = "only-child";

const pc_first_of_type: Array<u8, 13> = "first-of-type";

const pc_last_of_type: Array<u8, 12> = "last-of-type";

const pc_only_of_type: Array<u8, 12> = "only-of-type";

const pc_link: Array<u8, 4> = "link";

const pc_any_link: Array<u8, 8> = "any-link";

const pc_visited: Array<u8, 7> = "visited";

const pc_checked: Array<u8, 7> = "checked";

const pc_enabled: Array<u8, 7> = "enabled";

const pc_disabled: Array<u8, 8> = "disabled";

const pc_target: Array<u8, 6> = "target";

const pc_scope: Array<u8, 5> = "scope";

const pc_defined: Array<u8, 7> = "defined";

const pc_hover: Array<u8, 5> = "hover";

const pc_active: Array<u8, 6> = "active";

const pc_focus: Array<u8, 5> = "focus";

const pc_focus_within: Array<u8, 12> = "focus-within";

const pc_focus_visible: Array<u8, 13> = "focus-visible";

const pe_before: Array<u8, 6> = "before";

const pe_after: Array<u8, 5> = "after";

const pe_first_line: Array<u8, 10> = "first-line";

const pe_first_letter: Array<u8, 12> = "first-letter";

const fn_nth_child: Array<u8, 9> = "nth-child";

const fn_nth_last_child: Array<u8, 14> = "nth-last-child";

const fn_nth_of_type: Array<u8, 11> = "nth-of-type";

const fn_nth_last_of_type: Array<u8, 16> = "nth-last-of-type";

const fn_not: Array<u8, 3> = "not";

const fn_is: Array<u8, 2> = "is";

const fn_where: Array<u8, 5> = "where";

const fn_lang: Array<u8, 4> = "lang";

const fn_slotted: Array<u8, 7> = "slotted";

const kw_of: Array<u8, 2> = "of";

fn simple_pseudo_class_instr(values: &ComponentList, span: Span) -> result: Option<Instr> reads(values) {
  doc "The Instr a known argument-less pseudo-class name spells, ASCII case-insensitively, and None when span names no such pseudo-class.";
  if span_ci_equals(values: values, span: span, literal: &pc_root[0_u64..pc_root.len]) {
    let made = Instr::Root();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_empty[0_u64..pc_empty.len]) {
    let made = Instr::Empty();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_first_child[0_u64..pc_first_child.len]) {
    let made = Instr::FirstChild();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_last_child[0_u64..pc_last_child.len]) {
    let made = Instr::LastChild();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_only_child[0_u64..pc_only_child.len]) {
    let made = Instr::OnlyChild();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_first_of_type[0_u64..pc_first_of_type.len]) {
    let made = Instr::FirstOfType();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_last_of_type[0_u64..pc_last_of_type.len]) {
    let made = Instr::LastOfType();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_only_of_type[0_u64..pc_only_of_type.len]) {
    let made = Instr::OnlyOfType();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_any_link[0_u64..pc_any_link.len]) {
    let made = Instr::AnyLink();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_link[0_u64..pc_link.len]) {
    let made = Instr::Link();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_visited[0_u64..pc_visited.len]) {
    let made = Instr::Visited();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_checked[0_u64..pc_checked.len]) {
    let made = Instr::Checked();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_enabled[0_u64..pc_enabled.len]) {
    let made = Instr::Enabled();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_disabled[0_u64..pc_disabled.len]) {
    let made = Instr::Disabled();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_target[0_u64..pc_target.len]) {
    let made = Instr::Target();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_scope[0_u64..pc_scope.len]) {
    let made = Instr::Scope();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_defined[0_u64..pc_defined.len]) {
    let made = Instr::Defined();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_focus_within[0_u64..pc_focus_within.len]) {
    let made = Instr::FocusWithin();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_focus_visible[0_u64..pc_focus_visible.len]) {
    let made = Instr::FocusVisible();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_hover[0_u64..pc_hover.len]) {
    let made = Instr::Hover();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_active[0_u64..pc_active.len]) {
    let made = Instr::Active();
    return Some<Instr>(value: made);
  }
  if span_ci_equals(values: values, span: span, literal: &pc_focus[0_u64..pc_focus.len]) {
    let made = Instr::Focus();
    return Some<Instr>(value: made);
  }
  return None<Instr>();
}

fn is_pseudo_element_name(values: &ComponentList, span: Span) -> result: Bool reads(values) {
  doc "True when span names, ASCII case-insensitively, one of before, after, first-line or first-letter.";
  if span_ci_equals(values: values, span: span, literal: &pe_before[0_u64..pe_before.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &pe_after[0_u64..pe_after.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &pe_first_line[0_u64..pe_first_line.len]) {
    return True();
  }
  if span_ci_equals(values: values, span: span, literal: &pe_first_letter[0_u64..pe_first_letter.len]) {
    return True();
  }
  return False();
}

fn pseudo_class_step(instrs: &Box<Slots<Instr>>, made: Instr, next: u64) -> result: Result<Option<SimpleStep>, SelectorError> writes(instrs) {
  doc "Pushes made and returns the step past next, with is_pseudo_element false.";
  match push_instr(instrs: instrs, value: made) {
    Ok(value: idx) => {
      let no_pe = False();
      let step = SimpleStep(pos: next, is_pseudo_element: no_pe);
      let some_step = Some<SimpleStep>(value: step);
      return Ok<Option<SimpleStep>, SelectorError>(value: some_step);
    }
    Err(error: refusal) => {
      return Err<Option<SimpleStep>, SelectorError>(error: refusal);
    }
  }
}

fn pseudo_element_step(next: u64) -> result: Result<Option<SimpleStep>, SelectorError> pure {
  doc "The step past next with is_pseudo_element true; no instruction is pushed since such a complex selector never matches.";
  let flag = True();
  let step = SimpleStep(pos: next, is_pseudo_element: flag);
  let some_step = Some<SimpleStep>(value: step);
  return Ok<Option<SimpleStep>, SelectorError>(value: some_step);
}

fn dispatch_pseudo_ident(instrs: &Box<Slots<Instr>>, values: &ComponentList, is_double: Bool, name: Span, next: u64) -> result: Result<Option<SimpleStep>, SelectorError> reads(values), writes(instrs) {
  doc "Dispatches a Colon or Colon-Colon followed by a plain Ident: a pseudo-element name in the double-colon form, and either a known pseudo-class or (single-colon only) a legacy pseudo-element name otherwise.";
  if is_double {
    let element = is_pseudo_element_name(values: values, span: name);
    if element {
      let result = pseudo_element_step(next: next);
      return result;
    }
    let refusal = SelectorError::Invalid();
    let none_step = None<SimpleStep>();
    return Err<Option<SimpleStep>, SelectorError>(error: refusal);
  }
  match simple_pseudo_class_instr(values: values, span: name) {
    Some(value: made) => {
      let result = pseudo_class_step(instrs: instrs, made: made, next: next);
      return result;
    }
    None() => {
      let element = is_pseudo_element_name(values: values, span: name);
      if element {
        let result = pseudo_element_step(next: next);
        return result;
      }
      let refusal = SelectorError::Invalid();
      return Err<Option<SimpleStep>, SelectorError>(error: refusal);
    }
  }
}

fn verify_full_consumption(values: &ComponentList, pos: u64, limit: u64) -> result: Bool reads(values) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "True when only whitespace remains from pos to limit.";
  let after = skip_ws(values: values, at: pos, limit: limit);
  let done = after == limit;
  return done;
}

fn dispatch_nested_list(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, compounds: &Box<Slots<Compound>>, alts: &Box<Slots<AltEntry>>, start: u64, content_end: u64, depth: u64) -> result: Result<AltRangeResult, SelectorError> reads(values), writes(atoms), writes(instrs), writes(compounds), writes(alts) contract {
  requires start <= content_end;
  requires content_end <= values^.components.inner.len;
} {
  doc "Parses a nested <complex-selector-list> filling exactly [start, content_end) but trailing whitespace, one level deeper than depth.";
  let next_depth = depth +wrap 1_u64;
  match parse_complex_selector_list(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, pos: start, limit: content_end, depth: next_depth) {
    Ok(value: result) => {
      let pos_ok = result.pos <= content_end;
      if pos_ok {
      } else {
        let refusal0 = SelectorError::Invalid();
        return Err<AltRangeResult, SelectorError>(error: refusal0);
      }
      let complete = verify_full_consumption(values: values, pos: result.pos, limit: content_end);
      if complete {
        return Ok<AltRangeResult, SelectorError>(value: result);
      }
      let refusal = SelectorError::Invalid();
      return Err<AltRangeResult, SelectorError>(error: refusal);
    }
    Err(error: refusal) => {
      return Err<AltRangeResult, SelectorError>(error: refusal);
    }
  }
}

fn dispatch_logical_function(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, compounds: &Box<Slots<Compound>>, alts: &Box<Slots<AltEntry>>, kind: u8, content_start: u64, content_end: u64, fn_end: u64, depth: u64) -> result: Result<Option<SimpleStep>, SelectorError> reads(values), writes(atoms), writes(instrs), writes(compounds), writes(alts) contract {
  requires content_start <= content_end;
  requires content_end <= values^.components.inner.len;
} {
  doc "Parses :not()/:is()/:where()'s <complex-selector-list> argument and pushes the matching Instr; kind is 0 for not, 1 for is, 2 for where.";
  match dispatch_nested_list(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, start: content_start, content_end: content_end, depth: depth) {
    Ok(value: result) => {
      let made = if kind == 0_u8 {
        let it = Instr::Not(alt_start: result.alt_start, alt_end: result.alt_end);
        give it;
      } else if kind == 1_u8 {
        let it = Instr::Is(alt_start: result.alt_start, alt_end: result.alt_end);
        give it;
      } else {
        let it = Instr::Where(alt_start: result.alt_start, alt_end: result.alt_end);
        give it;
      }
      let step_result = pseudo_class_step(instrs: instrs, made: made, next: fn_end);
      return step_result;
    }
    Err(error: refusal) => {
      return Err<Option<SimpleStep>, SelectorError>(error: refusal);
    }
  }
}

fn dispatch_lang(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, content_start: u64, content_end: u64, fn_end: u64) -> result: Result<Option<SimpleStep>, SelectorError> reads(values), writes(atoms), writes(instrs) contract {
  requires content_start <= content_end;
  requires content_end <= values^.components.inner.len;
} {
  doc "Parses :lang()'s single ident-or-string argument and pushes Instr::Lang holding its lowercased atom.";
  let arg_pos = skip_ws(values: values, at: content_start, limit: content_end);
  let has_arg = arg_pos < content_end;
  if has_arg {
  } else {
    let refusal = SelectorError::Invalid();
    return Err<Option<SimpleStep>, SelectorError>(error: refusal);
  }
  let c = values^.components.inner[arg_pos];
  match attr_value_span(c: c) {
    Some(value: arg_span) => {
      let after_arg = arg_pos +wrap 1_u64;
      let complete = verify_full_consumption(values: values, pos: after_arg, limit: content_end);
      if complete {
      } else {
        let refusal = SelectorError::Invalid();
        return Err<Option<SimpleStep>, SelectorError>(error: refusal);
      }
      let start64 = cvt::<u32, u64>(arg_span.start);
      let end64 = cvt::<u32, u64>(arg_span.end);
      let ordered = start64 <= end64;
      if ordered {
      } else {
        let refusal = SelectorError::Invalid();
        return Err<Option<SimpleStep>, SelectorError>(error: refusal);
      }
      let within = end64 <= values^.text.inner.len;
      if within {
      } else {
        let refusal = SelectorError::Invalid();
        return Err<Option<SimpleStep>, SelectorError>(error: refusal);
      }
      match intern_lowered(atoms: atoms, values: values, start: start64, end: end64) {
        Ok(value: arg_atom) => {
          let made = Instr::Lang(arg: arg_atom);
          let result = pseudo_class_step(instrs: instrs, made: made, next: fn_end);
          return result;
        }
        Err(error: refusal) => {
          return Err<Option<SimpleStep>, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let refusal = SelectorError::Invalid();
      return Err<Option<SimpleStep>, SelectorError>(error: refusal);
    }
  }
}

fn dispatch_nth(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, compounds: &Box<Slots<Compound>>, alts: &Box<Slots<AltEntry>>, kind: u8, content_start: u64, content_end: u64, fn_end: u64, depth: u64) -> result: Result<Option<SimpleStep>, SelectorError> reads(values), writes(atoms), writes(instrs), writes(compounds), writes(alts) contract {
  requires content_start <= content_end;
  requires content_end <= values^.components.inner.len;
} {
  doc "Parses an <an+b> argument, with the of S form when allow_of is set (nth-child and nth-last-child only); kind selects the pushed Instr: 0 nth-child, 1 nth-last-child, 2 nth-of-type, 3 nth-last-of-type.";
  match consume_an_plus_b(values: values, start: content_start, limit: content_end) {
    Some(value: found) => {
      let is_child_kind = kind == 0_u8;
      let is_last_child_kind = kind == 1_u8;
      let allow_of = bor(is_child_kind, is_last_child_kind);
      let at_end = found.pos == content_end;
      if at_end {
        let made = nth_instr_no_of(kind: kind, anb: found.value);
        let result = pseudo_class_step(instrs: instrs, made: made, next: fn_end);
        return result;
      }
      if allow_of {
      } else {
        let refusal = SelectorError::Invalid();
        return Err<Option<SimpleStep>, SelectorError>(error: refusal);
      }
      let of_pos = found.pos;
      let has_of_kw = of_pos < content_end;
      if has_of_kw {
      } else {
        let refusal = SelectorError::Invalid();
        return Err<Option<SimpleStep>, SelectorError>(error: refusal);
      }
      let c = values^.components.inner[of_pos];
      match as_ident(c: c) {
        Some(value: kw_span) => {
          let is_of = span_ci_equals(values: values, span: kw_span, literal: &kw_of[0_u64..kw_of.len]);
          if is_of {
          } else {
            let refusal = SelectorError::Invalid();
            return Err<Option<SimpleStep>, SelectorError>(error: refusal);
          }
          let after_of = of_pos +wrap 1_u64;
          let list_start = skip_ws(values: values, at: after_of, limit: content_end);
          match dispatch_nested_list(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, start: list_start, content_end: content_end, depth: depth) {
            Ok(value: result) => {
              let made = nth_instr_with_of(kind: kind, anb: found.value, of_start: result.alt_start, of_end: result.alt_end);
              let step_result = pseudo_class_step(instrs: instrs, made: made, next: fn_end);
              return step_result;
            }
            Err(error: refusal) => {
              return Err<Option<SimpleStep>, SelectorError>(error: refusal);
            }
          }
        }
        None() => {
          let refusal = SelectorError::Invalid();
          return Err<Option<SimpleStep>, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let refusal = SelectorError::Invalid();
      return Err<Option<SimpleStep>, SelectorError>(error: refusal);
    }
  }
}

fn nth_instr_no_of(kind: u8, anb: AnPlusB) -> result: Instr pure {
  doc "Builds the nth Instr for kind with no of-clause.";
  if kind == 0_u8 {
    let made = Instr::NthChild(a: anb.a, b: anb.b, of_start: no_of_clause, of_end: no_of_clause);
    return made;
  }
  if kind == 1_u8 {
    let made = Instr::NthLastChild(a: anb.a, b: anb.b, of_start: no_of_clause, of_end: no_of_clause);
    return made;
  }
  if kind == 2_u8 {
    let made = Instr::NthOfType(a: anb.a, b: anb.b);
    return made;
  }
  let made = Instr::NthLastOfType(a: anb.a, b: anb.b);
  return made;
}

fn nth_instr_with_of(kind: u8, anb: AnPlusB, of_start: u32, of_end: u32) -> result: Instr pure {
  doc "Builds the nth-child or nth-last-child Instr for kind with an of-clause.";
  if kind == 0_u8 {
    let made = Instr::NthChild(a: anb.a, b: anb.b, of_start: of_start, of_end: of_end);
    return made;
  }
  let made = Instr::NthLastChild(a: anb.a, b: anb.b, of_start: of_start, of_end: of_end);
  return made;
}

fn dispatch_pseudo_function(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, compounds: &Box<Slots<Compound>>, alts: &Box<Slots<AltEntry>>, is_double: Bool, name: Span, content_start: u64, fn_end: u64, depth: u64) -> result: Result<Option<SimpleStep>, SelectorError> reads(values), writes(atoms), writes(instrs), writes(compounds), writes(alts) contract {
  requires content_start <= fn_end;
  requires fn_end <= values^.components.inner.len;
} {
  doc "Dispatches a Colon or Colon-Colon followed by a Function component: the pseudo-class functions in the single-colon form, and ::slotted() only in the double-colon form.";
  if is_double {
    let slotted = span_ci_equals(values: values, span: name, literal: &fn_slotted[0_u64..fn_slotted.len]);
    if slotted {
      let result = pseudo_element_step(next: fn_end);
      return result;
    }
    let refusal = SelectorError::Invalid();
    return Err<Option<SimpleStep>, SelectorError>(error: refusal);
  }
  let is_not = span_ci_equals(values: values, span: name, literal: &fn_not[0_u64..fn_not.len]);
  if is_not {
    let result = dispatch_logical_function(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 0_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let is_is = span_ci_equals(values: values, span: name, literal: &fn_is[0_u64..fn_is.len]);
  if is_is {
    let result = dispatch_logical_function(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 1_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let is_where = span_ci_equals(values: values, span: name, literal: &fn_where[0_u64..fn_where.len]);
  if is_where {
    let result = dispatch_logical_function(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 2_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let is_lang = span_ci_equals(values: values, span: name, literal: &fn_lang[0_u64..fn_lang.len]);
  if is_lang {
    let result = dispatch_lang(atoms: atoms, values: values, instrs: instrs, content_start: content_start, content_end: fn_end, fn_end: fn_end);
    return result;
  }
  let is_nth_child = span_ci_equals(values: values, span: name, literal: &fn_nth_child[0_u64..fn_nth_child.len]);
  if is_nth_child {
    let result = dispatch_nth(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 0_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let is_nth_last_child = span_ci_equals(values: values, span: name, literal: &fn_nth_last_child[0_u64..fn_nth_last_child.len]);
  if is_nth_last_child {
    let result = dispatch_nth(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 1_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let is_nth_of_type = span_ci_equals(values: values, span: name, literal: &fn_nth_of_type[0_u64..fn_nth_of_type.len]);
  if is_nth_of_type {
    let result = dispatch_nth(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 2_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let is_nth_last_of_type = span_ci_equals(values: values, span: name, literal: &fn_nth_last_of_type[0_u64..fn_nth_last_of_type.len]);
  if is_nth_last_of_type {
    let result = dispatch_nth(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, kind: 3_u8, content_start: content_start, content_end: fn_end, fn_end: fn_end, depth: depth);
    return result;
  }
  let refusal = SelectorError::Invalid();
  return Err<Option<SimpleStep>, SelectorError>(error: refusal);
}

fn try_pseudo(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, compounds: &Box<Slots<Compound>>, alts: &Box<Slots<AltEntry>>, pos: u64, limit: u64, depth: u64) -> result: Result<Option<SimpleStep>, SelectorError> reads(values), writes(atoms), writes(instrs), writes(compounds), writes(alts) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes a pseudo-class or pseudo-element at pos, a Colon component; None when pos does not begin one.";
  let has = pos < limit;
  if has {
  } else {
    let none_step = None<SimpleStep>();
    return Ok<Option<SimpleStep>, SelectorError>(value: none_step);
  }
  let c = values^.components.inner[pos];
  let colon1 = is_colon(c: c);
  if colon1 {
  } else {
    let none_step = None<SimpleStep>();
    return Ok<Option<SimpleStep>, SelectorError>(value: none_step);
  }
  let after_colon1 = pos +wrap 1_u64;
  let has_second = after_colon1 < limit;
  let is_double = if has_second {
    let c2 = values^.components.inner[after_colon1];
    let colon2 = is_colon(c: c2);
    give colon2;
  } else {
    give False();
  }
  let name_pos = if is_double {
    let n = after_colon1 +wrap 1_u64;
    give n;
  } else {
    give after_colon1;
  }
  let has_name = name_pos < limit;
  if has_name {
  } else {
    let refusal = SelectorError::Invalid();
    return Err<Option<SimpleStep>, SelectorError>(error: refusal);
  }
  let nc = values^.components.inner[name_pos];
  match as_function(c: nc) {
    Some(value: finfo) => {
      let content_start = name_pos +wrap 1_u64;
      let fn_end = clamp_between(x: finfo.end, lo: content_start, hi: limit);
      let result = dispatch_pseudo_function(atoms: atoms, values: values, instrs: instrs, compounds: compounds, alts: alts, is_double: is_double, name: finfo.name, content_start: content_start, fn_end: fn_end, depth: depth);
      return result;
    }
    None() => {
    }
  }
  match as_ident(c: nc) {
    Some(value: name_span) => {
      let next = name_pos +wrap 1_u64;
      let result = dispatch_pseudo_ident(instrs: instrs, values: values, is_double: is_double, name: name_span, next: next);
      return result;
    }
    None() => {
      let refusal = SelectorError::Invalid();
      return Err<Option<SimpleStep>, SelectorError>(error: refusal);
    }
  }
}
