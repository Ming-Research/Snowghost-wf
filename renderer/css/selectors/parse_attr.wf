alias AtomTable = pkg::base::atom::AtomTable;
alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

struct QName {
  ns: NsConstraint;
  name: Span;
  pos: u64;
}

fn try_attr_name(values: &ComponentList, pos: u64, limit: u64) -> result: Result<Option<QName>, SelectorError> reads(values) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes an attribute selector's qualified name at pos: an optional *| or | namespace prefix (never another prefix) followed by an Ident; None when pos does not begin one.";
  let has = pos < limit;
  if has {
  } else {
    let none_qn = None<QName>();
    return Ok<Option<QName>, SelectorError>(value: none_qn);
  }
  let c = values^.components.inner[pos];
  let star = delim_is(c: c, wanted: 42_u32);
  if star {
    let after_star = pos +wrap 1_u64;
    let has_bar = after_star < limit;
    let bar_here = if has_bar {
      let c2 = values^.components.inner[after_star];
      give delim_is(c: c2, wanted: 124_u32);
    } else {
      give False();
    }
    if bar_here {
    } else {
      let refusal = SelectorError::Invalid();
      return Err<Option<QName>, SelectorError>(error: refusal);
    }
    let after_bar = after_star +wrap 1_u64;
    let has_name = after_bar < limit;
    if has_name {
    } else {
      let refusal = SelectorError::Invalid();
      return Err<Option<QName>, SelectorError>(error: refusal);
    }
    let c3 = values^.components.inner[after_bar];
    match as_ident(c: c3) {
      Some(value: name_span) => {
        let next = after_bar +wrap 1_u64;
        let ns = NsConstraint::AnyNs();
        let made = QName(ns: ns, name: name_span, pos: next);
        let some_qn = Some<QName>(value: made);
        return Ok<Option<QName>, SelectorError>(value: some_qn);
      }
      None() => {
        let refusal = SelectorError::Invalid();
        return Err<Option<QName>, SelectorError>(error: refusal);
      }
    }
  }
  let bar = delim_is(c: c, wanted: 124_u32);
  if bar {
    let after_bar = pos +wrap 1_u64;
    let has_name = after_bar < limit;
    if has_name {
    } else {
      let refusal = SelectorError::Invalid();
      return Err<Option<QName>, SelectorError>(error: refusal);
    }
    let c2 = values^.components.inner[after_bar];
    match as_ident(c: c2) {
      Some(value: name_span) => {
        let next = after_bar +wrap 1_u64;
        let ns = NsConstraint::NoNs();
        let made = QName(ns: ns, name: name_span, pos: next);
        let some_qn = Some<QName>(value: made);
        return Ok<Option<QName>, SelectorError>(value: some_qn);
      }
      None() => {
        let refusal = SelectorError::Invalid();
        return Err<Option<QName>, SelectorError>(error: refusal);
      }
    }
  }
  match as_ident(c: c) {
    Some(value: name_span) => {
      let after_name = pos +wrap 1_u64;
      let has_bar2 = after_name < limit;
      let followed_by_bar = if has_bar2 {
        let c2 = values^.components.inner[after_name];
        give delim_is(c: c2, wanted: 124_u32);
      } else {
        give False();
      }
      if followed_by_bar {
        let refusal = SelectorError::Invalid();
        return Err<Option<QName>, SelectorError>(error: refusal);
      }
      let ns = NsConstraint::NoNs();
      let made = QName(ns: ns, name: name_span, pos: after_name);
      let some_qn = Some<QName>(value: made);
      return Ok<Option<QName>, SelectorError>(value: some_qn);
    }
    None() => {
      let none_qn = None<QName>();
      return Ok<Option<QName>, SelectorError>(value: none_qn);
    }
  }
}

fn attr_op_of(c: Component) -> result: Option<AttrOp> pure {
  doc "The attribute matcher an operator component spells, or None when c is not one.";
  match c {
    IncludeMatch() => {
      let op = AttrOp::Includes();
      return Some<AttrOp>(value: op);
    }
    DashMatch() => {
      let op = AttrOp::DashMatch();
      return Some<AttrOp>(value: op);
    }
    PrefixMatch() => {
      let op = AttrOp::Prefix();
      return Some<AttrOp>(value: op);
    }
    SuffixMatch() => {
      let op = AttrOp::Suffix();
      return Some<AttrOp>(value: op);
    }
    SubstringMatch() => {
      let op = AttrOp::Substring();
      return Some<AttrOp>(value: op);
    }
    Delim(code_point: cp) => {
      let is_eq = cp == 61_u32;
      if is_eq {
        let op = AttrOp::Equals();
        return Some<AttrOp>(value: op);
      }
      return None<AttrOp>();
    }
    Ident(name: n) => {
      return None<AttrOp>();
    }
    Function(name: n, end: e) => {
      return None<AttrOp>();
    }
    AtKeyword(name: n) => {
      return None<AttrOp>();
    }
    Hash(name: n, kind: k) => {
      return None<AttrOp>();
    }
    QuotedString(value: v) => {
      return None<AttrOp>();
    }
    Url(value: v) => {
      return None<AttrOp>();
    }
    Number(number: n) => {
      return None<AttrOp>();
    }
    Percentage(number: n) => {
      return None<AttrOp>();
    }
    Dimension(number: n, unit_name: u) => {
      return None<AttrOp>();
    }
    UnicodeRange(start: s, end: e) => {
      return None<AttrOp>();
    }
    Column() => {
      return None<AttrOp>();
    }
    Whitespace() => {
      return None<AttrOp>();
    }
    Cdo() => {
      return None<AttrOp>();
    }
    Cdc() => {
      return None<AttrOp>();
    }
    Colon() => {
      return None<AttrOp>();
    }
    Semicolon() => {
      return None<AttrOp>();
    }
    Comma() => {
      return None<AttrOp>();
    }
    ParenthesisBlock(end: e) => {
      return None<AttrOp>();
    }
    BracketBlock(end: e) => {
      return None<AttrOp>();
    }
    BraceBlock(end: e) => {
      return None<AttrOp>();
    }
    Error(error: er) => {
      return None<AttrOp>();
    }
  }
}

fn attr_value_span(c: Component) -> result: Option<Span> pure {
  doc "The value text span when c is a QuotedString or Ident component, and None otherwise.";
  match c {
    QuotedString(value: v) => {
      return Some<Span>(value: v);
    }
    Ident(name: n) => {
      return Some<Span>(value: n);
    }
    Function(name: n, end: e) => {
      return None<Span>();
    }
    AtKeyword(name: n) => {
      return None<Span>();
    }
    Hash(name: n, kind: k) => {
      return None<Span>();
    }
    Url(value: v) => {
      return None<Span>();
    }
    Delim(code_point: cp) => {
      return None<Span>();
    }
    Number(number: n) => {
      return None<Span>();
    }
    Percentage(number: n) => {
      return None<Span>();
    }
    Dimension(number: n, unit_name: u) => {
      return None<Span>();
    }
    UnicodeRange(start: s, end: e) => {
      return None<Span>();
    }
    IncludeMatch() => {
      return None<Span>();
    }
    DashMatch() => {
      return None<Span>();
    }
    PrefixMatch() => {
      return None<Span>();
    }
    SuffixMatch() => {
      return None<Span>();
    }
    SubstringMatch() => {
      return None<Span>();
    }
    Column() => {
      return None<Span>();
    }
    Whitespace() => {
      return None<Span>();
    }
    Cdo() => {
      return None<Span>();
    }
    Cdc() => {
      return None<Span>();
    }
    Colon() => {
      return None<Span>();
    }
    Semicolon() => {
      return None<Span>();
    }
    Comma() => {
      return None<Span>();
    }
    ParenthesisBlock(end: e) => {
      return None<Span>();
    }
    BracketBlock(end: e) => {
      return None<Span>();
    }
    BraceBlock(end: e) => {
      return None<Span>();
    }
    Error(error: er) => {
      return None<Span>();
    }
  }
}

fn modifier_flag(values: &ComponentList, span: Span) -> result: Option<Bool> reads(values) {
  doc "When span is exactly one ASCII byte 'i', 'I', 's' or 'S' in values.text, returns True for the i/I insensitivity flag and False for s/S; None otherwise.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let ordered = start <= end;
  if ordered {
  } else {
    return None<Bool>();
  }
  let within = end <= values^.text.inner.len;
  if within {
  } else {
    return None<Bool>();
  }
  let one = end -wrap start;
  let single = one == 1_u64;
  if single {
  } else {
    return None<Bool>();
  }
  let in_bounds = start < values^.text.inner.len;
  if in_bounds {
  } else {
    return None<Bool>();
  }
  let byte = values^.text.inner[start];
  let lowered = ascii_lower_byte(byte: byte);
  let is_i = lowered == 105_u8;
  if is_i {
    let flag = True();
    return Some<Bool>(value: flag);
  }
  let is_s = lowered == 115_u8;
  if is_s {
    let flag = False();
    return Some<Bool>(value: flag);
  }
  return None<Bool>();
}

fn try_attribute(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, pos: u64, limit: u64) -> result: Result<Option<u64>, SelectorError> reads(values), writes(atoms), writes(instrs) contract {
  requires pos <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Consumes an attribute selector, a BracketBlock component, at pos; None when pos does not begin one.";
  let has = pos < limit;
  if has {
  } else {
    let none_step = None<u64>();
    return Ok<Option<u64>, SelectorError>(value: none_step);
  }
  let c = values^.components.inner[pos];
  match as_bracket(c: c) {
    Some(value: end32) => {
      let end_wide = cvt::<u32, u64>(end32);
      let after = pos +wrap 1_u64;
      let content_end = clamp_between(x: end_wide, lo: after, hi: limit);
      let outcome = parse_attribute_contents(atoms: atoms, values: values, instrs: instrs, start: after, content_end: content_end);
      match outcome {
        Ok(value: done) => {
          let some_step = Some<u64>(value: content_end);
          return Ok<Option<u64>, SelectorError>(value: some_step);
        }
        Err(error: refusal) => {
          return Err<Option<u64>, SelectorError>(error: refusal);
        }
      }
    }
    None() => {
      let none_step = None<u64>();
      return Ok<Option<u64>, SelectorError>(value: none_step);
    }
  }
}

fn parse_attribute_contents(atoms: &AtomTable, values: &ComponentList, instrs: &Box<Slots<Instr>>, start: u64, content_end: u64) -> result: Result<unit, SelectorError> reads(values), writes(atoms), writes(instrs) contract {
  requires start <= content_end;
  requires content_end <= values^.components.inner.len;
} {
  doc "Parses one attribute selector's bracket contents (already excluding the brackets), pushing AttrPresence or AttrMatch.";
  let pos0 = skip_ws(values: values, at: start, limit: content_end);
  match try_attr_name(values: values, pos: pos0, limit: content_end) {
    Ok(value: found) => {
      match found {
        Some(value: qn) => {
          let qn_pos_ok = qn.pos <= content_end;
          if qn_pos_ok {
          } else {
            let refusal = SelectorError::Invalid();
            return Err<unit, SelectorError>(error: refusal);
          }
          match intern_pair_span(atoms: atoms, values: values, span: qn.name) {
            Ok(value: name_pair) => {
              let after_name = skip_ws(values: values, at: qn.pos, limit: content_end);
              let at_end = after_name >= content_end;
              if at_end {
                let made = Instr::AttrPresence(ns: qn.ns, exact: name_pair.exact, lower: name_pair.lower);
                match push_instr(instrs: instrs, value: made) {
                  Ok(value: idx) => {
                    return Ok<unit, SelectorError>(value: unit);
                  }
                  Err(error: refusal) => {
                    return Err<unit, SelectorError>(error: refusal);
                  }
                }
              }
              let op_c = values^.components.inner[after_name];
              match attr_op_of(c: op_c) {
                Some(value: op) => {
                  let name_start = cvt::<u32, u64>(qn.name.start);
                  let name_end = cvt::<u32, u64>(qn.name.end);
                  let name_span_ok1 = name_start <= name_end;
                  if name_span_ok1 {
                  } else {
                    let refusal = SelectorError::Invalid();
                    return Err<unit, SelectorError>(error: refusal);
                  }
                  let name_span_ok2 = name_end <= values^.text.inner.len;
                  if name_span_ok2 {
                  } else {
                    let refusal = SelectorError::Invalid();
                    return Err<unit, SelectorError>(error: refusal);
                  }
                  let default_ci = is_default_ci_attribute(values: values, start: name_start, end: name_end);
                  let after_op = after_name +wrap 1_u64;
                  let before_value = skip_ws(values: values, at: after_op, limit: content_end);
                  let has_value = before_value < content_end;
                  if has_value {
                  } else {
                    let refusal = SelectorError::Invalid();
                    return Err<unit, SelectorError>(error: refusal);
                  }
                  let value_c = values^.components.inner[before_value];
                  match attr_value_span(c: value_c) {
                    Some(value: value_span) => {
                      match intern_pair_span(atoms: atoms, values: values, span: value_span) {
                        Ok(value: value_pair) => {
                          let after_value = before_value +wrap 1_u64;
                          let before_flag = skip_ws(values: values, at: after_value, limit: content_end);
                          let flag_done = before_flag >= content_end;
                          if flag_done {
                            let case_kind = ValueCase::CaseDefault();
                            let made = Instr::AttrMatch(ns: qn.ns, exact: name_pair.exact, lower: name_pair.lower, op: op, value_exact: value_pair.exact, value_lower: value_pair.lower, case: case_kind, default_ci: default_ci);
                            match push_instr(instrs: instrs, value: made) {
                              Ok(value: idx) => {
                                return Ok<unit, SelectorError>(value: unit);
                              }
                              Err(error: refusal) => {
                                return Err<unit, SelectorError>(error: refusal);
                              }
                            }
                          }
                          let flag_c = values^.components.inner[before_flag];
                          match as_ident(c: flag_c) {
                            Some(value: flag_span) => {
                              match modifier_flag(values: values, span: flag_span) {
                                Some(value: is_i) => {
                                  let after_flag = before_flag +wrap 1_u64;
                                  let trailing = skip_ws(values: values, at: after_flag, limit: content_end);
                                  let trailing_done = trailing >= content_end;
                                  if trailing_done {
                                  } else {
                                    let refusal = SelectorError::Invalid();
                                    return Err<unit, SelectorError>(error: refusal);
                                  }
                                  let case_kind = if is_i {
                                    let ci = ValueCase::CaseInsensitive();
                                    give ci;
                                  } else {
                                    let cs = ValueCase::CaseSensitive();
                                    give cs;
                                  }
                                  let made = Instr::AttrMatch(ns: qn.ns, exact: name_pair.exact, lower: name_pair.lower, op: op, value_exact: value_pair.exact, value_lower: value_pair.lower, case: case_kind, default_ci: default_ci);
                                  match push_instr(instrs: instrs, value: made) {
                                    Ok(value: idx) => {
                                      return Ok<unit, SelectorError>(value: unit);
                                    }
                                    Err(error: refusal) => {
                                      return Err<unit, SelectorError>(error: refusal);
                                    }
                                  }
                                }
                                None() => {
                                  let refusal = SelectorError::Invalid();
                                  return Err<unit, SelectorError>(error: refusal);
                                }
                              }
                            }
                            None() => {
                              let refusal = SelectorError::Invalid();
                              return Err<unit, SelectorError>(error: refusal);
                            }
                          }
                        }
                        Err(error: refusal) => {
                          return Err<unit, SelectorError>(error: refusal);
                        }
                      }
                    }
                    None() => {
                      let refusal = SelectorError::Invalid();
                      return Err<unit, SelectorError>(error: refusal);
                    }
                  }
                }
                None() => {
                  let refusal = SelectorError::Invalid();
                  return Err<unit, SelectorError>(error: refusal);
                }
              }
            }
            Err(error: refusal) => {
              return Err<unit, SelectorError>(error: refusal);
            }
          }
        }
        None() => {
          let refusal = SelectorError::Invalid();
          return Err<unit, SelectorError>(error: refusal);
        }
      }
    }
    Err(error: refusal) => {
      return Err<unit, SelectorError>(error: refusal);
    }
  }
}
