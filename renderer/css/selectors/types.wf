struct FlushRange {
  start: u32;
  end: u32;
}

fn flush_order(order: &Box<Slots<u32>>, collected: &Box<Slots<u32>>) -> result: Result<FlushRange, SelectorError> reads(collected), writes(order) {
  doc "Appends every index in collected to order contiguously (immune to any interleaving nested parses caused in order while collected was being built), and returns the range collected now occupies in order.";
  let start_wide = order^.inner.len;
  let start = cvt.wrap::<u64, u32>(start_wide);
  let count = collected^.inner.len;
  for (k in 0_u64..count) {
    let in_bounds = k < collected^.inner.len;
    if in_bounds {
    } else {
      let refusal = SelectorError::Invalid();
      return Err<FlushRange, SelectorError>(error: refusal);
    }
    let idx = collected^.inner[k];
    match push_order(order: order, value: idx) {
      Ok(value: oidx) => {
      }
      Err(error: refusal) => {
        return Err<FlushRange, SelectorError>(error: refusal);
      }
    }
  }
  let end_wide = order^.inner.len;
  let end = cvt.wrap::<u64, u32>(end_wide);
  let result = FlushRange(start: start, end: end);
  return Ok<FlushRange, SelectorError>(value: result);
}

fn push_order(order: &Box<Slots<u32>>, value: u32) -> result: Result<u32, SelectorError> writes(order) {
  doc "Appends value (an index into compounds, alts, or instrs) to order, the same growth and ceiling as push_instr, and returns the index it was placed at.";
  let length = order^.inner.len;
  let capacity = order^.inner.cap;
  let full = length >= capacity;
  if full {
    let small = capacity < array_capacity_seed;
    if small {
      grow(cell: order, capacity: array_capacity_seed);
    } else {
      let within = capacity <= array_growth_limit;
      if within {
      } else {
        let refusal = SelectorError::TooLarge();
        return Err<u32, SelectorError>(error: refusal);
      }
      let doubled = capacity + capacity;
      grow(cell: order, capacity: doubled);
    }
  }
  let fits = length <= 4294967295_u64;
  if fits {
  } else {
    let refusal = SelectorError::TooLarge();
    return Err<u32, SelectorError>(error: refusal);
  }
  place_back(window: &order^.inner, value: value);
  let index = cvt.wrap::<u64, u32>(length);
  return Ok<u32, SelectorError>(value: index);
}
