const max_nesting_depth: u64 = 32_u64;

const max_compounds_per_selector: u64 = 64_u64;

const array_capacity_seed: u64 = 64_u64;

const array_growth_limit: u64 = 16777216_u64;

const no_of_clause: u32 = 4294967295_u32;

fn push_instr(instrs: &Box<Slots<Instr>>, value: Instr) -> result: Result<u32, SelectorError> writes(instrs) {
  doc "Appends value to instrs, growing its capacity by doubling (seeded at array_capacity_seed) while at most array_growth_limit, and returns the index it was placed at; TooLarge past that ceiling or past u32's range.";
  let length = instrs^.inner.len;
  let capacity = instrs^.inner.cap;
  let full = length >= capacity;
  if full {
    let small = capacity < array_capacity_seed;
    if small {
      grow(cell: instrs, capacity: array_capacity_seed);
    } else {
      let within = capacity <= array_growth_limit;
      if within {
      } else {
        let refusal = SelectorError::TooLarge();
        return Err<u32, SelectorError>(error: refusal);
      }
      let doubled = capacity + capacity;
      grow(cell: instrs, capacity: doubled);
    }
  }
  let fits = length <= 4294967295_u64;
  if fits {
  } else {
    let refusal = SelectorError::TooLarge();
    return Err<u32, SelectorError>(error: refusal);
  }
  place_back(window: &instrs^.inner, value: value);
  let index = cvt.wrap::<u64, u32>(length);
  return Ok<u32, SelectorError>(value: index);
}

fn push_compound(compounds: &Box<Slots<Compound>>, value: Compound) -> result: Result<u32, SelectorError> writes(compounds) {
  doc "Appends value to compounds, the same growth and ceiling as push_instr, and returns the index it was placed at.";
  let length = compounds^.inner.len;
  let capacity = compounds^.inner.cap;
  let full = length >= capacity;
  if full {
    let small = capacity < array_capacity_seed;
    if small {
      grow(cell: compounds, capacity: array_capacity_seed);
    } else {
      let within = capacity <= array_growth_limit;
