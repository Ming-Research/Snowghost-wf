alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias ComponentRange = pkg::css::rules::ComponentRange;
alias HashKind = pkg::css::syntax::HashKind;
alias Span = pkg::css::syntax::Span;

struct HashInfo {
  name: Span;
  kind: HashKind;
}

struct FnInfo {
  name: Span;
  end: u64;
}

fn clamp_selector_range(values: &ComponentList, range: ComponentRange) -> (start: u64, limit: u64) reads(values) contract {
  ensures start <= limit;
  ensures limit <= values^.components.inner.len;
} {
  doc "Widens range to u64 and clamps it to values.components' length.";
  let count = values^.components.inner.len;
  let end_wide = cvt::<u32, u64>(range.end);
  let start_wide = cvt::<u32, u64>(range.start);
  let end_ok = end_wide <= count;
  if end_ok {
    let start_ok = start_wide <= end_wide;
    if start_ok {
      return start_wide, end_wide;
    }
    return end_wide, end_wide;
  }
  let start_within = start_wide <= count;
  if start_within {
    return start_wide, count;
  }
  return count, count;
}

fn as_hash(c: Component) -> result: Option<HashInfo> pure {
  doc "The name and kind when c is a Hash component, and None otherwise.";
  match c {
    Hash(name: n, kind: k) => {
      let made = HashInfo(name: n, kind: k);
      return Some<HashInfo>(value: made);
    }
    Ident(name: n) => {
      return None<HashInfo>();
    }
    Function(name: n, end: e) => {
      return None<HashInfo>();
    }
    AtKeyword(name: n) => {
      return None<HashInfo>();
    }
    QuotedString(value: v) => {
      return None<HashInfo>();
    }
    Url(value: v) => {
      return None<HashInfo>();
    }
    Delim(code_point: cp) => {
      return None<HashInfo>();
    }
    Number(number: n) => {
      return None<HashInfo>();
    }
    Percentage(number: n) => {
      return None<HashInfo>();
    }
    Dimension(number: n, unit_name: u) => {
      return None<HashInfo>();
    }
    UnicodeRange(start: s, end: e) => {
      return None<HashInfo>();
    }
    IncludeMatch() => {
      return None<HashInfo>();
    }
    DashMatch() => {
      return None<HashInfo>();
    }
    PrefixMatch() => {
      return None<HashInfo>();
    }
    SuffixMatch() => {
      return None<HashInfo>();
    }
    SubstringMatch() => {
      return None<HashInfo>();
    }
    Column() => {
      return None<HashInfo>();
    }
    Whitespace() => {
      return None<HashInfo>();
    }
    Cdo() => {
      return None<HashInfo>();
    }
    Cdc() => {
      return None<HashInfo>();
    }
    Colon() => {
      return None<HashInfo>();
    }
    Semicolon() => {
      return None<HashInfo>();
    }
    Comma() => {
      return None<HashInfo>();
    }
    ParenthesisBlock(end: e) => {
      return None<HashInfo>();
    }
    BracketBlock(end: e) => {
      return None<HashInfo>();
    }
    BraceBlock(end: e) => {
      return None<HashInfo>();
    }
    Error(error: er) => {
      return None<HashInfo>();
    }
  }
}

