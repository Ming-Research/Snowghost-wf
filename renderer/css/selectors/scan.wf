fn as_function(c: Component) -> result: Option<FnInfo> pure {
  doc "The name and declared end when c is a Function component, and None otherwise.";
  match c {
    Function(name: n, end: e) => {
      let wide = cvt::<u32, u64>(e);
      let made = FnInfo(name: n, end: wide);
      return Some<FnInfo>(value: made);
