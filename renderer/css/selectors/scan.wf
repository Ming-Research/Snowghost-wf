fn component_end(values: &ComponentList, at: u64, limit: u64) -> result: u64 reads(values) contract {
  requires at < limit;
  requires limit <= values^.components.inner.len;
  ensures result > at;
  ensures result <= limit;
} {
  doc "The sibling index following the component at at: a Function, ParenthesisBlock, BracketBlock or BraceBlock's own declared end (clamped into (at, limit]), and at + 1 for every leaf.";
  let c = values^.components.inner[at];
  let candidate = component_own_end(c: c);
  match candidate {
    Some(value: e) => {
      let wide = cvt::<u32, u64>(e);
      let above = wide > at;
      if above {
        let within = wide <= limit;
        if within {
          return wide;
        }
        return limit;
      }
      let fallback = at +wrap 1_u64;
      if fallback <= limit {
        return fallback;
      }
      return limit;
    }
    None() => {
      let fallback = at +wrap 1_u64;
      if fallback <= limit {
        return fallback;
      }
      return limit;
    }
  }
}

fn component_own_end(c: Component) -> result: Option<u32> pure {
  doc "The component's own declared end index (the index after its last content component), for a Function or block; None for a leaf.";
  match c {
    Function(name: n, end: e) => {
      return Some<u32>(value: e);
    }
    ParenthesisBlock(end: e) => {
      return Some<u32>(value: e);
    }
    BracketBlock(end: e) => {
      return Some<u32>(value: e);
    }
    BraceBlock(end: e) => {
      return Some<u32>(value: e);
    }
    Ident(name: n) => {
      return None<u32>();
    }
    AtKeyword(name: n) => {
      return None<u32>();
    }
    Hash(name: n, kind: k) => {
      return None<u32>();
    }
    QuotedString(value: v) => {
      return None<u32>();
    }
    Url(value: v) => {
      return None<u32>();
    }
    Delim(code_point: cp) => {
      return None<u32>();
    }
    Number(number: n) => {
      return None<u32>();
    }
    Percentage(number: n) => {
      return None<u32>();
    }
    Dimension(number: n, unit_name: u) => {
      return None<u32>();
    }
    UnicodeRange(start: s, end: e) => {
      return None<u32>();
    }
    IncludeMatch() => {
      return None<u32>();
    }
    DashMatch() => {
      return None<u32>();
    }
    PrefixMatch() => {
      return None<u32>();
    }
    SuffixMatch() => {
      return None<u32>();
    }
    SubstringMatch() => {
      return None<u32>();
    }
    Column() => {
      return None<u32>();
    }
    Whitespace() => {
      return None<u32>();
    }
    Cdo() => {
      return None<u32>();
    }
    Cdc() => {
      return None<u32>();
    }
    Colon() => {
      return None<u32>();
    }
    Semicolon() => {
      return None<u32>();
    }
    Comma() => {
      return None<u32>();
    }
    Error(error: er) => {
      return None<u32>();
    }
  }
}

fn skip_ws(values: &ComponentList, at: u64, limit: u64) -> result: u64 reads(values) contract {
  requires at <= limit;
  requires limit <= values^.components.inner.len;
  ensures result >= at;
  ensures result <= limit;
} {
  doc "Advances at past every top-level Whitespace component up to limit, skipping whole nested Function/block contents without inspecting them (none of which is itself whitespace at this level).";
  let pos = at;
  loop @ws {
    let more = pos < limit;
    if more {
    } else {
      break @ws;
    }
    let c = values^.components.inner[pos];
    let is_ws = component_is_whitespace(c: c);
    if is_ws {
      let next = component_end(values: values, at: pos, limit: limit);
      set pos = next;
    } else {
      break @ws;
    }
  }
  let safe = clamp_between(x: pos, lo: at, hi: limit);
  return safe;
}

fn clamp_between(x: u64, lo: u64, hi: u64) -> result: u64 pure contract {
  requires lo <= hi;
  ensures result >= lo;
  ensures result <= hi;
} {
  doc "Clamps x into [lo, hi].";
  if x < lo {
    return lo;
  }
  if x > hi {
    return hi;
  }
  return x;
}
