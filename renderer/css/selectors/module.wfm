alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias ComponentList = pkg::css::syntax::ComponentList;
alias ComponentRange = pkg::css::rules::ComponentRange;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;

public const pseudo_element_none: u8 = 0_u8;

public const pseudo_element_before: u8 = 1_u8;

public const pseudo_element_after: u8 = 2_u8;

public const pseudo_element_other: u8 = 3_u8;

public struct AnPlusB {
  public a: i32;
  public b: i32;
}

public enum SelectorError {
  Invalid();
  TooLarge();
}

enum NsConstraint {
  AnyNs();
  NoNs();
}

enum AttrOp {
  Equals();
  Includes();
  DashMatch();
  Prefix();
  Suffix();
  Substring();
}

enum ValueCase {
  CaseDefault();
  CaseInsensitive();
  CaseSensitive();
}

enum Combinator {
  Start();
  Descendant();
  Child();
  NextSibling();
  SubsequentSibling();
}

enum Instr {
  Universal(ns: NsConstraint);
  Type(ns: NsConstraint, exact: Atom, lower: Atom);
  Id(exact: Atom, lower: Atom);
  Class(exact: Atom, lower: Atom);
  AttrPresence(ns: NsConstraint, exact: Atom, lower: Atom);
  AttrMatch(ns: NsConstraint, exact: Atom, lower: Atom, op: AttrOp, value_exact: Atom, value_lower: Atom, case: ValueCase, default_ci: Bool);
  Root();
  Empty();
  FirstChild();
  LastChild();
  OnlyChild();
  FirstOfType();
  LastOfType();
  OnlyOfType();
  NthChild(a: i32, b: i32, of_start: u32, of_end: u32);
  NthLastChild(a: i32, b: i32, of_start: u32, of_end: u32);
  NthOfType(a: i32, b: i32);
  NthLastOfType(a: i32, b: i32);
  Not(alt_start: u32, alt_end: u32);
  Is(alt_start: u32, alt_end: u32);
  Where(alt_start: u32, alt_end: u32);
  Link();
  AnyLink();
  Visited();
  Checked();
  Enabled();
  Disabled();
  Lang(arg: Atom);
  Target();
  Scope();
  Defined();
  Hover();
  Active();
  Focus();
  FocusWithin();
  FocusVisible();
}

struct Compound {
  simple_start: u32;
  simple_end: u32;
  combinator: Combinator;
}

struct AltEntry {
  compound_start: u32;
  compound_end: u32;
  never_matches: Bool;
  pseudo: u8;
}

public struct SelectorList {
  instrs: Box<Slots<Instr>>;
  compounds: Box<Slots<Compound>>;
  alts: Box<Slots<AltEntry>>;
  compound_order: Box<Slots<u32>>;
  alt_order: Box<Slots<u32>>;
  instr_order: Box<Slots<u32>>;
  top_start: u32;
  top_end: u32;
}

public enum SubjectKey {
  Anything();
  Nothing();
  Id(public hash: u64);
  Class(public hash: u64);
  Type(public hash: u64);
}

public const reach_self: u8 = 1_u8;

public const reach_descendants: u8 = 2_u8;

public const reach_siblings: u8 = 4_u8;

public const reach_sibling_descendants: u8 = 8_u8;

public const reach_all: u8 = 16_u8;

public struct ClassReach {
  doc "Where a change of one class word on an element e can change what a selector's alternative matches: e itself (reach_self), its descendants, its later siblings, the descendants of its later siblings, or any element of the document (reach_all), as bits of reach; the elements in the first four must also carry subject. hash is the class's name_hash; every marks a reach that holds for every class word, from an attribute selector on the class attribute or an :nth-child of-clause.";
  public every: Bool;
  public hash: u64;
  public reach: u8;
  public subject: SubjectKey;
}

public struct Positions {
  table: Box<Array<u64>>;
}

public struct Specificity {
  public ids: u32;
  public classes: u32;
  public types: u32;
}

public struct MatchContext {
  public target: Option<NodeId>;
  public scope: Option<NodeId>;
}

public fn parse_an_plus_b(values: &ComponentList, range: ComponentRange) -> result: Option<AnPlusB> reads(values) doc "Parses the component values of values in range, surrounded by optional whitespace, as the <an+b> microsyntax of CSS Syntax Module Level 3 as css-parsing-tests at revision 203ce36b represents it, and returns A and B, or None when the range is not exactly one <an+b>. A range is as pkg::css::rules describes. A coefficient beyond the range of i32 is clamped to it.";

public fn parse_selector_list(values: &ComponentList, range: ComponentRange, atoms: &AtomTable) -> result: Result<SelectorList, SelectorError> reads(values), writes(atoms) doc "Parses the component values in range as a <selector-list> of Selectors Level 4, as the Selectors API parses a selector string with no namespace prefixes declared, as WPT's dom/nodes/selectors.js at revision b48a5c3f expects: type and universal selectors with the *| and | prefixes only; id, class and attribute selectors with every attribute matcher and the i and s flags; the descendant, child, next-sibling and subsequent-sibling combinators; the pseudo-classes :root, :empty, :first-child, :last-child, :only-child, :first-of-type, :last-of-type, :only-of-type, :nth-child(), :nth-last-child(), :nth-of-type(), :nth-last-of-type() (with the of S form of the child ones), :not(), :is(), :where(), :link, :any-link, :visited, :checked, :enabled, :disabled, :lang(), :target, :scope, :defined, :hover, :active, :focus, :focus-within and :focus-visible; and the pseudo-elements ::before, ::after, ::first-line and ::first-letter, also in their single-colon forms, last in a compound selector. Names and keywords match ASCII case-insensitively where the grammar does. Element and attribute names are interned in atoms. Invalid for every other input, and for a name prefix other than *| and |; TooLarge when the list would pass a storage limit. The non-public fields of SelectorList and every non-public declaration of this interface are the implementation's to choose.";

public fn selector_matches(list: &SelectorList, document: &Document, atoms: &AtomTable, element: NodeId, context: MatchContext) -> result: Bool reads(list), reads(document), reads(atoms) doc "Returns whether element, an Element node of document, matches some complex selector of list, with the meaning Selectors Level 4 and the HTML Standard give each part in an HTML document: type selectors and attribute names match an HTML element ASCII case-insensitively and other elements exactly; attribute values under the i flag, and the values of the attributes the HTML Standard lists as case-insensitive, compare ASCII case-insensitively; the id and class selectors compare case-sensitively except in a document in quirks mode, where they compare ASCII case-insensitively. :link and :any-link match an a or area element with an href attribute and :visited matches none; :checked, :enabled and :disabled follow the HTML Standard's attribute-based definitions for form controls, options and fieldsets; :lang() compares the value of the nearest lang attribute on the element or an ancestor as Selectors Level 3 defines, equal to the argument or beginning with it followed by a hyphen, ASCII case-insensitively; :target matches context.target and :scope context.scope, or the root element when it is None; :defined matches every element; :hover, :active, :focus, :focus-within and :focus-visible match none, as no user interaction exists. A complex selector ending in a pseudo-element matches no element; pseudo_matching_specificity matches the ::before and ::after ones. Template contents are not descendants of their template. A call allocates nothing and tests each compound selector of list at most once against each of element, its ancestors, and the siblings of element and of its ancestors; one test takes time proportional to the size of the compound selector, plus the number of siblings of the tested element for a structural pseudo-class, plus one call on the argument list for each element that a pseudo-class with a selector-list argument tests.";

public fn alternative_count(list: &SelectorList) -> count: u64 reads(list) doc "Returns the number of complex selectors, alternatives, at the top level of list.";

public fn subject_key(list: &SelectorList, atoms: &AtomTable, alternative: u64) -> key: SubjectKey reads(list), reads(atoms) doc "Returns a key that every element the alternative at index alternative of list matches carries: Id with the name_hash of its subject compound's id when the compound, its rightmost, has an id selector; otherwise Class with the name_hash of its first class selector; otherwise Type with the name_hash of its type selector's lowercase name; Nothing when the alternative matches no element (it ends in a pseudo-element, which pseudo_subject_key keys, or has no compound); and Anything when it has none of these or the list is malformed. An element with no id attribute value, class word or local name of that hash, compared as the matchers compare them with ASCII case folded, does not match the alternative.";

public fn class_reaches(list: &SelectorList, atoms: &AtomTable, out: &Box<Slots<ClassReach>>) -> complete: Bool reads(list), reads(atoms), writes(out) doc "Appends to out a reach for each class selector, and each attribute selector on the class attribute, of the top-level alternatives of list that style an element or its ::before or ::after, so that adding or removing a class word on an element e changes what those alternatives match only on the elements the reaches name: the rightmost compound reaches e; another compound reaches e's descendants when only descendant and child combinators follow it, its later siblings when only sibling combinators do, and both with the later siblings' descendants when both do; a class inside a selector-list argument (:not, :is, :where) reaches as its compound reaches the element the argument tests, composed with that element's reach to the subject: the same as the holding compound's when it is in the argument's rightmost compound, the argument's own when the holding compound is the subject, and e with all four otherwise; an of-clause of :nth-child or :nth-last-child reaches any element for any class. subject is the alternative's subject key (for ::before and ::after, its originating compound's), which every element it styles carries. Returns False when out passes a storage limit, and the reaches are then incomplete.";

public fn alternative_pseudo_element(list: &SelectorList, alternative: u64) -> kind: u8 reads(list) doc "Returns the pseudo-element the alternative at index alternative of list ends in: pseudo_element_before or pseudo_element_after for ::before and ::after and their single-colon forms, pseudo_element_other for ::first-line, ::first-letter and ::slotted(), and pseudo_element_none for an alternative that ends in none or a malformed list.";

public fn pseudo_subject_key(list: &SelectorList, atoms: &AtomTable, alternative: u64) -> key: SubjectKey reads(list), reads(atoms) doc "Returns, for an alternative ending in ::before or ::after, the key subject_key would give the alternative without its pseudo-element, which every element whose pseudo-element it matches carries: from the compound the pseudo-element ends, Anything when that compound has no id, class or type selector; Nothing for any other alternative, and Anything for a malformed list.";

public fn pseudo_matching_specificity(list: &SelectorList, document: &Document, atoms: &AtomTable, element: NodeId, context: MatchContext, positions: &Positions, pseudo: u8) -> result: Option<Specificity> reads(list), reads(document), reads(atoms), reads(positions) doc "Returns the greatest specificity among the top-level alternatives of list that end in the pseudo-element pseudo, pseudo_element_before or pseudo_element_after, and that element, the pseudo-element's originating element, matches with the pseudo-element left out, as matching_specificity judges an alternative, each counting the pseudo-element as one type selector; None when it matches none.";

public fn name_hash(bytes: &[u8]) -> hash: u64 reads(bytes) doc "Returns the 64-bit FNV-1a hash of bytes with each ASCII upper-case letter folded to lower case, so names that differ only in ASCII case hash alike.";

public fn sibling_positions(document: &Document) -> made: Positions reads(document) doc "Returns, for every node of document by its index, its 1-based position among its parent's element children and their number, and its position among those children with its namespace and local name and their number, 0 for a node that is not an element child of a node; each parent's children are walked twice, first child to last. A document past 2^32 - 2 nodes, or whose names give more than 2^32 namespace and name pairs, gets empty positions, which selector_matches_positioned treats as absent.";

public fn selector_matches_positioned(list: &SelectorList, document: &Document, atoms: &AtomTable, element: NodeId, context: MatchContext, positions: &Positions) -> result: Bool reads(list), reads(document), reads(atoms), reads(positions) doc "Returns what selector_matches returns, reading positions, which sibling_positions made for document, for :first-child, :last-child, :only-child, :nth-child, :nth-last-child and their -of-type forms instead of counting siblings; the of-clause forms of :nth-child and :nth-last-child, and a node positions does not cover, count as selector_matches does.";

public fn matching_specificity(list: &SelectorList, document: &Document, atoms: &AtomTable, element: NodeId, context: MatchContext, positions: &Positions) -> result: Option<Specificity> reads(list), reads(document), reads(atoms), reads(positions) doc "Returns the greatest specificity, under Selectors Level 4, among the complex selectors at the top level of list that element, an Element node of document, matches as selector_matches_positioned judges, or None when it matches none. Specificity counts ids in ids, classes, attribute selectors and pseudo-classes in classes, and type selectors in types; the universal selector and :where() count nothing, :is() and :not() count their most specific argument, and :nth-child(An+B of S) and :nth-last-child(An+B of S) count one pseudo-class and their most specific S. Each column saturates at the largest u32.";

public fn uniform_specificity(list: &SelectorList) -> result: Option<Specificity> reads(list) doc "Returns the specificity that every top-level alternative of list that can match has, under the rules matching_specificity follows, or None when two alternatives differ or none can match; a list with one has it statically, so a caller can match it with selector_matches_positioned and read the specificity once.";
