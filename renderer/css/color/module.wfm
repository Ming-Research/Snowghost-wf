alias ComponentList = pkg::css::syntax::ComponentList;
alias ComponentRange = pkg::css::rules::ComponentRange;

public enum ColorSpace {
  Rgb();
  Lab();
  Lch();
  Oklab();
  Oklch();
  Srgb();
  SrgbLinear();
  DisplayP3();
  A98Rgb();
  ProphotoRgb();
  Rec2020();
  XyzD50();
  XyzD65();
}

public struct Color {
  public space: ColorSpace;
  public first: f32;
  public second: f32;
  public third: f32;
  public alpha: f32;
  public missing: u8;
}

public enum ParsedColor {
  CurrentColor();
  Value(public color: Color);
}

public enum ColorError {
  Invalid();
}

public fn parse_color(values: &ComponentList, range: ComponentRange) -> result: Result<ParsedColor, ColorError> reads(values) doc "Parses the component values of values in range, surrounded by optional whitespace, as one <color> of CSS Color Module Level 4 as css-parsing-tests at revision 203ce36b represents it: a named color, transparent, currentcolor, a hex color, or one of rgb(), rgba(), hsl(), hsla(), hwb(), lab(), lch(), oklab(), oklch() and color() in the modern and legacy syntaxes, with none, percentages and angles as that level admits them. A range is as pkg::css::rules describes. Names and function names match ASCII case-insensitively. A named color, transparent, a hex color and rgb(), rgba(), hsl(), hsla() and hwb() give the Rgb space, with red, green and blue from 0 to 255 in first, second and third; hsl and hwb are converted, a none channel counting as zero. Lab(), lch(), oklab() and oklch() give their own spaces with their channels in order, percentages resolved against the reference ranges and hues in degrees from 0 up to 360. Color() gives the predefined space it names, xyz naming XyzD65, with percentages resolved against one. Alpha is from 0 to 1. Missing has bit 0, 1, 2 or 3 set when first, second, third or alpha is none, and those channels hold zero; its other bits are zero. Clamping, rounding of hex alpha and every other value follows that suite. System colors, color-mix(), light-dark(), relative colors, calc() and the CSS Color Module Level 5 spaces are Invalid at this revision.";
