fn hue_to_channel(t1: f64, t2: f64, hue: f64) -> result: f64 pure {
  doc "The hueToRgb step of CSS Color 4's hsl-to-rgb algorithm: t1, t2 and hue already divided by 60 and offset by 2, 0 or -2 for red, green or blue.";
  let adjusted = hue;
  let low = flt(adjusted, 0.0_f64);
  if low {
    set adjusted = fadd.strict(adjusted, 6.0_f64);
  }
  let high = fge(adjusted, 6.0_f64);
  if high {
    set adjusted = fsub.strict(adjusted, 6.0_f64);
  }
  let under1 = flt(adjusted, 1.0_f64);
  if under1 {
    let diff = fsub.strict(t2, t1);
    let scaled = fmul.strict(diff, adjusted);
    let result = fadd.strict(t1, scaled);
    return result;
  }
  let under3 = flt(adjusted, 3.0_f64);
  if under3 {
    return t2;
  }
  let under4 = flt(adjusted, 4.0_f64);
  if under4 {
    let remaining = fsub.strict(4.0_f64, adjusted);
    let diff = fsub.strict(t2, t1);
    let scaled = fmul.strict(diff, remaining);
    let result = fadd.strict(t1, scaled);
    return result;
  }
  return t1;
}

fn hsl_to_rgb(hue_deg: f64, saturation_pct: f64, light_pct: f64) -> (r: f64, g: f64, b: f64) pure {
  doc "Converts hue (already normalized to [0, 360)) with saturation and lightness in the 0 to 100 percentage domain to red, green and blue each from 0 to 255, per CSS Color 4's hsl-to-rgb algorithm.";
  let saturation = fdiv.strict(saturation_pct, 1.0e2_f64);
  let light = fdiv.strict(light_pct, 1.0e2_f64);
  let hue60 = fdiv.strict(hue_deg, 60.0_f64);
  let low_light = fle(light, 0.5_f64);
  let t2 = light;
  if low_light {
    let factor = fadd.strict(saturation, 1.0_f64);
    set t2 = fmul.strict(light, factor);
  } else {
    let product = fmul.strict(light, saturation);
    let sum = fadd.strict(light, saturation);
    set t2 = fsub.strict(sum, product);
  }
  let light2 = fmul.strict(light, 2.0_f64);
  let t1 = fsub.strict(light2, t2);
  let hue_r = fadd.strict(hue60, 2.0_f64);
  let r_frac = hue_to_channel(t1: t1, t2: t2, hue: hue_r);
  let g_frac = hue_to_channel(t1: t1, t2: t2, hue: hue60);
  let hue_b = fsub.strict(hue60, 2.0_f64);
  let b_frac = hue_to_channel(t1: t1, t2: t2, hue: hue_b);
  let r = fmul.strict(r_frac, 255.0_f64);
  let g = fmul.strict(g_frac, 255.0_f64);
  let b = fmul.strict(b_frac, 255.0_f64);
  return r, g, b;
}

fn hwb_to_rgb(hue_deg: f64, white_pct: f64, black_pct: f64) -> (r: f64, g: f64, b: f64) pure {
  doc "Converts hue (already normalized to [0, 360)) with whiteness and blackness in the 0 to 100 percentage domain to red, green and blue each from 0 to 255, per CSS Color 4's hwb-to-rgb algorithm: gray when whiteness plus blackness is at least 100%, otherwise hsl(hue, 100%, 50%) blended toward white and black.";
  let white = fdiv.strict(white_pct, 1.0e2_f64);
  let black = fdiv.strict(black_pct, 1.0e2_f64);
  let sum = fadd.strict(white, black);
  let gray = fge(sum, 1.0_f64);
  if gray {
    let fraction = fdiv.strict(white, sum);
    let level = fmul.strict(fraction, 255.0_f64);
    return level, level, level;
  }
  let (r0, g0, b0) = hsl_to_rgb(hue_deg: hue_deg, saturation_pct: 1.0e2_f64, light_pct: 50.0_f64);
  let factor = fsub.strict(1.0_f64, sum);
  let white255 = fmul.strict(white, 255.0_f64);
  let r_scaled = fmul.strict(r0, factor);
  let r = fadd.strict(r_scaled, white255);
  let g_scaled = fmul.strict(g0, factor);
  let g = fadd.strict(g_scaled, white255);
  let b_scaled = fmul.strict(b0, factor);
  let b = fadd.strict(b_scaled, white255);
  return r, g, b;
}
