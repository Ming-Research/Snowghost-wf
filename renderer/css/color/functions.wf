fn parse_color_function(values: &ComponentList, start: u64, limit: u64) -> result: Option<ParsedColor> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses color()'s contents: a predefined space ident, then three percentage-or-number-or-none channels against a reference of 1, then an optional alpha, all space-separated.";
  let (tok1, pos1) = next_lead(values: values, at: start, limit: limit);
  match tok1 {
    End() => {
      return None<ParsedColor>();
    }
    Whitespace() => {
      return None<ParsedColor>();
    }
    Comma() => {
      return None<ParsedColor>();
    }
    Slash() => {
      return None<ParsedColor>();
    }
    Number(value: v) => {
      return None<ParsedColor>();
    }
    Percentage(value: v) => {
      return None<ParsedColor>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ParsedColor>();
    }
    Hash(name: n) => {
      return None<ParsedColor>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ParsedColor>();
    }
    Other() => {
      return None<ParsedColor>();
    }
    Ident(name: n) => {
      let target = match predefined_space(values: values, name: n) {
        Some(value: s) => {
          give s;
        }
        None() => {
          return None<ParsedColor>();
        }
      }
      let no_hue = False();
      let three = parse_modern_three(values: values, start: pos1, limit: limit, first_hue: no_hue, first_ref: 1.0_f64, second_hue: no_hue, second_ref: 1.0_f64, third_hue: no_hue, third_ref: 1.0_f64);
      match three {
        None() => {
          return None<ParsedColor>();
        }
        Some(value: t) => {
          let color = assemble_direct(three: t, target: target);
          return Some<ParsedColor>(value: color);
        }
      }
    }
  }
}
