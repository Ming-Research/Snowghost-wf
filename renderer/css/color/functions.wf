alias ComponentList = pkg::css::syntax::ComponentList;

struct ThreeChannels {
  first: ChannelParse;
  second: ChannelParse;
  third: ChannelParse;
  alpha: ChannelParse;
}

fn resolve_generic(values: &ComponentList, token: Lead, is_hue: Bool, reference: f64) -> result: Option<ChannelParse> reads(values) {
  doc "Resolves token as a hue channel when is_hue, otherwise as a percentage-or-number-or-none channel against reference.";
  if is_hue {
    let result = resolve_hue(values: values, token: token);
    return result;
  }
  let result = resolve_channel(values: values, token: token, reference: reference);
  return result;
}

fn parse_modern_three(values: &ComponentList, start: u64, limit: u64, first_hue: Bool, first_ref: f64, second_hue: Bool, second_ref: f64, third_hue: Bool, third_ref: f64) -> result: Option<ThreeChannels> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses three space-separated channels (each hue or percentage-or-number-or-none, per its own flag and reference), then an optional '/' <alpha-value>, surrounded by optional whitespace, over exactly start to limit; an absent alpha is 1. None when the shape or any channel does not match, or anything follows.";
  let (tok1, pos1) = next_lead(values: values, at: start, limit: limit);
  let first = match resolve_generic(values: values, token: tok1, is_hue: first_hue, reference: first_ref) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (tok2, pos2) = next_lead(values: values, at: pos1, limit: limit);
  let second = match resolve_generic(values: values, token: tok2, is_hue: second_hue, reference: second_ref) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (tok3, pos3) = next_lead(values: values, at: pos2, limit: limit);
  let third = match resolve_generic(values: values, token: tok3, is_hue: third_hue, reference: third_ref) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (tok4, pos4) = next_lead(values: values, at: pos3, limit: limit);
  match tok4 {
    End() => {
      let full = ChannelParse::Present(value: 1.0_f64);
      let result = ThreeChannels(first: first, second: second, third: third, alpha: full);
      return Some<ThreeChannels>(value: result);
    }
    Slash() => {
      let (tok5, pos5) = next_lead(values: values, at: pos4, limit: limit);
      let alpha = match resolve_alpha(values: values, token: tok5) {
        Some(value: v) => {
          give v;
        }
        None() => {
          return None<ThreeChannels>();
        }
      }
      let (tok6, pos6) = next_lead(values: values, at: pos5, limit: limit);
      match tok6 {
        End() => {
          let result = ThreeChannels(first: first, second: second, third: third, alpha: alpha);
          return Some<ThreeChannels>(value: result);
        }
        Whitespace() => {
          return None<ThreeChannels>();
        }
        Comma() => {
          return None<ThreeChannels>();
        }
        Slash() => {
          return None<ThreeChannels>();
        }
        Number(value: v) => {
          return None<ThreeChannels>();
        }
        Percentage(value: v) => {
          return None<ThreeChannels>();
        }
        Dimension(value: v, unit_span: u) => {
          return None<ThreeChannels>();
        }
        Ident(name: n) => {
          return None<ThreeChannels>();
        }
        Hash(name: n) => {
          return None<ThreeChannels>();
        }
        Function(name: n, contents_start: cs, contents_end: ce) => {
          return None<ThreeChannels>();
        }
        Other() => {
          return None<ThreeChannels>();
        }
      }
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Comma() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
}

fn is_legacy(values: &ComponentList, start: u64, limit: u64) -> result: Bool reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "True when a comma directly follows the first argument: rgb()/hsl()'s legacy comma-separated syntax rather than the modern space-separated one.";
  let (first, after_first) = next_lead(values: values, at: start, limit: limit);
  let (second, after_second) = next_lead(values: values, at: after_first, limit: limit);
  match second {
    End() => {
      return False();
    }
    Whitespace() => {
      return False();
    }
    Comma() => {
      return True();
    }
    Slash() => {
      return False();
    }
    Number(value: v) => {
      return False();
    }
    Percentage(value: v) => {
      return False();
    }
    Dimension(value: v, unit_span: u) => {
      return False();
    }
    Ident(name: n) => {
      return False();
    }
    Hash(name: n) => {
      return False();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn require_end(values: &ComponentList, at: u64, limit: u64) -> result: Bool reads(values) contract {
  requires at <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "True when only whitespace remains from at to limit.";
  let (token, next) = next_lead(values: values, at: at, limit: limit);
  match token {
    End() => {
      return True();
    }
    Whitespace() => {
      return False();
    }
    Comma() => {
      return False();
    }
    Slash() => {
      return False();
    }
    Number(value: v) => {
      return False();
    }
    Percentage(value: v) => {
      return False();
    }
    Dimension(value: v, unit_span: u) => {
      return False();
    }
    Ident(name: n) => {
      return False();
    }
    Hash(name: n) => {
      return False();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return False();
    }
    Other() => {
      return False();
    }
  }
}

fn parse_legacy_rgb(values: &ComponentList, start: u64, limit: u64) -> result: Option<ThreeChannels> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses r, g, b as three comma-separated <number>s or three comma-separated <percentage>s, not mixed, with an optional comma-separated <alpha-value>, surrounded by optional whitespace, over exactly start to limit.";
  let (tok1, pos1) = next_lead(values: values, at: start, limit: limit);
  let percent_mode = lead_is_percentage(token: tok1);
  let number_mode = lead_is_number(token: tok1);
  let recognized_first = bor(percent_mode, number_mode);
  if recognized_first {
  } else {
    return None<ThreeChannels>();
  }
  let value1 = match resolve_plain(values: values, token: tok1, reference: 255.0_f64) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (comma1, after_comma1) = next_lead(values: values, at: pos1, limit: limit);
  match comma1 {
    End() => {
      return None<ThreeChannels>();
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Comma() => {
    }
    Slash() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
  let (tok2, pos2) = next_lead(values: values, at: after_comma1, limit: limit);
  let kind2_ok = False();
  if percent_mode {
    let m = lead_is_percentage(token: tok2);
    set kind2_ok = m;
  } else {
    let m = lead_is_number(token: tok2);
    set kind2_ok = m;
  }
  if kind2_ok {
  } else {
    return None<ThreeChannels>();
  }
  let value2 = match resolve_plain(values: values, token: tok2, reference: 255.0_f64) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (comma2, after_comma2) = next_lead(values: values, at: pos2, limit: limit);
  match comma2 {
    End() => {
      return None<ThreeChannels>();
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Comma() => {
    }
    Slash() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
  let (tok3, pos3) = next_lead(values: values, at: after_comma2, limit: limit);
  let kind3_ok = False();
  if percent_mode {
    let m = lead_is_percentage(token: tok3);
    set kind3_ok = m;
  } else {
    let m = lead_is_number(token: tok3);
    set kind3_ok = m;
  }
  if kind3_ok {
  } else {
    return None<ThreeChannels>();
  }
  let value3 = match resolve_plain(values: values, token: tok3, reference: 255.0_f64) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let first_parsed = ChannelParse::Present(value: value1);
  let second_parsed = ChannelParse::Present(value: value2);
  let third_parsed = ChannelParse::Present(value: value3);
  let full = ChannelParse::Present(value: 1.0_f64);
  let solid = ThreeChannels(first: first_parsed, second: second_parsed, third: third_parsed, alpha: full);
  let (tok4, pos4) = next_lead(values: values, at: pos3, limit: limit);
  match tok4 {
    End() => {
      return Some<ThreeChannels>(value: solid);
    }
    Comma() => {
      let (tok5, pos5) = next_lead(values: values, at: pos4, limit: limit);
      let alpha_value = match resolve_plain(values: values, token: tok5, reference: 1.0_f64) {
        Some(value: v) => {
          give v;
        }
        None() => {
          return None<ThreeChannels>();
        }
      }
      let alpha_clamped = clamp01(value: alpha_value);
      let ended = require_end(values: values, at: pos5, limit: limit);
      if ended {
      } else {
        return None<ThreeChannels>();
      }
      let alpha_parsed = ChannelParse::Present(value: alpha_clamped);
      let result = ThreeChannels(first: solid.first, second: solid.second, third: solid.third, alpha: alpha_parsed);
      return Some<ThreeChannels>(value: result);
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Slash() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
}

fn parse_legacy_hsl(values: &ComponentList, start: u64, limit: u64) -> result: Option<ThreeChannels> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses hue as a comma-separated <hue> (never none), saturation and lightness as comma-separated <percentage>s (never none), and an optional comma-separated <alpha-value>, surrounded by optional whitespace, over exactly start to limit.";
  let (tok1, pos1) = next_lead(values: values, at: start, limit: limit);
  let hue_value = match resolve_hue(values: values, token: tok1) {
    Some(value: parsed) => {
      match parsed {
        Missing() => {
          return None<ThreeChannels>();
        }
        Present(value: v) => {
          give v;
        }
      }
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (comma1, after_comma1) = next_lead(values: values, at: pos1, limit: limit);
  match comma1 {
    End() => {
      return None<ThreeChannels>();
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Comma() => {
    }
    Slash() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
  let (tok2, pos2) = next_lead(values: values, at: after_comma1, limit: limit);
  let is_percent2 = lead_is_percentage(token: tok2);
  if is_percent2 {
  } else {
    return None<ThreeChannels>();
  }
  let sat_value = match resolve_plain(values: values, token: tok2, reference: 1.0e2_f64) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let (comma2, after_comma2) = next_lead(values: values, at: pos2, limit: limit);
  match comma2 {
    End() => {
      return None<ThreeChannels>();
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Comma() => {
    }
    Slash() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
  let (tok3, pos3) = next_lead(values: values, at: after_comma2, limit: limit);
  let is_percent3 = lead_is_percentage(token: tok3);
  if is_percent3 {
  } else {
    return None<ThreeChannels>();
  }
  let light_value = match resolve_plain(values: values, token: tok3, reference: 1.0e2_f64) {
    Some(value: v) => {
      give v;
    }
    None() => {
      return None<ThreeChannels>();
    }
  }
  let first_parsed = ChannelParse::Present(value: hue_value);
  let second_parsed = ChannelParse::Present(value: sat_value);
  let third_parsed = ChannelParse::Present(value: light_value);
  let full = ChannelParse::Present(value: 1.0_f64);
  let solid = ThreeChannels(first: first_parsed, second: second_parsed, third: third_parsed, alpha: full);
  let (tok4, pos4) = next_lead(values: values, at: pos3, limit: limit);
  match tok4 {
    End() => {
      return Some<ThreeChannels>(value: solid);
    }
    Comma() => {
      let (tok5, pos5) = next_lead(values: values, at: pos4, limit: limit);
      let alpha_value = match resolve_plain(values: values, token: tok5, reference: 1.0_f64) {
        Some(value: v) => {
          give v;
        }
        None() => {
          return None<ThreeChannels>();
        }
      }
      let alpha_clamped = clamp01(value: alpha_value);
      let ended = require_end(values: values, at: pos5, limit: limit);
      if ended {
      } else {
        return None<ThreeChannels>();
      }
      let alpha_parsed = ChannelParse::Present(value: alpha_clamped);
      let result = ThreeChannels(first: solid.first, second: solid.second, third: solid.third, alpha: alpha_parsed);
      return Some<ThreeChannels>(value: result);
    }
    Whitespace() => {
      return None<ThreeChannels>();
    }
    Slash() => {
      return None<ThreeChannels>();
    }
    Number(value: v) => {
      return None<ThreeChannels>();
    }
    Percentage(value: v) => {
      return None<ThreeChannels>();
    }
    Dimension(value: v, unit_span: u) => {
      return None<ThreeChannels>();
    }
    Ident(name: n) => {
      return None<ThreeChannels>();
    }
    Hash(name: n) => {
      return None<ThreeChannels>();
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      return None<ThreeChannels>();
    }
    Other() => {
      return None<ThreeChannels>();
    }
  }
}

fn channels_alpha_bit(three: ThreeChannels) -> result: u8 pure {
  doc "8 when three's alpha is Missing, 0 otherwise.";
  let missing = channel_missing(parsed: three.alpha);
  if missing {
    return 8_u8;
  }
  return 0_u8;
}

fn channels_missing_bits(three: ThreeChannels) -> result: u8 pure {
  doc "The interface's missing bit pattern for three's first, second, third and alpha, bit 0 to 3 respectively.";
  let bits = 0_u8;
  let m0 = channel_missing(parsed: three.first);
  if m0 {
    set bits = ior(bits, 1_u8);
  }
  let m1 = channel_missing(parsed: three.second);
  if m1 {
    set bits = ior(bits, 2_u8);
  }
  let m2 = channel_missing(parsed: three.third);
  if m2 {
    set bits = ior(bits, 4_u8);
  }
  let m3 = channel_missing(parsed: three.alpha);
  if m3 {
    set bits = ior(bits, 8_u8);
  }
  return bits;
}

fn assemble_direct(three: ThreeChannels, target: ColorSpace) -> result: ParsedColor pure {
  doc "Builds a ParsedColor::Value in target directly from three's channels, each Missing channel holding zero, per the interface.";
  let bits = channels_missing_bits(three: three);
  let first_v = channel_value(parsed: three.first);
  let second_v = channel_value(parsed: three.second);
  let third_v = channel_value(parsed: three.third);
  let alpha_v = channel_value(parsed: three.alpha);
  let first32 = narrow_f32(value: first_v);
  let second32 = narrow_f32(value: second_v);
  let third32 = narrow_f32(value: third_v);
  let alpha32 = narrow_f32(value: alpha_v);
  let color = Color(space: target, first: first32, second: second32, third: third32, alpha: alpha32, missing: bits);
  let parsed = ParsedColor::Value(color: color);
  return parsed;
}

fn assemble_hsl(three: ThreeChannels) -> result: ParsedColor pure {
  doc "Builds the Rgb ParsedColor from hsl's three channels (hue, saturation, lightness), converting via hsl_to_rgb with a Missing channel counting as zero; the result's own missing bit is only ever alpha's, since the conversion always yields concrete red, green and blue.";
  let hue = channel_value(parsed: three.first);
  let saturation = channel_value(parsed: three.second);
  let light = channel_value(parsed: three.third);
  let (r, g, b) = hsl_to_rgb(hue_deg: hue, saturation_pct: saturation, light_pct: light);
  let alpha_v = channel_value(parsed: three.alpha);
  let bits = channels_alpha_bit(three: three);
  let r32 = narrow_f32(value: r);
  let g32 = narrow_f32(value: g);
  let b32 = narrow_f32(value: b);
  let alpha32 = narrow_f32(value: alpha_v);
  let space = ColorSpace::Rgb();
  let color = Color(space: space, first: r32, second: g32, third: b32, alpha: alpha32, missing: bits);
  let parsed = ParsedColor::Value(color: color);
  return parsed;
}

fn assemble_hwb(three: ThreeChannels) -> result: ParsedColor pure {
  doc "Builds the Rgb ParsedColor from hwb's three channels (hue, whiteness, blackness), converting via hwb_to_rgb with a Missing channel counting as zero; the result's own missing bit is only ever alpha's.";
  let hue = channel_value(parsed: three.first);
  let white = channel_value(parsed: three.second);
  let black = channel_value(parsed: three.third);
  let (r, g, b) = hwb_to_rgb(hue_deg: hue, white_pct: white, black_pct: black);
  let alpha_v = channel_value(parsed: three.alpha);
  let bits = channels_alpha_bit(three: three);
  let r32 = narrow_f32(value: r);
  let g32 = narrow_f32(value: g);
  let b32 = narrow_f32(value: b);
  let alpha32 = narrow_f32(value: alpha_v);
  let space = ColorSpace::Rgb();
  let color = Color(space: space, first: r32, second: g32, third: b32, alpha: alpha32, missing: bits);
  let parsed = ParsedColor::Value(color: color);
  return parsed;
}

fn parse_rgb_function(values: &ComponentList, start: u64, limit: u64) -> result: Option<ParsedColor> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses rgb()/rgba()'s contents in the legacy comma or modern space-separated syntax, giving the Rgb space with red, green and blue from 0 to 255.";
  let legacy = is_legacy(values: values, start: start, limit: limit);
  if legacy {
    let three = parse_legacy_rgb(values: values, start: start, limit: limit);
    match three {
      None() => {
        return None<ParsedColor>();
      }
      Some(value: t) => {
        let space = ColorSpace::Rgb();
        let color = assemble_direct(three: t, target: space);
        return Some<ParsedColor>(value: color);
      }
    }
  }
  let no_hue = False();
  let three = parse_modern_three(values: values, start: start, limit: limit, first_hue: no_hue, first_ref: 255.0_f64, second_hue: no_hue, second_ref: 255.0_f64, third_hue: no_hue, third_ref: 255.0_f64);
  match three {
    None() => {
      return None<ParsedColor>();
    }
    Some(value: t) => {
      let space = ColorSpace::Rgb();
      let color = assemble_direct(three: t, target: space);
      return Some<ParsedColor>(value: color);
    }
  }
}

fn parse_hsl_function(values: &ComponentList, start: u64, limit: u64) -> result: Option<ParsedColor> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses hsl()/hsla()'s contents in the legacy comma or modern space-separated syntax, converting to the Rgb space via hsl_to_rgb.";
  let legacy = is_legacy(values: values, start: start, limit: limit);
  if legacy {
    let three = parse_legacy_hsl(values: values, start: start, limit: limit);
    match three {
      None() => {
        return None<ParsedColor>();
      }
      Some(value: t) => {
        let color = assemble_hsl(three: t);
        return Some<ParsedColor>(value: color);
      }
    }
  }
  let no_hue = False();
  let yes_hue = True();
  let three = parse_modern_three(values: values, start: start, limit: limit, first_hue: yes_hue, first_ref: 0.0_f64, second_hue: no_hue, second_ref: 1.0e2_f64, third_hue: no_hue, third_ref: 1.0e2_f64);
  match three {
    None() => {
      return None<ParsedColor>();
    }
    Some(value: t) => {
      let color = assemble_hsl(three: t);
      return Some<ParsedColor>(value: color);
    }
  }
}

fn parse_hwb_function(values: &ComponentList, start: u64, limit: u64) -> result: Option<ParsedColor> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses hwb()'s contents, modern syntax only: hue, whiteness and blackness, converting to the Rgb space via hwb_to_rgb.";
  let no_hue = False();
  let yes_hue = True();
  let three = parse_modern_three(values: values, start: start, limit: limit, first_hue: yes_hue, first_ref: 0.0_f64, second_hue: no_hue, second_ref: 1.0e2_f64, third_hue: no_hue, third_ref: 1.0e2_f64);
  match three {
    None() => {
      return None<ParsedColor>();
    }
    Some(value: t) => {
      let color = assemble_hwb(three: t);
      return Some<ParsedColor>(value: color);
    }
  }
}

fn parse_lab_like(values: &ComponentList, start: u64, limit: u64, target: ColorSpace, l_ref: f64, a_ref: f64, b_ref: f64) -> result: Option<ParsedColor> reads(values) contract {
  requires start <= limit;
  requires limit <= values^.components.inner.len;
} {
  doc "Parses lab()'s or oklab()'s contents, modern syntax only: three percentage-or-number-or-none channels against l_ref, a_ref and b_ref, then an optional alpha, giving target directly.";
