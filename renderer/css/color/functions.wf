  let three = parse_modern_three(values: values, start: start, limit: limit, first_hue: no_hue, first_ref: l_ref, second_hue: no_hue, second_ref: a_ref, third_hue: no_hue, third_ref: b_ref);
  match three {
    None() => {
      return None<ParsedColor>();
    }
    Some(value: t) => {
      let color = assemble_direct(three: t, target: target);
      return Some<ParsedColor>(value: color);
    }
  }
}

fn parse_lch_like(values: &ComponentList, start: u64, limit: u64, target: ColorSpace, l_ref: f64, c_ref: f64) -> result: Option<ParsedColor> reads(values) contract {
