alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;
alias ComponentRange = pkg::css::rules::ComponentRange;

const fn_rgb: Array<u8, 3> =[114_u8, 103_u8, 98_u8];

const fn_rgba: Array<u8, 4> =[114_u8, 103_u8, 98_u8, 97_u8];

const fn_hsl: Array<u8, 3> =[104_u8, 115_u8, 108_u8];

const fn_hsla: Array<u8, 4> =[104_u8, 115_u8, 108_u8, 97_u8];

const fn_hwb: Array<u8, 3> =[104_u8, 119_u8, 98_u8];

const fn_lab: Array<u8, 3> =[108_u8, 97_u8, 98_u8];

const fn_lch: Array<u8, 3> =[108_u8, 99_u8, 104_u8];

const fn_oklab: Array<u8, 5> =[111_u8, 107_u8, 108_u8, 97_u8, 98_u8];

const fn_oklch: Array<u8, 5> =[111_u8, 107_u8, 108_u8, 99_u8, 104_u8];

const fn_color: Array<u8, 5> =[99_u8, 111_u8, 108_u8, 111_u8, 114_u8];

const ident_currentcolor: Array<u8, 12> =[99_u8, 117_u8, 114_u8, 114_u8, 101_u8, 110_u8, 116_u8, 99_u8, 111_u8, 108_u8, 111_u8, 114_u8];

fn clamp_range(values: &ComponentList, range: ComponentRange) -> (start: u64, limit: u64) reads(values) contract {
  ensures start <= limit;
  ensures limit <= values^.components.inner.len;
} {
  doc "Widens range to u64 and clamps it to values.components' length, so every position it names from start to limit is in bounds regardless of what range holds.";
  let count = values^.components.inner.len;
  let end_wide = cvt::<u32, u64>(range.end);
  let start_wide = cvt::<u32, u64>(range.start);
  if end_wide <= count {
    if start_wide <= end_wide {
      return start_wide, end_wide;
    }
    return end_wide, end_wide;
  }
  if start_wide <= count {
    return start_wide, count;
  }
  return count, count;
}

fn dispatch_function(values: &ComponentList, name: Span, contents_start: u64, contents_end: u64) -> result: Option<ParsedColor> reads(values) contract {
  requires contents_start <= contents_end;
  requires contents_end <= values^.components.inner.len;
} {
  doc "Dispatches a Function's name to its parser among rgb(), rgba(), hsl(), hsla(), hwb(), lab(), lch(), oklab(), oklch() and color(), ASCII case-insensitively; an unrecognized name is None.";
  let rgb_literal = &fn_rgb[0_u64..fn_rgb.len];
  let is_rgb = span_matches_ci(values: values, span: name, literal: rgb_literal);
  if is_rgb {
    let result = parse_rgb_function(values: values, start: contents_start, limit: contents_end);
    return result;
  }
  let rgba_literal = &fn_rgba[0_u64..fn_rgba.len];
  let is_rgba = span_matches_ci(values: values, span: name, literal: rgba_literal);
  if is_rgba {
    let result = parse_rgb_function(values: values, start: contents_start, limit: contents_end);
    return result;
  }
  let hsl_literal = &fn_hsl[0_u64..fn_hsl.len];
  let is_hsl = span_matches_ci(values: values, span: name, literal: hsl_literal);
  if is_hsl {
    let result = parse_hsl_function(values: values, start: contents_start, limit: contents_end);
    return result;
  }
  let hsla_literal = &fn_hsla[0_u64..fn_hsla.len];
  let is_hsla = span_matches_ci(values: values, span: name, literal: hsla_literal);
  if is_hsla {
    let result = parse_hsl_function(values: values, start: contents_start, limit: contents_end);
    return result;
  }
  let hwb_literal = &fn_hwb[0_u64..fn_hwb.len];
  let is_hwb = span_matches_ci(values: values, span: name, literal: hwb_literal);
  if is_hwb {
    let result = parse_hwb_function(values: values, start: contents_start, limit: contents_end);
    return result;
  }
  let lab_literal = &fn_lab[0_u64..fn_lab.len];
  let is_lab = span_matches_ci(values: values, span: name, literal: lab_literal);
  if is_lab {
    let space = ColorSpace::Lab();
    let result = parse_lab_like(values: values, start: contents_start, limit: contents_end, target: space, l_ref: 1.0e2_f64, a_ref: 125.0_f64, b_ref: 125.0_f64);
    return result;
  }
  let lch_literal = &fn_lch[0_u64..fn_lch.len];
  let is_lch = span_matches_ci(values: values, span: name, literal: lch_literal);
  if is_lch {
    let space = ColorSpace::Lch();
    let result = parse_lch_like(values: values, start: contents_start, limit: contents_end, target: space, l_ref: 1.0e2_f64, c_ref: 1.5e2_f64);
    return result;
  }
  let oklab_literal = &fn_oklab[0_u64..fn_oklab.len];
  let is_oklab = span_matches_ci(values: values, span: name, literal: oklab_literal);
  if is_oklab {
    let space = ColorSpace::Oklab();
    let result = parse_lab_like(values: values, start: contents_start, limit: contents_end, target: space, l_ref: 1.0_f64, a_ref: 0.4_f64, b_ref: 0.4_f64);
    return result;
  }
  let oklch_literal = &fn_oklch[0_u64..fn_oklch.len];
  let is_oklch = span_matches_ci(values: values, span: name, literal: oklch_literal);
  if is_oklch {
    let space = ColorSpace::Oklch();
    let result = parse_lch_like(values: values, start: contents_start, limit: contents_end, target: space, l_ref: 1.0_f64, c_ref: 0.4_f64);
    return result;
  }
  let color_literal = &fn_color[0_u64..fn_color.len];
  let is_color = span_matches_ci(values: values, span: name, literal: color_literal);
  if is_color {
    let result = parse_color_function(values: values, start: contents_start, limit: contents_end);
    return result;
  }
  return None<ParsedColor>();
}

fn parse_color(values: &ComponentList, range: ComponentRange) -> result: Result<ParsedColor, ColorError> reads(values) {
  doc "Parses range of values as one <color>, surrounded by optional whitespace: a named color or transparent, currentcolor, a hex color, or a recognized functional notation; anything else, or anything left over, is Invalid.";
  let (start, limit) = clamp_range(values: values, range: range);
  let (lead, after) = next_lead(values: values, at: start, limit: limit);
  match lead {
    End() => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Whitespace() => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Comma() => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Slash() => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Number(value: v) => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Percentage(value: v) => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Dimension(value: v, unit_span: u) => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Other() => {
      let invalid = ColorError::Invalid();
      return Err<ParsedColor, ColorError>(error: invalid);
    }
    Ident(name: n) => {
      let ended = require_end(values: values, at: after, limit: limit);
      if ended {
      } else {
        let invalid = ColorError::Invalid();
        return Err<ParsedColor, ColorError>(error: invalid);
      }
      let current_literal = &ident_currentcolor[0_u64..ident_currentcolor.len];
      let is_current = span_matches_ci(values: values, span: n, literal: current_literal);
      if is_current {
        let current = ParsedColor::CurrentColor();
        return Ok<ParsedColor, ColorError>(value: current);
      }
      let found = named_color_lookup(values: values, span: n);
      match found {
        None() => {
          let invalid = ColorError::Invalid();
          return Err<ParsedColor, ColorError>(error: invalid);
        }
        Some(value: named) => {
          let r32 = narrow_f32(value: named.r);
          let g32 = narrow_f32(value: named.g);
          let b32 = narrow_f32(value: named.b);
          let alpha = 1.0_f64;
          if named.is_opaque {
          } else {
            set alpha = 0.0_f64;
          }
          let alpha32 = narrow_f32(value: alpha);
          let space = ColorSpace::Rgb();
          let color = Color(space: space, first: r32, second: g32, third: b32, alpha: alpha32, missing: 0_u8);
          let parsed = ParsedColor::Value(color: color);
          return Ok<ParsedColor, ColorError>(value: parsed);
        }
      }
    }
    Hash(name: n) => {
      let ended = require_end(values: values, at: after, limit: limit);
      if ended {
      } else {
        let invalid = ColorError::Invalid();
        return Err<ParsedColor, ColorError>(error: invalid);
      }
      let parsed = parse_hex_color(values: values, name: n);
      return parsed;
    }
    Function(name: n, contents_start: cs, contents_end: ce) => {
      let ended = require_end(values: values, at: after, limit: limit);
      if ended {
      } else {
        let invalid = ColorError::Invalid();
        return Err<ParsedColor, ColorError>(error: invalid);
      }
      let ordered = cs <= ce;
      let within = ce <= values^.components.inner.len;
      let bounded = band(ordered, within);
      if bounded {
      } else {
        let invalid = ColorError::Invalid();
        return Err<ParsedColor, ColorError>(error: invalid);
      }
      let result = dispatch_function(values: values, name: n, contents_start: cs, contents_end: ce);
      match result {
        None() => {
          let invalid = ColorError::Invalid();
          return Err<ParsedColor, ColorError>(error: invalid);
        }
        Some(value: color) => {
          return Ok<ParsedColor, ColorError>(value: color);
        }
      }
    }
  }
}
