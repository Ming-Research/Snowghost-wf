alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

const space_name_srgb: Array<u8, 4> =[115_u8, 114_u8, 103_u8, 98_u8];

const space_name_srgb_linear: Array<u8, 11> =[115_u8, 114_u8, 103_u8, 98_u8, 45_u8, 108_u8, 105_u8, 110_u8, 101_u8, 97_u8, 114_u8];

const space_name_display_p3: Array<u8, 10> =[100_u8, 105_u8, 115_u8, 112_u8, 108_u8, 97_u8, 121_u8, 45_u8, 112_u8, 51_u8];

const space_name_a98_rgb: Array<u8, 7> =[97_u8, 57_u8, 56_u8, 45_u8, 114_u8, 103_u8, 98_u8];

const space_name_prophoto_rgb: Array<u8, 12> =[112_u8, 114_u8, 111_u8, 112_u8, 104_u8, 111_u8, 116_u8, 111_u8, 45_u8, 114_u8, 103_u8, 98_u8];

const space_name_rec2020: Array<u8, 7> =[114_u8, 101_u8, 99_u8, 50_u8, 48_u8, 50_u8, 48_u8];

const space_name_xyz: Array<u8, 3> =[120_u8, 121_u8, 122_u8];

const space_name_xyz_d50: Array<u8, 7> =[120_u8, 121_u8, 122_u8, 45_u8, 100_u8, 53_u8, 48_u8];

const space_name_xyz_d65: Array<u8, 7> =[120_u8, 121_u8, 122_u8, 45_u8, 100_u8, 54_u8, 53_u8];

fn predefined_space(values: &ComponentList, name: Span) -> result: Option<ColorSpace> reads(values.text.inner) {
  doc "Looks name up among color()'s predefined space idents, ASCII case-insensitively: srgb, srgb-linear, display-p3, a98-rgb, prophoto-rgb, rec2020, xyz, xyz-d50 and xyz-d65, with xyz naming XyzD65 exactly as xyz-d65 does.";
  let srgb_literal = &space_name_srgb[0_u64..space_name_srgb.len];
  let is_srgb = span_matches_ci(values: values, span: name, literal: srgb_literal);
  if is_srgb {
    let space = ColorSpace::Srgb();
    return Some<ColorSpace>(value: space);
  }
  let srgb_linear_literal = &space_name_srgb_linear[0_u64..space_name_srgb_linear.len];
  let is_srgb_linear = span_matches_ci(values: values, span: name, literal: srgb_linear_literal);
  if is_srgb_linear {
    let space = ColorSpace::SrgbLinear();
    return Some<ColorSpace>(value: space);
  }
  let display_p3_literal = &space_name_display_p3[0_u64..space_name_display_p3.len];
  let is_display_p3 = span_matches_ci(values: values, span: name, literal: display_p3_literal);
  if is_display_p3 {
    let space = ColorSpace::DisplayP3();
    return Some<ColorSpace>(value: space);
  }
  let a98_rgb_literal = &space_name_a98_rgb[0_u64..space_name_a98_rgb.len];
  let is_a98_rgb = span_matches_ci(values: values, span: name, literal: a98_rgb_literal);
  if is_a98_rgb {
    let space = ColorSpace::A98Rgb();
    return Some<ColorSpace>(value: space);
  }
  let prophoto_rgb_literal = &space_name_prophoto_rgb[0_u64..space_name_prophoto_rgb.len];
  let is_prophoto_rgb = span_matches_ci(values: values, span: name, literal: prophoto_rgb_literal);
  if is_prophoto_rgb {
    let space = ColorSpace::ProphotoRgb();
    return Some<ColorSpace>(value: space);
  }
  let rec2020_literal = &space_name_rec2020[0_u64..space_name_rec2020.len];
  let is_rec2020 = span_matches_ci(values: values, span: name, literal: rec2020_literal);
  if is_rec2020 {
    let space = ColorSpace::Rec2020();
    return Some<ColorSpace>(value: space);
  }
  let xyz_d50_literal = &space_name_xyz_d50[0_u64..space_name_xyz_d50.len];
  let is_xyz_d50 = span_matches_ci(values: values, span: name, literal: xyz_d50_literal);
  if is_xyz_d50 {
    let space = ColorSpace::XyzD50();
    return Some<ColorSpace>(value: space);
  }
  let xyz_d65_literal = &space_name_xyz_d65[0_u64..space_name_xyz_d65.len];
  let is_xyz_d65 = span_matches_ci(values: values, span: name, literal: xyz_d65_literal);
  if is_xyz_d65 {
    let space = ColorSpace::XyzD65();
    return Some<ColorSpace>(value: space);
  }
  let xyz_literal = &space_name_xyz[0_u64..space_name_xyz.len];
  let is_xyz = span_matches_ci(values: values, span: name, literal: xyz_literal);
  if is_xyz {
    let space = ColorSpace::XyzD65();
    return Some<ColorSpace>(value: space);
  }
  return None<ColorSpace>();
}
