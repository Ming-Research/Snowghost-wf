struct NamedColor {
  r: f64;
  g: f64;
  b: f64;
  is_opaque: Bool;
}

fn named_color_at(values: &ComponentList, span: Span, i: u64) -> result: Option<NamedColor> reads(values.text.inner) contract {
  requires i < named_color_count;
} {
  doc "Compares span against the i'th table entry, and gives its color on a match.";
  let offset32 = named_color_offset[i];
  let offset = cvt::<u32, u64>(offset32);
  let length8 = named_color_length[i];
  let length = cvt::<u8, u64>(length8);
  let end = offset +wrap length;
  let fits = end <= named_color_bytes.len;
  if fits {
  } else {
    return None<NamedColor>();
  }
  let literal = &named_color_bytes[offset..end];
  let matched = span_matches_ci(values: values, span: span, literal: literal);
  if matched {
  } else {
    return None<NamedColor>();
  }
  let r8 = named_color_r[i];
  let g8 = named_color_g[i];
  let b8 = named_color_b[i];
  let opaque8 = named_color_opaque[i];
  let r = cvt::<u8, f64>(r8);
  let g = cvt::<u8, f64>(g8);
  let b = cvt::<u8, f64>(b8);
  let is_opaque = opaque8 != 0_u8;
  let found = NamedColor(r: r, g: g, b: b, is_opaque: is_opaque);
  return Some<NamedColor>(value: found);
}

fn named_color_lookup(values: &ComponentList, span: Span) -> result: Option<NamedColor> reads(values.text.inner) {
  doc "Looks span up in the 149 CSS named colors (the 148 keywords of section 6.1 plus transparent), ASCII case-insensitively, giving its RGB triple and whether it is opaque (every color but transparent).";
  for (i in 0_u64..named_color_count) {
    let found = named_color_at(values: values, span: span, i: i);
    match found {
      Some(value: color) => {
        return Some<NamedColor>(value: color);
      }
      None() => {
      }
    }
  }
  return None<NamedColor>();
}
