pkg::text::line_break: [];
pkg::css::syntax: [];
pkg::image::png: [];
pkg::html::tokenizer: [];
pkg::oracle::support: [std::io, std::text, std::fs];
pkg::oracle::line_break: [pkg::text::line_break, pkg::oracle::support, std::io, std::text, std::fs, std::process];
pkg::oracle::css_syntax: [pkg::css::syntax, pkg::oracle::support, std::io, std::text, std::fs, std::process];
pkg::oracle::png: [pkg::image::png, pkg::oracle::support, std::io, std::text, std::fs, std::process];
pkg::oracle::html_tokenizer: [pkg::html::tokenizer, pkg::oracle::support, std::io, std::text, std::fs, std::process];

entry line_break_oracle = pkg::oracle::line_break::run;

entry css_syntax_oracle = pkg::oracle::css_syntax::run;

entry png_oracle = pkg::oracle::png::run;

entry html_tokenizer_oracle = pkg::oracle::html_tokenizer::run;
