alias normalization = pkg::text::normalization;
alias properties = pkg::text::properties;

const category_format: u16 = 1_u16;

const category_other_letter: u16 = 7_u16;

const category_spacing_mark: u16 = 10_u16;

const category_nonspacing_mark: u16 = 12_u16;

const category_decimal_number: u16 = 13_u16;

const category_modifier_symbol: u16 = 24_u16;

const category_space_separator: u16 = 29_u16;

const category_bits: u16 = 31_u16;

const unicode_ignorable: u16 = 32_u16;

const unicode_hidden: u16 = 64_u16;

const unicode_continuation: u16 = 128_u16;

const unicode_zwj: u16 = 256_u16;

const unicode_zwnj: u16 = 512_u16;

const unicode_variation_selector: u16 = 1024_u16;

const unicode_low_flags: u16 = 224_u16;

const glyph_base: u16 = 2_u16;

const glyph_ligature: u16 = 4_u16;

const glyph_mark: u16 = 8_u16;

const glyph_substituted: u16 = 16_u16;

const glyph_ligated: u16 = 32_u16;

const glyph_multiplied: u16 = 64_u16;

const glyph_preserve: u16 = 112_u16;

const lig_base_bit: u8 = 16_u8;

const lig_low_bits: u8 = 15_u8;

fn within(value: u32, low: u32, high: u32) -> result: Bool pure {
  doc "Whether value lies from low to high inclusive.";
  let above = value >= low;
  let below = value <= high;
  let inside = band(above, below);
  return inside;
}

fn category_code(scalar: u32) -> result: u16 pure {
  doc "Returns scalar's General_Category as HarfBuzz numbers hb_unicode_general_category_t: Cc 0, Cf 1, Cn 2, Co 3, Cs 4, Ll 5, Lm 6, Lo 7, Lt 8, Lu 9, Mc 10, Me 11, Mn 12, Nd 13, Nl 14, No 15, Pc 16, Pd 17, Pe 18, Pf 19, Pi 20, Po 21, Ps 22, Sc 23, Sk 24, Sm 25, So 26, Zl 27, Zp 28 and Zs 29.";
  match properties::general_category(scalar: scalar) {
    UppercaseLetter() => {
      return 9_u16;
    }
    LowercaseLetter() => {
      return 5_u16;
    }
    TitlecaseLetter() => {
      return 8_u16;
    }
    ModifierLetter() => {
      return 6_u16;
    }
    OtherLetter() => {
      return 7_u16;
    }
    NonspacingMark() => {
      return 12_u16;
    }
    SpacingMark() => {
      return 10_u16;
    }
    EnclosingMark() => {
      return 11_u16;
    }
    DecimalNumber() => {
      return 13_u16;
    }
    LetterNumber() => {
      return 14_u16;
    }
    OtherNumber() => {
      return 15_u16;
    }
    ConnectorPunctuation() => {
      return 16_u16;
    }
    DashPunctuation() => {
      return 17_u16;
    }
    OpenPunctuation() => {
      return 22_u16;
    }
    ClosePunctuation() => {
      return 18_u16;
    }
    InitialPunctuation() => {
      return 20_u16;
    }
    FinalPunctuation() => {
      return 19_u16;
    }
    OtherPunctuation() => {
      return 21_u16;
    }
    MathSymbol() => {
      return 25_u16;
    }
    CurrencySymbol() => {
      return 23_u16;
    }
    ModifierSymbol() => {
      return 24_u16;
    }
    OtherSymbol() => {
      return 26_u16;
    }
    SpaceSeparator() => {
      return 29_u16;
    }
    LineSeparator() => {
      return 27_u16;
    }
    ParagraphSeparator() => {
      return 28_u16;
    }
    Control() => {
      return 0_u16;
    }
    Format() => {
      return 1_u16;
    }
    Surrogate() => {
      return 4_u16;
    }
    PrivateUse() => {
      return 3_u16;
    }
    Unassigned() => {
      return 2_u16;
    }
  }
}

fn default_ignorable_scalar(scalar: u32) -> result: Bool pure {
  doc "HarfBuzz's is_default_ignorable: Default_Ignorable_Code_Point without U+115F, U+1160, U+3164, U+FFA0 and U+1BCA0 to U+1BCA3.";
  if scalar == 173_u32 {
    return True();
  }
  if scalar == 847_u32 {
    return True();
  }
  if scalar == 1564_u32 {
    return True();
  }
  let khmer = within(value: scalar, low: 6068_u32, high: 6069_u32);
  let mongolian = within(value: scalar, low: 6155_u32, high: 6159_u32);
  let formats = within(value: scalar, low: 8203_u32, high: 8207_u32);
  let embeddings = within(value: scalar, low: 8234_u32, high: 8238_u32);
  let invisibles = within(value: scalar, low: 8288_u32, high: 8303_u32);
  let selectors = within(value: scalar, low: 65024_u32, high: 65039_u32);
  let byte_order = scalar == 65279_u32;
  let specials = within(value: scalar, low: 65520_u32, high: 65528_u32);
  let musical = within(value: scalar, low: 119155_u32, high: 119162_u32);
  let tags = within(value: scalar, low: 917504_u32, high: 921599_u32);
  let first = bor(khmer, mongolian);
  let second = bor(formats, embeddings);
  let third = bor(invisibles, selectors);
  let fourth = bor(byte_order, specials);
  let fifth = bor(musical, tags);
  let early = bor(first, second);
  let middle = bor(third, fourth);
  let late = bor(middle, fifth);
  let any = bor(early, late);
  return any;
}

fn variation_selector_scalar(scalar: u32) -> result: Bool pure {
  doc "HarfBuzz's is_variation_selector: U+FE00 to U+FE0F and U+E0100 to U+E01EF.";
  let basic = within(value: scalar, low: 65024_u32, high: 65039_u32);
  let supplement = within(value: scalar, low: 917760_u32, high: 917999_u32);
  let either = bor(basic, supplement);
  return either;
}

fn modified_combining_class(scalar: u32) -> result: u16 pure {
  doc "HarfBuzz's modified_combining_class: the Canonical_Combining_Class with Hebrew, Arabic, Syriac, Telugu, Thai, Lao and Tibetan fixed-position classes renumbered to order marks as HarfBuzz orders them, and U+1A60 and U+0FC6 at 254 and U+0F39 at 127.";
  if scalar == 6752_u32 {
    return 254_u16;
  }
  if scalar == 4038_u32 {
    return 254_u16;
  }
  if scalar == 3897_u32 {
    return 127_u16;
  }
  let class = normalization::canonical_combining_class(scalar: scalar);
  let wide = cvt::<u8, u16>(class);
  if class < 10_u8 {
    return wide;
  }
  if class <= 36_u8 {
    let renumbered = hebrew_arabic_class(class: class);
    return renumbered;
  }
  if class == 84_u8 {
    return 4_u16;
  }
  if class == 91_u8 {
    return 5_u16;
  }
  if class == 103_u8 {
    return 3_u16;
  }
  if class == 130_u8 {
    return 132_u16;
  }
  if class == 132_u8 {
    return 131_u16;
  }
  return wide;
}

fn hebrew_arabic_class(class: u8) -> result: u16 pure {
  doc "HarfBuzz's modified classes of the fixed-position classes 10 to 36, Hebrew points, Arabic harakat and the Syriac superscript alaph.";
  if class == 10_u8 {
    return 22_u16;
  }
  if class == 11_u8 {
    return 15_u16;
  }
  if class == 12_u8 {
    return 16_u16;
  }
  if class == 13_u8 {
    return 17_u16;
  }
  if class == 14_u8 {
    return 23_u16;
  }
  if class == 15_u8 {
    return 18_u16;
  }
  if class == 16_u8 {
    return 19_u16;
  }
  if class == 17_u8 {
    return 20_u16;
  }
  if class == 18_u8 {
    return 21_u16;
  }
  if class == 19_u8 {
    return 14_u16;
  }
  if class == 20_u8 {
    return 24_u16;
  }
  if class == 21_u8 {
    return 12_u16;
  }
  if class == 22_u8 {
    return 25_u16;
  }
  if class == 23_u8 {
    return 13_u16;
  }
  if class == 24_u8 {
    return 10_u16;
  }
  if class == 25_u8 {
    return 11_u16;
  }
  if class == 27_u8 {
    return 28_u16;
  }
  if class == 28_u8 {
    return 29_u16;
  }
  if class == 29_u8 {
    return 30_u16;
  }
  if class == 30_u8 {
    return 31_u16;
  }
  if class == 31_u8 {
    return 32_u16;
  }
  if class == 32_u8 {
    return 33_u16;
  }
  if class == 33_u8 {
    return 27_u16;
  }
  let same = cvt::<u8, u16>(class);
  return same;
}

fn unicode_props_of(scalar: u32) -> result: u16 pure {
  doc "HarfBuzz's _hb_glyph_info_set_unicode_props: the General_Category code in the low five bits; from U+0080, the ignorable bit for a default ignorable, with the ZWNJ or ZWJ bit for U+200C and U+200D and the hidden bit for the Mongolian free variation selectors, the tag characters and U+034F; and, for a mark, the continuation bit and the modified combining class in the high byte.";
  let category = category_code(scalar: scalar);
  if scalar < 128_u32 {
    return category;
  }
  let props = category;
  let ignorable = default_ignorable_scalar(scalar: scalar);
  if ignorable {
    set props = ior(props, unicode_ignorable);
    let mongolian_low = within(value: scalar, low: 6155_u32, high: 6157_u32);
    let mongolian_high = scalar == 6159_u32;
    let mongolian = bor(mongolian_low, mongolian_high);
    let tag = within(value: scalar, low: 917536_u32, high: 917631_u32);
    let joiner = scalar == 847_u32;
    let tagged = bor(mongolian, tag);
    let hidden = bor(tagged, joiner);
    if scalar == 8204_u32 {
      set props = ior(props, unicode_zwnj);
    } else if scalar == 8205_u32 {
      set props = ior(props, unicode_zwj);
    } else if hidden {
      set props = ior(props, unicode_hidden);
    }
  }
  let low = category >= category_spacing_mark;
  let high = category <= category_nonspacing_mark;
  let mark = band(low, high);
  if mark {
    let class = modified_combining_class(scalar: scalar);
    let shifted = ishl.wrap(class, 8_u32);
    set props = ior(props, unicode_continuation);
    set props = ior(props, shifted);
  }
  return props;
}

fn space_fallback_type(scalar: u32) -> result: u16 pure {
  doc "HarfBuzz's space_fallback_type for the space characters it can replace with U+0020: 1, 2, 3, 4, 5, 6 and 16 for a space of that fraction of an em, 17 for four eighteenths of an em, 18 for a plain space, 19 for a figure space, 20 for a punctuation space, 21 for a narrow space, and 0 for any other character.";
  if scalar == 32_u32 {
    return 18_u16;
  }
  if scalar == 160_u32 {
    return 18_u16;
  }
  if scalar == 8192_u32 {
    return 2_u16;
  }
  if scalar == 8193_u32 {
    return 1_u16;
  }
  if scalar == 8194_u32 {
    return 2_u16;
  }
  if scalar == 8195_u32 {
    return 1_u16;
  }
  if scalar == 8196_u32 {
    return 3_u16;
  }
  if scalar == 8197_u32 {
    return 4_u16;
  }
  if scalar == 8198_u32 {
    return 6_u16;
  }
  if scalar == 8199_u32 {
    return 19_u16;
  }
  if scalar == 8200_u32 {
    return 20_u16;
  }
  if scalar == 8201_u32 {
    return 5_u16;
  }
  if scalar == 8202_u32 {
    return 16_u16;
  }
  if scalar == 8239_u32 {
    return 21_u16;
  }
  if scalar == 8287_u32 {
    return 17_u16;
  }
  if scalar == 12288_u32 {
    return 1_u16;
  }
  return 0_u16;
}

fn category_of(item: Item) -> result: u16 pure {
  doc "The General_Category code of item's unicode_props.";
  let category = iand(item.unicode_props, category_bits);
  return category;
}

fn unicode_mark(item: Item) -> result: Bool pure {
  doc "HarfBuzz's _hb_glyph_info_is_unicode_mark: a category of Mc, Me or Mn.";
  let category = category_of(item: item);
  let low = category >= category_spacing_mark;
  let high = category <= category_nonspacing_mark;
  let mark = band(low, high);
  return mark;
}

fn combining_class_of(item: Item) -> result: u16 pure {
  doc "HarfBuzz's info_cc: the modified combining class of a unicode mark, 0 for anything else.";
  let mark = unicode_mark(item: item);
  if mark {
    let class = ishr.wrap(item.unicode_props, 8_u32);
    return class;
  }
  return 0_u16;
}

fn with_category(item: Item, category: u16) -> result: Item pure {
  doc "HarfBuzz's _hb_glyph_info_set_general_category: sets the category, keeps the ignorable, hidden and continuation bits and clears the high byte.";
  let kept = iand(item.unicode_props, unicode_low_flags);
  let props = ior(kept, category);
  let changed = item;
  set changed.unicode_props = props;
  return changed;
}

fn has_unicode_bit(item: Item, bit: u16) -> result: Bool pure {
  doc "Whether item's unicode_props has bit.";
  let masked = iand(item.unicode_props, bit);
  let present = masked != 0_u16;
  return present;
}

fn has_glyph_bit(item: Item, bit: u16) -> result: Bool pure {
  doc "Whether item's glyph_props has bit.";
  let masked = iand(item.glyph_props, bit);
  let present = masked != 0_u16;
  return present;
}

fn default_ignorable(item: Item) -> result: Bool pure {
  doc "HarfBuzz's _hb_glyph_info_is_default_ignorable: ignorable and not substituted.";
  let ignorable = has_unicode_bit(item: item, bit: unicode_ignorable);
  let substituted = has_glyph_bit(item: item, bit: glyph_substituted);
  let kept = bnot(substituted);
  let both = band(ignorable, kept);
  return both;
}

fn format_bit(item: Item, bit: u16) -> result: Bool pure {
  doc "Whether item is a format character (Cf) whose unicode_props has bit, as HarfBuzz tests ZWJ and ZWNJ.";
  let category = category_of(item: item);
  let format = category == category_format;
  let flagged = has_unicode_bit(item: item, bit: bit);
  let both = band(format, flagged);
  return both;
}

fn lig_id_of(item: Item) -> result: u8 pure {
  doc "HarfBuzz's _hb_glyph_info_get_lig_id.";
  let id = ishr.wrap(item.lig_props, 5_u32);
  return id;
}

fn ligated_internal(item: Item) -> result: Bool pure {
  doc "Whether item's lig_props mark it as a ligature base.";
  let masked = iand(item.lig_props, lig_base_bit);
  let set_bit = masked != 0_u8;
  return set_bit;
}

fn lig_comp_of(item: Item) -> result: u8 pure {
  doc "HarfBuzz's _hb_glyph_info_get_lig_comp: 0 for a ligature base, and the component otherwise.";
  let internal = ligated_internal(item: item);
  if internal {
    return 0_u8;
  }
  let component = iand(item.lig_props, lig_low_bits);
  return component;
}

fn lig_num_comps_of(item: Item) -> result: u8 pure {
  doc "HarfBuzz's _hb_glyph_info_get_lig_num_comps: the component count of a ligature glyph formed by ligation, and 1 otherwise.";
  let ligature = has_glyph_bit(item: item, bit: glyph_ligature);
  let internal = ligated_internal(item: item);
  let both = band(ligature, internal);
  if both {
    let count = iand(item.lig_props, lig_low_bits);
    return count;
  }
  return 1_u8;
}

fn lig_num_comps_in_ligation(item: Item) -> result: u8 pure {
  doc "HarfBuzz's _hb_glyph_info_get_lig_num_comps_in_ligation: 0 for a piece of a multiple substitution other than its first, which adds no component, and the component count otherwise.";
  let multiplied = has_glyph_bit(item: item, bit: glyph_multiplied);
  let component = lig_comp_of(item: item);
  let piece = component != 0_u8;
  let later = band(multiplied, piece);
  if later {
    return 0_u8;
  }
  let count = lig_num_comps_of(item: item);
  return count;
}

fn ligature_props(id: u8, count: u64) -> result: u8 pure {
  doc "HarfBuzz's _hb_glyph_info_set_lig_props_for_ligature: id in the top three bits, the base bit, and count modulo 16.";
  let shifted = ishl.wrap(id, 5_u32);
  let wrapped = cvt.wrap::<u64, u8>(count);
  let low = iand(wrapped, lig_low_bits);
  let with_base = ior(shifted, lig_base_bit);
  let props = ior(with_base, low);
  return props;
}

fn mark_props(id: u8, component: u64) -> result: u8 pure {
  doc "HarfBuzz's _hb_glyph_info_set_lig_props_for_mark: id in the top three bits and component modulo 16.";
  let shifted = ishl.wrap(id, 5_u32);
  let wrapped = cvt.wrap::<u64, u8>(component);
  let low = iand(wrapped, lig_low_bits);
  let props = ior(shifted, low);
  return props;
}

fn definition_props(face: &Face, glyph: u32) -> result: u16 reads(face) {
  doc "HarfBuzz's GDEF get_glyph_props for glyph: the base, ligature or mark bit for GDEF class 1, 2 or 3, a mark also carrying its mark attachment class in the high byte, and 0 for any other class.";
  let index = cvt::<u32, u64>(glyph);
  let count = face^.definitions.glyph_classes.inner.len;
  if index < count {
  } else {
    return 0_u16;
  }
  let class = face^.definitions.glyph_classes.inner[index];
  if class == 1_u8 {
    return glyph_base;
  }
  if class == 2_u8 {
    return glyph_ligature;
  }
  if class == 3_u8 {
    let attachments = face^.definitions.mark_attachment_classes.inner.len;
    if index < attachments {
      let attachment = face^.definitions.mark_attachment_classes.inner[index];
      let wide = cvt::<u8, u16>(attachment);
      let high = ishl.wrap(wide, 8_u32);
      let props = ior(glyph_mark, high);
      return props;
    }
    return glyph_mark;
  }
  return 0_u16;
}
