struct PlannedLookup {
  doc "One lookup HarfBuzz's map applies: its index in the table's lookups, the mask of the features that select it, and whether ZWNJ and ZWJ are skipped automatically, which a feature with manual joiners turns off.";
  index: u16;
  mask: u8;
  auto_zwnj: Bool;
  auto_zwj: Bool;
}

struct Plan {
  doc "The lookups shape_run applies, in order: substitutions for GSUB and positions for GPOS. numr_mask, frac_mask and dnom_mask are the mask bits of the fraction features, 0 for a feature the face lacks; positioning is whether the face has GPOS, which HarfBuzz applies instead of its fallbacks.";
  substitutions: Box<Slots<PlannedLookup>>;
  positions: Box<Slots<PlannedLookup>>;
  numr_mask: u8;
  frac_mask: u8;
  dnom_mask: u8;
  positioning: Bool;
}

struct FeatureSpec {
  doc "A feature HarfBuzz enables for a horizontal left-to-right run with the default shaper, in the order it adds them: its tag, its mask bit (mask_global unless it applies to marked glyphs only), 1 when it uses manual joiners and 0 otherwise, and its GSUB stage.";
  tag: u32;
  mask: u8;
  manual: u8;
  stage: u8;
}

const mask_global: u8 = 1_u8;

const mask_numr: u8 = 2_u8;

const mask_frac: u8 = 4_u8;

const mask_dnom: u8 = 8_u8;

const mask_bits: u8 = 15_u8;

const planned_manual_zwnj: u8 = 16_u8;

const planned_manual_zwj: u8 = 32_u8;

const planned_present: u8 = 128_u8;

const no_index: u64 = 18446744073709551615_u64;

const tag_latn: u32 = 1818326126_u32;

const tag_grek: u32 = 1735550315_u32;

const tag_cyrl: u32 = 1668903532_u32;

const tag_zyyy: u32 = 2054781305_u32;

const tag_upper_dflt: u32 = 1145457748_u32;

const tag_dflt: u32 = 1684434036_u32;

const tag_rvrn: u32 = 1920365166_u32;

const default_feature_count: u64 = 25_u64;

const default_features: Array<FeatureSpec, 25> =[FeatureSpec(tag: 1920365166_u32, mask: 1_u8, manual: 0_u8, stage: 0_u8), FeatureSpec(tag: 1819570785_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1819570797_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1718772067_u32, mask: 4_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1853189490_u32, mask: 2_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1684959085_u32, mask: 8_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1918987876_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1214345830_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1212240454_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1114995322_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1112889946_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1633842797_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1651275629_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1667460464_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1819239276_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1835102827_u32, mask: 1_u8, manual: 1_u8, stage: 1_u8), FeatureSpec(tag: 1835756907_u32, mask: 1_u8, manual: 1_u8, stage: 1_u8), FeatureSpec(tag: 1919707495_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1667329140_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1668049255_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1668641395_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1684632436_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1801810542_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1818847073_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8), FeatureSpec(tag: 1919118452_u32, mask: 1_u8, manual: 0_u8, stage: 1_u8)];

fn script_tag(script: Script) -> result: u32 pure {
  doc "The OpenType script tag HarfBuzz tries first for script: latn, grek, cyrl, and zyyy for Common, which fonts do not list, so that Common selects DFLT.";
  match script {
    Common() => {
      return tag_zyyy;
    }
    Latin() => {
      return tag_latn;
    }
    Greek() => {
      return tag_grek;
    }
    Cyrillic() => {
      return tag_cyrl;
    }
  }
}

fn find_script(layout: &LayoutTable, tag: u32, low: u64, high: u64) -> result: u64 reads(layout) contract {
  requires low <= high;
  requires high <= layout^.scripts.inner.len;
} {
  doc "HarfBuzz's binary search of the script records from low up to high for tag, probing the same records it probes even in an unsorted list; the index found, or no_index.";
  if low >= high {
    return no_index;
  }
  let span = high - low;
  let less = span - 1_u64;
  let half = less / 2_u64;
  let middle = low + half;
  let record = layout^.scripts.inner[middle];
  if tag < record.tag {
    return musttail find_script(layout: layout, tag: tag, low: low, high: middle);
  }
  if tag > record.tag {
    let next = middle + 1_u64;
    return musttail find_script(layout: layout, tag: tag, low: next, high: high);
  }
  return middle;
}

fn select_script(layout: &LayoutTable, tag: u32) -> result: u64 reads(layout) {
  doc "HarfBuzz's hb_ot_layout_table_select_script for one script tag: the record of tag, else of DFLT, else of dflt, else of latn; no_index when none is present.";
  let count = layout^.scripts.inner.len;
  let found = find_script(layout: layout, tag: tag, low: 0_u64, high: count);
  if found != no_index {
    return found;
  }
  let fallback = find_script(layout: layout, tag: tag_upper_dflt, low: 0_u64, high: count);
  if fallback != no_index {
    return fallback;
  }
  let lower = find_script(layout: layout, tag: tag_dflt, low: 0_u64, high: count);
  if lower != no_index {
    return lower;
  }
  let latin = find_script(layout: layout, tag: tag_latn, low: 0_u64, high: count);
  return latin;
}

fn empty_system() -> result: LanguageSystem pure {
  doc "The language system of a missing script: no features and no required feature.";
  let empty = Extent(start: 0_u32, count: 0_u32);
  let system = LanguageSystem(tag: 0_u32, required_feature: 65535_u16, features: empty);
  return system;
}

fn find_system(layout: &LayoutTable, low: u64, high: u64) -> result: u64 reads(layout) contract {
  requires low <= high;
  requires high <= layout^.language_systems.inner.len;
} {
  doc "HarfBuzz's binary search of the language system records from low up to high for dflt; the index found, or no_index.";
  if low >= high {
    return no_index;
  }
  let span = high - low;
  let less = span - 1_u64;
  let half = less / 2_u64;
  let middle = low + half;
  let record = layout^.language_systems.inner[middle];
  if tag_dflt < record.tag {
    return musttail find_system(layout: layout, low: low, high: middle);
  }
  if tag_dflt > record.tag {
    let next = middle + 1_u64;
    return musttail find_system(layout: layout, low: next, high: high);
  }
  return middle;
}

fn select_system(layout: &LayoutTable, script: u64) -> result: LanguageSystem reads(layout) {
  doc "HarfBuzz's language selection with no language: the script's LangSys record tagged dflt when it has one, and its default LangSys otherwise.";
  let count = layout^.scripts.inner.len;
  if script < count {
  } else {
    let empty = empty_system();
    return empty;
  }
  let record = layout^.scripts.inner[script];
  let start = cvt::<u32, u64>(record.systems.start);
  let size = cvt::<u32, u64>(record.systems.count);
  let end = start + size;
  let systems = layout^.language_systems.inner.len;
  if end <= systems {
    let found = find_system(layout: layout, low: start, high: end);
    if found < systems {
      let system = layout^.language_systems.inner[found];
      return system;
    }
  }
  let system = record.default_system;
  return system;
}

fn feature_in(layout: &LayoutTable, system: LanguageSystem, tag: u32) -> result: u64 reads(layout) {
  doc "The index of the first feature of system whose tag is tag, as hb_ot_layout_collect_features_map lets earlier entries win; no_index when there is none.";
  let start = cvt::<u32, u64>(system.features.start);
  let size = cvt::<u32, u64>(system.features.count);
  let listed = layout^.language_features.inner.len;
  let features = layout^.features.inner.len;
  for (step in 0_u64..size) {
    let position = start + step;
    if position < listed {
      let feature = layout^.language_features.inner[position];
      let index = cvt::<u16, u64>(feature);
      if index < features {
        let record = layout^.features.inner[index];
        if record.tag == tag {
          return index;
        }
      }
    }
  }
  return no_index;
}

fn mark_lookups(layout: &LayoutTable, feature: u64, bits: u8, flags: &Box<Array<u8>>) -> result: unit reads(layout), writes(flags) {
  doc "Adds bits to the flags of every lookup of feature, as add_lookups followed by the merge of duplicates does: masks and manual joiners combine, and the present bit marks the lookup.";
  let features = layout^.features.inner.len;
  if feature < features {
  } else {
    return unit;
  }
  let record = layout^.features.inner[feature];
  let start = cvt::<u32, u64>(record.lookups.start);
  let size = cvt::<u32, u64>(record.lookups.count);
  let listed = layout^.feature_lookups.inner.len;
  let marked = ior(bits, planned_present);
  for (step in 0_u64..size) {
    let position = start + step;
    if position < listed {
      let lookup = layout^.feature_lookups.inner[position];
      let index = cvt::<u16, u64>(lookup);
      if index < flags^.inner.len {
        let old = flags^.inner[index];
        let combined = ior(old, marked);
        set flags^.inner[index] = combined;
      }
    }
  }
  return unit;
}

fn feature_bits(spec: FeatureSpec) -> result: u8 pure {
  doc "The flags a lookup of spec's feature receives: its mask bit and, for a feature with manual joiners, both manual bits.";
  if spec.manual != 0_u8 {
    let manual = ior(planned_manual_zwnj, planned_manual_zwj);
    let bits = ior(spec.mask, manual);
    return bits;
  }
  let bits = spec.mask;
  return bits;
}

fn required_stage(layout: &LayoutTable, system: LanguageSystem, substitution: Bool) -> result: u8 reads(layout) {
  doc "The stage HarfBuzz applies a required feature in: the stage of the default feature with its tag, else stage 0; GPOS has one stage.";
  if substitution {
  } else {
    return 0_u8;
  }
  let required = cvt::<u16, u64>(system.required_feature);
  let features = layout^.features.inner.len;
  if required < features {
  } else {
    return 0_u8;
  }
  let record = layout^.features.inner[required];
  for (position in 0_u64..default_feature_count) {
    let spec = default_features[position];
    if spec.tag == record.tag {
      let stage = spec.stage;
      return stage;
    }
  }
  return 0_u8;
}

fn collect_stage(layout: &LayoutTable, system: LanguageSystem, substitution: Bool, stage: u8, lookups: &Box<Slots<PlannedLookup>>, flags: &Box<Array<u8>>) -> result: Result<unit, ShapeError> reads(layout), writes(lookups), writes(flags) {
  doc "Appends to lookups the lookups of one stage in index order, each once with its features' combined mask and joiner flags: the required feature's when it applies in this stage, then those of every default feature of the stage the language system lists. flags is all zero on entry and on return.";
  let required = cvt::<u16, u64>(system.required_feature);
  let required_in = required_stage(layout: layout, system: system, substitution: substitution);
  if required_in == stage {
    mark_lookups(layout: layout, feature: required, bits: mask_global, flags: flags);
  }
  for (position in 0_u64..default_feature_count) {
    let spec = default_features[position];
    let in_stage = if substitution {
      let same = spec.stage == stage;
      give same;
    } else {
      give True();
    }
    if in_stage {
      let feature = feature_in(layout: layout, system: system, tag: spec.tag);
      let bits = feature_bits(spec: spec);
      mark_lookups(layout: layout, feature: feature, bits: bits, flags: flags);
    }
  }
  let count = flags^.inner.len;
  let lookup_total = layout^.lookups.inner.len;
  for (index in 0_u64..count) {
    let flag_bits = flags^.inner[index];
    let present = iand(flag_bits, planned_present);
    if present != 0_u8 {
      set flags^.inner[index] = 0_u8;
      if index < lookup_total {
        let lookup = layout^.lookups.inner[index];
        if lookup.subtables.count != 0_u32 {
          let narrow = cvt.wrap::<u64, u16>(index);
          let mask = iand(flag_bits, mask_bits);
          let manual_zwnj = iand(flag_bits, planned_manual_zwnj);
          let manual_zwj = iand(flag_bits, planned_manual_zwj);
          let auto_zwnj = manual_zwnj == 0_u8;
          let auto_zwj = manual_zwj == 0_u8;
          let planned = PlannedLookup(index: narrow, mask: mask, auto_zwnj: auto_zwnj, auto_zwj: auto_zwj);
          let pushed = propagate push_planned(list: lookups, value: planned);
        }
      }
    }
  }
  return Ok<unit, ShapeError>(value: unit);
}

fn push_planned(list: &Box<Slots<PlannedLookup>>, value: PlannedLookup) -> result: Result<unit, ShapeError> writes(list) {
  doc "Appends value to list, doubling its capacity when it is full; a table has at most 65536 lookups, and each stage lists one at most once.";
  let length = list^.inner.len;
  let capacity = list^.inner.cap;
  if length < capacity {
    place_back(window: &list^.inner, value: value);
    return Ok<unit, ShapeError>(value: unit);
  }
  if length >= 131072_u64 {
    let refusal = ShapeError::TooLarge();
    return Err<unit, ShapeError>(error: refusal);
  }
  let doubled = imax(capacity, 8_u64);
  let wanted = doubled + doubled;
  if wanted <= 131072_u64 {
    grow(cell: list, capacity: wanted);
  } else {
    grow(cell: list, capacity: 131072_u64);
  }
  place_back(window: &list^.inner, value: value);
  return Ok<unit, ShapeError>(value: unit);
}

fn plan_table(layout: &LayoutTable, system: LanguageSystem, substitution: Bool) -> result: Result<Box<Slots<PlannedLookup>>, ShapeError> reads(layout) {
  doc "The lookups of one table in the order HarfBuzz applies them: for GSUB the stage of rvrn and then the stage of every other feature, for GPOS its one stage.";
  let lookup_total = layout^.lookups.inner.len;
  let count = imin(lookup_total, 65536_u64);
  let flags = box_array_filled::<u8>(count: count, value: 0_u8);
  let lookups = box_slots_new::<PlannedLookup>(capacity: 0_u64);
  let first = propagate collect_stage(layout: layout, system: system, substitution: substitution, stage: 0_u8, lookups: &lookups, flags: &flags);
  if substitution {
    let second = propagate collect_stage(layout: layout, system: system, substitution: substitution, stage: 1_u8, lookups: &lookups, flags: &flags);
  }
  return Ok<Box<Slots<PlannedLookup>>, ShapeError>(value: move lookups);
}

fn found_in(substitution: &LayoutTable, gsub: LanguageSystem, positioning: &LayoutTable, gpos: LanguageSystem, tag: u32) -> result: Bool reads(substitution), reads(positioning) {
  doc "Whether either table's language system lists a feature tagged tag, which gives the feature its mask bits.";
  let in_gsub = feature_in(layout: substitution, system: gsub, tag: tag);
  let in_gpos = feature_in(layout: positioning, system: gpos, tag: tag);
  let listed_gsub = in_gsub != no_index;
  let listed_gpos = in_gpos != no_index;
  let either = bor(listed_gsub, listed_gpos);
  return either;
}

fn make_plan(face: &Face, script: Script) -> result: Result<Plan, ShapeError> reads(face) {
  doc "Builds the plan HarfBuzz's map compiles for a horizontal left-to-right run in script with no language and the default features.";
  let tag = script_tag(script: script);
  let gsub_script = select_script(layout: &face^.substitutions, tag: tag);
  let gpos_script = select_script(layout: &face^.positions, tag: tag);
  let gsub = select_system(layout: &face^.substitutions, script: gsub_script);
  let gpos = select_system(layout: &face^.positions, script: gpos_script);
  let substitution_kind = True();
  let positioning_kind = False();
  let substitutions = propagate plan_table(layout: &face^.substitutions, system: gsub, substitution: substitution_kind);
  let positions = propagate plan_table(layout: &face^.positions, system: gpos, substitution: positioning_kind);
  let numr_spec = default_features[4_u64];
  let frac_spec = default_features[3_u64];
  let dnom_spec = default_features[5_u64];
  let has_numr = found_in(substitution: &face^.substitutions, gsub: gsub, positioning: &face^.positions, gpos: gpos, tag: numr_spec.tag);
  let has_frac = found_in(substitution: &face^.substitutions, gsub: gsub, positioning: &face^.positions, gpos: gpos, tag: frac_spec.tag);
  let has_dnom = found_in(substitution: &face^.substitutions, gsub: gsub, positioning: &face^.positions, gpos: gpos, tag: dnom_spec.tag);
  let numr_mask = if has_numr {
    give mask_numr;
  } else {
    give 0_u8;
  }
  let frac_mask = if has_frac {
    give mask_frac;
  } else {
    give 0_u8;
  }
  let dnom_mask = if has_dnom {
    give mask_dnom;
  } else {
    give 0_u8;
  }
  let positioning = face^.positions.present;
  let plan = Plan(substitutions: move substitutions, positions: move positions, numr_mask: numr_mask, frac_mask: frac_mask, dnom_mask: dnom_mask, positioning: positioning);
  return Ok<Plan, ShapeError>(value: move plan);
}
