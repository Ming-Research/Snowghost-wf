  let value_pairs = box_slots_new::<ValuePair>(capacity: 0_u64);
  let mark_attachments = box_slots_new::<MarkAttachment>(capacity: 0_u64);
  let mark_records = box_slots_new::<MarkRecord>(capacity: 0_u64);
  let anchors = box_slots_new::<Option<Anchor>>(capacity: 0_u64);
  let ligature_attachments = box_slots_new::<LigatureAttachment>(capacity: 0_u64);
  let layout = LayoutTable(scripts: move scripts, language_systems: move language_systems, language_features: move language_features, features: move features, feature_lookups: move feature_lookups, lookups: move lookups, subtables: move subtables, coverages: move coverages, coverage_ranges: move coverage_ranges, class_definitions: move class_definitions, class_ranges: move class_ranges, glyphs: move glyphs, classes: move classes, single_substitutions: move single_substitutions, multiple_substitutions: move multiple_substitutions, sequences: move sequences, ligature_substitutions: move ligature_substitutions, ligature_sets: move ligature_sets, ligatures: move ligatures, chained_contexts: move chained_contexts, rule_sets: move rule_sets, chain_rules: move chain_rules, coverage_sequences: move coverage_sequences, sequence_lookups: move sequence_lookups, single_positionings: move single_positionings, value_records: move value_records, pair_positionings: move pair_positionings, pair_sets: move pair_sets, pair_values: move pair_values, value_pairs: move value_pairs, mark_attachments: move mark_attachments, mark_records: move mark_records, anchors: move anchors, ligature_attachments: move ligature_attachments);
  return move layout;
