  let coverages = box_slots_new::<Extent>(capacity: 0_u64);
  let coverage_ranges = box_slots_new::<CoverageRange>(capacity: 0_u64);
  let class_definitions = box_slots_new::<Extent>(capacity: 0_u64);
  let class_ranges = box_slots_new::<ClassRange>(capacity: 0_u64);
  let glyphs = box_slots_new::<u16>(capacity: 0_u64);
  let classes = box_slots_new::<u16>(capacity: 0_u64);
  let single_substitutions = box_slots_new::<SingleSubstitution>(capacity: 0_u64);
  let multiple_substitutions = box_slots_new::<MultipleSubstitution>(capacity: 0_u64);
  let sequences = box_slots_new::<Extent>(capacity: 0_u64);
  let ligature_substitutions = box_slots_new::<LigatureSubstitution>(capacity: 0_u64);
  let ligature_sets = box_slots_new::<Extent>(capacity: 0_u64);
  let ligatures = box_slots_new::<Ligature>(capacity: 0_u64);
  let chained_contexts = box_slots_new::<ChainedContext>(capacity: 0_u64);
  let rule_sets = box_slots_new::<Extent>(capacity: 0_u64);
  let chain_rules = box_slots_new::<ChainRule>(capacity: 0_u64);
  let coverage_sequences = box_slots_new::<u32>(capacity: 0_u64);
  let sequence_lookups = box_slots_new::<SequenceLookup>(capacity: 0_u64);
  let single_positionings = box_slots_new::<SinglePositioning>(capacity: 0_u64);
  let value_records = box_slots_new::<ValueRecord>(capacity: 0_u64);
  let pair_positionings = box_slots_new::<PairPositioning>(capacity: 0_u64);
  let pair_sets = box_slots_new::<Extent>(capacity: 0_u64);
