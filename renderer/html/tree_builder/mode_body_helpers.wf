alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias QuirksMode = pkg::dom::QuirksMode;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn document_quirks_mode(document: &Document) -> result: QuirksMode reads(document) {
  doc "Returns the document's quirks mode, read from its root (node 0).";
  let len = document^.nodes.inner.len;
  let ok = len > 0_u64;
  if ok {
    match &document^.nodes.inner[0_u64].data {
      DocumentRoot(quirks: q) => {
        return q^;
      }
      DocumentType(name: n, public_id: p, system_id: s) => {
        let out = QuirksMode::NoQuirks();
        return out;
      }
      Element(namespace: ns, local_name: ln, attributes: attrs, template_contents: tc) => {
        let out2 = QuirksMode::NoQuirks();
        return out2;
      }
      Text(data: d) => {
        let out3 = QuirksMode::NoQuirks();
        return out3;
      }
      Comment(data: d2) => {
        let out4 = QuirksMode::NoQuirks();
        return out4;
      }
      Fragment() => {
        let out5 = QuirksMode::NoQuirks();
        return out5;
      }
    }
  }
  let out6 = QuirksMode::NoQuirks();
  return out6;
}

fn qm_is_no_quirks(qm: QuirksMode) -> result: Bool pure {
  doc "Tells whether qm is not Quirks (i.e. NoQuirks or LimitedQuirks), as \"the document is not set to quirks mode\" checks (13.2.6.4.7's \"table\" start tag) need: only full quirks mode blocks the p-closing step, not limited quirks.";
  let quirks = QuirksMode::Quirks();
  let is_quirks = eeq(qm, quirks);
  return bnot(is_quirks);
}

const hidden_lit: Array<u8, 6> =[104_u8, 105_u8, 100_u8, 100_u8, 101_u8, 110_u8];

fn token_attr_value_is_hidden(atoms: &AtomTable, tok_text: &TokenText, first: u32, end: u32, attr_id: u32) -> result: Result<Bool, TreeError> reads(tok_text), writes(atoms) {
  doc "Tells whether the token's attributes (first..end) include one named attr_id whose value case-insensitively equals \"hidden\".";
  let first64 = cvt::<u32, u64>(first);
  let end64 = cvt::<u32, u64>(end);
  let attrs_len = tok_text^.attributes.inner.len;
  let idx = first64;
  loop @walk {
    let more = idx < end64;
    if more {
    } else {
      break @walk;
    }
    let in_range = idx < attrs_len;
    if in_range {
    } else {
      break @walk;
    }
    let raw = tok_text^.attributes.inner[idx];
    let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: raw.name);
    let hit = a_is(atom: name_atom, id: attr_id);
    if hit {
      let text_len = tok_text^.text.inner.len;
      let vs = cvt::<u32, u64>(raw.value.start);
      let ve = cvt::<u32, u64>(raw.value.end);
      let ok1 = vs <= ve;
      let ok2 = ve <= text_len;
      let ok = band(ok1, ok2);
      if ok {
        let value_bytes = &tok_text^.text.inner[vs..ve];
        let same = bytes_eq_ascii_ci(a: value_bytes, b: &hidden_lit[0_u64..hidden_lit.len]);
        return Ok<Bool, TreeError>(value: same);
      }
      let bareval1 = False();
      return Ok<Bool, TreeError>(value: bareval1);
    }
    set idx = idx +wrap 1_u64;
  }
  let bareval2 = False();
  return Ok<Bool, TreeError>(value: bareval2);
}

fn insert_body_characters(state: &State, document: &Document, bytes: &[u8]) -> result: Result<unit, TreeError> reads(bytes), writes(state), writes(document) {
  doc "Performs \"in body\"'s (13.2.6.4.7) character-token action on bytes directly: reconstruct the active formatting elements, insert the characters (dropping NUL), and clear frameset-ok if any inserted byte is not whitespace or NUL. Used by \"in head\"/\"after head\" to feed a guaranteed-non-whitespace remainder straight into body, instead of reprocessing the original (whitespace-prefixed) token through the generic mechanism, which would re-insert the already-consumed prefix.";
  let recon = propagate reconstruct_active_formatting_elements(state: state, document: document);
  let small = bytes^.len <= 1073741824_u64;
  if small {
    let ins = propagate insert_characters_dropping_nul(state: state, document: document, bytes: bytes);
  }
  let any_non_ws = bytes_any_non_ws_non_nul(bytes: bytes);
  if any_non_ws {
    set state^.frameset_ok = False();
  }
  return Ok<unit, TreeError>(value: unit);
}

fn mark_pending_lf_skip(state: &State) -> result: unit writes(state) {
  doc "Records that the element just inserted (pre, listing, or textarea) should have one immediately following U+000A LINE FEED ignored, as an authoring convenience.";
  set state^.pending_lf_skip = True();
  return unit;
}

fn strip_pending_leading_lf(state: &State, bytes: &[u8]) -> (start: u64, consumed: Bool) reads(bytes), writes(state) {
  doc "If pending_lf_skip is set, clears it and, when bytes starts with LF, returns 1 as the start offset to skip that byte; otherwise returns 0.";
  let pending = state^.pending_lf_skip;
  set state^.pending_lf_skip = False();
  if pending {
    let has_byte = bytes^.len > 0_u64;
    if has_byte {
      let first = bytes^[0_u64];
      let is_lf = first == 10_u8;
      if is_lf {
        return 1_u64, True();
      }
    }
  }
  return 0_u64, False();
}

fn in_body_li(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, kw: &Keywords, span: Span, first_attribute: u32, end_attribute: u32) -> result: Result<unit, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms) {
  doc "13.2.6.4.7 start tag \"li\".";
  set state^.frameset_ok = False();
  let len = open_len(state: state);
  let has = len > 0_u64;
  if has {
    let idx = len -wrap 1_u64;
    loop @walk (
      invariant bound: idx < len
    ) {
      let elem = open_at(state: state, index: idx);
      let html = ns_is_html(namespace: elem.namespace);
      let is_li = a_is(atom: elem.local_name, id: atom_li);
      let hit = band(html, is_li);
      if hit {
        generate_implied_end_tags_except(state: state, kw: kw, except: elem.local_name);
        pop_until_html_tag(state: state, id: atom_li);
        break @walk;
      }
      let special = is_special(namespace: elem.namespace, local_name: elem.local_name, kw: kw);
      let is_addr = a_is(atom: elem.local_name, id: atom_address);
      let is_div = a_is(atom: elem.local_name, id: atom_div);
      let is_p = a_is(atom: elem.local_name, id: atom_p);
      let is_apdh1 = bor(is_div, is_p);
      let is_apd = bor(is_addr, is_apdh1);
      let not_apd = bnot(is_apd);
      let stop = band(special, not_apd);
      if stop {
        break @walk;
      }
      let can_go_up = idx > 0_u64;
      if can_go_up {
        set idx = idx - 1_u64;
      } else {
        break @walk;
      }
    }
  }
  close_p_if_in_button_scope(state: state, kw: kw);
  let node = propagate insert_html_element_span(state: state, document: document, atoms: atoms, tok_text: tok_text, span: span, first_attribute: first_attribute, end_attribute: end_attribute);
  return Ok<unit, TreeError>(value: unit);
}

fn in_body_dd_dt(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, kw: &Keywords, span: Span, first_attribute: u32, end_attribute: u32, is_dd: Bool) -> result: Result<unit, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms) {
  doc "13.2.6.4.7 start tag \"dd\"/\"dt\".";
  set state^.frameset_ok = False();
  let len = open_len(state: state);
  let has = len > 0_u64;
  if has {
    let idx = len -wrap 1_u64;
    loop @walk (
      invariant bound: idx < len
    ) {
      let elem = open_at(state: state, index: idx);
      let html = ns_is_html(namespace: elem.namespace);
      let is_dd_e = a_is(atom: elem.local_name, id: atom_dd);
      let is_dt_e = a_is(atom: elem.local_name, id: atom_dt);
      let hit_dd = band(html, is_dd_e);
      let hit_dt = band(html, is_dt_e);
      if hit_dd {
        generate_implied_end_tags_except(state: state, kw: kw, except: elem.local_name);
        pop_until_html_tag(state: state, id: atom_dd);
        break @walk;
      }
      if hit_dt {
        generate_implied_end_tags_except(state: state, kw: kw, except: elem.local_name);
        pop_until_html_tag(state: state, id: atom_dt);
        break @walk;
      }
      let special = is_special(namespace: elem.namespace, local_name: elem.local_name, kw: kw);
      let is_addr = a_is(atom: elem.local_name, id: atom_address);
      let is_div = a_is(atom: elem.local_name, id: atom_div);
      let is_p = a_is(atom: elem.local_name, id: atom_p);
      let is_apdh1 = bor(is_div, is_p);
      let is_apd = bor(is_addr, is_apdh1);
      let not_apd = bnot(is_apd);
      let stop = band(special, not_apd);
      if stop {
        break @walk;
      }
      let can_go_up = idx > 0_u64;
      if can_go_up {
        set idx = idx - 1_u64;
      } else {
        break @walk;
      }
    }
  }
  close_p_if_in_button_scope(state: state, kw: kw);
  let node = propagate insert_html_element_span(state: state, document: document, atoms: atoms, tok_text: tok_text, span: span, first_attribute: first_attribute, end_attribute: end_attribute);
  return Ok<unit, TreeError>(value: unit);
}
