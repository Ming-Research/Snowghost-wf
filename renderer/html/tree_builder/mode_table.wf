alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn clear_stack_to_table_context(state: &State) -> result: unit writes(state) {
  doc "13.2.6.4.9: pops elements while the current node is not table, template, or html.";
  loop @walk {
    let cur = current_entry(state: state);
    match cur {
      None() => {
        break @walk;
      }
      Some(value: c) => {
        let html = ns_is_html(namespace: c.namespace);
        if html {
          let a = a_is(atom: c.local_name, id: atom_table);
          let b = a_is(atom: c.local_name, id: atom_template);
          let c2 = a_is(atom: c.local_name, id: atom_html);
          let stop_a = bor(a, b);
          let stop = bor(stop_a, c2);
          if stop {
            break @walk;
          }
        }
        pop_open_if_any(state: state);
      }
    }
  }
  return unit;
}

fn mode_in_table(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.9 \"in table\".";
  match token {
    Characters(data: d) => {
      let cur = current_entry(state: state);
      let in_ctx = match cur {
        Some(value: c) => {
          let html = ns_is_html(namespace: c.namespace);
          let a = a_is(atom: c.local_name, id: atom_table);
          let b = a_is(atom: c.local_name, id: atom_tbody);
          let c2 = a_is(atom: c.local_name, id: atom_template);
          let d2 = a_is(atom: c.local_name, id: atom_tfoot);
          let e2 = a_is(atom: c.local_name, id: atom_thead);
          let f2 = a_is(atom: c.local_name, id: atom_tr);
          let g1 = bor4(a: a, b: b, c: c2, d: d2);
          let g2 = bor(e2, f2);
          let any_hit = bor(g1, g2);
          let out = band(html, any_hit);
          give out;
        }
        None() => {
          give False();
        }
      }
      if in_ctx {
        let out2 = box_slots_new::<u8>(capacity: 0_u64);
        set state^.pending_table_text = move out2;
        set state^.pending_table_all_whitespace = True();
        save_original_mode(state: state);
        set_mode_in_table_text(state: state);
        let r0 = True();
        return Ok<Bool, TreeError>(value: r0);
      }
      let r1 = propagate in_table_anything_else(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: r1);
    }
    Comment(data: d2) => {
      let ins = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r3 = False();
      return Ok<Bool, TreeError>(value: r3);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: n2);
      let is_caption = a_is(atom: name_atom, id: atom_caption);
      if is_caption {
        clear_stack_to_table_context(state: state);
        let marked = propagate afe_push_marker(state: state);
        let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        set_mode_in_caption(state: state);
        let r4 = False();
        return Ok<Bool, TreeError>(value: r4);
      }
      let is_colgroup = a_is(atom: name_atom, id: atom_colgroup);
      if is_colgroup {
        clear_stack_to_table_context(state: state);
        let node2 = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        set_mode_in_column_group(state: state);
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let is_col = a_is(atom: name_atom, id: atom_col);
      if is_col {
        clear_stack_to_table_context(state: state);
        let colgroup_atom = Atom(index: atom_colgroup);
        let node3 = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: colgroup_atom);
        set_mode_in_column_group(state: state);
        let r6 = True();
        return Ok<Bool, TreeError>(value: r6);
      }
      let is_tbody = a_is(atom: name_atom, id: atom_tbody);
      let is_thead = a_is(atom: name_atom, id: atom_thead);
      let is_tfoot = a_is(atom: name_atom, id: atom_tfoot);
      let is_tbg1 = bor(is_tbody, is_thead);
      let is_tbg = bor(is_tbg1, is_tfoot);
      if is_tbg {
        clear_stack_to_table_context(state: state);
        let node4 = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        set_mode_in_table_body(state: state);
        let r7 = False();
        return Ok<Bool, TreeError>(value: r7);
      }
      let is_td = a_is(atom: name_atom, id: atom_td);
      let is_th = a_is(atom: name_atom, id: atom_th);
      let is_tr = a_is(atom: name_atom, id: atom_tr);
      let is_rowg1 = bor(is_td, is_th);
      let is_rowg = bor(is_rowg1, is_tr);
      if is_rowg {
        clear_stack_to_table_context(state: state);
        let tbody_atom = Atom(index: atom_tbody);
        let node5 = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: tbody_atom);
        set_mode_in_table_body(state: state);
        let r8 = True();
        return Ok<Bool, TreeError>(value: r8);
      }
      let is_table = a_is(atom: name_atom, id: atom_table);
      if is_table {
        let table_kind1 = ScopeKind::Table();
        let has_tbl = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_table, kind: table_kind1);
        if has_tbl {
          pop_until_html_tag(state: state, id: atom_table);
          reset_insertion_mode(state: state, kw: kw);
          let r9 = True();
          return Ok<Bool, TreeError>(value: r9);
        }
        let r10 = False();
        return Ok<Bool, TreeError>(value: r10);
      }
      let is_style = a_is(atom: name_atom, id: atom_style);
      let is_script = a_is(atom: name_atom, id: atom_script);
      let is_template = a_is(atom: name_atom, id: atom_template);
      let is_head1 = bor(is_style, is_script);
      let is_headlike = bor(is_head1, is_template);
      if is_headlike {
        let processed = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r11 = False();
        return Ok<Bool, TreeError>(value: r11);
      }
      let is_input = a_is(atom: name_atom, id: atom_input);
      if is_input {
        let is_hidden = propagate token_attr_value_is_hidden(atoms: atoms, tok_text: tok_text, first: fa, end: ea, attr_id: atom_type);
        if is_hidden {
          let node6 = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
          pop_open_if_any(state: state);
          let r12 = False();
          return Ok<Bool, TreeError>(value: r12);
        }
        let r13 = propagate in_table_anything_else(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        return Ok<Bool, TreeError>(value: r13);
      }
      let is_form = a_is(atom: name_atom, id: atom_form);
      if is_form {
        let in_template = state^.template_modes.inner.len > 0_u64;
        let has_form_ptr = match state^.form_pointer {
          Some(value: fp) => {
            give True();
          }
          None() => {
            give False();
          }
        }
        let blocked_a = bor(in_template, has_form_ptr);
        if blocked_a {
          let r14 = False();
          return Ok<Bool, TreeError>(value: r14);
        }
        let node7 = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        if in_template {
        } else {
          let some_form = Some<NodeId>(value: node7);
          set state^.form_pointer = some_form;
        }
        pop_open_if_any(state: state);
        let r15 = False();
        return Ok<Bool, TreeError>(value: r15);
      }
      let r16 = propagate in_table_anything_else(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: r16);
    }
    EndTag(name: n3) => {
      let is_table_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_table);
      if is_table_end {
        let table_kind2 = ScopeKind::Table();
        let has_tbl2 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_table, kind: table_kind2);
        if has_tbl2 {
          pop_until_html_tag(state: state, id: atom_table);
          reset_insertion_mode(state: state, kw: kw);
        }
        let r17 = False();
        return Ok<Bool, TreeError>(value: r17);
      }
      let is_ignored = propagate end_tag_is_table_junk(atoms: atoms, text: tok_text, span: n3);
      if is_ignored {
        let r18 = False();
        return Ok<Bool, TreeError>(value: r18);
      }
      let is_template_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_template);
      if is_template_end {
        let processed2 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r19 = False();
        return Ok<Bool, TreeError>(value: r19);
      }
      let r20 = propagate in_table_anything_else(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: r20);
    }
    EndOfFile() => {
      let processed3 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed3);
    }
  }
}

fn end_tag_is_table_junk(atoms: &AtomTable, text: &TokenText, span: Span) -> result: Result<Bool, TreeError> reads(text), writes(atoms) {
  doc "body, caption, col, colgroup, html, tbody, td, tfoot, th, thead, tr: end tags ignored in \"in table\".";
  let name_atom = propagate intern_span(atoms: atoms, text: text, span: span);
  let a = a_is(atom: name_atom, id: atom_body);
  let b = a_is(atom: name_atom, id: atom_caption);
  let c = a_is(atom: name_atom, id: atom_col);
  let d = a_is(atom: name_atom, id: atom_colgroup);
  let e = a_is(atom: name_atom, id: atom_html);
  let f = a_is(atom: name_atom, id: atom_tbody);
  let g = a_is(atom: name_atom, id: atom_td);
  let h = a_is(atom: name_atom, id: atom_tfoot);
  let g1 = bor8(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h);
  let i = a_is(atom: name_atom, id: atom_th);
  let j = a_is(atom: name_atom, id: atom_thead);
  let k = a_is(atom: name_atom, id: atom_tr);
  let g2a = bor(i, j);
  let g2 = bor(g2a, k);
  let out = bor(g1, g2);
  return Ok<Bool, TreeError>(value: out);
}

fn in_table_anything_else(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.9's \"anything else\": foster parenting on, process using in body rules, foster parenting off.";
  set state^.foster_parenting = True();
  let processed = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
  set state^.foster_parenting = False();
  return Ok<Bool, TreeError>(value: processed);
}

fn mode_in_table_text(state: &State, document: &Document, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), writes(state), writes(document) {
  doc "13.2.6.4.10 \"in table text\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let small = bytes^.len <= 1073741824_u64;
      if small {
        let i = 0_u64;
        let blen = bytes^.len;
        loop @copy {
          let more = i < blen;
          if more {
          } else {
            break @copy;
          }
          let b = bytes^[i];
          let is_nul = b == 0_u8;
          if is_nul {
          } else {
            let pushed = propagate push_generic::<u8>(cell: &state^.pending_table_text, value: b, ceiling: 1073741824_u64);
            let is_ws = is_html_ws(byte: b);
            if is_ws {
            } else {
              set state^.pending_table_all_whitespace = False();
            }
          }
          set i = i +wrap 1_u64;
        }
      }
      let r0 = False();
      return Ok<Bool, TreeError>(value: r0);
    }
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let r1 = propagate in_table_text_flush(state: state, document: document);
      return Ok<Bool, TreeError>(value: r1);
    }
    EndTag(name: n2) => {
      let r2 = propagate in_table_text_flush(state: state, document: document);
      return Ok<Bool, TreeError>(value: r2);
    }
    Comment(data: d2) => {
      let r3 = propagate in_table_text_flush(state: state, document: document);
      return Ok<Bool, TreeError>(value: r3);
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      let r4 = propagate in_table_text_flush(state: state, document: document);
      return Ok<Bool, TreeError>(value: r4);
    }
    EndOfFile() => {
      let r5 = propagate in_table_text_flush(state: state, document: document);
      return Ok<Bool, TreeError>(value: r5);
    }
  }
}

fn in_table_text_flush(state: &State, document: &Document) -> result: Result<Bool, TreeError> writes(state), writes(document) {
  doc "13.2.6.4.10's \"anything else\": either foster-insert the pending characters (if not all whitespace, via in table's rules) or insert them plainly, then switch back to the original mode and reprocess.";
  let all_ws = state^.pending_table_all_whitespace;
  let len = state^.pending_table_text.inner.len;
  let ok = len <= 1073741824_u64;
  if ok {
    let bytes = &state^.pending_table_text.inner[0_u64..len];
    let has_content = len > 0_u64;
    if has_content {
      if all_ws {
        let ins = propagate insert_characters_current(state: state, document: document, bytes: bytes);
      } else {
        set state^.foster_parenting = True();
        let ins2 = propagate insert_characters_current(state: state, document: document, bytes: bytes);
        set state^.foster_parenting = False();
      }
    }
  }
  let fresh = box_slots_new::<u8>(capacity: 0_u64);
  set state^.pending_table_text = move fresh;
  set state^.pending_table_all_whitespace = True();
  restore_original_mode(state: state);
  let bareval1 = True();
  return Ok<Bool, TreeError>(value: bareval1);
}
