alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn clear_stack_to_table_body_context(state: &State) -> result: unit writes(state) {
  doc "13.2.6.4.13: pops elements while the current node is not tbody, tfoot, thead, template, or html.";
  loop @walk {
    let cur = current_entry(state: state);
    match cur {
      None() => {
        break @walk;
      }
      Some(value: c) => {
        let html = ns_is_html(namespace: c.namespace);
        if html {
          let a = a_is(atom: c.local_name, id: atom_tbody);
          let b = a_is(atom: c.local_name, id: atom_tfoot);
          let c2 = a_is(atom: c.local_name, id: atom_thead);
          let d = a_is(atom: c.local_name, id: atom_template);
          let e = a_is(atom: c.local_name, id: atom_html);
          let g1 = bor4(a: a, b: b, c: c2, d: d);
          let stop = bor(g1, e);
          if stop {
            break @walk;
          }
        }
        pop_open_if_any(state: state);
      }
    }
  }
  return unit;
}

fn clear_stack_to_table_row_context(state: &State) -> result: unit writes(state) {
  doc "13.2.6.4.14: pops elements while the current node is not tr, template, or html.";
  loop @walk {
    let cur = current_entry(state: state);
    match cur {
      None() => {
        break @walk;
      }
      Some(value: c) => {
        let html = ns_is_html(namespace: c.namespace);
        if html {
          let a = a_is(atom: c.local_name, id: atom_tr);
          let b = a_is(atom: c.local_name, id: atom_template);
          let c2 = a_is(atom: c.local_name, id: atom_html);
          let g1 = bor(a, b);
          let stop = bor(g1, c2);
          if stop {
            break @walk;
          }
        }
        pop_open_if_any(state: state);
      }
    }
  }
  return unit;
}

fn mode_in_table_body(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.13 \"in table body\".";
  match token {
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_tr = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tr);
      if is_tr {
        clear_stack_to_table_body_context(state: state);
        let tr_atom = Atom(index: atom_tr);
        let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: tr_atom, first_attribute: fa, end_attribute: ea);
        set_mode_in_row(state: state);
        let r0 = False();
        return Ok<Bool, TreeError>(value: r0);
      }
      let is_td = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_td);
      let is_th = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_th);
      let is_cell = bor(is_td, is_th);
      if is_cell {
        clear_stack_to_table_body_context(state: state);
        let tr_atom2 = Atom(index: atom_tr);
        let node2 = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: tr_atom2);
        set_mode_in_row(state: state);
        let r1 = True();
        return Ok<Bool, TreeError>(value: r1);
      }
      let is_junk = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n, id1: atom_caption, id2: atom_col, id3: atom_colgroup, id4: atom_tbody);
      let is_junk2a = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tfoot);
      let is_junk2b = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_thead);
      let g1 = bor(is_junk2a, is_junk2b);
      let is_junk_all = bor(is_junk, g1);
      if is_junk_all {
        let body_kind = ScopeKind::Table();
        let has_tbody = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tbody, kind: body_kind);
        let thead_kind = ScopeKind::Table();
        let has_thead = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_thead, kind: thead_kind);
        let tfoot_kind = ScopeKind::Table();
        let has_tfoot = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tfoot, kind: tfoot_kind);
        let g2 = bor(has_tbody, has_thead);
        let has_any = bor(g2, has_tfoot);
        if has_any {
          clear_stack_to_table_body_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table(state: state);
          let r2 = True();
          return Ok<Bool, TreeError>(value: r2);
        }
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let outcome = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome);
    }
    EndTag(name: n2) => {
      let is_bgrp = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_tbody, id2: atom_tfoot, id3: atom_thead, id4: atom_thead);
      if is_bgrp {
        let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: n2);
        let bgrp_kind = ScopeKind::Table();
        let ictor1 = Namespace::Html();
        let has_it = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor1, target_name: name_atom, kind: bgrp_kind);
        if has_it {
          clear_stack_to_table_body_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table(state: state);
        }
        let r4 = False();
        return Ok<Bool, TreeError>(value: r4);
      }
      let is_table_end = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_table);
      if is_table_end {
        let body_kind2 = ScopeKind::Table();
        let has_tbody2 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tbody, kind: body_kind2);
        let thead_kind2 = ScopeKind::Table();
        let has_thead2 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_thead, kind: thead_kind2);
        let tfoot_kind2 = ScopeKind::Table();
        let has_tfoot2 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tfoot, kind: tfoot_kind2);
        let g3 = bor(has_tbody2, has_thead2);
        let has_any2 = bor(g3, has_tfoot2);
        if has_any2 {
          clear_stack_to_table_body_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table(state: state);
          let r5 = True();
          return Ok<Bool, TreeError>(value: r5);
        }
        let r6 = False();
        return Ok<Bool, TreeError>(value: r6);
      }
      let is_ignored = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_body, id2: atom_caption, id3: atom_col, id4: atom_colgroup);
      let is_ignored2a = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      let is_ignored2b = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_td);
      let is_ignored2c = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_th);
      let is_ignored2d = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_tr);
      let g4 = bor4(a: is_ignored2a, b: is_ignored2b, c: is_ignored2c, d: is_ignored2d);
      let ig = bor(is_ignored, g4);
      if ig {
        let r7 = False();
        return Ok<Bool, TreeError>(value: r7);
      }
      let outcome2 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome2);
    }
    Characters(data: d) => {
      let outcome3 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome3);
    }
    Comment(data: d2) => {
      let outcome4 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome4);
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      let outcome5 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome5);
    }
    EndOfFile() => {
      let outcome6 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome6);
    }
  }
}

fn mode_in_row(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.14 \"in row\".";
  match token {
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_td = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_td);
      let is_th = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_th);
      let is_cell = bor(is_td, is_th);
      if is_cell {
        clear_stack_to_table_row_context(state: state);
        let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: n);
        let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        set_mode_in_cell(state: state);
        let marked = propagate afe_push_marker(state: state);
        let r0 = False();
        return Ok<Bool, TreeError>(value: r0);
      }
      let is_junk = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n, id1: atom_caption, id2: atom_col, id3: atom_colgroup, id4: atom_tbody);
      let is_junk2a = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tfoot);
      let is_junk2b = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_thead);
      let is_junk2c = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tr);
      let g1 = bor(is_junk2a, is_junk2b);
      let g2 = bor(g1, is_junk2c);
      let is_junk_all = bor(is_junk, g2);
      if is_junk_all {
        let tr_kind = ScopeKind::Table();
        let has_tr = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tr, kind: tr_kind);
        if has_tr {
          clear_stack_to_table_row_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table_body(state: state);
          let r1 = True();
          return Ok<Bool, TreeError>(value: r1);
        }
        let r2 = False();
        return Ok<Bool, TreeError>(value: r2);
      }
      let outcome = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome);
    }
    EndTag(name: n2) => {
      let is_tr_end = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_tr);
      if is_tr_end {
        let tr_kind2 = ScopeKind::Table();
        let has_tr2 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tr, kind: tr_kind2);
        if has_tr2 {
          clear_stack_to_table_row_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table_body(state: state);
        }
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let is_table_end = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_table);
      if is_table_end {
        let tr_kind3 = ScopeKind::Table();
        let has_tr3 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tr, kind: tr_kind3);
        if has_tr3 {
          clear_stack_to_table_row_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table_body(state: state);
          let r4 = True();
          return Ok<Bool, TreeError>(value: r4);
        }
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let is_bgrp = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_tbody, id2: atom_tfoot, id3: atom_thead, id4: atom_thead);
      if is_bgrp {
        let name_atom2 = propagate intern_span(atoms: atoms, text: tok_text, span: n2);
        let bgrp_kind = ScopeKind::Table();
        let ictor2 = Namespace::Html();
        let has_it = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor2, target_name: name_atom2, kind: bgrp_kind);
        let tr_kind4 = ScopeKind::Table();
        let has_tr4 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_tr, kind: tr_kind4);
        let both = band(has_it, has_tr4);
        if both {
          clear_stack_to_table_row_context(state: state);
          pop_open_if_any(state: state);
          set_mode_in_table_body(state: state);
          let r6 = True();
          return Ok<Bool, TreeError>(value: r6);
        }
        let r7 = False();
        return Ok<Bool, TreeError>(value: r7);
      }
      let is_ignored = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_body, id2: atom_caption, id3: atom_col, id4: atom_colgroup);
      let is_ignored2a = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      let is_ignored2b = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_td);
      let is_ignored2c = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_th);
      let g3 = bor(is_ignored2a, is_ignored2b);
      let g4 = bor(g3, is_ignored2c);
      let ig = bor(is_ignored, g4);
      if ig {
        let r8 = False();
        return Ok<Bool, TreeError>(value: r8);
      }
      let outcome2 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome2);
    }
    Characters(data: d) => {
      let outcome3 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome3);
    }
    Comment(data: d2) => {
      let outcome4 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome4);
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      let outcome5 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome5);
    }
    EndOfFile() => {
      let outcome6 = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome6);
    }
  }
}

fn mode_in_cell(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.15 \"in cell\".";
  match token {
    EndTag(name: n) => {
      let is_td = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_td);
      let is_th = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_th);
      let is_cell = bor(is_td, is_th);
      if is_cell {
        let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: n);
        let cell_kind = ScopeKind::Table();
        let ictor3 = Namespace::Html();
        let has_it = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor3, target_name: name_atom, kind: cell_kind);
        if has_it {
          generate_implied_end_tags(state: state, kw: kw);
          pop_until_html_tag(state: state, id: name_atom.index);
          afe_clear_to_last_marker(state: state);
          set_mode_in_row(state: state);
        }
        let r0 = False();
        return Ok<Bool, TreeError>(value: r0);
      }
      let is_ignored = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n, id1: atom_body, id2: atom_caption, id3: atom_col, id4: atom_colgroup);
      let is_ignored2 = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_html);
      let ig = bor(is_ignored, is_ignored2);
      if ig {
        let r1 = False();
        return Ok<Bool, TreeError>(value: r1);
      }
      let is_close_group = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n, id1: atom_table, id2: atom_tbody, id3: atom_tfoot, id4: atom_thead);
      let is_close_group2 = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tr);
      let cg = bor(is_close_group, is_close_group2);
      if cg {
        let name_atom2 = propagate intern_span(atoms: atoms, text: tok_text, span: n);
        let cg_kind = ScopeKind::Table();
        let ictor4 = Namespace::Html();
        let has_it2 = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor4, target_name: name_atom2, kind: cg_kind);
        if has_it2 {
          let closed = propagate in_cell_close(state: state, kw: kw);
          let r2 = True();
          return Ok<Bool, TreeError>(value: r2);
        }
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let processed = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_group = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_caption, id2: atom_col, id3: atom_colgroup, id4: atom_tbody);
      let is_group2a = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_td);
      let is_group2b = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_tfoot);
      let is_group2c = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_th);
      let is_group2d = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_thead);
      let g1 = bor4(a: is_group2a, b: is_group2b, c: is_group2c, d: is_group2d);
      let is_group2e = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_tr);
      let g2 = bor(g1, is_group2e);
      let all_group = bor(is_group, g2);
      if all_group {
        let td_kind = ScopeKind::Table();
        let has_td = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_td, kind: td_kind);
        let th_kind = ScopeKind::Table();
        let has_th = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_th, kind: th_kind);
        let has_either = bor(has_td, has_th);
        if has_either {
          let closed2 = propagate in_cell_close(state: state, kw: kw);
          let r4 = True();
          return Ok<Bool, TreeError>(value: r4);
        }
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let outcome = propagate in_body_start_tag(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token, span: n2, first_attribute: fa, end_attribute: ea, self_closing: sc);
      return Ok<Bool, TreeError>(value: outcome);
    }
    Characters(data: d) => {
      let outcome2 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome2);
    }
    Comment(data: d2) => {
      let outcome3 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome3);
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      let outcome4 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome4);
    }
    EndOfFile() => {
      let outcome5 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome5);
    }
  }
}

fn in_cell_close(state: &State, kw: &Keywords) -> result: Result<unit, TreeError> reads(kw), writes(state) {
  doc "13.2.6.4.15's \"close the cell\": generate implied end tags (a current node that is then not td or th is only a parse error, not a reason to skip the pop), pop elements until a td or th element has been popped regardless of what the current node now is, clear AFE to last marker, switch to in row.";
  generate_implied_end_tags(state: state, kw: kw);
  loop @pop {
    let len = open_len(state: state);
    let has = len > 0_u64;
    if has {
    } else {
      break @pop;
    }
    let idx = len -wrap 1_u64;
    invariant idx_bound: idx < len;
    let elem = open_at(state: state, index: idx);
    pop_open(state: state);
    let html = ns_is_html(namespace: elem.namespace);
    if html {
      let is_td = a_is(atom: elem.local_name, id: atom_td);
      let is_th = a_is(atom: elem.local_name, id: atom_th);
      let is_cell = bor(is_td, is_th);
      if is_cell {
        break @pop;
      }
    }
  }
  afe_clear_to_last_marker(state: state);
  set_mode_in_row(state: state);
  return Ok<unit, TreeError>(value: unit);
}
