alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn token_is_characters(token: Token) -> result: Bool pure {
  doc "Tells whether token is a Characters token.";
  match token {
    Characters(data: d) => {
      return True();
    }
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      return False();
    }
    EndTag(name: n2) => {
      return False();
    }
    Comment(data: d2) => {
      return False();
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      return False();
    }
    EndOfFile() => {
      return False();
    }
  }
}

fn token_is_start_tag(token: Token) -> result: Bool pure {
  doc "Tells whether token is a StartTag token.";
  match token {
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      return True();
    }
    Characters(data: d) => {
      return False();
    }
    EndTag(name: n2) => {
      return False();
    }
    Comment(data: d2) => {
      return False();
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      return False();
    }
    EndOfFile() => {
      return False();
    }
  }
}

fn token_is_eof(token: Token) -> result: Bool pure {
  doc "Tells whether token is the end-of-file token.";
  match token {
    EndOfFile() => {
      return True();
    }
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      return False();
    }
    EndTag(name: n2) => {
      return False();
    }
    Comment(data: d2) => {
      return False();
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      return False();
    }
    Characters(data: d3) => {
      return False();
    }
  }
}

fn is_annotation_xml_mathml(namespace: Namespace, local_name: Atom) -> result: Bool pure {
  doc "Tells whether namespace/local_name name a MathML annotation-xml element.";
  let mathml = ns_is_mathml(namespace: namespace);
  if mathml {
    let out = a_is(atom: local_name, id: atom_annotation_xml);
    return out;
  }
  return False();
}

fn should_dispatch_as_html(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(state), reads(document), reads(tok_text), writes(atoms) {
  doc "13.2.6.1: the tree construction dispatcher's condition list. True routes token through the current insertion mode's HTML-content rules; False routes it through the rules for parsing tokens in foreign content.";
  let is_eof = token_is_eof(token: token);
  if is_eof {
    let bareval1 = True();
    return Ok<Bool, TreeError>(value: bareval1);
  }
  let len = open_len(state: state);
  let stack_empty = len == 0_u64;
  if stack_empty {
    let bareval2 = True();
    return Ok<Bool, TreeError>(value: bareval2);
  }
  let acn = adjusted_current_node(state: state);
  match acn {
    None() => {
      let bareval3 = True();
      return Ok<Bool, TreeError>(value: bareval3);
    }
    Some(value: elem) => {
      let html = ns_is_html(namespace: elem.namespace);
      if html {
        let bareval4 = True();
        return Ok<Bool, TreeError>(value: bareval4);
      }
      let is_chars = token_is_characters(token: token);
      let is_start = token_is_start_tag(token: token);
      let mtip = is_mathml_text_integration_point(namespace: elem.namespace, local_name: elem.local_name);
      let mtip_chars = band(mtip, is_chars);
      if mtip_chars {
        let bareval5 = True();
        return Ok<Bool, TreeError>(value: bareval5);
      }
      let mtip_start = band(mtip, is_start);
      if mtip_start {
        let sn = token_start_tag_name(token: token);
        let is_mglyph = propagate tag_is(atoms: atoms, text: tok_text, span: sn, id: atom_mglyph);
        let is_malignmark = propagate tag_is(atoms: atoms, text: tok_text, span: sn, id: atom_malignmark);
        let is_breakout_name = bor(is_mglyph, is_malignmark);
        if is_breakout_name {
          let bareval6 = False();
          return Ok<Bool, TreeError>(value: bareval6);
        }
        let bareval7 = True();
        return Ok<Bool, TreeError>(value: bareval7);
      }
      let axml = is_annotation_xml_mathml(namespace: elem.namespace, local_name: elem.local_name);
      let axml_start = band(axml, is_start);
      if axml_start {
        let sn2 = token_start_tag_name(token: token);
        let is_svg_tag = propagate tag_is(atoms: atoms, text: tok_text, span: sn2, id: atom_svg);
        if is_svg_tag {
          let bareval8 = True();
          return Ok<Bool, TreeError>(value: bareval8);
        }
      }
      let hip = is_html_integration_point(document: document, namespace: elem.namespace, local_name: elem.local_name, node: elem.node);
      let hip_relevant = bor(is_start, is_chars);
      let hip_hit = band(hip, hip_relevant);
      if hip_hit {
        let bareval9 = True();
        return Ok<Bool, TreeError>(value: bareval9);
      }
      let bareval10 = False();
      return Ok<Bool, TreeError>(value: bareval10);
    }
  }
}

fn dispatch_html_content(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4: dispatches token to the mode_* function for the current insertion mode, and returns whether the caller must reprocess the same token.";
  let mode = state^.mode;
  match mode {
    Initial() => {
      let out = propagate mode_initial(state: state, document: document, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    BeforeHtml() => {
      let out = propagate mode_before_html(state: state, document: document, atoms: atoms, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    BeforeHead() => {
      let out = propagate mode_before_head(state: state, document: document, atoms: atoms, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InHead() => {
      let out = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InHeadNoscript() => {
      let out = propagate mode_in_head_noscript(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    AfterHead() => {
      let out = propagate mode_after_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InBody() => {
      let out = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    Text() => {
      let out = propagate mode_text(state: state, document: document, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InTable() => {
      let out = propagate mode_in_table(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InTableText() => {
      let out = propagate mode_in_table_text(state: state, document: document, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InCaption() => {
      let out = propagate mode_in_caption(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InColumnGroup() => {
      let out = propagate mode_in_column_group(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InTableBody() => {
      let out = propagate mode_in_table_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InRow() => {
      let out = propagate mode_in_row(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InCell() => {
      let out = propagate mode_in_cell(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InTemplate() => {
      let out = propagate mode_in_template(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    AfterBody() => {
      let out = propagate mode_after_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    InFrameset() => {
      let out = propagate mode_in_frameset(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    AfterFrameset() => {
      let out = propagate mode_after_frameset(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    AfterAfterBody() => {
      let out = propagate mode_after_after_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
    AfterAfterFrameset() => {
      let out = propagate mode_after_after_frameset(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: out);
    }
  }
}

fn process_token(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<unit, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.1's tree construction dispatcher, reprocessing token until the chosen mode (HTML-content or foreign-content) reports it fully consumed.";
  loop @reprocess {
    let as_html = propagate should_dispatch_as_html(state: state, document: document, atoms: atoms, tok_text: tok_text, token: token);
    if as_html {
      let again = propagate dispatch_html_content(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      if again {
      } else {
        break @reprocess;
      }
    } else {
      let acn2 = adjusted_current_node(state: state);
      let ns = match acn2 {
        Some(value: e2) => {
          give e2.namespace;
        }
        None() => {
          give Namespace::Html();
        }
      }
      let again2 = propagate process_foreign_content(state: state, document: document, atoms: atoms, tokenizer: tokenizer, tok_text: tok_text, kw: kw, token: token, current_namespace: ns);
      if again2 {
      } else {
        break @reprocess;
      }
    }
  }
  return Ok<unit, TreeError>(value: unit);
}
