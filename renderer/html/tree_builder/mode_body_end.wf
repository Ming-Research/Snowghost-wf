alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Span = pkg::html::tokenizer::Span;
alias TokenText = pkg::html::tokenizer::TokenText;

fn in_body_end_tag(state: &State, document: &Document, atoms: &AtomTable, kw: &Keywords, tok_text: &TokenText, span: Span) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms) {
  doc "13.2.6.4.7's end tag branches.";
  let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: span);
  let is_body = a_is(atom: name_atom, id: atom_body);
  if is_body {
    let body_kind = ScopeKind::Ordinary();
    let has_body = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_body, kind: body_kind);
    if has_body {
      set_mode_after_body(state: state);
    }
    let r = False();
    return Ok<Bool, TreeError>(value: r);
  }
  let is_html = a_is(atom: name_atom, id: atom_html);
  if is_html {
    let html_kind = ScopeKind::Ordinary();
    let has_body2 = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_body, kind: html_kind);
    if has_body2 {
      set_mode_after_body(state: state);
      let r1 = True();
      return Ok<Bool, TreeError>(value: r1);
    }
    let r2 = False();
    return Ok<Bool, TreeError>(value: r2);
  }
  let is_block_end = is_addr_block_end(atoms: atoms, kw: kw, name_atom: name_atom);
  if is_block_end {
    let block_kind = ScopeKind::Ordinary();
    let ictor1 = Namespace::Html();
    let has_it = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor1, target_name: name_atom, kind: block_kind);
    if has_it {
      generate_implied_end_tags(state: state, kw: kw);
      pop_until_html_tag(state: state, id: name_atom.index);
    }
    let r3 = False();
    return Ok<Bool, TreeError>(value: r3);
  }
  let is_form = a_is(atom: name_atom, id: atom_form);
  if is_form {
    let in_template = state^.template_modes.inner.len > 0_u64;
    if in_template {
      let form_kind = ScopeKind::Ordinary();
      let has_form = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_form, kind: form_kind);
      if has_form {
        generate_implied_end_tags(state: state, kw: kw);
        pop_until_html_tag(state: state, id: atom_form);
      }
      let r4 = False();
      return Ok<Bool, TreeError>(value: r4);
    }
    let node_opt = state^.form_pointer;
    set state^.form_pointer = None<NodeId>();
    match node_opt {
      None() => {
      }
      Some(value: fp) => {
        let fp_node = fp;
        let form_in_stack = stack_contains_node(state: state, target: fp_node);
        if form_in_stack {
          generate_implied_end_tags(state: state, kw: kw);
          pop_until_node(state: state, target: fp_node);
        }
      }
    }
    let r5 = False();
    return Ok<Bool, TreeError>(value: r5);
  }
  let is_p = a_is(atom: name_atom, id: atom_p);
  if is_p {
    let p_kind = ScopeKind::Button();
    let has_p = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_p, kind: p_kind);
    if has_p {
    } else {
      let p_atom2 = Atom(index: atom_p);
      let node = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: p_atom2);
    }
    close_p_element(state: state, kw: kw);
    let r6 = False();
    return Ok<Bool, TreeError>(value: r6);
  }
  let is_li = a_is(atom: name_atom, id: atom_li);
  if is_li {
    let li_kind = ScopeKind::ListItem();
    let has_li = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_li, kind: li_kind);
    if has_li {
      generate_implied_end_tags_except(state: state, kw: kw, except: name_atom);
      pop_until_html_tag(state: state, id: atom_li);
    }
    let r7 = False();
    return Ok<Bool, TreeError>(value: r7);
  }
  let is_dd = a_is(atom: name_atom, id: atom_dd);
  let is_dt = a_is(atom: name_atom, id: atom_dt);
  let is_dd_dt = bor(is_dd, is_dt);
  if is_dd_dt {
    let ddt_kind = ScopeKind::Ordinary();
    let ictor2 = Namespace::Html();
    let has_ddt = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor2, target_name: name_atom, kind: ddt_kind);
    if has_ddt {
      generate_implied_end_tags_except(state: state, kw: kw, except: name_atom);
      pop_until_html_tag(state: state, id: name_atom.index);
    }
    let r8 = False();
    return Ok<Bool, TreeError>(value: r8);
  }
  let is_heading = is_h1_h6(local_name: name_atom);
  if is_heading {
    let h1 = Atom(index: atom_h1);
    let h2 = Atom(index: atom_h2);
    let h_kind = ScopeKind::Ordinary();
    let has_h = has_any_heading_in_scope(state: state, kw: kw);
    if has_h {
      generate_implied_end_tags(state: state, kw: kw);
      pop_until_any_heading(state: state);
    }
    let r9 = False();
    return Ok<Bool, TreeError>(value: r9);
  }
  let is_a = a_is(atom: name_atom, id: atom_a);
  let is_fmt = is_formatting_html(local_name: name_atom, kw: kw);
  let is_fmt_group = bor(is_a, is_fmt);
  if is_fmt_group {
    let adopted = propagate adoption_agency(state: state, document: document, kw: kw, subject: name_atom);
    let r10 = False();
    return Ok<Bool, TreeError>(value: r10);
  }
  let is_applet = kw^.applet.index == name_atom.index;
  let is_marquee = kw^.marquee.index == name_atom.index;
  let is_object = a_is(atom: name_atom, id: atom_object);
  let is_amo_1 = bor(is_applet, is_marquee);
  let is_amo = bor(is_amo_1, is_object);
  if is_amo {
    let amo_kind = ScopeKind::Ordinary();
    let ictor3 = Namespace::Html();
    let has_amo = has_tag_in_scope(state: state, kw: kw, target_namespace: ictor3, target_name: name_atom, kind: amo_kind);
    if has_amo {
      generate_implied_end_tags(state: state, kw: kw);
      pop_until_html_tag(state: state, id: name_atom.index);
      afe_clear_to_last_marker(state: state);
    }
    let r11 = False();
    return Ok<Bool, TreeError>(value: r11);
  }
  let is_br = a_is(atom: name_atom, id: atom_br);
  if is_br {
    let recon = propagate reconstruct_active_formatting_elements(state: state, document: document);
    let br_atom = Atom(index: atom_br);
    let node2 = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: br_atom);
    pop_open_if_any(state: state);
    set state^.frameset_ok = False();
    let r12 = False();
    return Ok<Bool, TreeError>(value: r12);
  }
  let ran = run_any_other_end_tag_html(state: state, kw: kw, subject: name_atom);
  let r13 = False();
  return Ok<Bool, TreeError>(value: r13);
}

fn has_any_heading_in_scope(state: &State, kw: &Keywords) -> result: Bool reads(state), reads(kw) {
  doc "Tells whether the stack of open elements has an h1-h6 HTML element in scope.";
  let len = open_len(state: state);
  let has = len > 0_u64;
  if has {
  } else {
    return False();
  }
  let idx = len;
  loop @scan {
    let more = idx > 0_u64;
    if more {
    } else {
      break @scan;
    }
    let prev = idx -wrap 1_u64;
    let len2 = open_len(state: state);
    let ok = prev < len2;
    if ok {
    } else {
      break @scan;
    }
    let elem = open_at(state: state, index: prev);
    let html = ns_is_html(namespace: elem.namespace);
    let heading = is_h1_h6(local_name: elem.local_name);
    let hit = band(html, heading);
    if hit {
      return True();
    }
    let boundary = is_ordinary_scope_boundary(namespace: elem.namespace, local_name: elem.local_name, kw: kw);
    if boundary {
      return False();
    }
    set idx = prev;
  }
  return False();
}

fn pop_until_any_heading(state: &State) -> result: unit writes(state) {
  doc "Pops elements from the stack of open elements until an h1-h6 HTML element has been popped, or the stack runs out.";
  loop @pop {
    let len = open_len(state: state);
    let has = len > 0_u64;
    if has {
    } else {
      break @pop;
    }
    let idx = len -wrap 1_u64;
    let elem = open_at(state: state, index: idx);
    pop_open(state: state);
    let html = ns_is_html(namespace: elem.namespace);
    if html {
      let heading = is_h1_h6(local_name: elem.local_name);
      if heading {
        break @pop;
      }
    }
  }
  return unit;
}
