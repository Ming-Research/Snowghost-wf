alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn mode_in_head_noscript(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.5 \"in head noscript\".";
  match token {
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r0 = False();
      return Ok<Bool, TreeError>(value: r0);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let handled = propagate in_body_process_html_start_tag(state: state, document: document, atoms: atoms, tok_text: tok_text, first_attribute: fa, end_attribute: ea);
        let r1 = False();
        return Ok<Bool, TreeError>(value: r1);
      }
      let is_link_meta = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_link, id2: atom_meta, id3: atom_style, id4: atom_style);
      let ins_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
      let is_basefont = kw^.basefont.index == ins_name.index;
      let is_bgsound = kw^.bgsound.index == ins_name.index;
      let is_noframes = kw^.noframes.index == ins_name.index;
      let is_bgsound_noframes = bor(is_bgsound, is_noframes);
      let is_kw_group = bor(is_basefont, is_bgsound_noframes);
      let is_delegate = bor(is_link_meta, is_kw_group);
      if is_delegate {
        let processed = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r2 = False();
        return Ok<Bool, TreeError>(value: r2);
      }
      let is_head_or_noscript = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_head);
      let is_noscript2 = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_noscript);
      let is_bad = bor(is_head_or_noscript, is_noscript2);
      if is_bad {
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let made = propagate in_head_noscript_anything_else(state: state);
      let r4 = True();
      return Ok<Bool, TreeError>(value: r4);
    }
    EndTag(name: n3) => {
      let is_noscript_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_noscript);
      if is_noscript_end {
        pop_open_if_any(state: state);
        set_mode_in_head(state: state);
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let is_br = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_br);
      if is_br {
        let made2 = propagate in_head_noscript_anything_else(state: state);
        let r6 = True();
        return Ok<Bool, TreeError>(value: r6);
      }
      let r7 = False();
      return Ok<Bool, TreeError>(value: r7);
    }
    Characters(data: d) => {
      let ws = characters_all_ws(tok_text: tok_text, token: token);
      if ws {
        let processed2 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r8 = False();
        return Ok<Bool, TreeError>(value: r8);
      }
      let made3 = propagate in_head_noscript_anything_else(state: state);
      let r9 = True();
      return Ok<Bool, TreeError>(value: r9);
    }
    Comment(data: d2) => {
      let processed3 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      let r10 = False();
      return Ok<Bool, TreeError>(value: r10);
    }
    EndOfFile() => {
      let made4 = propagate in_head_noscript_anything_else(state: state);
      let r11 = True();
      return Ok<Bool, TreeError>(value: r11);
    }
  }
}

fn in_head_noscript_anything_else(state: &State) -> result: Result<unit, TreeError> writes(state) {
  doc "in head noscript's \"anything else\": pop the noscript element, switch to in head.";
  pop_open_if_any(state: state);
  set_mode_in_head(state: state);
  return Ok<unit, TreeError>(value: unit);
}

fn mode_text(state: &State, document: &Document, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), writes(state), writes(document) {
  doc "13.2.6.4.8 \"text\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes0 = &tok_text^.text.inner[s..e];
      let (skip_start, skipped_one) = strip_pending_leading_lf(state: state, bytes: bytes0);
      let bytes_len0 = bytes0^.len;
      let skip_ok = skip_start <= bytes_len0;
      let bytes = if skip_ok {
        give &bytes0^[skip_start..bytes_len0];
      } else {
        give bytes0;
      }
      let small = bytes^.len <= 1073741824_u64;
      if small {
        let ins = propagate insert_characters_current(state: state, document: document, bytes: bytes);
      }
      let r0 = False();
      return Ok<Bool, TreeError>(value: r0);
    }
    EndTag(name: n) => {
      pop_open_if_any(state: state);
      restore_original_mode(state: state);
      let r1 = False();
      return Ok<Bool, TreeError>(value: r1);
    }
    EndOfFile() => {
      pop_open_if_any(state: state);
      restore_original_mode(state: state);
      let r2 = True();
      return Ok<Bool, TreeError>(value: r2);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let r3 = False();
      return Ok<Bool, TreeError>(value: r3);
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      let r4 = False();
      return Ok<Bool, TreeError>(value: r4);
    }
    Comment(data: d2) => {
      let r5 = False();
      return Ok<Bool, TreeError>(value: r5);
    }
  }
}
