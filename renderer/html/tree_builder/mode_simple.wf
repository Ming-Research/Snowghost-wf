alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias Document = pkg::dom::Document;
alias NodeData = pkg::dom::NodeData;
alias NodeId = pkg::dom::NodeId;
alias Namespace = pkg::dom::Namespace;
alias QuirksMode = pkg::dom::QuirksMode;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias create_node = pkg::dom::create_node;

fn characters_all_ws(tok_text: &TokenText, token: Token) -> result: Bool reads(tok_text) {
  doc "Tells whether token is a Characters token whose bytes are all HTML whitespace; a non-Characters token gives False.";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let out = bytes_all_ws(bytes: bytes);
      return out;
    }
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      return False();
    }
    EndTag(name: n2) => {
      return False();
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      return False();
    }
    Comment(data: d2) => {
      return False();
    }
    EndOfFile() => {
      return False();
    }
  }
}

fn characters_all_ws_or_nul(tok_text: &TokenText, token: Token) -> result: Bool reads(tok_text) {
  doc "Tells whether token is a Characters token whose bytes are all HTML whitespace or U+0000 NULL; a non-Characters token gives False. before head/in head/after head/in head noscript treat NUL as ignorable alongside whitespace, since NUL is a parse error to be ignored there as it is in \"in body\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let out = bytes_all_ws_or_nul(bytes: bytes);
      return out;
    }
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      return False();
    }
    EndTag(name: n2) => {
      return False();
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      return False();
    }
    Comment(data: d2) => {
      return False();
    }
    EndOfFile() => {
      return False();
    }
  }
}

fn mode_before_html(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), writes(state), writes(document), writes(atoms) {
  doc "13.2.6.4.2 \"before html\".";
  let ws = characters_all_ws(tok_text: tok_text, token: token);
  if ws {
    let bareval1 = False();
    return Ok<Bool, TreeError>(value: bareval1);
  }
  match token {
    Comment(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let small = bytes^.len <= 1073741824_u64;
      if small {
        let root = NodeId(index: 0_u32);
        let no_ref = None<NodeId>();
        let place = Place(parent: root, before: no_ref);
        let ins = propagate insert_comment_at(document: document, place: place, data: bytes);
      }
      let bareval2 = False();
      return Ok<Bool, TreeError>(value: bareval2);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let bareval3 = False();
      return Ok<Bool, TreeError>(value: bareval3);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let html_ns = Namespace::Html();
        let html_atom = Atom(index: atom_html);
        let node = propagate create_element_for_token(document: document, atoms: atoms, tok_text: tok_text, name: html_atom, first_attribute: fa, end_attribute: ea, namespace: html_ns);
        let root = NodeId(index: 0_u32);
        let placed = propagate append_child_wrap(document: document, parent: root, child: node);
        let elem = StackEntry(node: node, namespace: html_ns, local_name: html_atom);
        let pushed = propagate push_open(state: state, elem: elem);
        set_mode_before_head(state: state);
        let bareval4 = False();
        return Ok<Bool, TreeError>(value: bareval4);
      }
      let made = propagate before_html_anything_else(state: state, document: document);
      let bareval5 = True();
      return Ok<Bool, TreeError>(value: bareval5);
    }
    EndTag(name: n3) => {
      let is_breaker = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n3, id1: atom_head, id2: atom_body, id3: atom_html, id4: atom_br);
      if is_breaker {
        let made2 = propagate before_html_anything_else(state: state, document: document);
        let bareval6 = True();
        return Ok<Bool, TreeError>(value: bareval6);
      }
      let bareval7 = False();
      return Ok<Bool, TreeError>(value: bareval7);
    }
    Characters(data: d2) => {
      let made3 = propagate before_html_anything_else(state: state, document: document);
      let bareval8 = True();
      return Ok<Bool, TreeError>(value: bareval8);
    }
    EndOfFile() => {
      let made4 = propagate before_html_anything_else(state: state, document: document);
      let bareval9 = True();
      return Ok<Bool, TreeError>(value: bareval9);
    }
  }
}

fn before_html_anything_else(state: &State, document: &Document) -> result: Result<unit, TreeError> writes(state), writes(document) {
  doc "before html's \"anything else\": create the html element with no attributes, append to Document, push, switch to before head.";
  let html_ns = Namespace::Html();
  let html_atom = Atom(index: atom_html);
  let no_contents = None<NodeId>();
  let empty_attrs = box_slots_new::<Attribute>(capacity: 0_u64);
  let data = NodeData::Element(namespace: html_ns, local_name: html_atom, attributes: move empty_attrs, template_contents: no_contents);
  match create_node(document: document, data: move data) {
    Ok(value: node) => {
      let root = NodeId(index: 0_u32);
      let placed = propagate append_child_wrap(document: document, parent: root, child: node);
      let elem = StackEntry(node: node, namespace: html_ns, local_name: html_atom);
      let pushed = propagate push_open(state: state, elem: elem);
      set_mode_before_head(state: state);
      return Ok<unit, TreeError>(value: unit);
    }
    Err(error: problem) => {
      let wrapped = to_tree_error(problem: problem);
      return Err<unit, TreeError>(error: wrapped);
    }
  }
}

fn tag_is(atoms: &AtomTable, text: &TokenText, span: Span, id: u32) -> result: Result<Bool, TreeError> reads(text), writes(atoms) {
  doc "Interns the tag name span names in text and tells whether it equals the static or re-exported atom id.";
  let name_atom = propagate intern_span(atoms: atoms, text: text, span: span);
  let out = a_is(atom: name_atom, id: id);
  return Ok<Bool, TreeError>(value: out);
}

fn tag_is_one_of4(atoms: &AtomTable, text: &TokenText, span: Span, id1: u32, id2: u32, id3: u32, id4: u32) -> result: Result<Bool, TreeError> reads(text), writes(atoms) {
  doc "Interns the tag name span names in text and tells whether it equals one of four static or re-exported atom ids.";
  let name_atom = propagate intern_span(atoms: atoms, text: text, span: span);
  let a = a_is(atom: name_atom, id: id1);
  let b = a_is(atom: name_atom, id: id2);
  let c = a_is(atom: name_atom, id: id3);
  let d = a_is(atom: name_atom, id: id4);
  let out = bor4(a: a, b: b, c: c, d: d);
  return Ok<Bool, TreeError>(value: out);
}
