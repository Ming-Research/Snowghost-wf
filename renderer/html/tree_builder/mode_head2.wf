alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias ContentState = pkg::html::tokenizer::ContentState;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn insert_and_pop_void(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, name: Atom, first_attribute: u32, end_attribute: u32) -> result: Result<unit, TreeError> reads(tok_text), writes(state), writes(document), writes(atoms) {
  doc "Inserts an HTML element for the token and immediately pops it: base, basefont, bgsound, link, meta, area, br, embed, img, keygen, wbr, param, source, track, hr, input.";
  let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name, first_attribute: first_attribute, end_attribute: end_attribute);
  pop_open_if_any(state: state);
  return Ok<unit, TreeError>(value: unit);
}

fn mode_in_head(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.4 \"in head\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let ws_end = first_non_ws_or_nul(bytes: bytes);
      let ws_prefix = &bytes^[0_u64..ws_end];
      let small = ws_prefix^.len <= 1073741824_u64;
      if small {
        let has_prefix = ws_end > 0_u64;
        if has_prefix {
          let ins = propagate insert_characters_dropping_nul(state: state, document: document, bytes: ws_prefix);
        }
      }
      let all_ws = ws_end == bytes^.len;
      if all_ws {
        let bareval1 = False();
        return Ok<Bool, TreeError>(value: bareval1);
      }
      let made = propagate in_head_anything_else(state: state);
      let bareval2 = True();
      return Ok<Bool, TreeError>(value: bareval2);
    }
    Comment(data: d2) => {
      let ins2 = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let bareval3 = False();
      return Ok<Bool, TreeError>(value: bareval3);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let bareval4 = False();
      return Ok<Bool, TreeError>(value: bareval4);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let handled = propagate in_body_process_html_start_tag(state: state, document: document, atoms: atoms, tok_text: tok_text, first_attribute: fa, end_attribute: ea);
        let bareval5 = False();
        return Ok<Bool, TreeError>(value: bareval5);
      }
      let void_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
      let void_a = a_is(atom: void_name, id: atom_base);
      let void_b = kw^.basefont.index == void_name.index;
      let void_c = kw^.bgsound.index == void_name.index;
      let void_d = a_is(atom: void_name, id: atom_link);
      let is_void = bor4(a: void_a, b: void_b, c: void_c, d: void_d);
      if is_void {
        let done_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
        let done = propagate insert_and_pop_void(state: state, document: document, atoms: atoms, tok_text: tok_text, name: done_name, first_attribute: fa, end_attribute: ea);
        let bareval6 = False();
        return Ok<Bool, TreeError>(value: bareval6);
      }
      let is_meta = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_meta);
      if is_meta {
        let done2_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
        let done2 = propagate insert_and_pop_void(state: state, document: document, atoms: atoms, tok_text: tok_text, name: done2_name, first_attribute: fa, end_attribute: ea);
        let bareval7 = False();
        return Ok<Bool, TreeError>(value: bareval7);
      }
      let is_title = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_title);
      if is_title {
        let title_atom = Atom(index: atom_title);
        let done3 = propagate generic_rcdata(state: state, document: document, atoms: atoms, tokenizer: tokenizer, tok_text: tok_text, name: title_atom, first_attribute: fa, end_attribute: ea);
        let bareval8 = False();
        return Ok<Bool, TreeError>(value: bareval8);
      }
      let nfs_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
      let nfs_a = kw^.noframes.index == nfs_name.index;
      let nfs_b = a_is(atom: nfs_name, id: atom_style);
      let is_noframes_style = bor(nfs_a, nfs_b);
      if is_noframes_style {
        let done4_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
        let done4 = propagate generic_rawtext(state: state, document: document, atoms: atoms, tokenizer: tokenizer, tok_text: tok_text, name: done4_name, first_attribute: fa, end_attribute: ea);
        let bareval9 = False();
        return Ok<Bool, TreeError>(value: bareval9);
      }
      let is_noscript = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_noscript);
      if is_noscript {
        let scripting_on = state^.scripting;
        if scripting_on {
          let done5_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
          let done5 = propagate generic_rawtext(state: state, document: document, atoms: atoms, tokenizer: tokenizer, tok_text: tok_text, name: done5_name, first_attribute: fa, end_attribute: ea);
          let bareval10 = False();
          return Ok<Bool, TreeError>(value: bareval10);
        }
        let noscript_atom = Atom(index: atom_noscript);
        let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: noscript_atom, first_attribute: fa, end_attribute: ea);
        set_mode_in_head_noscript(state: state);
        let bareval11 = False();
        return Ok<Bool, TreeError>(value: bareval11);
      }
      let is_script = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_script);
      if is_script {
        let done6_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
        let done6 = propagate generic_scriptdata(state: state, document: document, atoms: atoms, tokenizer: tokenizer, tok_text: tok_text, name: done6_name, first_attribute: fa, end_attribute: ea);
        let bareval12 = False();
        return Ok<Bool, TreeError>(value: bareval12);
      }
      let is_template = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_template);
      if is_template {
        let marker = propagate afe_push_marker(state: state);
        set state^.frameset_ok = False();
        set_mode_in_template(state: state);
        let in_template_mode = InsertionMode::InTemplate();
        let pushed_mode = propagate push_template_mode(state: state, mode: in_template_mode);
        let template_atom = Atom(index: atom_template);
        let node2 = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: template_atom, first_attribute: fa, end_attribute: ea);
        let bareval13 = False();
        return Ok<Bool, TreeError>(value: bareval13);
      }
      let is_head_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_head);
      if is_head_tag {
        let bareval14 = False();
        return Ok<Bool, TreeError>(value: bareval14);
      }
      let made2 = propagate in_head_anything_else(state: state);
      let bareval15 = True();
      return Ok<Bool, TreeError>(value: bareval15);
    }
    EndTag(name: n3) => {
      let is_head_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_head);
      if is_head_end {
        pop_open_if_any(state: state);
        set_mode_after_head(state: state);
        let bareval16 = False();
        return Ok<Bool, TreeError>(value: bareval16);
      }
      let is_template_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_template);
      if is_template_end {
        let has_template = stack_contains_html_tag(state: state, id: atom_template);
        if has_template {
          generate_all_implied_end_tags_thoroughly(state: state, kw: kw);
          pop_until_html_tag(state: state, id: atom_template);
          afe_clear_to_last_marker(state: state);
          let popped_mode = pop_template_mode(state: state);
          reset_insertion_mode(state: state, kw: kw);
        }
        let bareval17 = False();
        return Ok<Bool, TreeError>(value: bareval17);
      }
      let is_breaker = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n3, id1: atom_body, id2: atom_html, id3: atom_br, id4: atom_br);
      if is_breaker {
        let made3 = propagate in_head_anything_else(state: state);
        let bareval18 = True();
        return Ok<Bool, TreeError>(value: bareval18);
      }
      let bareval19 = False();
      return Ok<Bool, TreeError>(value: bareval19);
    }
    EndOfFile() => {
      let made4 = propagate in_head_anything_else(state: state);
      let bareval20 = True();
      return Ok<Bool, TreeError>(value: bareval20);
    }
  }
}

fn in_head_anything_else(state: &State) -> result: Result<unit, TreeError> writes(state) {
  doc "in head's \"anything else\": pop the head element, switch to after head.";
  pop_open_if_any(state: state);
  set_mode_after_head(state: state);
  return Ok<unit, TreeError>(value: unit);
}

fn name_atom_from_span(atoms: &AtomTable, text: &TokenText, span: Span) -> result: Atom reads(text), writes(atoms) {
  doc "Interns span's bytes, or returns atom 0 on refusal (only reachable past the interface's own size limits).";
  match intern_span(atoms: atoms, text: text, span: span) {
    Ok(value: a) => {
      return a;
    }
    Err(error: problem) => {
      let zero = Atom(index: 0_u32);
      return zero;
    }
  }
}
