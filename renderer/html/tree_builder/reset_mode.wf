alias Atom = pkg::base::atom::Atom;
alias Namespace = pkg::dom::Namespace;

fn top_template_mode(state: &State) -> found: Option<InsertionMode> reads(state) {
  doc "Returns the current template insertion mode: the most recently pushed entry of the stack of template insertion modes.";
  let len = state^.template_modes.inner.len;
  let has = len > 0_u64;
  if has {
    let idx = len -wrap 1_u64;
    invariant idx_bound: idx < len;
    let m = state^.template_modes.inner[idx];
    let made = Some<InsertionMode>(value: m);
    return made;
  }
  return None<InsertionMode>();
}

fn reset_insertion_mode(state: &State, kw: &Keywords) -> result: unit reads(kw), writes(state) {
  doc "13.2.4.1: resets the insertion mode appropriately.";
  let len = open_len(state: state);
  let has = len > 0_u64;
  if has {
  } else {
    set_mode_in_body(state: state);
    return unit;
  }
  let idx = len -wrap 1_u64;
  loop @walk {
    let at_top = idx == 0_u64;
    let use_fragment = band(at_top, state^.is_fragment);
    let namespace = if use_fragment {
      give state^.fragment_namespace;
    } else {
      let len2 = open_len(state: state);
      let in_range = idx < len2;
      if in_range {
        let e = open_at(state: state, index: idx);
        give e.namespace;
      } else {
        let html_ns = Namespace::Html();
        give html_ns;
      }
    }
    let local_name = if use_fragment {
      give state^.fragment_name;
    } else {
      let len3 = open_len(state: state);
      let in_range2 = idx < len3;
      if in_range2 {
        let e2 = open_at(state: state, index: idx);
        give e2.local_name;
      } else {
        let zero = Atom(index: 0_u32);
        give zero;
      }
    }
    let html = ns_is_html(namespace: namespace);
    if html {
      let is_td = a_is(atom: local_name, id: atom_td);
      let is_th = a_is(atom: local_name, id: atom_th);
      let is_cell = bor(is_td, is_th);
      let not_last = bnot(at_top);
      let cell_hit = band(is_cell, not_last);
      if cell_hit {
        set_mode_in_cell(state: state);
        return unit;
      }
      let is_tr = a_is(atom: local_name, id: atom_tr);
      if is_tr {
        set_mode_in_row(state: state);
        return unit;
      }
      let is_tbody = a_is(atom: local_name, id: atom_tbody);
      let is_thead = a_is(atom: local_name, id: atom_thead);
      let is_tfoot = a_is(atom: local_name, id: atom_tfoot);
      let is_thead_tfoot = bor(is_thead, is_tfoot);
      let is_body_group = bor(is_tbody, is_thead_tfoot);
      if is_body_group {
        set_mode_in_table_body(state: state);
        return unit;
      }
      let is_caption = a_is(atom: local_name, id: atom_caption);
      if is_caption {
        set_mode_in_caption(state: state);
        return unit;
      }
      let is_colgroup = a_is(atom: local_name, id: atom_colgroup);
      if is_colgroup {
        set_mode_in_column_group(state: state);
        return unit;
      }
      let is_table = a_is(atom: local_name, id: atom_table);
      if is_table {
        set_mode_in_table(state: state);
        return unit;
      }
      let is_template = a_is(atom: local_name, id: atom_template);
      if is_template {
        let top = top_template_mode(state: state);
        match top {
          Some(value: m) => {
            set state^.mode = m;
            return unit;
          }
          None() => {
            set_mode_in_body(state: state);
            return unit;
          }
        }
      }
      let is_head = a_is(atom: local_name, id: atom_head);
      let not_top = bnot(at_top);
      let head_not_last = band(is_head, not_top);
      if head_not_last {
        set_mode_in_head(state: state);
        return unit;
      }
      let is_body = a_is(atom: local_name, id: atom_body);
      if is_body {
        set_mode_in_body(state: state);
        return unit;
      }
      let is_frameset = kw^.frameset.index == local_name.index;
      if is_frameset {
        set_mode_in_frameset(state: state);
        return unit;
      }
      let is_html = a_is(atom: local_name, id: atom_html);
      if is_html {
        match state^.head_pointer {
          None() => {
            set_mode_before_head(state: state);
            return unit;
          }
          Some(value: hp) => {
            set_mode_after_head(state: state);
            return unit;
          }
        }
      }
    }
    if at_top {
      set_mode_in_body(state: state);
      return unit;
    }
    set idx = idx -wrap 1_u64;
  }
}
