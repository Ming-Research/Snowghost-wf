alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;
alias ContentState = pkg::html::tokenizer::ContentState;

fn clear_lf_skip_unless_characters(state: &State, token: Token) -> result: unit writes(state) {
  doc "The pending leading-LF-skip flag only ever applies to the very next Characters token; any other token clears it unconsumed.";
  match token {
    Characters(data: d) => {
    }
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      set state^.pending_lf_skip = False();
    }
    EndTag(name: n2) => {
      set state^.pending_lf_skip = False();
    }
    Comment(data: d2) => {
      set state^.pending_lf_skip = False();
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      set state^.pending_lf_skip = False();
    }
    EndOfFile() => {
      set state^.pending_lf_skip = False();
    }
  }
  return unit;
}

fn mode_in_body(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.7 \"in body\", the largest insertion mode.";
  let cleared = clear_lf_skip_unless_characters(state: state, token: token);
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes0 = &tok_text^.text.inner[s..e];
      let (skip_start, skipped_one) = strip_pending_leading_lf(state: state, bytes: bytes0);
      let bytes_len0 = bytes0^.len;
      let skip_ok = skip_start <= bytes_len0;
      let bytes = if skip_ok {
        give &bytes0^[skip_start..bytes_len0];
      } else {
        give bytes0;
      }
      let recon = propagate reconstruct_active_formatting_elements(state: state, document: document);
      let small = bytes^.len <= 1073741824_u64;
      if small {
        let ins = propagate insert_characters_replacing_nul(state: state, document: document, bytes: bytes);
      }
      let any_non_ws = bytes_any_non_ws(bytes: bytes);
      if any_non_ws {
        set state^.frameset_ok = False();
      }
      let r0 = False();
      return Ok<Bool, TreeError>(value: r0);
    }
    Comment(data: d2) => {
      let ins2 = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let r1 = False();
      return Ok<Bool, TreeError>(value: r1);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    EndOfFile() => {
      let has_template = state^.template_modes.inner.len > 0_u64;
      if has_template {
        let processed = propagate mode_in_template(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        return Ok<Bool, TreeError>(value: processed);
      }
      let r3 = False();
      return Ok<Bool, TreeError>(value: r3);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let outcome = propagate in_body_start_tag(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token, span: n2, first_attribute: fa, end_attribute: ea, self_closing: sc);
      return Ok<Bool, TreeError>(value: outcome);
    }
    EndTag(name: n3) => {
      let outcome2 = propagate in_body_end_tag(state: state, document: document, atoms: atoms, kw: kw, tok_text: tok_text, span: n3);
      return Ok<Bool, TreeError>(value: outcome2);
    }
  }
}
