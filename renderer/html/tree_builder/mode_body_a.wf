alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;
alias ContentState = pkg::html::tokenizer::ContentState;
alias Span = pkg::html::tokenizer::Span;

fn close_p_if_in_button_scope(state: &State, kw: &Keywords) -> result: unit reads(kw), writes(state) {
  doc "\"If the stack of open elements has a p element in button scope, then close a p element.\"";
  let p_atom = Atom(index: atom_p);
  let button_kind = ScopeKind::Button();
  let has_p = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_p, kind: button_kind);
  if has_p {
    close_p_element(state: state, kw: kw);
  }
  return unit;
}

fn insert_html_element_span(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, span: Span, first_attribute: u32, end_attribute: u32) -> result: Result<NodeId, TreeError> reads(tok_text), writes(state), writes(document), writes(atoms) {
  doc "Interns span's bytes as the element name and inserts an HTML element for the token.";
  let name = propagate intern_span(atoms: atoms, text: tok_text, span: span);
  let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name, first_attribute: first_attribute, end_attribute: end_attribute);
  return Ok<NodeId, TreeError>(value: node);
}

fn is_addr_block_start(local_name: Atom, kw: &Keywords) -> result: Bool reads(kw) {
  doc "address, article, aside, blockquote, center, details, dialog, dir, div, dl, fieldset, figcaption, figure, footer, header, hgroup, main, menu, nav, ol, p, search, section, summary, ul.";
  let is_center = kw^.center.index == local_name.index;
  if is_center {
    return True();
  }
  let a = a_is(atom: local_name, id: atom_address);
  let b = a_is(atom: local_name, id: atom_article);
  let c = a_is(atom: local_name, id: atom_aside);
  let d = a_is(atom: local_name, id: atom_blockquote);
  let e = a_is(atom: local_name, id: atom_details);
  let f = a_is(atom: local_name, id: atom_dialog);
  let g = a_is(atom: local_name, id: atom_dir);
  let h = a_is(atom: local_name, id: atom_div);
  let g1 = bor8(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h);
  let i = a_is(atom: local_name, id: atom_dl);
  let j = a_is(atom: local_name, id: atom_fieldset);
  let k = a_is(atom: local_name, id: atom_figcaption);
  let l = a_is(atom: local_name, id: atom_figure);
  let m = a_is(atom: local_name, id: atom_footer);
  let n = a_is(atom: local_name, id: atom_header);
  let o = a_is(atom: local_name, id: atom_hgroup);
  let p = a_is(atom: local_name, id: atom_main);
  let g2 = bor8(a: i, b: j, c: k, d: l, e: m, f: n, g: o, h: p);
  let q = a_is(atom: local_name, id: atom_menu);
  let r = a_is(atom: local_name, id: atom_nav);
  let s = a_is(atom: local_name, id: atom_ol);
  let t = a_is(atom: local_name, id: atom_p);
  let u = a_is(atom: local_name, id: atom_search);
  let v = a_is(atom: local_name, id: atom_section);
  let w = a_is(atom: local_name, id: atom_summary);
  let x = a_is(atom: local_name, id: atom_ul);
  let g3 = bor8(a: q, b: r, c: s, d: t, e: u, f: v, g: w, h: x);
  let low = bor(g1, g2);
  let out = bor(low, g3);
  return out;
}

fn is_addr_block_end(atoms: &AtomTable, kw: &Keywords, name_atom: Atom) -> result: Bool reads(kw) {
  doc "address, article, aside, blockquote, button, center, details, dialog, dir, div, dl, fieldset, figcaption, figure, footer, header, hgroup, listing, main, menu, nav, ol, pre, search, section, summary, ul.";
  let a = a_is(atom: name_atom, id: atom_address);
  let b = a_is(atom: name_atom, id: atom_article);
  let c = a_is(atom: name_atom, id: atom_aside);
  let d = a_is(atom: name_atom, id: atom_blockquote);
  let e = a_is(atom: name_atom, id: atom_button);
  let f = kw^.center.index == name_atom.index;
  let g = a_is(atom: name_atom, id: atom_details);
  let h = a_is(atom: name_atom, id: atom_dialog);
  let g1 = bor8(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h);
  let i = a_is(atom: name_atom, id: atom_dir);
  let j = a_is(atom: name_atom, id: atom_div);
  let k = a_is(atom: name_atom, id: atom_dl);
  let l = a_is(atom: name_atom, id: atom_fieldset);
  let m = a_is(atom: name_atom, id: atom_figcaption);
  let n = a_is(atom: name_atom, id: atom_figure);
  let o = a_is(atom: name_atom, id: atom_footer);
  let p = a_is(atom: name_atom, id: atom_header);
  let g2 = bor8(a: i, b: j, c: k, d: l, e: m, f: n, g: o, h: p);
  let q = a_is(atom: name_atom, id: atom_hgroup);
  let r = kw^.listing.index == name_atom.index;
  let s = a_is(atom: name_atom, id: atom_main);
  let t = a_is(atom: name_atom, id: atom_menu);
  let u = a_is(atom: name_atom, id: atom_nav);
  let v = a_is(atom: name_atom, id: atom_ol);
  let w = a_is(atom: name_atom, id: atom_pre);
  let x = a_is(atom: name_atom, id: atom_search);
  let g3 = bor8(a: q, b: r, c: s, d: t, e: u, f: v, g: w, h: x);
  let y = a_is(atom: name_atom, id: atom_section);
  let z = a_is(atom: name_atom, id: atom_summary);
  let aa = a_is(atom: name_atom, id: atom_ul);
  let g4a = bor(z, aa);
  let g4 = bor(y, g4a);
  let low = bor(g1, g2);
  let low2 = bor(g3, g4);
  let out = bor(low, low2);
  return out;
}

fn is_h1_h6(local_name: Atom) -> result: Bool pure {
  doc "h1, h2, h3, h4, h5, h6.";
  let a = a_is(atom: local_name, id: atom_h1);
  let b = a_is(atom: local_name, id: atom_h2);
  let c = a_is(atom: local_name, id: atom_h3);
  let d = a_is(atom: local_name, id: atom_h4);
  let e = a_is(atom: local_name, id: atom_h5);
  let f = a_is(atom: local_name, id: atom_h6);
  let g = False();
  let h = False();
  let out = bor8(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h);
  return out;
}
