alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias DomError = pkg::dom::DomError;
alias Namespace = pkg::dom::Namespace;

public enum TreeError {
  TooLarge();
  Dom(public error: DomError);
}

public fn parse_document(source: &[u8], scripting: Bool, atoms: &AtomTable) -> result: Result<Document, TreeError> reads(source), writes(atoms) contract {
  requires source^.len <= 1073741824_u64;
} doc "Parses source as a whole HTML document under the tree construction section of the WHATWG HTML Living Standard, with pkg::html::tokenizer as its tokenizer and the scripting flag as given; source is WTF-8 and tokenized as next_token describes. Element and attribute names are interned in atoms. The document's quirks mode is set on its root. No script runs: a script element is inserted and parsing continues. Template contents are Fragment nodes named by their template element's template_contents. Parse errors are not reported. TooLarge when the document would pass a storage limit; Dom carries a document operation's refusal, which a correct builder never meets.";

public fn parse_fragment(source: &[u8], context_namespace: Namespace, context_name: Atom, scripting: Bool, atoms: &AtomTable) -> result: Result<Document, TreeError> reads(source), writes(atoms) contract {
  requires source^.len <= 1073741824_u64;
} doc "Parses source under the standard's HTML fragment parsing algorithm with a context element of the given namespace and local name, which has no attributes and no form or template ancestor. The returned document's root holds the fragment's result nodes as its children, in order: the children the algorithm leaves on its root html element. Otherwise as parse_document.";
