  doc "Tells whether public_id starts with one of the DOCTYPE public identifier prefixes that force limited-quirks mode.";
  let m0 = bytes_starts_with_ci(text: text, prefix: &public_id_starts_limited_60[0_u64..public_id_starts_limited_60.len]);
  let m1 = bytes_starts_with_ci(text: text, prefix: &public_id_starts_limited_61[0_u64..public_id_starts_limited_61.len]);
