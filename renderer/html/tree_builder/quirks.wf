fn public_id_starts_quirks_sysless(text: &[u8]) -> result: Bool reads(text) {
  doc "Tells whether public_id starts with one of the two DOCTYPE public identifier prefixes that force quirks mode only when the system identifier is missing or empty.";
  let m0 = bytes_starts_with_ci(text: text, prefix: &public_id_starts_quirks_sysless_58[0_u64..public_id_starts_quirks_sysless_58.len]);
  let m1 = bytes_starts_with_ci(text: text, prefix: &public_id_starts_quirks_sysless_59[0_u64..public_id_starts_quirks_sysless_59.len]);
  let grp1m1 = bor(m0, m1);
  let grp1 = grp1m1;
  return grp1;
}

