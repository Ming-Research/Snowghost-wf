fn public_id_starts_limited_syshas(text: &[u8]) -> result: Bool reads(text) {
  doc "Tells whether public_id starts with one of the two DOCTYPE public identifier prefixes that force limited-quirks mode only when the system identifier is neither missing nor empty.";
  let m0 = bytes_starts_with_ci(text: text, prefix: &public_id_starts_limited_syshas_62[0_u64..public_id_starts_limited_syshas_62.len]);
  let m1 = bytes_starts_with_ci(text: text, prefix: &public_id_starts_limited_syshas_63[0_u64..public_id_starts_limited_syshas_63.len]);
