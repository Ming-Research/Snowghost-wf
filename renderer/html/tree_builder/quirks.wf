fn system_id_is_ibm_quirks(text: &[u8]) -> result: Bool reads(text) {
  doc "Tells whether system_id exactly equals the one DOCTYPE system identifier that forces quirks mode.";
  let m0 = bytes_eq(a: text, b: &system_id_is_ibm_quirks_64[0_u64..system_id_is_ibm_quirks_64.len]);
  return m0;
}

const html_name_lit: Array<u8, 4> = "html";

fn quirks_mode_for_doctype(force_quirks: Bool, has_name: Bool, name: &[u8], has_system: Bool, system_id: &[u8], public_id: &[u8]) -> result: QuirksMode reads(name), reads(system_id), reads(public_id) {
  doc "13.2.6.4.1: determines the Document's quirks mode from a DOCTYPE token's fields (name and system_id empty when missing, per has_name/has_system).";
  if force_quirks {
    let out = QuirksMode::Quirks();
    return out;
  }
  let is_html = bytes_eq(a: name, b: &html_name_lit[0_u64..html_name_lit.len]);
  let name_ok = band(has_name, is_html);
  if name_ok {
  } else {
    let out = QuirksMode::Quirks();
    return out;
  }
  let exact_quirks = public_id_is_quirks_exact(text: public_id);
  if exact_quirks {
    let out = QuirksMode::Quirks();
    return out;
  }
  let prefix_quirks = public_id_starts_quirks(text: public_id);
  if prefix_quirks {
    let out = QuirksMode::Quirks();
    return out;
  }
  let sysid_quirks = system_id_is_ibm_quirks(text: system_id);
  let sysid_quirks_applies = band(has_system, sysid_quirks);
  if sysid_quirks_applies {
    let out = QuirksMode::Quirks();
    return out;
  }
  let no_system = bnot(has_system);
  let sysless_prefix = public_id_starts_quirks_sysless(text: public_id);
  let sysless_quirks = band(no_system, sysless_prefix);
  if sysless_quirks {
    let out = QuirksMode::Quirks();
    return out;
  }
  let limited_prefix = public_id_starts_limited(text: public_id);
  if limited_prefix {
    let out = QuirksMode::LimitedQuirks();
    return out;
  }
  let syshas_prefix = public_id_starts_limited_syshas(text: public_id);
  let syshas_quirks = band(has_system, syshas_prefix);
  if syshas_quirks {
    let out = QuirksMode::LimitedQuirks();
    return out;
  }
  let out = QuirksMode::NoQuirks();
  return out;
}
