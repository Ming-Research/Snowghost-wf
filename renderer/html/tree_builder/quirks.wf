fn public_id_is_quirks_exact(text: &[u8]) -> result: Bool reads(text) {
  doc "Tells whether public_id exactly equals (ASCII case-insensitively) one of the DOCTYPE public identifiers that force quirks mode by exact match.";
  let m0 = bytes_eq(a: text, b: &public_id_is_quirks_exact_0[0_u64..public_id_is_quirks_exact_0.len]);
  let m1 = bytes_eq(a: text, b: &public_id_is_quirks_exact_1[0_u64..public_id_is_quirks_exact_1.len]);
  let m2 = bytes_eq(a: text, b: &public_id_is_quirks_exact_2[0_u64..public_id_is_quirks_exact_2.len]);
  let grp1m1 = bor(m0, m1);
  let grp1m2 = bor(grp1m1, m2);
  let grp1 = grp1m2;
  return grp1;
}

