fn is_special_html(local_name: Atom, kw: &Keywords) -> result: Bool reads(kw) {
  doc "Tells whether local_name, in the HTML namespace, is in the special category (13.2.4.2).";
  let c_address = a_is(atom: local_name, id: atom_address);
  let c_area = a_is(atom: local_name, id: atom_area);
  let c_article = a_is(atom: local_name, id: atom_article);
  let c_aside = a_is(atom: local_name, id: atom_aside);
  let c_base = a_is(atom: local_name, id: atom_base);
  let c_blockquote = a_is(atom: local_name, id: atom_blockquote);
  let c_body = a_is(atom: local_name, id: atom_body);
  let c_br = a_is(atom: local_name, id: atom_br);
  let c_button = a_is(atom: local_name, id: atom_button);
  let c_caption = a_is(atom: local_name, id: atom_caption);
  let c_col = a_is(atom: local_name, id: atom_col);
  let c_colgroup = a_is(atom: local_name, id: atom_colgroup);
  let c_dd = a_is(atom: local_name, id: atom_dd);
  let c_details = a_is(atom: local_name, id: atom_details);
  let c_dir = a_is(atom: local_name, id: atom_dir);
  let c_div = a_is(atom: local_name, id: atom_div);
  let c_dl = a_is(atom: local_name, id: atom_dl);
  let c_dt = a_is(atom: local_name, id: atom_dt);
  let c_embed = a_is(atom: local_name, id: atom_embed);
  let c_fieldset = a_is(atom: local_name, id: atom_fieldset);
  let c_figcaption = a_is(atom: local_name, id: atom_figcaption);
  let c_figure = a_is(atom: local_name, id: atom_figure);
  let c_footer = a_is(atom: local_name, id: atom_footer);
  let c_form = a_is(atom: local_name, id: atom_form);
  let c_h1 = a_is(atom: local_name, id: atom_h1);
  let c_h2 = a_is(atom: local_name, id: atom_h2);
  let c_h3 = a_is(atom: local_name, id: atom_h3);
  let c_h4 = a_is(atom: local_name, id: atom_h4);
  let c_h5 = a_is(atom: local_name, id: atom_h5);
  let c_h6 = a_is(atom: local_name, id: atom_h6);
  let c_head = a_is(atom: local_name, id: atom_head);
  let c_header = a_is(atom: local_name, id: atom_header);
  let c_hgroup = a_is(atom: local_name, id: atom_hgroup);
  let c_hr = a_is(atom: local_name, id: atom_hr);
  let c_html = a_is(atom: local_name, id: atom_html);
  let c_iframe = a_is(atom: local_name, id: atom_iframe);
  let c_img = a_is(atom: local_name, id: atom_img);
  let c_input = a_is(atom: local_name, id: atom_input);
  let c_li = a_is(atom: local_name, id: atom_li);
  let c_link = a_is(atom: local_name, id: atom_link);
  let c_main = a_is(atom: local_name, id: atom_main);
  let c_menu = a_is(atom: local_name, id: atom_menu);
  let c_meta = a_is(atom: local_name, id: atom_meta);
  let c_nav = a_is(atom: local_name, id: atom_nav);
  let c_noscript = a_is(atom: local_name, id: atom_noscript);
  let c_object = a_is(atom: local_name, id: atom_object);
  let c_ol = a_is(atom: local_name, id: atom_ol);
  let c_p = a_is(atom: local_name, id: atom_p);
  let c_pre = a_is(atom: local_name, id: atom_pre);
  let c_script = a_is(atom: local_name, id: atom_script);
  let c_search = a_is(atom: local_name, id: atom_search);
  let c_section = a_is(atom: local_name, id: atom_section);
  let c_select = a_is(atom: local_name, id: atom_select);
  let c_source = a_is(atom: local_name, id: atom_source);
  let c_style = a_is(atom: local_name, id: atom_style);
  let c_summary = a_is(atom: local_name, id: atom_summary);
  let c_table = a_is(atom: local_name, id: atom_table);
  let c_tbody = a_is(atom: local_name, id: atom_tbody);
  let c_td = a_is(atom: local_name, id: atom_td);
  let c_template = a_is(atom: local_name, id: atom_template);
  let c_textarea = a_is(atom: local_name, id: atom_textarea);
  let c_tfoot = a_is(atom: local_name, id: atom_tfoot);
  let c_th = a_is(atom: local_name, id: atom_th);
  let c_thead = a_is(atom: local_name, id: atom_thead);
  let c_title = a_is(atom: local_name, id: atom_title);
  let c_tr = a_is(atom: local_name, id: atom_tr);
  let c_track = a_is(atom: local_name, id: atom_track);
  let c_ul = a_is(atom: local_name, id: atom_ul);
  let c_applet = kw^.applet.index == local_name.index;
  let c_basefont = kw^.basefont.index == local_name.index;
  let c_bgsound = kw^.bgsound.index == local_name.index;
  let c_center = kw^.center.index == local_name.index;
  let c_frame = kw^.frame.index == local_name.index;
  let c_frameset = kw^.frameset.index == local_name.index;
  let c_keygen = kw^.keygen.index == local_name.index;
  let c_listing = kw^.listing.index == local_name.index;
  let c_marquee = kw^.marquee.index == local_name.index;
  let c_noembed = kw^.noembed.index == local_name.index;
  let c_noframes = kw^.noframes.index == local_name.index;
  let c_param = kw^.param.index == local_name.index;
  let c_plaintext = kw^.plaintext.index == local_name.index;
  let c_xmp = kw^.xmp.index == local_name.index;
  let g1 = bor8(a: c_address, b: c_area, c: c_article, d: c_aside, e: c_base, f: c_blockquote, g: c_body, h: c_br);
  let g2 = bor8(a: c_button, b: c_caption, c: c_col, d: c_colgroup, e: c_dd, f: c_details, g: c_dir, h: c_div);
  let g3 = bor8(a: c_dl, b: c_dt, c: c_embed, d: c_fieldset, e: c_figcaption, f: c_figure, g: c_footer, h: c_form);
  let g4 = bor8(a: c_h1, b: c_h2, c: c_h3, d: c_h4, e: c_h5, f: c_h6, g: c_head, h: c_header);
  let g5 = bor8(a: c_hgroup, b: c_hr, c: c_html, d: c_iframe, e: c_img, f: c_input, g: c_li, h: c_link);
  let g6 = bor8(a: c_main, b: c_menu, c: c_meta, d: c_nav, e: c_noscript, f: c_object, g: c_ol, h: c_p);
  let g7 = bor8(a: c_pre, b: c_script, c: c_search, d: c_section, e: c_select, f: c_source, g: c_style, h: c_summary);
  let g8 = bor8(a: c_table, b: c_tbody, c: c_td, d: c_template, e: c_textarea, f: c_tfoot, g: c_th, h: c_thead);
  let g9 = bor8(a: c_title, b: c_tr, c: c_track, d: c_ul, e: c_applet, f: c_basefont, g: c_bgsound, h: c_center);
  let g10 = bor8(a: c_frame, b: c_frameset, c: c_keygen, d: c_listing, e: c_marquee, f: c_noembed, g: c_noframes, h: c_param);
  let g11c_xmp = bor(c_plaintext, c_xmp);
  let g11 = g11c_xmp;
  let g1g2 = bor(g1, g2);
  let g1g2g3 = bor(g1g2, g3);
  let g1g2g3g4 = bor(g1g2g3, g4);
  let g1g2g3g4g5 = bor(g1g2g3g4, g5);
  let g1g2g3g4g5g6 = bor(g1g2g3g4g5, g6);
  let g1g2g3g4g5g6g7 = bor(g1g2g3g4g5g6, g7);
  let g1g2g3g4g5g6g7g8 = bor(g1g2g3g4g5g6g7, g8);
  let g1g2g3g4g5g6g7g8g9 = bor(g1g2g3g4g5g6g7g8, g9);
  let g1g2g3g4g5g6g7g8g9g10 = bor(g1g2g3g4g5g6g7g8g9, g10);
  let g1g2g3g4g5g6g7g8g9g10g11 = bor(g1g2g3g4g5g6g7g8g9g10, g11);
  return g1g2g3g4g5g6g7g8g9g10g11;
}

fn is_special_svg(local_name: Atom) -> result: Bool pure {
  doc "Tells whether local_name, in the SVG namespace, is in the special category: foreignObject, desc, title.";
  let c_fo = a_is(atom: local_name, id: atom_foreign__object);
  let c_desc = a_is(atom: local_name, id: atom_desc);
  let c_title = a_is(atom: local_name, id: atom_title);
  let g1c_desc = bor(c_fo, c_desc);
  let g1c_title = bor(g1c_desc, c_title);
  let g1 = g1c_title;
  return g1;
}

fn is_special_mathml(local_name: Atom) -> result: Bool pure {
  doc "Tells whether local_name, in the MathML namespace, is in the special category: mi, mo, mn, ms, mtext, annotation-xml.";
  let c_mi = a_is(atom: local_name, id: atom_mi);
  let c_mo = a_is(atom: local_name, id: atom_mo);
  let c_mn = a_is(atom: local_name, id: atom_mn);
  let c_ms = a_is(atom: local_name, id: atom_ms);
  let c_mtext = a_is(atom: local_name, id: atom_mtext);
  let c_axml = a_is(atom: local_name, id: atom_annotation_xml);
  let g1c_mo = bor(c_mi, c_mo);
  let g1c_mn = bor(g1c_mo, c_mn);
  let g1c_ms = bor(g1c_mn, c_ms);
  let g1c_mtext = bor(g1c_ms, c_mtext);
  let g1c_axml = bor(g1c_mtext, c_axml);
  let g1 = g1c_axml;
  return g1;
}

fn is_special(namespace: Namespace, local_name: Atom, kw: &Keywords) -> result: Bool reads(kw) {
  doc "Tells whether the element named local_name in namespace is in the special category.";
  let html = ns_is_html(namespace: namespace);
  if html {
    let out = is_special_html(local_name: local_name, kw: kw);
    return out;
  }
  let svg = ns_is_svg(namespace: namespace);
  if svg {
    let out = is_special_svg(local_name: local_name);
    return out;
  }
  let out = is_special_mathml(local_name: local_name);
  return out;
}

fn is_formatting_html(local_name: Atom, kw: &Keywords) -> result: Bool reads(kw) {
  doc "Tells whether local_name is one of the HTML formatting elements: a, b, big, code, em, font, i, nobr, s, small, strike, strong, tt, u.";
  let c_a = a_is(atom: local_name, id: atom_a);
  let c_b = a_is(atom: local_name, id: atom_b);
  let c_code = a_is(atom: local_name, id: atom_code);
  let c_em = a_is(atom: local_name, id: atom_em);
  let c_font = a_is(atom: local_name, id: atom_font);
  let c_i = a_is(atom: local_name, id: atom_i);
  let c_s = a_is(atom: local_name, id: atom_s);
  let c_small = a_is(atom: local_name, id: atom_small);
  let c_strong = a_is(atom: local_name, id: atom_strong);
  let c_u = a_is(atom: local_name, id: atom_u);
  let c_big = kw^.big.index == local_name.index;
  let c_nobr = kw^.nobr.index == local_name.index;
  let c_strike = kw^.strike.index == local_name.index;
  let c_tt = kw^.tt.index == local_name.index;
  let g1 = bor8(a: c_a, b: c_b, c: c_code, d: c_em, e: c_font, f: c_i, g: c_s, h: c_small);
  let g2c_u = bor(c_strong, c_u);
  let g2c_big = bor(g2c_u, c_big);
  let g2c_nobr = bor(g2c_big, c_nobr);
  let g2c_strike = bor(g2c_nobr, c_strike);
  let g2c_tt = bor(g2c_strike, c_tt);
  let g2 = g2c_tt;
  let g1g2 = bor(g1, g2);
  return g1g2;
}

fn is_formatting(namespace: Namespace, local_name: Atom, kw: &Keywords) -> result: Bool reads(kw) {
  doc "Tells whether the element named local_name in namespace is in the formatting category (always the HTML namespace).";
  let html = ns_is_html(namespace: namespace);
  if html {
    let out = is_formatting_html(local_name: local_name, kw: kw);
    return out;
  }
  return False();
}
