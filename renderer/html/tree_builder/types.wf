fn save_original_mode(state: &State) -> result: unit writes(state) {
  doc "Sets the original insertion mode to the current insertion mode, as switching to \"text\" or \"in table text\" does.";
  let m = state^.mode;
  set state^.original_mode = m;
  return unit;
}

fn restore_original_mode(state: &State) -> result: unit writes(state) {
  doc "Switches the insertion mode to the original insertion mode.";
  let m = state^.original_mode;
  set state^.mode = m;
  return unit;
}

fn push_template_mode(state: &State, mode: InsertionMode) -> result: Result<unit, TreeError> writes(state) {
  doc "Pushes mode onto the stack of template insertion modes.";
  let pushed = propagate push_generic::<InsertionMode>(cell: &state^.template_modes, value: mode, ceiling: template_modes_ceiling);
  return Ok<unit, TreeError>(value: unit);
}

fn pop_template_mode(state: &State) -> result: unit writes(state) {
  doc "Pops the current template insertion mode off the stack of template insertion modes.";
  let len = state^.template_modes.inner.len;
  let has = len > 0_u64;
  if has {
    let dropped = take_back(window: &state^.template_modes.inner);
  }
  return unit;
}
