alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn pop_if_option_current(state: &State) -> result: unit writes(state) {
  doc "Pops the current node when it is an HTML option element; a no-op otherwise.";
  let cur = current_entry(state: state);
  match cur {
    Some(value: c) => {
      let html = ns_is_html(namespace: c.namespace);
      let is_opt = a_is(atom: c.local_name, id: atom_option);
      let popit = band(html, is_opt);
      if popit {
        pop_open_if_any(state: state);
      }
    }
    None() => {
    }
  }
  return unit;
}

fn pop_if_optgroup_current(state: &State) -> result: unit writes(state) {
  doc "Pops the current node when it is an HTML optgroup element; a no-op otherwise.";
  let cur = current_entry(state: state);
  match cur {
    Some(value: c) => {
      let html = ns_is_html(namespace: c.namespace);
      let is_og = a_is(atom: c.local_name, id: atom_optgroup);
      let popit = band(html, is_og);
      if popit {
        pop_open_if_any(state: state);
      }
    }
    None() => {
    }
  }
  return unit;
}

fn select_has_select_in_scope(state: &State, kw: &Keywords) -> result: Bool reads(state), reads(kw) {
  doc "Tells whether the stack of open elements has a select element in select scope.";
  let sel_kind = ScopeKind::Select();
  let out = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_select, kind: sel_kind);
  return out;
}

fn select_end_select(state: &State, kw: &Keywords) -> result: unit reads(kw), writes(state) {
  doc "The shared end-select step used by end tag \"select\" and by start tag \"select\" (parse error): pop until select popped, then reset the insertion mode.";
  pop_until_html_tag(state: state, id: atom_select);
  reset_insertion_mode(state: state, kw: kw);
  return unit;
}

fn mode_in_select(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.17 \"in select\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let small = bytes^.len <= 1073741824_u64;
      if small {
        let ins = propagate insert_characters_dropping_nul(state: state, document: document, bytes: bytes);
      }
      let r0 = False();
      return Ok<Bool, TreeError>(value: r0);
    }
    Comment(data: d2) => {
      let ins2 = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let r1 = False();
      return Ok<Bool, TreeError>(value: r1);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: n2);
      let is_html_tag = a_is(atom: name_atom, id: atom_html);
      if is_html_tag {
        let handled = propagate in_body_process_html_start_tag(state: state, document: document, atoms: atoms, tok_text: tok_text, first_attribute: fa, end_attribute: ea);
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let is_option = a_is(atom: name_atom, id: atom_option);
      if is_option {
        pop_if_option_current(state: state);
        let node = propagate insert_html_element_span(state: state, document: document, atoms: atoms, tok_text: tok_text, span: n2, first_attribute: fa, end_attribute: ea);
        let r4 = False();
        return Ok<Bool, TreeError>(value: r4);
      }
      let is_optgroup = a_is(atom: name_atom, id: atom_optgroup);
      if is_optgroup {
        pop_if_option_current(state: state);
        pop_if_optgroup_current(state: state);
        let node2 = propagate insert_html_element_span(state: state, document: document, atoms: atoms, tok_text: tok_text, span: n2, first_attribute: fa, end_attribute: ea);
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let is_hr = a_is(atom: name_atom, id: atom_hr);
      if is_hr {
        pop_if_option_current(state: state);
        pop_if_optgroup_current(state: state);
        let done = propagate insert_and_pop_void(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        let r6 = False();
        return Ok<Bool, TreeError>(value: r6);
      }
      let is_select = a_is(atom: name_atom, id: atom_select);
      if is_select {
        let has_select = select_has_select_in_scope(state: state, kw: kw);
        if has_select {
          select_end_select(state: state, kw: kw);
        }
        let r7 = False();
        return Ok<Bool, TreeError>(value: r7);
      }
      let is_script = a_is(atom: name_atom, id: atom_script);
      let is_template = a_is(atom: name_atom, id: atom_template);
      let is_head_like = bor(is_script, is_template);
      if is_head_like {
        let processed = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r8 = False();
        return Ok<Bool, TreeError>(value: r8);
      }
      let r9 = False();
      return Ok<Bool, TreeError>(value: r9);
    }
    EndTag(name: n3) => {
      let name_atom2 = propagate intern_span(atoms: atoms, text: tok_text, span: n3);
      let is_optgroup_end = a_is(atom: name_atom2, id: atom_optgroup);
      if is_optgroup_end {
        let len = open_len(state: state);
        let has_two = len >= 2_u64;
        if has_two {
          let idx_cur = len -wrap 1_u64;
          invariant idx_cur_bound: idx_cur < len;
          let cur = open_at(state: state, index: idx_cur);
          let idx_prev = len -wrap 2_u64;
          invariant idx_prev_bound: idx_prev < len;
          let prev = open_at(state: state, index: idx_prev);
          let cur_is_option = a_is(atom: cur.local_name, id: atom_option);
          let prev_is_optgroup = a_is(atom: prev.local_name, id: atom_optgroup);
          let both = band(cur_is_option, prev_is_optgroup);
          if both {
            pop_open_if_any(state: state);
          }
        }
        pop_if_optgroup_current(state: state);
        let r10 = False();
        return Ok<Bool, TreeError>(value: r10);
      }
      let is_option_end = a_is(atom: name_atom2, id: atom_option);
      if is_option_end {
        pop_if_option_current(state: state);
        let r11 = False();
        return Ok<Bool, TreeError>(value: r11);
      }
      let is_select_end = a_is(atom: name_atom2, id: atom_select);
      if is_select_end {
        let has_select2 = select_has_select_in_scope(state: state, kw: kw);
        if has_select2 {
          select_end_select(state: state, kw: kw);
        }
        let r12 = False();
        return Ok<Bool, TreeError>(value: r12);
      }
      let is_template_end = a_is(atom: name_atom2, id: atom_template);
      if is_template_end {
        let processed2 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r13 = False();
        return Ok<Bool, TreeError>(value: r13);
      }
      let r14 = False();
      return Ok<Bool, TreeError>(value: r14);
    }
    EndOfFile() => {
      let processed3 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed3);
    }
  }
}

fn select_in_table_break_names(atoms: &AtomTable, text: &TokenText, span: Span) -> result: Result<Bool, TreeError> reads(text), writes(atoms) {
  doc "Tells whether span names one of caption, table, tbody, tfoot, thead, tr, td, th: the tags \"in select in table\" treats specially.";
  let g1 = propagate tag_is_one_of4(atoms: atoms, text: text, span: span, id1: atom_caption, id2: atom_table, id3: atom_tbody, id4: atom_tfoot);
  let g2 = propagate tag_is_one_of4(atoms: atoms, text: text, span: span, id1: atom_thead, id2: atom_tr, id3: atom_td, id4: atom_th);
  let out = bor(g1, g2);
  return Ok<Bool, TreeError>(value: out);
}

fn mode_in_select_in_table(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.18 \"in select in table\".";
  match token {
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_break = propagate select_in_table_break_names(atoms: atoms, text: tok_text, span: n2);
      if is_break {
        select_end_select(state: state, kw: kw);
        let r0 = True();
        return Ok<Bool, TreeError>(value: r0);
      }
      let processed = propagate mode_in_select(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed);
    }
    EndTag(name: n3) => {
      let is_break2 = propagate select_in_table_break_names(atoms: atoms, text: tok_text, span: n3);
      if is_break2 {
        let ns = Namespace::Html();
        let target = propagate intern_span(atoms: atoms, text: tok_text, span: n3);
        let kind = ScopeKind::Table();
        let in_scope = has_tag_in_scope(state: state, kw: kw, target_namespace: ns, target_name: target, kind: kind);
        if in_scope {
          select_end_select(state: state, kw: kw);
          let r1 = True();
          return Ok<Bool, TreeError>(value: r1);
        }
        let r2 = False();
        return Ok<Bool, TreeError>(value: r2);
      }
      let processed2 = propagate mode_in_select(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed2);
    }
    Characters(data: d) => {
      let processed3 = propagate mode_in_select(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed3);
    }
    Comment(data: d2) => {
      let processed4 = propagate mode_in_select(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed4);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let processed5 = propagate mode_in_select(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed5);
    }
    EndOfFile() => {
      let processed6 = propagate mode_in_select(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed6);
    }
  }
}
