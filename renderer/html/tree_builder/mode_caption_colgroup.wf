alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn mode_in_caption(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.11 \"in caption\".";
  match token {
    EndTag(name: n) => {
      let is_caption_end = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_caption);
      if is_caption_end {
        let done = propagate in_caption_close(state: state, kw: kw);
        let r0 = False();
        return Ok<Bool, TreeError>(value: r0);
      }
      let is_table_end = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_table);
      if is_table_end {
        let closed_table = propagate in_caption_close(state: state, kw: kw);
        return Ok<Bool, TreeError>(value: closed_table);
      }
      let is_ignored = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n, id1: atom_body, id2: atom_col, id3: atom_colgroup, id4: atom_html);
      let is_ignored2a = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tbody);
      let is_ignored2b = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_td);
      let is_ignored2c = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tfoot);
      let is_ignored2d = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_th);
      let g1 = bor4(a: is_ignored2a, b: is_ignored2b, c: is_ignored2c, d: is_ignored2d);
      let is_ignored3a = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_thead);
      let is_ignored3b = propagate tag_is(atoms: atoms, text: tok_text, span: n, id: atom_tr);
      let g2 = bor(is_ignored3a, is_ignored3b);
      let ig1 = bor(is_ignored, g1);
      let ig = bor(ig1, g2);
      if ig {
        let r1 = False();
        return Ok<Bool, TreeError>(value: r1);
      }
      let processed = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_break_start = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_caption, id2: atom_col, id3: atom_colgroup, id4: atom_tbody);
      let bs2a = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_td);
      let bs2b = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_tfoot);
      let bs2c = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_th);
      let bs2d = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_thead);
      let g3 = bor4(a: bs2a, b: bs2b, c: bs2c, d: bs2d);
      let bs3 = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_tr);
      let all1 = bor(is_break_start, g3);
      let all2 = bor(all1, bs3);
      if all2 {
        let closed2 = propagate in_caption_close(state: state, kw: kw);
        return Ok<Bool, TreeError>(value: closed2);
      }
      let outcome = propagate in_body_start_tag(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token, span: n2, first_attribute: fa, end_attribute: ea, self_closing: sc);
      return Ok<Bool, TreeError>(value: outcome);
    }
    Characters(data: d) => {
      let outcome2 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome2);
    }
    Comment(data: d2) => {
      let outcome3 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome3);
    }
    Doctype(name: n3, public_id: p, system_id: si, force_quirks: fq) => {
      let outcome4 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome4);
    }
    EndOfFile() => {
      let outcome5 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: outcome5);
    }
  }
}

fn in_caption_close(state: &State, kw: &Keywords) -> result: Result<Bool, TreeError> reads(kw), writes(state) {
  doc "13.2.6.4.11's shared close step: if a caption element is in table scope, generate implied end tags, pop until caption popped, clear AFE to last marker, switch to in table, and report the close as performed; otherwise (fragment case: no caption element in table scope) do nothing and report no close, so the caller ignores the token instead of reprocessing it forever.";
  let cap_kind = ScopeKind::Table();
  let has_caption = has_html_tag_in_scope(state: state, kw: kw, target_name: atom_caption, kind: cap_kind);
  if has_caption {
    generate_implied_end_tags(state: state, kw: kw);
    pop_until_html_tag(state: state, id: atom_caption);
    afe_clear_to_last_marker(state: state);
    set_mode_in_table(state: state);
    let closed = True();
    return Ok<Bool, TreeError>(value: closed);
  }
  let not_closed = False();
  return Ok<Bool, TreeError>(value: not_closed);
}

fn mode_in_column_group(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.12 \"in column group\".";
  match token {
    Characters(data: d) => {
      let ws = characters_all_ws(tok_text: tok_text, token: token);
      if ws {
        let (s, e) = span_range(text: tok_text, span: d);
        let bytes = &tok_text^.text.inner[s..e];
        let small = bytes^.len <= 1073741824_u64;
        if small {
          let ins = propagate insert_characters_current(state: state, document: document, bytes: bytes);
        }
        let r0 = False();
        return Ok<Bool, TreeError>(value: r0);
      }
      let done = propagate in_column_group_anything_else(state: state, kw: kw);
      return Ok<Bool, TreeError>(value: done);
    }
    Comment(data: d2) => {
      let ins2 = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let r1 = False();
      return Ok<Bool, TreeError>(value: r1);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let handled = propagate in_body_process_html_start_tag(state: state, document: document, atoms: atoms, tok_text: tok_text, first_attribute: fa, end_attribute: ea);
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let is_col = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_col);
      if is_col {
        let col_atom = Atom(index: atom_col);
        let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: col_atom, first_attribute: fa, end_attribute: ea);
        pop_open_if_any(state: state);
        let r4 = False();
        return Ok<Bool, TreeError>(value: r4);
      }
      let is_template = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_template);
      if is_template {
        let processed = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let done2 = propagate in_column_group_anything_else(state: state, kw: kw);
      return Ok<Bool, TreeError>(value: done2);
    }
    EndTag(name: n3) => {
      let is_colgroup_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_colgroup);
      if is_colgroup_end {
        let cur = current_entry(state: state);
        let is_colgroup_cur = match cur {
          Some(value: c) => {
            let html = ns_is_html(namespace: c.namespace);
            let is_cg = a_is(atom: c.local_name, id: atom_colgroup);
            let out = band(html, is_cg);
            give out;
          }
          None() => {
            give False();
          }
        }
        if is_colgroup_cur {
          pop_open_if_any(state: state);
          set_mode_in_table(state: state);
        }
        let r6 = False();
        return Ok<Bool, TreeError>(value: r6);
      }
      let is_col_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_col);
      if is_col_end {
        let r7 = False();
        return Ok<Bool, TreeError>(value: r7);
      }
      let is_template_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_template);
      if is_template_end {
        let processed2 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r8 = False();
        return Ok<Bool, TreeError>(value: r8);
      }
      let done3 = propagate in_column_group_anything_else(state: state, kw: kw);
      return Ok<Bool, TreeError>(value: done3);
    }
    EndOfFile() => {
      let processed3 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
      return Ok<Bool, TreeError>(value: processed3);
    }
  }
}

fn in_column_group_anything_else(state: &State, kw: &Keywords) -> result: Result<Bool, TreeError> writes(state) {
  doc "13.2.6.4.12's \"anything else\": if the current node is not colgroup, ignore; otherwise pop it, switch to in table, reprocess.";
  let cur = current_entry(state: state);
  let is_colgroup_cur = match cur {
    Some(value: c) => {
      let html = ns_is_html(namespace: c.namespace);
      let is_cg = a_is(atom: c.local_name, id: atom_colgroup);
      let out = band(html, is_cg);
      give out;
    }
    None() => {
      give False();
    }
  }
  if is_colgroup_cur {
    pop_open_if_any(state: state);
    set_mode_in_table(state: state);
    let bareval1 = True();
    return Ok<Bool, TreeError>(value: bareval1);
  }
  let bareval2 = False();
  return Ok<Bool, TreeError>(value: bareval2);
}
