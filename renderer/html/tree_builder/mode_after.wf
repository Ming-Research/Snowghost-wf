alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn after_body_anything_else(state: &State) -> result: Result<unit, TreeError> writes(state) {
  doc "after body's and after after body's shared \"anything else\": parse error, switch to \"in body\", reprocess.";
  set_mode_in_body(state: state);
  return Ok<unit, TreeError>(value: unit);
}

fn mode_after_body(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.19 \"after body\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let ws = bytes_all_ws(bytes: bytes);
      if ws {
        let processed = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        return Ok<Bool, TreeError>(value: processed);
      }
      let made = propagate after_body_anything_else(state: state);
      let r0 = True();
      return Ok<Bool, TreeError>(value: r0);
    }
    Comment(data: d2) => {
      let (s2, e2) = span_range(text: tok_text, span: d2);
      let bytes2 = &tok_text^.text.inner[s2..e2];
      let small = bytes2^.len <= 1073741824_u64;
      let len = open_len(state: state);
      let has = len > 0_u64;
      if small {
        if has {
          let root = open_at(state: state, index: 0_u64);
          let no_ref = None<NodeId>();
          let place = Place(parent: root.node, before: no_ref);
          let ins = propagate insert_comment_at(document: document, place: place, data: bytes2);
        }
      }
      let r1 = False();
      return Ok<Bool, TreeError>(value: r1);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let processed2 = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let made2 = propagate after_body_anything_else(state: state);
      let r4 = True();
      return Ok<Bool, TreeError>(value: r4);
    }
    EndTag(name: n3) => {
      let is_html_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_html);
      if is_html_end {
        let is_frag = state^.is_fragment;
        if is_frag {
        } else {
          set_mode_after_after_body(state: state);
        }
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let made3 = propagate after_body_anything_else(state: state);
      let r6 = True();
      return Ok<Bool, TreeError>(value: r6);
    }
    EndOfFile() => {
      let r7 = False();
      return Ok<Bool, TreeError>(value: r7);
    }
  }
}

fn mode_in_frameset(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.20 \"in frameset\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let small = bytes^.len <= 1073741824_u64;
      if small {
        let ins = propagate insert_characters_only_ws(state: state, document: document, bytes: bytes);
      }
      let r0 = False();
      return Ok<Bool, TreeError>(value: r0);
    }
    Comment(data: d2) => {
      let ins2 = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let r1 = False();
      return Ok<Bool, TreeError>(value: r1);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let processed = propagate mode_in_body(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r3 = False();
        return Ok<Bool, TreeError>(value: r3);
      }
      let name_atom = propagate intern_span(atoms: atoms, text: tok_text, span: n2);
      let is_frameset = kw^.frameset.index == name_atom.index;
      if is_frameset {
        let node = propagate insert_html_element_span(state: state, document: document, atoms: atoms, tok_text: tok_text, span: n2, first_attribute: fa, end_attribute: ea);
        let r4 = False();
        return Ok<Bool, TreeError>(value: r4);
      }
      let is_frame = kw^.frame.index == name_atom.index;
      if is_frame {
        let done = propagate insert_and_pop_void(state: state, document: document, atoms: atoms, tok_text: tok_text, name: name_atom, first_attribute: fa, end_attribute: ea);
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let is_noframes = kw^.noframes.index == name_atom.index;
      if is_noframes {
        let processed2 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r6 = False();
        return Ok<Bool, TreeError>(value: r6);
      }
      let r7 = False();
      return Ok<Bool, TreeError>(value: r7);
    }
    EndTag(name: n3) => {
      let name_atom2 = propagate intern_span(atoms: atoms, text: tok_text, span: n3);
      let is_frameset_end = kw^.frameset.index == name_atom2.index;
      if is_frameset_end {
        let len = open_len(state: state);
        let is_root_only = len <= 1_u64;
        if is_root_only {
          let r8 = False();
          return Ok<Bool, TreeError>(value: r8);
        }
        pop_open_if_any(state: state);
        let is_frag = state^.is_fragment;
        if is_frag {
        } else {
          let cur = current_entry(state: state);
          let still_frameset = match cur {
            Some(value: c) => {
              let html = ns_is_html(namespace: c.namespace);
              let is_fs = kw^.frameset.index == c.local_name.index;
              let out = band(html, is_fs);
              give out;
            }
            None() => {
              give False();
            }
          }
          if still_frameset {
          } else {
            set_mode_after_frameset(state: state);
          }
        }
        let r9 = False();
        return Ok<Bool, TreeError>(value: r9);
      }
      let r10 = False();
      return Ok<Bool, TreeError>(value: r10);
    }
    EndOfFile() => {
      let r11 = False();
      return Ok<Bool, TreeError>(value: r11);
    }
  }
}

