alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias ContentState = pkg::html::tokenizer::ContentState;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;
alias tokenizer_set_state = pkg::html::tokenizer::tokenizer_set_state;

fn mode_before_head(state: &State, document: &Document, atoms: &AtomTable, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), writes(state), writes(document), writes(atoms) {
  doc "13.2.6.4.3 \"before head\".";
  let ws = characters_all_ws_or_nul(tok_text: tok_text, token: token);
  if ws {
    let bareval1 = False();
    let done0 = Ok<Bool, TreeError>(value: bareval1);
    return done0;
  }
  match token {
    Comment(data: d) => {
      let ins = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d);
      let bareval2 = False();
      let done = Ok<Bool, TreeError>(value: bareval2);
      return done;
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let bareval3 = False();
      let done2 = Ok<Bool, TreeError>(value: bareval3);
      return done2;
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let reprocessed = propagate in_body_process_html_start_tag(state: state, document: document, atoms: atoms, tok_text: tok_text, first_attribute: fa, end_attribute: ea);
        let bareval4 = False();
        let done3 = Ok<Bool, TreeError>(value: bareval4);
        return done3;
      }
      let is_head = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_head);
      if is_head {
        let head_atom = Atom(index: atom_head);
        let head_node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: head_atom, first_attribute: fa, end_attribute: ea);
        let some_head = Some<NodeId>(value: head_node);
        set state^.head_pointer = some_head;
        set_mode_in_head(state: state);
        let bareval5 = False();
        let done4 = Ok<Bool, TreeError>(value: bareval5);
        return done4;
      }
      let made = propagate before_head_anything_else(state: state, document: document, atoms: atoms);
      let bareval6 = True();
      let done5 = Ok<Bool, TreeError>(value: bareval6);
      return done5;
    }
    EndTag(name: n3) => {
      let is_breaker = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n3, id1: atom_head, id2: atom_body, id3: atom_html, id4: atom_br);
      if is_breaker {
        let made2 = propagate before_head_anything_else(state: state, document: document, atoms: atoms);
        let bareval7 = True();
        let done6 = Ok<Bool, TreeError>(value: bareval7);
        return done6;
      }
      let bareval8 = False();
      let done7 = Ok<Bool, TreeError>(value: bareval8);
      return done7;
    }
    Characters(data: d2) => {
      let made3 = propagate before_head_anything_else(state: state, document: document, atoms: atoms);
      let bareval9 = True();
      let done8 = Ok<Bool, TreeError>(value: bareval9);
      return done8;
    }
    EndOfFile() => {
      let made4 = propagate before_head_anything_else(state: state, document: document, atoms: atoms);
      let bareval10 = True();
      let done9 = Ok<Bool, TreeError>(value: bareval10);
      return done9;
    }
  }
}

fn before_head_anything_else(state: &State, document: &Document, atoms: &AtomTable) -> result: Result<unit, TreeError> writes(state), writes(document), writes(atoms) {
  doc "before head's \"anything else\": insert an implied head element, set the head pointer, switch to in head.";
  let head_atom = Atom(index: atom_head);
  let head_node = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: head_atom);
  let some_head = Some<NodeId>(value: head_node);
  set state^.head_pointer = some_head;
  set_mode_in_head(state: state);
  return Ok<unit, TreeError>(value: unit);
}

fn insert_comment_span(state: &State, document: &Document, tok_text: &TokenText, span: Span) -> result: Result<unit, TreeError> reads(state), reads(tok_text), writes(document) {
  doc "Inserts a comment at the appropriate place, reading its data from span.";
  let (s, e) = span_range(text: tok_text, span: span);
  let bytes = &tok_text^.text.inner[s..e];
  let small = bytes^.len <= 1073741824_u64;
  if small {
    let ins = propagate insert_comment_current(state: state, document: document, bytes: bytes);
  }
  return Ok<unit, TreeError>(value: unit);
}
