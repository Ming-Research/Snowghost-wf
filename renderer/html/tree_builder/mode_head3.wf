alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias Namespace = pkg::dom::Namespace;
alias NodeId = pkg::dom::NodeId;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias Tokenizer = pkg::html::tokenizer::Tokenizer;

fn mode_after_head(state: &State, document: &Document, atoms: &AtomTable, tokenizer: &Tokenizer, kw: &Keywords, tok_text: &TokenText, token: Token) -> result: Result<Bool, TreeError> reads(tok_text), reads(kw), writes(state), writes(document), writes(atoms), writes(tokenizer) {
  doc "13.2.6.4.6 \"after head\".";
  match token {
    Characters(data: d) => {
      let (s, e) = span_range(text: tok_text, span: d);
      let bytes = &tok_text^.text.inner[s..e];
      let ws_end = first_non_ws_or_nul(bytes: bytes);
      let ws_prefix = &bytes^[0_u64..ws_end];
      let small = ws_prefix^.len <= 1073741824_u64;
      let has_prefix = ws_end > 0_u64;
      if small {
        if has_prefix {
          let ins = propagate insert_characters_dropping_nul(state: state, document: document, bytes: ws_prefix);
        }
      }
      let all_ws = ws_end == bytes^.len;
      if all_ws {
        let r0 = False();
        return Ok<Bool, TreeError>(value: r0);
      }
      let made = propagate after_head_anything_else(state: state, document: document, atoms: atoms);
      let r1 = True();
      return Ok<Bool, TreeError>(value: r1);
    }
    Comment(data: d2) => {
      let ins2 = propagate insert_comment_span(state: state, document: document, tok_text: tok_text, span: d2);
      let r2 = False();
      return Ok<Bool, TreeError>(value: r2);
    }
    Doctype(name: n, public_id: p, system_id: si, force_quirks: fq) => {
      let r3 = False();
      return Ok<Bool, TreeError>(value: r3);
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let is_html_tag = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_html);
      if is_html_tag {
        let handled = propagate in_body_process_html_start_tag(state: state, document: document, atoms: atoms, tok_text: tok_text, first_attribute: fa, end_attribute: ea);
        let r4 = False();
        return Ok<Bool, TreeError>(value: r4);
      }
      let is_body = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_body);
      if is_body {
        let body_atom = Atom(index: atom_body);
        let node = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: body_atom, first_attribute: fa, end_attribute: ea);
        set state^.frameset_ok = False();
        set_mode_in_body(state: state);
        let r5 = False();
        return Ok<Bool, TreeError>(value: r5);
      }
      let fs_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
      let is_frameset = kw^.frameset.index == fs_name.index;
      if is_frameset {
        let node2 = propagate insert_html_element(state: state, document: document, atoms: atoms, tok_text: tok_text, name: fs_name, first_attribute: fa, end_attribute: ea);
        set_mode_in_frameset(state: state);
        let r6 = False();
        return Ok<Bool, TreeError>(value: r6);
      }
      let head_like = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n2, id1: atom_base, id2: atom_link, id3: atom_meta, id4: atom_script);
      let head_like2a = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_style);
      let head_like2b = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_template);
      let head_like2c = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_title);
      let hl_name = name_atom_from_span(atoms: atoms, text: tok_text, span: n2);
      let head_like2d = kw^.noframes.index == hl_name.index;
      let head_like2 = bor4(a: head_like2a, b: head_like2b, c: head_like2c, d: head_like2d);
      let is_head_like = bor(head_like, head_like2);
      if is_head_like {
        match state^.head_pointer {
          Some(value: hp) => {
            let hp_node = hp^;
            let html_ns = Namespace::Html();
            let head_atom2 = Atom(index: atom_head);
            let hp_entry = StackEntry(node: hp_node, namespace: html_ns, local_name: head_atom2);
            let pushed = propagate push_open(state: state, elem: hp_entry);
            let processed = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
            let removed = propagate remove_open_node(state: state, target: hp_node);
          }
          None() => {
          }
        }
        let r7 = False();
        return Ok<Bool, TreeError>(value: r7);
      }
      let is_head2 = propagate tag_is(atoms: atoms, text: tok_text, span: n2, id: atom_head);
      if is_head2 {
        let r8 = False();
        return Ok<Bool, TreeError>(value: r8);
      }
      let made2 = propagate after_head_anything_else(state: state, document: document, atoms: atoms);
      let r9 = True();
      return Ok<Bool, TreeError>(value: r9);
    }
    EndTag(name: n3) => {
      let is_template_end = propagate tag_is(atoms: atoms, text: tok_text, span: n3, id: atom_template);
      if is_template_end {
        let processed2 = propagate mode_in_head(state: state, document: document, atoms: atoms, tokenizer: tokenizer, kw: kw, tok_text: tok_text, token: token);
        let r10 = False();
        return Ok<Bool, TreeError>(value: r10);
      }
      let is_breaker = propagate tag_is_one_of4(atoms: atoms, text: tok_text, span: n3, id1: atom_body, id2: atom_html, id3: atom_br, id4: atom_br);
      if is_breaker {
        let made3 = propagate after_head_anything_else(state: state, document: document, atoms: atoms);
        let r11 = True();
        return Ok<Bool, TreeError>(value: r11);
      }
      let r12 = False();
      return Ok<Bool, TreeError>(value: r12);
    }
    EndOfFile() => {
      let made4 = propagate after_head_anything_else(state: state, document: document, atoms: atoms);
      let r13 = True();
      return Ok<Bool, TreeError>(value: r13);
    }
  }
}

fn after_head_anything_else(state: &State, document: &Document, atoms: &AtomTable) -> result: Result<unit, TreeError> writes(state), writes(document), writes(atoms) {
  doc "after head's \"anything else\": insert an implied body element, set frameset-ok to ok, switch to in body.";
  let body_atom = Atom(index: atom_body);
  let node = propagate insert_html_element_no_attrs(state: state, document: document, atoms: atoms, name: body_atom);
  set state^.frameset_ok = True();
  set_mode_in_body(state: state);
  return Ok<unit, TreeError>(value: unit);
}

fn remove_open_node(state: &State, target: NodeId) -> result: Result<unit, TreeError> writes(state) {
  doc "Removes the stack-of-open-elements entry naming target, wherever it is (used to remove the head element pointer's pushed entry again after delegating to in head).";
  let idx_opt = stack_index_of_node(state: state, target: target);
  match idx_opt {
    Some(value: idx) => {
      let len = open_len(state: state);
      let ok = idx < len;
      if ok {
        let removed = remove_open_at(state: state, index: idx);
      }
    }
    None() => {
    }
  }
  return Ok<unit, TreeError>(value: unit);
}
