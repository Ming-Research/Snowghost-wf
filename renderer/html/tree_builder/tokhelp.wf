alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias TokenText = pkg::html::tokenizer::TokenText;
alias atom_intern = pkg::base::atom::atom_intern;

fn span_range(text: &TokenText, span: Span) -> (start: u64, end: u64) reads(text) contract {
  ensures start <= end;
  ensures end <= text^.text.inner.len;
} {
  doc "Returns the bounds-checked (start, end) u64 range span names in text's byte storage, or (0, 0) when span is out of bounds.";
  let len = text^.text.inner.len;
  let start64 = cvt::<u32, u64>(span.start);
  let end64 = cvt::<u32, u64>(span.end);
  let ok1 = start64 <= end64;
  let ok2 = end64 <= len;
  let ok = band(ok1, ok2);
  if ok {
    return start64, end64;
  }
  return 0_u64, 0_u64;
}

fn intern_span(atoms: &AtomTable, text: &TokenText, span: Span) -> result: Result<Atom, TreeError> reads(text), writes(atoms) {
  doc "Interns the bytes span names in text's byte storage.";
  let len = text^.text.inner.len;
  let start64 = cvt::<u32, u64>(span.start);
  let end64 = cvt::<u32, u64>(span.end);
  let ok1 = start64 <= end64;
  let ok2 = end64 <= len;
  let ok = band(ok1, ok2);
  if ok {
  } else {
    let too_large0 = TreeError::TooLarge();
    return Err<Atom, TreeError>(error: too_large0);
  }
  let bytes = &text^.text.inner[start64..end64];
  let short = bytes^.len <= 65536_u64;
  if short {
    match atom_intern(table: atoms, name: bytes) {
      Ok(value: a) => {
        return Ok<Atom, TreeError>(value: a);
      }
      Err(error: problem) => {
        let too_large = TreeError::TooLarge();
        return Err<Atom, TreeError>(error: too_large);
      }
    }
  }
  let too_large2 = TreeError::TooLarge();
  return Err<Atom, TreeError>(error: too_large2);
}

fn token_start_tag_name(token: Token) -> result: Span pure {
  doc "Returns a StartTag token's name span, or a zero span for any other token kind.";
  match token {
    StartTag(name: n, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      return n;
    }
    EndTag(name: n2) => {
      let zero = Span(start: 0_u32, end: 0_u32);
      return zero;
    }
    Doctype(name: n3, public_id: p, system_id: s, force_quirks: fq) => {
      let zero2 = Span(start: 0_u32, end: 0_u32);
      return zero2;
    }
    Comment(data: d) => {
      let zero3 = Span(start: 0_u32, end: 0_u32);
      return zero3;
    }
    Characters(data: d2) => {
      let zero4 = Span(start: 0_u32, end: 0_u32);
      return zero4;
    }
    EndOfFile() => {
      let zero5 = Span(start: 0_u32, end: 0_u32);
      return zero5;
    }
  }
}

fn token_end_tag_name(token: Token) -> result: Span pure {
  doc "Returns an EndTag token's name span, or a zero span for any other token kind.";
  match token {
    EndTag(name: n) => {
      return n;
    }
    StartTag(name: n2, first_attribute: fa, end_attribute: ea, self_closing: sc) => {
      let zero = Span(start: 0_u32, end: 0_u32);
      return zero;
    }
    Doctype(name: n3, public_id: p, system_id: s, force_quirks: fq) => {
      let zero2 = Span(start: 0_u32, end: 0_u32);
      return zero2;
    }
    Comment(data: d) => {
      let zero3 = Span(start: 0_u32, end: 0_u32);
      return zero3;
    }
    Characters(data: d2) => {
      let zero4 = Span(start: 0_u32, end: 0_u32);
      return zero4;
    }
    EndOfFile() => {
      let zero5 = Span(start: 0_u32, end: 0_u32);
      return zero5;
    }
  }
}
