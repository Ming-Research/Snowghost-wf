alias Atom = pkg::base::atom::Atom;

fn is_implied_end_tag_html(local_name: Atom, kw: &Keywords) -> result: Bool reads(kw) {
  doc "The HTML elements popped by \"generate implied end tags\": dd, dt, li, optgroup, option, p, rb, rp, rt, rtc.";
  let a = a_is(atom: local_name, id: atom_dd);
  let b = a_is(atom: local_name, id: atom_dt);
  let c = a_is(atom: local_name, id: atom_li);
  let d = a_is(atom: local_name, id: atom_optgroup);
  let e = a_is(atom: local_name, id: atom_option);
  let f = a_is(atom: local_name, id: atom_p);
  let g = a_is(atom: local_name, id: atom_rp);
  let h = a_is(atom: local_name, id: atom_rt);
  let g1 = bor8(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h);
  let i = kw^.rb.index == local_name.index;
  let j = kw^.rtc.index == local_name.index;
  let g2 = bor(i, j);
  let out = bor(g1, g2);
  return out;
}

fn is_implied_end_tag_thorough_html(local_name: Atom) -> result: Bool pure {
  doc "The extra HTML elements \"generate all implied end tags thoroughly\" also pops: caption, colgroup, tbody, td, tfoot, th, thead, tr.";
  let a = a_is(atom: local_name, id: atom_caption);
  let b = a_is(atom: local_name, id: atom_colgroup);
  let c = a_is(atom: local_name, id: atom_tbody);
  let d = a_is(atom: local_name, id: atom_td);
  let e = a_is(atom: local_name, id: atom_tfoot);
  let f = a_is(atom: local_name, id: atom_th);
  let g = a_is(atom: local_name, id: atom_thead);
  let h = a_is(atom: local_name, id: atom_tr);
  let out = bor8(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h);
  return out;
}

fn generate_implied_end_tags(state: &State, kw: &Keywords) -> result: unit reads(kw), writes(state) {
  doc "13.2.6.3: while the current node is one of the implied-end-tag elements, pops it.";
  loop @pop {
    let cur = current_entry(state: state);
    match cur {
      None() => {
        break @pop;
      }
      Some(value: c) => {
        let html = ns_is_html(namespace: c.namespace);
        if html {
        } else {
          break @pop;
        }
        let implied = is_implied_end_tag_html(local_name: c.local_name, kw: kw);
        if implied {
          pop_open_if_any(state: state);
        } else {
          break @pop;
        }
      }
    }
  }
  return unit;
}

fn generate_implied_end_tags_except(state: &State, kw: &Keywords, except: Atom) -> result: unit reads(kw), writes(state) {
  doc "13.2.6.3: generates implied end tags, excluding except from the popped set.";
  loop @pop {
    let cur = current_entry(state: state);
    match cur {
      None() => {
        break @pop;
      }
      Some(value: c) => {
        let html = ns_is_html(namespace: c.namespace);
        if html {
        } else {
          break @pop;
        }
        let is_except = a_is(atom: c.local_name, id: except.index);
        if is_except {
          break @pop;
        }
        let implied = is_implied_end_tag_html(local_name: c.local_name, kw: kw);
        if implied {
          pop_open_if_any(state: state);
        } else {
          break @pop;
        }
      }
    }
  }
  return unit;
}

fn generate_all_implied_end_tags_thoroughly(state: &State, kw: &Keywords) -> result: unit reads(kw), writes(state) {
  doc "13.2.6.3: while the current node is one of the implied-end-tag elements or the thorough set, pops it.";
  loop @pop {
    let cur = current_entry(state: state);
    match cur {
      None() => {
        break @pop;
      }
      Some(value: c) => {
        let html = ns_is_html(namespace: c.namespace);
        if html {
        } else {
          break @pop;
        }
        let implied = is_implied_end_tag_html(local_name: c.local_name, kw: kw);
        let thorough = is_implied_end_tag_thorough_html(local_name: c.local_name);
        let either = bor(implied, thorough);
        if either {
          pop_open_if_any(state: state);
        } else {
          break @pop;
        }
      }
    }
  }
  return unit;
}

fn close_p_element(state: &State, kw: &Keywords) -> result: unit reads(kw), writes(state) {
  doc "13.2.6.4.7: \"close a p element\": generate implied end tags except for p, then pop until a p element has been popped.";
  let p_atom = atom_p;
  let p_val = Atom(index: p_atom);
  generate_implied_end_tags_except(state: state, kw: kw, except: p_val);
  pop_until_html_tag(state: state, id: atom_p);
  return unit;
}
