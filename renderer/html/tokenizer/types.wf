fn token_text_new() -> made: TokenText pure {
  doc "Returns empty token text storage for next_token to fill.";
  let text = box_slots_new::<u8>(capacity: 0_u64);
  let attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  return TokenText(text: move text, attributes: move attributes);
}

fn tokenizer_new(state: ContentState, last_start_tag: &[u8]) -> made: Tokenizer reads(last_start_tag) contract {
  requires last_start_tag^.len <= 1024_u64;
} {
  doc "Returns a tokenizer at the start of its source in state, with last_start_tag as the name of the last start tag emitted, which decides whether an end tag is appropriate in the RCDATA, RAWTEXT and script data states.";
  let length = last_start_tag^.len;
  let tag = box_slots_new::<u8>(capacity: length);
  for @fill (
    at in 0_u64..length,
    invariant grown: tag.inner.len == at
  ) {
    let byte = last_start_tag^[at];
    place_back(window: &tag.inner, value: byte);
  }
  return Tokenizer(position: 0_u64, state: state, last_start_tag: move tag);
}

fn tokenizer_set_state(tokenizer: &Tokenizer, state: ContentState) -> result: unit writes(tokenizer) {
  doc "Switches the tokenizer to state before its next token, as the tree builder does after a start tag such as title or script.";
  set tokenizer^.state = state;
  return unit;
}

fn clear_output(output: &TokenText) -> result: unit writes(output) {
  doc "Empties output's text and attributes at the start of a next_token call.";
  truncate_bytes(cell: &output^.text, length: 0_u64);
  truncate_attributes(cell: &output^.attributes, length: 0_u64);
  return unit;
}

fn truncate_bytes(cell: &Box<Slots<u8>>, length: u64) -> result: unit writes(cell) {
  doc "Removes bytes of cell past length.";
  loop @shrink {
    let current = cell^.inner.len;
    let over = current > length;
    if over {
      let dropped = take_back(window: &cell^.inner);
    } else {
      break @shrink;
    }
  }
  return unit;
}

fn truncate_attributes(cell: &Box<Slots<Attribute>>, length: u64) -> result: unit writes(cell) {
  doc "Removes attributes of cell past length.";
  loop @shrink {
    let current = cell^.inner.len;
    let over = current > length;
    if over {
      let dropped = take_back(window: &cell^.inner);
    } else {
      break @shrink;
    }
  }
  return unit;
}
