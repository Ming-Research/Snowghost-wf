const eof_char: u32 = 1114112_u32;

const replacement_char: u32 = 65533_u32;

const cr_char: u32 = 13_u32;

const lf_char: u32 = 10_u32;

fn decode_one(source: &[u8], pos: u64) -> (ch: u32, next: u64) reads(source) {
  doc "Decodes one scalar value of source's WTF-8 at pos under the WHATWG Encoding Standard's UTF-8 decoder: every maximal ill-formed subsequence becomes one U+FFFD, and a well-formed lone-surrogate 3-byte form decodes to its surrogate value. Returns eof_char and pos unchanged at or past source's end.";
  let length = source^.len;
  let at_end = pos >= length;
  if at_end {
    return eof_char, pos;
  }
  let lead = source^[pos];
  let ascii = lead <= 127_u8;
  if ascii {
    let cp = cvt::<u8, u32>(lead);
    let next = pos +wrap 1_u64;
    return cp, next;
  }
  let c1_pos = pos +wrap 1_u64;
  let two_lo = lead >= 194_u8;
  let two_hi = lead <= 223_u8;
  let two = band(two_lo, two_hi);
  if two {
    let cp0_wide = cvt::<u8, u32>(lead);
    let cp0 = iand(cp0_wide, 31_u32);
    let has1 = c1_pos < length;
    if has1 {
      let b1 = source^[c1_pos];
      let ok1_lo = b1 >= 128_u8;
      let ok1_hi = b1 <= 191_u8;
      let ok1 = band(ok1_lo, ok1_hi);
      if ok1 {
        let b1_wide = cvt::<u8, u32>(b1);
        let b1_bits = iand(b1_wide, 63_u32);
        let shifted = ishl.wrap(cp0, 6_u32);
        let cp = ior(shifted, b1_bits);
        let next = c1_pos +wrap 1_u64;
        return cp, next;
      }
    }
    return replacement_char, c1_pos;
  }
  let three_lo = lead >= 224_u8;
  let three_hi = lead <= 239_u8;
  let three = band(three_lo, three_hi);
  if three {
    let cp0_wide = cvt::<u8, u32>(lead);
    let cp0 = iand(cp0_wide, 15_u32);
    let is_e0 = lead == 224_u8;
    let lower1 = if is_e0 {
      give 160_u8;
    } else {
      give 128_u8;
    }
    let upper1 = 191_u8;
    let has1 = c1_pos < length;
    if has1 {
      let b1 = source^[c1_pos];
      let ok1_lo = b1 >= lower1;
      let ok1_hi = b1 <= upper1;
      let ok1 = band(ok1_lo, ok1_hi);
      if ok1 {
        let b1_wide = cvt::<u8, u32>(b1);
        let b1_bits = iand(b1_wide, 63_u32);
        let shifted0 = ishl.wrap(cp0, 6_u32);
        let cp1 = ior(shifted0, b1_bits);
        let c2_pos = c1_pos +wrap 1_u64;
        let has2 = c2_pos < length;
        if has2 {
          let b2 = source^[c2_pos];
          let ok2_lo = b2 >= 128_u8;
          let ok2_hi = b2 <= 191_u8;
          let ok2 = band(ok2_lo, ok2_hi);
          if ok2 {
            let b2_wide = cvt::<u8, u32>(b2);
            let b2_bits = iand(b2_wide, 63_u32);
            let shifted1 = ishl.wrap(cp1, 6_u32);
            let cp = ior(shifted1, b2_bits);
            let next = c2_pos +wrap 1_u64;
            return cp, next;
          }
        }
        return replacement_char, c2_pos;
      }
    }
    return replacement_char, c1_pos;
  }
  let four_lo = lead >= 240_u8;
  let four_hi = lead <= 244_u8;
  let four = band(four_lo, four_hi);
  if four {
    let cp0_wide = cvt::<u8, u32>(lead);
    let cp0 = iand(cp0_wide, 7_u32);
    let is_f0 = lead == 240_u8;
    let is_f4 = lead == 244_u8;
    let lower1 = if is_f0 {
      give 144_u8;
    } else {
      give 128_u8;
    }
    let upper1 = if is_f4 {
      give 143_u8;
    } else {
      give 191_u8;
    }
    let has1 = c1_pos < length;
    if has1 {
      let b1 = source^[c1_pos];
      let ok1_lo = b1 >= lower1;
      let ok1_hi = b1 <= upper1;
      let ok1 = band(ok1_lo, ok1_hi);
      if ok1 {
        let b1_wide = cvt::<u8, u32>(b1);
        let b1_bits = iand(b1_wide, 63_u32);
        let shifted0 = ishl.wrap(cp0, 6_u32);
        let cp1 = ior(shifted0, b1_bits);
        let c2_pos = c1_pos +wrap 1_u64;
        let has2 = c2_pos < length;
        if has2 {
          let b2 = source^[c2_pos];
          let ok2_lo = b2 >= 128_u8;
          let ok2_hi = b2 <= 191_u8;
          let ok2 = band(ok2_lo, ok2_hi);
          if ok2 {
            let b2_wide = cvt::<u8, u32>(b2);
            let b2_bits = iand(b2_wide, 63_u32);
            let shifted1 = ishl.wrap(cp1, 6_u32);
            let cp2 = ior(shifted1, b2_bits);
            let c3_pos = c2_pos +wrap 1_u64;
            let has3 = c3_pos < length;
            if has3 {
              let b3 = source^[c3_pos];
              let ok3_lo = b3 >= 128_u8;
              let ok3_hi = b3 <= 191_u8;
              let ok3 = band(ok3_lo, ok3_hi);
              if ok3 {
                let b3_wide = cvt::<u8, u32>(b3);
                let b3_bits = iand(b3_wide, 63_u32);
                let shifted2 = ishl.wrap(cp2, 6_u32);
                let cp = ior(shifted2, b3_bits);
                let next = c3_pos +wrap 1_u64;
                return cp, next;
              }
            }
            return replacement_char, c3_pos;
          }
        }
        return replacement_char, c2_pos;
      }
    }
    return replacement_char, c1_pos;
  }
  let next = pos +wrap 1_u64;
  return replacement_char, next;
}

fn next_char(source: &[u8], pos: u64) -> (ch: u32, next: u64) reads(source) {
  doc "Decodes the next input character at pos under input stream preprocessing (13.2.3.5): CR LF and a lone CR both become one LF.";
  let (raw, after) = decode_one(source: source, pos: pos);
  let is_cr = raw == cr_char;
  if is_cr {
    let (peek, after2) = decode_one(source: source, pos: after);
    let is_lf = peek == lf_char;
    if is_lf {
      return lf_char, after2;
    }
    return lf_char, after;
  }
  return raw, after;
}
