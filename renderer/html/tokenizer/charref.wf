const max_scalar: u32 = 1114111_u32;

const out_of_range: u32 = 1200000_u32;

const c1_source: Array<u32, 27> =[128_u32, 130_u32, 131_u32, 132_u32, 133_u32, 134_u32, 135_u32, 136_u32, 137_u32, 138_u32, 139_u32, 140_u32, 142_u32, 145_u32, 146_u32, 147_u32, 148_u32, 149_u32, 150_u32, 151_u32, 152_u32, 153_u32, 154_u32, 155_u32, 156_u32, 158_u32, 159_u32];

const c1_target: Array<u32, 27> =[8364_u32, 8218_u32, 402_u32, 8222_u32, 8230_u32, 8224_u32, 8225_u32, 710_u32, 8240_u32, 352_u32, 8249_u32, 338_u32, 381_u32, 8216_u32, 8217_u32, 8220_u32, 8221_u32, 8226_u32, 8211_u32, 8212_u32, 732_u32, 8482_u32, 353_u32, 8250_u32, 339_u32, 382_u32, 376_u32];

fn numeric_reference_value(value: u32) -> result: u32 pure {
  doc "Applies the numeric character reference end state's replacements: a null value or one past the Unicode scalar range or a surrogate becomes U+FFFD, a Windows-1252 C1 control becomes its mapped scalar value, and every other value is unchanged.";
  let is_zero = value == 0_u32;
  if is_zero {
    return replacement_char;
  }
  let too_big = value > max_scalar;
  if too_big {
    return replacement_char;
  }
  let surrogate_lo = value >= 55296_u32;
  let surrogate_hi = value <= 57343_u32;
  let surrogate = band(surrogate_lo, surrogate_hi);
  if surrogate {
    return replacement_char;
  }
  let count = c1_source.len;
  let at = 0_u64;
  loop @scan {
    let more = at < count;
    if more {
    } else {
      break @scan;
    }
    let candidate = c1_source[at];
    let hit = candidate == value;
    if hit {
      return c1_target[at];
    }
    set at = at +wrap 1_u64;
  }
  return value;
}

fn digit_value(byte: u8) -> result: u32 pure {
  doc "Returns the value of byte as a hexadecimal digit, 0 for a byte that is not one.";
  let is_digit = is_ascii_digit(byte: byte);
  if is_digit {
    let widened = cvt::<u8, u32>(byte);
    return widened -wrap 48_u32;
  }
  let upper_lo = byte >= 65_u8;
  let upper_hi = byte <= 70_u8;
  let upper = band(upper_lo, upper_hi);
  if upper {
    let widened = cvt::<u8, u32>(byte);
    let ten = widened -wrap 55_u32;
    return ten;
  }
  let lower_lo = byte >= 97_u8;
  let lower_hi = byte <= 102_u8;
  let lower = band(lower_lo, lower_hi);
  if lower {
    let widened = cvt::<u8, u32>(byte);
    let ten = widened -wrap 87_u32;
    return ten;
  }
  return 0_u32;
}

fn consume_hex_digits(source: &[u8], start: u64) -> (value: u32, next: u64) reads(source) {
  doc "Consumes one or more ASCII hex digits from start, clamping the accumulated value above the valid scalar range instead of wrapping. Precondition: start names a hex digit.";
  let length = source^.len;
  let value = 0_u32;
  let at = start;
  loop @digits {
    let more = at < length;
    if more {
    } else {
      break @digits;
    }
    let byte = source^[at];
    let is_hex = is_ascii_hex(byte: byte);
    if is_hex {
    } else {
      break @digits;
    }
    let digit = digit_value(byte: byte);
    let too_big = value > max_scalar;
    if too_big {
      set value = out_of_range;
    } else {
      let shifted = value *wrap 16_u32;
      set value = shifted +wrap digit;
    }
    set at = at +wrap 1_u64;
  }
  return value, at;
}

fn consume_decimal_digits(source: &[u8], start: u64) -> (value: u32, next: u64) reads(source) {
  doc "Consumes one or more ASCII digits from start, clamping the accumulated value above the valid scalar range instead of wrapping. Precondition: start names a digit.";
  let length = source^.len;
  let value = 0_u32;
  let at = start;
  loop @digits {
    let more = at < length;
    if more {
    } else {
      break @digits;
    }
    let byte = source^[at];
    let is_digit = is_ascii_digit(byte: byte);
    if is_digit {
    } else {
      break @digits;
    }
    let digit = digit_value(byte: byte);
    let too_big = value > max_scalar;
    if too_big {
      set value = out_of_range;
    } else {
      let shifted = value *wrap 10_u32;
      set value = shifted +wrap digit;
    }
    set at = at +wrap 1_u64;
  }
  return value, at;
}

fn find_named_entity(source: &[u8], start: u64) -> (found: Bool, name_len: u64, cp1: u32, cp2: u32, has_cp2: Bool) reads(source) {
  doc "Finds the longest entity in entity_table whose name matches source at start; found is False when none does.";
  let length = source^.len;
  let count = entity_table.len;
  let best_len = 0_u64;
  let best_cp1 = 0_u32;
  let best_cp2 = 0_u32;
  let best_has2 = False();
  let index = 0_u64;
  loop @scan {
    let more = index < count;
    if more {
    } else {
      break @scan;
    }
    let record = entity_table[index];
    let name_len = record.name_len;
    let longer = name_len > best_len;
    if longer {
      let room = start <= length;
      let usable = if room {
        let remaining = length - start;
        give name_len <= remaining;
      } else {
        give False();
      }
      if usable {
        let matches = name_matches(source: source, start: start, name: record.name, name_len: name_len);
        if matches {
          set best_len = name_len;
          set best_cp1 = record.cp1;
          set best_cp2 = record.cp2;
          let has2 = record.cp2 != 0_u32;
          set best_has2 = has2;
        }
      }
    }
    set index = index +wrap 1_u64;
  }
  let found = best_len > 0_u64;
  return found, best_len, best_cp1, best_cp2, best_has2;
}

fn name_matches(source: &[u8], start: u64, name: Array<u8, 32>, name_len: u64) -> result: Bool reads(source) {
  doc "Tells whether source holds name's first name_len bytes starting at start. Precondition: start + name_len <= source^.len and name_len <= 32.";
  let i = 0_u64;
  loop @compare {
    let more = i < name_len;
    if more {
    } else {
      break @compare;
    }
    let cap_ok = i < 32_u64;
    if cap_ok {
    } else {
      return False();
    }
    let src_index = start +wrap i;
    let in_range = src_index < source^.len;
    if in_range {
    } else {
      return False();
    }
    let left = source^[src_index];
    let right = name[i];
    let differs = left != right;
    if differs {
      return False();
    }
    set i = i +wrap 1_u64;
  }
  return True();
}

fn resolve_character_reference(source: &[u8], pos: u64, in_attribute: Bool) -> (matched: Bool, next: u64, cp1: u32, cp2: u32, has_cp2: Bool) reads(source) {
  doc "Resolves the character reference that may start at pos, which names the ampersand. matched is False when pos should instead be treated as one literal ampersand, in which case next, cp1, cp2 and has_cp2 carry no meaning.";
  let length = source^.len;
  let amp_next = pos +wrap 1_u64;
  let has_first = amp_next < length;
  if has_first {
  } else {
    return False(), pos, 0_u32, 0_u32, False();
  }
  let c1 = source^[amp_next];
  let is_hash = c1 == 35_u8;
  if is_hash {
    let hash_next = amp_next +wrap 1_u64;
    let has_second = hash_next < length;
    if has_second {
    } else {
      return False(), pos, 0_u32, 0_u32, False();
    }
    let c2 = source^[hash_next];
    let is_x_lower = c2 == 120_u8;
    let is_x_upper = c2 == 88_u8;
    let is_x = bor(is_x_lower, is_x_upper);
    if is_x {
      let digits_start = hash_next +wrap 1_u64;
      let has_digit = digits_start < length;
      let first_hex = if has_digit {
        let byte = source^[digits_start];
        give is_ascii_hex(byte: byte);
      } else {
        give False();
      }
      if first_hex {
        let (raw, after_digits) = consume_hex_digits(source: source, start: digits_start);
        let has_semicolon = after_digits < length;
        let closed = if has_semicolon {
          let byte = source^[after_digits];
          give byte == 59_u8;
        } else {
          give False();
        }
        let final_pos = if closed {
          give after_digits +wrap 1_u64;
        } else {
          give after_digits;
        }
        let value = numeric_reference_value(value: raw);
        return True(), final_pos, value, 0_u32, False();
      }
      return False(), pos, 0_u32, 0_u32, False();
    }
    let first_digit = is_ascii_digit(byte: c2);
    if first_digit {
      let (raw, after_digits) = consume_decimal_digits(source: source, start: hash_next);
      let has_semicolon = after_digits < length;
      let closed = if has_semicolon {
        let byte = source^[after_digits];
        give byte == 59_u8;
      } else {
        give False();
      }
      let final_pos = if closed {
        give after_digits +wrap 1_u64;
      } else {
        give after_digits;
      }
      let value = numeric_reference_value(value: raw);
      return True(), final_pos, value, 0_u32, False();
    }
    return False(), pos, 0_u32, 0_u32, False();
  }
  let alnum = is_ascii_alnum(byte: c1);
  if alnum {
  } else {
    return False(), pos, 0_u32, 0_u32, False();
  }
  let (found, name_len, cp1, cp2, has_cp2) = find_named_entity(source: source, start: amp_next);
  if found {
  } else {
    return False(), pos, 0_u32, 0_u32, False();
  }
  let match_end = amp_next +wrap name_len;
  let last_index = match_end -wrap 1_u64;
  let ends_semicolon_ok = last_index < length;
  let ends_semicolon = if ends_semicolon_ok {
    let byte = source^[last_index];
    give byte == 59_u8;
  } else {
    give False();
  }
  if in_attribute {
    if ends_semicolon {
    } else {
      let has_next = match_end < length;
      let risky = if has_next {
        let byte = source^[match_end];
        let eq = byte == 61_u8;
        let word = is_ascii_alnum(byte: byte);
        give bor(eq, word);
      } else {
        give False();
      }
      if risky {
        return False(), pos, 0_u32, 0_u32, False();
      }
    }
  }
  return True(), match_end, cp1, cp2, has_cp2;
}
