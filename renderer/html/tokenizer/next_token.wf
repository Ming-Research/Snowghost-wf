fn next_token(tokenizer: &Tokenizer, source: &[u8], output: &TokenText) -> token: Token reads(source), writes(tokenizer), writes(output) contract {
  requires source^.len <= 1073741824_u64;
} {
  doc "Returns the next token of source under 13.2.5, starting at tokenizer's position in its current state. See module.wfm for the complete contract.";
  clear_output(output: output);
  match tokenizer^.state {
    Data() => {
      let token = scan_data(tokenizer: tokenizer, source: source, output: output);
      return token;
    }
    Rcdata() => {
      let allow_refs = True();
      let token = scan_foreign_text(tokenizer: tokenizer, source: source, output: output, allow_refs: allow_refs);
      return token;
    }
    Rawtext() => {
      let allow_refs = False();
      let token = scan_foreign_text(tokenizer: tokenizer, source: source, output: output, allow_refs: allow_refs);
      return token;
    }
    ScriptData() => {
      let token = scan_script_data(tokenizer: tokenizer, source: source, output: output);
      return token;
    }
    Plaintext() => {
      let token = scan_plaintext(tokenizer: tokenizer, source: source, output: output);
      return token;
    }
    CdataSection() => {
      let token = scan_cdata_section(tokenizer: tokenizer, source: source, output: output);
      return token;
    }
  }
}
