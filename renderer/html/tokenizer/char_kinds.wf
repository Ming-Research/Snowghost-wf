const tab_char: u32 = 9_u32;

const lf_char32: u32 = 10_u32;

const ff_char: u32 = 12_u32;

const space_char: u32 = 32_u32;

const quotation_char: u32 = 34_u32;

const amp_char: u32 = 38_u32;

const apostrophe_char: u32 = 39_u32;

const solidus_char: u32 = 47_u32;

const semicolon_char: u32 = 59_u32;

const less_than_char: u32 = 60_u32;

const equals_char: u32 = 61_u32;

const greater_than_char: u32 = 62_u32;

const question_char: u32 = 63_u32;

const grave_char: u32 = 96_u32;

const bang_char: u32 = 33_u32;

const left_bracket_char: u32 = 91_u32;

const right_bracket_char: u32 = 93_u32;

const dash_char: u32 = 45_u32;

fn is_char_whitespace(ch: u32) -> result: Bool pure {
  doc "Tells whether ch is tab, LF, FF, or space.";
  let a = ch == tab_char;
  let b = ch == lf_char32;
  let c = ch == ff_char;
  let d = ch == space_char;
  let e = bor(a, b);
  let f = bor(c, d);
  return bor(e, f);
}

fn ascii_lower_char(ch: u32) -> result: u32 pure {
  doc "Returns ch with an ASCII upper-case letter folded to lower case.";
  let low = ch >= 65_u32;
  let high = ch <= 90_u32;
  let upper = band(low, high);
  if upper {
    return ch +wrap 32_u32;
  }
  return ch;
}

fn replace_nul(ch: u32) -> result: u32 pure {
  doc "Returns U+FFFD for a NUL character and ch unchanged otherwise.";
  let is_nul = ch == 0_u32;
  if is_nul {
    return replacement_char;
  }
  return ch;
}
