fn is_char_whitespace(ch: u32) -> result: Bool pure {
  doc "Tells whether ch is tab, LF, FF, or space.";
  let a = ch == '\u{9}'_u32;
  let b = ch == '\n'_u32;
  let c = ch == '\u{c}'_u32;
  let d = ch == ' '_u32;
  let e = bor(a, b);
  let f = bor(c, d);
  return bor(e, f);
}

fn ascii_lower_char(ch: u32) -> result: u32 pure {
  doc "Returns ch with an ASCII upper-case letter folded to lower case.";
  let low = ch >= 65_u32;
  let high = ch <= 90_u32;
  let upper = band(low, high);
  if upper {
    return ch +wrap 32_u32;
  }
  return ch;
}

fn span_of(start: u64, end: u64) -> result: Span pure {
  doc "Returns the Span from start to end, narrowed to u32 by wrapping (token text never approaches 2^32 bytes in practice).";
  let start32 = cvt.wrap::<u64, u32>(start);
  let end32 = cvt.wrap::<u64, u32>(end);
  let span = Span(start: start32, end: end32);
  return span;
}

fn replace_nul(ch: u32) -> result: u32 pure {
  doc "Returns U+FFFD for a NUL character and ch unchanged otherwise.";
  let is_nul = ch == 0_u32;
  if is_nul {
    return replacement_char;
  }
  return ch;
}
