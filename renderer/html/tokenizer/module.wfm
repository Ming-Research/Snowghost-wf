public struct Span {
  public start: u32;
  public end: u32;
}

public enum ContentState {
  Data();
  Rcdata();
  Rawtext();
  ScriptData();
  Plaintext();
  CdataSection();
}

public struct Attribute {
  public name: Span;
  public value: Span;
}

public enum Token {
  Doctype(public name: Option<Span>, public public_id: Option<Span>, public system_id: Option<Span>, public force_quirks: Bool);
  StartTag(public name: Span, public first_attribute: u32, public end_attribute: u32, public self_closing: Bool);
  EndTag(public name: Span);
  Comment(public data: Span);
  Characters(public data: Span);
  EndOfFile();
}

public struct TokenText {
  public readonly text: Box<Slots<u8>>;
  public readonly attributes: Box<Slots<Attribute>>;
}

public struct Tokenizer {
  position: u64;
  state: ContentState;
  last_start_tag: Box<Slots<u8>>;
}

public fn token_text_new() -> made: TokenText pure doc "Returns empty token text storage for next_token to fill.";

public fn tokenizer_new(state: ContentState, last_start_tag: &[u8]) -> made: Tokenizer reads(last_start_tag) contract {
  requires last_start_tag^.len <= 1024_u64;
} doc "Returns a tokenizer at the start of its source in state, with last_start_tag as the name of the last start tag emitted, which decides whether an end tag is appropriate in the RCDATA, RAWTEXT and script data states.";

public fn tokenizer_set_state(tokenizer: &Tokenizer, state: ContentState) -> result: unit writes(tokenizer) doc "Switches the tokenizer to state before its next token, as the tree builder does after a start tag such as title or script.";

public fn next_token(tokenizer: &Tokenizer, source: &[u8], output: &TokenText) -> token: Token reads(source), writes(tokenizer), writes(output) contract {
  requires source^.len <= 1073741824_u64;
} doc "Returns the next token of source under the tokenization section of the WHATWG HTML Living Standard, starting at the tokenizer's position in its current state and advancing past the characters the token consumed. Source is the whole input stream as WTF-8, UTF-8 that may also encode lone surrogates. The tokenizer applies input stream preprocessing, so a CR or a CR LF pair becomes one LF, and decodes each maximal ill-formed subsequence as U+FFFD. Character references resolve with the standard's named and numeric character reference rules. Parse errors are not reported. Output is cleared at each call. Every Span indexes output.text, which holds the token's strings as WTF-8, a lone surrogate staying one. Tag, attribute and DOCTYPE names are lowercased in ASCII. A StartTag's attributes are output.attributes from first_attribute to end_attribute in source order, an attribute whose name repeats an earlier one dropped. A DOCTYPE's name and identifiers are absent when the source gave none. A run of characters may be split across consecutive Characters tokens, which consumers treat as one. Each StartTag's name becomes the tokenizer's last start tag. Once source is exhausted every call returns EndOfFile.";
