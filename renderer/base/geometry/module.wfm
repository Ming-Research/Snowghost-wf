public struct LayoutUnit {
  public raw: i32;
}

public struct Point {
  public x: LayoutUnit;
  public y: LayoutUnit;
}

public struct Size {
  public width: LayoutUnit;
  public height: LayoutUnit;
}

public struct Rect {
  public origin: Point;
  public size: Size;
}

public struct Sides {
  public top: LayoutUnit;
  public right: LayoutUnit;
  public bottom: LayoutUnit;
  public left: LayoutUnit;
}

public fn unit_from_pixels(pixels: i32) -> made: LayoutUnit pure doc "Returns pixels whole CSS pixels as a layout unit, saturating at the representable range.";

public fn unit_from_f64(pixels: f64) -> made: LayoutUnit pure doc "Returns pixels CSS pixels as the nearest layout unit, ties to even, saturating at the representable range; NaN becomes zero. This is the one rounding a computed length takes.";

public fn unit_to_f64(value: LayoutUnit) -> pixels: f64 pure doc "Returns value in CSS pixels, exactly.";

public fn unit_add(left: LayoutUnit, right: LayoutUnit) -> sum: LayoutUnit pure doc "Returns left plus right, saturating at the representable range.";

public fn unit_sub(left: LayoutUnit, right: LayoutUnit) -> difference: LayoutUnit pure doc "Returns left minus right, saturating at the representable range.";

public fn unit_min(left: LayoutUnit, right: LayoutUnit) -> least: LayoutUnit pure doc "Returns the smaller of left and right.";

public fn unit_max(left: LayoutUnit, right: LayoutUnit) -> greatest: LayoutUnit pure doc "Returns the larger of left and right.";

public fn rect_contains(rect: Rect, point: Point) -> inside: Bool pure doc "Returns whether point lies in rect, including its top and left edges and excluding its bottom and right edges.";

public fn rect_intersects(first: Rect, second: Rect) -> overlapping: Bool pure doc "Returns whether first and second share an area; rectangles that only touch do not.";
