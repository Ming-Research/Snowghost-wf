const units_per_pixel: i32 = 64_i32;

const lowest_raw: i32 = -2147483648_i32;

const highest_raw: i32 = 2147483647_i32;

fn unit_from_pixels(pixels: i32) -> made: LayoutUnit pure {
  doc "Scales by the units per pixel with saturating multiplication.";
  let raw = pixels *sat units_per_pixel;
  let made = LayoutUnit(raw: raw);
  return made;
}

fn unit_from_f64(pixels: f64) -> made: LayoutUnit pure {
  doc "Scales, rounds ties to even and converts; a value that does not convert (outside the range, or NaN) saturates by its sign, NaN taking zero.";
  let scaled = fmul.strict(pixels, 64.0_f64);
  let rounded = froundeven(scaled);
  match cvt.checked::<f64, i32>(rounded) {
    Ok(value: raw) => {
      let made = LayoutUnit(raw: raw);
      return made;
    }
    Err(error: outside) => {
      let above = fgt(rounded, 0.0_f64);
      if above {
        let highest = LayoutUnit(raw: highest_raw);
        return highest;
      }
      let below = flt(rounded, 0.0_f64);
      if below {
        let lowest = LayoutUnit(raw: lowest_raw);
        return lowest;
      }
      let zero = LayoutUnit(raw: 0_i32);
      return zero;
    }
  }
}

fn unit_to_f64(value: LayoutUnit) -> pixels: f64 pure {
  doc "Every i32 is exact in f64, and dividing by a power of two is exact.";
  let raw = value.raw;
  let wide = cvt::<i32, f64>(raw);
  let pixels = fdiv.strict(wide, 64.0_f64);
  return pixels;
}

fn unit_add(left: LayoutUnit, right: LayoutUnit) -> sum: LayoutUnit pure {
  doc "Adds the raw values with saturation.";
  let a = left.raw;
  let b = right.raw;
  let raw = a +sat b;
  let sum = LayoutUnit(raw: raw);
  return sum;
}

fn unit_sub(left: LayoutUnit, right: LayoutUnit) -> difference: LayoutUnit pure {
  doc "Subtracts the raw values with saturation.";
  let a = left.raw;
  let b = right.raw;
  let raw = a -sat b;
  let difference = LayoutUnit(raw: raw);
  return difference;
}

fn unit_min(left: LayoutUnit, right: LayoutUnit) -> least: LayoutUnit pure {
  doc "Compares the raw values.";
  let a = left.raw;
  let b = right.raw;
  let smaller = a <= b;
  if smaller {
    return left;
  }
  return right;
}

fn unit_max(left: LayoutUnit, right: LayoutUnit) -> greatest: LayoutUnit pure {
  doc "Compares the raw values.";
  let a = left.raw;
  let b = right.raw;
  let larger = a >= b;
  if larger {
    return left;
  }
  return right;
}

fn rect_contains(rect: Rect, point: Point) -> inside: Bool pure {
  doc "Half-open on both axes; the far edges are computed with saturation, so a rectangle at the edge of the range still contains its interior.";
  let far_x = unit_add(left: rect.origin.x, right: rect.size.width);
  let far_y = unit_add(left: rect.origin.y, right: rect.size.height);
  let px = point.x.raw;
  let py = point.y.raw;
  let ox = rect.origin.x.raw;
  let oy = rect.origin.y.raw;
  let fx = far_x.raw;
  let fy = far_y.raw;
  let right_of_left = px >= ox;
  let left_of_right = px < fx;
  let below_top = py >= oy;
  let above_bottom = py < fy;
  let within_x = band(right_of_left, left_of_right);
  let within_y = band(below_top, above_bottom);
  let inside = band(within_x, within_y);
  return inside;
}

fn rect_intersects(first: Rect, second: Rect) -> overlapping: Bool pure {
  doc "Two half-open rectangles overlap when each starts before the other ends on both axes.";
  let first_far_x = unit_add(left: first.origin.x, right: first.size.width);
  let first_far_y = unit_add(left: first.origin.y, right: first.size.height);
  let second_far_x = unit_add(left: second.origin.x, right: second.size.width);
  let second_far_y = unit_add(left: second.origin.y, right: second.size.height);
  let a_x = first.origin.x.raw;
  let a_y = first.origin.y.raw;
  let b_x = second.origin.x.raw;
  let b_y = second.origin.y.raw;
  let a_fx = first_far_x.raw;
  let a_fy = first_far_y.raw;
  let b_fx = second_far_x.raw;
  let b_fy = second_far_y.raw;
  let x_one = a_x < b_fx;
  let x_two = b_x < a_fx;
  let y_one = a_y < b_fy;
  let y_two = b_y < a_fy;
  let on_x = band(x_one, x_two);
  let on_y = band(y_one, y_two);
  let overlapping = band(on_x, on_y);
  return overlapping;
}
