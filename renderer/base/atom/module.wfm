public struct Atom {
  public index: u32;
}

public struct AtomSpan {
  public start: u32;
  public end: u32;
}

public struct AtomTable {
  public readonly text: Box<Slots<u8>>;
  public readonly spans: Box<Slots<AtomSpan>>;
  index: Box<Slots<u32>>;
}

public fn atom_table_new() -> made: AtomTable pure doc "Returns a table that holds the static atoms, each at the index its generated constant names, and nothing else.";

public fn atom_intern(table: &AtomTable, name: &[u8]) -> atom: Atom reads(name), writes(table) contract {
  requires name^.len <= 65536_u64;
} doc "Returns the atom whose text equals name byte for byte, adding it when the table has none; equal names always return equal atoms, so comparing two atoms compares their texts. The returned index is below the length of table.spans. The text of an atom at index i is table.text from table.spans[i].start to table.spans[i].end.";

public fn atom_find(table: &AtomTable, name: &[u8]) -> found: Option<Atom> reads(table), reads(name) doc "Returns the atom whose text equals name byte for byte, or None when the table has none; it never adds one.";
