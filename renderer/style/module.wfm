alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias BackgroundGroup = pkg::css::values::BackgroundGroup;
alias TrackList = pkg::css::values::TrackList;
alias Track = pkg::css::values::Track;
alias TableGroup = pkg::css::values::TableGroup;
alias QuotePair = pkg::css::values::QuotePair;
alias QuoteList = pkg::css::values::QuoteList;
alias NamedArea = pkg::css::values::NamedArea;
alias ItemGroup = pkg::css::values::ItemGroup;
alias CounterList = pkg::css::values::CounterList;
alias CounterChange = pkg::css::values::CounterChange;
alias ContentList = pkg::css::values::ContentList;
alias ContentItem = pkg::css::values::ContentItem;
alias ContentGroup = pkg::css::values::ContentGroup;
alias ContainerGroup = pkg::css::values::ContainerGroup;
alias AreaMap = pkg::css::values::AreaMap;
alias BorderGroup = pkg::css::values::BorderGroup;
alias BoxGroup = pkg::css::values::BoxGroup;
alias FeatureFilter = pkg::css::selectors::FeatureFilter;
alias FeatureReach = pkg::css::selectors::FeatureReach;
alias SubjectKey = pkg::css::selectors::SubjectKey;
alias ComponentList = pkg::css::syntax::ComponentList;
alias DeclarationStore = pkg::css::values::DeclarationStore;
alias Declared = pkg::css::values::Declared;
alias Document = pkg::dom::Document;
alias Environment = pkg::css::values::Environment;
alias Family = pkg::css::values::Family;
alias FontGroup = pkg::css::values::FontGroup;
alias NodeId = pkg::dom::NodeId;
alias Positions = pkg::css::selectors::Positions;
alias SelectorList = pkg::css::selectors::SelectorList;
alias SizeGroup = pkg::css::values::SizeGroup;
alias Sizing = pkg::css::values::Sizing;
alias SpacingGroup = pkg::css::values::SpacingGroup;
alias TextGroup = pkg::css::values::TextGroup;
alias TextSpan = pkg::dom::TextSpan;

public const origin_user_agent: u8 = 0_u8;

public const origin_author: u8 = 1_u8;

public const pseudo_before: u8 = 0_u8;

public const pseudo_after: u8 = 1_u8;

public enum StyleError {
  TooLarge();
  Inconsistent();
}

struct Sheet {
  values: ComponentList;
}

struct Rule {
  selectors: SelectorList;
  origin: u8;
  first: u32;
  end: u32;
  custom_first: u32;
  custom_end: u32;
  custom_slot: u32;
  uniform: Bool;
  packed: u64;
  features: FeatureFilter;
}

struct CustomDeclaration {
  name: Atom;
  sheet: u32;
  start: u32;
  end: u32;
  important: Bool;
  origin: u8;
}

struct AttributeStyle {
  doc "The declarations recorded at load for one element's style attribute or presentational hints; node is the element's NodeId index, which an edit to the document does not change.";
  node: u32;
  first: u32;
  end: u32;
  custom_first: u32;
  custom_end: u32;
}

public struct RuleStore {
  sheets: Box<Slots<Sheet>>;
  rules: Box<Slots<Rule>>;
  declared: DeclarationStore;
  customs: Box<Slots<CustomDeclaration>>;
  custom_rules: Box<Slots<u32>>;
  attributes: Box<Slots<AttributeStyle>>;
  hints: Box<Slots<AttributeStyle>>;
  attribute_at: Box<Array<u32>>;
  hint_at: Box<Array<u32>>;
  reaches: Box<Slots<FeatureReach>>;
  reaches_complete: Bool;
}

public enum SheetSource {
  StyleElement(public node: NodeId);
  Link(public node: NodeId, public href: TextSpan, public media: Option<TextSpan>);
}

public struct Traversal {
  public readonly elements: Box<Slots<NodeId>>;
  public readonly parents: Box<Slots<u32>>;
  depths: Box<Slots<u32>>;
  public readonly order: Box<Array<u32>>;
}

public struct Cascade {
  positions: Positions;
  winners: Box<Array<u32>>;
  custom_keys: Box<Array<u64>>;
  custom_count: u64;
  element_count: u64;
  nodes: Box<Array<NodeId>>;
  parents: Box<Array<u32>>;
  kinds: Box<Array<u8>>;
}

struct Resolved {
  node: u32;
  longhand: u8;
  valid: Bool;
  value: Declared;
}

struct TrackNodes {
  columns: u32;
  rows: u32;
  auto_columns: u32;
  auto_rows: u32;
}

struct CustomEntry {
  name: Atom;
  start: u32;
  end: u32;
}

struct CustomSet {
  first: u32;
  end: u32;
}

public struct Inherited {
  fonts: Box<Array<FontGroup>>;
  texts: Box<Array<TextGroup>>;
  visibility: Box<Array<u8>>;
  font_keywords: Box<Array<u8>>;
  font_scales: Box<Array<f32>>;
  ex: Box<Array<f32>>;
  ch: Box<Array<f32>>;
  lh: Box<Array<f32>>;
  sets: Box<Array<u32>>;
  custom_sets: Box<Slots<CustomSet>>;
  custom_entries: Box<Slots<CustomEntry>>;
  custom_text: Box<Slots<u8>>;
  named: DeclarationStore;
  initial_family: u32;
  disc: Atom;
  monospace: Atom;
  root_font_size: f32;
  tables: Box<Array<TableGroup>>;
  quotes: Box<Array<u32>>;
  list_positions: Box<Array<u8>>;
  resolved: Box<Slots<Resolved>>;
  resolved_first: Box<Array<u32>>;
  resolved_end: Box<Array<u32>>;
  resolves: Bool;
  environment: Environment;
  pseudo_parents: Box<Slots<u32>>;
  pseudo_kinds: Box<Slots<u8>>;
}

public struct Resets {
  boxes: Box<Array<BoxGroup>>;
  sizes: Box<Array<SizeGroup>>;
  spacings: Box<Array<SpacingGroup>>;
  borders: Box<Array<BorderGroup>>;
  backgrounds: Box<Array<BackgroundGroup>>;
  vertical_aligns: Box<Array<Sizing>>;
  decorations: Box<Array<u8>>;
  containers: Box<Array<ContainerGroup>>;
  track_nodes: Box<Array<TrackNodes>>;
  items: Box<Array<ItemGroup>>;
  table_layouts: Box<Array<u8>>;
  contents: Box<Array<ContentGroup>>;
}

public struct RestyleSet {
  doc "The elements an edit requires matching again, by preorder index in ascending order, or full when the whole document must be; pseudos when a rule that reached them ends in ::before or ::after, so that which pseudo-elements they have can change; edited the element whose class changed, whose class words restyle indexes again.";
  public full: Bool;
  public elements: Box<Slots<u32>>;
  public pseudos: Bool;
  public edited: NodeId;
}

public struct StructureSet {
  doc "The elements, by NodeId in no particular order, whose matched rules an insertion or removal of a child of one parent can change, apart from the inserted subtree, or full when the whole document must be matched again; pseudos when a rule that reached them ends in ::before or ::after.";
  public full: Bool;
  public nodes: Box<Slots<NodeId>>;
  public pseudos: Bool;
}

public struct ComputedStyle {
  public box: u32;
  public size: u32;
  public spacing: u32;
  public border: u32;
  public font: u32;
  public text: u32;
  public background: u32;
  public custom: u32;
  public container: u32;
  public item: u32;
  public table: u32;
  public content: u32;
}

public struct PseudoStyle {
  public element: u32;
  public kind: u8;
  public style: ComputedStyle;
}

struct RuleIndex {
  doc "The rules a styled node may match, by the key of their subject compound: bucket b's rule numbers are entries[starts[b]..starts[b + 1]], and anything lists the rules with an alternative keyed Anything.";
  starts: Box<Array<u64>>;
  entries: Box<Array<u32>>;
  anything: Box<Slots<u32>>;
}

struct WordTable {
  doc "Word sequences interned by open addressing: each distinct sequence's words from its start, slots holding one-based entry numbers.";
  words: Box<Slots<u64>>;
  starts: Box<Slots<u64>>;
  slots: Box<Array<u32>>;
  mask: u64;
}

struct KeptTables {
  doc "The tables a style run interns into, kept across runs with Styles: the open-addressing indexes of the seven hashed groups, the word tables of the other groups and their lists, and the canonical identifier of each custom-property set with its index. They are one field of Styles so that a module holding a Styles meets one private field, not eighteen.";
  box_index: Box<Array<u32>>;
  size_index: Box<Array<u32>>;
  spacing_index: Box<Array<u32>>;
  border_index: Box<Array<u32>>;
  font_index: Box<Array<u32>>;
  text_index: Box<Array<u32>>;
  background_index: Box<Array<u32>>;
  item_words: WordTable;
  table_words: WordTable;
  container_words: WordTable;
  track_words: WordTable;
  area_words: WordTable;
  content_words: WordTable;
  content_list_words: WordTable;
  counter_words: WordTable;
  quote_words: WordTable;
  custom_canon: Box<Slots<u32>>;
  custom_index: Box<Array<u32>>;
}

public struct Styles {
  public readonly elements: Box<Array<ComputedStyle>>;
  public readonly boxes: Box<Slots<BoxGroup>>;
  public readonly sizes: Box<Slots<SizeGroup>>;
  public readonly spacings: Box<Slots<SpacingGroup>>;
  public readonly borders: Box<Slots<BorderGroup>>;
  public readonly fonts: Box<Slots<FontGroup>>;
  public readonly texts: Box<Slots<TextGroup>>;
  public readonly backgrounds: Box<Slots<BackgroundGroup>>;
  public readonly families: Box<Slots<Family>>;
  public readonly custom_sets: u64;
  public readonly containers: Box<Slots<ContainerGroup>>;
  public readonly items: Box<Slots<ItemGroup>>;
  public readonly tables: Box<Slots<TableGroup>>;
  public readonly contents: Box<Slots<ContentGroup>>;
  public readonly tracks: Box<Slots<Track>>;
  public readonly track_lists: Box<Slots<TrackList>>;
  public readonly line_names: Box<Slots<Atom>>;
  public readonly area_maps: Box<Slots<AreaMap>>;
  public readonly named_areas: Box<Slots<NamedArea>>;
  public readonly content_lists: Box<Slots<ContentList>>;
  public readonly content_items: Box<Slots<ContentItem>>;
  public readonly counter_lists: Box<Slots<CounterList>>;
  public readonly counter_changes: Box<Slots<CounterChange>>;
  public readonly quote_lists: Box<Slots<QuoteList>>;
  public readonly quote_pairs: Box<Slots<QuotePair>>;
  public readonly generated_text: Box<Slots<u8>>;
  public readonly pseudos: Box<Slots<PseudoStyle>>;
  public readonly order: Box<Array<u32>>;
  kept: KeptTables;
}

public struct StyleState {
  doc "The style stage kept across edits: the three parts' per-node results, the computed styles with their kept tables, the rule indexes, each element's pseudo-elements, and a mark per styled node that is 0 between restyles.";
  cascade: Cascade;
  inherited: Inherited;
  resets: Resets;
  public readonly styles: Styles;
  index: RuleIndex;
  pseudo_index: RuleIndex;
  pseudo_flags: Box<Array<u8>>;
  pseudo_first: Box<Array<u32>>;
  marks: Box<Array<u8>>;
}

public const changed_boxes_only: u32 = 2147483648_u32;

public struct Restyled {
  doc "What a restyle did: full when it rebuilt every node; structural when an input of box construction changed (display, position, float, overflow, multi-column, list marker, generated content, counters, quotes, or which pseudo-elements an element has), which pkg::layout reads by building boxes again; visited the elements it computed again; and changed, in the order computed, each element whose computed style or a pseudo-element's changed in what layout reads (all but colours, the custom-property set and, of the background, more than whether it is present), or whose set of pseudo-elements changed, by its preorder position, with changed_boxes_only added when its font, text, table and content values, which its own text and inline boxes read, are the same and no pseudo-element of it changed.";
  public full: Bool;
  public structural: Bool;
  public visited: u64;
  public changed: Box<Slots<u32>>;
}

public fn rule_store_new() -> made: RuleStore pure doc "Returns a store that holds no sheet, rule or declaration.";

public fn add_sheet(store: &RuleStore, source: &[u8], origin: u8, environment: Environment, atoms: &AtomTable) -> result: Result<unit, StyleError> reads(source), writes(store), writes(atoms) contract {
  requires source^.len <= 16777216_u64;
} doc "Parses source as a style sheet of the given origin with pkg::css::syntax and pkg::css::rules and appends its style rules to store in source order, keeping the sheet's component values for var() substitution. Each style rule's selector list is parsed by pkg::css::selectors (a rule it rejects is skipped) and each declaration by pkg::css::values::parse_declaration, except custom properties, whose names start with two hyphens and whose values are kept as component ranges. The rules inside an @media block whose media query list holds in environment, as media_holds decides, and inside an @supports block whose condition holds, at any depth, are taken; every other at-rule (@import, @font-face, @keyframes, @page, @namespace, @layer) and its contents is skipped. An @supports declaration condition holds when parse_declaration accepts the declaration or its name is a custom property; a selector() condition when pkg::css::selectors parses the selector; not, and and or combine conditions.";

public fn sheet_sources(document: &Document, traversal: &Traversal) -> made: Box<Slots<SheetSource>> reads(document), reads(traversal) doc "Returns the style sheets of document in tree order: each style element in the HTML namespace, and each link element in the HTML namespace whose rel attribute holds the word stylesheet, ASCII case-insensitively, and which has an href attribute, with that href and its media attribute when it has one. The renderer has no network, so the caller reads each link's sheet.";

public fn add_style_element(store: &RuleStore, document: &Document, node: NodeId, environment: Environment, atoms: &AtomTable) -> result: Result<unit, StyleError> reads(document), writes(store), writes(atoms) doc "Adds, as add_sheet does with the author origin, the concatenated data of the Text children of the style element node, unless it has a media attribute whose media query list does not hold in environment or a type attribute that is neither empty nor text/css ASCII case-insensitively.";

public fn media_holds(document: &Document, span: TextSpan, environment: Environment) -> holds: Bool reads(document) doc "Returns whether the media query list in the document text span holds for a screen of environment's width and height, in CSS pixels, with a pointer, hover, a light color scheme, no preference for reduced motion, scripting off and a resolution of one device pixel per CSS pixel: media types all and screen hold and every other type does not; the features width, height, aspect-ratio, orientation, resolution, -webkit-device-pixel-ratio, color, monochrome, hover, any-hover, pointer, any-pointer, prefers-color-scheme, prefers-reduced-motion, prefers-contrast and scripting are answered with their min- and max- prefixes and the range syntax of Media Queries Level 4; an unknown feature or a query that does not parse makes its query false; an empty list holds.";

public fn add_style_attributes(store: &RuleStore, document: &Document, traversal: &Traversal, atoms: &AtomTable) -> result: Result<unit, StyleError> reads(document), reads(traversal), writes(store), writes(atoms) doc "Parses the style attribute of each element of traversal in the HTML, SVG or MathML namespace, in preorder, as a declaration list of the author origin that applies to that element alone, after every rule and with a specificity above any selector's, recorded by the element's NodeId so that a later insertion or removal of elements leaves it with its element. It is called after every sheet has been added.";

public fn add_presentational_hints(store: &RuleStore, document: &Document, traversal: &Traversal, atoms: &AtomTable) -> result: Result<unit, StyleError> reads(document), reads(traversal), writes(store), writes(atoms) doc "Records, for each element of traversal in the HTML namespace, in preorder, the presentational hints of the HTML Standard's rendering section that depend on attribute values, as a declaration list, recorded by the element's NodeId, that match_elements offers in the user-agent layer with a specificity above every selector's, so an author declaration always wins over a hint and a hint over every normal user-agent rule: the width and height attributes of img, video, embed, iframe, object and an image input as dimensions, and of img, video and an image input as aspect-ratio auto w / h when neither is a percentage; canvas's as aspect-ratio when both are non-negative integers; a table's width (ignoring zero) and height, cellspacing as border-spacing and border as its border widths, 1px when the value does not parse; the width of col and hr; the height of tr, thead, tbody and tfoot; a td's or th's width and height (ignoring zero), its table's cellpadding as its padding; and, for a table whose border attribute is not equivalent to zero, the rules the standard gives table[border] and its cells under that condition, border-style outset on the table and a 1px inset border on each cell of table > tr or table > thead, tbody or tfoot > tr. It is called after add_style_attributes; static hints, whose selectors express them, are in the user-agent sheet.";

public fn rule_count(store: &RuleStore) -> count: u64 reads(store) doc "Returns the number of style rules store holds.";

public fn build_traversal(document: &Document) -> result: Result<Traversal, StyleError> reads(document) doc "Returns document's Element nodes in tree order (preorder), which a walk from the document root through first children and next siblings visits; template contents are not in the tree. parents holds, at each element's preorder index, its parent element's preorder index, or the number of elements for an element whose parent is no element; the walk also records each element's depth, which the pass in document order checks and groups into tree levels. order holds, at each node's NodeId index, that element's preorder index, or 4294967295 for a node that is no element of the traversal.";

public fn match_elements(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal) -> result: Result<Cascade, StyleError> reads(store), reads(document), reads(atoms), reads(traversal) doc "The first part of the stage. A counted loop over the elements finds which ::before and ::after some rule with a longhand declaration matches, through a second rule index keyed by the compound before the pseudo-element; those pseudo-elements are numbered after the elements, in document order of their elements, ::before before ::after, and the styled nodes are the elements in preorder followed by them, each pseudo-element's parent being its element. Then one counted loop over the styled nodes, whose iteration writes only its node's slots, tests the rules a rule index offers with pkg::css::selectors::matching_specificity, or pseudo_matching_specificity for a pseudo-element, and keeps, for each longhand, the declaration of the largest cascade key among the matching rules, an element's presentational hints and its style attribute: origin and importance (user agent normal, author normal, author important, user agent important), then specificity, then order of appearance. It also records, for each rule that sets custom properties, the specificity with which it matched, so the pass in document order chooses custom properties without matching again.";

public fn inherited_pass(store: &RuleStore, cascade: &Cascade, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Inherited, StyleError> reads(store), reads(cascade), reads(document), reads(traversal), writes(atoms) doc "The second part, a cascade of the styled nodes one tree level at a time, so a parent is computed before its children: each level's elements in one counted loop, then the pseudo-elements in one, the nodes that declare custom properties or hold a pending value that writes a shared table computed after their level's loop in document order. It computes each node's custom properties, substituting var() in their values against its parent's and its own, and the inherited longhands, the font longhands with font-size first, the text longhands and the inherited table and generated-content longhands, from each node's winning declarations and its parent's computed values, substituting var() where a winning declaration holds one. A node that declares no custom property shares its parent's set. It also substitutes and parses each pending winning value of a longhand that is not inherited but whose value names atoms or fills the store's side tables (the grid templates, implicit tracks and lines, content and the counters), since that writes shared tables; the third part reads the result.";

public fn reset_pass(store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Resets, StyleError> reads(store), reads(cascade), reads(inherited), reads(atoms), reads(traversal) doc "The third part, one counted loop over the styled nodes whose iteration writes only its node's slots: it computes the longhands that are not inherited from the node's winning declarations, its own font size and custom properties from the second part, substituting var() in a buffer of its own; an explicit inherit, and the blockification of a flex or grid container's children, read the parent's declarations again by walking up the ancestors, so no node waits for another. List values (track lists, area maps, content and counter lists) are kept as references to the second part's store with the node whose font their lengths use; content normal of a pseudo-element computes to none.";

public fn intern_styles(inherited: &Inherited, resets: &Resets, traversal: &Traversal) -> result: Result<Styles, StyleError> reads(inherited), reads(resets), reads(traversal) doc "Interns each of the eleven value groups in its own table and the custom-property sets by their entries, as twelve independent tasks, and returns every element's identifiers in preorder and every pseudo-element's in pseudos, in the order of the styled nodes; the custom identifier is the first set with the element's entries, and custom_sets the number of distinct sets. The container and content tasks also intern the lists their groups name, computing track lengths against the font of the node they come from: track_lists[0] is none and [1] one auto track, area_maps[0] none, content_lists[0] normal and [1] none, counter_lists[0] none, quote_lists[0] auto and [1] none. Equal groups, equal lists and equal sets get equal identifiers. order is a copy of traversal's, so a consumer that names an element by its NodeId finds its identifiers without the traversal.";

public fn structural_restyle(store: &RuleStore, document: &Document, atoms: &AtomTable, parent: NodeId) -> result: Result<StructureSet, StyleError> reads(store), reads(document), reads(atoms) doc "The elements whose matched rules, and so whose winning declarations, inserting or removing a child of parent can change, from the structural reaches add_sheet recorded for every rule (pkg::css::selectors::feature_reaches): position pseudo-classes, sibling combinators and :empty. They are parent's remaining element children that carry a reached subject key, the elements of their subtrees that carry a key reached downward, and parent itself for :empty. full when a reach names any element or reaches past parent, or when the store's reaches are incomplete. The inserted subtree is matched by the caller. Only parent's children and the subtrees the reaches name are walked, through the document's links, so the cost follows them and not the document.";

public fn class_restyle(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, node: NodeId, class: &[u8]) -> result: Result<RestyleSet, StyleError> reads(store), reads(document), reads(atoms), reads(traversal), reads(class) doc "The elements whose matched rules, and so whose winning declarations, adding or removing the class word class on the element node can change, from the class reaches add_sheet recorded for every rule (pkg::css::selectors::feature_reaches) whose class is class, by name_hash, or that hold for every class: node itself for a reach of the subject compound; its descendants, its later siblings and their descendants that carry the reach's subject key, for the others. Only the reaches and the elements they name are read, so the cost follows the store's reach count and the elements in the reached ranges. full when a reach names any element (reach_all), when the store's reaches are incomplete or when node is no element of traversal. Elements whose inherited values change only through a restyled ancestor are not in the set; the level cascade finds them.";

public fn rematched(old: &Cascade, new: &Cascade) -> changed: Box<Array<Bool>> reads(old), reads(new) doc "For two results of match_elements over documents with the same elements and the same store, says for each element, at its preorder index, whether its winning declarations or its custom-rule keys differ, or those of one of its pseudo-elements, or which pseudo-elements it has; every element when the element counts differ. The check a restyle set answers to: an element it flags must be in the set.";

public fn style_state(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<StyleState, StyleError> reads(store), reads(document), reads(traversal), writes(atoms) doc "Runs the stage as compute_styles does and keeps what restyle reads: the rule indexes, the three parts' results and each element's pseudo-elements; state.styles is compute_styles's result.";

public fn restyle(state: &StyleState, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment, wanted: &RestyleSet) -> result: Result<Restyled, StyleError> reads(store), reads(document), reads(traversal), reads(wanted), writes(state), writes(atoms) doc "Brings state up to date with document after an edit whose restyle set is wanted (class_restyle), the elements and the store otherwise unchanged: it matches the set's elements and their pseudo-elements again, then computes, one tree level at a time from the set's shallowest element, the elements of the set and the children of each element in the set or whose inherited values or style changed, with their pseudo-elements, interning into the kept tables, so an unchanged value keeps its identifier and state.styles equals in value what compute_styles gives for document. A full set or a change in which pseudo-elements an element of the set has computes every node again instead, still into the kept tables; a change of the root's font size restyles the elements whose winning declarations can read it with the levels, and computes every node again without matching when they pass a share of the elements.";

public fn pseudo_reads_attribute(state: &StyleState, element: u64, name: Atom) -> reads_name: Bool reads(state) doc "Whether a generated ::before or ::after of the element at preorder index element, in state's styles, has content reading the element's attribute name through attr(), which box construction resolves; True when its lists cannot be read.";

public fn compute_styles(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Styles, StyleError> reads(store), reads(document), reads(traversal), writes(atoms) doc "Runs match_elements, inherited_pass, reset_pass and intern_styles in turn.";

public fn layout_changes(old: &Styles, new: &Styles) -> changed: Box<Array<Bool>> reads(old), reads(new) doc "For two results of compute_styles over the same document, before and after an edit, says for each node, at its NodeId index, whether anything layout reads differs in value between old and new: its box, size, spacing, border, font, text, container, item, table or content group, with the lists those groups name, or the style of one of its pseudo-elements, or which pseudo-elements it has. Background contributes only whether its colour is currentColor or has positive alpha, which layout reads when choosing inline fragments; its exact colour and custom-property groups are not compared. A node that is an element in one result only counts as changed, and one that is an element in neither as unchanged. Group identifiers are not comparable across two runs, so it first maps each table of old onto new by value, once per table; its cost then follows the tables' sizes and the element count.";
