  let equal_count = old_count == new_count;
  if equal_count {
  } else {
    return False();
  }
  let equal_rows = first.rows == second.rows;
  let equal_columns = first.columns == second.columns;
  let equal_declared = old_declared == new_declared;
  let equal_items = True();
  for (offset in 0_u64..old_count) {
    let old_entry = old_start +sat offset;
    let new_entry = new_start +sat offset;
    let old_valid = old_entry < old^.named_areas.inner.len;
    let new_valid = new_entry < new^.named_areas.inner.len;
    let entries_inside = band(old_valid, new_valid);
    let equal_item = if entries_inside {
      let equal = delta_area_value(first: old^.named_areas.inner[old_entry], second: new^.named_areas.inner[new_entry]);
