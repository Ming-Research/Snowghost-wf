alias LengthPercentage = pkg::css::values::LengthPercentage;
alias Sizing = pkg::css::values::Sizing;
alias Track = pkg::css::values::Track;
alias NamedArea = pkg::css::values::NamedArea;
alias ContentItem = pkg::css::values::ContentItem;
alias CounterChange = pkg::css::values::CounterChange;
alias QuotePair = pkg::css::values::QuotePair;
alias Family = pkg::css::values::Family;
alias Atom = pkg::base::atom::Atom;
alias AreaMap = pkg::css::values::AreaMap;
alias BorderGroup = pkg::css::values::BorderGroup;
alias BoxGroup = pkg::css::values::BoxGroup;
alias ContainerGroup = pkg::css::values::ContainerGroup;
alias ContentGroup = pkg::css::values::ContentGroup;
alias FontGroup = pkg::css::values::FontGroup;
alias GridLine = pkg::css::values::GridLine;
alias ItemGroup = pkg::css::values::ItemGroup;
alias LineNames = pkg::css::values::LineNames;
alias SizeGroup = pkg::css::values::SizeGroup;
alias SpacingGroup = pkg::css::values::SpacingGroup;
alias TableGroup = pkg::css::values::TableGroup;
alias TextGroup = pkg::css::values::TextGroup;
alias TrackBreadth = pkg::css::values::TrackBreadth;
alias TrackList = pkg::css::values::TrackList;

fn delta_float_value(first: f32, second: f32) -> same: Bool pure {
  doc "Compares exact float words, preserving the former value keys' negative-zero normalization and other bit patterns.";
  let first_word = exact_word(value: first);
  let second_word = exact_word(value: second);
  let same = first_word == second_word;
  return same;
}

fn delta_lp_value(first: LengthPercentage, second: LengthPercentage) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two LengthPercentage values independently.";
  let equal_0 = delta_float_value(first: first.px, second: second.px);
  let equal_1 = delta_float_value(first: first.percent, second: second.percent);
  let equal_2 = eeq(first.has_percent, second.has_percent);
  let both_0_0 = band(equal_0, equal_1);
  let both_1_0 = band(both_0_0, equal_2);
  return both_1_0;
}

fn delta_sizing_value(first: Sizing, second: Sizing) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two Sizing values independently.";
  let equal_0 = first.kind == second.kind;
  let equal_1 = first.keyword == second.keyword;
  let equal_2 = delta_lp_value(first: first.value, second: second.value);
  let both_0_0 = band(equal_0, equal_1);
  let both_1_0 = band(both_0_0, equal_2);
  return both_1_0;
}

fn delta_box_value(first: BoxGroup, second: BoxGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two BoxGroup values independently.";
  let equal_0 = first.display == second.display;
  let equal_1 = first.position == second.position;
  let equal_2 = first.float == second.float;
  let equal_3 = first.clear == second.clear;
  let equal_4 = first.overflow_x == second.overflow_x;
  let equal_5 = first.overflow_y == second.overflow_y;
  let equal_6 = first.box_sizing == second.box_sizing;
  let equal_7 = first.visibility == second.visibility;
  let equal_8 = eeq(first.z_auto, second.z_auto);
  let equal_9 = first.z_index == second.z_index;
  let equal_10 = first.unicode_bidi == second.unicode_bidi;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_0_4 = band(equal_8, equal_9);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_1_2 = band(both_0_4, equal_10);
  let both_2_0 = band(both_1_0, both_1_1);
  let both_3_0 = band(both_2_0, both_1_2);
  return both_3_0;
}

fn delta_size_value(first: SizeGroup, second: SizeGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two SizeGroup values independently.";
  let equal_0 = delta_sizing_value(first: first.width, second: second.width);
  let equal_1 = delta_sizing_value(first: first.height, second: second.height);
  let equal_2 = delta_sizing_value(first: first.min_width, second: second.min_width);
  let equal_3 = delta_sizing_value(first: first.min_height, second: second.min_height);
  let equal_4 = delta_sizing_value(first: first.max_width, second: second.max_width);
  let equal_5 = delta_sizing_value(first: first.max_height, second: second.max_height);
  let equal_6 = eeq(first.aspect_auto, second.aspect_auto);
  let equal_7 = delta_float_value(first: first.aspect_width, second: second.aspect_width);
  let equal_8 = delta_float_value(first: first.aspect_height, second: second.aspect_height);
  let equal_9 = delta_sizing_value(first: first.top, second: second.top);
  let equal_10 = delta_sizing_value(first: first.right, second: second.right);
  let equal_11 = delta_sizing_value(first: first.bottom, second: second.bottom);
  let equal_12 = delta_sizing_value(first: first.left, second: second.left);
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_0_4 = band(equal_8, equal_9);
  let both_0_5 = band(equal_10, equal_11);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_1_2 = band(both_0_4, both_0_5);
  let both_2_0 = band(both_1_0, both_1_1);
  let both_2_1 = band(both_1_2, equal_12);
  let both_3_0 = band(both_2_0, both_2_1);
  return both_3_0;
}

fn delta_spacing_value(first: SpacingGroup, second: SpacingGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two SpacingGroup values independently.";
  let equal_0 = delta_sizing_value(first: first.margin_top, second: second.margin_top);
  let equal_1 = delta_sizing_value(first: first.margin_right, second: second.margin_right);
  let equal_2 = delta_sizing_value(first: first.margin_bottom, second: second.margin_bottom);
  let equal_3 = delta_sizing_value(first: first.margin_left, second: second.margin_left);
  let equal_4 = delta_lp_value(first: first.padding_top, second: second.padding_top);
  let equal_5 = delta_lp_value(first: first.padding_right, second: second.padding_right);
  let equal_6 = delta_lp_value(first: first.padding_bottom, second: second.padding_bottom);
  let equal_7 = delta_lp_value(first: first.padding_left, second: second.padding_left);
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_2_0 = band(both_1_0, both_1_1);
  return both_2_0;
}

fn delta_border_value(first: BorderGroup, second: BorderGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two BorderGroup values independently.";
  let equal_0 = delta_float_value(first: first.top_width, second: second.top_width);
  let equal_1 = delta_float_value(first: first.right_width, second: second.right_width);
  let equal_2 = delta_float_value(first: first.bottom_width, second: second.bottom_width);
  let equal_3 = delta_float_value(first: first.left_width, second: second.left_width);
  let equal_4 = first.top_style == second.top_style;
  let equal_5 = first.right_style == second.right_style;
  let equal_6 = first.bottom_style == second.bottom_style;
  let equal_7 = first.left_style == second.left_style;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_2_0 = band(both_1_0, both_1_1);
  return both_2_0;
}

fn delta_text_value(first: TextGroup, second: TextGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two TextGroup values independently.";
  let equal_0 = first.text_align == second.text_align;
  let equal_1 = delta_lp_value(first: first.text_indent, second: second.text_indent);
  let equal_2 = first.text_transform == second.text_transform;
  let equal_3 = first.white_space == second.white_space;
  let equal_4 = delta_sizing_value(first: first.letter_spacing, second: second.letter_spacing);
  let equal_5 = delta_sizing_value(first: first.word_spacing, second: second.word_spacing);
  let equal_6 = delta_sizing_value(first: first.vertical_align, second: second.vertical_align);
  let equal_7 = first.decoration_line == second.decoration_line;
  let equal_8 = first.list_style_type.index == second.list_style_type.index;
  let equal_9 = first.overflow_wrap == second.overflow_wrap;
  let equal_10 = first.word_break == second.word_break;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_0_4 = band(equal_8, equal_9);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_1_2 = band(both_0_4, equal_10);
  let both_2_0 = band(both_1_0, both_1_1);
  let both_3_0 = band(both_2_0, both_1_2);
  return both_3_0;
}

fn delta_line_value(first: GridLine, second: GridLine) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two GridLine values independently.";
  let equal_0 = first.kind == second.kind;
  let equal_1 = first.number == second.number;
  let equal_2 = first.name.index == second.name.index;
  let equal_3 = eeq(first.named, second.named);
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_1_0 = band(both_0_0, both_0_1);
  return both_1_0;
}

fn delta_item_value(first: ItemGroup, second: ItemGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two ItemGroup values independently.";
  let equal_0 = first.order == second.order;
  let equal_1 = delta_float_value(first: first.grow, second: second.grow);
  let equal_2 = delta_float_value(first: first.shrink, second: second.shrink);
  let equal_3 = delta_sizing_value(first: first.basis, second: second.basis);
  let equal_4 = first.align_self == second.align_self;
  let equal_5 = first.justify_self == second.justify_self;
  let equal_6 = delta_line_value(first: first.row_start, second: second.row_start);
  let equal_7 = delta_line_value(first: first.row_end, second: second.row_end);
  let equal_8 = delta_line_value(first: first.column_start, second: second.column_start);
  let equal_9 = delta_line_value(first: first.column_end, second: second.column_end);
  let equal_10 = first.break_inside == second.break_inside;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_0_4 = band(equal_8, equal_9);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_1_2 = band(both_0_4, equal_10);
  let both_2_0 = band(both_1_0, both_1_1);
  let both_3_0 = band(both_2_0, both_1_2);
  return both_3_0;
}

fn delta_table_value(first: TableGroup, second: TableGroup) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two TableGroup values independently.";
  let equal_0 = first.border_collapse == second.border_collapse;
  let equal_1 = delta_float_value(first: first.spacing_horizontal, second: second.spacing_horizontal);
  let equal_2 = delta_float_value(first: first.spacing_vertical, second: second.spacing_vertical);
  let equal_3 = first.table_layout == second.table_layout;
  let equal_4 = first.caption_side == second.caption_side;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_2_0 = band(both_1_0, equal_4);
  return both_2_0;
}

fn delta_breadth_value(first: TrackBreadth, second: TrackBreadth) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two TrackBreadth values independently.";
  let equal_0 = first.kind == second.kind;
  let equal_1 = delta_lp_value(first: first.value, second: second.value);
  let equal_2 = delta_float_value(first: first.flex, second: second.flex);
  let both_0_0 = band(equal_0, equal_1);
  let both_1_0 = band(both_0_0, equal_2);
  return both_1_0;
}

fn delta_family_value(first: Family, second: Family) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two Family values independently.";
  let equal_0 = first.name.index == second.name.index;
  let equal_1 = eeq(first.generic, second.generic);
  let both_0_0 = band(equal_0, equal_1);
  return both_0_0;
}

fn delta_area_value(first: NamedArea, second: NamedArea) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two NamedArea values independently.";
  let equal_0 = first.name.index == second.name.index;
  let equal_1 = first.row_start == second.row_start;
  let equal_2 = first.row_end == second.row_end;
  let equal_3 = first.column_start == second.column_start;
  let equal_4 = first.column_end == second.column_end;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_2_0 = band(both_1_0, equal_4);
  return both_2_0;
}

fn delta_counter_value(first: CounterChange, second: CounterChange) -> same: Bool pure {
  doc "Compares the layout-relevant fields of two CounterChange values independently.";
  let equal_0 = first.name.index == second.name.index;
  let equal_1 = first.value == second.value;
  let both_0_0 = band(equal_0, equal_1);
  return both_0_0;
}

fn delta_container_value(old: &Styles, new: &Styles, first: ContainerGroup, second: ContainerGroup) -> same: Bool reads(old), reads(new) {
  doc "Compares the layout-relevant fields of two ContainerGroup values independently.";
  let equal_0 = first.flex_direction == second.flex_direction;
  let equal_1 = first.flex_wrap == second.flex_wrap;
  let equal_2 = first.justify_content == second.justify_content;
  let equal_3 = first.align_items == second.align_items;
  let equal_4 = first.align_content == second.align_content;
  let equal_5 = first.justify_items == second.justify_items;
  let equal_6 = delta_sizing_value(first: first.row_gap, second: second.row_gap);
  let equal_7 = delta_sizing_value(first: first.column_gap, second: second.column_gap);
  let equal_8 = delta_track_list(old: old, new: new, old_id: first.template_columns, new_id: second.template_columns);
  let equal_9 = delta_track_list(old: old, new: new, old_id: first.template_rows, new_id: second.template_rows);
  let equal_10 = delta_area_map(old: old, new: new, old_id: first.template_areas, new_id: second.template_areas);
  let equal_11 = first.auto_flow == second.auto_flow;
  let equal_12 = delta_track_list(old: old, new: new, old_id: first.auto_columns, new_id: second.auto_columns);
  let equal_13 = delta_track_list(old: old, new: new, old_id: first.auto_rows, new_id: second.auto_rows);
  let equal_14 = first.column_count == second.column_count;
  let equal_15 = delta_sizing_value(first: first.column_width, second: second.column_width);
  let equal_16 = first.column_fill == second.column_fill;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_0_3 = band(equal_6, equal_7);
  let both_0_4 = band(equal_8, equal_9);
  let both_0_5 = band(equal_10, equal_11);
  let both_0_6 = band(equal_12, equal_13);
  let both_0_7 = band(equal_14, equal_15);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_1_2 = band(both_0_4, both_0_5);
  let both_1_3 = band(both_0_6, both_0_7);
  let both_2_0 = band(both_1_0, both_1_1);
  let both_2_1 = band(both_1_2, both_1_3);
  let both_3_0 = band(both_2_0, both_2_1);
  let both_4_0 = band(both_3_0, equal_16);
  return both_4_0;
}

fn delta_content_value(old: &Styles, new: &Styles, first: ContentGroup, second: ContentGroup) -> same: Bool reads(old), reads(new) {
  doc "Compares the layout-relevant fields of two ContentGroup values independently.";
  let equal_0 = delta_content_list(old: old, new: new, old_id: first.content, new_id: second.content);
  let equal_1 = delta_counter_list(old: old, new: new, old_id: first.counter_reset, new_id: second.counter_reset);
  let equal_2 = delta_counter_list(old: old, new: new, old_id: first.counter_increment, new_id: second.counter_increment);
  let equal_3 = delta_counter_list(old: old, new: new, old_id: first.counter_set, new_id: second.counter_set);
  let equal_4 = delta_quote_list(old: old, new: new, old_id: first.quotes, new_id: second.quotes);
  let equal_5 = first.list_style_position == second.list_style_position;
  let both_0_0 = band(equal_0, equal_1);
  let both_0_1 = band(equal_2, equal_3);
  let both_0_2 = band(equal_4, equal_5);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_2_0 = band(both_1_0, both_0_2);
  return both_2_0;
}

fn delta_range(first: u32, end: u32, available: u64) -> (declared: u64, start: u64, count: u64) pure {
  doc "The declared range width and the existing entries it names; missing entries are omitted as in the former value keys.";
  let first_wide = cvt::<u32, u64>(first);
  let end_wide = cvt::<u32, u64>(end);
  let declared = end_wide -sat first_wide;
  let start = imin(first_wide, available);
  let stop = imin(end_wide, available);
  let count = stop -sat start;
  return declared, start, count;
}

fn delta_names(old: &Styles, new: &Styles, first: LineNames, second: LineNames) -> same: Bool reads(old), reads(new) {
  doc "Compares corresponding line_names entries by value, independently under band.";
  let (old_declared, old_start, old_count) = delta_range(first: first.first, end: first.end, available: old^.line_names.inner.len);
  let (new_declared, new_start, new_count) = delta_range(first: second.first, end: second.end, available: new^.line_names.inner.len);
  let equal_count = old_count == new_count;
  if equal_count {
  } else {
    return False();
  }
  let equal_declared = old_declared == new_declared;
  let equal_items = True();
  for (offset in 0_u64..old_count) {
    let old_entry = old_start +sat offset;
    let new_entry = new_start +sat offset;
    let old_valid = old_entry < old^.line_names.inner.len;
    let new_valid = new_entry < new^.line_names.inner.len;
    let entries_inside = band(old_valid, new_valid);
    let equal_item = if entries_inside {
      let equal = old^.line_names.inner[old_entry].index == new^.line_names.inner[new_entry].index;
      give equal;
    } else {
      give False();
    }
    set equal_items = band(equal_items, equal_item);
  }
  let same = band(equal_declared, equal_items);
  return same;
}

fn delta_generated(old: &Styles, new: &Styles, old_first: u32, old_end: u32, new_first: u32, new_end: u32) -> same: Bool reads(old), reads(new) {
  doc "Compares corresponding generated_text entries by value, independently under band.";
  let (old_declared, old_start, old_count) = delta_range(first: old_first, end: old_end, available: old^.generated_text.inner.len);
  let (new_declared, new_start, new_count) = delta_range(first: new_first, end: new_end, available: new^.generated_text.inner.len);
  let equal_count = old_count == new_count;
  if equal_count {
  } else {
    return False();
  }
  let equal_declared = old_declared == new_declared;
  let equal_items = True();
  for (offset in 0_u64..old_count) {
    let old_entry = old_start +sat offset;
    let new_entry = new_start +sat offset;
    let old_valid = old_entry < old^.generated_text.inner.len;
    let new_valid = new_entry < new^.generated_text.inner.len;
    let entries_inside = band(old_valid, new_valid);
    let equal_item = if entries_inside {
      let equal = old^.generated_text.inner[old_entry] == new^.generated_text.inner[new_entry];
      give equal;
    } else {
      give False();
    }
    set equal_items = band(equal_items, equal_item);
  }
  let same = band(equal_declared, equal_items);
  return same;
}

fn delta_families(old: &Styles, new: &Styles, first: FontGroup, second: FontGroup) -> same: Bool reads(old), reads(new) {
  doc "Compares corresponding families entries by value, independently under band.";
  let (old_declared, old_start, old_count) = delta_range(first: first.families_start, end: first.families_end, available: old^.families.inner.len);
  let (new_declared, new_start, new_count) = delta_range(first: second.families_start, end: second.families_end, available: new^.families.inner.len);
  let equal_count = old_count == new_count;
  if equal_count {
  } else {
    return False();
  }
  let equal_declared = old_declared == new_declared;
  let equal_items = True();
  for (offset in 0_u64..old_count) {
    let old_entry = old_start +sat offset;
    let new_entry = new_start +sat offset;
    let old_valid = old_entry < old^.families.inner.len;
    let new_valid = new_entry < new^.families.inner.len;
    let entries_inside = band(old_valid, new_valid);
    let equal_item = if entries_inside {
      let equal = delta_family_value(first: old^.families.inner[old_entry], second: new^.families.inner[new_entry]);
      give equal;
    } else {
      give False();
    }
    set equal_items = band(equal_items, equal_item);
  }
  let same = band(equal_declared, equal_items);
  return same;
}

fn delta_font_value(old: &Styles, new: &Styles, first: FontGroup, second: FontGroup) -> same: Bool reads(old), reads(new) {
  doc "Compares font fields and family names independently, without comparing family range positions.";
  let equal_size = delta_float_value(first: first.size, second: second.size);
  let equal_weight = delta_float_value(first: first.weight, second: second.weight);
  let equal_style = first.style == second.style;
  let equal_height = delta_sizing_value(first: first.line_height, second: second.line_height);
  let equal_families = delta_families(old: old, new: new, first: first, second: second);
  let both_0_0 = band(equal_size, equal_weight);
  let both_0_1 = band(equal_style, equal_height);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_2_0 = band(both_1_0, equal_families);
  return both_2_0;
}

fn delta_track_value(old: &Styles, new: &Styles, first: Track, second: Track) -> same: Bool reads(old), reads(new) {
  doc "Compares track breadths, fit-content and line-name values independently.";
  let equal_min = delta_breadth_value(first: first.min, second: second.min);
  let equal_max = delta_breadth_value(first: first.max, second: second.max);
  let equal_fit = eeq(first.fit_content, second.fit_content);
  let equal_names = delta_names(old: old, new: new, first: first.names_before, second: second.names_before);
  let both_0_0 = band(equal_min, equal_max);
  let both_0_1 = band(equal_fit, equal_names);
  let both_1_0 = band(both_0_0, both_0_1);
  return both_1_0;
}

fn delta_content_item_value(old: &Styles, new: &Styles, first: ContentItem, second: ContentItem) -> same: Bool reads(old), reads(new) {
  doc "Compares generated-content item fields and text bytes independently.";
  let equal_kind = first.kind == second.kind;
  let equal_name = first.name.index == second.name.index;
  let equal_style = first.list_style.index == second.list_style.index;
  let equal_text = delta_generated(old: old, new: new, old_first: first.text_start, old_end: first.text_end, new_first: second.text_start, new_end: second.text_end);
  let both_0_0 = band(equal_kind, equal_name);
  let both_0_1 = band(equal_style, equal_text);
  let both_1_0 = band(both_0_0, both_0_1);
  return both_1_0;
}

fn delta_quote_value(old: &Styles, new: &Styles, first: QuotePair, second: QuotePair) -> same: Bool reads(old), reads(new) {
  doc "Compares opening and closing quote bytes independently.";
  let equal_open = delta_generated(old: old, new: new, old_first: first.open_start, old_end: first.open_end, new_first: second.open_start, new_end: second.open_end);
  let equal_close = delta_generated(old: old, new: new, old_first: first.close_start, old_end: first.close_end, new_first: second.close_start, new_end: second.close_end);
  let same = band(equal_open, equal_close);
  return same;
}

fn delta_track_list(old: &Styles, new: &Styles, old_id: u32, new_id: u32) -> same: Bool reads(old), reads(new) {
  doc "Compares referenced track_lists entries by their full values; two missing IDs compare equal only when the IDs agree, as the former unknown-class words did.";
  let old_at = cvt::<u32, u64>(old_id);
  let new_at = cvt::<u32, u64>(new_id);
  let old_inside = old_at < old^.track_lists.inner.len;
  let new_inside = new_at < new^.track_lists.inner.len;
  let inside = band(old_inside, new_inside);
  if inside {
  } else {
    let old_absent = bnot(old_inside);
    let new_absent = bnot(new_inside);
    let both_absent = band(old_absent, new_absent);
    let equal_id = old_id == new_id;
    let same = band(both_absent, equal_id);
    return same;
  }
  let first = old^.track_lists.inner[old_at];
  let second = new^.track_lists.inner[new_at];
  let (old_declared, old_start, old_count) = delta_range(first: first.first, end: first.end, available: old^.tracks.inner.len);
  let (new_declared, new_start, new_count) = delta_range(first: second.first, end: second.end, available: new^.tracks.inner.len);
  let equal_count = old_count == new_count;
  if equal_count {
  } else {
    return False();
  }
  let old_first = cvt::<u32, u64>(first.first);
  let new_first = cvt::<u32, u64>(second.first);
  let old_repeat_first_raw = cvt::<u32, u64>(first.repeat_first);
  let new_repeat_first_raw = cvt::<u32, u64>(second.repeat_first);
  let old_repeat_end_raw = cvt::<u32, u64>(first.repeat_end);
  let new_repeat_end_raw = cvt::<u32, u64>(second.repeat_end);
  let old_repeat_first = old_repeat_first_raw -sat old_first;
  let new_repeat_first = new_repeat_first_raw -sat new_first;
  let old_repeat_end = old_repeat_end_raw -sat old_first;
  let new_repeat_end = new_repeat_end_raw -sat new_first;
  let equal_kind = first.repeat_kind == second.repeat_kind;
  let equal_first = old_repeat_first == new_repeat_first;
  let equal_end = old_repeat_end == new_repeat_end;
  let equal_declared = old_declared == new_declared;
  let equal_before = delta_names(old: old, new: new, first: first.repeat_names_before, second: second.repeat_names_before);
  let equal_after = delta_names(old: old, new: new, first: first.repeat_names_after, second: second.repeat_names_after);
  let equal_names = delta_names(old: old, new: new, first: first.names_after, second: second.names_after);
  let equal_items = True();
  for (offset in 0_u64..old_count) {
    let old_entry = old_start +sat offset;
    let new_entry = new_start +sat offset;
    let old_valid = old_entry < old^.tracks.inner.len;
    let new_valid = new_entry < new^.tracks.inner.len;
    let entries_inside = band(old_valid, new_valid);
    let equal_item = if entries_inside {
      let equal = delta_track_value(old: old, new: new, first: old^.tracks.inner[old_entry], second: new^.tracks.inner[new_entry]);
      give equal;
    } else {
      give False();
    }
    set equal_items = band(equal_items, equal_item);
  }
  let both_0_0 = band(equal_kind, equal_first);
  let both_0_1 = band(equal_end, equal_declared);
  let both_0_2 = band(equal_before, equal_after);
  let both_0_3 = band(equal_names, equal_items);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_2_0 = band(both_1_0, both_1_1);
  return both_2_0;
}

fn delta_area_map(old: &Styles, new: &Styles, old_id: u32, new_id: u32) -> same: Bool reads(old), reads(new) {
  doc "Compares referenced area_maps entries by their full values; two missing IDs compare equal only when the IDs agree, as the former unknown-class words did.";
  let old_at = cvt::<u32, u64>(old_id);
