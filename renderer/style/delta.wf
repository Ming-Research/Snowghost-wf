    } else {
      give False();
    }
    set equal_items = band(equal_items, equal_item);
  }
  let both_0_0 = band(equal_rows, equal_columns);
  let both_0_1 = band(equal_declared, equal_items);
  let both_1_0 = band(both_0_0, both_0_1);
  return both_1_0;
}

