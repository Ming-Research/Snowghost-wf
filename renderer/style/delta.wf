fn background_present(styles: &Styles, id: u32) -> present: Bool reads(styles) {
  doc "The background predicate inline fragments read: currentColor or positive alpha; an identifier outside the background table is absent, as culled_box treats it.";
  let at = cvt::<u32, u64>(id);
  if at < styles^.backgrounds.inner.len {
    let color = styles^.backgrounds.inner[at].color;
    let painted = fgt(color.color.alpha, 0.0_f32);
    let present = bor(color.current, painted);
    return present;
  }
  return False();
}

fn same_style(old: &Styles, new: &Styles, old_style: ComputedStyle, new_style: ComputedStyle) -> same: Bool reads(old), reads(new) {
  doc "Compares every layout-relevant group and background presence independently, then combines the results; identifiers are used only to select each result's own values.";
  let equal_box = delta_box(old: old, new: new, old_id: old_style.box, new_id: new_style.box);
  let equal_size = delta_size(old: old, new: new, old_id: old_style.size, new_id: new_style.size);
  let equal_spacing = delta_spacing(old: old, new: new, old_id: old_style.spacing, new_id: new_style.spacing);
  let equal_border = delta_border(old: old, new: new, old_id: old_style.border, new_id: new_style.border);
  let equal_font = delta_font(old: old, new: new, old_id: old_style.font, new_id: new_style.font);
  let equal_text = delta_text(old: old, new: new, old_id: old_style.text, new_id: new_style.text);
  let equal_container = delta_container(old: old, new: new, old_id: old_style.container, new_id: new_style.container);
  let equal_item = delta_item(old: old, new: new, old_id: old_style.item, new_id: new_style.item);
  let equal_table = delta_table(old: old, new: new, old_id: old_style.table, new_id: new_style.table);
  let equal_content = delta_content(old: old, new: new, old_id: old_style.content, new_id: new_style.content);
  let old_background = background_present(styles: old, id: old_style.background);
  let new_background = background_present(styles: new, id: new_style.background);
  let equal_background = eeq(old_background, new_background);
  let both_0_0 = band(equal_box, equal_size);
  let both_0_1 = band(equal_spacing, equal_border);
  let both_0_2 = band(equal_font, equal_text);
  let both_0_3 = band(equal_container, equal_item);
  let both_0_4 = band(equal_table, equal_content);
  let both_1_0 = band(both_0_0, both_0_1);
  let both_1_1 = band(both_0_2, both_0_3);
  let both_1_2 = band(both_0_4, equal_background);
  let both_2_0 = band(both_1_0, both_1_1);
  let both_3_0 = band(both_2_0, both_1_2);
  return both_3_0;
}

fn delta_pseudo_boundary(styles: &Styles, element: u64, kind: u8, upper: Bool) -> boundary: u64 reads(styles) {
  doc "A lower or upper bound for (element, kind) in the sorted pseudo list. Each search step depends on the key selected by the preceding interval; unrelated searches only read styles.";
  let low = 0_u64;
  let high = styles^.pseudos.inner.len;
  loop {
    if low >= high {
      break;
    }
    let distance = high -sat low;
    let half = distance / 2_u64;
    let middle = low +sat half;
    if middle < styles^.pseudos.inner.len {
      let pseudo = styles^.pseudos.inner[middle];
      let owner = cvt::<u32, u64>(pseudo.element);
      let earlier_owner = owner < element;
      let equal_owner = owner == element;
      let earlier_kind = pseudo.kind < kind;
      let equal_kind = pseudo.kind == kind;
      let included_equal = band(upper, equal_kind);
      let preceding_kind = bor(earlier_kind, included_equal);
      let same_owner_precedes = band(equal_owner, preceding_kind);
      let precedes = bor(earlier_owner, same_owner_precedes);
      if precedes {
        set low = middle +sat 1_u64;
      } else {
        set high = middle;
      }
    } else {
      set high = low;
    }
  }
  return low;
}

fn delta_pseudo_index(styles: &Styles, element: u64, kind: u8) -> index: Option<u64> reads(styles) {
  doc "Finds a generated pseudo slot by read-only binary bounds. Among equal sorted keys, independently selects the last generating entry under imax, preserving the former scatter's last-entry behavior. Normal and none content are absent; an unknown content group still counts as present.";
  let lower_kind = False();
  let upper_kind = True();
  let lower = delta_pseudo_boundary(styles: styles, element: element, kind: kind, upper: lower_kind);
  let upper = delta_pseudo_boundary(styles: styles, element: element, kind: kind, upper: upper_kind);
  let selected = 0_u64;
  for (at in lower..upper) {
    let candidate = if at < styles^.pseudos.inner.len {
      let pseudo = styles^.pseudos.inner[at];
      let content_at = cvt::<u32, u64>(pseudo.style.content);
      let known = content_at < styles^.contents.inner.len;
      let generates = if known {
        let content = styles^.contents.inner[content_at].content;
        give content > 1_u32;
      } else {
        give True();
      }
      let present = if generates {
        give at +sat 1_u64;
      } else {
        give 0_u64;
      }
      give present;
    } else {
      give 0_u64;
    }
    set selected = imax(selected, candidate);
  }
  if selected == 0_u64 {
    return None<u64>();
  }
  let at = selected -sat 1_u64;
  return Some<u64>(value: at);
}

fn same_pseudo(old: &Styles, new: &Styles, old_element: u64, new_element: u64, kind: u8) -> same: Bool reads(old), reads(new) {
  doc "Compares generated pseudo styles by the originating node's independently resolved old and new preorder positions and kind, or regards two absent slots as equal.";
  let old_index = delta_pseudo_index(styles: old, element: old_element, kind: kind);
  let new_index = delta_pseudo_index(styles: new, element: new_element, kind: kind);
  match old_index {
    None() => {
      match new_index {
        None() => {
          return True();
        }
        Some(..) => {
          return False();
        }
      }
    }
    Some(value: old_at) => {
      match new_index {
        None() => {
          return False();
        }
        Some(value: new_at) => {
          let old_inside = old_at < old^.pseudos.inner.len;
          let new_inside = new_at < new^.pseudos.inner.len;
          let inside = band(old_inside, new_inside);
          if inside {
            let old_style = old^.pseudos.inner[old_at].style;
            let new_style = new^.pseudos.inner[new_at].style;
            let same = same_style(old: old, new: new, old_style: old_style, new_style: new_style);
            return same;
          }
          return False();
        }
      }
    }
  }
}

fn layout_changes(old: &Styles, new: &Styles) -> changed: Box<Array<Bool>> reads(old), reads(new) {
  doc "Each NodeId independently resolves both runs' preorder positions, compares referenced layout values and generated pseudo slots, and writes only its own flag. Two absent elements are unchanged and an element in only one run is changed. Nested lists compare corresponding entries under band reductions; shared references may repeat comparisons without ordering nodes. Float words preserve exact bits except negative zero is zero. Normal and none pseudo content are absent. Exact colours and custom groups are excluded except the currentColor-or-positive-alpha background predicate that inline fragments read. The longer order map determines the result length; there is no temporary classification table or shared pseudo scatter.";
  let old_count = old^.elements.inner.len;
  let new_count = new^.elements.inner.len;
  let old_nodes = old^.order.inner.len;
  let new_nodes = new^.order.inner.len;
  let count = imax(old_nodes, new_nodes);
  let no = False();
  let small = count <= node_ceiling;
  let room = if small {
    give count;
  } else {
    give 0_u64;
  }
  let changed = box_array_filled::<Bool>(count: room, value: no);
  let slots = changed.inner.len;
  for (i in 0_u64..slots) {
    let old_position = if i < old_nodes {
      let position = old^.order.inner[i];
      give cvt::<u32, u64>(position);
    } else {
      give 4294967295_u64;
    }
    let new_position = if i < new_nodes {
      let position = new^.order.inner[i];
      give cvt::<u32, u64>(position);
    } else {
      give 4294967295_u64;
    }
    let old_visited = old_position != 4294967295_u64;
    let new_visited = new_position != 4294967295_u64;
    let old_listed = old_position < old_count;
    let new_listed = new_position < new_count;
    let old_element = band(old_visited, old_listed);
    let new_element = band(new_visited, new_listed);
    let both = band(old_element, new_element);
    let flag = if both {
      let old_style = old^.elements.inner[old_position];
      let new_style = new^.elements.inner[new_position];
      let same = same_style(old: old, new: new, old_style: old_style, new_style: new_style);
      let same_before = same_pseudo(old: old, new: new, old_element: old_position, new_element: new_position, kind: 0_u8);
      let same_after = same_pseudo(old: old, new: new, old_element: old_position, new_element: new_position, kind: 1_u8);
      let pseudos = band(same_before, same_after);
      let unchanged = band(same, pseudos);
      give bnot(unchanged);
    } else {
      let same_presence = eeq(old_element, new_element);
      give bnot(same_presence);
    }
    set changed.inner[i] = flag;
  }
  return move changed;
}
