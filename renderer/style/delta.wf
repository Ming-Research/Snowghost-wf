alias Atom = pkg::base::atom::Atom;
alias AreaMap = pkg::css::values::AreaMap;
alias BorderGroup = pkg::css::values::BorderGroup;
alias BoxGroup = pkg::css::values::BoxGroup;
alias ContainerGroup = pkg::css::values::ContainerGroup;
alias ContentGroup = pkg::css::values::ContentGroup;
alias FontGroup = pkg::css::values::FontGroup;
alias GridLine = pkg::css::values::GridLine;
alias ItemGroup = pkg::css::values::ItemGroup;
alias LineNames = pkg::css::values::LineNames;
alias SizeGroup = pkg::css::values::SizeGroup;
alias SpacingGroup = pkg::css::values::SpacingGroup;
alias TableGroup = pkg::css::values::TableGroup;
alias TextGroup = pkg::css::values::TextGroup;
alias TrackBreadth = pkg::css::values::TrackBreadth;
alias TrackList = pkg::css::values::TrackList;

struct ClassTables {
  tracks: WordTable;
  areas: WordTable;
  contents: WordTable;
  counters: WordTable;
  quotes: WordTable;
  boxes: WordTable;
  sizes: WordTable;
  spacings: WordTable;
  borders: WordTable;
  fonts: WordTable;
  texts: WordTable;
  containers: WordTable;
  items: WordTable;
  tables: WordTable;
  content_groups: WordTable;
}

struct Classes {
  tracks: Box<Array<u32>>;
  areas: Box<Array<u32>>;
  contents: Box<Array<u32>>;
  counters: Box<Array<u32>>;
  quotes: Box<Array<u32>>;
  boxes: Box<Array<u32>>;
  sizes: Box<Array<u32>>;
  spacings: Box<Array<u32>>;
  borders: Box<Array<u32>>;
  fonts: Box<Array<u32>>;
  texts: Box<Array<u32>>;
  containers: Box<Array<u32>>;
  items: Box<Array<u32>>;
  tables: Box<Array<u32>>;
  content_groups: Box<Array<u32>>;
}

const absent_pseudo: u32 = 4294967295_u32;

const unknown_class: u64 = 1099511627776_u64;

fn put_u8(key: &Box<Slots<u64>>, value: u8) -> result: unit writes(key) {
  doc "Appends a byte as a word.";
  let word = cvt::<u8, u64>(value);
  put_word(key: key, value: word);
  return unit;
}

fn put_u32(key: &Box<Slots<u64>>, value: u32) -> result: unit writes(key) {
  doc "Appends a 32-bit value as a word.";
  let word = cvt::<u32, u64>(value);
  put_word(key: key, value: word);
  return unit;
}

fn put_i32(key: &Box<Slots<u64>>, value: i32) -> result: unit writes(key) {
  doc "Appends a signed 32-bit value as a word.";
  let word = cvt.wrap::<i32, u64>(value);
  put_word(key: key, value: word);
  return unit;
}

fn put_f32(key: &Box<Slots<u64>>, value: f32) -> result: unit writes(key) {
  doc "Appends a float as a word, negative zero taken as zero.";
  let word = exact_word(value: value);
  put_word(key: key, value: word);
  return unit;
}

fn put_flag(key: &Box<Slots<u64>>, value: Bool) -> result: unit writes(key) {
  doc "Appends a Bool as a word.";
  let word = bool_word(value: value);
  put_word(key: key, value: word);
  return unit;
}

fn put_atom(key: &Box<Slots<u64>>, value: Atom) -> result: unit writes(key) {
  doc "Appends an atom as a word; atoms are comparable between runs because both runs intern into one table.";
  let word = cvt::<u32, u64>(value.index);
  put_word(key: key, value: word);
  return unit;
}

fn class_word(classes: &Box<Array<u32>>, id: u32) -> word: u64 reads(classes) {
  doc "The class of a list the identifier names, or a word no class has when the identifier is outside the table.";
  let at = cvt::<u32, u64>(id);
  if at < classes^.inner.len {
    let class = classes^.inner[at];
    let wide = cvt::<u32, u64>(class);
    return wide;
  }
  let outside = unknown_class +sat at;
  return outside;
}

fn put_class(key: &Box<Slots<u64>>, classes: &Box<Array<u32>>, id: u32) -> result: unit reads(classes), writes(key) {
  doc "Appends the class of a list identifier as a word.";
  let word = class_word(classes: classes, id: id);
  put_word(key: key, value: word);
  return unit;
}

fn put_generated(key: &Box<Slots<u64>>, styles: &Styles, start: u32, end: u32) -> result: unit reads(styles), writes(key) {
  doc "Appends the length and the bytes of a range of the generated text.";
  let a = cvt::<u32, u64>(start);
  let b = cvt::<u32, u64>(end);
  let width = b -sat a;
  put_word(key: key, value: width);
  for (k in a..b) {
    let inside = k < styles^.generated_text.inner.len;
    if inside {
      let byte = cvt::<u8, u64>(styles^.generated_text.inner[k]);
      put_word(key: key, value: byte);
    }
  }
  return unit;
}

fn put_line_names(key: &Box<Slots<u64>>, styles: &Styles, names: LineNames) -> result: unit reads(styles), writes(key) {
  doc "Appends the count and the atoms of a range of the line names.";
  let first = cvt::<u32, u64>(names.first);
  let end = cvt::<u32, u64>(names.end);
  let count = end -sat first;
  put_word(key: key, value: count);
  for (k in first..end) {
    let inside = k < styles^.line_names.inner.len;
    if inside {
      put_atom(key: key, value: styles^.line_names.inner[k]);
    }
  }
  return unit;
}

fn put_breadth(key: &Box<Slots<u64>>, value: TrackBreadth) -> result: unit writes(key) {
  doc "Appends the words of a computed track breadth.";
  put_u8(key: key, value: value.kind);
  put_lp(key: key, value: value.value);
  put_f32(key: key, value: value.flex);
  return unit;
}

fn key_track_list(key: &Box<Slots<u64>>, styles: &Styles, list: TrackList) -> result: unit reads(styles), writes(key) {
  doc "Writes a computed track list: its repeat, each track's breadths, fit-content flag and line names, and the names around the repeat and after the last track.";
  let first = cvt::<u32, u64>(list.first);
  let end = cvt::<u32, u64>(list.end);
  let repeat_first_raw = cvt::<u32, u64>(list.repeat_first);
  let repeat_first = repeat_first_raw -sat first;
  let repeat_end_raw = cvt::<u32, u64>(list.repeat_end);
  let repeat_end = repeat_end_raw -sat first;
  let count = end -sat first;
  put_u8(key: key, value: list.repeat_kind);
  put_word(key: key, value: repeat_first);
  put_word(key: key, value: repeat_end);
  put_word(key: key, value: count);
  for (k in first..end) {
    let inside = k < styles^.tracks.inner.len;
    if inside {
      let track = styles^.tracks.inner[k];
      put_breadth(key: key, value: track.min);
      put_breadth(key: key, value: track.max);
      put_flag(key: key, value: track.fit_content);
      put_line_names(key: key, styles: styles, names: track.names_before);
    }
  }
  put_line_names(key: key, styles: styles, names: list.repeat_names_before);
  put_line_names(key: key, styles: styles, names: list.repeat_names_after);
  put_line_names(key: key, styles: styles, names: list.names_after);
  return unit;
}

fn key_area_map(key: &Box<Slots<u64>>, styles: &Styles, map: AreaMap) -> result: unit reads(styles), writes(key) {
  doc "Writes an area map: its size and each named area with its corners.";
  let first = cvt::<u32, u64>(map.first);
  let end = cvt::<u32, u64>(map.end);
  put_u32(key: key, value: map.rows);
  put_u32(key: key, value: map.columns);
  let count = end -sat first;
  put_word(key: key, value: count);
  for (k in first..end) {
    let inside = k < styles^.named_areas.inner.len;
    if inside {
      let area = styles^.named_areas.inner[k];
      put_atom(key: key, value: area.name);
      put_u32(key: key, value: area.row_start);
      put_u32(key: key, value: area.row_end);
      put_u32(key: key, value: area.column_start);
      put_u32(key: key, value: area.column_end);
    }
  }
  return unit;
}

fn key_content_list(key: &Box<Slots<u64>>, styles: &Styles, at: u64) -> result: unit reads(styles), writes(key) {
  doc "Writes content list at: entries 0, normal, and 1, none, are both empty lists with different meanings, so each is written as a word of its own; any other is written by its items with their text bytes.";
  if at < 2_u64 {
    let word = predefined_tag +sat at;
    put_word(key: key, value: word);
    return unit;
  }
  let inside_list = at < styles^.content_lists.inner.len;
  if inside_list {
  } else {
    return unit;
  }
  let list = styles^.content_lists.inner[at];
  let first = cvt::<u32, u64>(list.first);
  let end = cvt::<u32, u64>(list.end);
  for (k in first..end) {
    let inside = k < styles^.content_items.inner.len;
    if inside {
      let item = styles^.content_items.inner[k];
      put_u8(key: key, value: item.kind);
      put_atom(key: key, value: item.name);
      put_atom(key: key, value: item.list_style);
      put_generated(key: key, styles: styles, start: item.text_start, end: item.text_end);
    }
  }
  return unit;
}

fn key_counter_list(key: &Box<Slots<u64>>, styles: &Styles, at: u64) -> result: unit reads(styles), writes(key) {
  doc "Writes counter list at by its changes.";
  let inside_list = at < styles^.counter_lists.inner.len;
  if inside_list {
  } else {
    return unit;
  }
  let list = styles^.counter_lists.inner[at];
  let first = cvt::<u32, u64>(list.first);
  let end = cvt::<u32, u64>(list.end);
  for (k in first..end) {
    let inside = k < styles^.counter_changes.inner.len;
    if inside {
      let change = styles^.counter_changes.inner[k];
      put_atom(key: key, value: change.name);
      put_i32(key: key, value: change.value);
    }
  }
  return unit;
}

fn key_quote_list(key: &Box<Slots<u64>>, styles: &Styles, at: u64) -> result: unit reads(styles), writes(key) {
  doc "Writes quote list at: entries 0, auto, and 1, none, are both empty lists with different meanings, so each is written as a word of its own; any other is written by its pairs with their text bytes.";
  if at < 2_u64 {
    let word = predefined_tag +sat at;
    put_word(key: key, value: word);
    return unit;
  }
  let inside_list = at < styles^.quote_lists.inner.len;
  if inside_list {
  } else {
    return unit;
  }
  let list = styles^.quote_lists.inner[at];
  let first = cvt::<u32, u64>(list.first);
  let end = cvt::<u32, u64>(list.end);
  for (k in first..end) {
    let inside = k < styles^.quote_pairs.inner.len;
    if inside {
      let pair = styles^.quote_pairs.inner[k];
      put_generated(key: key, styles: styles, start: pair.open_start, end: pair.open_end);
      put_generated(key: key, styles: styles, start: pair.close_start, end: pair.close_end);
    }
  }
  return unit;
}

fn key_box(key: &Box<Slots<u64>>, value: BoxGroup) -> result: unit writes(key) {
  doc "Writes every field of a box group.";
  put_u8(key: key, value: value.display);
  put_u8(key: key, value: value.position);
  put_u8(key: key, value: value.float);
  put_u8(key: key, value: value.clear);
  put_u8(key: key, value: value.overflow_x);
  put_u8(key: key, value: value.overflow_y);
  put_u8(key: key, value: value.box_sizing);
  put_u8(key: key, value: value.visibility);
  put_flag(key: key, value: value.z_auto);
  put_i32(key: key, value: value.z_index);
  put_u8(key: key, value: value.unicode_bidi);
  return unit;
}

fn key_size(key: &Box<Slots<u64>>, value: SizeGroup) -> result: unit writes(key) {
  doc "Writes every field of a size group.";
  put_sizing(key: key, value: value.width);
  put_sizing(key: key, value: value.height);
  put_sizing(key: key, value: value.min_width);
  put_sizing(key: key, value: value.min_height);
  put_sizing(key: key, value: value.max_width);
  put_sizing(key: key, value: value.max_height);
  put_flag(key: key, value: value.aspect_auto);
  put_f32(key: key, value: value.aspect_width);
  put_f32(key: key, value: value.aspect_height);
  put_sizing(key: key, value: value.top);
  put_sizing(key: key, value: value.right);
  put_sizing(key: key, value: value.bottom);
  put_sizing(key: key, value: value.left);
  return unit;
}

fn key_spacing(key: &Box<Slots<u64>>, value: SpacingGroup) -> result: unit writes(key) {
  doc "Writes every field of a spacing group.";
  put_sizing(key: key, value: value.margin_top);
  put_sizing(key: key, value: value.margin_right);
  put_sizing(key: key, value: value.margin_bottom);
  put_sizing(key: key, value: value.margin_left);
  put_lp(key: key, value: value.padding_top);
  put_lp(key: key, value: value.padding_right);
  put_lp(key: key, value: value.padding_bottom);
  put_lp(key: key, value: value.padding_left);
  return unit;
}

fn key_border(key: &Box<Slots<u64>>, value: BorderGroup) -> result: unit writes(key) {
  doc "Writes the widths and styles of a border group; its four colours are left out, as the file's comment says.";
  put_f32(key: key, value: value.top_width);
  put_f32(key: key, value: value.right_width);
  put_f32(key: key, value: value.bottom_width);
  put_f32(key: key, value: value.left_width);
  put_u8(key: key, value: value.top_style);
  put_u8(key: key, value: value.right_style);
  put_u8(key: key, value: value.bottom_style);
  put_u8(key: key, value: value.left_style);
  return unit;
}

fn key_font(key: &Box<Slots<u64>>, styles: &Styles, value: FontGroup) -> result: unit reads(styles), writes(key) {
  doc "Writes every field of a font group, the families by the names of the range they cover in the run's family table.";
  put_f32(key: key, value: value.size);
  put_f32(key: key, value: value.weight);
  put_u8(key: key, value: value.style);
  put_sizing(key: key, value: value.line_height);
  let first = cvt::<u32, u64>(value.families_start);
  let end = cvt::<u32, u64>(value.families_end);
  let count = end -sat first;
  put_word(key: key, value: count);
  for (k in first..end) {
    let inside = k < styles^.families.inner.len;
    if inside {
      let family = styles^.families.inner[k];
      put_atom(key: key, value: family.name);
      put_flag(key: key, value: family.generic);
    }
  }
  return unit;
}

fn key_text(key: &Box<Slots<u64>>, value: TextGroup) -> result: unit writes(key) {
  doc "Writes every field of a text group but its colour.";
  put_u8(key: key, value: value.text_align);
  put_lp(key: key, value: value.text_indent);
  put_u8(key: key, value: value.text_transform);
  put_u8(key: key, value: value.white_space);
  put_sizing(key: key, value: value.letter_spacing);
  put_sizing(key: key, value: value.word_spacing);
  put_sizing(key: key, value: value.vertical_align);
  put_u8(key: key, value: value.decoration_line);
  put_atom(key: key, value: value.list_style_type);
  put_u8(key: key, value: value.overflow_wrap);
  put_u8(key: key, value: value.word_break);
  return unit;
}

fn key_container(key: &Box<Slots<u64>>, classes: &Classes, value: ContainerGroup) -> result: unit reads(classes), writes(key) {
  doc "Writes every field of a container group, its track lists and area map by their classes.";
  put_u8(key: key, value: value.flex_direction);
  put_u8(key: key, value: value.flex_wrap);
  put_u8(key: key, value: value.justify_content);
  put_u8(key: key, value: value.align_items);
  put_u8(key: key, value: value.align_content);
  put_u8(key: key, value: value.justify_items);
  put_sizing(key: key, value: value.row_gap);
  put_sizing(key: key, value: value.column_gap);
  put_class(key: key, classes: &classes^.tracks, id: value.template_columns);
  put_class(key: key, classes: &classes^.tracks, id: value.template_rows);
  put_class(key: key, classes: &classes^.areas, id: value.template_areas);
  put_u8(key: key, value: value.auto_flow);
  put_class(key: key, classes: &classes^.tracks, id: value.auto_columns);
  put_class(key: key, classes: &classes^.tracks, id: value.auto_rows);
  put_u32(key: key, value: value.column_count);
  put_sizing(key: key, value: value.column_width);
  put_u8(key: key, value: value.column_fill);
  return unit;
}

fn key_line(key: &Box<Slots<u64>>, value: GridLine) -> result: unit writes(key) {
  doc "Writes a grid line.";
  put_line(key: key, value: value);
  return unit;
}

fn key_item(key: &Box<Slots<u64>>, value: ItemGroup) -> result: unit writes(key) {
  doc "Writes every field of an item group.";
  put_i32(key: key, value: value.order);
  put_f32(key: key, value: value.grow);
  put_f32(key: key, value: value.shrink);
  put_sizing(key: key, value: value.basis);
  put_u8(key: key, value: value.align_self);
  put_u8(key: key, value: value.justify_self);
  key_line(key: key, value: value.row_start);
  key_line(key: key, value: value.row_end);
  key_line(key: key, value: value.column_start);
  key_line(key: key, value: value.column_end);
  put_u8(key: key, value: value.break_inside);
  return unit;
}

fn key_table(key: &Box<Slots<u64>>, value: TableGroup) -> result: unit writes(key) {
  doc "Writes every field of a table group.";
  put_u8(key: key, value: value.border_collapse);
  put_f32(key: key, value: value.spacing_horizontal);
  put_f32(key: key, value: value.spacing_vertical);
  put_u8(key: key, value: value.table_layout);
  put_u8(key: key, value: value.caption_side);
  return unit;
}

fn key_content(key: &Box<Slots<u64>>, classes: &Classes, value: ContentGroup) -> result: unit reads(classes), writes(key) {
  doc "Writes every field of a content group, its lists by their classes.";
  put_class(key: key, classes: &classes^.contents, id: value.content);
  put_class(key: key, classes: &classes^.counters, id: value.counter_reset);
  put_class(key: key, classes: &classes^.counters, id: value.counter_increment);
  put_class(key: key, classes: &classes^.counters, id: value.counter_set);
  put_class(key: key, classes: &classes^.quotes, id: value.quotes);
  put_u8(key: key, value: value.list_style_position);
  return unit;
}

fn intern_key(table: &WordTable, key: &Box<Slots<u64>>) -> id: u32 reads(key), writes(table) {
  doc "The class of the words in key among the table's sequences.";
  let length = key^.inner.len;
  let found = word_intern(table: table, key: &key^.inner[0_u64..length]);
  return found.id;
}

fn pair_total(first: u64, second: u64) -> total: u64 pure {
  doc "The most sequences two tables of these lengths can add to one table of classes, with two for the predefined entries.";
  let both = first +sat second;
  let total = both +sat 2_u64;
  return total;
}

fn class_tables_new(old: &Styles, new: &Styles) -> made: ClassTables reads(old), reads(new) {
  doc "One empty table of word sequences per table of a result, each large enough for the entries of that table in both results.";
  let tracks_total = pair_total(first: old^.track_lists.inner.len, second: new^.track_lists.inner.len);
  let tracks = word_table_new(expected: tracks_total);
  let areas_total = pair_total(first: old^.area_maps.inner.len, second: new^.area_maps.inner.len);
  let areas = word_table_new(expected: areas_total);
  let contents_total = pair_total(first: old^.content_lists.inner.len, second: new^.content_lists.inner.len);
  let contents = word_table_new(expected: contents_total);
  let counters_total = pair_total(first: old^.counter_lists.inner.len, second: new^.counter_lists.inner.len);
  let counters = word_table_new(expected: counters_total);
  let quotes_total = pair_total(first: old^.quote_lists.inner.len, second: new^.quote_lists.inner.len);
  let quotes = word_table_new(expected: quotes_total);
  let boxes_total = pair_total(first: old^.boxes.inner.len, second: new^.boxes.inner.len);
  let boxes = word_table_new(expected: boxes_total);
  let sizes_total = pair_total(first: old^.sizes.inner.len, second: new^.sizes.inner.len);
  let sizes = word_table_new(expected: sizes_total);
  let spacings_total = pair_total(first: old^.spacings.inner.len, second: new^.spacings.inner.len);
  let spacings = word_table_new(expected: spacings_total);
  let borders_total = pair_total(first: old^.borders.inner.len, second: new^.borders.inner.len);
  let borders = word_table_new(expected: borders_total);
  let fonts_total = pair_total(first: old^.fonts.inner.len, second: new^.fonts.inner.len);
  let fonts = word_table_new(expected: fonts_total);
  let texts_total = pair_total(first: old^.texts.inner.len, second: new^.texts.inner.len);
  let texts = word_table_new(expected: texts_total);
  let containers_total = pair_total(first: old^.containers.inner.len, second: new^.containers.inner.len);
  let containers = word_table_new(expected: containers_total);
  let items_total = pair_total(first: old^.items.inner.len, second: new^.items.inner.len);
  let items = word_table_new(expected: items_total);
  let tables_total = pair_total(first: old^.tables.inner.len, second: new^.tables.inner.len);
  let tables = word_table_new(expected: tables_total);
  let content_groups_total = pair_total(first: old^.contents.inner.len, second: new^.contents.inner.len);
  let content_groups = word_table_new(expected: content_groups_total);
  return ClassTables(tracks: move tracks, areas: move areas, contents: move contents, counters: move counters, quotes: move quotes, boxes: move boxes, sizes: move sizes, spacings: move spacings, borders: move borders, fonts: move fonts, texts: move texts, containers: move containers, items: move items, tables: move tables, content_groups: move content_groups);
}

fn classes_of(count: u64) -> made: Box<Array<u32>> pure {
  doc "An array of count classes, empty for a count past 2^30, which no table of a result reaches; an identifier outside an empty array is a difference.";
  let small = count <= 1073741824_u64;
  if small {
    let made = box_array_filled::<u32>(count: count, value: 0_u32);
    return move made;
  }
  let empty = box_array_filled::<u32>(count: 0_u64, value: 0_u32);
  return move empty;
}

fn classes_new(styles: &Styles) -> made: Classes reads(styles) {
  doc "Arrays of classes, one slot per entry of each table of styles.";
  let tracks = classes_of(count: styles^.track_lists.inner.len);
  let areas = classes_of(count: styles^.area_maps.inner.len);
  let contents = classes_of(count: styles^.content_lists.inner.len);
  let counters = classes_of(count: styles^.counter_lists.inner.len);
  let quotes = classes_of(count: styles^.quote_lists.inner.len);
  let boxes = classes_of(count: styles^.boxes.inner.len);
  let sizes = classes_of(count: styles^.sizes.inner.len);
  let spacings = classes_of(count: styles^.spacings.inner.len);
  let borders = classes_of(count: styles^.borders.inner.len);
  let fonts = classes_of(count: styles^.fonts.inner.len);
  let texts = classes_of(count: styles^.texts.inner.len);
  let containers = classes_of(count: styles^.containers.inner.len);
  let items = classes_of(count: styles^.items.inner.len);
  let tables = classes_of(count: styles^.tables.inner.len);
  let content_groups = classes_of(count: styles^.contents.inner.len);
  return Classes(tracks: move tracks, areas: move areas, contents: move contents, counters: move counters, quotes: move quotes, boxes: move boxes, sizes: move sizes, spacings: move spacings, borders: move borders, fonts: move fonts, texts: move texts, containers: move containers, items: move items, tables: move tables, content_groups: move content_groups);
}

fn classify_lists(shared: &ClassTables, key: &Box<Slots<u64>>, styles: &Styles, classes: &Classes) -> result: unit reads(styles), writes(shared), writes(key), writes(classes) {
  doc "Gives each entry of the five list tables of styles its class.";
  let track_count = classes^.tracks.inner.len;
  for (k in 0_u64..track_count) {
    let inside = k < styles^.track_lists.inner.len;
    if inside {
      clear_key(key: key);
      key_track_list(key: key, styles: styles, list: styles^.track_lists.inner[k]);
      let id = intern_key(table: &shared^.tracks, key: key);
      set classes^.tracks.inner[k] = id;
    }
  }
  let area_count = classes^.areas.inner.len;
  for (k in 0_u64..area_count) {
    let inside = k < styles^.area_maps.inner.len;
    if inside {
      clear_key(key: key);
      key_area_map(key: key, styles: styles, map: styles^.area_maps.inner[k]);
      let id = intern_key(table: &shared^.areas, key: key);
      set classes^.areas.inner[k] = id;
    }
  }
  let content_count = classes^.contents.inner.len;
  for (k in 0_u64..content_count) {
    clear_key(key: key);
    key_content_list(key: key, styles: styles, at: k);
    let id = intern_key(table: &shared^.contents, key: key);
    set classes^.contents.inner[k] = id;
  }
  let counter_count = classes^.counters.inner.len;
  for (k in 0_u64..counter_count) {
    clear_key(key: key);
    key_counter_list(key: key, styles: styles, at: k);
    let id = intern_key(table: &shared^.counters, key: key);
    set classes^.counters.inner[k] = id;
  }
  let quote_count = classes^.quotes.inner.len;
  for (k in 0_u64..quote_count) {
    clear_key(key: key);
    key_quote_list(key: key, styles: styles, at: k);
    let id = intern_key(table: &shared^.quotes, key: key);
    set classes^.quotes.inner[k] = id;
  }
  return unit;
}

fn classify_groups(shared: &ClassTables, key: &Box<Slots<u64>>, styles: &Styles, classes: &Classes) -> result: unit reads(styles), writes(shared), writes(key), writes(classes) {
  doc "Gives each entry of the ten group tables of styles its class; the lists must have theirs.";
  let box_count = classes^.boxes.inner.len;
  for (k in 0_u64..box_count) {
    let inside = k < styles^.boxes.inner.len;
    if inside {
      clear_key(key: key);
      key_box(key: key, value: styles^.boxes.inner[k]);
      let id = intern_key(table: &shared^.boxes, key: key);
      set classes^.boxes.inner[k] = id;
    }
  }
  let size_count = classes^.sizes.inner.len;
  for (k in 0_u64..size_count) {
    let inside = k < styles^.sizes.inner.len;
    if inside {
      clear_key(key: key);
      key_size(key: key, value: styles^.sizes.inner[k]);
      let id = intern_key(table: &shared^.sizes, key: key);
      set classes^.sizes.inner[k] = id;
    }
  }
  let spacing_count = classes^.spacings.inner.len;
  for (k in 0_u64..spacing_count) {
    let inside = k < styles^.spacings.inner.len;
    if inside {
      clear_key(key: key);
      key_spacing(key: key, value: styles^.spacings.inner[k]);
      let id = intern_key(table: &shared^.spacings, key: key);
      set classes^.spacings.inner[k] = id;
    }
  }
  let border_count = classes^.borders.inner.len;
  for (k in 0_u64..border_count) {
    let inside = k < styles^.borders.inner.len;
    if inside {
      clear_key(key: key);
      key_border(key: key, value: styles^.borders.inner[k]);
      let id = intern_key(table: &shared^.borders, key: key);
      set classes^.borders.inner[k] = id;
    }
  }
  let font_count = classes^.fonts.inner.len;
  for (k in 0_u64..font_count) {
    let inside = k < styles^.fonts.inner.len;
    if inside {
      clear_key(key: key);
      key_font(key: key, styles: styles, value: styles^.fonts.inner[k]);
      let id = intern_key(table: &shared^.fonts, key: key);
      set classes^.fonts.inner[k] = id;
    }
  }
  let text_count = classes^.texts.inner.len;
  for (k in 0_u64..text_count) {
    let inside = k < styles^.texts.inner.len;
    if inside {
      clear_key(key: key);
      key_text(key: key, value: styles^.texts.inner[k]);
      let id = intern_key(table: &shared^.texts, key: key);
      set classes^.texts.inner[k] = id;
    }
  }
  let container_count = classes^.containers.inner.len;
  for (k in 0_u64..container_count) {
    let inside = k < styles^.containers.inner.len;
    if inside {
      clear_key(key: key);
      key_container(key: key, classes: classes, value: styles^.containers.inner[k]);
      let id = intern_key(table: &shared^.containers, key: key);
      set classes^.containers.inner[k] = id;
    }
  }
  let item_count = classes^.items.inner.len;
  for (k in 0_u64..item_count) {
    let inside = k < styles^.items.inner.len;
    if inside {
      clear_key(key: key);
      key_item(key: key, value: styles^.items.inner[k]);
      let id = intern_key(table: &shared^.items, key: key);
      set classes^.items.inner[k] = id;
    }
  }
  let table_count = classes^.tables.inner.len;
  for (k in 0_u64..table_count) {
    let inside = k < styles^.tables.inner.len;
    if inside {
      clear_key(key: key);
      key_table(key: key, value: styles^.tables.inner[k]);
      let id = intern_key(table: &shared^.tables, key: key);
      set classes^.tables.inner[k] = id;
    }
  }
  let content_group_count = classes^.content_groups.inner.len;
  for (k in 0_u64..content_group_count) {
    let inside = k < styles^.contents.inner.len;
    if inside {
      clear_key(key: key);
      key_content(key: key, classes: classes, value: styles^.contents.inner[k]);
      let id = intern_key(table: &shared^.content_groups, key: key);
      set classes^.content_groups.inner[k] = id;
    }
  }
  return unit;
}

fn same_class(old_classes: &Box<Array<u32>>, old_id: u32, new_classes: &Box<Array<u32>>, new_id: u32) -> same: Bool reads(old_classes), reads(new_classes) {
  doc "True when both identifiers are inside their runs' tables and name entries of one class.";
  let old_at = cvt::<u32, u64>(old_id);
  let new_at = cvt::<u32, u64>(new_id);
  let old_inside = old_at < old_classes^.inner.len;
  let new_inside = new_at < new_classes^.inner.len;
  let inside = band(old_inside, new_inside);
  if inside {
  } else {
    return False();
  }
  let first = old_classes^.inner[old_at];
  let second = new_classes^.inner[new_at];
  let equal = first == second;
  return equal;
}

fn background_present(styles: &Styles, id: u32) -> present: Bool reads(styles) {
  doc "The background predicate inline fragments read: currentColor or positive alpha; an identifier outside the background table is absent, as culled_box treats it.";
  let at = cvt::<u32, u64>(id);
  if at < styles^.backgrounds.inner.len {
    let color = styles^.backgrounds.inner[at].color;
    let painted = fgt(color.color.alpha, 0.0_f32);
    let present = bor(color.current, painted);
    return present;
  }
  return False();
}

fn same_style(old: &Styles, new: &Styles, old_classes: &Classes, new_classes: &Classes, old_style: ComputedStyle, new_style: ComputedStyle) -> same: Bool reads(old), reads(new), reads(old_classes), reads(new_classes) {
  doc "True when the two computed styles agree on the box, size, spacing, border, font, text, container, item, table and content groups by class and on background presence; a compared class identifier outside its table is a difference.";
  let same_box = same_class(old_classes: &old_classes^.boxes, old_id: old_style.box, new_classes: &new_classes^.boxes, new_id: new_style.box);
  if same_box {
  } else {
    return False();
  }
  let same_size = same_class(old_classes: &old_classes^.sizes, old_id: old_style.size, new_classes: &new_classes^.sizes, new_id: new_style.size);
  if same_size {
  } else {
    return False();
  }
  let same_spacing = same_class(old_classes: &old_classes^.spacings, old_id: old_style.spacing, new_classes: &new_classes^.spacings, new_id: new_style.spacing);
  if same_spacing {
  } else {
    return False();
  }
  let same_border = same_class(old_classes: &old_classes^.borders, old_id: old_style.border, new_classes: &new_classes^.borders, new_id: new_style.border);
  if same_border {
  } else {
    return False();
  }
  let same_font = same_class(old_classes: &old_classes^.fonts, old_id: old_style.font, new_classes: &new_classes^.fonts, new_id: new_style.font);
  if same_font {
  } else {
    return False();
  }
  let same_text = same_class(old_classes: &old_classes^.texts, old_id: old_style.text, new_classes: &new_classes^.texts, new_id: new_style.text);
  if same_text {
  } else {
    return False();
  }
  let same_container = same_class(old_classes: &old_classes^.containers, old_id: old_style.container, new_classes: &new_classes^.containers, new_id: new_style.container);
  if same_container {
  } else {
    return False();
  }
  let same_item = same_class(old_classes: &old_classes^.items, old_id: old_style.item, new_classes: &new_classes^.items, new_id: new_style.item);
  if same_item {
  } else {
    return False();
  }
  let same_table = same_class(old_classes: &old_classes^.tables, old_id: old_style.table, new_classes: &new_classes^.tables, new_id: new_style.table);
  if same_table {
  } else {
    return False();
  }
  let same_content = same_class(old_classes: &old_classes^.content_groups, old_id: old_style.content, new_classes: &new_classes^.content_groups, new_id: new_style.content);
  if same_content {
  } else {
    return False();
  }
  let old_background = background_present(styles: old, id: old_style.background);
  let new_background = background_present(styles: new, id: new_style.background);
  let same_background = eeq(old_background, new_background);
  return same_background;
}

fn pseudo_slots(styles: &Styles, count: u64) -> slots: Box<Array<u32>> reads(styles) {
  doc "For each element below count, at twice its position and one more for ::after, the index of its pseudo-element in styles, or absent_pseudo when it has none or its content is normal or none, which pkg::layout skips as it does an absent one.";
  let width = count +sat count;
  let fits = width <= 2147483648_u64;
  let room = if fits {
    give width;
  } else {
    give 0_u64;
  }
  let slots = box_array_filled::<u32>(count: room, value: absent_pseudo);
  let total = styles^.pseudos.inner.len;
  for (p in 0_u64..total) {
    let pseudo = styles^.pseudos.inner[p];
    let element = cvt::<u32, u64>(pseudo.element);
    let kind = cvt::<u8, u64>(pseudo.kind);
    let twice = element +sat element;
    let at = twice +sat kind;
    let inside = at < slots.inner.len;
    let small = kind < 2_u64;
    let usable = band(inside, small);
    let content_at = cvt::<u32, u64>(pseudo.style.content);
    let known = content_at < styles^.contents.inner.len;
    let generates = if known {
      let listed_content = styles^.contents.inner[content_at].content;
      let more = listed_content > 1_u32;
      give more;
    } else {
      give True();
    }
    let counted = band(usable, generates);
    if counted {
      let index = cvt.wrap::<u64, u32>(p);
      set slots.inner[at] = index;
    }
  }
  return move slots;
}

fn same_pseudo(old: &Styles, new: &Styles, old_classes: &Classes, new_classes: &Classes, old_slots: &Box<Array<u32>>, new_slots: &Box<Array<u32>>, old_slot: u64, new_slot: u64) -> same: Bool reads(old), reads(new), reads(old_classes), reads(new_classes), reads(old_slots), reads(new_slots) {
  doc "True when the pseudo-element slots old_slot of old and new_slot of new, one element's in each result, are both empty, or hold pseudo-elements of the same style.";
  let old_listed = old_slot < old_slots^.inner.len;
  let new_listed = new_slot < new_slots^.inner.len;
  let listed = band(old_listed, new_listed);
  if listed {
  } else {
    return False();
  }
  let old_index = old_slots^.inner[old_slot];
  let new_index = new_slots^.inner[new_slot];
  let old_absent = old_index == absent_pseudo;
  let new_absent = new_index == absent_pseudo;
  let both_absent = band(old_absent, new_absent);
  if both_absent {
    return True();
  }
  let either_absent = bor(old_absent, new_absent);
  if either_absent {
    return False();
  }
  let old_at = cvt::<u32, u64>(old_index);
  let new_at = cvt::<u32, u64>(new_index);
  let old_inside = old_at < old^.pseudos.inner.len;
  let new_inside = new_at < new^.pseudos.inner.len;
  let inside = band(old_inside, new_inside);
  if inside {
  } else {
    return False();
  }
  let old_style = old^.pseudos.inner[old_at].style;
  let new_style = new^.pseudos.inner[new_at].style;
  let same = same_style(old: old, new: new, old_classes: old_classes, new_classes: new_classes, old_style: old_style, new_style: new_style);
  return same;
}

fn layout_changes(old: &Styles, new: &Styles) -> changed: Box<Array<Bool>> reads(old), reads(new) {
  doc "Maps the tables of both results onto classes by value, then compares each element's ten group classes, its background presence and its two pseudo-element slots, aligning the two results by NodeId through their order maps; the result has one slot per NodeId index of the longer map, true for an element of one result only and false for a node that is an element of neither. Group identifiers are not comparable across runs, so every entry of every compared table of both results is written as a sequence of words that holds all of its value, a list a group names written by the class of the list, and the sequences of both runs are interned in one WordTable per table: two entries have one class exactly when their sequences are equal word for word, which is equality of every field and not a comparison of hashes, so no group or list compare is simplified. A list is written by its contents: computed tracks with their line names, area names and corners, content items with their text bytes, counter changes, quote pairs with their text bytes, and a font group by the names of the families of its range. A pseudo-element whose content is normal or none generates no box and counts as absent, as pkg::layout treats it. Content lists 0 and 1 and quote lists 0 and 1 are empty lists of different meanings and are written as words of their own. Background presence compares whether its colour is currentColor or has positive alpha, which inline fragment generation reads. The exact background colour, the colour of the text group, the four colours of the border group and custom groups are left out because pkg::layout reads none of them.";
  let old_count = old^.elements.inner.len;
  let new_count = new^.elements.inner.len;
  let old_nodes = old^.order.inner.len;
  let new_nodes = new^.order.inner.len;
  let longer = old_nodes > new_nodes;
  let count = if longer {
    give old_nodes;
  } else {
    give new_nodes;
  }
  let no = False();
  let small = count <= 1073741824_u64;
  let room = if small {
    give count;
  } else {
    give 0_u64;
  }
  let changed = box_array_filled::<Bool>(count: room, value: no);
  let shared = class_tables_new(old: old, new: new);
  let key = box_slots_new::<u64>(capacity: 64_u64);
  let new_classes = classes_new(styles: new);
  let old_classes = classes_new(styles: old);
  classify_lists(shared: &shared, key: &key, styles: new, classes: &new_classes);
  classify_lists(shared: &shared, key: &key, styles: old, classes: &old_classes);
  classify_groups(shared: &shared, key: &key, styles: new, classes: &new_classes);
  classify_groups(shared: &shared, key: &key, styles: old, classes: &old_classes);
  let old_slots = pseudo_slots(styles: old, count: old_count);
  let new_slots = pseudo_slots(styles: new, count: new_count);
  for (n in 0_u64..room) {
    let old_at = if n < old^.order.inner.len {
      give cvt::<u32, u64>(old^.order.inner[n]);
    } else {
      give old_count;
    }
    let new_at = if n < new^.order.inner.len {
      give cvt::<u32, u64>(new^.order.inner[n]);
    } else {
      give new_count;
    }
    let old_listed = old_at < old^.elements.inner.len;
    let new_listed = new_at < new^.elements.inner.len;
    let both = band(old_listed, new_listed);
    let flag = if both {
      let old_style = old^.elements.inner[old_at];
      let new_style = new^.elements.inner[new_at];
      let same = same_style(old: old, new: new, old_classes: &old_classes, new_classes: &new_classes, old_style: old_style, new_style: new_style);
      let old_twice = old_at +sat old_at;
      let new_twice = new_at +sat new_at;
      let old_after = old_twice +sat 1_u64;
      let new_after = new_twice +sat 1_u64;
      let same_before = same_pseudo(old: old, new: new, old_classes: &old_classes, new_classes: &new_classes, old_slots: &old_slots, new_slots: &new_slots, old_slot: old_twice, new_slot: new_twice);
      let same_after = same_pseudo(old: old, new: new, old_classes: &old_classes, new_classes: &new_classes, old_slots: &old_slots, new_slots: &new_slots, old_slot: old_after, new_slot: new_after);
      let pseudos = band(same_before, same_after);
      let unchanged = band(same, pseudos);
      give bnot(unchanged);
    } else {
      give bor(old_listed, new_listed);
    }
    set changed.inner[n] = flag;
  }
  return move changed;
}
