fn element_node(state: &StyleState, element: u64) -> node: u64 reads(state) {
  doc "Maps a stable element slot to its styled-node slot. Original elements retain their index; appended elements follow the original pseudo-elements. New pseudo membership requests a full build.";
  if element < state^.cascade.element_count {
    return element;
  }
  let node = element +sat state^.styles.pseudos.inner.len;
  return node;
}

fn structure_fallback() -> result: Result<Restyled, StyleError> pure {
  doc "Requests the caller's full traversal and state rebuild for a structural edit the kept representation cannot cover.";
  let yes = True();
  let changed = box_slots_new::<u32>(capacity: 0_u64);
  let made = Restyled(full: yes, structural: yes, visited: 0_u64, changed: move changed);
  return Ok<Restyled, StyleError>(value: move made);
}

fn grow_seeded<T: copy>(cells: &Box<Slots<T>>, count: u64) -> result: Result<unit, StyleError> writes(cells) {
  doc "Appends count initialized slots, each a copy of the existing first slot, to be overwritten by the new elements' cascade.";
  if cells^.inner.len == 0_u64 {
    return inconsistent::<unit>();
  }
  let seed = cells^.inner[0_u64];
  for (k in 0_u64..count) {
    let added = propagate push::<T>(cell: cells, value: seed, ceiling: node_ceiling);
  }
  return Ok<unit, StyleError>(value: unit);
}

fn grow_filled<T: copy>(cells: &Box<Slots<T>>, value: T, count: u64) -> result: Result<unit, StyleError> writes(cells) {
  doc "Appends count slots holding value.";
  for (k in 0_u64..count) {
    let added = propagate push::<T>(cell: cells, value: value, ceiling: node_ceiling);
  }
  return Ok<unit, StyleError>(value: unit);
}

fn grow_rows(state: &StyleState, traversal: &Traversal, count: u64) -> result: Result<unit, StyleError> writes(state), writes(traversal) {
  doc "Grows every per-element and styled-node row by count new slots, each row once and independently of the others: the node, parent and depth rows with placeholders fill_row overwrites, winners and custom keys empty, the pseudo-element rows and marks cleared, and the value rows with their initialized seeds, which the value passes overwrite.";
  let hole = NodeId(index: unvisited);
  let grown_nodes = propagate grow_filled::<NodeId>(cells: &state^.cascade.nodes, value: hole, count: count);
  let grown_parents = propagate grow_filled::<u32>(cells: &state^.cascade.parents, value: 0_u32, count: count);
  let grown_kinds = propagate grow_filled::<u8>(cells: &state^.cascade.kinds, value: 0_u8, count: count);
  let winners = count *sat winner_words;
  let grown_winners = propagate grow_filled::<u32>(cells: &state^.cascade.winners, value: 0_u32, count: winners);
  let customs = count *sat state^.cascade.custom_count;
  let grown_customs = propagate grow_filled::<u64>(cells: &state^.cascade.custom_keys, value: 0_u64, count: customs);
  let grown_inherited_fonts = propagate grow_seeded::<FontGroup>(cells: &state^.inherited.fonts, count: count);
  let grown_inherited_texts = propagate grow_seeded::<TextGroup>(cells: &state^.inherited.texts, count: count);
  let grown_inherited_visibility = propagate grow_seeded::<u8>(cells: &state^.inherited.visibility, count: count);
  let grown_inherited_font_keywords = propagate grow_seeded::<u8>(cells: &state^.inherited.font_keywords, count: count);
  let grown_inherited_font_scales = propagate grow_seeded::<f32>(cells: &state^.inherited.font_scales, count: count);
  let grown_inherited_ex = propagate grow_seeded::<f32>(cells: &state^.inherited.ex, count: count);
  let grown_inherited_ch = propagate grow_seeded::<f32>(cells: &state^.inherited.ch, count: count);
  let grown_inherited_lh = propagate grow_seeded::<f32>(cells: &state^.inherited.lh, count: count);
  let grown_inherited_sets = propagate grow_seeded::<u32>(cells: &state^.inherited.sets, count: count);
  let grown_inherited_tables = propagate grow_seeded::<TableGroup>(cells: &state^.inherited.tables, count: count);
  let grown_inherited_quotes = propagate grow_seeded::<u32>(cells: &state^.inherited.quotes, count: count);
  let grown_inherited_list_positions = propagate grow_seeded::<u8>(cells: &state^.inherited.list_positions, count: count);
  let grown_inherited_resolved_first = propagate grow_seeded::<u32>(cells: &state^.inherited.resolved_first, count: count);
  let grown_inherited_resolved_end = propagate grow_seeded::<u32>(cells: &state^.inherited.resolved_end, count: count);
  let grown_resets_boxes = propagate grow_seeded::<BoxGroup>(cells: &state^.resets.boxes, count: count);
  let grown_resets_sizes = propagate grow_seeded::<SizeGroup>(cells: &state^.resets.sizes, count: count);
  let grown_resets_spacings = propagate grow_seeded::<SpacingGroup>(cells: &state^.resets.spacings, count: count);
  let grown_resets_borders = propagate grow_seeded::<BorderGroup>(cells: &state^.resets.borders, count: count);
  let grown_resets_backgrounds = propagate grow_seeded::<BackgroundGroup>(cells: &state^.resets.backgrounds, count: count);
  let grown_resets_vertical_aligns = propagate grow_seeded::<Sizing>(cells: &state^.resets.vertical_aligns, count: count);
  let grown_resets_decorations = propagate grow_seeded::<u8>(cells: &state^.resets.decorations, count: count);
  let grown_resets_containers = propagate grow_seeded::<ContainerGroup>(cells: &state^.resets.containers, count: count);
  let grown_resets_track_nodes = propagate grow_seeded::<TrackNodes>(cells: &state^.resets.track_nodes, count: count);
  let grown_resets_items = propagate grow_seeded::<ItemGroup>(cells: &state^.resets.items, count: count);
  let grown_resets_table_layouts = propagate grow_seeded::<u8>(cells: &state^.resets.table_layouts, count: count);
  let grown_resets_contents = propagate grow_seeded::<ContentGroup>(cells: &state^.resets.contents, count: count);
  let grown_styles = propagate grow_seeded::<ComputedStyle>(cells: &state^.styles.elements, count: count);
  let grown_flags = propagate grow_filled::<u8>(cells: &state^.pseudo_flags, value: 0_u8, count: count);
  let grown_first = propagate grow_filled::<u32>(cells: &state^.pseudo_first, value: no_pseudo, count: count);
  let grown_marks = propagate grow_filled::<u8>(cells: &state^.marks, value: 0_u8, count: count);
  let grown_elements = propagate grow_filled::<NodeId>(cells: &traversal^.elements, value: hole, count: count);
  let grown_element_parents = propagate grow_filled::<u32>(cells: &traversal^.parents, value: 0_u32, count: count);
  let grown_depths = propagate grow_filled::<u32>(cells: &traversal^.depths, value: 0_u32, count: count);
  return Ok<unit, StyleError>(value: unit);
}

fn subtree_elements(document: &Document, root: NodeId) -> result: Result<Box<Slots<NodeId>>, StyleError> reads(document) {
  doc "Lists only root's element subtree through child and sibling links. The walk follows the links that supply its next node; it never lists the document's other elements.";
  let nodes = box_slots_new::<NodeId>(capacity: 0_u64);
  let current = Some<NodeId>(value: root);
  let limit = document^.nodes.inner.len;
  for (step in 0_u64..limit) {
    let node = match current {
      Some(value: found) => {
        give found;
      }
      None() => {
        return Ok<Box<Slots<NodeId>>, StyleError>(value: move nodes);
      }
    }
    let element = is_element(document: document, node: node);
    if element {
      let added = propagate push::<NodeId>(cell: &nodes, value: node, ceiling: node_ceiling);
    }
    set current = next_within(document: document, node: node, root: root);
  }
  match current {
    Some(..) => {
      return inconsistent::<Box<Slots<NodeId>>>();
    }
    None() => {
      return Ok<Box<Slots<NodeId>>, StyleError>(value: move nodes);
    }
  }
}

fn new_parent_slot(traversal: &Traversal, document: &Document, node: NodeId) -> result: Result<u64, StyleError> reads(traversal), reads(document) {
  doc "The stable slot of a new element's parent element: the edited parent's existing slot, or a slot the order scatter gave another new element.";
  let at = cvt::<u32, u64>(node.index);
  if at < document^.nodes.inner.len {
  } else {
    return inconsistent::<u64>();
  }
  let parent = match document^.nodes.inner[at].links.parent {
    Some(value: found) => {
      give cvt::<u32, u64>(found^.index);
    }
    None() => {
      return inconsistent::<u64>();
    }
  }
  if parent < traversal^.order.inner.len {
  } else {
    return inconsistent::<u64>();
  }
  let slot = cvt::<u32, u64>(traversal^.order.inner[parent]);
  if slot < traversal^.elements.inner.len {
  } else {
    return inconsistent::<u64>();
  }
  return Ok<u64, StyleError>(value: slot);
}

fn new_depth(document: &Document, node: NodeId, root: NodeId, base: u32) -> result: Result<u32, StyleError> reads(document) {
  doc "The depth of node, an element of the subtree inserted at root, as base, root's depth, plus its steps up to root through the document's parent links, so that no new element waits for its parent's row; TooLarge past depth_ceiling.";
  let current = node.index;
  let steps = 0_u32;
  for (step in 0_u64..depth_ceiling) {
    if current == root.index {
      let depth = base +sat steps;
      let wide = cvt::<u32, u64>(depth);
      if wide > depth_ceiling {
        let failure = StyleError::TooLarge();
        return Err<u32, StyleError>(error: failure);
      }
      return Ok<u32, StyleError>(value: depth);
    }
    let at = cvt::<u32, u64>(current);
    if at < document^.nodes.inner.len {
    } else {
      return inconsistent::<u32>();
    }
    match document^.nodes.inner[at].links.parent {
      Some(value: found) => {
        set current = found^.index;
      }
      None() => {
        return inconsistent::<u32>();
      }
    }
    set steps = steps +sat 1_u32;
  }
  let failure = StyleError::TooLarge();
  return Err<u32, StyleError>(error: failure);
}

fn structure_restyle(state: &StyleState, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment, parent: NodeId, previous: Option<NodeId>, next: Option<NodeId>, inserted: Option<NodeId>, removed: Option<NodeId>) -> result: Result<Restyled, StyleError> reads(store), reads(document), writes(state), writes(traversal), writes(atoms) {
  doc "Updates the edited parent's sibling positions, checks bounded structural reaches and pseudo membership, then appends or clears only the edited subtree's slots. An insertion grows every row once (grow_rows), writes the order maps for the new elements, a scatter through their NodeIds that is the one sequential step because Whitefoot cannot yet prove such indices distinct (status-board item proof-range-field), and then fills each new element's rows at its own slot in a loop where no iteration reads a row another writes: depths come from steps up to the subtree's root (new_depth), so siblings wait on nothing and a child only on the order map. The union of new and structurally reached elements is deduplicated by marks and passed to the existing level frontier; new elements are always returned as changed.";
  let adding = match inserted {
    Some(..) => {
      give True();
    }
    None() => {
      give False();
    }
  }
  let root = match inserted {
    Some(value: found) => {
      match removed {
        Some(..) => {
          return inconsistent::<Restyled>();
        }
        None() => {
        }
      }
      give found;
    }
    None() => {
      match removed {
        Some(value: found) => {
          give found;
        }
        None() => {
          return inconsistent::<Restyled>();
        }
      }
    }
  }
  let parent_at = cvt::<u32, u64>(parent.index);
  if parent_at < traversal^.order.inner.len {
    let parent_slot = cvt::<u32, u64>(traversal^.order.inner[parent_at]);
    if parent_slot < traversal^.elements.inner.len {
    } else {
      return structure_fallback();
    }
  } else {
    return structure_fallback();
  }
  let subtree = propagate subtree_elements(document: document, root: root);
  let count = subtree.inner.len;
  children_changed(positions: &state^.cascade.positions, document: document, parent: parent);
  let reached = propagate structural_restyle(store: store, document: document, atoms: atoms, parent: parent, previous: previous, next: next);
  if reached.full {
    return structure_fallback();
  }
  for (k in 0_u64..count) {
    let node = subtree.inner[k];
    if adding {
      let bits = pseudo_bits(state: state, store: store, document: document, atoms: atoms, element: node);
      if bits != 0_u8 {
        return structure_fallback();
      }
    }
  }
  let reached_count = reached.nodes.inner.len;
  for (k in 0_u64..reached_count) {
    let at = cvt::<u32, u64>(reached.nodes.inner[k].index);
    if at < traversal^.order.inner.len {
      if traversal^.order.inner[at] == 0_u32 {
        return structure_fallback();
      }
    }
  }
  if reached.pseudos {
    for (k in 0_u64..reached_count) {
      let node = reached.nodes.inner[k];
      let at = cvt::<u32, u64>(node.index);
      if at < traversal^.order.inner.len {
        let slot = cvt::<u32, u64>(traversal^.order.inner[at]);
        if slot < state^.pseudo_flags.inner.len {
          let bits = pseudo_bits(state: state, store: store, document: document, atoms: atoms, element: node);
          if bits != state^.pseudo_flags.inner[slot] {
            return structure_fallback();
          }
        }
      }
    }
  }
  let first_new = traversal^.elements.inner.len;
  if adding {
    let old_nodes = traversal^.order.inner.len;
    let nodes = document^.nodes.inner.len;
    for (k in old_nodes..nodes) {
      let listed = propagate push::<u32>(cell: &traversal^.order, value: unvisited, ceiling: node_ceiling);
      let styled = propagate push::<u32>(cell: &state^.styles.order, value: unvisited, ceiling: node_ceiling);
    }
    if parent_at < traversal^.order.inner.len {
    } else {
      return structure_fallback();
    }
    let parent_slot = cvt::<u32, u64>(traversal^.order.inner[parent_at]);
    if parent_slot < traversal^.depths.inner.len {
    } else {
      return structure_fallback();
    }
    let above = cvt::<u32, u64>(traversal^.depths.inner[parent_slot]);
    if above >= depth_ceiling {
      let failure = StyleError::TooLarge();
      return Err<Restyled, StyleError>(error: failure);
    }
    let base = traversal^.depths.inner[parent_slot] +sat 1_u32;
    let ends = first_new +sat count;
    if ends < element_ceiling {
    } else {
      return inconsistent::<Restyled>();
    }
    let grown = propagate grow_rows(state: state, traversal: traversal, count: count);
    for (k in 0_u64..count) {
      let node = subtree.inner[k];
      let at = cvt::<u32, u64>(node.index);
      let wide = first_new +sat k;
      let slot = cvt.wrap::<u64, u32>(wide);
      if at < traversal^.order.inner.len {
        set traversal^.order.inner[at] = slot;
      }
      if at < state^.styles.order.inner.len {
        set state^.styles.order.inner[at] = slot;
      }
    }
    for (k in 0_u64..count) {
      let node = subtree.inner[k];
      let slot = first_new +sat k;
      let up = propagate new_parent_slot(traversal: traversal, document: document, node: node);
      let depth = propagate new_depth(document: document, node: node, root: root, base: base);
      let node_slot = element_node(state: state, element: slot);
      let parent_node = element_node(state: state, element: up);
      if slot < traversal^.elements.inner.len {
        set traversal^.elements.inner[slot] = node;
      }
      if slot < traversal^.parents.inner.len {
        set traversal^.parents.inner[slot] = cvt.wrap::<u64, u32>(up);
      }
      if slot < traversal^.depths.inner.len {
        set traversal^.depths.inner[slot] = depth;
      }
      if node_slot < state^.cascade.nodes.inner.len {
        set state^.cascade.nodes.inner[node_slot] = node;
      }
      if node_slot < state^.cascade.parents.inner.len {
        set state^.cascade.parents.inner[node_slot] = cvt.wrap::<u64, u32>(parent_node);
      }
    }
  } else {
    for (k in 0_u64..count) {
      let node = subtree.inner[k];
      let at = cvt::<u32, u64>(node.index);
      if at < traversal^.order.inner.len {
        let slot = cvt::<u32, u64>(traversal^.order.inner[at]);
        let node_slot = element_node(state: state, element: slot);
        let pseudos = box_slots_new::<u64>(capacity: 0_u64);
        let listed = propagate pseudo_nodes(state: state, element: slot, nodes: &pseudos);
        let hole = NodeId(index: unvisited);
        for (p in 0_u64..pseudos.inner.len) {
          let pseudo = pseudos.inner[p];
          if pseudo < state^.cascade.nodes.inner.len {
            set state^.cascade.nodes.inner[pseudo] = hole;
          }
        }
        if slot < state^.pseudo_flags.inner.len {
          set state^.pseudo_flags.inner[slot] = 0_u8;
        }
        if slot < state^.pseudo_first.inner.len {
          set state^.pseudo_first.inner[slot] = no_pseudo;
        }
        set traversal^.order.inner[at] = unvisited;
        if at < state^.styles.order.inner.len {
          set state^.styles.order.inner[at] = unvisited;
        }
        if slot < traversal^.elements.inner.len {
          set traversal^.elements.inner[slot] = hole;
        }
        if node_slot < state^.cascade.nodes.inner.len {
          set state^.cascade.nodes.inner[node_slot] = hole;
        }
      }
    }
  }
  set traversal^.stale = True();
  let wanted = box_slots_new::<u32>(capacity: 0_u64);
  let last_new = traversal^.elements.inner.len;
  for (slot in first_new..last_new) {
    if slot < state^.marks.inner.len {
      set state^.marks.inner[slot] = in_set;
      let narrow = cvt.wrap::<u64, u32>(slot);
      let added = propagate push::<u32>(cell: &wanted, value: narrow, ceiling: node_ceiling);
    }
  }
  for (k in 0_u64..reached_count) {
    let at = cvt::<u32, u64>(reached.nodes.inner[k].index);
    if at < traversal^.order.inner.len {
      let slot = cvt::<u32, u64>(traversal^.order.inner[at]);
      if slot < state^.marks.inner.len {
        if state^.marks.inner[slot] == 0_u8 {
          set state^.marks.inner[slot] = in_set;
          let narrow = cvt.wrap::<u64, u32>(slot);
          let added = propagate push::<u32>(cell: &wanted, value: narrow, ceiling: node_ceiling);
        }
      }
    }
  }
  let no = False();
  let unedited = NodeId(index: unvisited);
  let set_of = RestyleSet(full: no, elements: move wanted, pseudos: no, edited: unedited);
  let done = propagate restyle(state: state, store: store, document: document, atoms: atoms, traversal: traversal, environment: environment, wanted: &set_of);
  set done.structural = True();
  for (slot in first_new..last_new) {
    let narrow = cvt.wrap::<u64, u32>(slot);
    let added = propagate push::<u32>(cell: &done.changed, value: narrow, ceiling: node_ceiling);
  }
  return Ok<Restyled, StyleError>(value: move done);
}
