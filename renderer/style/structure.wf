fn element_node(state: &StyleState, element: u64) -> node: u64 reads(state) {
  doc "Maps a stable element slot to its styled-node slot. Original elements retain their index; appended elements follow the original pseudo-elements. New pseudo membership requests a full build.";
  if element < state^.cascade.element_count {
    return element;
  }
  let node = element +sat state^.styles.pseudos.inner.len;
  return node;
}

fn structure_fallback() -> result: Result<Restyled, StyleError> pure {
  doc "Requests the caller's full traversal and state rebuild for a structural edit the kept representation cannot cover.";
  let yes = True();
  let changed = box_slots_new::<u32>(capacity: 0_u64);
  let made = Restyled(full: yes, structural: yes, visited: 0_u64, changed: move changed);
  return Ok<Restyled, StyleError>(value: move made);
}

fn append_seed<T: copy>(cells: &Box<Slots<T>>) -> result: Result<unit, StyleError> writes(cells) {
  doc "Appends one initialized slot, to be overwritten by the new element's cascade, using the existing first slot as a typed seed.";
  if cells^.inner.len == 0_u64 {
    return inconsistent::<unit>();
  }
  let seed = cells^.inner[0_u64];
  let added = propagate push::<T>(cell: cells, value: seed, ceiling: node_ceiling);
  return Ok<unit, StyleError>(value: unit);
}

fn append_style_node(state: &StyleState, node: NodeId, parent: u32) -> result: Result<unit, StyleError> writes(state) {
  doc "Appends the new element's styled-node rows. Every row has its old length until its own append; winners and custom keys start empty, and the three value passes overwrite their initialized seeds.";
  let added_node = propagate push::<NodeId>(cell: &state^.cascade.nodes, value: node, ceiling: node_ceiling);
  let added_parent = propagate push::<u32>(cell: &state^.cascade.parents, value: parent, ceiling: node_ceiling);
  let added_kind = propagate push::<u8>(cell: &state^.cascade.kinds, value: 0_u8, ceiling: node_ceiling);
  for (k in 0_u64..winner_words) {
    let added = propagate push::<u32>(cell: &state^.cascade.winners, value: 0_u32, ceiling: node_ceiling);
  }
  let customs = state^.cascade.custom_count;
  for (k in 0_u64..customs) {
    let added = propagate push::<u64>(cell: &state^.cascade.custom_keys, value: 0_u64, ceiling: node_ceiling);
  }
  let added_inherited_fonts = propagate append_seed::<FontGroup>(cells: &state^.inherited.fonts);
  let added_inherited_texts = propagate append_seed::<TextGroup>(cells: &state^.inherited.texts);
  let added_inherited_visibility = propagate append_seed::<u8>(cells: &state^.inherited.visibility);
  let added_inherited_font_keywords = propagate append_seed::<u8>(cells: &state^.inherited.font_keywords);
  let added_inherited_font_scales = propagate append_seed::<f32>(cells: &state^.inherited.font_scales);
  let added_inherited_ex = propagate append_seed::<f32>(cells: &state^.inherited.ex);
  let added_inherited_ch = propagate append_seed::<f32>(cells: &state^.inherited.ch);
  let added_inherited_lh = propagate append_seed::<f32>(cells: &state^.inherited.lh);
  let added_inherited_sets = propagate append_seed::<u32>(cells: &state^.inherited.sets);
  let added_inherited_tables = propagate append_seed::<TableGroup>(cells: &state^.inherited.tables);
  let added_inherited_quotes = propagate append_seed::<u32>(cells: &state^.inherited.quotes);
  let added_inherited_list_positions = propagate append_seed::<u8>(cells: &state^.inherited.list_positions);
  let added_inherited_resolved_first = propagate append_seed::<u32>(cells: &state^.inherited.resolved_first);
  let added_inherited_resolved_end = propagate append_seed::<u32>(cells: &state^.inherited.resolved_end);
  let added_resets_boxes = propagate append_seed::<BoxGroup>(cells: &state^.resets.boxes);
  let added_resets_sizes = propagate append_seed::<SizeGroup>(cells: &state^.resets.sizes);
  let added_resets_spacings = propagate append_seed::<SpacingGroup>(cells: &state^.resets.spacings);
  let added_resets_borders = propagate append_seed::<BorderGroup>(cells: &state^.resets.borders);
  let added_resets_backgrounds = propagate append_seed::<BackgroundGroup>(cells: &state^.resets.backgrounds);
  let added_resets_vertical_aligns = propagate append_seed::<Sizing>(cells: &state^.resets.vertical_aligns);
  let added_resets_decorations = propagate append_seed::<u8>(cells: &state^.resets.decorations);
  let added_resets_containers = propagate append_seed::<ContainerGroup>(cells: &state^.resets.containers);
  let added_resets_track_nodes = propagate append_seed::<TrackNodes>(cells: &state^.resets.track_nodes);
  let added_resets_items = propagate append_seed::<ItemGroup>(cells: &state^.resets.items);
  let added_resets_table_layouts = propagate append_seed::<u8>(cells: &state^.resets.table_layouts);
  let added_resets_contents = propagate append_seed::<ContentGroup>(cells: &state^.resets.contents);
  return Ok<unit, StyleError>(value: unit);
}

fn subtree_elements(document: &Document, root: NodeId) -> result: Result<Box<Slots<NodeId>>, StyleError> reads(document) {
  doc "Lists only root's element subtree through child and sibling links. The walk follows the links that supply its next node; it never lists the document's other elements.";
  let nodes = box_slots_new::<NodeId>(capacity: 0_u64);
  let current = Some<NodeId>(value: root);
  let limit = document^.nodes.inner.len;
  for (step in 0_u64..limit) {
    let node = match current {
      Some(value: found) => {
        give found;
      }
      None() => {
        return Ok<Box<Slots<NodeId>>, StyleError>(value: move nodes);
      }
    }
    let element = is_element(document: document, node: node);
    if element {
      let added = propagate push::<NodeId>(cell: &nodes, value: node, ceiling: node_ceiling);
    }
    set current = next_within(document: document, node: node, root: root);
  }
  match current {
    Some(..) => {
      return inconsistent::<Box<Slots<NodeId>>>();
    }
    None() => {
      return Ok<Box<Slots<NodeId>>, StyleError>(value: move nodes);
    }
  }
}

fn append_element(state: &StyleState, traversal: &Traversal, document: &Document, node: NodeId) -> result: Result<unit, StyleError> reads(document), writes(state), writes(traversal) {
  doc "Appends one stable element slot and its styled-node rows. The parent slot already exists, so its depth plus one supplies the depth without a preorder traversal.";
  let at = cvt::<u32, u64>(node.index);
  if at < document^.nodes.inner.len {
  } else {
    return inconsistent::<unit>();
  }
  let parent = match document^.nodes.inner[at].links.parent {
    Some(value: found) => {
      give cvt::<u32, u64>(found^.index);
    }
    None() => {
      return inconsistent::<unit>();
    }
  }
  if parent < traversal^.order.inner.len {
  } else {
    return inconsistent::<unit>();
  }
  let parent_slot = cvt::<u32, u64>(traversal^.order.inner[parent]);
  if parent_slot < traversal^.depths.inner.len {
  } else {
    return inconsistent::<unit>();
  }
  let above = cvt::<u32, u64>(traversal^.depths.inner[parent_slot]);
  if above >= depth_ceiling {
    let failure = StyleError::TooLarge();
    return Err<unit, StyleError>(error: failure);
  }
  let depth = traversal^.depths.inner[parent_slot] +sat 1_u32;
  let slot = traversal^.elements.inner.len;
  if slot < element_ceiling {
  } else {
    return inconsistent::<unit>();
  }
  let narrow = cvt::<u64, u32>(slot);
  let narrow_parent = cvt.wrap::<u64, u32>(parent_slot);
  let parent_node = element_node(state: state, element: parent_slot);
  let narrow_parent_node = cvt.wrap::<u64, u32>(parent_node);
  let added = propagate append_style_node(state: state, node: node, parent: narrow_parent_node);
  let element_added = propagate push::<NodeId>(cell: &traversal^.elements, value: node, ceiling: node_ceiling);
  let parent_added = propagate push::<u32>(cell: &traversal^.parents, value: narrow_parent, ceiling: node_ceiling);
  let depth_added = propagate push::<u32>(cell: &traversal^.depths, value: depth, ceiling: node_ceiling);
  let style_added = propagate append_seed::<ComputedStyle>(cells: &state^.styles.elements);
  let flag_added = propagate push::<u8>(cell: &state^.pseudo_flags, value: 0_u8, ceiling: node_ceiling);
  let first_added = propagate push::<u32>(cell: &state^.pseudo_first, value: no_pseudo, ceiling: node_ceiling);
  let mark_added = propagate push::<u8>(cell: &state^.marks, value: 0_u8, ceiling: node_ceiling);
  if at < traversal^.order.inner.len {
    set traversal^.order.inner[at] = narrow;
  }
  if at < state^.styles.order.inner.len {
    set state^.styles.order.inner[at] = narrow;
  }
  return Ok<unit, StyleError>(value: unit);
}

fn structure_restyle(state: &StyleState, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment, parent: NodeId, inserted: Option<NodeId>, removed: Option<NodeId>) -> result: Result<Restyled, StyleError> reads(store), reads(document), writes(state), writes(traversal), writes(atoms) {
  doc "Updates the edited parent's sibling positions, checks bounded structural reaches and pseudo membership, then appends or clears only the edited subtree's slots. The union of new and structurally reached elements is deduplicated by marks and passed to the existing level frontier; new elements are always returned as changed.";
  let adding = match inserted {
    Some(..) => {
      give True();
    }
    None() => {
      give False();
    }
  }
  let root = match inserted {
    Some(value: found) => {
      match removed {
        Some(..) => {
          return inconsistent::<Restyled>();
        }
        None() => {
        }
      }
      give found;
    }
    None() => {
      match removed {
        Some(value: found) => {
          give found;
        }
        None() => {
          return inconsistent::<Restyled>();
        }
      }
    }
  }
  let parent_at = cvt::<u32, u64>(parent.index);
  if parent_at < traversal^.order.inner.len {
    let parent_slot = cvt::<u32, u64>(traversal^.order.inner[parent_at]);
    if parent_slot < traversal^.elements.inner.len {
    } else {
      return structure_fallback();
    }
  } else {
    return structure_fallback();
  }
  let subtree = propagate subtree_elements(document: document, root: root);
  let count = subtree.inner.len;
  children_changed(positions: &state^.cascade.positions, document: document, parent: parent);
  let reached = propagate structural_restyle(store: store, document: document, atoms: atoms, parent: parent);
  if reached.full {
    return structure_fallback();
  }
  for (k in 0_u64..count) {
    let node = subtree.inner[k];
    if adding {
      let bits = pseudo_bits(state: state, store: store, document: document, atoms: atoms, element: node);
      if bits != 0_u8 {
        return structure_fallback();
      }
    }
  }
  let reached_count = reached.nodes.inner.len;
  for (k in 0_u64..reached_count) {
    let at = cvt::<u32, u64>(reached.nodes.inner[k].index);
    if at < traversal^.order.inner.len {
      if traversal^.order.inner[at] == 0_u32 {
        return structure_fallback();
      }
    }
  }
  if reached.pseudos {
    for (k in 0_u64..reached_count) {
      let node = reached.nodes.inner[k];
      let at = cvt::<u32, u64>(node.index);
      if at < traversal^.order.inner.len {
        let slot = cvt::<u32, u64>(traversal^.order.inner[at]);
        if slot < state^.pseudo_flags.inner.len {
          let bits = pseudo_bits(state: state, store: store, document: document, atoms: atoms, element: node);
          if bits != state^.pseudo_flags.inner[slot] {
            return structure_fallback();
          }
        }
      }
    }
  }
  let first_new = traversal^.elements.inner.len;
  if adding {
    let old_nodes = traversal^.order.inner.len;
    let nodes = document^.nodes.inner.len;
    for (k in old_nodes..nodes) {
      let listed = propagate push::<u32>(cell: &traversal^.order, value: unvisited, ceiling: node_ceiling);
      let styled = propagate push::<u32>(cell: &state^.styles.order, value: unvisited, ceiling: node_ceiling);
    }
    for (k in 0_u64..count) {
      let node = subtree.inner[k];
      let added = propagate append_element(state: state, traversal: traversal, document: document, node: node);
    }
  } else {
    for (k in 0_u64..count) {
      let node = subtree.inner[k];
      let at = cvt::<u32, u64>(node.index);
      if at < traversal^.order.inner.len {
        let slot = cvt::<u32, u64>(traversal^.order.inner[at]);
        let node_slot = element_node(state: state, element: slot);
        let pseudos = box_slots_new::<u64>(capacity: 0_u64);
        let listed = propagate pseudo_nodes(state: state, element: slot, nodes: &pseudos);
        let hole = NodeId(index: unvisited);
        for (p in 0_u64..pseudos.inner.len) {
          let pseudo = pseudos.inner[p];
          if pseudo < state^.cascade.nodes.inner.len {
            set state^.cascade.nodes.inner[pseudo] = hole;
          }
        }
        if slot < state^.pseudo_flags.inner.len {
          set state^.pseudo_flags.inner[slot] = 0_u8;
        }
        if slot < state^.pseudo_first.inner.len {
          set state^.pseudo_first.inner[slot] = no_pseudo;
        }
        set traversal^.order.inner[at] = unvisited;
        if at < state^.styles.order.inner.len {
          set state^.styles.order.inner[at] = unvisited;
        }
        if slot < traversal^.elements.inner.len {
          set traversal^.elements.inner[slot] = hole;
        }
        if node_slot < state^.cascade.nodes.inner.len {
          set state^.cascade.nodes.inner[node_slot] = hole;
        }
      }
    }
  }
  set traversal^.stale = True();
  let wanted = box_slots_new::<u32>(capacity: 0_u64);
  let last_new = traversal^.elements.inner.len;
  for (slot in first_new..last_new) {
    if slot < state^.marks.inner.len {
      set state^.marks.inner[slot] = in_set;
      let narrow = cvt.wrap::<u64, u32>(slot);
      let added = propagate push::<u32>(cell: &wanted, value: narrow, ceiling: node_ceiling);
    }
  }
  for (k in 0_u64..reached_count) {
    let at = cvt::<u32, u64>(reached.nodes.inner[k].index);
    if at < traversal^.order.inner.len {
      let slot = cvt::<u32, u64>(traversal^.order.inner[at]);
      if slot < state^.marks.inner.len {
        if state^.marks.inner[slot] == 0_u8 {
          set state^.marks.inner[slot] = in_set;
          let narrow = cvt.wrap::<u64, u32>(slot);
          let added = propagate push::<u32>(cell: &wanted, value: narrow, ceiling: node_ceiling);
        }
      }
    }
  }
  let no = False();
  let unedited = NodeId(index: unvisited);
  let set_of = RestyleSet(full: no, elements: move wanted, pseudos: no, edited: unedited);
  let done = propagate restyle(state: state, store: store, document: document, atoms: atoms, traversal: traversal, environment: environment, wanted: &set_of);
  set done.structural = True();
  for (slot in first_new..last_new) {
    let narrow = cvt.wrap::<u64, u32>(slot);
    let added = propagate push::<u32>(cell: &done.changed, value: narrow, ceiling: node_ceiling);
  }
  return Ok<Restyled, StyleError>(value: move done);
}
