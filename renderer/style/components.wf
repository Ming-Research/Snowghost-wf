fn block_end_at(values: &ComponentList, at: u64) -> found: u64 reads(values) contract {
  requires at < values^.components.inner.len;
} {
  doc "The index after the contents of the function or block at at, or at + 1 for any other component.";
  match values^.components.inner[at] {
    Ident(..) => {
      return at +sat 1_u64;
    }
    Function(name: n, end: e) => {
      let wide = cvt::<u32, u64>(e^);
      return wide;
    }
    AtKeyword(..) => {
      return at +sat 1_u64;
    }
    Hash(..) => {
      return at +sat 1_u64;
    }
    QuotedString(..) => {
      return at +sat 1_u64;
    }
    Url(..) => {
      return at +sat 1_u64;
    }
    Delim(..) => {
      return at +sat 1_u64;
    }
    Number(..) => {
      return at +sat 1_u64;
    }
    Percentage(..) => {
      return at +sat 1_u64;
    }
    Dimension(..) => {
      return at +sat 1_u64;
    }
    UnicodeRange(..) => {
      return at +sat 1_u64;
    }
    IncludeMatch() => {
      return at +sat 1_u64;
    }
    DashMatch() => {
      return at +sat 1_u64;
    }
    PrefixMatch() => {
      return at +sat 1_u64;
    }
    SuffixMatch() => {
      return at +sat 1_u64;
    }
    SubstringMatch() => {
      return at +sat 1_u64;
    }
    Column() => {
      return at +sat 1_u64;
    }
    Whitespace() => {
      return at +sat 1_u64;
    }
    Cdo() => {
      return at +sat 1_u64;
    }
    Cdc() => {
      return at +sat 1_u64;
    }
    Colon() => {
      return at +sat 1_u64;
    }
    Semicolon() => {
      return at +sat 1_u64;
    }
    Comma() => {
      return at +sat 1_u64;
    }
    ParenthesisBlock(end: e) => {
      let wide = cvt::<u32, u64>(e^);
      return wide;
    }
    BracketBlock(end: e) => {
      let wide = cvt::<u32, u64>(e^);
      return wide;
    }
    BraceBlock(end: e) => {
      let wide = cvt::<u32, u64>(e^);
      return wide;
    }
    Error(..) => {
      return at +sat 1_u64;
    }
  }
}

fn sibling_after(values: &ComponentList, at: u64, limit: u64) -> next: u64 reads(values) contract {
  requires at < limit;
  requires limit <= values^.components.inner.len;
  ensures next > at;
  ensures next <= limit;
} {
  doc "The index of the sibling after the component at at, past a function's or block's contents, clamped to limit.";
  let end = block_end_at(values: values, at: at);
  if end <= at {
    let one = at + 1_u64;
    return one;
  }
  if end > limit {
    return limit;
  }
  return end;
}

fn skip_space(values: &ComponentList, at: u64, limit: u64) -> next: u64 reads(values) contract {
  requires limit <= values^.components.inner.len;
  ensures next >= at;
} {
  doc "The first index at or after at, before limit, that holds no whitespace, or the larger of at and limit.";
  if at >= limit {
    return at;
  }
  let span = limit - at;
  for (step in 0_u64..span) {
    let here = at + step;
    let kind = component_kind(values: values, at: here);
    if kind != c_space {
      return here;
    }
  }
  return limit;
}

fn text_bounds(values: &ComponentList, span: Span) -> (start: u64, end: u64) reads(values) contract {
  ensures start <= end;
  ensures end <= values^.text.inner.len;
} {
  doc "The byte bounds of span in values.text, empty when it is reversed or outside the text.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = values^.text.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
    return start, end;
  }
  return 0_u64, 0_u64;
}

fn lower_byte(byte: u8) -> lower: u8 pure {
  doc "Lowers an ASCII upper-case letter.";
  let from_a = byte >= 65_u8;
  let to_z = byte <= 90_u8;
  let upper = band(from_a, to_z);
  if upper {
    let lowered = byte + 32_u8;
    return lowered;
  }
  return byte;
}

fn word_index(list: &[u8], text: &[u8]) -> found: Option<u64> reads(list), reads(text) {
  doc "The number of the space-separated word of list (lower case) equal to text ASCII case-insensitively, or None.";
  let length = list^.len;
  let size = text^.len;
  if size == 0_u64 {
    return None<u64>();
  }
  let word = 0_u64;
  let start = 0_u64;
  let stop = length +sat 1_u64;
  for (at in 0_u64..stop) {
    let boundary = at >= length;
    let space = if boundary {
      give True();
    } else {
      give list^[at] == 32_u8;
    }
    if space {
      let ordered = start <= at;
      let inside = at <= length;
      let usable = band(ordered, inside);
      if usable {
        let width = at - start;
        if width == size {
          let same = True();
          for (k in 0_u64..size) {
            let index = start + k;
            let inner = index < length;
            if inner {
              let a = list^[index];
              let b = lower_byte(byte: text^[k]);
              if a != b {
                set same = False();
              }
            }
          }
          if same {
            return Some<u64>(value: word);
          }
        }
      }
      set word = word +sat 1_u64;
      set start = at +sat 1_u64;
    }
  }
  return None<u64>();
}

fn name_word(values: &ComponentList, at: u64, list: &[u8]) -> found: Option<u64> reads(values), reads(list) contract {
  requires at < values^.components.inner.len;
} {
  doc "The number in list of the identifier or function name at at, ASCII case-insensitively, or None.";
  match name_at(values: values, at: at) {
    Some(value: name) => {
      let (a, b) = text_bounds(values: values, span: name);
      let found = word_index(list: list, text: &values^.text.inner[a..b]);
      return found;
    }
    None() => {
      return None<u64>();
    }
  }
}
