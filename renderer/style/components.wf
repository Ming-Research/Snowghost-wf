alias ComponentList = pkg::css::syntax::ComponentList;
alias Numeric = pkg::css::syntax::Numeric;
alias Span = pkg::css::syntax::Span;

const c_ident: u8 = 0_u8;

const c_function: u8 = 1_u8;

const c_hash: u8 = 2_u8;

const c_string: u8 = 3_u8;

const c_delim: u8 = 4_u8;

const c_number: u8 = 5_u8;

const c_percentage: u8 = 6_u8;

const c_dimension: u8 = 7_u8;

const c_space: u8 = 8_u8;

const c_comma: u8 = 9_u8;

const c_paren: u8 = 10_u8;

const c_colon: u8 = 11_u8;

const c_url: u8 = 12_u8;

const c_other: u8 = 13_u8;

fn component_kind(values: &ComponentList, at: u64) -> kind: u8 reads(values) contract {
  requires at < values^.components.inner.len;
} {
  doc "Classifies the component at at: c_ident, c_function, c_hash, c_string, c_delim, c_number, c_percentage, c_dimension, c_space, c_comma, c_paren, c_colon, c_url, or c_other.";
  match values^.components.inner[at] {
    Ident(..) => {
      return 0_u8;
    }
    Function(..) => {
      return 1_u8;
    }
    AtKeyword(..) => {
      return 13_u8;
    }
    Hash(..) => {
      return 2_u8;
    }
    QuotedString(..) => {
      return 3_u8;
    }
    Url(..) => {
      return 12_u8;
    }
    Delim(..) => {
      return 4_u8;
    }
    Number(..) => {
      return 5_u8;
    }
    Percentage(..) => {
      return 6_u8;
    }
    Dimension(..) => {
      return 7_u8;
    }
    UnicodeRange(..) => {
      return 13_u8;
    }
    IncludeMatch() => {
      return 13_u8;
    }
    DashMatch() => {
      return 13_u8;
    }
    PrefixMatch() => {
      return 13_u8;
    }
    SuffixMatch() => {
      return 13_u8;
    }
    SubstringMatch() => {
      return 13_u8;
    }
    Column() => {
      return 13_u8;
    }
    Whitespace() => {
      return 8_u8;
    }
    Cdo() => {
      return 13_u8;
    }
    Cdc() => {
      return 13_u8;
    }
    Colon() => {
      return 11_u8;
    }
    Semicolon() => {
      return 13_u8;
    }
    Comma() => {
      return 9_u8;
    }
    ParenthesisBlock(..) => {
      return 10_u8;
    }
    BracketBlock(..) => {
      return 13_u8;
    }
    BraceBlock(..) => {
      return 13_u8;
    }
    Error(..) => {
      return 13_u8;
    }
  }
}

fn name_at(values: &ComponentList, at: u64) -> found: Option<Span> reads(values) contract {
  requires at < values^.components.inner.len;
} {
  doc "The name of the identifier or function at at, or None.";
  match values^.components.inner[at] {
    Ident(name: n) => {
      return Some<Span>(value: n^);
    }
    Function(name: n, end: e) => {
      return Some<Span>(value: n^);
    }
    AtKeyword(..) => {
      return None<Span>();
    }
    Hash(..) => {
      return None<Span>();
    }
    QuotedString(..) => {
      return None<Span>();
    }
    Url(..) => {
