    IncludeMatch() => {
      return None<Span>();
    }
    DashMatch() => {
      return None<Span>();
    }
    PrefixMatch() => {
      return None<Span>();
    }
    SuffixMatch() => {
      return None<Span>();
    }
    SubstringMatch() => {
      return None<Span>();
    }
    Column() => {
      return None<Span>();
    }
    Whitespace() => {
      return None<Span>();
    }
    Cdo() => {
      return None<Span>();
    }
    Cdc() => {
      return None<Span>();
    }
    Colon() => {
      return None<Span>();
    }
    Semicolon() => {
      return None<Span>();
    }
    Comma() => {
      return None<Span>();
    }
    ParenthesisBlock(..) => {
      return None<Span>();
    }
    BracketBlock(..) => {
      return None<Span>();
    }
    BraceBlock(..) => {
      return None<Span>();
    }
    Error(..) => {
      return None<Span>();
    }
  }
}

