alias AtomTable = pkg::base::atom::AtomTable;
alias ComponentRange = pkg::css::rules::ComponentRange;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias TextSpan = pkg::dom::TextSpan;
alias atom_canvas = pkg::base::static_atoms::atom_canvas;
alias atom_col = pkg::base::static_atoms::atom_col;
alias atom_embed = pkg::base::static_atoms::atom_embed;
alias atom_height = pkg::base::static_atoms::atom_height;
alias atom_hr = pkg::base::static_atoms::atom_hr;
alias atom_iframe = pkg::base::static_atoms::atom_iframe;
alias atom_img = pkg::base::static_atoms::atom_img;
alias atom_input = pkg::base::static_atoms::atom_input;
alias atom_object = pkg::base::static_atoms::atom_object;
alias atom_table = pkg::base::static_atoms::atom_table;
alias atom_tbody = pkg::base::static_atoms::atom_tbody;
alias atom_td = pkg::base::static_atoms::atom_td;
alias atom_tfoot = pkg::base::static_atoms::atom_tfoot;
alias atom_th = pkg::base::static_atoms::atom_th;
alias atom_thead = pkg::base::static_atoms::atom_thead;
alias atom_tr = pkg::base::static_atoms::atom_tr;
alias atom_type = pkg::base::static_atoms::atom_type;
alias atom_video = pkg::base::static_atoms::atom_video;
alias atom_width = pkg::base::static_atoms::atom_width;
alias parse_component_values = pkg::css::syntax::parse_component_values;
alias parse_declaration_list = pkg::css::rules::parse_declaration_list;

const border_name: Array<u8, 6> = "border";

const cellspacing_name: Array<u8, 11> = "cellspacing";

const cellpadding_name: Array<u8, 11> = "cellpadding";

const image_word: Array<u8, 5> = "image";

const width_text: Array<u8, 6> = "width:";

const height_text: Array<u8, 7> = "height:";

const aspect_text: Array<u8, 18> = "aspect-ratio:auto ";

const spacing_text: Array<u8, 15> = "border-spacing:";

const border_width_text: Array<u8, 13> = "border-width:";

const padding_text: Array<u8, 8> = "padding:";

const outset_text: Array<u8, 20> = "border-style:outset;";

const inset_text: Array<u8, 57> = "border-width:1px;border-style:inset;border-color:inherit;";

const px_text: Array<u8, 3> = "px;";

const percent_text: Array<u8, 2> = "%;";

const one_px_text: Array<u8, 4> = "1px;";

const ratio_slash: Array<u8, 3> = " / ";

struct Number {
  valid: Bool;
  start: u64;
  end: u64;
  percent: Bool;
  zero: Bool;
}

struct HintNames {
  border: u32;
  cellspacing: u32;
  cellpadding: u32;
}

fn no_number() -> made: Number pure {
  doc "A number that did not parse.";
  let no = False();
  return Number(valid: no, start: 0_u64, end: 0_u64, percent: no, zero: no);
}

fn digit_byte(byte: u8) -> digit: Bool pure {
  doc "True for an ASCII digit.";
  let from = byte >= 48_u8;
  let to = byte <= 57_u8;
  let both = band(from, to);
  return both;
}

fn parse_number(document: &Document, span: TextSpan, dimension: Bool) -> number: Number reads(document) {
  doc "Parses the attribute value span with the HTML Standard's rules for parsing non-negative integers, or, when dimension holds, its rules for parsing dimension values: leading ASCII whitespace, then, for an integer, an optional plus sign, then digits, then for a dimension an optional fraction of a full stop and digits and an optional percent sign; anything after is ignored. The result is the bounds of the number's text in the document, whether it is a percentage and whether it is zero.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = document^.text.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
  } else {
    let made = no_number();
    return made;
  }
  let at = start;
  let span_width = end - start;
  for (step in 0_u64..span_width) {
    let here = at < end;
    if here {
    } else {
      break;
    }
    let byte = document^.text.inner[at];
    let space = is_space_byte(byte: byte);
    if space {
      set at = at + 1_u64;
    } else {
      break;
    }
  }
  let integer = bnot(dimension);
  if integer {
    let here = at < end;
    if here {
      if document^.text.inner[at] == 43_u8 {
        set at = at + 1_u64;
      }
    }
  }
  let digits_start = at;
  let zero = True();
  for (step in 0_u64..span_width) {
    let here = at < end;
    if here {
    } else {
      break;
    }
    let byte = document^.text.inner[at];
    let digit = digit_byte(byte: byte);
    if digit {
      if byte != 48_u8 {
        set zero = False();
      }
      set at = at + 1_u64;
    } else {
      break;
    }
  }
  if at == digits_start {
    let made = no_number();
    return made;
  }
  let number_end = at;
  let percent = False();
  if dimension {
    let here = at < end;
    if here {
      if document^.text.inner[at] == 46_u8 {
        let fraction_start = at + 1_u64;
        let probe = fraction_start;
        for (step in 0_u64..span_width) {
          let more = probe < end;
          if more {
          } else {
            break;
          }
          let byte = document^.text.inner[probe];
          let digit = digit_byte(byte: byte);
          if digit {
            if byte != 48_u8 {
              set zero = False();
            }
            set probe = probe + 1_u64;
          } else {
            break;
          }
        }
        if probe > fraction_start {
          set number_end = probe;
          set at = probe;
        }
      }
    }
    let after = at < end;
    if after {
      if document^.text.inner[at] == 37_u8 {
        set percent = True();
      }
    }
  }
  let yes = True();
  return Number(valid: yes, start: digits_start, end: number_end, percent: percent, zero: zero);
}

fn put_hint_text(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) {
  doc "Appends text to the hint buffer.";
  let length = text^.len;
  for (k in 0_u64..length) {
    let byte = text^[k];
    emit(out: buffer, value: byte);
  }
  return unit;
}

fn put_number_text(buffer: &Box<Slots<u8>>, document: &Document, number: Number) -> result: unit reads(document), writes(buffer) {
  doc "Appends the text of a parsed number.";
  let ordered = number.start <= number.end;
  let inside = number.end <= document^.text.inner.len;
  let usable = band(ordered, inside);
  if usable {
    put_hint_text(buffer: buffer, text: &document^.text.inner[number.start..number.end]);
  }
  return unit;
}

fn dimension_hint(buffer: &Box<Slots<u8>>, document: &Document, node: NodeId, attribute: u32, property: &[u8], nonzero: Bool) -> number: Number reads(document), reads(property), writes(buffer) {
  doc "Appends property's declaration of the attribute's value as a dimension, in px or as a percentage, when it parses, and not zero when nonzero holds; returns the parsed number.";
  match attribute_of(document: document, node: node, name: attribute) {
    Some(value: span) => {
      let yes = True();
      let number = parse_number(document: document, span: span, dimension: yes);
      let refused = band(nonzero, number.zero);
      let usable_right = bnot(refused);
      let usable = band(number.valid, usable_right);
      if usable {
        put_hint_text(buffer: buffer, text: property);
        put_number_text(buffer: buffer, document: document, number: number);
        if number.percent {
          put_hint_text(buffer: buffer, text: &percent_text[0_u64..percent_text.len]);
        } else {
          put_hint_text(buffer: buffer, text: &px_text[0_u64..px_text.len]);
        }
      }
      return number;
    }
    None() => {
      let made = no_number();
      return made;
    }
  }
}

fn integer_of(document: &Document, node: NodeId, attribute: u32) -> number: Number reads(document) {
  doc "The attribute's value parsed as a non-negative integer.";
  match attribute_of(document: document, node: node, name: attribute) {
    Some(value: span) => {
      let no = False();
      let number = parse_number(document: document, span: span, dimension: no);
      return number;
    }
    None() => {
      let made = no_number();
      return made;
    }
  }
}

fn has_attribute(document: &Document, node: NodeId, attribute: u32) -> present: Bool reads(document) {
  doc "True when node has the attribute.";
  match attribute_of(document: document, node: node, name: attribute) {
    Some(..) => {
      return True();
    }
    None() => {
      return False();
    }
  }
}

fn aspect_hint(buffer: &Box<Slots<u8>>, document: &Document, width: Number, height: Number, number_rules: Bool) -> result: unit reads(document), writes(buffer) {
  doc "Appends aspect-ratio: auto w / h when both numbers parsed and, under the dimension rules, neither is a percentage.";
  let both = band(width.valid, height.valid);
  let percent = bor(width.percent, height.percent);
  let refused = band(number_rules, percent);
  let usable_right = bnot(refused);
  let usable = band(both, usable_right);
  if usable {
    put_hint_text(buffer: buffer, text: &aspect_text[0_u64..aspect_text.len]);
    put_number_text(buffer: buffer, document: document, number: width);
    put_hint_text(buffer: buffer, text: &ratio_slash[0_u64..ratio_slash.len]);
    put_number_text(buffer: buffer, document: document, number: height);
    emit(out: buffer, value: 59_u8);
  }
  return unit;
}

fn is_image_input(document: &Document, node: NodeId) -> image: Bool reads(document) {
  doc "True for an input element whose type attribute is image, ASCII case-insensitively.";
  match attribute_of(document: document, node: node, name: atom_type) {
    Some(value: span) => {
      let n = image_word.len;
      let found = has_token(document: document, span: span, word: &image_word[0_u64..n]);
      return found;
    }
    None() => {
      return False();
    }
  }
}

fn html_name(document: &Document, traversal: &Traversal, position: u64) -> local: u32 reads(document), reads(traversal) {
  doc "The local name atom of the element at preorder position when it is in the HTML namespace, otherwise 4294967295.";
  let count = traversal^.elements.inner.len;
  let inside = position < count;
  if inside {
  } else {
    return 4294967295_u32;
  }
  let node = traversal^.elements.inner[position];
  let (html, local) = element_name(document: document, node: node);
  if html {
    return local;
  }
  return 4294967295_u32;
}

fn parent_of(traversal: &Traversal, position: u64) -> parent: u64 reads(traversal) {
  doc "The preorder index of the element's parent element, or the element count for none.";
  let count = traversal^.parents.inner.len;
  let inside = position < count;
  if inside {
    let parent = cvt::<u32, u64>(traversal^.parents.inner[position]);
    return parent;
  }
  return count;
}

fn cell_table(document: &Document, traversal: &Traversal, position: u64) -> table: u64 reads(document), reads(traversal) {
  doc "The preorder index of the table a td or th belongs to as table > tr > cell or table > thead, tbody or tfoot > tr > cell, or the element count for none.";
  let count = traversal^.elements.inner.len;
  let row = parent_of(traversal: traversal, position: position);
  let row_name = html_name(document: document, traversal: traversal, position: row);
  if row_name != atom_tr {
    return count;
  }
  let above = parent_of(traversal: traversal, position: row);
  let above_name = html_name(document: document, traversal: traversal, position: above);
  if above_name == atom_table {
    return above;
  }
  let head = above_name == atom_thead;
  let body = above_name == atom_tbody;
  let foot = above_name == atom_tfoot;
  let some = bor(head, body);
  let group = bor(some, foot);
  if group {
    let table = parent_of(traversal: traversal, position: above);
    let table_name = html_name(document: document, traversal: traversal, position: table);
    if table_name == atom_table {
      return table;
    }
  }
  return count;
}

fn border_nonzero(document: &Document, node: NodeId, names: HintNames) -> nonzero: Bool reads(document) {
  doc "True when the table has a border attribute whose value is not equivalent to zero: one that does not parse as a non-negative integer or parses to a value other than zero.";
  let present = has_attribute(document: document, node: node, attribute: names.border);
  if present {
  } else {
    return False();
  }
  let number = integer_of(document: document, node: node, attribute: names.border);
  if number.valid {
    let made = bnot(number.zero);
    return made;
  }
  return True();
}

fn element_hints(buffer: &Box<Slots<u8>>, document: &Document, traversal: &Traversal, position: u64, names: HintNames) -> result: unit reads(document), reads(traversal), writes(buffer) {
  doc "Writes the declarations of the presentational hints of the element at preorder position, as CSS text, to buffer.";
  let local = html_name(document: document, traversal: traversal, position: position);
  if local == 4294967295_u32 {
    return unit;
  }
  let count = traversal^.elements.inner.len;
  let inside = position < count;
  if inside {
  } else {
    return unit;
  }
  let node = traversal^.elements.inner[position];
  let yes = True();
  let no = False();
  let width_n = width_text.len;
  let height_n = height_text.len;
  let is_input = local == atom_input;
  let image_input = if is_input {
    give is_image_input(document: document, node: node);
  } else {
    give False();
  }
  let is_img = local == atom_img;
  let is_video = local == atom_video;
  let embedded_a_left = local == atom_embed;
  let embedded_a_right = local == atom_iframe;
  let embedded_a = bor(embedded_a_left, embedded_a_right);
  let embedded_b_left = local == atom_object;
  let embedded_b = bor(embedded_b_left, is_img);
  let embedded_c = bor(is_video, image_input);
  let embedded_ab = bor(embedded_a, embedded_b);
  let embedded = bor(embedded_ab, embedded_c);
  if embedded {
    let width = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_width, property: &width_text[0_u64..width_n], nonzero: no);
    let height = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_height, property: &height_text[0_u64..height_n], nonzero: no);
    let ratio_a = bor(is_img, is_video);
    let ratio = bor(ratio_a, image_input);
    if ratio {
      aspect_hint(buffer: buffer, document: document, width: width, height: height, number_rules: yes);
    }
    return unit;
  }
  if local == atom_canvas {
    let width = integer_of(document: document, node: node, attribute: atom_width);
    let height = integer_of(document: document, node: node, attribute: atom_height);
    aspect_hint(buffer: buffer, document: document, width: width, height: height, number_rules: no);
    return unit;
  }
  if local == atom_table {
    let width = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_width, property: &width_text[0_u64..width_n], nonzero: yes);
    let height = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_height, property: &height_text[0_u64..height_n], nonzero: no);
    let spacing = integer_of(document: document, node: node, attribute: names.cellspacing);
    if spacing.valid {
      put_hint_text(buffer: buffer, text: &spacing_text[0_u64..spacing_text.len]);
      put_number_text(buffer: buffer, document: document, number: spacing);
      put_hint_text(buffer: buffer, text: &px_text[0_u64..px_text.len]);
    }
    let bordered = has_attribute(document: document, node: node, attribute: names.border);
    if bordered {
      let border = integer_of(document: document, node: node, attribute: names.border);
      put_hint_text(buffer: buffer, text: &border_width_text[0_u64..border_width_text.len]);
      if border.valid {
        put_number_text(buffer: buffer, document: document, number: border);
        put_hint_text(buffer: buffer, text: &px_text[0_u64..px_text.len]);
      } else {
        put_hint_text(buffer: buffer, text: &one_px_text[0_u64..one_px_text.len]);
      }
      let nonzero = border_nonzero(document: document, node: node, names: names);
      if nonzero {
        put_hint_text(buffer: buffer, text: &outset_text[0_u64..outset_text.len]);
      }
    }
    return unit;
  }
  let is_hr = local == atom_hr;
  let is_col = local == atom_col;
  let widths = bor(is_hr, is_col);
  if widths {
    let width = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_width, property: &width_text[0_u64..width_n], nonzero: no);
    return unit;
  }
  let rows_a_left = local == atom_tr;
  let rows_a_right = local == atom_thead;
  let rows_a = bor(rows_a_left, rows_a_right);
  let rows_b_left = local == atom_tbody;
  let rows_b_right = local == atom_tfoot;
  let rows_b = bor(rows_b_left, rows_b_right);
  let rows = bor(rows_a, rows_b);
  if rows {
    let height = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_height, property: &height_text[0_u64..height_n], nonzero: no);
    return unit;
  }
  let cell_left = local == atom_td;
  let cell_right = local == atom_th;
  let cell = bor(cell_left, cell_right);
  if cell {
    let width = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_width, property: &width_text[0_u64..width_n], nonzero: yes);
    let height = dimension_hint(buffer: buffer, document: document, node: node, attribute: atom_height, property: &height_text[0_u64..height_n], nonzero: yes);
    let table = cell_table(document: document, traversal: traversal, position: position);
    let listed = table < count;
    if listed {
      let table_node = traversal^.elements.inner[table];
      let padding = integer_of(document: document, node: table_node, attribute: names.cellpadding);
      if padding.valid {
        put_hint_text(buffer: buffer, text: &padding_text[0_u64..padding_text.len]);
        put_number_text(buffer: buffer, document: document, number: padding);
        put_hint_text(buffer: buffer, text: &px_text[0_u64..px_text.len]);
      }
      let nonzero = border_nonzero(document: document, node: table_node, names: names);
      if nonzero {
        put_hint_text(buffer: buffer, text: &inset_text[0_u64..inset_text.len]);
      }
    }
  }
  return unit;
}

fn hint_name(atoms: &AtomTable, name: &[u8]) -> result: Result<u32, StyleError> reads(name), writes(atoms) {
  doc "The atom index of an attribute name.";
  let atom = propagate intern_name(atoms: atoms, name: name);
  return Ok<u32, StyleError>(value: atom.index);
}

fn add_presentational_hints(store: &RuleStore, document: &Document, traversal: &Traversal, atoms: &AtomTable) -> result: Result<unit, StyleError> reads(document), reads(traversal), writes(store), writes(atoms) {
  doc "Writes each element's presentational hints as a declaration list, in preorder, and records it for that element in the store's hints.";
  let border_n = border_name.len;
  let spacing_n = cellspacing_name.len;
  let padding_n = cellpadding_name.len;
  let border = propagate hint_name(atoms: atoms, name: &border_name[0_u64..border_n]);
  let cellspacing = propagate hint_name(atoms: atoms, name: &cellspacing_name[0_u64..spacing_n]);
  let cellpadding = propagate hint_name(atoms: atoms, name: &cellpadding_name[0_u64..padding_n]);
  let names = HintNames(border: border, cellspacing: cellspacing, cellpadding: cellpadding);
  let count = traversal^.elements.inner.len;
  for (at in 0_u64..count) {
    let buffer = box_slots_new::<u8>(capacity: 0_u64);
    element_hints(buffer: &buffer, document: document, traversal: traversal, position: at, names: names);
    let size = buffer.inner.len;
    let some = size > 0_u64;
    let small = size <= sheet_ceiling;
    let usable = band(some, small);
    if usable {
      let parsed = parse_component_values(source: &buffer.inner[0_u64..size]);
      match move parsed {
        Ok(value: list) => {
          let total = list.components.inner.len;
          let last = narrow_index(value: total);
          let whole = ComponentRange(start: 0_u32, end: last);
          let declarations = parse_declaration_list(values: &list, range: whole);
          match move declarations {
            Ok(value: items) => {
              let sheet = narrow_index(value: store^.sheets.inner.len);
              let added = propagate add_declarations(store: store, list: &list, items: &items, sheet: sheet, origin: origin_user_agent, atoms: atoms);
              let kept = Sheet(values: move list);
              let placed = propagate push::<Sheet>(cell: &store^.sheets, value: move kept, ceiling: rule_ceiling);
              let element = narrow_index(value: at);
              let record = AttributeStyle(element: element, first: added.first, end: added.end, custom_first: added.custom_first, custom_end: added.custom_end);
              let recorded = propagate push::<AttributeStyle>(cell: &store^.hints, value: record, ceiling: 4294967295_u64);
            }
            Err(..) => {
              return too_large::<unit>();
            }
          }
        }
        Err(..) => {
          return too_large::<unit>();
        }
      }
    }
  }
  return Ok<unit, StyleError>(value: unit);
}
