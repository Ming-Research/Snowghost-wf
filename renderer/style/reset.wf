const max_inherit_depth: u64 = 4096_u64;

struct ResetValues {
  box_group: BoxGroup;
  size: SizeGroup;
  spacing: SpacingGroup;
  border: BorderGroup;
  background: BackgroundGroup;
  vertical_align: Sizing;
  decoration: u8;
}

struct SecondValues {
  container: ContainerGroup;
  track_nodes: TrackNodes;
  item: ItemGroup;
  table_layout: u8;
  content: ContentGroup;
}

struct Applied {
  found: Bool;
  value: Declared;
  size: f32;
  ex: f32;
  ch: f32;
  lh: f32;
  node: u64;
}

fn not_applied() -> made: Applied pure {
  doc "No declared value: the longhand takes its initial value.";
  let no = False();
  let placeholder = Declared::Keyword(keyword: 0_u8);
  return Applied(found: no, value: placeholder, size: 16.0_f32, ex: 8.0_f32, ch: 8.0_f32, lh: 18.4_f32, node: 0_u64);
}

fn pending_value(store: &RuleStore, inherited: &Inherited, atoms: &AtomTable, element: u64, pending: PendingRef, longhand: u8) -> declared: Option<Declared> reads(store), reads(inherited), reads(atoms) {
  doc "Substitutes var() in a pending value against the element's custom properties in a buffer of its own and parses it with parse_pending, by plain_resolved; None when it is invalid at computed-value time or parse_pending gives nothing.";
  let set_id = if element < inherited^.sets.inner.len {
    give inherited^.sets.inner[element];
  } else {
    give 0_u32;
  }
  let sets = inherited^.custom_sets.inner.len;
  let entries = inherited^.custom_entries.inner.len;
  let (first, end) = entry_range(sets: &inherited^.custom_sets.inner[0_u64..sets], entries_length: entries, set_id: set_id);
  let text_length = inherited^.custom_text.inner.len;
  let (parsed, made) = plain_resolved(store: store, pending: pending, longhand: longhand, entries: &inherited^.custom_entries.inner[first..end], text: &inherited^.custom_text.inner[0_u64..text_length], atoms: atoms);
  return made;
}

fn applied_value(store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, element: u64, longhand: u8) -> applied: Applied reads(store), reads(cascade), reads(inherited), reads(atoms) {
  doc "The declared value that applies to a longhand that is not inherited, with the font size and index of the node it comes from: the node's own, or for inherit its nearest ancestor's that is not inherit, found by walking up; not found for no declaration, initial, unset, a value invalid at computed-value time, or an inherit that reaches the document. A pending value of a stored longhand is read from what the second part resolved.";
  let count = cascade^.parents.inner.len;
  let at = element;
  for (step in 0_u64..max_inherit_depth) {
    let inside = at < count;
    if inside {
    } else {
      let made = not_applied();
      return made;
    }
    let size = if at < inherited^.fonts.inner.len {
      give inherited^.fonts.inner[at].size;
    } else {
      give 16.0_f32;
    }
    let declared = match winner_value(store: store, cascade: cascade, element: at, longhand: longhand) {
      Some(value: d) => {
        give d;
      }
      None() => {
        let made = not_applied();
        return made;
      }
    }
    let resolved = match declared_pending(declared: declared) {
      Some(value: pending) => {
        let stored = stored_longhand(longhand: longhand);
        let parsed = if stored {
          give resolved_lookup(inherited: inherited, node: at, longhand: longhand);
        } else {
          give pending_value(store: store, inherited: inherited, atoms: atoms, element: at, pending: pending, longhand: longhand);
        }
        let inner = match parsed {
          Some(value: v) => {
            give v;
          }
          None() => {
            let made = not_applied();
            return made;
          }
        }
        give inner;
      }
      None() => {
        give declared;
      }
    }
    match declared_wide(declared: resolved) {
      Some(value: keyword) => {
        if keyword == wide_inherit {
          let parent = cvt::<u32, u64>(cascade^.parents.inner[at]);
          let earlier = parent < at;
          if earlier {
            set at = parent;
          } else {
            let made = not_applied();
            return made;
          }
        } else {
          let made = not_applied();
          return made;
        }
      }
      None() => {
        let yes = True();
        let ex = if at < inherited^.ex.inner.len {
          give inherited^.ex.inner[at];
        } else {
          give 8.0_f32;
        }
        let ch = if at < inherited^.ch.inner.len {
          give inherited^.ch.inner[at];
        } else {
          give 8.0_f32;
        }
        let lh = if at < inherited^.lh.inner.len {
          give inherited^.lh.inner[at];
        } else {
          give 18.4_f32;
        }
        return Applied(found: yes, value: resolved, size: size, ex: ex, ch: ch, lh: lh, node: at);
      }
    }
  }
  let made = not_applied();
  return made;
}

fn keyword_reset(applied: Applied, initial: u8) -> keyword: u8 pure {
  doc "A keyword longhand's computed keyword.";
  if applied.found {
    match declared_keyword(declared: applied.value) {
      Some(value: k) => {
        return k;
      }
      None() => {
        return initial;
      }
    }
  }
  return initial;
}

fn lp_reset(applied: Applied, environment: Environment) -> computed: LengthPercentage pure {
  doc "A length-percentage longhand: px with its percentage kept, zero initially.";
  if applied.found {
    match declared_lengths(declared: applied.value) {
      Some(value: lengths) => {
        let made = compute_length(lengths: lengths, font_size: applied.size, ex: applied.ex, ch: applied.ch, lh: applied.lh, environment: environment);
        return made;
      }
      None() => {
      }
    }
  }
  let made = lp_zero();
  return made;
}

fn sizing_reset(applied: Applied, environment: Environment, initial: u8) -> computed: Sizing pure {
  doc "A sizing longhand: auto, none, normal, a size keyword, or a length-percentage; initial is its initial kind.";
  if applied.found {
    match declared_keyword(declared: applied.value) {
      Some(value: k) => {
        if k == keyword_auto {
          let made = sizing_kind(kind: sizing_auto);
          return made;
        }
        if k == keyword_none {
          let made = sizing_kind(kind: sizing_none);
          return made;
        }
        if k == keyword_normal {
          let made = sizing_kind(kind: sizing_normal);
          return made;
        }
        let zero = lp_zero();
        return Sizing(kind: sizing_keyword, keyword: k, value: zero);
      }
      None() => {
      }
    }
    match declared_lengths(declared: applied.value) {
      Some(value: lengths) => {
        let computed = compute_length(lengths: lengths, font_size: applied.size, ex: applied.ex, ch: applied.ch, lh: applied.lh, environment: environment);
        return Sizing(kind: sizing_value, keyword: 0_u8, value: computed);
      }
      None() => {
      }
    }
  }
  if initial == sizing_value {
    let made = sizing_px(px: 0.0_f32);
    return made;
  }
  let made = sizing_kind(kind: initial);
  return made;
}

fn width_reset(applied: Applied, environment: Environment, style: u8) -> width: f32 pure {
  doc "A border width in px: zero when the side's style is none or hidden, 3px initially, a width between 0 and 1px taken as 1px and others rounded down to whole pixels.";
  let hidden = style <= 1_u8;
  if hidden {
    return 0.0_f32;
  }
  let raw = if applied.found {
    let lengths = declared_lengths(declared: applied.value);
    let px = match lengths {
      Some(value: l) => {
        let computed = compute_length(lengths: l, font_size: applied.size, ex: applied.ex, ch: applied.ch, lh: applied.lh, environment: environment);
        give computed.px;
      }
      None() => {
        give 3.0_f32;
      }
    }
    give px;
  } else {
    give 3.0_f32;
  }
  let positive = fgt(raw, 0.0_f32);
  if positive {
  } else {
    return 0.0_f32;
  }
  let thin = flt(raw, 1.0_f32);
  if thin {
    return 1.0_f32;
  }
  let floored = ffloor(raw);
  return floored;
}

fn color_reset(applied: Applied, initial: ColorRef) -> color: ColorRef pure {
  doc "A color longhand that is not inherited: a color or currentcolor, the initial value otherwise.";
  if applied.found {
    match declared_color(declared: applied.value) {
      Some(value: reference) => {
        return reference;
      }
      None() => {
        return initial;
      }
    }
  }
  return initial;
}

fn blockified(display: u8) -> block: u8 pure {
  doc "The block-level equivalent of a display keyword, numbered as display_words lists them: inline, inline-block, the table parts including table-caption, ruby, ruby-text and math become block, inline-table table, inline-flex flex, inline-grid grid and -webkit-inline-box -webkit-box.";
  let inline = display == 0_u8;
  let inline_block = display == 5_u8;
  let simple = bor(inline, inline_block);
  if simple {
    return 1_u8;
  }
  if display == 8_u8 {
    return 7_u8;
  }
  let parts_from = display >= 9_u8;
  let parts_to = display <= 15_u8;
  let parts = band(parts_from, parts_to);
  if parts {
    return 1_u8;
  }
  if display == 16_u8 {
    return 1_u8;
  }
  if display == 18_u8 {
    return 17_u8;
  }
  if display == 20_u8 {
    return 19_u8;
  }
  let ruby_from = display >= 21_u8;
  let ruby_to = display <= 23_u8;
  let ruby = band(ruby_from, ruby_to);
  if ruby {
    return 1_u8;
  }
  if display == 25_u8 {
    return 24_u8;
  }
  return display;
}

fn lays_out_items(display: u8) -> container: Bool pure {
  doc "True for the flex and grid containers, whose children are blockified.";
  let arg_1 = display >= 17_u8;
  let arg_2 = display <= 20_u8;
  let flex = band(arg_1, arg_2);
  let arg_3 = display >= 24_u8;
  let arg_4 = display <= 25_u8;
  let boxes = band(arg_3, arg_4);
  let either = bor(flex, boxes);
  return either;
}

fn reset_element(store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, environment: Environment, element: u64) -> values: ResetValues reads(store), reads(cascade), reads(inherited), reads(atoms) {
  doc "Computes one element's longhands that are not inherited.";
  let display_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_display);
  let declared_display = keyword_reset(applied: display_applied, initial: 0_u8);
  let position_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_position);
  let position = keyword_reset(applied: position_applied, initial: 0_u8);
  let float_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_float);
  let declared_float = keyword_reset(applied: float_applied, initial: 0_u8);
  let arg_5 = position >= 2_u8;
  let arg_6 = position <= 3_u8;
  let absolute = band(arg_5, arg_6);
  let float = if absolute {
    give 0_u8;
  } else {
    give declared_float;
  }
  let parent = if element < cascade^.parents.inner.len {
    give cvt::<u32, u64>(cascade^.parents.inner[element]);
  } else {
    give element;
  }
  let is_root = parent >= element;
  let parent_display = if is_root {
    give 1_u8;
  } else {
    let applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: parent, longhand: lh_display);
    give keyword_reset(applied: applied, initial: 0_u8);
  }
  let floated = float != 0_u8;
  let item = lays_out_items(display: parent_display);
  let out_of_flow = bor(absolute, floated);
  let lifted = bor(out_of_flow, item);
  let blockify = bor(lifted, is_root);
  let display = if blockify {
    let block = blockified(display: declared_display);
    let contents = block == 3_u8;
    let contents_root = band(is_root, contents);
    let lifted_display = if contents_root {
      give 1_u8;
    } else {
      give block;
    }
    give lifted_display;
  } else {
    give declared_display;
  }
  let clear_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_clear);
  let clear = keyword_reset(applied: clear_applied, initial: 0_u8);
  let x_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_overflow_x);
  let y_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_overflow_y);
  let declared_x = keyword_reset(applied: x_applied, initial: 0_u8);
  let declared_y = keyword_reset(applied: y_applied, initial: 0_u8);
  let arg_7 = declared_x == 0_u8;
  let arg_8 = declared_x == 2_u8;
  let x_plain = bor(arg_7, arg_8);
  let arg_9 = declared_y == 0_u8;
  let arg_10 = declared_y == 2_u8;
  let y_plain = bor(arg_9, arg_10);
  let x_scrolls = bnot(x_plain);
  let y_scrolls = bnot(y_plain);
  let fix_x = band(x_plain, y_scrolls);
  let fix_y = band(y_plain, x_scrolls);
  let overflow_x = if fix_x {
    let visible_x = declared_x == 0_u8;
    let fixed_x = if visible_x {
      give 4_u8;
    } else {
      give 1_u8;
    }
    give fixed_x;
  } else {
    give declared_x;
  }
  let overflow_y = if fix_y {
    let visible_y = declared_y == 0_u8;
    let fixed_y = if visible_y {
      give 4_u8;
    } else {
      give 1_u8;
    }
    give fixed_y;
  } else {
    give declared_y;
  }
  let sizing_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_box_sizing);
  let box_sizing = keyword_reset(applied: sizing_applied, initial: 0_u8);
  let bidi_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_unicode_bidi);
  let unicode_bidi = keyword_reset(applied: bidi_applied, initial: 0_u8);
  let visibility = if element < inherited^.visibility.inner.len {
    give inherited^.visibility.inner[element];
  } else {
    give 0_u8;
  }
  let z_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_z_index);
  let z_auto = True();
  let z_index = 0_i32;
  if z_applied.found {
    match declared_integer(declared: z_applied.value) {
      Some(value: n) => {
        set z_auto = False();
        set z_index = n;
      }
      None() => {
      }
    }
  }
  let box_group = BoxGroup(display: display, position: position, float: float, clear: clear, overflow_x: overflow_x, overflow_y: overflow_y, box_sizing: box_sizing, visibility: visibility, z_auto: z_auto, z_index: z_index, unicode_bidi: unicode_bidi);
  let arg_11 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_width);
  let width = sizing_reset(applied: arg_11, environment: environment, initial: sizing_auto);
  let arg_12 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_height);
  let height = sizing_reset(applied: arg_12, environment: environment, initial: sizing_auto);
  let arg_13 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_min_width);
  let min_width = sizing_reset(applied: arg_13, environment: environment, initial: sizing_auto);
  let arg_14 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_min_height);
  let min_height = sizing_reset(applied: arg_14, environment: environment, initial: sizing_auto);
  let arg_15 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_max_width);
  let max_width = sizing_reset(applied: arg_15, environment: environment, initial: sizing_none);
  let arg_16 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_max_height);
  let max_height = sizing_reset(applied: arg_16, environment: environment, initial: sizing_none);
  let arg_17 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_top);
  let top = sizing_reset(applied: arg_17, environment: environment, initial: sizing_auto);
  let arg_18 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_right);
  let right = sizing_reset(applied: arg_18, environment: environment, initial: sizing_auto);
  let arg_19 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_bottom);
  let bottom = sizing_reset(applied: arg_19, environment: environment, initial: sizing_auto);
  let arg_20 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_left);
  let left = sizing_reset(applied: arg_20, environment: environment, initial: sizing_auto);
  let ratio_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_aspect_ratio);
  let aspect_auto = True();
  let aspect_width = 0.0_f32;
  let aspect_height = 0.0_f32;
  if ratio_applied.found {
    match declared_ratio(declared: ratio_applied.value) {
      Some(value: ratio) => {
        set aspect_auto = ratio.auto;
        set aspect_width = ratio.width;
        set aspect_height = ratio.height;
      }
      None() => {
      }
    }
  }
  let size = SizeGroup(width: width, height: height, min_width: min_width, min_height: min_height, max_width: max_width, max_height: max_height, aspect_auto: aspect_auto, aspect_width: aspect_width, aspect_height: aspect_height, top: top, right: right, bottom: bottom, left: left);
  let margin_right_long = lh_margin_top + 1_u8;
  let margin_bottom_long = lh_margin_top + 2_u8;
  let margin_left_long = lh_margin_top + 3_u8;
  let padding_right_long = lh_padding_top + 1_u8;
  let padding_bottom_long = lh_padding_top + 2_u8;
  let padding_left_long = lh_padding_top + 3_u8;
  let arg_21 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_margin_top);
  let margin_top = sizing_reset(applied: arg_21, environment: environment, initial: sizing_value);
  let arg_22 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: margin_right_long);
  let margin_right = sizing_reset(applied: arg_22, environment: environment, initial: sizing_value);
  let arg_23 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: margin_bottom_long);
  let margin_bottom = sizing_reset(applied: arg_23, environment: environment, initial: sizing_value);
  let arg_24 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: margin_left_long);
  let margin_left = sizing_reset(applied: arg_24, environment: environment, initial: sizing_value);
  let arg_25 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_padding_top);
  let padding_top = lp_reset(applied: arg_25, environment: environment);
  let arg_26 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: padding_right_long);
  let padding_right = lp_reset(applied: arg_26, environment: environment);
  let arg_27 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: padding_bottom_long);
  let padding_bottom = lp_reset(applied: arg_27, environment: environment);
  let arg_28 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: padding_left_long);
  let padding_left = lp_reset(applied: arg_28, environment: environment);
  let spacing = SpacingGroup(margin_top: margin_top, margin_right: margin_right, margin_bottom: margin_bottom, margin_left: margin_left, padding_top: padding_top, padding_right: padding_right, padding_bottom: padding_bottom, padding_left: padding_left);
  let yes = True();
  let black = black_color();
  let current = ColorRef(current: yes, color: black);
  let style_right_long = lh_border_top_style + 1_u8;
  let style_bottom_long = lh_border_top_style + 2_u8;
  let style_left_long = lh_border_top_style + 3_u8;
  let width_right_long = lh_border_top_width + 1_u8;
  let width_bottom_long = lh_border_top_width + 2_u8;
  let width_left_long = lh_border_top_width + 3_u8;
  let color_right_long = lh_border_top_color + 1_u8;
  let color_bottom_long = lh_border_top_color + 2_u8;
  let color_left_long = lh_border_top_color + 3_u8;
  let arg_29 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_border_top_style);
  let top_style = keyword_reset(applied: arg_29, initial: 0_u8);
  let arg_30 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: style_right_long);
  let right_style = keyword_reset(applied: arg_30, initial: 0_u8);
  let arg_31 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: style_bottom_long);
  let bottom_style = keyword_reset(applied: arg_31, initial: 0_u8);
  let arg_32 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: style_left_long);
  let left_style = keyword_reset(applied: arg_32, initial: 0_u8);
  let arg_33 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_border_top_width);
  let top_width = width_reset(applied: arg_33, environment: environment, style: top_style);
  let arg_34 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: width_right_long);
  let right_width = width_reset(applied: arg_34, environment: environment, style: right_style);
  let arg_35 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: width_bottom_long);
  let bottom_width = width_reset(applied: arg_35, environment: environment, style: bottom_style);
  let arg_36 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: width_left_long);
  let left_width = width_reset(applied: arg_36, environment: environment, style: left_style);
  let arg_37 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_border_top_color);
  let top_color = color_reset(applied: arg_37, initial: current);
  let arg_38 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: color_right_long);
  let right_color = color_reset(applied: arg_38, initial: current);
  let arg_39 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: color_bottom_long);
  let bottom_color = color_reset(applied: arg_39, initial: current);
  let arg_40 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: color_left_long);
  let left_color = color_reset(applied: arg_40, initial: current);
  let border = BorderGroup(top_width: top_width, right_width: right_width, bottom_width: bottom_width, left_width: left_width, top_style: top_style, right_style: right_style, bottom_style: bottom_style, left_style: left_style, top_color: top_color, right_color: right_color, bottom_color: bottom_color, left_color: left_color);
  let no = False();
  let space = ColorSpace::Rgb();
  let clear_color = Color(space: space, first: 0.0_f32, second: 0.0_f32, third: 0.0_f32, alpha: 0.0_f32, missing: 0_u8);
  let transparent = ColorRef(current: no, color: clear_color);
  let arg_41 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_background_color);
  let background_color = color_reset(applied: arg_41, initial: transparent);
  let background = BackgroundGroup(color: background_color);
  let arg_42 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_vertical_align);
  let vertical_align = sizing_reset(applied: arg_42, environment: environment, initial: sizing_keyword);
  let arg_43 = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_text_decoration_line);
  let decoration = keyword_reset(applied: arg_43, initial: 0_u8);
  return ResetValues(box_group: box_group, size: size, spacing: spacing, border: border, background: background, vertical_align: vertical_align, decoration: decoration);
}

fn reset_all(boxes: &[BoxGroup], sizes: &[SizeGroup], spacings: &[SpacingGroup], borders: &[BorderGroup], backgrounds: &[BackgroundGroup], aligns: &[Sizing], decorations: &[u8], store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, environment: Environment) -> fits: Bool reads(store), reads(cascade), reads(inherited), reads(atoms), writes(boxes), writes(sizes), writes(spacings), writes(borders), writes(backgrounds), writes(aligns), writes(decorations) {
  doc "The third part's first loop: iteration i computes the first batch's longhands and aspect-ratio of the styled node i and writes only slot i of each output.";
  let count = boxes^.len;
  let same_sizes = sizes^.len == count;
  let same_spacings = spacings^.len == count;
  let same_borders = borders^.len == count;
  let same_backgrounds = backgrounds^.len == count;
  let same_aligns = aligns^.len == count;
  let same_decorations = decorations^.len == count;
  let first = band(same_sizes, same_spacings);
  let second = band(same_borders, same_backgrounds);
  let third = band(same_aligns, same_decorations);
  let some = band(first, second);
  let all = band(some, third);
  if all {
  } else {
    return False();
  }
  for (i in 0_u64..count) {
    let values = reset_element(store: store, cascade: cascade, inherited: inherited, atoms: atoms, environment: environment, element: i);
    set boxes^[i] = values.box_group;
    set sizes^[i] = values.size;
    set spacings^[i] = values.spacing;
    set borders^[i] = values.border;
    set backgrounds^[i] = values.background;
    set aligns^[i] = values.vertical_align;
    set decorations^[i] = values.decoration;
  }
  return True();
}

fn reset_second_all(containers: &[ContainerGroup], track_nodes: &[TrackNodes], items: &[ItemGroup], table_layouts: &[u8], contents: &[ContentGroup], store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, environment: Environment) -> fits: Bool reads(store), reads(cascade), reads(inherited), reads(atoms), writes(containers), writes(track_nodes), writes(items), writes(table_layouts), writes(contents) {
  doc "The third part's second loop, independent of the first: iteration i computes the second batch's longhands that are not inherited of the styled node i and writes only slot i of each output. It is a loop of its own so each loop's iteration captures few enough bindings for the runtime to run it in parallel.";
  let count = containers^.len;
  let same_track_nodes = track_nodes^.len == count;
  let same_items = items^.len == count;
  let same_layouts = table_layouts^.len == count;
  let same_contents = contents^.len == count;
  let first = band(same_track_nodes, same_items);
  let second = band(same_layouts, same_contents);
  let all = band(first, second);
  if all {
  } else {
    return False();
  }
  for (i in 0_u64..count) {
    let values = reset_second(store: store, cascade: cascade, inherited: inherited, atoms: atoms, environment: environment, element: i);
    set containers^[i] = values.container;
    set track_nodes^[i] = values.track_nodes;
    set items^[i] = values.item;
    set table_layouts^[i] = values.table_layout;
    set contents^[i] = values.content;
  }
  return True();
}

fn reset_pass(store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Resets, StyleError> reads(store), reads(cascade), reads(inherited), reads(atoms), reads(traversal) {
  doc "Allocates the outputs and runs the third part's loop over the styled nodes with the root font size the second part found.";
  let count = cascade^.nodes.inner.len;
  let small = count <= 4294967294_u64;
  let elements = traversal^.elements.inner.len;
  let matched = elements == cascade^.element_count;
  if matched {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<Resets, StyleError>(error: failure);
  }
  if small {
  } else {
    let failure = StyleError::TooLarge();
    return Err<Resets, StyleError>(error: failure);
  }
  let own_environment = Environment(width: environment.width, height: environment.height, root_font_size: inherited^.root_font_size, serif: environment.serif, sans: environment.sans, mono: environment.mono);
  let blank = not_applied();
  let arg_44 = True();
  let initial_box = BoxGroup(display: 0_u8, position: 0_u8, float: 0_u8, clear: 0_u8, overflow_x: 0_u8, overflow_y: 0_u8, box_sizing: 0_u8, visibility: 0_u8, z_auto: arg_44, z_index: 0_i32, unicode_bidi: 0_u8);
  let auto = sizing_kind(kind: sizing_auto);
  let yes = True();
  let initial_size = SizeGroup(width: auto, height: auto, min_width: auto, min_height: auto, max_width: auto, max_height: auto, aspect_auto: yes, aspect_width: 0.0_f32, aspect_height: 0.0_f32, top: auto, right: auto, bottom: auto, left: auto);
  let zero = lp_zero();
  let zero_sizing = sizing_px(px: 0.0_f32);
  let initial_spacing = SpacingGroup(margin_top: zero_sizing, margin_right: zero_sizing, margin_bottom: zero_sizing, margin_left: zero_sizing, padding_top: zero, padding_right: zero, padding_bottom: zero, padding_left: zero);
  let black = black_color();
  let arg_45 = True();
  let current = ColorRef(current: arg_45, color: black);
  let initial_border = BorderGroup(top_width: 0.0_f32, right_width: 0.0_f32, bottom_width: 0.0_f32, left_width: 0.0_f32, top_style: 0_u8, right_style: 0_u8, bottom_style: 0_u8, left_style: 0_u8, top_color: current, right_color: current, bottom_color: current, left_color: current);
  let initial_background = BackgroundGroup(color: current);
  let baseline = sizing_kind(kind: sizing_keyword);
  let boxes = box_array_filled::<BoxGroup>(count: count, value: initial_box);
  let sizes = box_array_filled::<SizeGroup>(count: count, value: initial_size);
  let spacings = box_array_filled::<SpacingGroup>(count: count, value: initial_spacing);
  let borders = box_array_filled::<BorderGroup>(count: count, value: initial_border);
  let backgrounds = box_array_filled::<BackgroundGroup>(count: count, value: initial_background);
  let aligns = box_array_filled::<Sizing>(count: count, value: baseline);
  let decorations = box_array_filled::<u8>(count: count, value: 0_u8);
  let initial_second = initial_second_values();
  let containers = box_array_filled::<ContainerGroup>(count: count, value: initial_second.container);
  let track_nodes = box_array_filled::<TrackNodes>(count: count, value: initial_second.track_nodes);
  let items = box_array_filled::<ItemGroup>(count: count, value: initial_second.item);
  let table_layouts = box_array_filled::<u8>(count: count, value: 0_u8);
  let contents = box_array_filled::<ContentGroup>(count: count, value: initial_second.content);
  let first_fits = reset_all(boxes: &boxes.inner[0_u64..count], sizes: &sizes.inner[0_u64..count], spacings: &spacings.inner[0_u64..count], borders: &borders.inner[0_u64..count], backgrounds: &backgrounds.inner[0_u64..count], aligns: &aligns.inner[0_u64..count], decorations: &decorations.inner[0_u64..count], store: store, cascade: cascade, inherited: inherited, atoms: atoms, environment: own_environment);
  let second_fits = reset_second_all(containers: &containers.inner[0_u64..count], track_nodes: &track_nodes.inner[0_u64..count], items: &items.inner[0_u64..count], table_layouts: &table_layouts.inner[0_u64..count], contents: &contents.inner[0_u64..count], store: store, cascade: cascade, inherited: inherited, atoms: atoms, environment: own_environment);
  let fits = band(first_fits, second_fits);
  if fits {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<Resets, StyleError>(error: failure);
  }
  let made = Resets(boxes: move boxes, sizes: move sizes, spacings: move spacings, borders: move borders, backgrounds: move backgrounds, vertical_aligns: move aligns, decorations: move decorations, containers: move containers, track_nodes: move track_nodes, items: move items, table_layouts: move table_layouts, contents: move contents);
  return Ok<Resets, StyleError>(value: move made);
}

const list_none_ref: u32 = 4294967295_u32;

const content_normal_ref: u32 = 4294967295_u32;

const content_none_ref: u32 = 4294967294_u32;

fn initial_second_values() -> made: SecondValues pure {
  doc "The initial values of the second batch's longhands that are not inherited, with the reference sentinels the interning step reads: no template, auto implicit tracks, normal content and no counter changes.";
  let normal = sizing_kind(kind: sizing_normal);
  let column_auto = sizing_kind(kind: sizing_auto);
  let container = ContainerGroup(flex_direction: 0_u8, flex_wrap: 0_u8, justify_content: align_normal, align_items: align_normal, align_content: align_normal, justify_items: align_normal, row_gap: normal, column_gap: normal, template_columns: list_none_ref, template_rows: list_none_ref, template_areas: list_none_ref, auto_flow: 0_u8, auto_columns: list_none_ref, auto_rows: list_none_ref, column_count: 0_u32, column_width: column_auto, column_fill: 0_u8);
  let nodes = TrackNodes(columns: 0_u32, rows: 0_u32, auto_columns: 0_u32, auto_rows: 0_u32);
  let auto = sizing_kind(kind: sizing_auto);
  let no = False();
  let blank = Atom(index: 0_u32);
  let line = GridLine(kind: line_auto, number: 0_i32, name: blank, named: no);
  let item = ItemGroup(order: 0_i32, grow: 0.0_f32, shrink: 1.0_f32, basis: auto, align_self: align_auto, justify_self: align_auto, row_start: line, row_end: line, column_start: line, column_end: line, break_inside: 0_u8);
  let content = ContentGroup(content: content_normal_ref, counter_reset: list_none_ref, counter_increment: list_none_ref, counter_set: list_none_ref, quotes: 0_u32, list_style_position: 0_u8);
  return SecondValues(container: container, track_nodes: nodes, item: item, table_layout: 0_u8, content: content);
}

fn stored_reference(applied: Applied, kind: u8, none: u32) -> reference: u32 pure {
  doc "The index of an applied Stored value of kind in the second part's named store, or none for any other value.";
  if applied.found {
    match declared_stored(declared: applied.value) {
      Some(value: stored) => {
        let same = stored.kind == kind;
        let below = stored.index < content_none_ref;
        let usable = band(same, below);
        if usable {
          return stored.index;
        }
        return none;
      }
      None() => {
        return none;
      }
    }
  }
  return none;
}

fn node_of(applied: Applied) -> node: u32 pure {
  doc "The index of the node an applied value comes from, narrowed.";
  let narrowed = cvt.wrap::<u64, u32>(applied.node);
  return narrowed;
}

fn number_reset(applied: Applied, initial: f32) -> number: f32 pure {
  doc "A number longhand: its number, initial otherwise.";
  if applied.found {
    match declared_number(declared: applied.value) {
      Some(value: n) => {
        return n;
      }
      None() => {
        return initial;
      }
    }
  }
  return initial;
}

fn line_reset(applied: Applied, inherited: &Inherited) -> line: GridLine reads(inherited) {
  doc "A grid line longhand: the stored line, auto otherwise.";
  let no = False();
  let blank = Atom(index: 0_u32);
  let auto_line = GridLine(kind: line_auto, number: 0_i32, name: blank, named: no);
  if applied.found {
    match declared_stored(declared: applied.value) {
      Some(value: stored) => {
        let at = cvt::<u32, u64>(stored.index);
        let same = stored.kind == stored_line;
        let inside = at < inherited^.named.grid_lines.inner.len;
        let usable = band(same, inside);
        if usable {
          let found = inherited^.named.grid_lines.inner[at];
          return found;
        }
      }
      None() => {
      }
    }
  }
  return auto_line;
}

fn content_reset(applied: Applied) -> reference: u32 pure {
  doc "content as a reference: content_normal_ref for normal and initially, content_none_ref for none, or the index of a content list in the named store.";
  if applied.found {
    match declared_keyword(declared: applied.value) {
      Some(value: k) => {
        if k == keyword_none {
          return content_none_ref;
        }
        return content_normal_ref;
      }
      None() => {
      }
    }
  }
  let made = stored_reference(applied: applied, kind: stored_content, none: content_normal_ref);
  return made;
}

fn reset_second(store: &RuleStore, cascade: &Cascade, inherited: &Inherited, atoms: &AtomTable, environment: Environment, element: u64) -> values: SecondValues reads(store), reads(cascade), reads(inherited), reads(atoms) {
  doc "Computes one styled node's longhands of the second batch that are not inherited but aspect-ratio: the container, item and table layout values, and content and the counter longhands; list values are references to the named store, with the node whose font their lengths use, which the interning step turns into lists of computed values.";
  let direction_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_flex_direction);
  let direction = keyword_reset(applied: direction_applied, initial: 0_u8);
  let wrap_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_flex_wrap);
  let wrapping = keyword_reset(applied: wrap_applied, initial: 0_u8);
  let justify_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_justify_content);
  let justify_content = keyword_reset(applied: justify_applied, initial: align_normal);
  let items_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_align_items);
  let align_items = keyword_reset(applied: items_applied, initial: align_normal);
  let content_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_align_content);
  let align_content = keyword_reset(applied: content_applied, initial: align_normal);
  let justify_items_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_justify_items);
  let declared_justify_items = keyword_reset(applied: justify_items_applied, initial: align_normal);
  let legacy = declared_justify_items == align_legacy;
  let justify_items = if legacy {
    give align_normal;
  } else {
    give declared_justify_items;
  }
  let row_gap_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_row_gap);
  let row_gap = sizing_reset(applied: row_gap_applied, environment: environment, initial: sizing_normal);
  let column_gap_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_column_gap);
  let column_gap = sizing_reset(applied: column_gap_applied, environment: environment, initial: sizing_normal);
  let columns_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_template_columns);
  let columns = stored_reference(applied: columns_applied, kind: stored_tracks, none: list_none_ref);
  let rows_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_template_rows);
  let rows = stored_reference(applied: rows_applied, kind: stored_tracks, none: list_none_ref);
  let areas_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_template_areas);
  let areas = stored_reference(applied: areas_applied, kind: stored_areas, none: list_none_ref);
  let flow_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_auto_flow);
  let flow = keyword_reset(applied: flow_applied, initial: 0_u8);
  let auto_columns_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_auto_columns);
  let auto_columns = stored_reference(applied: auto_columns_applied, kind: stored_tracks, none: list_none_ref);
  let auto_rows_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_auto_rows);
  let auto_rows = stored_reference(applied: auto_rows_applied, kind: stored_tracks, none: list_none_ref);
  let count_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_column_count);
  let column_count = if count_applied.found {
    match declared_integer(declared: count_applied.value) {
      Some(value: n) => {
        give cvt.wrap::<i32, u32>(n);
      }
      None() => {
        give 0_u32;
      }
    }
  } else {
    give 0_u32;
  }
  let column_width_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_column_width);
  let column_width = sizing_reset(applied: column_width_applied, environment: environment, initial: sizing_auto);
  let fill_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_column_fill);
  let column_fill = keyword_reset(applied: fill_applied, initial: column_fill_balance);
  let container = ContainerGroup(flex_direction: direction, flex_wrap: wrapping, justify_content: justify_content, align_items: align_items, align_content: align_content, justify_items: justify_items, row_gap: row_gap, column_gap: column_gap, template_columns: columns, template_rows: rows, template_areas: areas, auto_flow: flow, auto_columns: auto_columns, auto_rows: auto_rows, column_count: column_count, column_width: column_width, column_fill: column_fill);
  let columns_node = node_of(applied: columns_applied);
  let rows_node = node_of(applied: rows_applied);
  let auto_columns_node = node_of(applied: auto_columns_applied);
  let auto_rows_node = node_of(applied: auto_rows_applied);
  let track_nodes = TrackNodes(columns: columns_node, rows: rows_node, auto_columns: auto_columns_node, auto_rows: auto_rows_node);
  let order_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_order);
  let order = if order_applied.found {
    match declared_integer(declared: order_applied.value) {
      Some(value: n) => {
        give n;
      }
      None() => {
        give 0_i32;
      }
    }
  } else {
    give 0_i32;
  }
  let grow_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_flex_grow);
  let grow_factor = number_reset(applied: grow_applied, initial: 0.0_f32);
  let shrink_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_flex_shrink);
  let shrink_factor = number_reset(applied: shrink_applied, initial: 1.0_f32);
  let basis_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_flex_basis);
  let basis = sizing_reset(applied: basis_applied, environment: environment, initial: sizing_auto);
  let self_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_align_self);
  let align_self = keyword_reset(applied: self_applied, initial: align_auto);
  let justify_self_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_justify_self);
  let justify_self = keyword_reset(applied: justify_self_applied, initial: align_auto);
  let row_start_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_row_start);
  let row_start = line_reset(applied: row_start_applied, inherited: inherited);
  let row_end_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_row_end);
  let row_end = line_reset(applied: row_end_applied, inherited: inherited);
  let column_start_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_column_start);
  let column_start = line_reset(applied: column_start_applied, inherited: inherited);
  let column_end_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_grid_column_end);
  let column_end = line_reset(applied: column_end_applied, inherited: inherited);
  let break_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_break_inside);
  let break_inside = keyword_reset(applied: break_applied, initial: break_inside_auto);
  let item = ItemGroup(order: order, grow: grow_factor, shrink: shrink_factor, basis: basis, align_self: align_self, justify_self: justify_self, row_start: row_start, row_end: row_end, column_start: column_start, column_end: column_end, break_inside: break_inside);
  let layout_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_table_layout);
  let table_layout = keyword_reset(applied: layout_applied, initial: 0_u8);
  let generated_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_content);
  let declared_content = content_reset(applied: generated_applied);
  let kind = if element < cascade^.kinds.inner.len {
    give cascade^.kinds.inner[element];
  } else {
    give 0_u8;
  }
  let pseudo = kind != 0_u8;
  let normal_content = declared_content == content_normal_ref;
  let none_for_pseudo = band(pseudo, normal_content);
  let content_value = if none_for_pseudo {
    give content_none_ref;
  } else {
    give declared_content;
  }
  let reset_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_counter_reset);
  let counter_reset = stored_reference(applied: reset_applied, kind: stored_counters, none: list_none_ref);
  let increment_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_counter_increment);
  let counter_increment = stored_reference(applied: increment_applied, kind: stored_counters, none: list_none_ref);
  let set_applied = applied_value(store: store, cascade: cascade, inherited: inherited, atoms: atoms, element: element, longhand: lh_counter_set);
  let counter_set = stored_reference(applied: set_applied, kind: stored_counters, none: list_none_ref);
  let content = ContentGroup(content: content_value, counter_reset: counter_reset, counter_increment: counter_increment, counter_set: counter_set, quotes: 0_u32, list_style_position: 0_u8);
  return SecondValues(container: container, track_nodes: track_nodes, item: item, table_layout: table_layout, content: content);
}

fn resolved_lookup(inherited: &Inherited, node: u64, longhand: u8) -> declared: Option<Declared> reads(inherited) {
  doc "The value the second part resolved for a pending stored longhand of node, from the node's run of the resolved list; None when it was invalid at computed-value time or is not listed.";
  let first_listed = node < inherited^.resolved_first.inner.len;
  let end_listed = node < inherited^.resolved_end.inner.len;
  let listed = band(first_listed, end_listed);
  if listed {
  } else {
    return None<Declared>();
  }
  let first = cvt::<u32, u64>(inherited^.resolved_first.inner[node]);
  let end = cvt::<u32, u64>(inherited^.resolved_end.inner[node]);
  let ordered = first <= end;
  let inside = end <= inherited^.resolved.inner.len;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return None<Declared>();
  }
  for (k in first..end) {
    let entry_value = inherited^.resolved.inner[k];
    if entry_value.longhand == longhand {
      if entry_value.valid {
        return Some<Declared>(value: entry_value.value);
      }
      return None<Declared>();
    }
  }
  return None<Declared>();
}
