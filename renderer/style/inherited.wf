alias declaration_store_new = pkg::css::values::declaration_store_new;
alias keyword_bolder = pkg::css::values::keyword_bolder;
alias keyword_lighter = pkg::css::values::keyword_lighter;
alias lh_color = pkg::css::values::lh_color;
alias lh_font_family = pkg::css::values::lh_font_family;
alias lh_font_size = pkg::css::values::lh_font_size;
alias lh_font_style = pkg::css::values::lh_font_style;
alias lh_font_weight = pkg::css::values::lh_font_weight;
alias lh_letter_spacing = pkg::css::values::lh_letter_spacing;
alias lh_line_height = pkg::css::values::lh_line_height;
alias lh_list_style_type = pkg::css::values::lh_list_style_type;
alias lh_text_align = pkg::css::values::lh_text_align;
alias lh_text_indent = pkg::css::values::lh_text_indent;
alias lh_text_transform = pkg::css::values::lh_text_transform;
alias lh_visibility = pkg::css::values::lh_visibility;
alias lh_white_space = pkg::css::values::lh_white_space;
alias lh_word_spacing = pkg::css::values::lh_word_spacing;
