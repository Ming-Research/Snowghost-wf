alias parse_pending_named = pkg::css::values::parse_pending_named;
alias sizing_keyword = pkg::css::values::sizing_keyword;
alias sizing_normal = pkg::css::values::sizing_normal;
alias sizing_number = pkg::css::values::sizing_number;
alias sizing_value = pkg::css::values::sizing_value;
alias wide_initial = pkg::css::values::wide_initial;

const initial_family_name: Array<u8, 15> = "Times New Roman";

const disc_name: Array<u8, 4> = "disc";

const monospace_name: Array<u8, 9> = "monospace";

const strict_sizes: Array<f32, 8> =[9.0_f32, 10.0_f32, 13.0_f32, 16.0_f32, 18.0_f32, 24.0_f32, 32.0_f32, 48.0_f32];

const fixed_sizes: Array<f32, 8> =[9.0_f32, 10.0_f32, 12.0_f32, 13.0_f32, 16.0_f32, 20.0_f32, 26.0_f32, 39.0_f32];

const state_pending: u8 = 0_u8;

const state_done: u8 = 1_u8;

struct OwnCustom {
  name: u32;
  declaration: u32;
  key: u64;
  state: u8;
}

fn black_color() -> made: Color pure {
  doc "Opaque black in the Rgb space.";
  let space = ColorSpace::Rgb();
  return Color(space: space, first: 0.0_f32, second: 0.0_f32, third: 0.0_f32, alpha: 1.0_f32, missing: 0_u8);
}

fn lp_zero() -> made: LengthPercentage pure {
  doc "A length of zero with no percentage.";
  let no = False();
  return LengthPercentage(px: 0.0_f32, percent: 0.0_f32, has_percent: no);
}

fn sizing_kind(kind: u8) -> made: Sizing pure {
  doc "A sizing value of the given kind with no length.";
  let zero = lp_zero();
  return Sizing(kind: kind, keyword: 0_u8, value: zero);
}

fn sizing_px(px: f32) -> made: Sizing pure {
  doc "A sizing value of px pixels.";
  let no = False();
  let value = LengthPercentage(px: px, percent: 0.0_f32, has_percent: no);
  return Sizing(kind: sizing_value, keyword: 0_u8, value: value);
}

fn winner_value(store: &RuleStore, cascade: &Cascade, element: u64, longhand: u8) -> declared: Option<Declared> reads(store), reads(cascade) {
  doc "The winning declared value of longhand for the element at preorder index element, or None when no declaration sets it.";
  let wide = cvt::<u8, u64>(longhand);
  let base = element *sat 93_u64;
  let at = base +sat wide;
  let total = cascade^.winners.inner.len;
  let inside = at < total;
  if inside {
  } else {
    return None<Declared>();
  }
  let one_based = cvt::<u32, u64>(cascade^.winners.inner[at]);
  if one_based == 0_u64 {
    return None<Declared>();
  }
  let index = one_based - 1_u64;
  let count = store^.declared.declarations.inner.len;
  let known = index < count;
  if known {
    let value = store^.declared.declarations.inner[index].value;
    return Some<Declared>(value: value);
  }
  return None<Declared>();
}

fn substitute_pending(store: &RuleStore, pending: PendingRef, entries: &[CustomEntry], text: &[u8], atoms: &AtomTable, out: &Box<Slots<u8>>) -> substituted: Bool reads(store), reads(entries), reads(text), reads(atoms), writes(out) {
  doc "Writes the pending value's text with var() substituted to out; false when the sheet is unknown or a var() fails.";
  let sheet = cvt::<u32, u64>(pending.sheet);
  let sheets = store^.sheets.inner.len;
  let known = sheet < sheets;
  if known {
  } else {
    return False();
  }
  let start = cvt::<u32, u64>(pending.start);
  let end = cvt::<u32, u64>(pending.end);
  let length = store^.sheets.inner[sheet].values.components.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return False();
  }
  let blocked = box_slots_new::<u32>(capacity: 0_u64);
  let code = substitute(values: &store^.sheets.inner[sheet].values, start: start, end: end, entries: entries, text: text, blocked: &blocked.inner[0_u64..0_u64], atoms: atoms, out: out, depth: 0_u64);
  let ok = code == sub_ok;
  return ok;
}

fn resolve_named(store: &RuleStore, pending: PendingRef, longhand: u8, entries: &[CustomEntry], text: &[u8], atoms: &AtomTable, named: &DeclarationStore) -> result: Result<Option<Declared>, StyleError> reads(store), reads(entries), reads(text), writes(atoms), writes(named) {
  doc "Substitutes var() in a pending value and parses it for longhand with parse_pending_named; None when it is invalid at computed-value time.";
  let scratch = box_slots_new::<u8>(capacity: 0_u64);
  let substituted = substitute_pending(store: store, pending: pending, entries: entries, text: text, atoms: atoms, out: &scratch);
  if substituted {
  } else {
    let arg_1 = None<Declared>();
    return Ok<Option<Declared>, StyleError>(value: arg_1);
  }
  let size = scratch.inner.len;
  let small = size <= 16777216_u64;
  if small {
  } else {
    let arg_2 = None<Declared>();
    return Ok<Option<Declared>, StyleError>(value: arg_2);
  }
  let parsed = parse_component_values(source: &scratch.inner[0_u64..size]);
  match move parsed {
    Ok(value: list) => {
      let count = list.components.inner.len;
      let last = cvt.wrap::<u64, u32>(count);
      let whole = ComponentRange(start: 0_u32, end: last);
      match parse_pending_named(values: &list, range: whole, shorthand: pending.shorthand, longhand: longhand, atoms: atoms, store: named) {
        Ok(value: found) => {
          return Ok<Option<Declared>, StyleError>(value: found);
        }
        Err(..) => {
          let failure = StyleError::TooLarge();
          return Err<Option<Declared>, StyleError>(error: failure);
        }
      }
    }
    Err(..) => {
      let arg_3 = None<Declared>();
      return Ok<Option<Declared>, StyleError>(value: arg_3);
    }
  }
}

fn inherited_declared(store: &RuleStore, cascade: &Cascade, element: u64, longhand: u8, entries: &[CustomEntry], text: &[u8], atoms: &AtomTable, named: &DeclarationStore) -> result: Result<Option<Declared>, StyleError> reads(store), reads(cascade), reads(entries), reads(text), writes(atoms), writes(named) {
  doc "The element's declared value of an inherited longhand with var() substituted: None when it inherits, through no declaration, inherit, unset or a value invalid at computed-value time; Wide(initial) for initial.";
  match winner_value(store: store, cascade: cascade, element: element, longhand: longhand) {
    Some(value: declared) => {
      match declared_pending(declared: declared) {
        Some(value: pending) => {
          let resolved = propagate resolve_named(store: store, pending: pending, longhand: longhand, entries: entries, text: text, atoms: atoms, named: named);
          match resolved {
            Some(value: inner) => {
              let inherits = inherits_value(declared: inner);
              if inherits {
                let arg_4 = None<Declared>();
                return Ok<Option<Declared>, StyleError>(value: arg_4);
              }
              return Ok<Option<Declared>, StyleError>(value: resolved);
            }
            None() => {
              let arg_5 = None<Declared>();
              return Ok<Option<Declared>, StyleError>(value: arg_5);
            }
          }
        }
        None() => {
          let inherits = inherits_value(declared: declared);
          if inherits {
            let arg_6 = None<Declared>();
            return Ok<Option<Declared>, StyleError>(value: arg_6);
          }
          let arg_7 = Some<Declared>(value: declared);
          return Ok<Option<Declared>, StyleError>(value: arg_7);
        }
      }
    }
    None() => {
      let arg_8 = None<Declared>();
      return Ok<Option<Declared>, StyleError>(value: arg_8);
    }
  }
}

fn inherits_value(declared: Declared) -> inherits: Bool pure {
  doc "True for inherit and unset, which an inherited longhand takes from its parent.";
  match declared_wide(declared: declared) {
    Some(value: keyword) => {
      let initial = keyword == wide_initial;
      let other = bnot(initial);
      return other;
    }
    None() => {
      return False();
    }
  }
}

fn is_initial(declared: Declared) -> initial: Bool pure {
  doc "True for the CSS-wide keyword initial.";
  match declared_wide(declared: declared) {
    Some(value: keyword) => {
      let made = keyword == wide_initial;
      return made;
    }
    None() => {
      return False();
    }
  }
}

fn initial_font(state: &Inherited) -> made: FontGroup reads(state) {
  doc "The initial font: the initial family, 16px, weight 400, normal style and line-height.";
  let start = state^.initial_family;
  let end = start +sat 1_u32;
  let normal = sizing_kind(kind: sizing_normal);
  return FontGroup(families_start: start, families_end: end, size: 16.0_f32, weight: 4.0e2_f32, style: 0_u8, line_height: normal);
}

fn initial_text(state: &Inherited) -> made: TextGroup reads(state) {
  doc "The initial text values: black, start, no indent, transform or spacing, normal white space, baseline, no decoration and disc markers.";
  let black = black_color();
  let zero = lp_zero();
  let normal = sizing_kind(kind: sizing_normal);
  let baseline = sizing_kind(kind: sizing_keyword);
  return TextGroup(color: black, text_align: 0_u8, text_indent: zero, text_transform: 0_u8, white_space: 0_u8, letter_spacing: normal, word_spacing: normal, vertical_align: baseline, decoration_line: 0_u8, list_style_type: state^.disc, overflow_wrap: 0_u8, word_break: 0_u8);
}

fn monospace_only(named: &DeclarationStore, start: u32, end: u32, monospace: Atom) -> only: Bool reads(named) {
  doc "True when the family list is the generic monospace alone.";
  let a = cvt::<u32, u64>(start);
  let b = cvt::<u32, u64>(end);
  let single = a +sat 1_u64;
  if single != b {
    return False();
  }
  let inside = a < named^.families.inner.len;
  if inside {
  } else {
    return False();
  }
  let family = named^.families.inner[a];
  let same = family.name.index == monospace.index;
  let both = band(same, family.generic);
  return both;
}

fn keyword_size(keyword: u64, monospace: Bool) -> size: f32 pure {
  doc "The font size of an absolute-size keyword, from the table for a 16px or, for monospace alone, a 13px medium.";
  let index = if keyword < 8_u64 {
    give keyword;
  } else {
    give 3_u64;
  }
  if monospace {
    return fixed_sizes[index];
  }
  return strict_sizes[index];
}

fn resolve_px(lengths: Lengths, basis: f32, ex: f32, ch: f32, environment: Environment) -> px: f32 pure {
  doc "A length or percentage against basis for em and percent, as px.";
  let computed = compute_length(lengths: lengths, font_size: basis, ex: ex, ch: ch, environment: environment);
  let share = fmul.strict(basis, computed.percent);
  let part = fdiv.strict(share, 1.0e2_f32);
  let px = fadd.strict(computed.px, part);
  return px;
}

fn relative_factor(lengths: Lengths) -> factor: Option<f32> pure {
  doc "The factor of a length made only of em and percent, as a multiple of the parent's size, or None when it has another unit.";
  let zero_px = feq(lengths.px, 0.0_f32);
  let zero_rem = feq(lengths.rem, 0.0_f32);
  let zero_ex = feq(lengths.ex, 0.0_f32);
  let zero_ch = feq(lengths.ch, 0.0_f32);
  let zero_vw = feq(lengths.vw, 0.0_f32);
  let zero_vh = feq(lengths.vh, 0.0_f32);
  let zero_vmin = feq(lengths.vmin, 0.0_f32);
  let zero_vmax = feq(lengths.vmax, 0.0_f32);
  let a = band(zero_px, zero_rem);
  let b = band(zero_ex, zero_ch);
  let c = band(zero_vw, zero_vh);
  let d = band(zero_vmin, zero_vmax);
  let ab = band(a, b);
  let cd = band(c, d);
  let only = band(ab, cd);
  if only {
    let share = fdiv.strict(lengths.percent, 1.0e2_f32);
    let factor = fadd.strict(lengths.em, share);
    return Some<f32>(value: factor);
  }
  return None<f32>();
}

fn font_size_of(declared: Option<Declared>, parent_size: f32, parent_keyword: u8, parent_scale: f32, parent_ex: f32, parent_ch: f32, monospace: Bool, environment: Environment) -> (size: f32, keyword: u8, scale: f32) pure {
  doc "Computes font-size as the reference browser does: an absolute keyword from the table of the element's family, monospace alone having its own; a size relative to a parent whose size came from a keyword (em, percent, larger at 1.2 times, smaller divided by 1.2) keeps that keyword with the factor, so it is looked up again for this element's family, as an inherited one is; any other length is resolved against the parent's size and drops the keyword.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        let size = keyword_size(keyword: 3_u64, monospace: monospace);
        return size, 4_u8, 1.0_f32;
      }
      match declared_keyword(declared: d) {
        Some(value: k) => {
          let wide = cvt::<u8, u64>(k);
          if wide < 8_u64 {
            let size = keyword_size(keyword: wide, monospace: monospace);
            let one_based = k +sat 1_u8;
            return size, one_based, 1.0_f32;
          }
          let factor = if wide == 8_u64 {
            give 1.2_f32;
          } else {
            give fdiv.strict(1.0_f32, 1.2_f32);
          }
          if parent_keyword != 0_u8 {
            let scale = fmul.strict(parent_scale, factor);
            let index_wide = cvt::<u8, u64>(parent_keyword);
            let index = index_wide - 1_u64;
            let base = keyword_size(keyword: index, monospace: monospace);
            let size = fmul.strict(base, scale);
            return size, parent_keyword, scale;
          }
          let size = fmul.strict(parent_size, factor);
          return size, 0_u8, 1.0_f32;
        }
        None() => {
        }
      }
      match declared_lengths(declared: d) {
        Some(value: lengths) => {
          if parent_keyword != 0_u8 {
            match relative_factor(lengths: lengths) {
              Some(value: factor) => {
                let negative_factor = flt(factor, 0.0_f32);
                if negative_factor {
                  return 0.0_f32, 0_u8, 1.0_f32;
                }
                let scale = fmul.strict(parent_scale, factor);
                let index_wide = cvt::<u8, u64>(parent_keyword);
                let index = index_wide - 1_u64;
                let base = keyword_size(keyword: index, monospace: monospace);
                let size = fmul.strict(base, scale);
                return size, parent_keyword, scale;
              }
              None() => {
              }
            }
          }
          let size = resolve_px(lengths: lengths, basis: parent_size, ex: parent_ex, ch: parent_ch, environment: environment);
          let negative = flt(size, 0.0_f32);
          if negative {
            return 0.0_f32, 0_u8, 1.0_f32;
          }
          return size, 0_u8, 1.0_f32;
        }
        None() => {
        }
      }
    }
    None() => {
    }
  }
  if parent_keyword != 0_u8 {
    let wide = cvt::<u8, u64>(parent_keyword);
    let index = wide - 1_u64;
    let base = keyword_size(keyword: index, monospace: monospace);
    let size = fmul.strict(base, parent_scale);
    return size, parent_keyword, parent_scale;
  }
  return parent_size, 0_u8, 1.0_f32;
}

fn weight_of(declared: Option<Declared>, parent: f32) -> weight: f32 pure {
  doc "Computes font-weight: a number, or bolder and lighter relative to the parent's weight.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        return 4.0e2_f32;
      }
      match declared_number(declared: d) {
        Some(value: n) => {
          return n;
        }
        None() => {
        }
      }
      match declared_keyword(declared: d) {
        Some(value: k) => {
          if k == keyword_bolder {
            let light = flt(parent, 3.5e2_f32);
            if light {
              return 4.0e2_f32;
            }
            let regular = flt(parent, 5.5e2_f32);
            if regular {
              return 7.0e2_f32;
            }
            let bold = flt(parent, 9.0e2_f32);
            if bold {
              return 9.0e2_f32;
            }
            return parent;
          }
          if k == keyword_lighter {
            let thin = flt(parent, 1.0e2_f32);
            if thin {
              return parent;
            }
            let regular = flt(parent, 5.5e2_f32);
            if regular {
              return 1.0e2_f32;
            }
            let bold = flt(parent, 7.5e2_f32);
            if bold {
              return 4.0e2_f32;
            }
            return 7.0e2_f32;
          }
          return parent;
        }
        None() => {
          return parent;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn keyword_or(declared: Option<Declared>, parent: u8, initial: u8) -> keyword: u8 pure {
  doc "A keyword longhand: its keyword, the initial value for initial, otherwise the parent's.";
  match declared {
    Some(value: d) => {
      let reset = is_initial(declared: d);
      if reset {
        return initial;
      }
      match declared_keyword(declared: d) {
        Some(value: k) => {
          return k;
        }
        None() => {
          return parent;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn line_height_of(declared: Option<Declared>, parent: Sizing, size: f32, ex: f32, ch: f32, environment: Environment) -> line_height: Sizing pure {
  doc "Computes line-height: normal, a number, or a length or percentage of the element's own font size as px.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        let made = sizing_kind(kind: sizing_normal);
        return made;
      }
      match declared_keyword(declared: d) {
        Some(..) => {
          let made = sizing_kind(kind: sizing_normal);
          return made;
        }
        None() => {
        }
      }
      match declared_number(declared: d) {
        Some(value: n) => {
          let no = False();
          let value = LengthPercentage(px: n, percent: 0.0_f32, has_percent: no);
          let made = Sizing(kind: sizing_number, keyword: 0_u8, value: value);
          return made;
        }
        None() => {
        }
      }
      match declared_lengths(declared: d) {
        Some(value: lengths) => {
          let px = resolve_px(lengths: lengths, basis: size, ex: ex, ch: ch, environment: environment);
          let made = sizing_px(px: px);
          return made;
        }
        None() => {
          return parent;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn spacing_of(declared: Option<Declared>, parent: Sizing, size: f32, ex: f32, ch: f32, environment: Environment) -> spacing: Sizing pure {
  doc "Computes letter-spacing or word-spacing: normal or a length as px.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        let made = sizing_kind(kind: sizing_normal);
        return made;
      }
      match declared_lengths(declared: d) {
        Some(value: lengths) => {
          let px = resolve_px(lengths: lengths, basis: size, ex: ex, ch: ch, environment: environment);
          let made = sizing_px(px: px);
          return made;
        }
        None() => {
          let made = sizing_kind(kind: sizing_normal);
          return made;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn indent_of(declared: Option<Declared>, parent: LengthPercentage, size: f32, ex: f32, ch: f32, environment: Environment) -> indent: LengthPercentage pure {
  doc "Computes text-indent: a length as px with its percentage kept.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        let made = lp_zero();
        return made;
      }
      match declared_lengths(declared: d) {
        Some(value: lengths) => {
          let made = compute_length(lengths: lengths, font_size: size, ex: ex, ch: ch, environment: environment);
          return made;
        }
        None() => {
          return parent;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn color_of(declared: Option<Declared>, parent: Color) -> color: Color pure {
  doc "Computes color: a color, the parent's for currentcolor, black for initial.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        let made = black_color();
        return made;
      }
      match declared_color(declared: d) {
        Some(value: reference) => {
          if reference.current {
            return parent;
          }
          return reference.color;
        }
        None() => {
          return parent;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn align_of(declared: Option<Declared>, parent: u8) -> align: u8 pure {
  doc "Computes text-align: a keyword, with match-parent taking the parent's computed value.";
  let made = keyword_or(declared: declared, parent: parent, initial: 0_u8);
  if made == 6_u8 {
    return parent;
  }
  return made;
}

fn add_own(own: &Box<Slots<OwnCustom>>, name: u32, declaration: u32, key: u64) -> result: unit writes(own) {
  doc "Keeps declaration as the element's value of the custom property name when its key is at least the one kept so far.";
  let count = own^.inner.len;
  for (k in 0_u64..count) {
    if own^.inner[k].name == name {
      let kept = own^.inner[k].key;
      if key >= kept {
        set own^.inner[k].declaration = declaration;
        set own^.inner[k].key = key;
      }
      return unit;
    }
  }
  let made = OwnCustom(name: name, declaration: declaration, key: key, state: state_pending);
  let length = own^.inner.len;
  let capacity = own^.inner.cap;
  if length >= capacity {
    let small = capacity < 8_u64;
    if small {
      grow(cell: own, capacity: 8_u64);
    } else {
      let limit = capacity < 1048576_u64;
      if limit {
        let doubled = capacity + capacity;
        grow(cell: own, capacity: doubled);
      } else {
        return unit;
      }
    }
  }
  let room = own^.inner.len < own^.inner.cap;
  if room {
    place_back(window: &own^.inner, value: made);
  }
  return unit;
}

fn offer_customs(own: &Box<Slots<OwnCustom>>, store: &RuleStore, first: u32, end: u32, packed: u64) -> result: unit reads(store), writes(own) {
  doc "Offers the custom declarations from first to end.";
  let low = cvt::<u32, u64>(first);
  let high = cvt::<u32, u64>(end);
  let total = store^.customs.inner.len;
  let ordered = low <= high;
  let inside = high <= total;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return unit;
  }
  for (c in low..high) {
    let declaration = store^.customs.inner[c];
    let layer = layer_of(origin: declaration.origin, important: declaration.important);
    let key = cascade_key(layer: layer, packed: packed, declaration: c);
    let index = cvt.wrap::<u64, u32>(c);
    add_own(own: own, name: declaration.name.index, declaration: index, key: key);
  }
  return unit;
}

fn collect_customs(own: &Box<Slots<OwnCustom>>, store: &RuleStore, cascade: &Cascade, position: u64) -> result: unit reads(store), reads(cascade), writes(own) {
  doc "Collects the winning custom declarations of the element from the specificities the first part recorded for the custom-property rules it matched, and from its style attribute.";
  let count = cascade^.custom_count;
  let base = position *sat count;
  let rules = store^.custom_rules.inner.len;
  for (slot in 0_u64..count) {
    let at = base +sat slot;
    let inside = at < cascade^.custom_keys.inner.len;
    let known = slot < rules;
    let usable = band(inside, known);
    if usable {
      let key = cascade^.custom_keys.inner[at];
      if key != 0_u64 {
        let packed = key - 1_u64;
        let rule = cvt::<u32, u64>(store^.custom_rules.inner[slot]);
        let listed_rule = rule < store^.rules.inner.len;
        if listed_rule {
          let first = store^.rules.inner[rule].custom_first;
          let end = store^.rules.inner[rule].custom_end;
          offer_customs(own: own, store: store, first: first, end: end, packed: packed);
        }
      }
    }
  }
  match attribute_style_of(store: store, element: position) {
    Some(value: record) => {
      let inside = record < store^.attributes.inner.len;
      if inside {
        let first = store^.attributes.inner[record].custom_first;
        let end = store^.attributes.inner[record].custom_end;
        offer_customs(own: own, store: store, first: first, end: end, packed: attribute_specificity);
      }
    }
    None() => {
    }
  }
  return unit;
}

fn push_entry(state: &Inherited, entry_value: CustomEntry) -> result: Result<unit, StyleError> writes(state) {
  doc "Appends one custom-property entry.";
  let placed = propagate push::<CustomEntry>(cell: &state^.custom_entries, value: entry_value, ceiling: 4294967295_u64);
  return Ok<unit, StyleError>(value: unit);
}

fn own_listed(own: &Box<Slots<OwnCustom>>, name: u32) -> found: Bool reads(own) {
  doc "True when the element declares the custom property name.";
  let count = own^.inner.len;
  for (k in 0_u64..count) {
    if own^.inner[k].name == name {
      return True();
    }
  }
  return False();
}

fn custom_set(state: &Inherited, store: &RuleStore, cascade: &Cascade, atoms: &AtomTable, position: u64, parent_set: u32) -> result: Result<u32, StyleError> reads(store), reads(cascade), reads(atoms), writes(state) {
  doc "The element's custom-property set: its parent's when it declares none, otherwise a new set of the parent's entries it does not override and its own values with var() substituted, in rounds so that one may refer to another: a value that refers to one still waiting, itself included, waits, and when a round resolves nothing, the values on a cycle of the references substitution follows are invalid and left out, so a value that only refers to them takes its fallback in the next round; one whose var() fails is left out too.";
  let own = box_slots_new::<OwnCustom>(capacity: 0_u64);
  collect_customs(own: &own, store: store, cascade: cascade, position: position);
  let own_count = own.inner.len;
  if own_count == 0_u64 {
    return Ok<u32, StyleError>(value: parent_set);
  }
  let first = state^.custom_entries.inner.len;
  let sets = state^.custom_sets.inner.len;
  let parent_wide = cvt::<u32, u64>(parent_set);
  let parent_known = parent_wide < sets;
  if parent_known {
    let from = cvt::<u32, u64>(state^.custom_sets.inner[parent_wide].first);
    let to = cvt::<u32, u64>(state^.custom_sets.inner[parent_wide].end);
    let ordered = from <= to;
    let inside = to <= state^.custom_entries.inner.len;
    let usable = band(ordered, inside);
    if usable {
      for (k in from..to) {
        let present = k < state^.custom_entries.inner.len;
        if present {
          let inherited_entry = state^.custom_entries.inner[k];
          let overridden = own_listed(own: &own, name: inherited_entry.name.index);
          if overridden {
          } else {
            let copied = propagate push_entry(state: state, entry_value: inherited_entry);
          }
        }
      }
    }
  }
  let twice = own_count *sat 2_u64;
  let rounds = twice +sat 2_u64;
  for (round in 0_u64..rounds) {
    let blocked = box_slots_new::<u32>(capacity: 0_u64);
    for (k in 0_u64..own_count) {
      let inside = k < own.inner.len;
      if inside {
        if own.inner[k].state == state_pending {
          let pushed = propagate push::<u32>(cell: &blocked, value: own.inner[k].name, ceiling: 4294967295_u64);
        }
      }
    }
    let waiting = blocked.inner.len;
    if waiting == 0_u64 {
      break;
    }
    for (k in 0_u64..own_count) {
      let inside = k < own.inner.len;
      if inside {
        if own.inner[k].state == state_pending {
          let index = cvt::<u32, u64>(own.inner[k].declaration);
          let known = index < store^.customs.inner.len;
          if known {
            let declaration = store^.customs.inner[index];
            let scratch = box_slots_new::<u8>(capacity: 0_u64);
            let sheet = cvt::<u32, u64>(declaration.sheet);
            let start = cvt::<u32, u64>(declaration.start);
            let end = cvt::<u32, u64>(declaration.end);
            let code = if sheet < store^.sheets.inner.len {
              let length = store^.sheets.inner[sheet].values.components.inner.len;
              let ordered = start <= end;
              let fits = end <= length;
              let usable = band(ordered, fits);
              if usable {
                let current = state^.custom_entries.inner.len;
                let entries_start = if first <= current {
                  give first;
                } else {
                  give current;
                }
                let text_length = state^.custom_text.inner.len;
                let others_count = blocked.inner.len;
                give substitute(values: &store^.sheets.inner[sheet].values, start: start, end: end, entries: &state^.custom_entries.inner[entries_start..current], text: &state^.custom_text.inner[0_u64..text_length], blocked: &blocked.inner[0_u64..others_count], atoms: atoms, out: &scratch, depth: 0_u64);
              } else {
                give sub_invalid;
              }
            } else {
              give sub_invalid;
            }
            if code == sub_blocked {
            } else if code == sub_ok {
              let text_start = state^.custom_text.inner.len;
              let size = scratch.inner.len;
              for (b in 0_u64..size) {
                let byte = scratch.inner[b];
                emit(out: &state^.custom_text, value: byte);
              }
              let text_end = state^.custom_text.inner.len;
              let a = cvt.wrap::<u64, u32>(text_start);
              let z = cvt.wrap::<u64, u32>(text_end);
              let name_atom = Atom(index: own.inner[k].name);
              let made = CustomEntry(name: name_atom, start: a, end: z);
              let added = propagate push_entry(state: state, entry_value: made);
              set own.inner[k].state = state_done;
            } else {
              set own.inner[k].state = state_done;
            }
          } else {
            set own.inner[k].state = state_done;
          }
        }
      }
    }
    let still = 0_u64;
    for (k in 0_u64..own_count) {
      let inside = k < own.inner.len;
      if inside {
        if own.inner[k].state == state_pending {
          set still = still +sat 1_u64;
        }
      }
    }
    if still == waiting {
      let current = state^.custom_entries.inner.len;
      let entries_start = if first <= current {
        give first;
      } else {
        give current;
      }
      invalidate_cycles(own: &own, store: store, atoms: atoms, entries: &state^.custom_entries.inner[entries_start..current]);
    }
  }
  let end = state^.custom_entries.inner.len;
  let a = cvt.wrap::<u64, u32>(first);
  let z = cvt.wrap::<u64, u32>(end);
  let made = CustomSet(first: a, end: z);
  let id = cvt.wrap::<u64, u32>(state^.custom_sets.inner.len);
  let placed = propagate push::<CustomSet>(cell: &state^.custom_sets, value: made, ceiling: 4294967295_u64);
  return Ok<u32, StyleError>(value: id);
}

fn set_bounds(state: &Inherited, set_id: u32) -> (first: u64, end: u64) reads(state) contract {
  ensures first <= end;
  ensures end <= state^.custom_entries.inner.len;
} {
  doc "The entry range of a custom-property set, empty for an unknown set.";
  let index = cvt::<u32, u64>(set_id);
  let known = index < state^.custom_sets.inner.len;
  if known {
  } else {
    return 0_u64, 0_u64;
  }
  let first = cvt::<u32, u64>(state^.custom_sets.inner[index].first);
  let end = cvt::<u32, u64>(state^.custom_sets.inner[index].end);
  let ordered = first <= end;
  let inside = end <= state^.custom_entries.inner.len;
  let usable = band(ordered, inside);
  if usable {
    return first, end;
  }
  return 0_u64, 0_u64;
}

fn declared_inherited(state: &Inherited, store: &RuleStore, cascade: &Cascade, element: u64, longhand: u8, set_id: u32, atoms: &AtomTable) -> result: Result<Option<Declared>, StyleError> reads(store), reads(cascade), writes(state), writes(atoms) {
  doc "inherited_declared against the element's custom-property set.";
  let (first, end) = set_bounds(state: state, set_id: set_id);
  let text_length = state^.custom_text.inner.len;
  let made = propagate inherited_declared(store: store, cascade: cascade, element: element, longhand: longhand, entries: &state^.custom_entries.inner[first..end], text: &state^.custom_text.inner[0_u64..text_length], atoms: atoms, named: &state^.named);
  return Ok<Option<Declared>, StyleError>(value: made);
}

fn inherit_element(state: &Inherited, store: &RuleStore, cascade: &Cascade, document: &Document, atoms: &AtomTable, environment: Environment, position: u64) -> result: Result<unit, StyleError> reads(store), reads(cascade), reads(document), writes(state), writes(atoms) {
  doc "Computes one styled node's custom properties, font and inherited text, table and generated-content values from its parent's, which the order of the nodes has already computed: an element's parent precedes it in preorder, and a pseudo-element follows every element. It also resolves the node's pending values of the longhands that are not inherited but fill shared tables, since only this pass may write them.";
  let count = cascade^.nodes.inner.len;
  let inside = position < count;
  let listed_parent = position < cascade^.parents.inner.len;
  let listed_kind = position < cascade^.kinds.inner.len;
  let listed = band(listed_parent, listed_kind);
  let known = band(inside, listed);
  if known {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<unit, StyleError>(error: failure);
  }
  let element = cascade^.nodes.inner[position];
  let kind = cascade^.kinds.inner[position];
  let parent = cvt::<u32, u64>(cascade^.parents.inner[position]);
  let has_parent = parent < position;
  let sized = position < state^.fonts.inner.len;
  let texts_sized = position < state^.texts.inner.len;
  let flags_sized = position < state^.visibility.inner.len;
  let scales_listed = position < state^.font_scales.inner.len;
  let keywords_listed = position < state^.font_keywords.inner.len;
  let keywords_sized = band(scales_listed, keywords_listed);
  let sets_sized = position < state^.sets.inner.len;
  let some_sized = band(sized, texts_sized);
  let more_sized = band(flags_sized, keywords_sized);
  let all_some = band(some_sized, more_sized);
  let all_sized = band(all_some, sets_sized);
  if all_sized {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<unit, StyleError>(error: failure);
  }
  let parent_font = initial_font(state: state);
  let parent_text = initial_text(state: state);
  let parent_visibility = 0_u8;
  let parent_keyword = 4_u8;
  let parent_scale = 1.0_f32;
  let parent_set = 0_u32;
  let initial_ex = fmul.strict(environment.serif.x_height, 16.0_f32);
  let parent_ex = initial_ex;
  let parent_ch = fmul.strict(environment.serif.zero_advance, 16.0_f32);
  let ex_sized = position < state^.ex.inner.len;
  let ch_sized = position < state^.ch.inner.len;
  let metrics_sized = band(ex_sized, ch_sized);
  if metrics_sized {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<unit, StyleError>(error: failure);
  }
  if has_parent {
    set parent_ex = state^.ex.inner[parent];
    set parent_ch = state^.ch.inner[parent];
    set parent_font = state^.fonts.inner[parent];
    set parent_text = state^.texts.inner[parent];
    set parent_visibility = state^.visibility.inner[parent];
    set parent_keyword = state^.font_keywords.inner[parent];
    set parent_scale = state^.font_scales.inner[parent];
    set parent_set = state^.sets.inner[parent];
  }
  let set_id = propagate custom_set(state: state, store: store, cascade: cascade, atoms: atoms, position: position, parent_set: parent_set);
  let sets_room = position < state^.sets.inner.len;
  if sets_room {
    set state^.sets.inner[position] = set_id;
  }
  let family = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_font_family, set_id: set_id, atoms: atoms);
  let families_start = parent_font.families_start;
  let families_end = parent_font.families_end;
  match family {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        set families_start = state^.initial_family;
        set families_end = state^.initial_family +sat 1_u32;
      }
      match declared_families(declared: d) {
        Some(value: range) => {
          set families_start = range.start;
          set families_end = range.end;
        }
        None() => {
        }
      }
    }
    None() => {
    }
  }
  let monospace = monospace_only(named: &state^.named, start: families_start, end: families_end, monospace: state^.monospace);
  let size_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_font_size, set_id: set_id, atoms: atoms);
  let size_environment = if has_parent {
    give Environment(width: environment.width, height: environment.height, root_font_size: state^.root_font_size, serif: environment.serif, sans: environment.sans, mono: environment.mono);
  } else {
    give environment;
  }
  let (size, size_keyword, size_scale) = font_size_of(declared: size_declared, parent_size: parent_font.size, parent_keyword: parent_keyword, parent_scale: parent_scale, parent_ex: parent_ex, parent_ch: parent_ch, monospace: monospace, environment: size_environment);
  let metrics = metrics_for(named: &state^.named, start: families_start, end: families_end, atoms: atoms, environment: environment);
  let (own_ex, own_ch) = font_units(metrics: metrics, size: size);
  if has_parent {
  } else {
    set state^.root_font_size = size;
  }
  let own_environment = Environment(width: environment.width, height: environment.height, root_font_size: state^.root_font_size, serif: environment.serif, sans: environment.sans, mono: environment.mono);
  let weight_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_font_weight, set_id: set_id, atoms: atoms);
  let weight = weight_of(declared: weight_declared, parent: parent_font.weight);
  let style_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_font_style, set_id: set_id, atoms: atoms);
  let style = keyword_or(declared: style_declared, parent: parent_font.style, initial: 0_u8);
  let line_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_line_height, set_id: set_id, atoms: atoms);
  let line_height = line_height_of(declared: line_declared, parent: parent_font.line_height, size: size, ex: own_ex, ch: own_ch, environment: own_environment);
  let font = FontGroup(families_start: families_start, families_end: families_end, size: size, weight: weight, style: style, line_height: line_height);
  let color_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_color, set_id: set_id, atoms: atoms);
  let color = color_of(declared: color_declared, parent: parent_text.color);
  let align_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_text_align, set_id: set_id, atoms: atoms);
  let declared_align = align_of(declared: align_declared, parent: parent_text.text_align);
  let element_node = kind == 0_u8;
  let html_th = is_html_th(document: document, element: element);
  let header_cell = band(element_node, html_th);
  let align_winner = winner_value(store: store, cascade: cascade, element: position, longhand: lh_text_align);
  let undeclared = match align_winner {
    Some(..) => {
      give False();
    }
    None() => {
      give True();
    }
  }
  let parent_initial = parent_text.text_align == 0_u8;
  let centred_cell = band(header_cell, undeclared);
  let centred = band(centred_cell, parent_initial);
  let align = if centred {
    give 4_u8;
  } else {
    give declared_align;
  }
  let indent_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_text_indent, set_id: set_id, atoms: atoms);
  let indent = indent_of(declared: indent_declared, parent: parent_text.text_indent, size: size, ex: own_ex, ch: own_ch, environment: own_environment);
  let transform_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_text_transform, set_id: set_id, atoms: atoms);
  let transform = keyword_or(declared: transform_declared, parent: parent_text.text_transform, initial: 0_u8);
  let white_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_white_space, set_id: set_id, atoms: atoms);
  let white = keyword_or(declared: white_declared, parent: parent_text.white_space, initial: 0_u8);
  let letter_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_letter_spacing, set_id: set_id, atoms: atoms);
  let letter = spacing_of(declared: letter_declared, parent: parent_text.letter_spacing, size: size, ex: own_ex, ch: own_ch, environment: own_environment);
  let word_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_word_spacing, set_id: set_id, atoms: atoms);
  let word = spacing_of(declared: word_declared, parent: parent_text.word_spacing, size: size, ex: own_ex, ch: own_ch, environment: own_environment);
  let list_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_list_style_type, set_id: set_id, atoms: atoms);
  let list_style = parent_text.list_style_type;
  match list_declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        set list_style = state^.disc;
      }
      match declared_list_style(declared: d) {
        Some(value: name) => {
          set list_style = name;
        }
        None() => {
        }
      }
    }
    None() => {
    }
  }
  let visibility_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_visibility, set_id: set_id, atoms: atoms);
  let visibility = keyword_or(declared: visibility_declared, parent: parent_visibility, initial: 0_u8);
  let wrap_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_overflow_wrap, set_id: set_id, atoms: atoms);
  let wrapping = keyword_or(declared: wrap_declared, parent: parent_text.overflow_wrap, initial: 0_u8);
  let break_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_word_break, set_id: set_id, atoms: atoms);
  let breaking = keyword_or(declared: break_declared, parent: parent_text.word_break, initial: 0_u8);
  let baseline = sizing_kind(kind: sizing_keyword);
  let text = TextGroup(color: color, text_align: align, text_indent: indent, text_transform: transform, white_space: white, letter_spacing: letter, word_spacing: word, vertical_align: baseline, decoration_line: 0_u8, list_style_type: list_style, overflow_wrap: wrapping, word_break: breaking);
  let parent_table = initial_table();
  let parent_quotes = quotes_auto_ref;
  let parent_position = 0_u8;
  let tables_sized = position < state^.tables.inner.len;
  let quotes_sized = position < state^.quotes.inner.len;
  let positions_sized = position < state^.list_positions.inner.len;
  let generated_sized = band(quotes_sized, positions_sized);
  let second_sized = band(tables_sized, generated_sized);
  if second_sized {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<unit, StyleError>(error: failure);
  }
  if has_parent {
    set parent_table = state^.tables.inner[parent];
    set parent_quotes = state^.quotes.inner[parent];
    set parent_position = state^.list_positions.inner[parent];
  }
  let collapse_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_border_collapse, set_id: set_id, atoms: atoms);
  let collapse = keyword_or(declared: collapse_declared, parent: parent_table.border_collapse, initial: 0_u8);
  let caption_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_caption_side, set_id: set_id, atoms: atoms);
  let caption = keyword_or(declared: caption_declared, parent: parent_table.caption_side, initial: 0_u8);
  let spacing_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_border_spacing, set_id: set_id, atoms: atoms);
  let spacing = border_spacing_of(named: &state^.named, declared: spacing_declared, parent: parent_table, size: size, ex: own_ex, ch: own_ch, environment: own_environment);
  let table = TableGroup(border_collapse: collapse, spacing_horizontal: spacing.spacing_horizontal, spacing_vertical: spacing.spacing_vertical, table_layout: 0_u8, caption_side: caption);
  let quotes_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_quotes, set_id: set_id, atoms: atoms);
  let quotes = quotes_of(declared: quotes_declared, parent: parent_quotes);
  let position_declared = propagate declared_inherited(state: state, store: store, cascade: cascade, element: position, longhand: lh_list_style_position, set_id: set_id, atoms: atoms);
  let list_position = keyword_or(declared: position_declared, parent: parent_position, initial: 0_u8);
  let table_room = position < state^.tables.inner.len;
  let quotes_room = position < state^.quotes.inner.len;
  let positions_room = position < state^.list_positions.inner.len;
  if table_room {
    set state^.tables.inner[position] = table;
  }
  if quotes_room {
    set state^.quotes.inner[position] = quotes;
  }
  if positions_room {
    set state^.list_positions.inner[position] = list_position;
  }
  if state^.resolves {
    let resolved = propagate resolve_stored(state: state, store: store, cascade: cascade, position: position, set_id: set_id, atoms: atoms);
  }
  let fonts_room = position < state^.fonts.inner.len;
  let texts_room = position < state^.texts.inner.len;
  let flags_room = position < state^.visibility.inner.len;
  let scales_room = position < state^.font_scales.inner.len;
  let keywords_present = position < state^.font_keywords.inner.len;
  let keywords_room = band(scales_room, keywords_present);
  let first_rooms = band(fonts_room, texts_room);
  let second_rooms = band(flags_room, keywords_room);
  let some_rooms = band(first_rooms, second_rooms);
  let ex_room = position < state^.ex.inner.len;
  let ch_room = position < state^.ch.inner.len;
  let unit_rooms = band(ex_room, ch_room);
  let rooms = band(some_rooms, unit_rooms);
  if rooms {
    set state^.ex.inner[position] = own_ex;
    set state^.ch.inner[position] = own_ch;
    set state^.fonts.inner[position] = font;
    set state^.font_keywords.inner[position] = size_keyword;
    set state^.font_scales.inner[position] = size_scale;
    set state^.texts.inner[position] = text;
    set state^.visibility.inner[position] = visibility;
  }
  return Ok<unit, StyleError>(value: unit);
}

fn intern_name(atoms: &AtomTable, name: &[u8]) -> result: Result<Atom, StyleError> reads(name), writes(atoms) {
  doc "Interns a short constant name.";
  let size = name^.len;
  if size > 65536_u64 {
    let failure = StyleError::TooLarge();
    return Err<Atom, StyleError>(error: failure);
  }
  match atom_intern(table: atoms, name: name) {
    Ok(value: atom) => {
      return Ok<Atom, StyleError>(value: atom);
    }
    Err(..) => {
      let failure = StyleError::TooLarge();
      return Err<Atom, StyleError>(error: failure);
    }
  }
}

fn inherited_pass(store: &RuleStore, cascade: &Cascade, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Inherited, StyleError> reads(store), reads(cascade), reads(document), reads(traversal), writes(atoms) {
  doc "Copies the store's family lists and side stores, adds the initial family, and computes every styled node in order: the elements in preorder, then the pseudo-elements.";
  let count = cascade^.nodes.inner.len;
  let small = count <= 4294967294_u64;
  let elements = traversal^.elements.inner.len;
  let matched = elements == cascade^.element_count;
  if matched {
  } else {
    let failure = StyleError::Inconsistent();
    return Err<Inherited, StyleError>(error: failure);
  }
  if small {
  } else {
    let failure = StyleError::TooLarge();
    return Err<Inherited, StyleError>(error: failure);
  }
  let named = match declaration_store_side_copy(from: &store^.declared) {
    Ok(value: made) => {
      give move made;
    }
    Err(..) => {
      let failure = StyleError::TooLarge();
      return Err<Inherited, StyleError>(error: failure);
    }
  }
  let resolves = pending_stored(store: store);
  let initial_n = initial_family_name.len;
  let disc_n = disc_name.len;
  let monospace_n = monospace_name.len;
  let initial_atom = propagate intern_name(atoms: atoms, name: &initial_family_name[0_u64..initial_n]);
  let disc = propagate intern_name(atoms: atoms, name: &disc_name[0_u64..disc_n]);
  let monospace = propagate intern_name(atoms: atoms, name: &monospace_name[0_u64..monospace_n]);
  let initial_index = cvt.wrap::<u64, u32>(named.families.inner.len);
  let no = False();
  let initial_family = Family(name: initial_atom, generic: no);
  match append_family(store: &named, family: initial_family) {
    Ok(..) => {
    }
    Err(..) => {
      let failure = StyleError::TooLarge();
      return Err<Inherited, StyleError>(error: failure);
    }
  }
  let normal = sizing_kind(kind: sizing_normal);
  let blank_font = FontGroup(families_start: initial_index, families_end: initial_index, size: 16.0_f32, weight: 4.0e2_f32, style: 0_u8, line_height: normal);
  let black = black_color();
  let zero = lp_zero();
  let baseline = sizing_kind(kind: sizing_keyword);
  let blank_text = TextGroup(color: black, text_align: 0_u8, text_indent: zero, text_transform: 0_u8, white_space: 0_u8, letter_spacing: normal, word_spacing: normal, vertical_align: baseline, decoration_line: 0_u8, list_style_type: disc, overflow_wrap: 0_u8, word_break: 0_u8);
  let blank_table = initial_table();
  let tables = box_array_filled::<TableGroup>(count: count, value: blank_table);
  let quotes = box_array_filled::<u32>(count: count, value: quotes_auto_ref);
  let list_positions = box_array_filled::<u8>(count: count, value: 0_u8);
  let resolved = box_slots_new::<Resolved>(capacity: 0_u64);
  let pseudo_parents = box_slots_new::<u32>(capacity: 0_u64);
  let pseudo_kinds = box_slots_new::<u8>(capacity: 0_u64);
  let node_total = cascade^.parents.inner.len;
  let kind_total = cascade^.kinds.inner.len;
  let first_pseudo = cascade^.element_count;
  for (node in first_pseudo..node_total) {
    let inside = node < kind_total;
    if inside {
      let parent_index = cascade^.parents.inner[node];
      let pseudo_kind = cascade^.kinds.inner[node];
      let placed_parent = propagate push::<u32>(cell: &pseudo_parents, value: parent_index, ceiling: 4294967295_u64);
      let placed_kind = propagate push::<u8>(cell: &pseudo_kinds, value: pseudo_kind, ceiling: 4294967295_u64);
    }
  }
  let fonts = box_array_filled::<FontGroup>(count: count, value: blank_font);
  let texts = box_array_filled::<TextGroup>(count: count, value: blank_text);
  let visibility = box_array_filled::<u8>(count: count, value: 0_u8);
  let font_keywords = box_array_filled::<u8>(count: count, value: 0_u8);
  let font_scales = box_array_filled::<f32>(count: count, value: 1.0_f32);
  let sets = box_array_filled::<u32>(count: count, value: 0_u32);
  let ex = box_array_filled::<f32>(count: count, value: 8.0_f32);
  let ch = box_array_filled::<f32>(count: count, value: 8.0_f32);
  let custom_sets = box_slots_new::<CustomSet>(capacity: 0_u64);
  let empty = CustomSet(first: 0_u32, end: 0_u32);
  let first_set = propagate push::<CustomSet>(cell: &custom_sets, value: empty, ceiling: 4294967295_u64);
  let custom_entries = box_slots_new::<CustomEntry>(capacity: 0_u64);
  let custom_text = box_slots_new::<u8>(capacity: 0_u64);
  let state = Inherited(fonts: move fonts, texts: move texts, visibility: move visibility, font_keywords: move font_keywords, font_scales: move font_scales, ex: move ex, ch: move ch, sets: move sets, custom_sets: move custom_sets, custom_entries: move custom_entries, custom_text: move custom_text, named: move named, initial_family: initial_index, disc: disc, monospace: monospace, root_font_size: environment.root_font_size, tables: move tables, quotes: move quotes, list_positions: move list_positions, resolved: move resolved, resolves: resolves, environment: environment, pseudo_parents: move pseudo_parents, pseudo_kinds: move pseudo_kinds);
  for (position in 0_u64..count) {
    let done = propagate inherit_element(state: &state, store: store, cascade: cascade, document: document, atoms: atoms, environment: environment, position: position);
  }
  return Ok<Inherited, StyleError>(value: move state);
}

fn is_html_th(document: &Document, element: NodeId) -> header: Bool reads(document) {
  doc "True for a th element in the HTML namespace, which the HTML Standard's rendering section centres, in prose rather than in its style sheet, when its parent's text-align is the initial value.";
  let index = cvt::<u32, u64>(element.index);
  let known = index < document^.nodes.inner.len;
  if known {
  } else {
    return False();
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(namespace: space, local_name: local, attributes: list, template_contents: held) => {
      let html = match space^ {
        Html() => {
          give True();
        }
        Svg() => {
          give False();
        }
        MathMl() => {
          give False();
        }
      }
      let named = local^.index == atom_th;
      let both = band(html, named);
      return both;
    }
    DocumentRoot(..) => {
    }
    DocumentType(..) => {
    }
    Text(..) => {
    }
    Comment(..) => {
    }
    Fragment() => {
    }
  }
  return False();
}

const mono_names: Array<u8, 22> = "monospace ui-monospace";

const sans_names: Array<u8, 34> = "sans-serif system-ui ui-sans-serif";

fn family_words(atoms: &AtomTable, index: u32, list: &[u8]) -> found: Bool reads(atoms), reads(list) {
  doc "True when the atom's text is one word of list.";
  let at = cvt::<u32, u64>(index);
  let known = at < atoms^.spans.inner.len;
  if known {
  } else {
    return False();
  }
  let span = atoms^.spans.inner[at];
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let ordered = start <= end;
  let inside = end <= atoms^.text.inner.len;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return False();
  }
  let found = word_index(list: list, text: &atoms^.text.inner[start..end]);
  match found {
    Some(..) => {
      return True();
    }
    None() => {
      return False();
    }
  }
}

fn metrics_for(named: &DeclarationStore, start: u32, end: u32, atoms: &AtomTable, environment: Environment) -> metrics: FontMetrics reads(named), reads(atoms) {
  doc "The metrics of the element's first available font: the first generic family of its list, as the environment's default fonts draw it, monospace for monospace and ui-monospace, sans-serif for sans-serif, system-ui and ui-sans-serif, and serif for any other generic and for a list with none, since named families are not loaded in this first cut.";
  let low = cvt::<u32, u64>(start);
  let high = cvt::<u32, u64>(end);
  let count = named^.families.inner.len;
  let ordered = low <= high;
  let inside = high <= count;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return environment.serif;
  }
  let mono_n = mono_names.len;
  let sans_n = sans_names.len;
  for (k in low..high) {
    let family = named^.families.inner[k];
    if family.generic {
      let mono = family_words(atoms: atoms, index: family.name.index, list: &mono_names[0_u64..mono_n]);
      if mono {
        return environment.mono;
      }
      let sans = family_words(atoms: atoms, index: family.name.index, list: &sans_names[0_u64..sans_n]);
      if sans {
        return environment.sans;
      }
      return environment.serif;
    }
  }
  return environment.serif;
}

fn font_units(metrics: FontMetrics, size: f32) -> (ex: f32, ch: f32) pure {
  doc "The ex and ch of a font size in px: the x-height, rounded up when the font's x-height is measured from its glyph's bounds, and the advance of the digit zero.";
  let raw_ex = fmul.strict(metrics.x_height, size);
  let ex = if metrics.x_rounds_up {
    give fceil(raw_ex);
  } else {
    give raw_ex;
  }
  let ch = fmul.strict(metrics.zero_advance, size);
  return ex, ch;
}

fn pending_named(own: &Box<Slots<OwnCustom>>, name: u32) -> found: Option<u64> reads(own) {
  doc "The position among own of the waiting custom property named name, or None.";
  let count = own^.inner.len;
  for (k in 0_u64..count) {
    let waiting = own^.inner[k].state == state_pending;
    let named = own^.inner[k].name == name;
    let both = band(waiting, named);
    if both {
      return Some<u64>(value: k);
    }
  }
  return None<u64>();
}

fn push_index(cell: &Box<Slots<u64>>, value: u64) -> result: unit writes(cell) {
  doc "Appends one index to a list that stays below 2^20 entries.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let small = capacity < 8_u64;
    if small {
      grow(cell: cell, capacity: 8_u64);
    } else {
      let limit = capacity < 1048576_u64;
      if limit {
        let doubled = capacity + capacity;
        grow(cell: cell, capacity: doubled);
      } else {
        return unit;
      }
    }
  }
  let room = cell^.inner.len < cell^.inner.cap;
  if room {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn references_of(own: &Box<Slots<OwnCustom>>, store: &RuleStore, atoms: &AtomTable, entries: &[CustomEntry], k: u64, out: &Box<Slots<u64>>) -> result: unit reads(own), reads(store), reads(atoms), reads(entries), writes(out) {
  doc "Appends the positions of the waiting custom properties that own[k]'s value depends on as substitution reads it: a var() whose name is waiting is one; a var() whose name has a value is skipped with its fallback; the fallback of a var() whose name has none is read in turn.";
  let inside = k < own^.inner.len;
  if inside {
  } else {
    return unit;
  }
  let index = cvt::<u32, u64>(own^.inner[k].declaration);
  let known = index < store^.customs.inner.len;
  if known {
  } else {
    return unit;
  }
  let declaration = store^.customs.inner[index];
  let sheet = cvt::<u32, u64>(declaration.sheet);
  let listed = sheet < store^.sheets.inner.len;
  if listed {
  } else {
    return unit;
  }
  let start = cvt::<u32, u64>(declaration.start);
  let end = cvt::<u32, u64>(declaration.end);
  let length = store^.sheets.inner[sheet].values.components.inner.len;
  let ordered = start <= end;
  let fits = end <= length;
  let usable = band(ordered, fits);
  if usable {
  } else {
    return unit;
  }
  let n = var_word.len;
  let cursor = start;
  let span = end - start;
  for (step in 0_u64..span) {
    let at = cursor;
    if at >= end {
      break;
    }
    let advance = at + 1_u64;
    let kind = component_kind(values: &store^.sheets.inner[sheet].values, at: at);
    if kind == c_function {
      let named = name_word(values: &store^.sheets.inner[sheet].values, at: at, list: &var_word[0_u64..n]);
      match named {
        Some(..) => {
          let name_at_index = skip_space(values: &store^.sheets.inner[sheet].values, at: advance, limit: end);
          if name_at_index < end {
            match var_name_atom(values: &store^.sheets.inner[sheet].values, at: name_at_index, atoms: atoms) {
              Some(value: name) => {
                match pending_named(own: own, name: name) {
                  Some(value: target) => {
                    push_index(cell: out, value: target);
                    set advance = sibling_after(values: &store^.sheets.inner[sheet].values, at: at, limit: end);
                  }
                  None() => {
                    match find_custom(entries: entries, name: name) {
                      Some(..) => {
                        set advance = sibling_after(values: &store^.sheets.inner[sheet].values, at: at, limit: end);
                      }
                      None() => {
                      }
                    }
                  }
                }
              }
              None() => {
              }
            }
          }
        }
        None() => {
        }
      }
    }
    set cursor = advance;
  }
  return unit;
}

fn on_cycle(own: &Box<Slots<OwnCustom>>, store: &RuleStore, atoms: &AtomTable, entries: &[CustomEntry], k: u64) -> cyclic: Bool reads(own), reads(store), reads(atoms), reads(entries) {
  doc "True when following var() references among the waiting custom properties from own[k] leads back to own[k].";
  let count = own^.inner.len;
  let seen = box_array_filled::<u8>(count: count, value: 0_u8);
  let frontier = box_slots_new::<u64>(capacity: 0_u64);
  references_of(own: own, store: store, atoms: atoms, entries: entries, k: k, out: &frontier);
  for (step in 0_u64..count) {
    let size = frontier.inner.len;
    if size == 0_u64 {
      return False();
    }
    let next = box_slots_new::<u64>(capacity: 0_u64);
    for (f in 0_u64..size) {
      let target = frontier.inner[f];
      if target == k {
        return True();
      }
      let inside = target < seen.inner.len;
      if inside {
        if seen.inner[target] == 0_u8 {
          set seen.inner[target] = 1_u8;
          references_of(own: own, store: store, atoms: atoms, entries: entries, k: target, out: &next);
        }
      }
    }
    set frontier = move next;
  }
  return False();
}

fn invalidate_cycles(own: &Box<Slots<OwnCustom>>, store: &RuleStore, atoms: &AtomTable, entries: &[CustomEntry]) -> result: unit reads(store), reads(atoms), reads(entries), writes(own) {
  doc "Marks invalid, as done without a value, every waiting custom property on a cycle of var() references; when none is, which no round that resolved nothing leaves, every waiting one.";
  let count = own^.inner.len;
  let cyclic = box_array_filled::<u8>(count: count, value: 0_u8);
  let any = False();
  for (k in 0_u64..count) {
    if own^.inner[k].state == state_pending {
      let found = on_cycle(own: own, store: store, atoms: atoms, entries: entries, k: k);
      if found {
        set cyclic.inner[k] = 1_u8;
        set any = True();
      }
    }
  }
  for (k in 0_u64..count) {
    let pending = own^.inner[k].state == state_pending;
    let marked = cyclic.inner[k] == 1_u8;
    let unmarked_stall = bnot(any);
    let drop_it = bor(marked, unmarked_stall);
    let both = band(pending, drop_it);
    if both {
      set own^.inner[k].state = state_done;
    }
  }
  return unit;
}

const quotes_auto_ref: u32 = 4294967295_u32;

const quotes_none_ref: u32 = 4294967294_u32;

fn initial_table() -> made: TableGroup pure {
  doc "The initial table values: separate borders, no spacing, automatic layout and the caption on top.";
  return TableGroup(border_collapse: 0_u8, spacing_horizontal: 0.0_f32, spacing_vertical: 0.0_f32, table_layout: 0_u8, caption_side: 0_u8);
}

fn border_spacing_of(named: &DeclarationStore, declared: Option<Declared>, parent: TableGroup, size: f32, ex: f32, ch: f32, environment: Environment) -> spacing: TableGroup reads(named) {
  doc "Computes border-spacing: its two lengths as px against the element's own font, zero for initial, the parent's otherwise; the result's other fields are the parent's.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        let made = TableGroup(border_collapse: parent.border_collapse, spacing_horizontal: 0.0_f32, spacing_vertical: 0.0_f32, table_layout: parent.table_layout, caption_side: parent.caption_side);
        return made;
      }
      match declared_stored(declared: d) {
        Some(value: stored) => {
          let first = cvt::<u32, u64>(stored.index);
          let second = first +sat 1_u64;
          let usable = second < named^.spacings.inner.len;
          let kind = stored.kind == stored_spacing;
          let both = band(usable, kind);
          if both {
            let horizontal = compute_length(lengths: named^.spacings.inner[first], font_size: size, ex: ex, ch: ch, environment: environment);
            let vertical = compute_length(lengths: named^.spacings.inner[second], font_size: size, ex: ex, ch: ch, environment: environment);
            let made = TableGroup(border_collapse: parent.border_collapse, spacing_horizontal: horizontal.px, spacing_vertical: vertical.px, table_layout: parent.table_layout, caption_side: parent.caption_side);
            return made;
          }
        }
        None() => {
        }
      }
    }
    None() => {
    }
  }
  return parent;
}

fn quotes_of(declared: Option<Declared>, parent: u32) -> quotes: u32 pure {
  doc "Computes quotes as a reference: quotes_auto_ref for auto and initial, quotes_none_ref for none, the index of a quote list in the pass's named store, or the parent's.";
  match declared {
    Some(value: d) => {
      let initial = is_initial(declared: d);
      if initial {
        return quotes_auto_ref;
      }
      match declared_keyword(declared: d) {
        Some(value: k) => {
          if k == keyword_none {
            return quotes_none_ref;
          }
          return quotes_auto_ref;
        }
        None() => {
        }
      }
      match declared_stored(declared: d) {
        Some(value: stored) => {
          if stored.kind == stored_quotes {
            let below = stored.index < quotes_none_ref;
            if below {
              return stored.index;
            }
          }
          return parent;
        }
        None() => {
          return parent;
        }
      }
    }
    None() => {
      return parent;
    }
  }
}

fn stored_longhand(longhand: u8) -> stored: Bool pure {
  doc "True for a longhand that is not inherited and whose value can be Stored, so that a pending value of it is parsed by parse_pending_named in this pass: the grid template and implicit track longhands, the four grid lines, content and the three counter longhands.";
  let template_from = longhand >= lh_grid_template_columns;
  let template_to = longhand <= lh_grid_template_areas;
  let template = band(template_from, template_to);
  let implicit_from = longhand >= lh_grid_auto_columns;
  let implicit_to = longhand <= lh_grid_auto_rows;
  let implicit = band(implicit_from, implicit_to);
  let lines_from = longhand >= lh_grid_row_start;
  let lines_to = longhand <= lh_grid_column_end;
  let lines = band(lines_from, lines_to);
  let generated_from = longhand >= lh_content;
  let generated_to = longhand <= lh_counter_set;
  let generated = band(generated_from, generated_to);
  let grid = bor(template, implicit);
  let placed = bor(lines, generated);
  let any = bor(grid, placed);
  return any;
}

fn pending_stored(store: &RuleStore) -> found: Bool reads(store) {
  doc "True when some declaration of the store is a pending value of a stored longhand, so the pass must resolve such values.";
  let count = store^.declared.declarations.inner.len;
  for (k in 0_u64..count) {
    let declaration = store^.declared.declarations.inner[k];
    let stored = stored_longhand(longhand: declaration.longhand);
    if stored {
      match declared_pending(declared: declaration.value) {
        Some(..) => {
          return True();
        }
        None() => {
        }
      }
    }
  }
  return False();
}

fn resolve_stored(state: &Inherited, store: &RuleStore, cascade: &Cascade, position: u64, set_id: u32, atoms: &AtomTable) -> result: Result<unit, StyleError> reads(store), reads(cascade), writes(state), writes(atoms) {
  doc "Substitutes and parses, with parse_pending_named, each pending winning value of a stored longhand of the node at position, and records it, or that it is invalid at computed-value time, in the pass's resolved list, which stays in node order for the third part to search.";
  let node = cvt.wrap::<u64, u32>(position);
  for (code in 55_u64..93_u64) {
    let longhand = cvt::<u64, u8>(code);
    let stored = stored_longhand(longhand: longhand);
    if stored {
      match winner_value(store: store, cascade: cascade, element: position, longhand: longhand) {
        Some(value: declared) => {
          match declared_pending(declared: declared) {
            Some(value: pending) => {
              let (first, end) = set_bounds(state: state, set_id: set_id);
              let text_length = state^.custom_text.inner.len;
              let parsed = propagate resolve_named(store: store, pending: pending, longhand: longhand, entries: &state^.custom_entries.inner[first..end], text: &state^.custom_text.inner[0_u64..text_length], atoms: atoms, named: &state^.named);
              let made = match parsed {
                Some(value: v) => {
                  let yes = True();
                  give Resolved(node: node, longhand: longhand, valid: yes, value: v);
                }
                None() => {
                  let no = False();
                  let placeholder = Declared::Keyword(keyword: 0_u8);
                  give Resolved(node: node, longhand: longhand, valid: no, value: placeholder);
                }
              }
              let placed = propagate push::<Resolved>(cell: &state^.resolved, value: made, ceiling: 4294967295_u64);
            }
            None() => {
            }
          }
        }
        None() => {
        }
      }
    }
  }
  return Ok<unit, StyleError>(value: unit);
}
