  let background_ns = nanoseconds_from(earlier: texted, later: backgrounded);
  let custom_ns = nanoseconds_from(earlier: backgrounded, later: customized);
  let container_ns = nanoseconds_from(earlier: customized, later: contained);
  let item_ns = nanoseconds_from(earlier: contained, later: itemized);
  let table_ns = nanoseconds_from(earlier: itemized, later: tabled);
  let content_ns = nanoseconds_from(earlier: tabled, later: contented);
  let ids_ns = nanoseconds_from(earlier: contented, later: assembled);
  let place_ns = nanoseconds_from(earlier: assembled, later: placed);
  let whole_ns = nanoseconds_from(earlier: begin, later: placed);
  let box_hash_ns = nanoseconds_from(earlier: placed, later: box_hashed);
  let size_hash_ns = nanoseconds_from(earlier: box_hashed, later: size_hashed);
  let spacing_hash_ns = nanoseconds_from(earlier: size_hashed, later: spacing_hashed);
  let border_hash_ns = nanoseconds_from(earlier: spacing_hashed, later: border_hashed);
  let font_hash_ns = nanoseconds_from(earlier: border_hashed, later: font_hashed);
  let text_hash_ns = nanoseconds_from(earlier: font_hashed, later: text_hashed);
  let background_hash_ns = nanoseconds_from(earlier: text_hashed, later: background_hashed);
  set_lap(laps: laps, slot: 0_u64, value: prepare_ns);
  set_lap(laps: laps, slot: 1_u64, value: setup_ns);
  set_lap(laps: laps, slot: 2_u64, value: box_ns);
  set_lap(laps: laps, slot: 3_u64, value: size_ns);
  set_lap(laps: laps, slot: 4_u64, value: spacing_ns);
  set_lap(laps: laps, slot: 5_u64, value: border_ns);
  set_lap(laps: laps, slot: 6_u64, value: font_ns);
  set_lap(laps: laps, slot: 7_u64, value: text_ns);
  set_lap(laps: laps, slot: 8_u64, value: background_ns);
  set_lap(laps: laps, slot: 9_u64, value: custom_ns);
  set_lap(laps: laps, slot: 10_u64, value: container_ns);
  set_lap(laps: laps, slot: 11_u64, value: item_ns);
  set_lap(laps: laps, slot: 12_u64, value: table_ns);
  set_lap(laps: laps, slot: 13_u64, value: content_ns);
  set_lap(laps: laps, slot: 14_u64, value: ids_ns);
  set_lap(laps: laps, slot: 15_u64, value: place_ns);
  set_lap(laps: laps, slot: 16_u64, value: whole_ns);
  set_lap(laps: laps, slot: 17_u64, value: box_hash_ns);
  set_lap(laps: laps, slot: 18_u64, value: size_hash_ns);
  set_lap(laps: laps, slot: 19_u64, value: spacing_hash_ns);
  set_lap(laps: laps, slot: 20_u64, value: border_hash_ns);
  set_lap(laps: laps, slot: 21_u64, value: font_hash_ns);
  set_lap(laps: laps, slot: 22_u64, value: text_hash_ns);
  set_lap(laps: laps, slot: 23_u64, value: background_hash_ns);
  return Ok<Styles, StyleError>(value: move styles);
}
