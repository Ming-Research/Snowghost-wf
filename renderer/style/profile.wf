fn custom_after(started: Instant, canon: &Box<Slots<u32>>, index: &Box<Array<u32>>, inherited: &Inherited) -> distinct: u64 reads(inherited), writes(canon), writes(index) {
  doc "canon_sets, called with the reading that starts its interval as an argument.";
