fn container_after(started: Instant, groups: &Box<Slots<ContainerGroup>>, out: &TrackOut, group_table: &WordTable, track_table: &WordTable, area_table: &WordTable, values: &[ContainerGroup], nodes: &[TrackNodes], inherited: &Inherited, ids: &[u32]) -> result: unit reads(values), reads(nodes), reads(inherited), writes(groups), writes(out), writes(group_table), writes(track_table), writes(area_table), writes(ids) {
  doc "intern_container_group, called with the reading that starts its interval as an argument.";
  intern_container_group(groups: groups, out: out, group_table: group_table, track_table: track_table, area_table: area_table, values: values, nodes: nodes, inherited: inherited, ids: ids);
  return unit;
}

