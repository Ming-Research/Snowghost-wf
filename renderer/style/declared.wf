fn declared_pending(declared: Declared) -> found: Option<PendingRef> pure {
  doc "The reference of a Pending value, or None.";
  match declared {
    Keyword(..) => {
      return None<PendingRef>();
    }
    Length(..) => {
      return None<PendingRef>();
    }
    Number(..) => {
      return None<PendingRef>();
    }
    Integer(..) => {
      return None<PendingRef>();
    }
    ColorValue(..) => {
      return None<PendingRef>();
    }
    CurrentColor() => {
      return None<PendingRef>();
    }
    Families(..) => {
      return None<PendingRef>();
    }
    ListStyle(..) => {
      return None<PendingRef>();
    }
    Wide(..) => {
      return None<PendingRef>();
    }
    Pending(sheet: s, start: a, end: b, shorthand: h) => {
      let made = PendingRef(sheet: s, start: a, end: b, shorthand: h);
      return Some<PendingRef>(value: made);
    }
  }
}
