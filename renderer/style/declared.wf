alias Atom = pkg::base::atom::Atom;
alias Color = pkg::css::color::Color;
alias ColorSpace = pkg::css::color::ColorSpace;
alias ColorRef = pkg::css::values::ColorRef;
alias Declared = pkg::css::values::Declared;
alias Lengths = pkg::css::values::Lengths;

struct Span32 {
  start: u32;
  end: u32;
}

struct PendingRef {
  sheet: u32;
  start: u32;
  end: u32;
  shorthand: u8;
}

fn declared_keyword(declared: Declared) -> found: Option<u8> pure {
  doc "The keyword of a Keyword value, or None.";
  match declared {
    Keyword(keyword: k) => {
      return Some<u8>(value: k);
    }
    Length(..) => {
      return None<u8>();
    }
    Number(..) => {
      return None<u8>();
    }
    Integer(..) => {
      return None<u8>();
    }
    ColorValue(..) => {
      return None<u8>();
    }
    CurrentColor() => {
      return None<u8>();
    }
    Families(..) => {
      return None<u8>();
    }
    ListStyle(..) => {
      return None<u8>();
    }
    Wide(..) => {
      return None<u8>();
    }
    Pending(..) => {
      return None<u8>();
    }
  }
}

