fn declared_color(declared: Declared) -> found: Option<ColorRef> pure {
  doc "A color or currentcolor value as a ColorRef, or None.";
  match declared {
    Keyword(..) => {
      return None<ColorRef>();
    }
    Length(..) => {
      return None<ColorRef>();
    }
    Number(..) => {
      return None<ColorRef>();
    }
    Integer(..) => {
      return None<ColorRef>();
    }
    ColorValue(color: c) => {
      let no = False();
      let made = ColorRef(current: no, color: c);
      return Some<ColorRef>(value: made);
    }
    CurrentColor() => {
      let yes = True();
      let black = black_color();
      let made = ColorRef(current: yes, color: black);
      return Some<ColorRef>(value: made);
    }
    Families(..) => {
      return None<ColorRef>();
    }
    ListStyle(..) => {
      return None<ColorRef>();
    }
    Wide(..) => {
      return None<ColorRef>();
    }
    Pending(..) => {
      return None<ColorRef>();
    }
  }
}

fn declared_families(declared: Declared) -> found: Option<Span32> pure {
  doc "The family range of a Families value as (start, end), or None.";
  match declared {
    Keyword(..) => {
      return None<Span32>();
    }
    Length(..) => {
      return None<Span32>();
    }
    Number(..) => {
      return None<Span32>();
    }
    Integer(..) => {
      return None<Span32>();
    }
    ColorValue(..) => {
      return None<Span32>();
    }
    CurrentColor() => {
      return None<Span32>();
    }
    Families(start: a, end: b) => {
      let made = Span32(start: a, end: b);
      return Some<Span32>(value: made);
    }
    ListStyle(..) => {
      return None<Span32>();
    }
    Wide(..) => {
      return None<Span32>();
    }
    Pending(..) => {
      return None<Span32>();
    }
  }
}

