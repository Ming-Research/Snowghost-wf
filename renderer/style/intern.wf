fn hash_border_group(hash: u64, value: BorderGroup) -> next: u64 pure {
  doc "Mixes every field of a BorderGroup into hash.";
  let acc = hash;
  let w_top_width = float_word(value: value.top_width);
  set acc = mix(hash: acc, value: w_top_width);
  let w_right_width = float_word(value: value.right_width);
  set acc = mix(hash: acc, value: w_right_width);
  let w_bottom_width = float_word(value: value.bottom_width);
  set acc = mix(hash: acc, value: w_bottom_width);
  let w_left_width = float_word(value: value.left_width);
  set acc = mix(hash: acc, value: w_left_width);
  let w_top_style = cvt::<u8, u64>(value.top_style);
  set acc = mix(hash: acc, value: w_top_style);
  let w_right_style = cvt::<u8, u64>(value.right_style);
  set acc = mix(hash: acc, value: w_right_style);
  let w_bottom_style = cvt::<u8, u64>(value.bottom_style);
  set acc = mix(hash: acc, value: w_bottom_style);
  let w_left_style = cvt::<u8, u64>(value.left_style);
  set acc = mix(hash: acc, value: w_left_style);
  set acc = hash_color_ref(hash: acc, value: value.top_color);
  set acc = hash_color_ref(hash: acc, value: value.right_color);
  set acc = hash_color_ref(hash: acc, value: value.bottom_color);
  set acc = hash_color_ref(hash: acc, value: value.left_color);
  return acc;
}

