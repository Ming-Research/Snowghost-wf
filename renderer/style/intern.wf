  doc "True when every field of the two LengthPercentage values is equal.";
  let equal_px = feq(first.px, second.px);
  if equal_px {
  } else {
    return False();
  }
  let equal_percent = feq(first.percent, second.percent);
  if equal_percent {
  } else {
    return False();
  }
  let equal_has_percent = first.has_percent == second.has_percent;
