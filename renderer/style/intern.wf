fn append_group<T: drop>(cell: &Box<Slots<T>>, value: T) -> result: unit writes(cell) {
  doc "Appends value to a table that holds fewer than 2^30 entries, doubling its capacity when full.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let small = capacity < 16_u64;
    if small {
      grow(cell: cell, capacity: 16_u64);
    } else {
      let limit = capacity < 1073741824_u64;
      if limit {
        let doubled = capacity + capacity;
        grow(cell: cell, capacity: doubled);
      } else {
        return unit;
      }
    }
  }
  let room = cell^.inner.len < cell^.inner.cap;
  if room {
  } else {
    return unit;
  }
  place_back(window: &cell^.inner, value: move value);
  return unit;
}

fn mix(hash: u64, value: u64) -> next: u64 pure {
  doc "One FNV-1a step over a 64-bit word.";
  let folded = ixor(hash, value);
  let next = folded *wrap 1099511628211_u64;
  return next;
}

fn float_word(value: f32) -> word: u64 pure {
  doc "A word for hashing a float: the value in 1/64 units, rounded toward zero, 0 when it does not fit.";
  let scaled = fmul.strict(value, 64.0_f32);
  let fits = cvt.defined::<f32, i64>(scaled);
  if fits {
    let whole = cvt::<f32, i64>(scaled);
    let word = cvt.wrap::<i64, u64>(whole);
    return word;
  }
  return 0_u64;
}

fn bool_word(value: Bool) -> word: u64 pure {
  doc "1 for true, 0 for false.";
  if value {
    return 1_u64;
  }
  return 0_u64;
}

fn space_word(space: ColorSpace) -> word: u64 pure {
  doc "The ordinal of a color space.";
  match space {
    Rgb() => {
      return 0_u64;
    }
    Lab() => {
      return 1_u64;
    }
    Lch() => {
      return 2_u64;
    }
    Oklab() => {
      return 3_u64;
    }
    Oklch() => {
      return 4_u64;
    }
    Srgb() => {
      return 5_u64;
    }
    SrgbLinear() => {
      return 6_u64;
    }
    DisplayP3() => {
      return 7_u64;
    }
    A98Rgb() => {
      return 8_u64;
    }
    ProphotoRgb() => {
      return 9_u64;
    }
    Rec2020() => {
      return 10_u64;
    }
    XyzD50() => {
      return 11_u64;
    }
    XyzD65() => {
      return 12_u64;
    }
  }
}

fn hash_box_group(hash: u64, value: BoxGroup) -> next: u64 pure {
  doc "Mixes every field of a BoxGroup into hash.";
  let acc = hash;
  let w_display = cvt::<u8, u64>(value.display);
  set acc = mix(hash: acc, value: w_display);
  let w_position = cvt::<u8, u64>(value.position);
  set acc = mix(hash: acc, value: w_position);
  let w_float = cvt::<u8, u64>(value.float);
  set acc = mix(hash: acc, value: w_float);
  let w_clear = cvt::<u8, u64>(value.clear);
  set acc = mix(hash: acc, value: w_clear);
  let w_overflow_x = cvt::<u8, u64>(value.overflow_x);
  set acc = mix(hash: acc, value: w_overflow_x);
  let w_overflow_y = cvt::<u8, u64>(value.overflow_y);
  set acc = mix(hash: acc, value: w_overflow_y);
  let w_box_sizing = cvt::<u8, u64>(value.box_sizing);
  set acc = mix(hash: acc, value: w_box_sizing);
  let w_visibility = cvt::<u8, u64>(value.visibility);
  set acc = mix(hash: acc, value: w_visibility);
  let w_z_auto = bool_word(value: value.z_auto);
  set acc = mix(hash: acc, value: w_z_auto);
  let w_z_index = cvt.wrap::<i32, u64>(value.z_index);
  set acc = mix(hash: acc, value: w_z_index);
  return acc;
}

fn same_box_group(first: BoxGroup, second: BoxGroup) -> same: Bool pure {
  doc "True when every field of the two BoxGroup values is equal.";
  if first.display != second.display {
    return False();
  }
  if first.position != second.position {
    return False();
  }
  if first.float != second.float {
    return False();
  }
  if first.clear != second.clear {
    return False();
  }
  if first.overflow_x != second.overflow_x {
    return False();
  }
  if first.overflow_y != second.overflow_y {
    return False();
  }
  if first.box_sizing != second.box_sizing {
    return False();
  }
  if first.visibility != second.visibility {
    return False();
  }
  let equal_z_auto = eeq(first.z_auto, second.z_auto);
  if equal_z_auto {
  } else {
    return False();
  }
  if first.z_index != second.z_index {
    return False();
  }
  return True();
}

fn hash_size_group(hash: u64, value: SizeGroup) -> next: u64 pure {
  doc "Mixes every field of a SizeGroup into hash.";
  let acc = hash;
  set acc = hash_sizing(hash: acc, value: value.width);
  set acc = hash_sizing(hash: acc, value: value.height);
  set acc = hash_sizing(hash: acc, value: value.min_width);
  set acc = hash_sizing(hash: acc, value: value.min_height);
  set acc = hash_sizing(hash: acc, value: value.max_width);
  set acc = hash_sizing(hash: acc, value: value.max_height);
  set acc = hash_sizing(hash: acc, value: value.top);
  set acc = hash_sizing(hash: acc, value: value.right);
  set acc = hash_sizing(hash: acc, value: value.bottom);
  set acc = hash_sizing(hash: acc, value: value.left);
  return acc;
}

