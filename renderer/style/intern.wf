  swap(first: &content_out.content_items, second: &styles^.content_items);
  swap(first: &content_out.counter_lists, second: &styles^.counter_lists);
  swap(first: &content_out.counter_changes, second: &styles^.counter_changes);
  swap(first: &content_out.quote_lists, second: &styles^.quote_lists);
  swap(first: &content_out.quote_pairs, second: &styles^.quote_pairs);
  swap(first: &content_out.text, second: &styles^.generated_text);
  set styles^.custom_sets = styles^.custom_sets +sat added_sets;
  for (k in 0_u64..count) {
    let raw_set = cvt::<u32, u64>(sets^[k]);
    let custom = if raw_set < styles^.kept.custom_canon.inner.len {
      give styles^.kept.custom_canon.inner[raw_set];
    } else {
      give 0_u32;
    }
    set out^[k] = ComputedStyle(box: box_ids.inner[k], size: size_ids.inner[k], spacing: spacing_ids.inner[k], border: border_ids.inner[k], font: font_ids.inner[k], text: text_ids.inner[k], background: background_ids.inner[k], custom: custom, container: container_ids.inner[k], item: item_ids.inner[k], table: table_ids.inner[k], content: content_ids.inner[k]);
  }
  return Ok<unit, StyleError>(value: unit);
}

fn compute_styles(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Styles, StyleError> reads(store), reads(document), reads(traversal), writes(atoms) {
  doc "The four steps in turn.";
  let cascade = propagate match_elements(store: store, document: document, atoms: atoms, traversal: traversal);
  let inherited = propagate inherited_pass(store: store, cascade: &cascade, document: document, atoms: atoms, traversal: traversal, environment: environment);
  let resets = propagate reset_pass(store: store, cascade: &cascade, inherited: &inherited, atoms: atoms, traversal: traversal, environment: environment);
  let styles = propagate intern_styles(inherited: &inherited, resets: &resets, traversal: traversal);
  return Ok<Styles, StyleError>(value: move styles);
}

fn set_range(inherited: &Inherited, set_id: u64) -> (first: u64, end: u64) reads(inherited) contract {
  ensures first <= end;
  ensures end <= inherited^.custom_entries.inner.len;
} {
  doc "The custom_entry range of custom-property set set_id, empty for an unknown set.";
  let known = set_id < inherited^.custom_sets.inner.len;
  if known {
  } else {
    return 0_u64, 0_u64;
  }
  let first = cvt::<u32, u64>(inherited^.custom_sets.inner[set_id].first);
  let end = cvt::<u32, u64>(inherited^.custom_sets.inner[set_id].end);
  let ordered = first <= end;
  let inside = end <= inherited^.custom_entries.inner.len;
  let usable = band(ordered, inside);
  if usable {
    return first, end;
  }
  return 0_u64, 0_u64;
}

fn entry_text(inherited: &Inherited, custom_entry: CustomEntry) -> (start: u64, end: u64) reads(inherited) contract {
  ensures start <= end;
  ensures end <= inherited^.custom_text.inner.len;
} {
  doc "The text range of a custom-property custom_entry, empty when it lies outside the text.";
  let start = cvt::<u32, u64>(custom_entry.start);
  let end = cvt::<u32, u64>(custom_entry.end);
  let ordered = start <= end;
  let inside = end <= inherited^.custom_text.inner.len;
  let usable = band(ordered, inside);
  if usable {
    return start, end;
  }
  return 0_u64, 0_u64;
}

fn hash_set(inherited: &Inherited, set_id: u64) -> hash: u64 reads(inherited) {
  doc "Mixes every custom_entry's name and text of a custom-property set, in order.";
  let (first, end) = set_range(inherited: inherited, set_id: set_id);
  let acc = 14695981039346656037_u64;
  for (k in first..end) {
    let custom_entry = inherited^.custom_entries.inner[k];
    let name = cvt::<u32, u64>(custom_entry.name.index);
    set acc = mix(hash: acc, value: name);
    let (a, b) = entry_text(inherited: inherited, custom_entry: custom_entry);
    for (t in a..b) {
      let byte = cvt::<u8, u64>(inherited^.custom_text.inner[t]);
      set acc = mix(hash: acc, value: byte);
    }
  }
  return acc;
}

fn same_sets(inherited: &Inherited, first_set: u64, second_set: u64) -> same: Bool reads(inherited) {
  doc "True when two custom-property sets hold the same names with the same texts in the same order.";
  let (a_first, a_end) = set_range(inherited: inherited, set_id: first_set);
  let (b_first, b_end) = set_range(inherited: inherited, set_id: second_set);
  let a_count = a_end - a_first;
  let b_count = b_end - b_first;
  if a_count != b_count {
    return False();
  }
  for (k in 0_u64..a_count) {
    let a_at = a_first +sat k;
    let b_at = b_first +sat k;
    let a_inside = a_at < inherited^.custom_entries.inner.len;
    let b_inside = b_at < inherited^.custom_entries.inner.len;
    let inside = band(a_inside, b_inside);
    if inside {
    } else {
      return False();
    }
    let a_entry = inherited^.custom_entries.inner[a_at];
    let b_entry = inherited^.custom_entries.inner[b_at];
    if a_entry.name.index != b_entry.name.index {
      return False();
    }
    let (a_start, a_stop) = entry_text(inherited: inherited, custom_entry: a_entry);
    let (b_start, b_stop) = entry_text(inherited: inherited, custom_entry: b_entry);
    let a_size = a_stop - a_start;
    let b_size = b_stop - b_start;
    if a_size != b_size {
      return False();
    }
    for (t in 0_u64..a_size) {
      let a_byte_at = a_start +sat t;
      let b_byte_at = b_start +sat t;
      let a_byte_in = a_byte_at < inherited^.custom_text.inner.len;
      let b_byte_in = b_byte_at < inherited^.custom_text.inner.len;
      let bytes_in = band(a_byte_in, b_byte_in);
      if bytes_in {
        if inherited^.custom_text.inner[a_byte_at] != inherited^.custom_text.inner[b_byte_at] {
          return False();
        }
      }
    }
  }
  return True();
}

fn canon_sets(canon: &Box<Slots<u32>>, index: &Box<Array<u32>>, inherited: &Inherited) -> distinct: u64 reads(inherited), writes(canon), writes(index) {
  doc "Gives every custom-property set of inherited that canon does not cover yet the identifier of the first set with the same entries, appended to canon, and returns how many of them are new; index holds the open-addressing slots of the distinct sets, kept with canon, and grows to twice the sets it can then hold, placing every distinct set again. The inherited pass only appends sets, so a set keeps its identifier across restyles.";
  let held = canon^.inner.len;
  let count = inherited^.custom_sets.inner.len;
  let small = count <= 1073741824_u64;
  let ordered = held <= count;
  let usable = band(small, ordered);
  if usable {
  } else {
    return 0_u64;
  }
  let capacity = 16_u64;
  for (step in 0_u64..64_u64) {
    let half = capacity / 2_u64;
    if half >= count {
      break;
    }
    set capacity = capacity *sat 2_u64;
  }
  let fits = capacity <= 4294967296_u64;
  if fits {
  } else {
    return 0_u64;
  }
  if capacity > index^.inner.len {
    let mask = capacity -sat 1_u64;
    let slots = box_array_filled::<u32>(count: capacity, value: 0_u32);
    for (i in 0_u64..held) {
      let own = cvt::<u32, u64>(canon^.inner[i]);
      if own == i {
        let hash = hash_set(inherited: inherited, set_id: i);
        let probe = iand(hash, mask);
        for (step in 0_u64..capacity) {
          let at = iand(probe, mask);
          if at < slots.inner.len {
            if slots.inner[at] == 0_u32 {
              let one_based = i +sat 1_u64;
              set slots.inner[at] = cvt.wrap::<u64, u32>(one_based);
              break;
            }
          }
          set probe = at +wrap 1_u64;
        }
      }
    }
    set index^ = move slots;
  }
  let size = index^.inner.len;
  let mask = size -sat 1_u64;
  let distinct = 0_u64;
  for (i in held..count) {
    let hash = hash_set(inherited: inherited, set_id: i);
    let probe = iand(hash, mask);
    let found = cvt.wrap::<u64, u32>(i);
    for (step in 0_u64..size) {
      let at = iand(probe, mask);
      let inside = at < index^.inner.len;
      if inside {
      } else {
        break;
      }
      let slot = index^.inner[at];
      if slot == 0_u32 {
        let one_based = i +sat 1_u64;
        set index^.inner[at] = cvt.wrap::<u64, u32>(one_based);
        set distinct = distinct +sat 1_u64;
        break;
      }
      let other = cvt::<u32, u64>(slot);
      let other_set = other -sat 1_u64;
      let same = same_sets(inherited: inherited, first_set: other_set, second_set: i);
      if same {
        set found = cvt.wrap::<u64, u32>(other_set);
        break;
      }
      set probe = at +wrap 1_u64;
    }
    append_group::<u32>(cell: canon, value: found);
  }
  return distinct;
}
