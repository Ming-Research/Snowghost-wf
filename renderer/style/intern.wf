fn hash_sizing(hash: u64, value: Sizing) -> next: u64 pure {
  doc "Mixes every field of a Sizing into hash.";
  let acc = hash;
  let w_kind = cvt::<u8, u64>(value.kind);
  set acc = mix(hash: acc, value: w_kind);
  let w_keyword = cvt::<u8, u64>(value.keyword);
  set acc = mix(hash: acc, value: w_keyword);
  set acc = hash_lp(hash: acc, value: value.value);
  return acc;
}

fn same_sizing(first: Sizing, second: Sizing) -> same: Bool pure {
  doc "True when every field of the two Sizing values is equal.";
  if first.kind != second.kind {
    return False();
  }
  if first.keyword != second.keyword {
    return False();
  }
  let equal_value = same_lp(first: first.value, second: second.value);
  if equal_value {
  } else {
    return False();
  }
  return True();
}

