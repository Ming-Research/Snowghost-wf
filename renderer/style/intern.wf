fn hash_color_ref(hash: u64, value: ColorRef) -> next: u64 pure {
  doc "Mixes every field of a ColorRef into hash.";
  let acc = hash;
  let w_current = bool_word(value: value.current);
  set acc = mix(hash: acc, value: w_current);
  set acc = hash_color(hash: acc, value: value.color);
  return acc;
}

fn same_color_ref(first: ColorRef, second: ColorRef) -> same: Bool pure {
  doc "True when every field of the two ColorRef values is equal.";
  let equal_current = first.current == second.current;
  if equal_current {
  } else {
    return False();
  }
  let equal_color = same_color(first: first.color, second: second.color);
  if equal_color {
  } else {
    return False();
  }
  return True();
}

fn hash_color(hash: u64, value: Color) -> next: u64 pure {
  doc "Mixes every field of a Color into hash.";
  let acc = hash;
  let w_space = space_word(space: value.space);
  set acc = mix(hash: acc, value: w_space);
  let w_first = float_word(value: value.first);
  set acc = mix(hash: acc, value: w_first);
  let w_second = float_word(value: value.second);
  set acc = mix(hash: acc, value: w_second);
  let w_third = float_word(value: value.third);
  set acc = mix(hash: acc, value: w_third);
  let w_alpha = float_word(value: value.alpha);
  set acc = mix(hash: acc, value: w_alpha);
  let w_missing = cvt::<u8, u64>(value.missing);
  set acc = mix(hash: acc, value: w_missing);
  return acc;
}

fn same_color(first: Color, second: Color) -> same: Bool pure {
  doc "True when every field of the two Color values is equal.";
  let first_space = space_word(space: first.space);
  let second_space = space_word(space: second.space);
  if first_space != second_space {
    return False();
  }
  let equal_first = feq(first.first, second.first);
  if equal_first {
  } else {
    return False();
  }
  let equal_second = feq(first.second, second.second);
  if equal_second {
  } else {
    return False();
  }
  let equal_third = feq(first.third, second.third);
  if equal_third {
  } else {
    return False();
  }
  let equal_alpha = feq(first.alpha, second.alpha);
  if equal_alpha {
  } else {
    return False();
  }
  if first.missing != second.missing {
    return False();
  }
  return True();
}

fn index_box_group(table: &Box<Slots<BoxGroup>>, index: &Box<Array<u32>>, more: u64) -> result: unit reads(table), writes(index) {
  doc "Makes index, the open-addressing slots of table's values, a power of two at least twice the values table will hold after more, placing every value again when it grows; identifiers are positions in table and do not change.";
  let held = table^.inner.len;
  let total = held +sat more;
  let capacity = 16_u64;
  for (step in 0_u64..64_u64) {
    let half = capacity / 2_u64;
    if half >= total {
      break;
    }
    set capacity = capacity *sat 2_u64;
  }
  let fits = capacity <= 4294967296_u64;
  if fits {
  } else {
    return unit;
  }
  if capacity <= index^.inner.len {
    return unit;
  }
  let mask = capacity -sat 1_u64;
  let slots = box_array_filled::<u32>(count: capacity, value: 0_u32);
  for (e in 0_u64..held) {
    let hash = hash_box_group(hash: 14695981039346656037_u64, value: table^.inner[e]);
    let probe = iand(hash, mask);
    for (step in 0_u64..capacity) {
      let at = iand(probe, mask);
      if at < slots.inner.len {
        if slots.inner[at] == 0_u32 {
          let one_based = e +sat 1_u64;
          set slots.inner[at] = cvt.wrap::<u64, u32>(one_based);
          break;
        }
      }
      set probe = at +wrap 1_u64;
    }
  }
  set index^ = move slots;
  return unit;
}

fn intern_box_group(table: &Box<Slots<BoxGroup>>, index: &Box<Array<u32>>, values: &[BoxGroup], ids: &[u32]) -> result: unit reads(values), writes(table), writes(index), writes(ids) {
  doc "Interns values in order into table, kept across style runs, writing each value's identifier, the index of the first equal value in table, to ids; index holds table's open-addressing slots and is grown first (index_box_group) to at least twice the values the table can then hold. A full build interns every element into an empty table; a restyle interns only the restyled ones, appending what is new. Writes nothing when ids is not as long as values or values passes 2^30.";
  let count = values^.len;
  let equal_count = ids^.len == count;
  let small = count <= 1073741824_u64;
  let usable = band(equal_count, small);
  if usable {
  } else {
    return unit;
  }
  index_box_group(table: table, index: index, more: count);
  let capacity = index^.inner.len;
  let mask = capacity -sat 1_u64;
  for (i in 0_u64..count) {
    let value = values^[i];
    let hash = hash_box_group(hash: 14695981039346656037_u64, value: value);
    let probe = iand(hash, mask);
    let found = 0_u32;
    for (step in 0_u64..capacity) {
      let at = iand(probe, mask);
      let inside = at < index^.inner.len;
      if inside {
      } else {
        break;
      }
      let held = index^.inner[at];
      if held == 0_u32 {
        let id = table^.inner.len;
        append_group::<BoxGroup>(cell: table, value: value);
        let one_based = id +sat 1_u64;
        let narrowed = cvt.wrap::<u64, u32>(one_based);
        set index^.inner[at] = narrowed;
        set found = narrowed;
        break;
      }
      let position = cvt::<u32, u64>(held);
      let item = position -sat 1_u64;
      let listed = item < table^.inner.len;
      if listed {
        let same = same_box_group(first: table^.inner[item], second: value);
        if same {
          set found = held;
          break;
        }
      }
      set probe = at +wrap 1_u64;
    }
    let id = found -sat 1_u32;
    set ids^[i] = id;
  }
  return unit;
}

