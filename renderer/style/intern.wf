  } else {
    let made = initial_text(state: inherited);
    give made;
  }
  let texts = box_array_filled::<TextGroup>(count: count, value: first_text);
  for (k in 0_u64..count) {
    let text = inherited^.texts.inner[k];
    let made = TextGroup(color: text.color, text_align: text.text_align, text_indent: text.text_indent, text_transform: text.text_transform, white_space: text.white_space, letter_spacing: text.letter_spacing, word_spacing: text.word_spacing, vertical_align: resets^.vertical_aligns.inner[k], decoration_line: resets^.decorations.inner[k], list_style_type: text.list_style_type, overflow_wrap: text.overflow_wrap, word_break: text.word_break);
