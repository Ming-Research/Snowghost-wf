  if first.bottom_style != second.bottom_style {
    return False();
  }
  if first.left_style != second.left_style {
    return False();
  }
  let equal_top_color = same_color_ref(first: first.top_color, second: second.top_color);
  if equal_top_color {
  } else {
    return False();
  }
  let equal_right_color = same_color_ref(first: first.right_color, second: second.right_color);
  if equal_right_color {
  } else {
    return False();
  }
  let equal_bottom_color = same_color_ref(first: first.bottom_color, second: second.bottom_color);
  if equal_bottom_color {
  } else {
    return False();
  }
  let equal_left_color = same_color_ref(first: first.left_color, second: second.left_color);
  if equal_left_color {
  } else {
    return False();
  }
  return True();
}

fn hash_font_group(hash: u64, value: FontGroup) -> next: u64 pure {
  doc "Mixes every field of a FontGroup into hash.";
  let acc = hash;
  let w_families_start = cvt::<u32, u64>(value.families_start);
  set acc = mix(hash: acc, value: w_families_start);
  let w_families_end = cvt::<u32, u64>(value.families_end);
  set acc = mix(hash: acc, value: w_families_end);
  let w_size = float_word(value: value.size);
  set acc = mix(hash: acc, value: w_size);
  let w_weight = float_word(value: value.weight);
  set acc = mix(hash: acc, value: w_weight);
  let w_style = cvt::<u8, u64>(value.style);
  set acc = mix(hash: acc, value: w_style);
  set acc = hash_sizing(hash: acc, value: value.line_height);
  return acc;
}

