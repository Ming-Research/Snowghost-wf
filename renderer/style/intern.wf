fn intern_background_group(table: &Box<Slots<BackgroundGroup>>, index: &Box<Array<u32>>, values: &[BackgroundGroup], ids: &[u32]) -> result: unit reads(values), writes(table), writes(index), writes(ids) {
  doc "Interns values in order into table, kept across style runs, writing each value's identifier, the index of the first equal value in table, to ids; index holds table's open-addressing slots and is grown first (index_background_group) to at least twice the values the table can then hold. A full build interns every element into an empty table; a restyle interns only the restyled ones, appending what is new. Writes nothing when ids is not as long as values or values passes 2^30.";
  let count = values^.len;
  let equal_count = ids^.len == count;
  let small = count <= 1073741824_u64;
  let usable = band(equal_count, small);
  if usable {
  } else {
    return unit;
  }
  index_background_group(table: table, index: index, more: count);
  let capacity = index^.inner.len;
  let mask = capacity -sat 1_u64;
  for (i in 0_u64..count) {
    let value = values^[i];
    let hash = hash_background_group(hash: 14695981039346656037_u64, value: value);
    let probe = iand(hash, mask);
    let found = 0_u32;
    for (step in 0_u64..capacity) {
      let at = iand(probe, mask);
      let inside = at < index^.inner.len;
      if inside {
      } else {
        break;
      }
      let held = index^.inner[at];
      if held == 0_u32 {
        let id = table^.inner.len;
        append_group::<BackgroundGroup>(cell: table, value: value);
        let one_based = id +sat 1_u64;
        let narrowed = cvt.wrap::<u64, u32>(one_based);
        set index^.inner[at] = narrowed;
        set found = narrowed;
        break;
      }
      let position = cvt::<u32, u64>(held);
      let item = position -sat 1_u64;
      let listed = item < table^.inner.len;
      if listed {
        let same = same_background_group(first: table^.inner[item], second: value);
        if same {
          set found = held;
          break;
        }
      }
      set probe = at +wrap 1_u64;
    }
    let id = found -sat 1_u32;
    set ids^[i] = id;
  }
  return unit;
}

