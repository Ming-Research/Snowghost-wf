  let equal_padding_top = same_lp(first: first.padding_top, second: second.padding_top);
  if equal_padding_top {
  } else {
    return False();
  }
  let equal_padding_right = same_lp(first: first.padding_right, second: second.padding_right);
  if equal_padding_right {
  } else {
    return False();
  }
  let equal_padding_bottom = same_lp(first: first.padding_bottom, second: second.padding_bottom);
  if equal_padding_bottom {
  } else {
    return False();
  }
  let equal_padding_left = same_lp(first: first.padding_left, second: second.padding_left);
  if equal_padding_left {
  } else {
    return False();
  }
