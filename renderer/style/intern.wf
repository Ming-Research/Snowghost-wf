  let sizes_listed = resets^.sizes.inner.len == count;
  let spacings_listed = resets^.spacings.inner.len == count;
  let borders_listed = resets^.borders.inner.len == count;
  let backgrounds_listed = resets^.backgrounds.inner.len == count;
