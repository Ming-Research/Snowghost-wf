fn hash_text_group(hash: u64, value: TextGroup) -> next: u64 pure {
  doc "Mixes every field of a TextGroup into hash.";
  let acc = hash;
  set acc = hash_color(hash: acc, value: value.color);
  let w_text_align = cvt::<u8, u64>(value.text_align);
  set acc = mix(hash: acc, value: w_text_align);
  set acc = hash_lp(hash: acc, value: value.text_indent);
  let w_text_transform = cvt::<u8, u64>(value.text_transform);
  set acc = mix(hash: acc, value: w_text_transform);
  let w_white_space = cvt::<u8, u64>(value.white_space);
  set acc = mix(hash: acc, value: w_white_space);
  set acc = hash_sizing(hash: acc, value: value.letter_spacing);
  set acc = hash_sizing(hash: acc, value: value.word_spacing);
  set acc = hash_sizing(hash: acc, value: value.vertical_align);
  let w_decoration_line = cvt::<u8, u64>(value.decoration_line);
  set acc = mix(hash: acc, value: w_decoration_line);
  let w_list_style_type = cvt::<u32, u64>(value.list_style_type.index);
  set acc = mix(hash: acc, value: w_list_style_type);
  return acc;
}

fn same_text_group(first: TextGroup, second: TextGroup) -> same: Bool pure {
  doc "True when every field of the two TextGroup values is equal.";
  let equal_color = same_color(first: first.color, second: second.color);
  if equal_color {
  } else {
    return False();
  }
  if first.text_align != second.text_align {
    return False();
  }
  let equal_text_indent = same_lp(first: first.text_indent, second: second.text_indent);
  if equal_text_indent {
  } else {
    return False();
  }
  if first.text_transform != second.text_transform {
    return False();
  }
  if first.white_space != second.white_space {
    return False();
  }
  let equal_letter_spacing = same_sizing(first: first.letter_spacing, second: second.letter_spacing);
  if equal_letter_spacing {
  } else {
    return False();
  }
  let equal_word_spacing = same_sizing(first: first.word_spacing, second: second.word_spacing);
  if equal_word_spacing {
  } else {
    return False();
  }
  let equal_vertical_align = same_sizing(first: first.vertical_align, second: second.vertical_align);
  if equal_vertical_align {
  } else {
    return False();
  }
  if first.decoration_line != second.decoration_line {
    return False();
  }
  if first.list_style_type.index != second.list_style_type.index {
    return False();
  }
  return True();
}

