alias AtomTable = pkg::base::atom::AtomTable;
alias FeatureReach = pkg::css::selectors::FeatureReach;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias feature_parent = pkg::css::selectors::feature_parent;
alias feature_children = pkg::css::selectors::feature_children;
alias FeatureFilter = pkg::css::selectors::FeatureFilter;
alias context_filter = pkg::css::selectors::context_filter;
alias filter_admits = pkg::css::selectors::filter_admits;
alias side_earlier = pkg::css::selectors::side_earlier;
alias side_previous = pkg::css::selectors::side_previous;
alias side_next = pkg::css::selectors::side_next;
alias side_later = pkg::css::selectors::side_later;
alias SubjectKey = pkg::css::selectors::SubjectKey;
alias TextSpan = pkg::dom::TextSpan;
alias atom_class = pkg::base::static_atoms::atom_class;
alias atom_id = pkg::base::static_atoms::atom_id;
alias name_hash = pkg::css::selectors::name_hash;
alias feature_class = pkg::css::selectors::feature_class;
alias reach_all = pkg::css::selectors::reach_all;
alias reach_descendants = pkg::css::selectors::reach_descendants;
alias reach_self = pkg::css::selectors::reach_self;
alias reach_sibling_descendants = pkg::css::selectors::reach_sibling_descendants;
alias reach_siblings = pkg::css::selectors::reach_siblings;

const key_ceiling: u64 = 4194304_u64;

struct Reached {
  doc "The union of the reaches a class change meets: whether node itself is reached and whether every element is, and for descendants, later siblings and their descendants the subject keys an element must carry, with a flag for a key every element carries.";
  full: Bool;
  pseudos: Bool;
  self_reached: Bool;
  down_any: Bool;
  down: Box<Slots<SubjectKey>>;
  across_any: Bool;
  across: Box<Slots<SubjectKey>>;
  beyond_any: Bool;
  beyond: Box<Slots<SubjectKey>>;
}

struct ElementKeys {
  doc "What a subject key tests on one element: the name_hash of its local name and of its first id attribute value (has_id when it has one), and its first class attribute value's span.";
  local: u64;
  has_id: Bool;
  id: u64;
  classes: TextSpan;
}

fn is_anything(key: SubjectKey) -> anything: Bool pure {
  doc "Whether key is Anything, which every element carries.";
  match key {
    Anything() => {
      return True();
    }
    Nothing() => {
      return False();
    }
    Id(..) => {
      return False();
    }
    Class(..) => {
      return False();
    }
    Type(..) => {
      return False();
    }
  }
}

const reach_low_mask: u64 = 1023_u64;

const reach_bucket_count: u64 = 1026_u64;

const structural_bucket: u64 = 1025_u64;

fn reach_bucket(reach: FeatureReach) -> bucket: u64 pure {
  doc "The bucket order_reaches files a reach under: 0 for a class reach that holds for every class, one more than its hash's low ten bits for another class reach, and structural_bucket, the last, for a structural one.";
  if reach.feature != feature_class {
    return structural_bucket;
  }
  if reach.every {
    return 0_u64;
  }
  let low = iand(reach.hash, reach_low_mask);
  let bucket = low + 1_u64;
  return bucket;
}

fn order_reaches(store: &RuleStore) -> result: unit writes(store) {
  doc "Reorders the store's reaches by reach_bucket, a stable counting sort, so gather_reaches finds a class's reaches by binary search.";
  let count = store^.reaches.inner.len;
  if count < 2_u64 {
    return unit;
  }
  let slots = reach_bucket_count + 1_u64;
  let starts = box_array_filled::<u64>(count: slots, value: 0_u64);
  for (r in 0_u64..count) {
    let bucket = reach_bucket(reach: store^.reaches.inner[r]);
    let next = bucket +sat 1_u64;
    if next < starts.inner.len {
      set starts.inner[next] = starts.inner[next] +wrap 1_u64;
    }
  }
  for (b in 0_u64..reach_bucket_count) {
    let next = b + 1_u64;
    if next < starts.inner.len {
      set starts.inner[next] = starts.inner[next] +wrap starts.inner[b];
    }
  }
  let first = store^.reaches.inner[0_u64];
  let ordered = box_array_filled::<FeatureReach>(count: count, value: first);
  for (r in 0_u64..count) {
    let reach = store^.reaches.inner[r];
    let bucket = reach_bucket(reach: reach);
    if bucket < starts.inner.len {
      let slot = starts.inner[bucket];
      if slot < count {
        set ordered.inner[slot] = reach;
        set starts.inner[bucket] = slot + 1_u64;
      }
    }
  }
  for (r in 0_u64..count) {
    if r < store^.reaches.inner.len {
      set store^.reaches.inner[r] = ordered.inner[r];
    }
  }
  return unit;
}

fn take_reach(gathered: &Reached, reach: FeatureReach) -> result: Result<unit, StyleError> writes(gathered) {
  doc "Adds one reach to gathered.";
  if reach.generated {
    set gathered^.pseudos = True();
  }
  let all_bit = iand(reach.reach, reach_all);
  if all_bit != 0_u8 {
    set gathered^.full = True();
  }
  let self_bit = iand(reach.reach, reach_self);
  if self_bit != 0_u8 {
    set gathered^.self_reached = True();
  }
  let any_key = is_anything(key: reach.subject);
  let down_bit = iand(reach.reach, reach_descendants);
  if down_bit != 0_u8 {
    if any_key {
      set gathered^.down_any = True();
    } else {
      let pushed = propagate push::<SubjectKey>(cell: &gathered^.down, value: reach.subject, ceiling: key_ceiling);
    }
  }
  let across_bit = iand(reach.reach, reach_siblings);
  if across_bit != 0_u8 {
    if any_key {
      set gathered^.across_any = True();
    } else {
      let pushed = propagate push::<SubjectKey>(cell: &gathered^.across, value: reach.subject, ceiling: key_ceiling);
    }
  }
  let beyond_bit = iand(reach.reach, reach_sibling_descendants);
  if beyond_bit != 0_u8 {
    if any_key {
      set gathered^.beyond_any = True();
    } else {
      let pushed = propagate push::<SubjectKey>(cell: &gathered^.beyond, value: reach.subject, ceiling: key_ceiling);
    }
  }
  return Ok<unit, StyleError>(value: unit);
}

fn gather_reaches(store: &RuleStore, hash: u64) -> result: Result<Reached, StyleError> reads(store) {
  doc "Collects the reaches of the store whose class hash is hash or that hold for every class: the leading run of bucket 0, and the run of hash's bucket, found by binary search in the order order_reaches left.";
  let no = False();
  let down = box_slots_new::<SubjectKey>(capacity: 0_u64);
  let across = box_slots_new::<SubjectKey>(capacity: 0_u64);
  let beyond = box_slots_new::<SubjectKey>(capacity: 0_u64);
  let incomplete = bnot(store^.reaches_complete);
  let gathered = Reached(full: incomplete, pseudos: no, self_reached: no, down_any: no, down: move down, across_any: no, across: move across, beyond_any: no, beyond: move beyond);
  let count = store^.reaches.inner.len;
  for (r in 0_u64..count) {
    let reach = store^.reaches.inner[r];
    if reach.every {
      let taken = propagate take_reach(gathered: &gathered, reach: reach);
    } else {
      break;
    }
  }
  let low = iand(hash, reach_low_mask);
  let wanted = low + 1_u64;
  let from = 0_u64;
  let to = count;
  for (step in 0_u64..64_u64) {
    if from >= to {
      break;
    }
    let width = to - from;
    let half = width / 2_u64;
    let middle = from + half;
    if middle < count {
      let bucket = reach_bucket(reach: store^.reaches.inner[middle]);
      if bucket < wanted {
        set from = middle + 1_u64;
      } else {
        set to = middle;
      }
    } else {
      break;
    }
  }
  for (r in from..count) {
    let reach = store^.reaches.inner[r];
    let bucket = reach_bucket(reach: reach);
    if bucket != wanted {
      break;
    }
    if reach.hash == hash {
      let taken = propagate take_reach(gathered: &gathered, reach: reach);
    }
  }
  return Ok<Reached, StyleError>(value: move gathered);
}

fn span_hash(document: &Document, span: TextSpan) -> hash: u64 reads(document) {
  doc "name_hash of the document text span holds, 0 for a span outside the text.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let ordered = start <= end;
  let inside = end <= document^.text.inner.len;
  let usable = band(ordered, inside);
  if usable {
    let hash = name_hash(bytes: &document^.text.inner[start..end]);
    return hash;
  }
  return 0_u64;
}

fn element_keys(document: &Document, atoms: &AtomTable, node: NodeId) -> keys: ElementKeys reads(document), reads(atoms) {
  doc "The local name, first id and first class attribute of node, as the rule index reads them (match_indexed).";
  let empty = TextSpan(start: 0_u32, end: 0_u32);
  let none = False();
  let found = ElementKeys(local: 0_u64, has_id: none, id: 0_u64, classes: empty);
  let at = cvt::<u32, u64>(node.index);
  let known = at < document^.nodes.inner.len;
  if known {
  } else {
    return found;
  }
  let data = &document^.nodes.inner[at].data;
  match data^ {
    Element(namespace: space, local_name: name, attributes: attrs, template_contents: contents) => {
      let local_index = cvt::<u32, u64>(name^.index);
      let named = local_index < atoms^.spans.inner.len;
      if named {
        let span = atoms^.spans.inner[local_index];
        let start = cvt::<u32, u64>(span.start);
        let end = cvt::<u32, u64>(span.end);
        let ordered = start <= end;
        let inside = end <= atoms^.text.inner.len;
        let usable = band(ordered, inside);
        if usable {
          set found.local = name_hash(bytes: &atoms^.text.inner[start..end]);
        }
      }
      let count = attrs^.inner.len;
      let seen_class = False();
      for (k in 0_u64..count) {
        let attribute = attrs^.inner[k];
        let plain = match attribute.namespace {
          NoNamespace() => {
            give True();
          }
          XLink() => {
            give False();
          }
          Xml() => {
            give False();
          }
          XmlNs() => {
            give False();
          }
        }
        if plain {
          let is_id = attribute.name.index == atom_id;
          let fresh_id = bnot(found.has_id);
          let first_id = band(is_id, fresh_id);
          if first_id {
            set found.has_id = True();
            set found.id = span_hash(document: document, span: attribute.value);
          }
          let is_class = attribute.name.index == atom_class;
          let fresh_class = bnot(seen_class);
          let first_class = band(is_class, fresh_class);
          if first_class {
            set seen_class = True();
            set found.classes = attribute.value;
          }
        }
      }
    }
    DocumentRoot(..) => {
    }
    DocumentType(..) => {
    }
    Text(..) => {
    }
    Comment(..) => {
    }
    Fragment() => {
    }
  }
  return found;
}

fn has_class_word(document: &Document, span: TextSpan, hash: u64) -> found: Bool reads(document) {
  doc "Whether some whitespace-separated word of the class value span holds has name_hash hash.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let ordered = start <= end;
  let inside = end <= document^.text.inner.len;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return False();
  }
  let word_start = start;
  let in_word = False();
  for (at in start..end) {
    let space = is_class_space(byte: document^.text.inner[at]);
    if space {
      let started = word_start <= at;
      let closes = band(in_word, started);
      if closes {
        let word = name_hash(bytes: &document^.text.inner[word_start..at]);
        if word == hash {
          return True();
        }
      }
      set in_word = False();
    } else if in_word {
    } else {
      set word_start = at;
      set in_word = True();
    }
  }
  if in_word {
    let ends = word_start <= end;
    if ends {
      let word = name_hash(bytes: &document^.text.inner[word_start..end]);
      if word == hash {
        return True();
      }
    }
  }
  return False();
}

fn carries(document: &Document, keys: ElementKeys, any: Bool, wanted: &Box<Slots<SubjectKey>>) -> found: Bool reads(document), reads(wanted) {
  doc "Whether an element with keys carries one of the wanted subject keys, or any is set.";
  if any {
    return True();
  }
  let count = wanted^.inner.len;
  for (k in 0_u64..count) {
    let key = wanted^.inner[k];
    match key {
      Anything() => {
        return True();
      }
      Nothing() => {
      }
      Id(hash: value) => {
        let same = value == keys.id;
        let holds = band(keys.has_id, same);
        if holds {
          return True();
        }
      }
      Class(hash: value) => {
        let holds = has_class_word(document: document, span: keys.classes, hash: value);
        if holds {
          return True();
        }
      }
      Type(hash: value) => {
        if value == keys.local {
          return True();
        }
      }
    }
  }
  return False();
}

fn class_restyle(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, node: NodeId, class: &[u8]) -> result: Result<RestyleSet, StyleError> reads(store), reads(document), reads(atoms), reads(traversal), reads(class) {
  doc "Gathers the reaches of class, then marks node, the reached elements of its subtree and those after it under its parent in one flag per element of the range, each flag written by its own element, and lists the marked ones in preorder.";
  let elements = box_slots_new::<u32>(capacity: 0_u64);
  let hash = name_hash(bytes: class);
  let reached = propagate gather_reaches(store: store, hash: hash);
  let count = traversal^.elements.inner.len;
  let listed = traversal^.depths.inner.len == count;
  let index = cvt::<u32, u64>(node.index);
  let known = index < traversal^.order.inner.len;
  let position = if known {
    give cvt::<u32, u64>(traversal^.order.inner[index]);
  } else {
    give count;
  }
  let element = position < count;
  let usable = band(listed, element);
  let bounded = count <= 4294967295_u64;
  let fine = band(usable, bounded);
  let whole = bnot(fine);
  let full = bor(reached.full, whole);
  if full {
    let everything = True();
    let made = RestyleSet(full: everything, elements: move elements, pseudos: everything, edited: node);
    return Ok<RestyleSet, StyleError>(value: move made);
  }
  let depth = traversal^.depths.inner[position];
  let subtree_end = count;
  let next = position + 1_u64;
  for (i in next..count) {
    if traversal^.depths.inner[i] <= depth {
      set subtree_end = i;
      break;
    }
  }
  let parent_end = count;
  for (i in subtree_end..count) {
    if traversal^.depths.inner[i] < depth {
      set parent_end = i;
      break;
    }
  }
  let down_keyed = reached.down.inner.len > 0_u64;
  let down = bor(reached.down_any, down_keyed);
  let across_keyed = reached.across.inner.len > 0_u64;
  let across_some = bor(reached.across_any, across_keyed);
  let beyond_keyed = reached.beyond.inner.len > 0_u64;
  let beyond_some = bor(reached.beyond_any, beyond_keyed);
  let sideways = bor(across_some, beyond_some);
  let range_end = if sideways {
    give parent_end;
  } else if down {
    give subtree_end;
  } else {
    give next;
  }
  let span = range_end - position;
  let unmarked = False();
  let span_bounded = span <= 4294967296_u64;
  if span_bounded {
  } else {
    let everything_else = True();
    let made = RestyleSet(full: everything_else, elements: move elements, pseudos: everything_else, edited: node);
    return Ok<RestyleSet, StyleError>(value: move made);
  }
  let marks = box_array_filled::<Bool>(count: span, value: unmarked);
  set marks.inner[0_u64] = reached.self_reached;
  for (k in 1_u64..span) {
    let i = position + k;
    let inside = i < count;
    if inside {
      let keys = element_keys(document: document, atoms: atoms, node: traversal^.elements.inner[i]);
      let in_subtree = i < subtree_end;
      if in_subtree {
        if down {
          set marks.inner[k] = carries(document: document, keys: keys, any: reached.down_any, wanted: &reached.down);
        }
      } else {
        let sibling = traversal^.depths.inner[i] == depth;
        if sibling {
          set marks.inner[k] = carries(document: document, keys: keys, any: reached.across_any, wanted: &reached.across);
        } else {
          set marks.inner[k] = carries(document: document, keys: keys, any: reached.beyond_any, wanted: &reached.beyond);
        }
      }
    }
  }
  for (k in 0_u64..span) {
    if marks.inner[k] {
      let i = position + k;
      let narrowed = cvt.wrap::<u64, u32>(i);
      let pushed = propagate push::<u32>(cell: &elements, value: narrowed, ceiling: 4294967296_u64);
    }
  }
  let partial = False();
  let made = RestyleSet(full: partial, elements: move elements, pseudos: reached.pseudos, edited: node);
  return Ok<RestyleSet, StyleError>(value: move made);
}

fn winners_differ(old: &Cascade, new: &Cascade, old_node: u64, new_node: u64) -> differ: Bool reads(old), reads(new) {
  doc "Whether the styled node old_node of old and new_node of new have different winners or different custom-rule keys; a row outside either cascade counts as different.";
  let old_first = winner_words *sat old_node;
  let new_first = winner_words *sat new_node;
  for (w in 0_u64..winner_words) {
    let a = old_first +sat w;
    let b = new_first +sat w;
    let a_in = a < old^.winners.inner.len;
    let b_in = b < new^.winners.inner.len;
    let both = band(a_in, b_in);
    if both {
      if old^.winners.inner[a] != new^.winners.inner[b] {
        return True();
      }
    } else {
      return True();
    }
  }
  let words = old^.custom_count;
  if words != new^.custom_count {
    return True();
  }
  let old_bits = words *sat old_node;
  let new_bits = words *sat new_node;
  for (w in 0_u64..words) {
    let a = old_bits +sat w;
    let b = new_bits +sat w;
    let a_in = a < old^.custom_keys.inner.len;
    let b_in = b < new^.custom_keys.inner.len;
    let both = band(a_in, b_in);
    if both {
      if old^.custom_keys.inner[a] != new^.custom_keys.inner[b] {
        return True();
      }
    } else {
      return True();
    }
  }
  return False();
}

fn pseudo_rank(cascade: &Cascade, node: u64) -> rank: u64 reads(cascade) {
  doc "Orders the pseudo-element node of cascade by its element and kind, as match_elements numbers them; the largest u64 past the nodes.";
  let inside = node < cascade^.parents.inner.len;
  let kind_in = node < cascade^.kinds.inner.len;
  let both = band(inside, kind_in);
  if both {
    let element = cvt::<u32, u64>(cascade^.parents.inner[node]);
    let kind = cvt::<u8, u64>(cascade^.kinds.inner[node]);
    let doubled = element *sat 4_u64;
    let rank = doubled +sat kind;
    return rank;
  }
  return 18446744073709551615_u64;
}

fn rematched(old: &Cascade, new: &Cascade) -> changed: Box<Array<Bool>> reads(old), reads(new) {
  doc "One loop over the elements, each comparing its own rows, then one merge in order over both cascades' pseudo-elements, which pairs them by element and kind.";
  let count = old^.element_count;
  let unchanged = False();
  let bounded = count <= 4294967296_u64;
  if bounded {
  } else {
    let refused = box_array_filled::<Bool>(count: 0_u64, value: unchanged);
    return move refused;
  }
  let changed = box_array_filled::<Bool>(count: count, value: unchanged);
  if new^.element_count != count {
    for (i in 0_u64..count) {
      set changed.inner[i] = True();
    }
    return move changed;
  }
  for (i in 0_u64..count) {
    set changed.inner[i] = winners_differ(old: old, new: new, old_node: i, new_node: i);
  }
  let old_nodes = old^.nodes.inner.len;
  let new_nodes = new^.nodes.inner.len;
  let a = count;
  let b = count;
  let steps = old_nodes +sat new_nodes;
  for (step in 0_u64..steps) {
    let a_left = a < old_nodes;
    let b_left = b < new_nodes;
    let any = bor(a_left, b_left);
    if any {
    } else {
      break;
    }
    let a_rank = pseudo_rank(cascade: old, node: a);
    let b_rank = pseudo_rank(cascade: new, node: b);
    if a_rank == b_rank {
      let element = a_rank / 4_u64;
      let differ = winners_differ(old: old, new: new, old_node: a, new_node: b);
      if element < changed.inner.len {
        if differ {
          set changed.inner[element] = True();
        }
      }
      set a = a +sat 1_u64;
      set b = b +sat 1_u64;
    } else if a_rank < b_rank {
      let element = a_rank / 4_u64;
      if element < changed.inner.len {
        set changed.inner[element] = True();
      }
      set a = a +sat 1_u64;
    } else {
      let element = b_rank / 4_u64;
      if element < changed.inner.len {
        set changed.inner[element] = True();
      }
      set b = b +sat 1_u64;
    }
  }
  return move changed;
}

fn is_element_node(document: &Document, node: NodeId) -> element: Bool reads(document) {
  doc "Whether node is an Element node of document.";
  let at = cvt::<u32, u64>(node.index);
  if at < document^.nodes.inner.len {
  } else {
    return False();
  }
  let data = &document^.nodes.inner[at].data;
  match data^ {
    Element(..) => {
      return True();
    }
    DocumentRoot(..) => {
      return False();
    }
    DocumentType(..) => {
      return False();
    }
    Text(..) => {
      return False();
    }
    Comment(..) => {
      return False();
    }
    Fragment() => {
      return False();
    }
  }
}

fn next_within(document: &Document, node: NodeId, root: NodeId) -> next: Option<NodeId> reads(document) {
  doc "The node after node in tree order inside root's subtree, root excluded: node's first child, else the next sibling of node or of its nearest ancestor below root; None past the subtree.";
  match node_links(document: document, node: node) {
    Some(value: links) => {
      match links.first_child {
        Some(value: child) => {
          return Some<NodeId>(value: child);
        }
        None() => {
        }
      }
    }
    None() => {
      return None<NodeId>();
    }
  }
  let count = document^.nodes.inner.len;
  let at = node;
  for (up in 0_u64..count) {
    if at.index == root.index {
      return None<NodeId>();
    }
    match node_links(document: document, node: at) {
      Some(value: links) => {
        match links.next_sibling {
          Some(value: sibling) => {
            return Some<NodeId>(value: sibling);
          }
          None() => {
          }
        }
        match links.parent {
          Some(value: holder) => {
            set at = holder;
          }
          None() => {
            return None<NodeId>();
          }
        }
      }
      None() => {
        return None<NodeId>();
      }
    }
  }
  return None<NodeId>();
}

struct SideKeys {
  doc "The subject keys the structural reaches name for the children at one place around an edit point, for the children themselves or for their descendants; any when a reach there names every element.";
  any: Bool;
  keys: Box<Slots<SubjectKey>>;
}

fn widen_side(side: u8) -> wide: u8 pure {
  doc "The places a reach to later siblings reaches from the children at the places side names: those places and every place after the first of them.";
  let earlier = iand(side, side_earlier);
  if earlier != 0_u8 {
    return 15_u8;
  }
  let previous = iand(side, side_previous);
  if previous != 0_u8 {
    return 14_u8;
  }
  let next = iand(side, side_next);
  if next != 0_u8 {
    return 12_u8;
  }
  return side;
}

fn reach_places(reach: FeatureReach, deep: Bool) -> places: u8 pure {
  doc "The places around an edit point whose children a structural reach makes rematch themselves, or, when deep holds, the elements of their subtrees: its side for its own bits (reach_self, reach_descendants), widened for the bits of later siblings (reach_siblings, reach_sibling_descendants).";
  let own_bit = if deep {
    give reach_descendants;
  } else {
    give reach_self;
  }
  let later_bit = if deep {
    give reach_sibling_descendants;
  } else {
    give reach_siblings;
  }
  let places = 0_u8;
  let own = iand(reach.reach, own_bit);
  if own != 0_u8 {
    set places = ior(places, reach.side);
  }
  let later = iand(reach.reach, later_bit);
  if later != 0_u8 {
    let wide = widen_side(side: reach.side);
    set places = ior(places, wide);
  }
  return places;
}

fn side_keys(store: &RuleStore, from: u64, context: FeatureFilter, place: u8, deep: Bool) -> result: Result<SideKeys, StyleError> reads(store) {
  doc "The keys of the structural reaches from index from on, the children reaches among them whose context the parent's context filter admits, that reach the children at place, or the elements of their subtrees when deep holds.";
  let keys = box_slots_new::<SubjectKey>(capacity: 0_u64);
  let any = False();
  let count = store^.reaches.inner.len;
  for (r in from..count) {
    let reach = store^.reaches.inner[r];
    let applies = filter_admits(filter: context, mask: reach.context);
    let children = reach.feature == feature_children;
    let counted = band(applies, children);
    if counted {
      let places = reach_places(reach: reach, deep: deep);
      let here = iand(places, place);
      if here != 0_u8 {
        let any_key = is_anything(key: reach.subject);
        if any_key {
          set any = True();
        } else {
          let pushed = propagate push::<SubjectKey>(cell: &keys, value: reach.subject, ceiling: key_ceiling);
        }
      }
    }
  }
  let made = SideKeys(any: any, keys: move keys);
  return Ok<SideKeys, StyleError>(value: move made);
}

fn visit_child(document: &Document, atoms: &AtomTable, child: NodeId, near: &SideKeys, deep: &SideKeys, nodes: &Box<Slots<NodeId>>) -> result: Result<unit, StyleError> reads(document), reads(atoms), reads(near), reads(deep), writes(nodes) {
  doc "Lists the element child when it carries a key near names, and the elements of its subtree that carry a key deep names.";
  let limit = document^.nodes.inner.len;
  let keys = element_keys(document: document, atoms: atoms, node: child);
  let near_hit = carries(document: document, keys: keys, any: near^.any, wanted: &near^.keys);
  if near_hit {
    let pushed = propagate push::<NodeId>(cell: nodes, value: child, ceiling: 4294967296_u64);
  }
  let deep_keyed = deep^.keys.inner.len > 0_u64;
  let deep_some = bor(deep^.any, deep_keyed);
  if deep_some {
  } else {
    return Ok<unit, StyleError>(value: unit);
  }
  let inner = next_within(document: document, node: child, root: child);
  for (walk in 0_u64..limit) {
    match inner {
      Some(value: below) => {
        let below_element = is_element_node(document: document, node: below);
        if below_element {
          let below_keys = element_keys(document: document, atoms: atoms, node: below);
          let deep_hit = carries(document: document, keys: below_keys, any: deep^.any, wanted: &deep^.keys);
          if deep_hit {
            let pushed = propagate push::<NodeId>(cell: nodes, value: below, ceiling: 4294967296_u64);
          }
        }
        set inner = next_within(document: document, node: below, root: child);
      }
      None() => {
        break;
      }
    }
  }
  return Ok<unit, StyleError>(value: unit);
}

fn structural_restyle(store: &RuleStore, document: &Document, atoms: &AtomTable, parent: NodeId, previous: Option<NodeId>, next: Option<NodeId>) -> result: Result<StructureSet, StyleError> reads(store), reads(document), reads(atoms) {
  doc "Finds the structural reaches (feature_children and feature_parent) by binary search, then lists by NodeId the elements whose matching an insertion or removal of a child of parent, between the children previous and next, can change: the element children at the places around the point the children reaches name (the nearest element at or after next, the elements after it, the nearest at or before previous, the elements before it) that carry a reached subject key, the elements of their subtrees carrying a key reached downward, and parent itself for a parent reach of its own; full for a reach of the whole document, a parent reach beyond parent, or incomplete reaches. Reaches whose context the features of parent and its ancestors do not admit are skipped. Only the places some reach names are walked, from the point outward through the document's links.";
  let nodes = box_slots_new::<NodeId>(capacity: 0_u64);
  let parent_self = False();
  let full = bnot(store^.reaches_complete);
  let pseudos = False();
  let used = 0_u8;
  let count = store^.reaches.inner.len;
  let from = 0_u64;
  let to = count;
  for (step in 0_u64..64_u64) {
    if from >= to {
      break;
    }
    let width = to - from;
    let half = width / 2_u64;
    let middle = from + half;
    if middle < count {
      let bucket = reach_bucket(reach: store^.reaches.inner[middle]);
      if bucket < structural_bucket {
        set from = middle + 1_u64;
      } else {
        set to = middle;
      }
    } else {
      break;
    }
  }
  let yes = True();
  let no = False();
  let context = context_filter(document: document, atoms: atoms, element: parent);
  for (r in from..count) {
    let reach = store^.reaches.inner[r];
    let applies = filter_admits(filter: context, mask: reach.context);
    if applies {
      if reach.generated {
        set pseudos = True();
      }
      let all_bit = iand(reach.reach, reach_all);
      if all_bit != 0_u8 {
        set full = True();
      }
      if reach.feature == feature_parent {
        let wide_bits = iand(reach.reach, 14_u8);
        if wide_bits != 0_u8 {
          set full = True();
        }
        let own = iand(reach.reach, reach_self);
        if own != 0_u8 {
          set parent_self = True();
        }
      } else {
        let near_places = reach_places(reach: reach, deep: no);
        let deep_places = reach_places(reach: reach, deep: yes);
        let places = ior(near_places, deep_places);
        set used = ior(used, places);
      }
    }
  }
  if full {
    let everything = True();
    let made = StructureSet(full: everything, nodes: move nodes, pseudos: everything);
    return Ok<StructureSet, StyleError>(value: move made);
  }
  if parent_self {
    let pushed = propagate push::<NodeId>(cell: &nodes, value: parent, ceiling: 4294967296_u64);
  }
  let limit = document^.nodes.inner.len;
  let after_used = iand(used, 12_u8);
  if after_used != 0_u8 {
    let near_next = propagate side_keys(store: store, from: from, context: context, place: side_next, deep: no);
    let deep_next = propagate side_keys(store: store, from: from, context: context, place: side_next, deep: yes);
    let near_later = propagate side_keys(store: store, from: from, context: context, place: side_later, deep: no);
    let deep_later = propagate side_keys(store: store, from: from, context: context, place: side_later, deep: yes);
    let later_used = iand(used, side_later);
    let cursor = next;
    let first = True();
    for (step in 0_u64..limit) {
      match cursor {
        Some(value: current) => {
          let element = is_element_node(document: document, node: current);
          if element {
            if first {
              let visited = propagate visit_child(document: document, atoms: atoms, child: current, near: &near_next, deep: &deep_next, nodes: &nodes);
              set first = False();
              if later_used == 0_u8 {
                break;
              }
            } else {
              let visited = propagate visit_child(document: document, atoms: atoms, child: current, near: &near_later, deep: &deep_later, nodes: &nodes);
            }
          }
          let after = match node_links(document: document, node: current) {
            Some(value: links) => {
              give links.next_sibling;
            }
            None() => {
              give None<NodeId>();
            }
          }
          set cursor = after;
        }
        None() => {
          break;
        }
      }
    }
  }
  let before_used = iand(used, 3_u8);
  if before_used != 0_u8 {
    let near_previous = propagate side_keys(store: store, from: from, context: context, place: side_previous, deep: no);
    let deep_previous = propagate side_keys(store: store, from: from, context: context, place: side_previous, deep: yes);
    let near_earlier = propagate side_keys(store: store, from: from, context: context, place: side_earlier, deep: no);
    let deep_earlier = propagate side_keys(store: store, from: from, context: context, place: side_earlier, deep: yes);
    let earlier_used = iand(used, side_earlier);
    let cursor = previous;
    let first = True();
    for (step in 0_u64..limit) {
      match cursor {
        Some(value: current) => {
          let element = is_element_node(document: document, node: current);
          if element {
            if first {
              let visited = propagate visit_child(document: document, atoms: atoms, child: current, near: &near_previous, deep: &deep_previous, nodes: &nodes);
              set first = False();
              if earlier_used == 0_u8 {
                break;
              }
            } else {
              let visited = propagate visit_child(document: document, atoms: atoms, child: current, near: &near_earlier, deep: &deep_earlier, nodes: &nodes);
            }
          }
          let before = match node_links(document: document, node: current) {
            Some(value: links) => {
              give links.previous_sibling;
            }
            None() => {
              give None<NodeId>();
            }
          }
          set cursor = before;
        }
        None() => {
          break;
        }
      }
    }
  }
  let partial = False();
  let made = StructureSet(full: partial, nodes: move nodes, pseudos: pseudos);
  return Ok<StructureSet, StyleError>(value: move made);
}
