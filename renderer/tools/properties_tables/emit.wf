alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;

const const_word: Array<u8, 6> = "const ";

const array_u8_head: Array<u8, 12> = ": Array<u8, ";

const array_u16_head: Array<u8, 13> = ": Array<u16, ";

const array_open: Array<u8, 4> = "> =[";

const array_close: Array<u8, 3> = "];\n";

const comma_space: Array<u8, 2> = ", ";

const suffix_u8: Array<u8, 3> = "_u8";

const suffix_u16: Array<u8, 4> = "_u16";

const newline_byte: Array<u8, 1> = "\n";

const flush_threshold: u64 = 65536_u64;

fn emit_blank(factory: &HandleFactory, out: &OutputStream, report: &Box<Slots<u8>>) -> result: unit writes(factory), writes(out), writes(report) waits {
  doc "Writes one blank line, separating two top-level declarations.";
  let blank = &newline_byte[0_u64..newline_byte.len];
  put_text(buffer: report, text: blank);
  let sent = flush(factory: factory, output: out, buffer: report);
  return unit;
}

fn emit_name(report: &Box<Slots<u8>>, name: &[u8]) -> result: unit reads(name), writes(report) {
  doc "Writes `const NAME` to report.";
  let const_label = &const_word[0_u64..const_word.len];
  put_text(buffer: report, text: const_label);
  put_text(buffer: report, text: name);
  return unit;
}

fn emit_u16_array(factory: &HandleFactory, out: &OutputStream, report: &Box<Slots<u8>>, name: &[u8], values: &Box<Slots<u16>>) -> result: unit reads(name), reads(values.inner), writes(factory), writes(out), writes(report) waits {
  doc "Prints `const NAME: Array<u16, N> = [v0_u16, v1_u16, ...];` and a blank line, flushing report as it grows.";
  let count = values^.inner.len;
  emit_name(report: report, name: name);
  let head = &array_u16_head[0_u64..array_u16_head.len];
  put_text(buffer: report, text: head);
  put_decimal(buffer: report, value: count);
  let opener = &array_open[0_u64..array_open.len];
  put_text(buffer: report, text: opener);
  let source = &values^.inner[0_u64..count];
  for (index in 0_u64..count) {
    let separated = index > 0_u64;
    if separated {
      let sep = &comma_space[0_u64..comma_space.len];
      put_text(buffer: report, text: sep);
    }
    let value = source^[index];
    let widened = cvt::<u16, u64>(value);
    put_decimal(buffer: report, value: widened);
    let suffix = &suffix_u16[0_u64..suffix_u16.len];
    put_text(buffer: report, text: suffix);
    let large = report^.inner.len > flush_threshold;
    if large {
      let sent = flush(factory: factory, output: out, buffer: report);
    }
  }
  let closer = &array_close[0_u64..array_close.len];
  put_text(buffer: report, text: closer);
  let sent = flush(factory: factory, output: out, buffer: report);
  return unit;
}

fn emit_u8_array(factory: &HandleFactory, out: &OutputStream, report: &Box<Slots<u8>>, name: &[u8], values: &Box<Slots<u8>>) -> result: unit reads(name), reads(values.inner), writes(factory), writes(out), writes(report) waits {
  doc "Prints `const NAME: Array<u8, N> = [v0_u8, v1_u8, ...];` and a blank line, flushing report as it grows.";
  let count = values^.inner.len;
  emit_name(report: report, name: name);
  let head = &array_u8_head[0_u64..array_u8_head.len];
  put_text(buffer: report, text: head);
  put_decimal(buffer: report, value: count);
  let opener = &array_open[0_u64..array_open.len];
  put_text(buffer: report, text: opener);
  let source = &values^.inner[0_u64..count];
  for (index in 0_u64..count) {
    let separated = index > 0_u64;
    if separated {
      let sep = &comma_space[0_u64..comma_space.len];
      put_text(buffer: report, text: sep);
    }
    let value = source^[index];
    let widened = cvt::<u8, u64>(value);
    put_decimal(buffer: report, value: widened);
    let suffix = &suffix_u8[0_u64..suffix_u8.len];
    put_text(buffer: report, text: suffix);
    let large = report^.inner.len > flush_threshold;
    if large {
      let sent = flush(factory: factory, output: out, buffer: report);
    }
  }
  let closer = &array_close[0_u64..array_close.len];
  put_text(buffer: report, text: closer);
  let sent = flush(factory: factory, output: out, buffer: report);
  return unit;
}
