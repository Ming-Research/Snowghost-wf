const extended_pictographic_word: Array<u8, 21> = "Extended_Pictographic";

fn gc_index_from_field(field: &[u8]) -> result: u8 reads(field) {
  doc "Packs the General_Category two-letter abbreviation in field against the Unicode Standard's listed order (Lu, Ll, Lt, Lm, Lo, Mn, Mc, Me, Nd, Nl, No, Pc, Pd, Ps, Pe, Pi, Pf, Po, Sm, Sc, Sk, So, Zs, Zl, Zp, Cc, Cf, Cs, Co, Cn), 0-based, matching module.wfm's own doc order for both properties_tables and general_category. An unrecognized field returns 29 (Cn); the array this indexes is built with the same default, so an omitted code point reads as Unassigned either way.";
  let is_lu = field_is2(field: field, a: 'L'_u8, b: 'u'_u8);
  if is_lu {
    return 0_u8;
  }
  let is_ll = field_is2(field: field, a: 'L'_u8, b: 'l'_u8);
  if is_ll {
    return 1_u8;
  }
  let is_lt = field_is2(field: field, a: 'L'_u8, b: 't'_u8);
  if is_lt {
    return 2_u8;
  }
  let is_lm = field_is2(field: field, a: 'L'_u8, b: 'm'_u8);
  if is_lm {
    return 3_u8;
  }
  let is_lo = field_is2(field: field, a: 'L'_u8, b: 'o'_u8);
  if is_lo {
    return 4_u8;
  }
  let is_mn = field_is2(field: field, a: 'M'_u8, b: 'n'_u8);
  if is_mn {
    return 5_u8;
  }
  let is_mc = field_is2(field: field, a: 'M'_u8, b: 'c'_u8);
  if is_mc {
    return 6_u8;
  }
  let is_me = field_is2(field: field, a: 'M'_u8, b: 'e'_u8);
  if is_me {
    return 7_u8;
  }
  let is_nd = field_is2(field: field, a: 'N'_u8, b: 'd'_u8);
  if is_nd {
    return 8_u8;
  }
  let is_nl = field_is2(field: field, a: 'N'_u8, b: 'l'_u8);
  if is_nl {
    return 9_u8;
  }
  let is_no = field_is2(field: field, a: 'N'_u8, b: 'o'_u8);
  if is_no {
    return 10_u8;
  }
  let is_pc = field_is2(field: field, a: 'P'_u8, b: 'c'_u8);
  if is_pc {
    return 11_u8;
  }
  let is_pd = field_is2(field: field, a: 'P'_u8, b: 'd'_u8);
  if is_pd {
    return 12_u8;
  }
  let is_ps = field_is2(field: field, a: 'P'_u8, b: 's'_u8);
  if is_ps {
    return 13_u8;
  }
  let is_pe = field_is2(field: field, a: 'P'_u8, b: 'e'_u8);
  if is_pe {
    return 14_u8;
  }
  let is_pi = field_is2(field: field, a: 'P'_u8, b: 'i'_u8);
  if is_pi {
    return 15_u8;
  }
  let is_pf = field_is2(field: field, a: 'P'_u8, b: 'f'_u8);
  if is_pf {
    return 16_u8;
  }
  let is_po = field_is2(field: field, a: 'P'_u8, b: 'o'_u8);
  if is_po {
    return 17_u8;
  }
  let is_sm = field_is2(field: field, a: 'S'_u8, b: 'm'_u8);
  if is_sm {
    return 18_u8;
  }
  let is_sc = field_is2(field: field, a: 'S'_u8, b: 'c'_u8);
  if is_sc {
    return 19_u8;
  }
  let is_sk = field_is2(field: field, a: 'S'_u8, b: 'k'_u8);
  if is_sk {
    return 20_u8;
  }
  let is_so = field_is2(field: field, a: 'S'_u8, b: 'o'_u8);
  if is_so {
    return 21_u8;
  }
  let is_zs = field_is2(field: field, a: 'Z'_u8, b: 's'_u8);
  if is_zs {
    return 22_u8;
  }
  let is_zl = field_is2(field: field, a: 'Z'_u8, b: 'l'_u8);
  if is_zl {
    return 23_u8;
  }
  let is_zp = field_is2(field: field, a: 'Z'_u8, b: 'p'_u8);
  if is_zp {
    return 24_u8;
  }
  let is_cc = field_is2(field: field, a: 'C'_u8, b: 'c'_u8);
  if is_cc {
    return 25_u8;
  }
  let is_cf = field_is2(field: field, a: 'C'_u8, b: 'f'_u8);
  if is_cf {
    return 26_u8;
  }
  let is_cs = field_is2(field: field, a: 'C'_u8, b: 's'_u8);
  if is_cs {
    return 27_u8;
  }
  let is_co = field_is2(field: field, a: 'C'_u8, b: 'o'_u8);
  if is_co {
    return 28_u8;
  }
  let is_cn = field_is2(field: field, a: 'C'_u8, b: 'n'_u8);
  if is_cn {
    return 29_u8;
  }
  return 29_u8;
}

fn field_is_extended_pictographic(field: &[u8]) -> result: Bool reads(field) {
  doc "Tells whether field is exactly the word Extended_Pictographic.";
  let word = &extended_pictographic_word[0_u64..extended_pictographic_word.len];
  let same = field_equals(field: field, word: word);
  return same;
}
