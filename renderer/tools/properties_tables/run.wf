alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

const usage_text: Array<u8, 38> = "usage: properties_tables UCD_DIRECTORY";

const unreadable_text: Array<u8, 49> = "cannot open or read a file in the given directory";

const gc_filename: Array<u8, 26> = "DerivedGeneralCategory.txt";

const emoji_filename: Array<u8, 14> = "emoji-data.txt";

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, judges the invocation and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = generate(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn generate(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the one directory argument, opens it, reads the two Unicode character database files it names and, on success, delegates to build_and_emit.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    put_byte(buffer: &report, value: '\n'_u8);
    let sent = flush(factory: files, output: err, buffer: &report);
    return 1_u8;
  }
  match argument_bytes(args: args, position: 1_u64) {
    Some(value: dirname) => {
      let dirname_len = dirname.inner.len;
      let dirname_ref = &dirname.inner[0_u64..dirname_len];
      match open_directory_path(factory: files, root: cwd, name: dirname_ref) {
        Ok(value: directory) => {
          let inner_code = read_and_build(factory: files, directory: &directory, out: out, err: err, report: &report);
          close_directory(factory: files, directory: move directory);
          return inner_code;
        }
        Err(error: problem) => {
          report_unreadable(files: files, err: err, report: &report);
          return 2_u8;
        }
      }
    }
    None() => {
      report_unreadable(files: files, err: err, report: &report);
      return 2_u8;
    }
  }
}

fn report_unreadable(files: &HandleFactory, err: &OutputStream, report: &Box<Slots<u8>>) -> result: unit writes(files), writes(err), writes(report) waits {
  doc "Writes the unreadable-directory message to err.";
  let message = &unreadable_text[0_u64..unreadable_text.len];
  put_text(buffer: report, text: message);
  put_byte(buffer: report, value: '\n'_u8);
  let sent = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn read_and_build(factory: &HandleFactory, directory: &DirectoryRead, out: &OutputStream, err: &OutputStream, report: &Box<Slots<u8>>) -> code: u8 reads(directory), writes(factory), writes(out), writes(err), writes(report) waits {
  doc "Reads DerivedGeneralCategory.txt and emoji-data.txt below directory and, on success, builds and prints every table.";
  let gc_name = &gc_filename[0_u64..gc_filename.len];
  match read_directory_file(factory: factory, directory: directory, name: gc_name) {
    Ok(value: gc_text) => {
      let emoji_name = &emoji_filename[0_u64..emoji_filename.len];
      match read_directory_file(factory: factory, directory: directory, name: emoji_name) {
        Ok(value: emoji_text) => {
          let gc_len = gc_text.inner.len;
          let gc_bytes = &gc_text.inner[0_u64..gc_len];
          let emoji_len = emoji_text.inner.len;
          let emoji_bytes = &emoji_text.inner[0_u64..emoji_len];
          build_and_emit(factory: factory, gc_text: gc_bytes, emoji_text: emoji_bytes, out: out, report: report);
          return 0_u8;
        }
        Err(error: problem) => {
          report_unreadable(files: factory, err: err, report: report);
          return 2_u8;
        }
      }
    }
    Err(error: problem) => {
      report_unreadable(files: factory, err: err, report: report);
      return 2_u8;
    }
  }
}
