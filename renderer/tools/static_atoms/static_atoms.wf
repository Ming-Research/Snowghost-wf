alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias read_next = std::io::read_next;
alias write_once = std::io::write_once;

enum GenerateError {
  TooLarge();
  ReadFailed();
  EmptyName(line: u64);
  BadByte(line: u64);
  OutOfOrder(line: u64);
  Collision(line: u64);
  NoNewline(line: u64);
  TooMany();
  NoNames();
}

struct NameList {
  text: Box<Slots<u8>>;
  ends: Box<Slots<u64>>;
}

const buffer_ceiling: u64 = 16777216_u64;

const name_ceiling: u64 = 65535_u64;

const line_feed: u8 = 10_u8;

