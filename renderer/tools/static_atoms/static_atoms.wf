fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, reads the list, generates the record and writes it or the error.";
  let Inputs(args: unused_args, cwd: unused_cwd_directory, stdout: out, stderr: err, handles: files, stdin: input, ..) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move unused_cwd_write);
  let closed = close_directory(factory: &files, directory: move unused_cwd);
  let report = box_slots_new::<u8>(capacity: 0_u64);
  let code = generate(factory: &files, input: &input, output: &report);
  if code == 0_u8 {
    let written = flush(factory: &files, output: &out, buffer: &report);
    if written {
      return exit_status(code: 0_u8);
    }
    return exit_status(code: 2_u8);
  }
  let noted = flush(factory: &files, output: &err, buffer: &report);
  return exit_status(code: code);
}

fn generate(factory: &HandleFactory, input: &InputStream, output: &Box<Slots<u8>>) -> code: u8 writes(factory), writes(input), writes(output) waits {
  doc "Leaves the generated record in output and returns 0, or leaves an error message there and returns 1 or 2.";
  let text = box_slots_new::<u8>(capacity: 0_u64);
  match read_all(factory: factory, input: input, buffer: &text) {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return describe(output: output, error: problem);
    }
  }
  let length = text.inner.len;
  let view = &text.inner[0_u64..length];
  match parse(text: view) {
    Ok(value: names) => {
      match emit(names: &names, output: output) {
        Ok(value: unused) => {
          return 0_u8;
        }
        Err(error: problem) => {
          truncate(buffer: output);
          return describe(output: output, error: problem);
        }
      }
    }
    Err(error: problem) => {
      return describe(output: output, error: problem);
    }
  }
}

fn describe(output: &Box<Slots<u8>>, error: GenerateError) -> code: u8 writes(output) {
  doc "Writes the message for error and returns its exit code. The code reports the failure even when the message does not fit within buffer_ceiling.";
  match error {
    TooLarge() => {
      let written = note(output: output, text: &too_large_text[0_u64..too_large_text.len]);
      return 1_u8;
    }
    ReadFailed() => {
      let written = note(output: output, text: &read_failed_text[0_u64..read_failed_text.len]);
      return 2_u8;
    }
    EmptyName(line: at) => {
      let written = note_line(output: output, line: at, tail: &empty_text[0_u64..empty_text.len]);
      return 1_u8;
    }
    BadByte(line: at) => {
      let written = note_line(output: output, line: at, tail: &bad_byte_text[0_u64..bad_byte_text.len]);
      return 1_u8;
    }
    OutOfOrder(line: at) => {
      let written = note_line(output: output, line: at, tail: &order_text[0_u64..order_text.len]);
      return 1_u8;
    }
    Collision(line: at) => {
      let written = note_line(output: output, line: at, tail: &collision_text[0_u64..collision_text.len]);
      return 1_u8;
    }
    NoNewline(line: at) => {
      let written = note_line(output: output, line: at, tail: &no_newline_text[0_u64..no_newline_text.len]);
      return 1_u8;
    }
    TooMany() => {
      let written = note(output: output, text: &too_many_text[0_u64..too_many_text.len]);
      return 1_u8;
    }
    NoNames() => {
      let written = note(output: output, text: &no_names_text[0_u64..no_names_text.len]);
      return 1_u8;
    }
  }
}

fn note(output: &Box<Slots<u8>>, text: &[u8]) -> written: Bool reads(text), writes(output) {
  doc "Appends text to output and tells whether it fit.";
  match put_text(buffer: output, text: text) {
    Ok(value: unused) => {
      return True();
    }
    Err(error: problem) => {
      return False();
    }
  }
}

fn note_line(output: &Box<Slots<u8>>, line: u64, tail: &[u8]) -> written: Bool reads(tail), writes(output) {
  doc "Appends `static_atoms: line N` and tail to output and tells whether they fit.";
  match put_line_note(output: output, line: line, tail: tail) {
    Ok(value: unused) => {
      return True();
    }
    Err(error: problem) => {
      return False();
    }
  }
}

fn put_line_note(output: &Box<Slots<u8>>, line: u64, tail: &[u8]) -> result: Result<unit, GenerateError> reads(tail), writes(output) {
  doc "Appends the program prefix, the line number and tail.";
  let prefixed = propagate put_text(buffer: output, text: &program_prefix[0_u64..program_prefix.len]);
  let numbered = propagate put_decimal(buffer: output, value: line);
  let ended = propagate put_text(buffer: output, text: tail);
  return Ok<unit, GenerateError>(value: unit);
}

fn read_all(factory: &HandleFactory, input: &InputStream, buffer: &Box<Slots<u8>>) -> result: Result<unit, GenerateError> writes(factory), writes(input), writes(buffer) waits {
  doc "Appends every byte of input to buffer, reading 4096 bytes at a time.";
  let chunk = slots_new::<u8, 4096>();
  for @fill (
    at in 0_u64..4096_u64,
    invariant grown: chunk.len == at
  ) {
    place_back(window: &chunk, value: 0_u8);
  }
  let sink = &chunk[0_u64..4096_u64];
  loop @chunks {
    let no_deadline = None<std::time::Instant>();
    match read_next(factory: factory, input: input, destination: sink, start: 0_u64, end: 4096_u64, deadline: no_deadline) {
      Ok(value: endpoint) => {
        for (at in 0_u64..endpoint) {
          let byte = sink^[at];
          let pushed = propagate push::<u8>(buffer: buffer, value: byte);
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            return Ok<unit, GenerateError>(value: unit);
          }
          ReadFailed(error: problem) => {
            let failure = GenerateError::ReadFailed();
            return Err<unit, GenerateError>(error: failure);
          }
        }
      }
    }
  }
  return Ok<unit, GenerateError>(value: unit);
}

fn name_byte(byte: u8, first: Bool) -> allowed: Bool pure {
  doc "Tells whether byte may stand in a name: a lowercase letter anywhere, and an uppercase letter, a digit, `-` or `:` after the first byte.";
  let lower_from = byte >= 97_u8;
  let lower_to = byte <= 122_u8;
  let lower = band(lower_from, lower_to);
  if lower {
    return True();
  }
  if first {
    return False();
  }
  let upper_from = byte >= 65_u8;
  let upper_to = byte <= 90_u8;
  let upper = band(upper_from, upper_to);
  let digit_from = byte >= 48_u8;
  let digit_to = byte <= 57_u8;
  let digit = band(digit_from, digit_to);
  let hyphen = byte == 45_u8;
  let colon = byte == 58_u8;
  let letter_or_digit = bor(upper, digit);
  let separator = bor(hyphen, colon);
  return bor(letter_or_digit, separator);
}

fn line_end(text: &[u8], start: u64) -> result: u64 reads(text) contract {
  requires start <= text^.len;
  ensures result >= start;
  ensures result <= text^.len;
} {
  doc "Returns the index of the first line feed at or after start, or the length of text when there is none.";
  let length = text^.len;
  for (at in start..length) {
    if text^[at] == line_feed {
      return at;
    }
  }
  return length;
}

fn precedes(first: &[u8], second: &[u8]) -> result: Bool reads(first), reads(second) {
  doc "Tells whether first comes strictly before second in byte order, a proper prefix first.";
  let first_length = first^.len;
  let second_length = second^.len;
  let shorter = if first_length < second_length {
    give first_length;
  } else {
    give second_length;
  }
  for (at in 0_u64..shorter) {
    let left = first^[at];
    let right = second^[at];
    if left < right {
      return True();
    }
    if left > right {
      return False();
    }
  }
  return first_length < second_length;
}

fn same_bytes(first: &[u8], second: &[u8]) -> result: Bool reads(first), reads(second) {
  doc "Tells whether first and second hold the same bytes.";
  let length = first^.len;
  if length == second^.len {
  } else {
    return False();
  }
  for (at in 0_u64..length) {
    if first^[at] == second^[at] {
    } else {
      return False();
    }
  }
  return True();
}

fn parse(text: &[u8]) -> result: Result<NameList, GenerateError> reads(text) {
  doc "Splits text into lines, checks every name and its order against the one before, and collects the names.";
  let name_text = box_slots_new::<u8>(capacity: 0_u64);
  let name_ends = box_slots_new::<u64>(capacity: 0_u64);
  let names = NameList(text: move name_text, ends: move name_ends);
  let length = text^.len;
  let position = 0_u64;
  let previous_start = 0_u64;
  let previous_end = 0_u64;
  loop @lines (
    invariant ordered: previous_start <= previous_end,
    invariant inside: previous_end <= length,
    invariant reached: position <= length
  ) {
    if position >= length {
      break @lines;
    }
    let count = names.ends.inner.len;
    if count >= name_ceiling {
      let failure = GenerateError::TooMany();
      return Err<NameList, GenerateError>(error: failure);
    }
    let line = count + 1_u64;
    let start = position;
    let end = line_end(text: text, start: start);
    if end >= length {
      let failure = GenerateError::NoNewline(line: line);
      return Err<NameList, GenerateError>(error: failure);
    }
    if end == start {
      let failure = GenerateError::EmptyName(line: line);
      return Err<NameList, GenerateError>(error: failure);
    }
    for (at in start..end) {
      let first = at == start;
      let allowed = name_byte(byte: text^[at], first: first);
      if allowed {
      } else {
        let failure = GenerateError::BadByte(line: line);
        return Err<NameList, GenerateError>(error: failure);
      }
    }
    if count > 0_u64 {
      let before = &text^[previous_start..previous_end];
      let current = &text^[start..end];
      let ordered = precedes(first: before, second: current);
      if ordered {
      } else {
        let failure = GenerateError::OutOfOrder(line: line);
        return Err<NameList, GenerateError>(error: failure);
      }
    }
    for (at in start..end) {
      let pushed = propagate push::<u8>(buffer: &names.text, value: text^[at]);
    }
    let stored = names.text.inner.len;
    let recorded = propagate push::<u64>(buffer: &names.ends, value: stored);
    set previous_start = start;
    set previous_end = end;
    set position = end + 1_u64;
  }
  if names.ends.inner.len == 0_u64 {
    let failure = GenerateError::NoNames();
    return Err<NameList, GenerateError>(error: failure);
  }
  return Ok<NameList, GenerateError>(value: move names);
}

fn name_range(list: &NameList, index: u64) -> (start: u64, end: u64) reads(list) contract {
  ensures start <= end;
  ensures end <= list^.text.inner.len;
} {
  doc "Returns where the name at index lies in the list's text. The list's own writes make its ends ascending and within its text; an index past the list, or ends that were not, would give the empty range at 0.";
  let count = list^.ends.inner.len;
  let length = list^.text.inner.len;
  if index < count {
    let end = list^.ends.inner[index];
    let start = 0_u64;
    if index > 0_u64 {
      let previous = index - 1_u64;
      set start = list^.ends.inner[previous];
    }
    if start <= end {
      if end <= length {
        return start, end;
      }
    }
  }
  return 0_u64, 0_u64;
}

fn mangle(buffer: &Box<Slots<u8>>, name: &[u8]) -> result: Result<unit, GenerateError> reads(name), writes(buffer) {
  doc "Appends the constant spelling of name without its atom_ prefix: `-` and `:` become `_`, and an uppercase letter becomes `__` and its lowercase form.";
  let length = name^.len;
  for (at in 0_u64..length) {
    let byte = name^[at];
    let upper_from = byte >= 65_u8;
    let upper_to = byte <= 90_u8;
    let upper = band(upper_from, upper_to);
    let hyphen = byte == 45_u8;
    let colon = byte == 58_u8;
    let separator = bor(hyphen, colon);
    if upper {
      let lower = byte + 32_u8;
      let first = propagate push::<u8>(buffer: buffer, value: 95_u8);
      let second = propagate push::<u8>(buffer: buffer, value: 95_u8);
      let letter = propagate push::<u8>(buffer: buffer, value: lower);
    } else if separator {
      let joined = propagate push::<u8>(buffer: buffer, value: 95_u8);
    } else {
      let kept_byte = propagate push::<u8>(buffer: buffer, value: byte);
    }
  }
  return Ok<unit, GenerateError>(value: unit);
}

fn constants(names: &NameList) -> result: Result<NameList, GenerateError> reads(names) {
  doc "Returns the constant spelling of every name, in list order; Collision for a name whose spelling equals an earlier one's.";
  let made_text = box_slots_new::<u8>(capacity: 0_u64);
  let made_ends = box_slots_new::<u64>(capacity: 0_u64);
  let made = NameList(text: move made_text, ends: move made_ends);
  let count = names^.ends.inner.len;
  for (index in 0_u64..count) {
    let (start, end) = name_range(list: names, index: index);
    let spelled = propagate mangle(buffer: &made.text, name: &names^.text.inner[start..end]);
    let finished = made.text.inner.len;
    let recorded = propagate push::<u64>(buffer: &made.ends, value: finished);
    let (begun, done) = name_range(list: &made, index: index);
    let current = &made.text.inner[begun..done];
    for (earlier in 0_u64..index) {
      let (earlier_start, earlier_end) = name_range(list: &made, index: earlier);
      let same = same_bytes(first: &made.text.inner[earlier_start..earlier_end], second: current);
      if same {
        let line = index + 1_u64;
        let failure = GenerateError::Collision(line: line);
        return Err<NameList, GenerateError>(error: failure);
      }
    }
  }
  return Ok<NameList, GenerateError>(value: move made);
}

fn emit(names: &NameList, output: &Box<Slots<u8>>) -> result: Result<unit, GenerateError> reads(names), writes(output) {
  doc "Appends the interface record: one constant per name, then the text and end offset arrays.";
  let made = propagate constants(names: names);
  let count = names^.ends.inner.len;
  for (index in 0_u64..count) {
    let opened = propagate put_text(buffer: output, text: &const_prefix[0_u64..const_prefix.len]);
    let (start, end) = name_range(list: &made, index: index);
    let spelled = propagate put_text(buffer: output, text: &made.text.inner[start..end]);
    let typed = propagate put_text(buffer: output, text: &u32_type[0_u64..u32_type.len]);
    let valued = propagate put_decimal(buffer: output, value: index);
    let closed = propagate put_text(buffer: output, text: &u32_end[0_u64..u32_end.len]);
  }
  let total = names^.text.inner.len;
  let text_opened = propagate put_text(buffer: output, text: &text_head[0_u64..text_head.len]);
  let text_sized = propagate put_decimal(buffer: output, value: total);
  let text_begun = propagate put_text(buffer: output, text: &array_open[0_u64..array_open.len]);
  for (at in 0_u64..total) {
    if at > 0_u64 {
      let separated = propagate put_text(buffer: output, text: &comma[0_u64..comma.len]);
    }
    let byte = names^.text.inner[at];
    let wide = cvt::<u8, u64>(byte);
    let valued = propagate put_decimal(buffer: output, value: wide);
    let suffixed = propagate put_text(buffer: output, text: &u8_suffix[0_u64..u8_suffix.len]);
  }
  let ends_opened = propagate put_text(buffer: output, text: &ends_head[0_u64..ends_head.len]);
  let ends_sized = propagate put_decimal(buffer: output, value: count);
  let ends_begun = propagate put_text(buffer: output, text: &array_open[0_u64..array_open.len]);
  for (index in 0_u64..count) {
    if index > 0_u64 {
      let separated = propagate put_text(buffer: output, text: &comma[0_u64..comma.len]);
    }
    let end = names^.ends.inner[index];
    let valued = propagate put_decimal(buffer: output, value: end);
    let suffixed = propagate put_text(buffer: output, text: &u32_suffix[0_u64..u32_suffix.len]);
  }
  let finished = propagate put_text(buffer: output, text: &array_close[0_u64..array_close.len]);
  return Ok<unit, GenerateError>(value: unit);
}

fn push<T: drop>(buffer: &Box<Slots<T>>, value: T) -> result: Result<unit, GenerateError> writes(buffer) {
  doc "Appends value, doubling a full buffer (an empty one takes 16 slots) while its capacity is below buffer_ceiling; TooLarge when a full buffer has reached it.";
  let length = buffer^.inner.len;
  let capacity = buffer^.inner.cap;
  if length < capacity {
    place_back(window: &buffer^.inner, value: move value);
    return Ok<unit, GenerateError>(value: unit);
  }
  if capacity >= buffer_ceiling {
    let failure = GenerateError::TooLarge();
    return Err<unit, GenerateError>(error: failure);
  }
  if capacity < 8_u64 {
    grow(cell: buffer, capacity: 16_u64);
  } else {
    let doubled = capacity + capacity;
    grow(cell: buffer, capacity: doubled);
  }
  place_back(window: &buffer^.inner, value: move value);
  return Ok<unit, GenerateError>(value: unit);
}

fn put_text(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: Result<unit, GenerateError> reads(text), writes(buffer) {
  doc "Appends every byte of text.";
  let length = text^.len;
  for (at in 0_u64..length) {
    let pushed = propagate push::<u8>(buffer: buffer, value: text^[at]);
  }
  return Ok<unit, GenerateError>(value: unit);
}

fn put_decimal(buffer: &Box<Slots<u8>>, value: u64) -> result: Result<unit, GenerateError> writes(buffer) {
  doc "Appends the decimal spelling of value without leading zeros: its digits are collected least significant first in a 20-byte array, the most a u64 has, and appended in reverse.";
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = value;
  for @collect (
    position in 0_u64..20_u64,
    invariant bounded: count <= 19_u64
  ) {
    let digit = rest % 10_u64;
    set digits[position] = decimal_glyphs[digit];
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      set count = position;
      break @collect;
    }
  }
  for @emit (
    step in 0_u64..20_u64,
    invariant remaining: count <= 19_u64
  ) {
    let pushed = propagate push::<u8>(buffer: buffer, value: digits[count]);
    if count == 0_u64 {
      return Ok<unit, GenerateError>(value: unit);
    }
    set count = count - 1_u64;
  }
  return Ok<unit, GenerateError>(value: unit);
}

fn flush(factory: &HandleFactory, output: &OutputStream, buffer: &Box<Slots<u8>>) -> result: Bool reads(buffer), writes(factory), writes(output) waits {
  doc "Repeats write_once until every byte of buffer is accepted, and tells whether it was; a refused or stalled write stops it.";
  let length = buffer^.inner.len;
  let content = &buffer^.inner[0_u64..length];
  let sent = 0_u64;
  loop @publish {
    if sent >= length {
      return True();
    }
    let no_deadline = None<std::time::Instant>();
    match write_once(factory: factory, output: output, source: content, start: sent, end: length, deadline: no_deadline) {
      Ok(value: next) => {
        if next == sent {
          return False();
        }
        set sent = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return True();
}

fn truncate(buffer: &Box<Slots<u8>>) -> result: unit writes(buffer) {
  doc "Removes every byte of buffer, keeping its capacity.";
  loop @drop {
    if buffer^.inner.len == 0_u64 {
      break @drop;
    }
    let byte = take_back(window: &buffer^.inner);
  }
  return unit;
}
