alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The static_atoms entry. Reads a name list on standard input, one name per line, each line ending with a line feed, in strictly ascending byte order; a name holds only ASCII letters, digits, `-` and `:` and starts with a lowercase letter. Writes to standard output the interface record of pkg::base::static_atoms: for the name at zero-based line i, `public const atom_C: u32 = i_u32;`, where C is the name with `-` and `:` turned into `_` and each uppercase letter turned into `__` followed by its lowercase form; then static_atom_text, every name's bytes concatenated in list order, and static_atom_ends, the end offset of each name in that text. Exits with 0 on success, and with 1 after a message on standard error when the list breaks a rule above, two names give one constant name, the list holds more than 65535 names or none, or the input or output passes 16 MiB; 2 when standard input cannot be read or standard output refuses a write.";
