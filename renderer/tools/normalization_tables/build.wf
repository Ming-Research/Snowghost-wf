alias OutputStream = std::io::OutputStream;

const ccc_block_index_name: Array<u8, 15> =[99_u8, 99_u8, 99_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const ccc_block_bytes_name: Array<u8, 15> =[99_u8, 99_u8, 99_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 98_u8, 121_u8, 116_u8, 101_u8, 115_u8];

const decomposition_block_index_name: Array<u8, 25> =[100_u8, 101_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const decomposition_block_ids_name: Array<u8, 23> =[100_u8, 101_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 100_u8, 115_u8];

const decomposition_offsets_name: Array<u8, 21> =[100_u8, 101_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 111_u8, 102_u8, 102_u8, 115_u8, 101_u8, 116_u8, 115_u8];

const decomposition_lengths_name: Array<u8, 21> =[100_u8, 101_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 108_u8, 101_u8, 110_u8, 103_u8, 116_u8, 104_u8, 115_u8];

const decomposition_values_name: Array<u8, 20> =[100_u8, 101_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 118_u8, 97_u8, 108_u8, 117_u8, 101_u8, 115_u8];

const composition_block_index_name: Array<u8, 23> =[99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const composition_block_ids_name: Array<u8, 21> =[99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 100_u8, 115_u8];

const composition_offsets_name: Array<u8, 19> =[99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 111_u8, 102_u8, 102_u8, 115_u8, 101_u8, 116_u8, 115_u8];

const composition_counts_name: Array<u8, 18> =[99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 99_u8, 111_u8, 117_u8, 110_u8, 116_u8, 115_u8];

const composition_combining_name: Array<u8, 21> =[99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 99_u8, 111_u8, 109_u8, 98_u8, 105_u8, 110_u8, 105_u8, 110_u8, 103_u8];

const composition_composed_name: Array<u8, 20> =[99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 115_u8, 101_u8, 100_u8];

fn build_and_emit(factory: &HandleFactory, data_text: &[u8], props_text: &[u8], out: &OutputStream, report: &Box<Slots<u8>>) -> result: unit reads(data_text), reads(props_text), writes(factory), writes(out), writes(report) {
  doc "Parses both input files, builds every table and prints them in order to out.";
  let data = parse_unicode_data(text: data_text);
  let excluded = parse_full_composition_exclusion(text: props_text);
  let ccc_tables = sweep_ccc(ccc_by_cp: &data.ccc_by_cp);
  let ccc_block_index_len = ccc_block_index_name.len;
  let ccc_block_index_label = &ccc_block_index_name[0_u64..ccc_block_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: ccc_block_index_label, values: &ccc_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let ccc_block_bytes_len = ccc_block_bytes_name.len;
  let ccc_block_bytes_label = &ccc_block_bytes_name[0_u64..ccc_block_bytes_len];
  emit_u8_array(factory: factory, out: out, report: report, name: ccc_block_bytes_label, values: &ccc_tables.block_bytes);
  emit_blank(factory: factory, out: out, report: report);
  let decomposition = build_decomposition_tables(data: &data);
  let decomposition_tables = sweep_ids(id_by_cp: &decomposition.decomposition_id_by_cp);
  let decomposition_block_index_len = decomposition_block_index_name.len;
  let decomposition_block_index_label = &decomposition_block_index_name[0_u64..decomposition_block_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: decomposition_block_index_label, values: &decomposition_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let decomposition_block_ids_len = decomposition_block_ids_name.len;
  let decomposition_block_ids_label = &decomposition_block_ids_name[0_u64..decomposition_block_ids_len];
  emit_u16_array(factory: factory, out: out, report: report, name: decomposition_block_ids_label, values: &decomposition_tables.block_values);
  emit_blank(factory: factory, out: out, report: report);
  let decomposition_offsets_len = decomposition_offsets_name.len;
  let decomposition_offsets_label = &decomposition_offsets_name[0_u64..decomposition_offsets_len];
  emit_u32_array(factory: factory, out: out, report: report, name: decomposition_offsets_label, values: &decomposition.offsets);
  emit_blank(factory: factory, out: out, report: report);
  let decomposition_lengths_len = decomposition_lengths_name.len;
  let decomposition_lengths_label = &decomposition_lengths_name[0_u64..decomposition_lengths_len];
  emit_u8_array(factory: factory, out: out, report: report, name: decomposition_lengths_label, values: &decomposition.lengths);
  emit_blank(factory: factory, out: out, report: report);
  let decomposition_values_len = decomposition_values_name.len;
  let decomposition_values_label = &decomposition_values_name[0_u64..decomposition_values_len];
  emit_u32_array(factory: factory, out: out, report: report, name: decomposition_values_label, values: &decomposition.values);
  emit_blank(factory: factory, out: out, report: report);
  let composition = build_composition_tables(data: &data, excluded: &excluded);
  let composition_tables = sweep_ids(id_by_cp: &composition.composition_id_by_cp);
  let composition_block_index_len = composition_block_index_name.len;
  let composition_block_index_label = &composition_block_index_name[0_u64..composition_block_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: composition_block_index_label, values: &composition_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let composition_block_ids_len = composition_block_ids_name.len;
  let composition_block_ids_label = &composition_block_ids_name[0_u64..composition_block_ids_len];
  emit_u16_array(factory: factory, out: out, report: report, name: composition_block_ids_label, values: &composition_tables.block_values);
  emit_blank(factory: factory, out: out, report: report);
  let composition_offsets_len = composition_offsets_name.len;
  let composition_offsets_label = &composition_offsets_name[0_u64..composition_offsets_len];
  emit_u32_array(factory: factory, out: out, report: report, name: composition_offsets_label, values: &composition.offsets);
  emit_blank(factory: factory, out: out, report: report);
  let composition_counts_len = composition_counts_name.len;
  let composition_counts_label = &composition_counts_name[0_u64..composition_counts_len];
  emit_u8_array(factory: factory, out: out, report: report, name: composition_counts_label, values: &composition.counts);
  emit_blank(factory: factory, out: out, report: report);
  let composition_combining_len = composition_combining_name.len;
  let composition_combining_label = &composition_combining_name[0_u64..composition_combining_len];
  emit_u32_array(factory: factory, out: out, report: report, name: composition_combining_label, values: &composition.combining);
  emit_blank(factory: factory, out: out, report: report);
  let composition_composed_len = composition_composed_name.len;
  let composition_composed_label = &composition_composed_name[0_u64..composition_composed_len];
  emit_u32_array(factory: factory, out: out, report: report, name: composition_composed_label, values: &composition.composed);
  return unit;
}
