const idna_bidi_block_index_name: Array<u8, 21> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 98_u8, 105_u8, 100_u8, 105_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const idna_bidi_block_bytes_name: Array<u8, 21> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 98_u8, 105_u8, 100_u8, 105_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 98_u8, 121_u8, 116_u8, 101_u8, 115_u8];

const idna_joining_block_index_name: Array<u8, 24> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 106_u8, 111_u8, 105_u8, 110_u8, 105_u8, 110_u8, 103_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const idna_joining_block_bytes_name: Array<u8, 24> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 106_u8, 111_u8, 105_u8, 110_u8, 105_u8, 110_u8, 103_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 98_u8, 121_u8, 116_u8, 101_u8, 115_u8];

const idna_mark_block_index_name: Array<u8, 21> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 109_u8, 97_u8, 114_u8, 107_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const idna_mark_block_bytes_name: Array<u8, 21> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 109_u8, 97_u8, 114_u8, 107_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 98_u8, 121_u8, 116_u8, 101_u8, 115_u8];

const idna_virama_block_index_name: Array<u8, 23> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 118_u8, 105_u8, 114_u8, 97_u8, 109_u8, 97_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const idna_virama_block_bytes_name: Array<u8, 23> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 118_u8, 105_u8, 114_u8, 97_u8, 109_u8, 97_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 98_u8, 121_u8, 116_u8, 101_u8, 115_u8];

fn build_and_emit(factory: &HandleFactory, mapping_text: &[u8], bidi_text: &[u8], joining_text: &[u8], gc_text: &[u8], data_text: &[u8], out: &OutputStream, report: &Box<Slots<u8>>) -> result: unit reads(mapping_text), reads(bidi_text), reads(joining_text), reads(gc_text), reads(data_text), writes(factory), writes(out), writes(report) {
  doc "Parses every input file, builds every table and prints them in order to out.";
  let mapping = parse_idna_mapping(text: mapping_text);
  let status_tables = sweep_u8(values_by_cp: &mapping.status_by_cp);
  let status_index_len = idna_status_block_index_name.len;
  let status_index_label = &idna_status_block_index_name[0_u64..status_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: status_index_label, values: &status_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let status_bytes_len = idna_status_block_bytes_name.len;
  let status_bytes_label = &idna_status_block_bytes_name[0_u64..status_bytes_len];
  emit_u8_array(factory: factory, out: out, report: report, name: status_bytes_label, values: &status_tables.block_bytes);
  emit_blank(factory: factory, out: out, report: report);
  let mapping_id_tables = sweep_u16(ids_by_cp: &mapping.mapping_id_by_cp);
  let mapping_index_len = idna_mapping_block_index_name.len;
  let mapping_index_label = &idna_mapping_block_index_name[0_u64..mapping_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: mapping_index_label, values: &mapping_id_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let mapping_ids_len = idna_mapping_block_ids_name.len;
  let mapping_ids_label = &idna_mapping_block_ids_name[0_u64..mapping_ids_len];
  emit_u16_array(factory: factory, out: out, report: report, name: mapping_ids_label, values: &mapping_id_tables.block_values);
  emit_blank(factory: factory, out: out, report: report);
  let mapping_offsets_len = idna_mapping_offsets_name.len;
  let mapping_offsets_label = &idna_mapping_offsets_name[0_u64..mapping_offsets_len];
  emit_u32_array(factory: factory, out: out, report: report, name: mapping_offsets_label, values: &mapping.mapping_offsets);
  emit_blank(factory: factory, out: out, report: report);
  let mapping_lengths_len = idna_mapping_lengths_name.len;
  let mapping_lengths_label = &idna_mapping_lengths_name[0_u64..mapping_lengths_len];
  emit_u8_array(factory: factory, out: out, report: report, name: mapping_lengths_label, values: &mapping.mapping_lengths);
  emit_blank(factory: factory, out: out, report: report);
  let mapping_values_len = idna_mapping_values_name.len;
  let mapping_values_label = &idna_mapping_values_name[0_u64..mapping_values_len];
  emit_u32_array(factory: factory, out: out, report: report, name: mapping_values_label, values: &mapping.mapping_values);
  emit_blank(factory: factory, out: out, report: report);
  let bidi_by_cp = parse_derived_bidi_class(text: bidi_text);
  let bidi_tables = sweep_u8(values_by_cp: &bidi_by_cp);
  let bidi_index_len = idna_bidi_block_index_name.len;
  let bidi_index_label = &idna_bidi_block_index_name[0_u64..bidi_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: bidi_index_label, values: &bidi_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let bidi_bytes_len = idna_bidi_block_bytes_name.len;
  let bidi_bytes_label = &idna_bidi_block_bytes_name[0_u64..bidi_bytes_len];
  emit_u8_array(factory: factory, out: out, report: report, name: bidi_bytes_label, values: &bidi_tables.block_bytes);
  emit_blank(factory: factory, out: out, report: report);
  let joining_by_cp = parse_derived_joining_type(text: joining_text);
  let joining_tables = sweep_u8(values_by_cp: &joining_by_cp);
  let joining_index_len = idna_joining_block_index_name.len;
  let joining_index_label = &idna_joining_block_index_name[0_u64..joining_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: joining_index_label, values: &joining_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let joining_bytes_len = idna_joining_block_bytes_name.len;
  let joining_bytes_label = &idna_joining_block_bytes_name[0_u64..joining_bytes_len];
  emit_u8_array(factory: factory, out: out, report: report, name: joining_bytes_label, values: &joining_tables.block_bytes);
  emit_blank(factory: factory, out: out, report: report);
  let mark_by_cp = parse_derived_general_category_mark(text: gc_text);
  let mark_tables = sweep_u8(values_by_cp: &mark_by_cp);
  let mark_index_len = idna_mark_block_index_name.len;
  let mark_index_label = &idna_mark_block_index_name[0_u64..mark_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: mark_index_label, values: &mark_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let mark_bytes_len = idna_mark_block_bytes_name.len;
  let mark_bytes_label = &idna_mark_block_bytes_name[0_u64..mark_bytes_len];
  emit_u8_array(factory: factory, out: out, report: report, name: mark_bytes_label, values: &mark_tables.block_bytes);
  emit_blank(factory: factory, out: out, report: report);
  let virama_by_cp = parse_unicode_data_virama(text: data_text);
  let virama_tables = sweep_u8(values_by_cp: &virama_by_cp);
  let virama_index_len = idna_virama_block_index_name.len;
  let virama_index_label = &idna_virama_block_index_name[0_u64..virama_index_len];
  emit_u16_array(factory: factory, out: out, report: report, name: virama_index_label, values: &virama_tables.block_index);
  emit_blank(factory: factory, out: out, report: report);
  let virama_bytes_len = idna_virama_block_bytes_name.len;
  let virama_bytes_label = &idna_virama_block_bytes_name[0_u64..virama_bytes_len];
  emit_u8_array(factory: factory, out: out, report: report, name: virama_bytes_label, values: &virama_tables.block_bytes);
  return unit;
}
