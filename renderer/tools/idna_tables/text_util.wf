const space: u8 = 32_u8;

const tab: u8 = 9_u8;

const dot: u8 = 46_u8;

const semicolon: u8 = 59_u8;

const number_sign: u8 = 35_u8;

const less_than: u8 = 60_u8;

const digit_zero: u8 = 48_u8;

const digit_nine: u8 = 57_u8;

const upper_a: u8 = 65_u8;

const upper_f: u8 = 70_u8;

const no_hex_digit: u8 = 16_u8;

const no_decimal_digit: u8 = 10_u8;

fn is_blank(byte: u8) -> result: Bool pure {
  doc "Tells whether byte is a space or a tab.";
  let spaced = byte == space;
  let tabbed = byte == tab;
  let blank = bor(spaced, tabbed);
  return blank;
}

fn find_byte(text: &[u8], from: u64, stop: u64, target: u8) -> result: u64 reads(text) contract {
  requires from <= stop;
  requires stop <= text^.len;
  ensures result >= from;
  ensures result <= stop;
} {
  doc "Returns the index of the first occurrence of target from from to stop, or stop.";
  let length = text^.len;
  let ordered = from <= stop;
  let within = stop <= length;
  let usable = band(ordered, within);
  if usable {
  } else {
    return stop;
  }
  for (at in from..stop) {
    let byte = text^[at];
    let found = byte == target;
    if found {
      return at;
    }
  }
  return stop;
}

fn skip_ws(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) contract {
  requires from <= stop;
  requires stop <= text^.len;
  ensures result >= from;
  ensures result <= stop;
} {
  doc "Returns the index of the first byte from from to stop that is not blank, or stop.";
  let length = text^.len;
  let at = from;
  loop @skip (
    invariant lower: at >= from
  ) {
    let before_stop = at < stop;
    let inside = at < length;
    let readable = band(before_stop, inside);
    if readable {
    } else {
      return stop;
    }
    let byte = text^[at];
    let blank = is_blank(byte: byte);
    if blank {
    } else {
      return at;
    }
    let next = at +wrap 1_u64;
    invariant next_lower: next >= from;
    set at = next;
  }
  return stop;
}

fn trim_ws_end(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) contract {
  requires from <= stop;
  requires stop <= text^.len;
  ensures result >= from;
  ensures result <= stop;
} {
  doc "Returns the smallest end in from..stop past which every byte to stop is blank.";
  let length = text^.len;
  let ordered = from <= stop;
  let within = stop <= length;
  let usable = band(ordered, within);
  if usable {
  } else {
    return stop;
  }
  let at = stop;
  loop @trim (
    invariant bounded: at <= stop,
    invariant lower: at >= from
  ) {
    let above = at > from;
    if above {
    } else {
      return at;
    }
    let previous = at -wrap 1_u64;
    invariant step: previous <= stop;
    let byte = text^[previous];
    let blank = is_blank(byte: byte);
    if blank {
      set at = previous;
    } else {
      return at;
    }
  }
  return at;
}

fn hex_digit(byte: u8) -> result: u8 pure {
  doc "Returns the value of one uppercase ASCII hexadecimal digit, or no_hex_digit for any other byte; these files spell hex digits in uppercase alone.";
  let decimal_low = byte >= digit_zero;
  let decimal_high = byte <= digit_nine;
  let decimal = band(decimal_low, decimal_high);
  if decimal {
    return byte -wrap digit_zero;
  }
  let upper_low = byte >= upper_a;
  let upper_high = byte <= upper_f;
  let upper = band(upper_low, upper_high);
  if upper {
    let offset = byte -wrap upper_a;
    return offset +wrap 10_u8;
  }
  return no_hex_digit;
}

fn parse_hex_u32(text: &[u8], from: u64, stop: u64) -> result: Option<u32> reads(text) {
  doc "Parses text from from to stop as 1 to 6 uppercase hexadecimal digits.";
  let length = text^.len;
  let ordered = from < stop;
  let within = stop <= length;
  let located = band(ordered, within);
  let size = stop -wrap from;
  let short = size <= 6_u64;
  let usable = band(located, short);
  if usable {
  } else {
    return None<u32>();
  }
  let value = 0_u32;
  for (at in from..stop) {
    let byte = text^[at];
    let digit = hex_digit(byte: byte);
    let valid = digit < no_hex_digit;
    if valid {
    } else {
      return None<u32>();
    }
    let widened = cvt::<u8, u32>(digit);
    let shifted = ishl.wrap(value, 4_u32);
    set value = ior(shifted, widened);
  }
  return Some<u32>(value: value);
}

fn decimal_digit(byte: u8) -> result: u8 pure {
  doc "Returns the value of one ASCII decimal digit, or no_decimal_digit for any other byte.";
  let low = byte >= digit_zero;
  let high = byte <= digit_nine;
  let decimal = band(low, high);
  if decimal {
    return byte -wrap digit_zero;
  }
  return no_decimal_digit;
}

fn parse_decimal_u32(text: &[u8], from: u64, stop: u64) -> result: Option<u32> reads(text) {
  doc "Parses text from from to stop as 1 to 9 ASCII decimal digits.";
  let length = text^.len;
  let ordered = from < stop;
  let within = stop <= length;
  let located = band(ordered, within);
  let size = stop -wrap from;
  let short = size <= 9_u64;
  let usable = band(located, short);
  if usable {
  } else {
    return None<u32>();
  }
  let value = 0_u32;
  for (at in from..stop) {
    let byte = text^[at];
    let digit = decimal_digit(byte: byte);
    let valid = digit < no_decimal_digit;
    if valid {
    } else {
      return None<u32>();
    }
    let widened = cvt::<u8, u32>(digit);
    let times_ten = value *wrap 10_u32;
    set value = times_ten +wrap widened;
  }
  return Some<u32>(value: value);
}
