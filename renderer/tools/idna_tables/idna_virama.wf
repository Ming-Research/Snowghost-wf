struct CccFields {
  ok: Bool;
  cp_start: u64;
  cp_end: u64;
  ccc_start: u64;
  ccc_end: u64;
}

fn split_ccc_fields(text: &[u8], line_start: u64, line_stop: u64) -> result: CccFields reads(text) {
  doc "Splits one UnicodeData.txt data line into its semicolon-delimited fields 0 (code point) and 3 (canonical combining class); reports ok False for a line with fewer than four fields.";
  let length = text^.len;
  let no = False();
  let bad = CccFields(ok: no, cp_start: 0_u64, cp_end: 0_u64, ccc_start: 0_u64, ccc_end: 0_u64);
  let within = line_stop <= length;
  let ordered = line_start <= line_stop;
  let usable = band(within, ordered);
  if usable {
  } else {
    return bad;
  }
  let f0_start = line_start;
  let f0_end = find_byte(text: text, from: f0_start, stop: line_stop, target: semicolon);
  let has0 = f0_end < line_stop;
  if has0 {
  } else {
    return bad;
  }
  let f1_start = f0_end +wrap 1_u64;
  let f1_end = find_byte(text: text, from: f1_start, stop: line_stop, target: semicolon);
  let has1 = f1_end < line_stop;
  if has1 {
  } else {
    return bad;
  }
  let f2_start = f1_end +wrap 1_u64;
  let f2_end = find_byte(text: text, from: f2_start, stop: line_stop, target: semicolon);
  let has2 = f2_end < line_stop;
  if has2 {
  } else {
    return bad;
  }
  let f3_start = f2_end +wrap 1_u64;
  let f3_end = find_byte(text: text, from: f3_start, stop: line_stop, target: semicolon);
  let has3 = f3_end < line_stop;
  if has3 {
  } else {
    return bad;
  }
  let yes = True();
  let good = CccFields(ok: yes, cp_start: f0_start, cp_end: f0_end, ccc_start: f3_start, ccc_end: f3_end);
  return good;
}

fn parse_unicode_data_virama(text: &[u8]) -> result: Box<Array<u8>> reads(text) {
  doc "Builds a code-space array marking every code point whose UnicodeData.txt canonical combining class is 9 (Virama) as 1; every other code point, including one UnicodeData.txt does not list, is 0.";
  let virama_by_cp = box_array_filled::<u8>(count: code_space, value: 0_u8);
  let length = text^.len;
  let at = 0_u64;
  loop @lines {
    let more = at < length;
    if more {
    } else {
      return move virama_by_cp;
    }
    let found_stop = line_end(text: text, start: at);
    let stop = imin(found_stop, length);
    let fields = split_ccc_fields(text: text, line_start: at, line_stop: stop);
    if fields.ok {
      match parse_hex_u32(text: text, from: fields.cp_start, stop: fields.cp_end) {
        Some(value: cp) => {
          let cp64 = cvt::<u32, u64>(cp);
          let in_space = cp64 < virama_by_cp.inner.len;
          if in_space {
            match parse_decimal_u32(text: text, from: fields.ccc_start, stop: fields.ccc_end) {
              Some(value: ccc) => {
                let is_virama = ccc == 9_u32;
                if is_virama {
                  set virama_by_cp.inner[cp64] = 1_u8;
                }
              }
              None() => {
              }
            }
          }
        }
        None() => {
        }
      }
    }
    set at = stop +wrap 1_u64;
  }
}
