struct Range32 {
  start: u32;
  end: u32;
}

fn parse_range(text: &[u8], from: u64, stop: u64) -> result: Option<Range32> reads(text) {
  doc "Parses text from from to stop as a UCD code point range: a single 'XXXX', or 'XXXX..YYYY'.";
  let length = text^.len;
  let ordered = from <= stop;
  let within = stop <= length;
  let usable = band(ordered, within);
  if usable {
  } else {
    return None<Range32>();
  }
  let dot_at = find_byte(text: text, from: from, stop: stop, target: dot);
  let has_dot = dot_at < stop;
  if has_dot {
    let after_dot = dot_at +wrap 1_u64;
    let second_dot = after_dot < stop;
    let byte_ok = if second_dot {
      let byte = text^[after_dot];
      give byte == dot;
    } else {
      give False();
    }
    if byte_ok {
    } else {
      return None<Range32>();
    }
    let tail = after_dot +wrap 1_u64;
    match parse_hex_u32(text: text, from: from, stop: dot_at) {
      Some(value: first) => {
        match parse_hex_u32(text: text, from: tail, stop: stop) {
          Some(value: second) => {
            let made = Range32(start: first, end: second);
            return Some<Range32>(value: made);
          }
          None() => {
            return None<Range32>();
          }
        }
      }
      None() => {
        return None<Range32>();
      }
    }
  }
  match parse_hex_u32(text: text, from: from, stop: stop) {
    Some(value: single) => {
      let made = Range32(start: single, end: single);
      return Some<Range32>(value: made);
    }
    None() => {
      return None<Range32>();
    }
  }
}

fn line_field_end(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) contract {
  requires from <= stop;
  requires stop <= text^.len;
  ensures result >= from;
  ensures result <= stop;
} {
  doc "Returns the index of the first semicolon or number sign from from to stop, or stop.";
  let semi = find_byte(text: text, from: from, stop: stop, target: semicolon);
  let hash = find_byte(text: text, from: from, stop: stop, target: number_sign);
  let semi_first = semi <= hash;
  if semi_first {
    return semi;
  }
  return hash;
}

fn field_equals(field: &[u8], want: &[u8]) -> result: Bool reads(field), reads(want) {
  doc "Tells whether field is exactly the bytes of want.";
  let length = field^.len;
  let want_len = want^.len;
  let same_len = length == want_len;
  if same_len {
  } else {
    return False();
  }
  for (at in 0_u64..want_len) {
    let byte = field^[at];
    let expected = want^[at];
    let same = byte == expected;
    if same {
    } else {
      return False();
    }
  }
  return True();
}
