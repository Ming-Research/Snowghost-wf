const bc_l_word: Array<u8, 1> =[76_u8];

const bc_r_word: Array<u8, 1> =[82_u8];

const bc_al_word: Array<u8, 2> =[65_u8, 76_u8];

const bc_en_word: Array<u8, 2> =[69_u8, 78_u8];

const bc_es_word: Array<u8, 2> =[69_u8, 83_u8];

const bc_cs_word: Array<u8, 2> =[67_u8, 83_u8];

const bc_et_word: Array<u8, 2> =[69_u8, 84_u8];

const bc_on_word: Array<u8, 2> =[79_u8, 78_u8];

const bc_bn_word: Array<u8, 2> =[66_u8, 78_u8];

const bc_nsm_word: Array<u8, 3> =[78_u8, 83_u8, 77_u8];

const bc_an_word: Array<u8, 2> =[65_u8, 78_u8];

const bidi_other: u8 = 0_u8;

const bidi_l: u8 = 1_u8;

const bidi_r: u8 = 2_u8;

const bidi_al: u8 = 3_u8;

const bidi_en: u8 = 4_u8;

const bidi_es: u8 = 5_u8;

const bidi_cs: u8 = 6_u8;

const bidi_et: u8 = 7_u8;

const bidi_on: u8 = 8_u8;

const bidi_bn: u8 = 9_u8;

const bidi_nsm: u8 = 10_u8;

const bidi_an: u8 = 11_u8;

fn bidi_class_id(word: &[u8]) -> result: u8 reads(word) {
  doc "Classifies one DerivedBidiClass.txt property value abbreviation into the reduced id set the CheckBidi rules need; every abbreviation this table has no separate id for (B, FSI, LRE, LRI, LRO, PDF, PDI, RLE, RLI, RLO, S, WS) becomes bidi_other, which the Bidi rule treats as disqualifying.";
  let l_ref = &bc_l_word[0_u64..bc_l_word.len];
  if field_equals(field: word, want: l_ref) {
    return bidi_l;
  }
  let r_ref = &bc_r_word[0_u64..bc_r_word.len];
  if field_equals(field: word, want: r_ref) {
    return bidi_r;
  }
  let al_ref = &bc_al_word[0_u64..bc_al_word.len];
  if field_equals(field: word, want: al_ref) {
    return bidi_al;
  }
  let en_ref = &bc_en_word[0_u64..bc_en_word.len];
  if field_equals(field: word, want: en_ref) {
    return bidi_en;
  }
  let es_ref = &bc_es_word[0_u64..bc_es_word.len];
  if field_equals(field: word, want: es_ref) {
    return bidi_es;
  }
  let cs_ref = &bc_cs_word[0_u64..bc_cs_word.len];
  if field_equals(field: word, want: cs_ref) {
    return bidi_cs;
  }
  let et_ref = &bc_et_word[0_u64..bc_et_word.len];
  if field_equals(field: word, want: et_ref) {
    return bidi_et;
  }
  let on_ref = &bc_on_word[0_u64..bc_on_word.len];
  if field_equals(field: word, want: on_ref) {
    return bidi_on;
  }
  let bn_ref = &bc_bn_word[0_u64..bc_bn_word.len];
  if field_equals(field: word, want: bn_ref) {
    return bidi_bn;
  }
  let nsm_ref = &bc_nsm_word[0_u64..bc_nsm_word.len];
  if field_equals(field: word, want: nsm_ref) {
    return bidi_nsm;
  }
  let an_ref = &bc_an_word[0_u64..bc_an_word.len];
  if field_equals(field: word, want: an_ref) {
    return bidi_an;
  }
  return bidi_other;
}

fn set_bidi_range(bidi_by_cp: &Box<Array<u8>>, value: u8, start: u64, stop: u64) -> result: unit writes(bidi_by_cp) {
  doc "Sets bidi_by_cp[cp] to value for every cp in start..stop, clamped to the table's length.";
  for (cp in start..stop) {
    let cp_ok = cp < bidi_by_cp^.inner.len;
    if cp_ok {
      set bidi_by_cp^.inner[cp] = value;
    }
  }
  return unit;
}

fn apply_bidi_defaults(bidi_by_cp: &Box<Array<u8>>) -> result: unit writes(bidi_by_cp) {
  doc "Applies DerivedBidiClass.txt's documented @missing defaults for Unicode 17.0.0, in the file's own order: Left_To_Right everywhere, then the listed Right_To_Left/Arabic_Letter/European_Terminator override ranges.";
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_l, start: 0_u64, stop: code_space);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 1424_u64, stop: 1536_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 1536_u64, stop: 1984_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 1984_u64, stop: 2144_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 2144_u64, stop: 2304_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_et, start: 8352_u64, stop: 8400_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 64285_u64, stop: 64336_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 64336_u64, stop: 64976_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 65008_u64, stop: 65024_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 65136_u64, stop: 65280_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 67584_u64, stop: 68864_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 68864_u64, stop: 68928_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 68928_u64, stop: 69312_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 69312_u64, stop: 69376_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 69376_u64, stop: 69424_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 69424_u64, stop: 69488_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 69488_u64, stop: 69632_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 124928_u64, stop: 126064_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 126064_u64, stop: 126144_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 126144_u64, stop: 126208_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 126208_u64, stop: 126288_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 126288_u64, stop: 126464_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_al, start: 126464_u64, stop: 126720_u64);
  set_bidi_range(bidi_by_cp: bidi_by_cp, value: bidi_r, start: 126720_u64, stop: 126976_u64);
  return unit;
}

fn parse_bidi_line(text: &[u8], line_start: u64, line_stop: u64, bidi_by_cp: &Box<Array<u8>>) -> result: unit reads(text), writes(bidi_by_cp) contract {
  requires line_stop <= text^.len;
} {
  doc "Parses one explicit RANGE;VALUE line of DerivedBidiClass.txt, overriding the default already applied for its range; a blank, comment, or malformed line does nothing.";
  let empty = line_start >= line_stop;
  if empty {
    return unit;
  }
  let readable = line_start < text^.len;
  if readable {
  } else {
    return unit;
  }
  let first = text^[line_start];
  let comment = first == number_sign;
  if comment {
    return unit;
  }
  let semi = find_byte(text: text, from: line_start, stop: line_stop, target: semicolon);
  let has_semi = semi < line_stop;
  if has_semi {
  } else {
    return unit;
  }
  let range_field_end = trim_ws_end(text: text, from: line_start, stop: semi);
  match parse_range(text: text, from: line_start, stop: range_field_end) {
    Some(value: found) => {
      let value_start_raw = semi +wrap 1_u64;
      let value_start = skip_ws(text: text, from: value_start_raw, stop: line_stop);
      let value_field_end = line_field_end(text: text, from: value_start, stop: line_stop);
      let value_end = trim_ws_end(text: text, from: value_start, stop: value_field_end);
      let ok = value_end <= line_stop;
      if ok {
        let word = &text^[value_start..value_end];
        let id = bidi_class_id(word: word);
        let start64 = cvt::<u32, u64>(found.start);
        let end64 = cvt::<u32, u64>(found.end);
        let stop64 = end64 +wrap 1_u64;
        set_bidi_range(bidi_by_cp: bidi_by_cp, value: id, start: start64, stop: stop64);
      }
      return unit;
    }
    None() => {
      return unit;
    }
  }
}

fn parse_derived_bidi_class(text: &[u8]) -> result: Box<Array<u8>> reads(text) {
  doc "Builds the reduced Bidi_Class id (bidi_other/bidi_l/bidi_r/bidi_al/bidi_en/bidi_es/bidi_cs/bidi_et/bidi_on/bidi_bn/bidi_nsm/bidi_an) for every code point: the file's documented @missing defaults, then every explicit RANGE;VALUE line.";
  let bidi_by_cp = box_array_filled::<u8>(count: code_space, value: bidi_l);
  apply_bidi_defaults(bidi_by_cp: &bidi_by_cp);
  let length = text^.len;
  let at = 0_u64;
  loop @lines {
    let more = at < length;
    if more {
    } else {
      return move bidi_by_cp;
    }
    let found_stop = line_end(text: text, start: at);
    let stop = imin(found_stop, length);
    parse_bidi_line(text: text, line_start: at, line_stop: stop, bidi_by_cp: &bidi_by_cp);
    set at = stop +wrap 1_u64;
  }
  return move bidi_by_cp;
}
