alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

const usage_text: Array<u8, 35> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 116_u8, 97_u8, 98_u8, 108_u8, 101_u8, 115_u8, 32_u8, 73_u8, 68_u8, 78_u8, 65_u8, 95_u8, 68_u8, 73_u8, 82_u8, 32_u8, 85_u8, 67_u8, 68_u8, 95_u8, 68_u8, 73_u8, 82_u8];

const unreadable_text: Array<u8, 49> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 111_u8, 112_u8, 101_u8, 110_u8, 32_u8, 111_u8, 114_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8, 97_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 103_u8, 105_u8, 118_u8, 101_u8, 110_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8];

const idna_mapping_filename: Array<u8, 20> =[73_u8, 100_u8, 110_u8, 97_u8, 77_u8, 97_u8, 112_u8, 112_u8, 105_u8, 110_u8, 103_u8, 84_u8, 97_u8, 98_u8, 108_u8, 101_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const bidi_class_filename: Array<u8, 20> =[68_u8, 101_u8, 114_u8, 105_u8, 118_u8, 101_u8, 100_u8, 66_u8, 105_u8, 100_u8, 105_u8, 67_u8, 108_u8, 97_u8, 115_u8, 115_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const joining_type_filename: Array<u8, 22> =[68_u8, 101_u8, 114_u8, 105_u8, 118_u8, 101_u8, 100_u8, 74_u8, 111_u8, 105_u8, 110_u8, 105_u8, 110_u8, 103_u8, 84_u8, 121_u8, 112_u8, 101_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const general_category_filename: Array<u8, 26> =[68_u8, 101_u8, 114_u8, 105_u8, 118_u8, 101_u8, 100_u8, 71_u8, 101_u8, 110_u8, 101_u8, 114_u8, 97_u8, 108_u8, 67_u8, 97_u8, 116_u8, 101_u8, 103_u8, 111_u8, 114_u8, 121_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const unicode_data_filename: Array<u8, 15> =[85_u8, 110_u8, 105_u8, 99_u8, 111_u8, 100_u8, 101_u8, 68_u8, 97_u8, 116_u8, 97_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const line_feed: u8 = 10_u8;

fn run(inputs: Inputs) -> status: ExitStatus pure {
  doc "Destructures the inputs, judges the invocation and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = generate(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn report_unreadable(files: &HandleFactory, err: &OutputStream, report: &Box<Slots<u8>>) -> result: unit writes(files), writes(err), writes(report) {
  doc "Writes the unreadable-input message to err.";
  let message = &unreadable_text[0_u64..unreadable_text.len];
  put_text(buffer: report, text: message);
  put_byte(buffer: report, value: line_feed);
  let sent = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn open_argument_directory(files: &HandleFactory, cwd: &DirectoryRead, args: &Args, position: u64) -> result: Result<DirectoryRead, unit> reads(cwd), reads(args), writes(files) {
  doc "Opens the directory named by the argument at position, relative to cwd.";
  match argument_bytes(args: args, position: position) {
    Some(value: name) => {
      let length = name.inner.len;
      let name_ref = &name.inner[0_u64..length];
      match open_directory_path(factory: files, root: cwd, name: name_ref) {
        Ok(value: directory) => {
          return Ok<DirectoryRead, unit>(value: move directory);
        }
        Err(error: problem) => {
          return Err<DirectoryRead, unit>(error: unit);
        }
      }
    }
    None() => {
      return Err<DirectoryRead, unit>(error: unit);
    }
  }
}

fn generate(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Reads the two directory arguments, opens them, reads every input file below them and, on success, delegates to build_and_emit.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 3_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    put_byte(buffer: &report, value: line_feed);
    let sent = flush(factory: files, output: err, buffer: &report);
    return 1_u8;
  }
  match open_argument_directory(files: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: idna_dir) => {
      match open_argument_directory(files: files, cwd: cwd, args: args, position: 2_u64) {
        Ok(value: ucd_dir) => {
          let inner_code = read_and_build(factory: files, idna_dir: &idna_dir, ucd_dir: &ucd_dir, out: out, err: err, report: &report);
          close_directory(factory: files, directory: move idna_dir);
          close_directory(factory: files, directory: move ucd_dir);
          return inner_code;
        }
        Err(error: problem) => {
          close_directory(factory: files, directory: move idna_dir);
          report_unreadable(files: files, err: err, report: &report);
          return 2_u8;
        }
      }
    }
    Err(error: problem) => {
      report_unreadable(files: files, err: err, report: &report);
      return 2_u8;
    }
  }
}

fn read_and_build(factory: &HandleFactory, idna_dir: &DirectoryRead, ucd_dir: &DirectoryRead, out: &OutputStream, err: &OutputStream, report: &Box<Slots<u8>>) -> code: u8 reads(idna_dir), reads(ucd_dir), writes(factory), writes(out), writes(err), writes(report) {
  doc "Reads every input file below idna_dir and ucd_dir and, on success, builds and prints every table.";
  let mapping_name = &idna_mapping_filename[0_u64..idna_mapping_filename.len];
  match read_directory_file(factory: factory, directory: idna_dir, name: mapping_name) {
    Ok(value: mapping_text) => {
      let bidi_name = &bidi_class_filename[0_u64..bidi_class_filename.len];
      match read_directory_file(factory: factory, directory: ucd_dir, name: bidi_name) {
        Ok(value: bidi_text) => {
          let joining_name = &joining_type_filename[0_u64..joining_type_filename.len];
          match read_directory_file(factory: factory, directory: ucd_dir, name: joining_name) {
            Ok(value: joining_text) => {
              let gc_name = &general_category_filename[0_u64..general_category_filename.len];
              match read_directory_file(factory: factory, directory: ucd_dir, name: gc_name) {
                Ok(value: gc_text) => {
                  let data_name = &unicode_data_filename[0_u64..unicode_data_filename.len];
                  match read_directory_file(factory: factory, directory: ucd_dir, name: data_name) {
                    Ok(value: data_text) => {
                      let mapping_len = mapping_text.inner.len;
                      let mapping_bytes = &mapping_text.inner[0_u64..mapping_len];
                      let bidi_len = bidi_text.inner.len;
                      let bidi_bytes = &bidi_text.inner[0_u64..bidi_len];
                      let joining_len = joining_text.inner.len;
                      let joining_bytes = &joining_text.inner[0_u64..joining_len];
                      let gc_len = gc_text.inner.len;
                      let gc_bytes = &gc_text.inner[0_u64..gc_len];
                      let data_len = data_text.inner.len;
                      let data_bytes = &data_text.inner[0_u64..data_len];
                      build_and_emit(factory: factory, mapping_text: mapping_bytes, bidi_text: bidi_bytes, joining_text: joining_bytes, gc_text: gc_bytes, data_text: data_bytes, out: out, report: report);
                      return 0_u8;
                    }
                    Err(error: problem) => {
                      report_unreadable(files: factory, err: err, report: report);
                      return 2_u8;
                    }
                  }
                }
                Err(error: problem) => {
                  report_unreadable(files: factory, err: err, report: report);
                  return 2_u8;
                }
              }
            }
            Err(error: problem) => {
              report_unreadable(files: factory, err: err, report: report);
              return 2_u8;
            }
          }
        }
        Err(error: problem) => {
          report_unreadable(files: factory, err: err, report: report);
          return 2_u8;
        }
      }
    }
    Err(error: problem) => {
      report_unreadable(files: factory, err: err, report: report);
      return 2_u8;
    }
  }
}
