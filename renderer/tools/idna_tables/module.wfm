alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The idna_tables entry, invoked as `idna_tables IDNA_DIR UCD_DIR` with IDNA_DIR naming, relative to the working directory, a directory holding Unicode 17.0.0's IdnaMappingTable.txt, and UCD_DIR naming a directory holding that version's DerivedBidiClass.txt, DerivedJoiningType.txt, DerivedGeneralCategory.txt and UnicodeData.txt. It reads every code point's IDNA mapping status (valid, mapped, disallowed, deviation folded into valid, ignored folded into mapped with an empty target) from IdnaMappingTable.txt; its Bidi_Class, reduced to the ids the CheckBidi rules need, from DerivedBidiClass.txt (applying the file's documented @missing defaults before its explicit entries); its Joining_Type from DerivedJoiningType.txt; whether its General_Category is Mn, Mc, or Me from DerivedGeneralCategory.txt; and whether its canonical combining class is 9 (Virama) from UnicodeData.txt. It prints to standard output the Whitefoot source of fifteen const arrays: two-stage block tables, one entry per 256-code-point block naming which deduplicated block holds its entries, then each distinct block's entries once, and flat arrays addressed by a table's own id. idna_status_block_index and idna_status_block_bytes give the reduced mapping status; idna_mapping_block_index and idna_mapping_block_ids name, per code point, an id into idna_mapping_offsets and idna_mapping_lengths, which locate its mapping target in idna_mapping_values; idna_bidi_block_index and idna_bidi_block_bytes give the reduced Bidi_Class id; idna_joining_block_index and idna_joining_block_bytes give the Joining_Type id; idna_mark_block_index and idna_mark_block_bytes give the General_Category=Mark flag; idna_virama_block_index and idna_virama_block_bytes give the Virama (canonical combining class 9) flag. It exits 0 after printing, 1 when an argument is missing, and 2 when a file cannot be read.";
