alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;

const const_word: Array<u8, 6> =[99_u8, 111_u8, 110_u8, 115_u8, 116_u8, 32_u8];

const array_u32_head: Array<u8, 13> =[58_u8, 32_u8, 65_u8, 114_u8, 114_u8, 97_u8, 121_u8, 60_u8, 117_u8, 51_u8, 50_u8, 44_u8, 32_u8];

const array_u8_head: Array<u8, 12> =[58_u8, 32_u8, 65_u8, 114_u8, 114_u8, 97_u8, 121_u8, 60_u8, 117_u8, 56_u8, 44_u8, 32_u8];

const array_u16_head: Array<u8, 13> =[58_u8, 32_u8, 65_u8, 114_u8, 114_u8, 97_u8, 121_u8, 60_u8, 117_u8, 49_u8, 54_u8, 44_u8, 32_u8];

const array_open: Array<u8, 4> =[62_u8, 32_u8, 61_u8, 91_u8];

const array_close: Array<u8, 3> =[93_u8, 59_u8, 10_u8];

const comma_space: Array<u8, 2> =[44_u8, 32_u8];

const suffix_u32: Array<u8, 4> =[95_u8, 117_u8, 51_u8, 50_u8];

const suffix_u8: Array<u8, 3> =[95_u8, 117_u8, 56_u8];

const suffix_u16: Array<u8, 4> =[95_u8, 117_u8, 49_u8, 54_u8];

const newline_byte: Array<u8, 1> =[10_u8];

fn emit_blank(factory: &HandleFactory, out: &OutputStream, report: &Box<Slots<u8>>) -> result: unit writes(factory), writes(out), writes(report) {
  doc "Writes one blank line, separating two top-level declarations.";
  let blank = &newline_byte[0_u64..newline_byte.len];
  put_text(buffer: report, text: blank);
  let sent = flush(factory: factory, output: out, buffer: report);
  return unit;
}

fn emit_name(report: &Box<Slots<u8>>, name: &[u8]) -> result: unit reads(name), writes(report) {
  doc "Writes `const NAME` to report.";
  let const_label = &const_word[0_u64..const_word.len];
  put_text(buffer: report, text: const_label);
  put_text(buffer: report, text: name);
  return unit;
}

fn emit_u32_array(factory: &HandleFactory, out: &OutputStream, report: &Box<Slots<u8>>, name: &[u8], values: &Box<Slots<u32>>) -> result: unit reads(name), reads(values.inner), writes(factory), writes(out), writes(report) {
  doc "Prints `const NAME: Array<u32, N> = [v0_u32, v1_u32, ...];` and a blank line, flushing report as it grows.";
  let count = values^.inner.len;
  emit_name(report: report, name: name);
  let head = &array_u32_head[0_u64..array_u32_head.len];
  put_text(buffer: report, text: head);
  put_decimal(buffer: report, value: count);
  let opener = &array_open[0_u64..array_open.len];
  put_text(buffer: report, text: opener);
  let source = &values^.inner[0_u64..count];
  for (index in 0_u64..count) {
    let separated = index > 0_u64;
    if separated {
      let sep = &comma_space[0_u64..comma_space.len];
      put_text(buffer: report, text: sep);
    }
    let value = source^[index];
    let widened = cvt::<u32, u64>(value);
    put_decimal(buffer: report, value: widened);
    let suffix = &suffix_u32[0_u64..suffix_u32.len];
    put_text(buffer: report, text: suffix);
    let large = report^.inner.len > 65536_u64;
    if large {
      let sent = flush(factory: factory, output: out, buffer: report);
    }
  }
  let closer = &array_close[0_u64..array_close.len];
  put_text(buffer: report, text: closer);
  let sent = flush(factory: factory, output: out, buffer: report);
  return unit;
}

fn emit_u16_array(factory: &HandleFactory, out: &OutputStream, report: &Box<Slots<u8>>, name: &[u8], values: &Box<Slots<u16>>) -> result: unit reads(name), reads(values.inner), writes(factory), writes(out), writes(report) {
  doc "Prints `const NAME: Array<u16, N> = [v0_u16, v1_u16, ...];` and a blank line, flushing report as it grows.";
  let count = values^.inner.len;
  emit_name(report: report, name: name);
  let head = &array_u16_head[0_u64..array_u16_head.len];
