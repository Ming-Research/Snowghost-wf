fn advance_cursor(ends: &[u32], cursor: u64, cp: u32) -> result: u64 reads(ends) {
  doc "Advances cursor while the range at cursor ends before cp, so ends[cursor] is the first range end at or after cp, or cursor equals ends^.len when none remains. The parallel starts and values arrays share the same length and index.";
  let count = ends^.len;
  let at = cursor;
  loop @advance {
    let more = at < count;
    if more {
    } else {
      return at;
    }
    let end = ends^[at];
    let past = cp > end;
    if past {
      set at = at +wrap 1_u64;
    } else {
      return at;
    }
  }
}

fn cursor_covers(starts: &[u32], cursor: u64, cp: u32) -> result: Bool reads(starts) {
  doc "Tells whether cp lies at or after the start of the range at cursor; call only once advance_cursor has placed cursor at the first range whose end is at or after cp, so this alone decides membership.";
  let count = starts^.len;
  let inside = cursor < count;
  if inside {
  } else {
    return False();
  }
  let start = starts^[cursor];
  let at_or_after = cp >= start;
  return at_or_after;
}
