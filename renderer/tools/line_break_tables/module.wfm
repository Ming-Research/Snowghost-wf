alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The line_break_tables entry, invoked as `line_break_tables_run DIR` with DIR naming, relative to the working directory, a directory holding the Unicode 17.0.0 character database files LineBreak.txt, EastAsianWidth.txt, DerivedGeneralCategory.txt and emoji-data.txt. It classifies every code point 0 through 0x10FFFF by Unicode Standard Annex #14's LB1 resolution, refined by East_Asian_Width (for the $EastAsian rules) and by General_Category Pi/Pf (to split QU) and Cn intersected with Extended_Pictographic (for LB30b's unassigned-emoji case), run-length-compresses the result, and prints the Whitefoot source of four public const tables to standard output: CLASS_STARTS and CLASS_VALUES (the runtime class of every code point, by binary search) and EA_WIDE_STARTS and EXT_PICT_CN_STARTS (toggle points of two boolean properties, true after an odd number of preceding starts). It exits 0 after printing, 1 when an argument is missing, and 2 when a file cannot be read.";
