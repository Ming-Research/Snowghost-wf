alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The line_break_tables entry, invoked as `line_break_tables_run DIR` with DIR naming, relative to the working directory, a directory holding the Unicode 17.0.0 character database files LineBreak.txt, EastAsianWidth.txt, DerivedGeneralCategory.txt and emoji-data.txt. It classifies every code point 0 through 0x10FFFF by Unicode Standard Annex #14's LB1 resolution, refined by East_Asian_Width (for the $EastAsian rules) and by General_Category Pi/Pf (to split QU) and Cn intersected with Extended_Pictographic (for LB30b's unassigned-emoji case), packs the three properties of each code point into one byte (runtime class in the low 6 bits, East_Asian_Width wideness in bit 6, Cn-and-Extended_Pictographic in bit 7), and prints the Whitefoot source of two public const tables to standard output: CLASS_BLOCK_INDEX, one entry per 256-code-point block naming which deduplicated block holds its bytes, and CLASS_BLOCK_BYTES, each distinct block's 256 packed bytes once. A lookup is therefore one block-index read and one packed-byte read. It exits 0 after printing, 1 when an argument is missing, and 2 when a file cannot be read.";
