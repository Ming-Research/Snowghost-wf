const lb_capacity: u64 = 4096_u64;

const gc_capacity: u64 = 2048_u64;

const wide_capacity: u64 = 512_u64;

const pict_capacity: u64 = 512_u64;

const sweep_ceiling: u64 = 1114112_u64;

struct LbRanges {
  starts: Box<Slots<u32>>;
  ends: Box<Slots<u32>>;
  values: Box<Slots<u8>>;
}

struct BoolRanges {
  starts: Box<Slots<u32>>;
  ends: Box<Slots<u32>>;
}

fn parse_lb_ranges(text: &[u8]) -> result: LbRanges reads(text) {
  doc "Parses every data line of LineBreak.txt into parallel start, end and raw-class-id arrays, in file order (already ascending).";
  let length = text^.len;
  let starts = box_slots_new::<u32>(capacity: lb_capacity);
  let ends = box_slots_new::<u32>(capacity: lb_capacity);
  let values = box_slots_new::<u8>(capacity: lb_capacity);
  let at = 0_u64;
  loop @lines {
    let more = at < length;
    if more {
    } else {
      let made = LbRanges(starts: move starts, ends: move ends, values: move values);
      return move made;
    }
    let parsed = parse_ucd_line(text: text, start: at);
    if parsed.ranged {
      let ordered = parsed.field_start <= parsed.field_end;
      let within = parsed.field_end <= length;
      if ordered {
        if within {
          let field = &text^[parsed.field_start..parsed.field_end];
          let raw_mnemonic = raw_lb_class(field: field);
          let room_starts = starts.inner.len < starts.inner.cap;
          let room_ends = ends.inner.len < ends.inner.cap;
          let room_values = values.inner.len < values.inner.cap;
          if room_starts {
            if room_ends {
              if room_values {
                place_back(window: &starts.inner, value: parsed.found.start);
                place_back(window: &ends.inner, value: parsed.found.end);
                place_back(window: &values.inner, value: raw_mnemonic);
              }
            }
          }
        }
      }
    }
    set at = parsed.next_line;
  }
  let made = LbRanges(starts: move starts, ends: move ends, values: move values);
  return move made;
}

fn parse_kind_ranges(text: &[u8], a: u8, b: u8) -> result: BoolRanges reads(text) {
  doc "Parses every data line of DerivedGeneralCategory.txt whose two-byte category field is exactly a, b into parallel start and end arrays. DerivedGeneralCategory.txt is grouped into one ascending-codepoint section per category rather than sorted as a whole, so every call scans the complete file and keeps only its own category's section, which is internally ascending; a single merged pass across categories would not be.";
  let length = text^.len;
  let starts = box_slots_new::<u32>(capacity: gc_capacity);
  let ends = box_slots_new::<u32>(capacity: gc_capacity);
  let at = 0_u64;
  loop @lines {
    let more = at < length;
    if more {
    } else {
      let made = BoolRanges(starts: move starts, ends: move ends);
      return move made;
    }
    let parsed = parse_ucd_line(text: text, start: at);
    if parsed.ranged {
      let ordered = parsed.field_start <= parsed.field_end;
      let within = parsed.field_end <= length;
      if ordered {
        if within {
          let field = &text^[parsed.field_start..parsed.field_end];
          let wanted = field_is2(field: field, a: a, b: b);
          if wanted {
            let room_starts = starts.inner.len < starts.inner.cap;
            let room_ends = ends.inner.len < ends.inner.cap;
            if room_starts {
              if room_ends {
                place_back(window: &starts.inner, value: parsed.found.start);
                place_back(window: &ends.inner, value: parsed.found.end);
              }
            }
          }
        }
      }
    }
    set at = parsed.next_line;
  }
  let made = BoolRanges(starts: move starts, ends: move ends);
  return move made;
}

fn parse_wide_ranges(text: &[u8]) -> result: BoolRanges reads(text) {
  doc "Parses every data line of EastAsianWidth.txt whose width is F, W or H into parallel start and end arrays.";
  let length = text^.len;
  let starts = box_slots_new::<u32>(capacity: wide_capacity);
  let ends = box_slots_new::<u32>(capacity: wide_capacity);
  let at = 0_u64;
  loop @lines {
    let more = at < length;
    if more {
    } else {
      let made = BoolRanges(starts: move starts, ends: move ends);
      return move made;
    }
    let parsed = parse_ucd_line(text: text, start: at);
    if parsed.ranged {
      let ordered = parsed.field_start <= parsed.field_end;
      let within = parsed.field_end <= length;
      if ordered {
        if within {
          let field = &text^[parsed.field_start..parsed.field_end];
          let wide = eaw_is_wide(field: field);
          if wide {
            let room_starts = starts.inner.len < starts.inner.cap;
            let room_ends = ends.inner.len < ends.inner.cap;
            if room_starts {
              if room_ends {
                place_back(window: &starts.inner, value: parsed.found.start);
                place_back(window: &ends.inner, value: parsed.found.end);
              }
            }
          }
        }
      }
    }
    set at = parsed.next_line;
  }
  let made = BoolRanges(starts: move starts, ends: move ends);
  return move made;
}

fn parse_pict_ranges(text: &[u8]) -> result: BoolRanges reads(text) {
  doc "Parses every data line of emoji-data.txt whose property is Extended_Pictographic into parallel start and end arrays.";
  let length = text^.len;
  let starts = box_slots_new::<u32>(capacity: pict_capacity);
  let ends = box_slots_new::<u32>(capacity: pict_capacity);
  let at = 0_u64;
  loop @lines {
    let more = at < length;
    if more {
    } else {
      let made = BoolRanges(starts: move starts, ends: move ends);
      return move made;
    }
    let parsed = parse_ucd_line(text: text, start: at);
    if parsed.ranged {
      let ordered = parsed.field_start <= parsed.field_end;
      let within = parsed.field_end <= length;
      if ordered {
        if within {
          let field = &text^[parsed.field_start..parsed.field_end];
          let pict = field_is_extended_pictographic(field: field);
          if pict {
            let room_starts = starts.inner.len < starts.inner.cap;
            let room_ends = ends.inner.len < ends.inner.cap;
            if room_starts {
              if room_ends {
                place_back(window: &starts.inner, value: parsed.found.start);
                place_back(window: &ends.inner, value: parsed.found.end);
              }
            }
          }
        }
      }
    }
    set at = parsed.next_line;
  }
  let made = BoolRanges(starts: move starts, ends: move ends);
  return move made;
}
