alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

const usage_text: Array<u8, 42> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 95_u8, 98_u8, 114_u8, 101_u8, 97_u8, 107_u8, 95_u8, 116_u8, 97_u8, 98_u8, 108_u8, 101_u8, 115_u8, 95_u8, 114_u8, 117_u8, 110_u8, 32_u8, 85_u8, 67_u8, 68_u8, 95_u8, 68_u8, 73_u8, 82_u8, 69_u8, 67_u8, 84_u8, 79_u8, 82_u8, 89_u8];

const unreadable_text: Array<u8, 49> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 111_u8, 112_u8, 101_u8, 110_u8, 32_u8, 111_u8, 114_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8, 97_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 103_u8, 105_u8, 118_u8, 101_u8, 110_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8];

const line_feed: u8 = 10_u8;

const lb_filename: Array<u8, 13> =[76_u8, 105_u8, 110_u8, 101_u8, 66_u8, 114_u8, 101_u8, 97_u8, 107_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const eaw_filename: Array<u8, 18> =[69_u8, 97_u8, 115_u8, 116_u8, 65_u8, 115_u8, 105_u8, 97_u8, 110_u8, 87_u8, 105_u8, 100_u8, 116_u8, 104_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const gc_filename: Array<u8, 26> =[68_u8, 101_u8, 114_u8, 105_u8, 118_u8, 101_u8, 100_u8, 71_u8, 101_u8, 110_u8, 101_u8, 114_u8, 97_u8, 108_u8, 67_u8, 97_u8, 116_u8, 101_u8, 103_u8, 111_u8, 114_u8, 121_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const emoji_filename: Array<u8, 14> =[101_u8, 109_u8, 111_u8, 106_u8, 105_u8, 45_u8, 100_u8, 97_u8, 116_u8, 97_u8, 46_u8, 116_u8, 120_u8, 116_u8];

const class_block_index_name: Array<u8, 17> =[99_u8, 108_u8, 97_u8, 115_u8, 115_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 105_u8, 110_u8, 100_u8, 101_u8, 120_u8];

const class_block_bytes_name: Array<u8, 17> =[99_u8, 108_u8, 97_u8, 115_u8, 115_u8, 95_u8, 98_u8, 108_u8, 111_u8, 99_u8, 107_u8, 95_u8, 98_u8, 121_u8, 116_u8, 101_u8, 115_u8];

fn run(inputs: Inputs) -> status: ExitStatus pure {
  doc "Destructures the inputs, judges the invocation and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = generate(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn generate(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Reads the one directory argument, opens it, reads the four Unicode character database files it names and, on success, delegates to build_and_emit.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    put_byte_lf(report: &report);
    let sent = flush(factory: files, output: err, buffer: &report);
    return 1_u8;
  }
  match argument_bytes(args: args, position: 1_u64) {
    Some(value: dirname) => {
      let dirname_len = dirname.inner.len;
      let dirname_ref = &dirname.inner[0_u64..dirname_len];
      match open_directory_path(factory: files, root: cwd, name: dirname_ref) {
        Ok(value: directory) => {
          let inner_code = build_and_emit(factory: files, directory: &directory, out: out, err: err, report: &report);
          close_directory(factory: files, directory: move directory);
          return inner_code;
        }
        Err(error: problem) => {
          report_unreadable(files: files, err: err, report: &report);
          return 2_u8;
        }
      }
    }
    None() => {
      report_unreadable(files: files, err: err, report: &report);
      return 2_u8;
    }
  }
}

fn put_byte_lf(report: &Box<Slots<u8>>) -> result: unit writes(report) {
  doc "Appends one line feed.";
  put_byte(buffer: report, value: line_feed);
  return unit;
}

fn report_unreadable(files: &HandleFactory, err: &OutputStream, report: &Box<Slots<u8>>) -> result: unit writes(files), writes(err), writes(report) {
  doc "Writes the unreadable-directory message to err.";
  let message = &unreadable_text[0_u64..unreadable_text.len];
  put_text(buffer: report, text: message);
  put_byte_lf(report: report);
  let sent = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn build_and_emit(factory: &HandleFactory, directory: &DirectoryRead, out: &OutputStream, err: &OutputStream, report: &Box<Slots<u8>>) -> code: u8 reads(directory), writes(factory), writes(out), writes(err), writes(report) {
  doc "Reads the four Unicode character database files below directory, parses each into ranges, sweeps every code point into the runtime tables and prints their Whitefoot source to out.";
  let lb_name = &lb_filename[0_u64..lb_filename.len];
  match read_directory_file(factory: factory, directory: directory, name: lb_name) {
    Ok(value: lb_text) => {
      let eaw_name = &eaw_filename[0_u64..eaw_filename.len];
      match read_directory_file(factory: factory, directory: directory, name: eaw_name) {
        Ok(value: eaw_text) => {
          let gc_name = &gc_filename[0_u64..gc_filename.len];
          match read_directory_file(factory: factory, directory: directory, name: gc_name) {
            Ok(value: gc_text) => {
              let emoji_name = &emoji_filename[0_u64..emoji_filename.len];
              match read_directory_file(factory: factory, directory: directory, name: emoji_name) {
                Ok(value: emoji_text) => {
                  let lb_bytes = &lb_text.inner[0_u64..lb_text.inner.len];
                  let eaw_bytes = &eaw_text.inner[0_u64..eaw_text.inner.len];
                  let gc_bytes = &gc_text.inner[0_u64..gc_text.inner.len];
                  let emoji_bytes = &emoji_text.inner[0_u64..emoji_text.inner.len];
                  let lb_ranges = parse_lb_ranges(text: lb_bytes);
                  let cn_ranges = parse_kind_ranges(text: gc_bytes, a: 67_u8, b: 110_u8);
                  let mn_ranges = parse_kind_ranges(text: gc_bytes, a: 77_u8, b: 110_u8);
                  let mc_ranges = parse_kind_ranges(text: gc_bytes, a: 77_u8, b: 99_u8);
                  let pi_ranges = parse_kind_ranges(text: gc_bytes, a: 80_u8, b: 105_u8);
                  let pf_ranges = parse_kind_ranges(text: gc_bytes, a: 80_u8, b: 102_u8);
                  let wide_ranges = parse_wide_ranges(text: eaw_bytes);
                  let pict_ranges = parse_pict_ranges(text: emoji_bytes);
                  let tables = sweep_packed(lb: &lb_ranges, cn: &cn_ranges, mn: &mn_ranges, mc: &mc_ranges, pi: &pi_ranges, pf: &pf_ranges, wide: &wide_ranges, pict: &pict_ranges);
                  let class_block_index_label = &class_block_index_name[0_u64..class_block_index_name.len];
                  emit_u16_array(factory: factory, out: out, report: report, name: class_block_index_label, values: &tables.block_index);
                  emit_blank(factory: factory, out: out, report: report);
                  let class_block_bytes_label = &class_block_bytes_name[0_u64..class_block_bytes_name.len];
                  emit_u8_array(factory: factory, out: out, report: report, name: class_block_bytes_label, values: &tables.packed_bytes);
                  return 0_u8;
                }
                Err(error: problem) => {
                  report_unreadable(files: factory, err: err, report: report);
                  return 2_u8;
                }
              }
            }
            Err(error: problem) => {
              report_unreadable(files: factory, err: err, report: report);
              return 2_u8;
            }
          }
        }
        Err(error: problem) => {
          report_unreadable(files: factory, err: err, report: report);
          return 2_u8;
        }
      }
    }
    Err(error: problem) => {
      report_unreadable(files: factory, err: err, report: report);
      return 2_u8;
    }
  }
}
