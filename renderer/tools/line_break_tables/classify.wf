fn raw_lb_class(field: &[u8]) -> result: u8 reads(field) {
  doc "Packs the Line_Break mnemonic in field (2 or 3 ASCII letters) against the 49 values LineBreak.txt uses, in their alphabetical order (AI, AK, AL, ..., ZWJ), and returns the matching raw_* index. An unrecognized field returns raw_xx.";
  let matched_ai = field_is2(field: field, a: 65_u8, b: 73_u8);
  if matched_ai {
    return raw_ai;
  }
  let matched_ak = field_is2(field: field, a: 65_u8, b: 75_u8);
  if matched_ak {
    return raw_ak;
  }
  let matched_al = field_is2(field: field, a: 65_u8, b: 76_u8);
  if matched_al {
    return raw_al;
  }
  let matched_ap = field_is2(field: field, a: 65_u8, b: 80_u8);
  if matched_ap {
    return raw_ap;
  }
  let matched_as = field_is2(field: field, a: 65_u8, b: 83_u8);
  if matched_as {
    return raw_as;
  }
  let matched_b2 = field_is2(field: field, a: 66_u8, b: 50_u8);
  if matched_b2 {
    return raw_b2;
  }
  let matched_ba = field_is2(field: field, a: 66_u8, b: 65_u8);
  if matched_ba {
    return raw_ba;
  }
  let matched_bb = field_is2(field: field, a: 66_u8, b: 66_u8);
  if matched_bb {
    return raw_bb;
  }
  let matched_bk = field_is2(field: field, a: 66_u8, b: 75_u8);
  if matched_bk {
    return raw_bk;
  }
  let matched_cb = field_is2(field: field, a: 67_u8, b: 66_u8);
  if matched_cb {
    return raw_cb;
  }
  let matched_cj = field_is2(field: field, a: 67_u8, b: 74_u8);
  if matched_cj {
    return raw_cj;
  }
  let matched_cl = field_is2(field: field, a: 67_u8, b: 76_u8);
  if matched_cl {
    return raw_cl;
  }
  let matched_cm = field_is2(field: field, a: 67_u8, b: 77_u8);
  if matched_cm {
    return raw_cm;
  }
  let matched_cp = field_is2(field: field, a: 67_u8, b: 80_u8);
  if matched_cp {
    return raw_cp;
  }
  let matched_cr = field_is2(field: field, a: 67_u8, b: 82_u8);
  if matched_cr {
    return raw_cr;
  }
  let matched_eb = field_is2(field: field, a: 69_u8, b: 66_u8);
  if matched_eb {
    return raw_eb;
  }
  let matched_em = field_is2(field: field, a: 69_u8, b: 77_u8);
  if matched_em {
    return raw_em;
  }
  let matched_ex = field_is2(field: field, a: 69_u8, b: 88_u8);
  if matched_ex {
    return raw_ex;
  }
  let matched_gl = field_is2(field: field, a: 71_u8, b: 76_u8);
  if matched_gl {
    return raw_gl;
  }
  let matched_h2 = field_is2(field: field, a: 72_u8, b: 50_u8);
  if matched_h2 {
    return raw_h2;
  }
  let matched_h3 = field_is2(field: field, a: 72_u8, b: 51_u8);
  if matched_h3 {
    return raw_h3;
  }
  let matched_hh = field_is2(field: field, a: 72_u8, b: 72_u8);
  if matched_hh {
    return raw_hh;
  }
  let matched_hl = field_is2(field: field, a: 72_u8, b: 76_u8);
  if matched_hl {
    return raw_hl;
  }
  let matched_hy = field_is2(field: field, a: 72_u8, b: 89_u8);
  if matched_hy {
    return raw_hy;
  }
  let matched_id = field_is2(field: field, a: 73_u8, b: 68_u8);
  if matched_id {
    return raw_id;
  }
  let matched_in = field_is2(field: field, a: 73_u8, b: 78_u8);
  if matched_in {
    return raw_in;
  }
  let matched_is = field_is2(field: field, a: 73_u8, b: 83_u8);
  if matched_is {
    return raw_is;
  }
  let matched_jl = field_is2(field: field, a: 74_u8, b: 76_u8);
  if matched_jl {
    return raw_jl;
  }
  let matched_jt = field_is2(field: field, a: 74_u8, b: 84_u8);
  if matched_jt {
    return raw_jt;
  }
  let matched_jv = field_is2(field: field, a: 74_u8, b: 86_u8);
  if matched_jv {
    return raw_jv;
  }
  let matched_lf = field_is2(field: field, a: 76_u8, b: 70_u8);
  if matched_lf {
    return raw_lf;
  }
  let matched_nl = field_is2(field: field, a: 78_u8, b: 76_u8);
  if matched_nl {
    return raw_nl;
  }
  let matched_ns = field_is2(field: field, a: 78_u8, b: 83_u8);
  if matched_ns {
    return raw_ns;
  }
  let matched_nu = field_is2(field: field, a: 78_u8, b: 85_u8);
  if matched_nu {
    return raw_nu;
  }
  let matched_op = field_is2(field: field, a: 79_u8, b: 80_u8);
  if matched_op {
    return raw_op;
  }
  let matched_po = field_is2(field: field, a: 80_u8, b: 79_u8);
  if matched_po {
    return raw_po;
  }
  let matched_pr = field_is2(field: field, a: 80_u8, b: 82_u8);
  if matched_pr {
    return raw_pr;
  }
  let matched_qu = field_is2(field: field, a: 81_u8, b: 85_u8);
  if matched_qu {
    return raw_qu;
  }
  let matched_ri = field_is2(field: field, a: 82_u8, b: 73_u8);
  if matched_ri {
    return raw_ri;
  }
  let matched_sa = field_is2(field: field, a: 83_u8, b: 65_u8);
  if matched_sa {
    return raw_sa;
  }
  let matched_sg = field_is2(field: field, a: 83_u8, b: 71_u8);
  if matched_sg {
    return raw_sg;
  }
  let matched_sp = field_is2(field: field, a: 83_u8, b: 80_u8);
  if matched_sp {
    return raw_sp;
  }
  let matched_sy = field_is2(field: field, a: 83_u8, b: 89_u8);
  if matched_sy {
    return raw_sy;
  }
  let matched_vf = field_is2(field: field, a: 86_u8, b: 70_u8);
  if matched_vf {
    return raw_vf;
  }
  let matched_vi = field_is2(field: field, a: 86_u8, b: 73_u8);
  if matched_vi {
    return raw_vi;
  }
  let matched_wj = field_is2(field: field, a: 87_u8, b: 74_u8);
  if matched_wj {
    return raw_wj;
  }
  let matched_xx = field_is2(field: field, a: 88_u8, b: 88_u8);
  if matched_xx {
    return raw_xx;
  }
  let matched_zw = field_is2(field: field, a: 90_u8, b: 87_u8);
  if matched_zw {
    return raw_zw;
  }
  let matched_zwj = field_is3(field: field, a: 90_u8, b: 87_u8, c: 74_u8);
  if matched_zwj {
    return raw_zwj;
  }
  return raw_xx;
}

fn eaw_is_wide(field: &[u8]) -> result: Bool reads(field) {
  doc "Tells whether an East_Asian_Width field is F, W, or H: the $EastAsian set LB19a and LB30 use.";
  let length = field^.len;
  let one = length == 1_u64;
  if one {
  } else {
    return False();
  }
  let byte0 = field^[0_u64];
  let is_f = byte0 == 70_u8;
  let is_w = byte0 == 87_u8;
  let is_h = byte0 == 72_u8;
  let is_f_or_w = bor(is_f, is_w);
  let wide = bor(is_f_or_w, is_h);
  return wide;
}

fn field_is_extended_pictographic(field: &[u8]) -> result: Bool reads(field) {
  doc "Tells whether field is exactly the 21-byte word Extended_Pictographic.";
  let length = field^.len;
  let right_len = length == 21_u64;
  if right_len {
  } else {
    return False();
  }
  let ok = True();
  let byte_0 = field^[0_u64];
  let ok_0 = byte_0 == 69_u8;
  set ok = band(ok, ok_0);
  let byte_1 = field^[1_u64];
  let ok_1 = byte_1 == 120_u8;
  set ok = band(ok, ok_1);
  let byte_2 = field^[2_u64];
  let ok_2 = byte_2 == 116_u8;
  set ok = band(ok, ok_2);
  let byte_3 = field^[3_u64];
  let ok_3 = byte_3 == 101_u8;
  set ok = band(ok, ok_3);
  let byte_4 = field^[4_u64];
  let ok_4 = byte_4 == 110_u8;
  set ok = band(ok, ok_4);
  let byte_5 = field^[5_u64];
  let ok_5 = byte_5 == 100_u8;
  set ok = band(ok, ok_5);
  let byte_6 = field^[6_u64];
  let ok_6 = byte_6 == 101_u8;
  set ok = band(ok, ok_6);
  let byte_7 = field^[7_u64];
  let ok_7 = byte_7 == 100_u8;
  set ok = band(ok, ok_7);
  let byte_8 = field^[8_u64];
  let ok_8 = byte_8 == 95_u8;
  set ok = band(ok, ok_8);
  let byte_9 = field^[9_u64];
  let ok_9 = byte_9 == 80_u8;
  set ok = band(ok, ok_9);
  let byte_10 = field^[10_u64];
  let ok_10 = byte_10 == 105_u8;
  set ok = band(ok, ok_10);
  let byte_11 = field^[11_u64];
  let ok_11 = byte_11 == 99_u8;
  set ok = band(ok, ok_11);
  let byte_12 = field^[12_u64];
  let ok_12 = byte_12 == 116_u8;
  set ok = band(ok, ok_12);
  let byte_13 = field^[13_u64];
  let ok_13 = byte_13 == 111_u8;
  set ok = band(ok, ok_13);
  let byte_14 = field^[14_u64];
  let ok_14 = byte_14 == 103_u8;
  set ok = band(ok, ok_14);
  let byte_15 = field^[15_u64];
  let ok_15 = byte_15 == 114_u8;
  set ok = band(ok, ok_15);
  let byte_16 = field^[16_u64];
  let ok_16 = byte_16 == 97_u8;
  set ok = band(ok, ok_16);
  let byte_17 = field^[17_u64];
  let ok_17 = byte_17 == 112_u8;
  set ok = band(ok, ok_17);
  let byte_18 = field^[18_u64];
  let ok_18 = byte_18 == 104_u8;
  set ok = band(ok, ok_18);
  let byte_19 = field^[19_u64];
  let ok_19 = byte_19 == 105_u8;
  set ok = band(ok, ok_19);
  let byte_20 = field^[20_u64];
  let ok_20 = byte_20 == 99_u8;
  set ok = band(ok, ok_20);
  return ok;
}

fn resolve_lb(raw: u8, is_pi: Bool, is_pf: Bool, is_mark: Bool) -> result: u8 pure {
  doc "Resolves one raw Line_Break mnemonic (raw_lb_class's raw_* index) together with three General_Category facts about the same code point to the final runtime class id LB1 fixes, named class_* to match runs.wf's runtime numbering exactly: AI, SG and XX resolve to AL; CJ to NS; SA to CM when is_mark (General_Category Mn or Mc) and to AL otherwise; QU splits into QU_PI (class_qu_pi) when is_pi (General_Category Pi), QU_PF (class_qu_pf) when is_pf (General_Category Pf), and QU_OTHER (class_qu_other) otherwise. Every other raw class keeps its own identity, renumbered into the runtime id space.";
  let is_ai = raw == raw_ai;
  if is_ai {
    return class_al;
  }
  let is_ak = raw == raw_ak;
  if is_ak {
    return class_ak;
  }
  let is_al = raw == raw_al;
  if is_al {
    return class_al;
  }
  let is_ap = raw == raw_ap;
  if is_ap {
    return class_ap;
  }
  let is_as = raw == raw_as;
  if is_as {
    return class_as;
  }
  let is_b2 = raw == raw_b2;
  if is_b2 {
    return class_b2;
  }
  let is_ba = raw == raw_ba;
  if is_ba {
    return class_ba;
  }
  let is_bb = raw == raw_bb;
  if is_bb {
    return class_bb;
  }
  let is_bk = raw == raw_bk;
  if is_bk {
    return class_bk;
  }
  let is_cb = raw == raw_cb;
  if is_cb {
    return class_cb;
  }
  let is_cj = raw == raw_cj;
  if is_cj {
    return class_ns;
  }
  let is_cl = raw == raw_cl;
  if is_cl {
    return class_cl;
  }
  let is_cm = raw == raw_cm;
  if is_cm {
    return class_cm;
  }
  let is_cp = raw == raw_cp;
  if is_cp {
    return class_cp;
  }
  let is_cr = raw == raw_cr;
  if is_cr {
    return class_cr;
  }
  let is_eb = raw == raw_eb;
  if is_eb {
    return class_eb;
  }
  let is_em = raw == raw_em;
  if is_em {
    return class_em;
  }
  let is_ex = raw == raw_ex;
  if is_ex {
    return class_ex;
  }
  let is_gl = raw == raw_gl;
  if is_gl {
    return class_gl;
  }
  let is_h2 = raw == raw_h2;
  if is_h2 {
    return class_h2;
  }
  let is_h3 = raw == raw_h3;
  if is_h3 {
    return class_h3;
  }
  let is_hh = raw == raw_hh;
  if is_hh {
    return class_hh;
  }
  let is_hl = raw == raw_hl;
  if is_hl {
    return class_hl;
  }
  let is_hy = raw == raw_hy;
  if is_hy {
    return class_hy;
  }
  let is_id = raw == raw_id;
  if is_id {
    return class_id;
  }
  let is_in = raw == raw_in;
  if is_in {
    return class_in;
  }
  let is_is = raw == raw_is;
  if is_is {
    return class_is;
  }
  let is_jl = raw == raw_jl;
  if is_jl {
    return class_jl;
  }
  let is_jt = raw == raw_jt;
  if is_jt {
    return class_jt;
  }
  let is_jv = raw == raw_jv;
  if is_jv {
    return class_jv;
  }
  let is_lf = raw == raw_lf;
  if is_lf {
    return class_lf;
  }
  let is_nl = raw == raw_nl;
  if is_nl {
    return class_nl;
  }
  let is_ns = raw == raw_ns;
  if is_ns {
    return class_ns;
  }
  let is_nu = raw == raw_nu;
  if is_nu {
    return class_nu;
  }
  let is_op = raw == raw_op;
  if is_op {
    return class_op;
  }
  let is_po = raw == raw_po;
  if is_po {
    return class_po;
  }
  let is_pr = raw == raw_pr;
  if is_pr {
    return class_pr;
  }
  let is_qu = raw == raw_qu;
  if is_qu {
    if is_pi {
      return class_qu_pi;
    }
    if is_pf {
      return class_qu_pf;
    }
    return class_qu_other;
  }
  let is_ri = raw == raw_ri;
  if is_ri {
    return class_ri;
  }
  let is_sa = raw == raw_sa;
  if is_sa {
    if is_mark {
      return class_cm;
    }
    return class_al;
  }
  let is_sg = raw == raw_sg;
  if is_sg {
    return class_al;
  }
  let is_sp = raw == raw_sp;
  if is_sp {
    return class_sp;
  }
  let is_sy = raw == raw_sy;
  if is_sy {
    return class_sy;
  }
  let is_vf = raw == raw_vf;
  if is_vf {
    return class_vf;
  }
  let is_vi = raw == raw_vi;
  if is_vi {
    return class_vi;
  }
  let is_wj = raw == raw_wj;
  if is_wj {
    return class_wj;
  }
  let is_xx = raw == raw_xx;
  if is_xx {
    return class_al;
  }
  let is_zw = raw == raw_zw;
  if is_zw {
    return class_zw;
  }
  let is_zwj = raw == raw_zwj;
  if is_zwj {
    return class_zwj;
  }
  return class_al;
}
