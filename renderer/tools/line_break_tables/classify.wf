fn raw_lb_class(field: &[u8]) -> result: u8 reads(field) {
  doc "Packs the Line_Break mnemonic in field (2 or 3 ASCII letters) against the 49 values LineBreak.txt uses and returns its alphabetical index 0 to 48. An unrecognized field returns 46, the index of XX.";
  let matched_0 = field_is2(field: field, a: 65_u8, b: 73_u8);
  if matched_0 {
    return 0_u8;
  }
  let matched_1 = field_is2(field: field, a: 65_u8, b: 75_u8);
  if matched_1 {
