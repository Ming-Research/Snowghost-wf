alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The html_entities entry, invoked as `html_entities PATH` with PATH naming the WHATWG named character reference table as JSON (the standard's table, keyed by `&name` or `&name;` with a `codepoints` array of one or two Unicode scalar values), relative to the working directory. Prints to standard output the Whitefoot source of pkg::tools::html_entities's entity_table: one EntityEntry per JSON key, its name bytes (without the leading `&`) held in a zero-padded 32-byte array with the true length, and its one or two codepoints. It exits with 0 after printing every entry, and with 2 when the file cannot be read or does not parse as this fixed shape.";
