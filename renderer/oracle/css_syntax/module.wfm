alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The css_syntax_oracle entry, invoked as `css_syntax_oracle PATH` with PATH naming the case file that tests/css/oracle.py writes, relative to the working directory: per case, the byte length in decimal, a line feed, the bytes and a line feed. For every case it runs parse_component_values and prints one line, the component list as JSON in css-parsing-tests' representation, with each number's value as the string `f64:` and the 16 lowercase hexadecimal digits of its bits. A list whose end index, span or delimiter code point is out of range prints as a JSON string that names the fault and the component's index instead. A case that parse_component_values refuses with TooLarge prints as the JSON string `\"driver: parse refused (TooLarge)\"`. It exits with 0 after printing every case, and with 2, after the cases before it, when the case file cannot be read or is malformed.";
