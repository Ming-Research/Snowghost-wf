const malformed_text: Array<u8, 47> =[99_u8, 115_u8, 115_u8, 95_u8, 115_u8, 121_u8, 110_u8, 116_u8, 97_u8, 120_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 98_u8, 121_u8, 116_u8, 101_u8, 32_u8];

const unicode_escape: Array<u8, 4> =[92_u8, 117_u8, 48_u8, 48_u8];

const source_ceiling: u64 = 16777216_u64;

const line_feed: u8 = 10_u8;

const quotation_mark: u8 = 34_u8;

const reverse_solidus: u8 = 92_u8;

const left_square_bracket: u8 = 91_u8;

const right_square_bracket: u8 = 93_u8;

const first_printable: u8 = 32_u8;

const largest_code_point: u32 = 1114111_u32;

const first_surrogate: u32 = 55296_u32;

const last_surrogate: u32 = 57343_u32;

enum Fault {
  InvalidEnd(at: u64);
  InvalidSpan(at: u64);
  InvalidCodePoint(at: u64);
}

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file: a decimal length line, that many bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let parsed = parse_decimal(text: text, start: position, end: header_end);
    let size = match parsed {
      Some(value: case_size) => {
        give case_size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let data_start = header_end +wrap 1_u64;
    let data_end = data_start +wrap size;
    let ordered = data_start <= data_end;
    let terminated = data_end < length;
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let terminator = text^[data_end];
    let closed = terminator == line_feed;
    if closed {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    print_case(text: text, start: data_start, end: data_end, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = data_end +wrap 1_u64;
  }
  return True();
}

fn print_case(text: &[u8], start: u64, end: u64, buffer: &Box<Slots<u8>>) -> result: unit reads(text), writes(buffer) {
  doc "Parses the bytes of one case from start to end and appends its JSON line, or the fault string when the case is longer than parse_component_values admits.";
  let ordered = start <= end;
  let within = end <= text^.len;
  let located = band(ordered, within);
  let admitted = False();
  if located {
    let source = &text^[start..end];
    let small = source^.len <= source_ceiling;
    if small {
      let list = parse_component_values(source: source);
      put_list(buffer: buffer, list: &list);
      set admitted = True();
    }
  }
  if admitted {
  } else {
    let message = &fault_too_large[0_u64..fault_too_large.len];
    put_text(buffer: buffer, text: message);
  }
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_list(buffer: &Box<Slots<u8>>, list: &ComponentList) -> result: unit reads(list), writes(buffer) {
  doc "Appends the whole component list as one JSON array. On a fault it removes what it appended and appends the fault string instead.";
  let mark = buffer^.inner.len;
  let count = list^.components.inner.len;
  let components = &list^.components.inner[0_u64..count];
  let text_length = list^.text.inner.len;
  let text = &list^.text.inner[0_u64..text_length];
  put_byte(buffer: buffer, value: left_square_bracket);
  let separated = False();
  match put_sequence(buffer: buffer, components: components, text: text, from: 0_u64, to: count, separated: separated) {
    Ok(value: done) => {
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Err(error: fault) => {
      truncate(buffer: buffer, length: mark);
      put_fault(buffer: buffer, fault: fault);
    }
  }
  return unit;
}

fn put_fault(buffer: &Box<Slots<u8>>, fault: Fault) -> result: unit writes(buffer) {
  doc "Appends a fault as a JSON string such as \"driver: invalid end at 7\".";
  match fault {
    InvalidEnd(at: index) => {
      let message = &fault_end[0_u64..fault_end.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: index);
    }
    InvalidSpan(at: index) => {
      let message = &fault_span[0_u64..fault_span.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: index);
    }
    InvalidCodePoint(at: index) => {
      let message = &fault_code_point[0_u64..fault_code_point.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: index);
    }
  }
  put_byte(buffer: buffer, value: quotation_mark);
  return unit;
}

fn put_sequence(buffer: &Box<Slots<u8>>, components: &[Component], text: &[u8], from: u64, to: u64, separated: Bool) -> result: Result<unit, Fault> reads(components), reads(text), writes(buffer) {
  doc "Appends the components from index from up to index to, each after a comma separator except the first when separated is False. A Function or block component is followed by its contents up to its end index, which must lie after the component and at most at to; those contents are appended inside the component's own array, and the walk continues at its end.";
  let count = components^.len;
  let at = from;
  let needs_separator = separated;
  loop @items {
    let more = at < to;
    if more {
    } else {
      break @items;
    }
    let inside = at < count;
    if inside {
    } else {
      let fault = Fault::InvalidEnd(at: at);
      return Err<unit, Fault>(error: fault);
    }
    if needs_separator {
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
    }
    set needs_separator = True();
    let component = components^[at];
    let next = at +wrap 1_u64;
    let nested = nested_end(component: component);
    match nested {
      Some(value: written_end) => {
        let closing = cvt::<u32, u64>(written_end);
        let after = closing >= next;
        let enclosed = closing <= to;
        let valid = band(after, enclosed);
        if valid {
        } else {
          let fault = Fault::InvalidEnd(at: at);
          return Err<unit, Fault>(error: fault);
        }
        let opened = propagate put_nested_head(buffer: buffer, component: component, text: text, at: at);
        let contents_separated = True();
        let contents = propagate put_sequence(buffer: buffer, components: components, text: text, from: next, to: closing, separated: contents_separated);
        put_byte(buffer: buffer, value: right_square_bracket);
        set next = closing;
      }
      None() => {
        let written = propagate put_component(buffer: buffer, component: component, text: text, at: at);
      }
    }
    set at = next;
  }
  return Ok<unit, Fault>(value: unit);
}

fn nested_end(component: Component) -> result: Option<u32> pure {
  doc "Returns the end index of a Function or block component, and None for every component that has no contents.";
  match component {
    Function(name: function_name, end: function_end) => {
      return Some<u32>(value: function_end);
    }
    ParenthesisBlock(end: block_end) => {
      return Some<u32>(value: block_end);
    }
    BracketBlock(end: block_end) => {
      return Some<u32>(value: block_end);
    }
    BraceBlock(end: block_end) => {
      return Some<u32>(value: block_end);
    }
    Ident(name: ident_name) => {
      return None<u32>();
    }
    AtKeyword(name: keyword_name) => {
      return None<u32>();
    }
    Hash(name: hash_name, kind: hash_kind) => {
      return None<u32>();
    }
    QuotedString(value: string_value) => {
      return None<u32>();
    }
    Url(value: url_value) => {
      return None<u32>();
    }
    Delim(code_point: delim_point) => {
      return None<u32>();
    }
    Number(number: numeric) => {
      return None<u32>();
    }
    Percentage(number: numeric) => {
      return None<u32>();
    }
    Dimension(number: numeric, unit_name: dimension_unit) => {
      return None<u32>();
    }
    UnicodeRange(start: range_start, end: range_end) => {
      return None<u32>();
    }
    IncludeMatch() => {
      return None<u32>();
    }
    DashMatch() => {
      return None<u32>();
    }
    PrefixMatch() => {
      return None<u32>();
    }
    SuffixMatch() => {
      return None<u32>();
    }
    SubstringMatch() => {
      return None<u32>();
    }
    Column() => {
      return None<u32>();
    }
    Whitespace() => {
      return None<u32>();
    }
    Cdo() => {
      return None<u32>();
    }
    Cdc() => {
      return None<u32>();
    }
    Colon() => {
      return None<u32>();
    }
    Semicolon() => {
      return None<u32>();
    }
    Comma() => {
      return None<u32>();
    }
    Error(error: parse_error) => {
      return None<u32>();
    }
  }
}

fn put_nested_head(buffer: &Box<Slots<u8>>, component: Component, text: &[u8], at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends the opening of a Function or block component's array: `[\"function\", NAME`, `[\"()\"`, `[\"[]\"` or `[\"{}\"`. Its contents and the closing bracket follow from put_sequence. Appends nothing for any other component.";
  match component {
    Function(name: function_name, end: function_end) => {
      let head = &head_function[0_u64..head_function.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_span(buffer: buffer, text: text, span: function_name, at: at);
    }
    ParenthesisBlock(end: block_end) => {
      let head = &head_parenthesis_block[0_u64..head_parenthesis_block.len];
      put_text(buffer: buffer, text: head);
    }
    BracketBlock(end: block_end) => {
      let head = &head_bracket_block[0_u64..head_bracket_block.len];
      put_text(buffer: buffer, text: head);
    }
    BraceBlock(end: block_end) => {
      let head = &head_brace_block[0_u64..head_brace_block.len];
      put_text(buffer: buffer, text: head);
    }
    Ident(name: ident_name) => {
    }
    AtKeyword(name: keyword_name) => {
    }
    Hash(name: hash_name, kind: hash_kind) => {
    }
    QuotedString(value: string_value) => {
    }
    Url(value: url_value) => {
    }
    Delim(code_point: delim_point) => {
    }
    Number(number: numeric) => {
    }
    Percentage(number: numeric) => {
    }
    Dimension(number: numeric, unit_name: dimension_unit) => {
    }
    UnicodeRange(start: range_start, end: range_end) => {
    }
    IncludeMatch() => {
    }
    DashMatch() => {
    }
    PrefixMatch() => {
    }
    SuffixMatch() => {
    }
    SubstringMatch() => {
    }
    Column() => {
    }
    Whitespace() => {
    }
    Cdo() => {
    }
    Cdc() => {
    }
    Colon() => {
    }
    Semicolon() => {
    }
    Comma() => {
    }
    Error(error: parse_error) => {
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn put_component(buffer: &Box<Slots<u8>>, component: Component, text: &[u8], at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends one component that has no contents in css-parsing-tests' representation. Appends nothing for a Function or block component, which put_nested_head and put_sequence write.";
  match component {
    Ident(name: ident_name) => {
      let head = &head_ident[0_u64..head_ident.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_span(buffer: buffer, text: text, span: ident_name, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    AtKeyword(name: keyword_name) => {
      let head = &head_at_keyword[0_u64..head_at_keyword.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_span(buffer: buffer, text: text, span: keyword_name, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Hash(name: hash_name, kind: hash_kind) => {
      let head = &head_hash[0_u64..head_hash.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_span(buffer: buffer, text: text, span: hash_name, at: at);
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
      put_hash_kind(buffer: buffer, kind: hash_kind);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    QuotedString(value: string_value) => {
      let head = &head_string[0_u64..head_string.len];
      put_text(buffer: buffer, text: head);
      let valued = propagate put_span(buffer: buffer, text: text, span: string_value, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Url(value: url_value) => {
      let head = &head_url[0_u64..head_url.len];
      put_text(buffer: buffer, text: head);
      let valued = propagate put_span(buffer: buffer, text: text, span: url_value, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Delim(code_point: delim_point) => {
      let delimited = propagate put_code_point_string(buffer: buffer, code_point: delim_point, at: at);
    }
    Number(number: numeric) => {
      let head = &head_number[0_u64..head_number.len];
      put_text(buffer: buffer, text: head);
      let numbered = propagate put_numeric(buffer: buffer, number: numeric, text: text, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Percentage(number: numeric) => {
      let head = &head_percentage[0_u64..head_percentage.len];
      put_text(buffer: buffer, text: head);
      let numbered = propagate put_numeric(buffer: buffer, number: numeric, text: text, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Dimension(number: numeric, unit_name: dimension_unit) => {
      let head = &head_dimension[0_u64..head_dimension.len];
      put_text(buffer: buffer, text: head);
      let numbered = propagate put_numeric(buffer: buffer, number: numeric, text: text, at: at);
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
      let united = propagate put_span(buffer: buffer, text: text, span: dimension_unit, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    UnicodeRange(start: range_start, end: range_end) => {
      let head = &head_unicode_range[0_u64..head_unicode_range.len];
      put_text(buffer: buffer, text: head);
      let first = cvt::<u32, u64>(range_start);
      put_decimal(buffer: buffer, value: first);
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
      let last = cvt::<u32, u64>(range_end);
      put_decimal(buffer: buffer, value: last);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    IncludeMatch() => {
      let token = &include_match_text[0_u64..include_match_text.len];
      put_text(buffer: buffer, text: token);
    }
    DashMatch() => {
      let token = &dash_match_text[0_u64..dash_match_text.len];
      put_text(buffer: buffer, text: token);
    }
    PrefixMatch() => {
      let token = &prefix_match_text[0_u64..prefix_match_text.len];
      put_text(buffer: buffer, text: token);
    }
    SuffixMatch() => {
      let token = &suffix_match_text[0_u64..suffix_match_text.len];
      put_text(buffer: buffer, text: token);
    }
    SubstringMatch() => {
      let token = &substring_match_text[0_u64..substring_match_text.len];
      put_text(buffer: buffer, text: token);
    }
    Column() => {
      let token = &column_text[0_u64..column_text.len];
      put_text(buffer: buffer, text: token);
    }
    Whitespace() => {
      let token = &whitespace_text[0_u64..whitespace_text.len];
      put_text(buffer: buffer, text: token);
    }
    Cdo() => {
      let token = &cdo_text[0_u64..cdo_text.len];
      put_text(buffer: buffer, text: token);
    }
    Cdc() => {
      let token = &cdc_text[0_u64..cdc_text.len];
      put_text(buffer: buffer, text: token);
    }
    Colon() => {
      let token = &colon_text[0_u64..colon_text.len];
      put_text(buffer: buffer, text: token);
    }
    Semicolon() => {
      let token = &semicolon_text[0_u64..semicolon_text.len];
      put_text(buffer: buffer, text: token);
    }
    Comma() => {
      let token = &comma_text[0_u64..comma_text.len];
      put_text(buffer: buffer, text: token);
    }
    Error(error: parse_error) => {
      let head = &head_error[0_u64..head_error.len];
      put_text(buffer: buffer, text: head);
      put_error_name(buffer: buffer, error: parse_error);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Function(name: function_name, end: function_end) => {
    }
    ParenthesisBlock(end: block_end) => {
    }
    BracketBlock(end: block_end) => {
    }
    BraceBlock(end: block_end) => {
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn put_hash_kind(buffer: &Box<Slots<u8>>, kind: HashKind) -> result: unit writes(buffer) {
  doc "Appends the type flag of a hash token: \"id\" or \"unrestricted\".";
  match kind {
    Id() => {
      let flag = &kind_id[0_u64..kind_id.len];
      put_text(buffer: buffer, text: flag);
    }
    Unrestricted() => {
      let flag = &kind_unrestricted[0_u64..kind_unrestricted.len];
      put_text(buffer: buffer, text: flag);
    }
  }
  return unit;
}

fn put_error_name(buffer: &Box<Slots<u8>>, error: ParseError) -> result: unit writes(buffer) {
  doc "Appends the css-parsing-tests name of a parse error as a JSON string.";
  match error {
    BadString() => {
      let name = &error_bad_string[0_u64..error_bad_string.len];
      put_text(buffer: buffer, text: name);
    }
    BadUrl() => {
      let name = &error_bad_url[0_u64..error_bad_url.len];
      put_text(buffer: buffer, text: name);
    }
    EofInString() => {
      let name = &error_eof_in_string[0_u64..error_eof_in_string.len];
      put_text(buffer: buffer, text: name);
    }
    EofInUrl() => {
      let name = &error_eof_in_url[0_u64..error_eof_in_url.len];
      put_text(buffer: buffer, text: name);
    }
    UnmatchedParenthesis() => {
      let name = &error_parenthesis[0_u64..error_parenthesis.len];
      put_text(buffer: buffer, text: name);
    }
    UnmatchedBracket() => {
      let name = &error_bracket[0_u64..error_bracket.len];
      put_text(buffer: buffer, text: name);
    }
    UnmatchedBrace() => {
      let name = &error_brace[0_u64..error_brace.len];
      put_text(buffer: buffer, text: name);
    }
  }
  return unit;
}

fn put_numeric(buffer: &Box<Slots<u8>>, number: Numeric, text: &[u8], at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends the three numeric fields shared by number, percentage and dimension tokens: the representation, the value as \"f64:\" and 16 lowercase hexadecimal digits of its bits, and the type flag \"integer\" or \"number\".";
  let spelled = propagate put_span(buffer: buffer, text: text, span: number.representation, at: at);
  let separator = &item_separator[0_u64..item_separator.len];
  put_text(buffer: buffer, text: separator);
  let prefix = &value_prefix[0_u64..value_prefix.len];
  put_text(buffer: buffer, text: prefix);
  let bits = reinterpret::<f64, u64>(number.value);
  let lowercase = False();
  put_hex(buffer: buffer, value: bits, width: 16_u64, uppercase: lowercase);
  put_byte(buffer: buffer, value: quotation_mark);
  put_text(buffer: buffer, text: separator);
  match number.kind {
    Integer() => {
      let flag = &kind_integer[0_u64..kind_integer.len];
      put_text(buffer: buffer, text: flag);
    }
    Number() => {
      let flag = &kind_number[0_u64..kind_number.len];
      put_text(buffer: buffer, text: flag);
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn put_span(buffer: &Box<Slots<u8>>, text: &[u8], span: Span, at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends the bytes of text that span covers as a JSON string. A span that ends before it starts or past the end of text is the fault InvalidSpan of the component at index at.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first <= last;
  let within = last <= text^.len;
  let valid = band(ordered, within);
  if valid {
  } else {
    let fault = Fault::InvalidSpan(at: at);
    return Err<unit, Fault>(error: fault);
  }
  put_byte(buffer: buffer, value: quotation_mark);
  for (index in first..last) {
    let byte = text^[index];
    put_json_byte(buffer: buffer, byte: byte);
  }
  put_byte(buffer: buffer, value: quotation_mark);
  return Ok<unit, Fault>(value: unit);
}

fn put_json_byte(buffer: &Box<Slots<u8>>, byte: u8) -> result: unit writes(buffer) {
  doc "Appends one byte of a JSON string: a quotation mark or reverse solidus after a reverse solidus, a byte below 0x20 as a \\u00XX escape, and every other byte, UTF-8 included, unchanged.";
  let quote = byte == quotation_mark;
  let solidus = byte == reverse_solidus;
  let escaped = bor(quote, solidus);
  if escaped {
    put_byte(buffer: buffer, value: reverse_solidus);
    put_byte(buffer: buffer, value: byte);
    return unit;
  }
  let control = byte < first_printable;
  if control {
    let escape = &unicode_escape[0_u64..unicode_escape.len];
    put_text(buffer: buffer, text: escape);
    let widened = cvt::<u8, u64>(byte);
    let uppercase = True();
    put_hex(buffer: buffer, value: widened, width: 2_u64, uppercase: uppercase);
    return unit;
  }
  put_byte(buffer: buffer, value: byte);
  return unit;
}

fn put_code_point_string(buffer: &Box<Slots<u8>>, code_point: u32, at: u64) -> result: Result<unit, Fault> writes(buffer) {
  doc "Appends a delimiter as a one-character JSON string, encoding its code point as UTF-8. A surrogate or a value past U+10FFFF is the fault InvalidCodePoint of the component at index at.";
  let beyond = code_point > largest_code_point;
  let above_first = code_point >= first_surrogate;
  let below_last = code_point <= last_surrogate;
  let surrogate = band(above_first, below_last);
  let invalid = bor(beyond, surrogate);
  if invalid {
    let fault = Fault::InvalidCodePoint(at: at);
    return Err<unit, Fault>(error: fault);
  }
  put_byte(buffer: buffer, value: quotation_mark);
  let one_byte = code_point < 128_u32;
  let two_bytes = code_point < 2048_u32;
  let three_bytes = code_point < 65536_u32;
  if one_byte {
    let byte = cvt.wrap::<u32, u8>(code_point);
    put_json_byte(buffer: buffer, byte: byte);
  } else if two_bytes {
    let lead = utf8_lead(code_point: code_point, shift: 6_u32, marker: 192_u32);
    let last = utf8_continuation(code_point: code_point, shift: 0_u32);
    put_byte(buffer: buffer, value: lead);
    put_byte(buffer: buffer, value: last);
  } else if three_bytes {
    let lead = utf8_lead(code_point: code_point, shift: 12_u32, marker: 224_u32);
    let middle = utf8_continuation(code_point: code_point, shift: 6_u32);
    let last = utf8_continuation(code_point: code_point, shift: 0_u32);
    put_byte(buffer: buffer, value: lead);
    put_byte(buffer: buffer, value: middle);
    put_byte(buffer: buffer, value: last);
  } else {
    let lead = utf8_lead(code_point: code_point, shift: 18_u32, marker: 240_u32);
    let upper = utf8_continuation(code_point: code_point, shift: 12_u32);
    let middle = utf8_continuation(code_point: code_point, shift: 6_u32);
    let last = utf8_continuation(code_point: code_point, shift: 0_u32);
    put_byte(buffer: buffer, value: lead);
    put_byte(buffer: buffer, value: upper);
    put_byte(buffer: buffer, value: middle);
    put_byte(buffer: buffer, value: last);
  }
  put_byte(buffer: buffer, value: quotation_mark);
  return Ok<unit, Fault>(value: unit);
}

fn utf8_lead(code_point: u32, shift: u32, marker: u32) -> result: u8 pure {
  doc "Returns the lead byte of a UTF-8 sequence: the bits of code_point from shift upward, joined with marker.";
  let high = ishr.wrap(code_point, shift);
  let joined = ior(high, marker);
  let byte = cvt.wrap::<u32, u8>(joined);
  return byte;
}

fn utf8_continuation(code_point: u32, shift: u32) -> result: u8 pure {
  doc "Returns the UTF-8 continuation byte that carries the six bits of code_point starting at shift.";
  let moved = ishr.wrap(code_point, shift);
  let bits = iand(moved, 63_u32);
  let joined = ior(bits, 128_u32);
  let byte = cvt.wrap::<u32, u8>(joined);
  return byte;
}
