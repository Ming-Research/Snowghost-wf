alias Args = std::text::Args;
alias ComponentList = pkg::css::syntax::ComponentList;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias SyntaxError = pkg::css::syntax::SyntaxError;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias parse_component_values = pkg::css::syntax::parse_component_values;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_components = pkg::oracle::css_json::put_components;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_fault = pkg::oracle::css_json::put_fault;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;

const fault_too_large: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const refused_too_large: Array<u8, 34> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 112_u8, 97_u8, 114_u8, 115_u8, 101_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8, 40_u8, 84_u8, 111_u8, 111_u8, 76_u8, 97_u8, 114_u8, 103_u8, 101_u8, 41_u8, 34_u8];

const usage_text: Array<u8, 30> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 99_u8, 115_u8, 115_u8, 95_u8, 115_u8, 121_u8, 110_u8, 116_u8, 97_u8, 120_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 31> =[99_u8, 115_u8, 115_u8, 95_u8, 115_u8, 121_u8, 110_u8, 116_u8, 97_u8, 120_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const malformed_text: Array<u8, 47> =[99_u8, 115_u8, 115_u8, 95_u8, 115_u8, 121_u8, 110_u8, 116_u8, 97_u8, 120_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 98_u8, 121_u8, 116_u8, 101_u8, 32_u8];

const source_ceiling: u64 = 16777216_u64;

const line_feed: u8 = 10_u8;

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file: a decimal length line, that many bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let parsed = parse_decimal(text: text, start: position, end: header_end);
    let size = match parsed {
      Some(value: case_size) => {
        give case_size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let data_start = header_end +wrap 1_u64;
    let data_end = data_start +wrap size;
    let ordered = data_start <= data_end;
    let terminated = data_end < length;
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let terminator = text^[data_end];
    let closed = terminator == line_feed;
    if closed {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    print_case(text: text, start: data_start, end: data_end, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = data_end +wrap 1_u64;
  }
  return True();
}

fn print_case(text: &[u8], start: u64, end: u64, buffer: &Box<Slots<u8>>) -> result: unit reads(text), writes(buffer) {
  doc "Parses the bytes of one case from start to end and appends its JSON line, the refusal string when parse_component_values refuses it, or the fault string when the case is longer than parse_component_values admits.";
  let ordered = start <= end;
  let within = end <= text^.len;
  let located = band(ordered, within);
  let admitted = False();
  if located {
    let source = &text^[start..end];
    let small = source^.len <= source_ceiling;
    if small {
      match parse_component_values(source: source) {
        Ok(value: list) => {
          put_list(buffer: buffer, list: &list);
        }
        Err(error: refusal) => {
          put_refusal(buffer: buffer, refusal: refusal);
        }
      }
      set admitted = True();
    }
  }
  if admitted {
  } else {
    let message = &fault_too_large[0_u64..fault_too_large.len];
    put_text(buffer: buffer, text: message);
  }
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_refusal(buffer: &Box<Slots<u8>>, refusal: SyntaxError) -> result: unit writes(buffer) {
  doc "Appends the JSON string that names why parse_component_values refused a case.";
  match refusal {
    TooLarge() => {
      let message = &refused_too_large[0_u64..refused_too_large.len];
      put_text(buffer: buffer, text: message);
    }
  }
  return unit;
}

fn put_list(buffer: &Box<Slots<u8>>, list: &ComponentList) -> result: unit reads(list), writes(buffer) {
  doc "Appends the whole component list as one JSON array, or the fault string instead when the list is malformed.";
  let count = list^.components.inner.len;
  match put_components(buffer: buffer, list: list, from: 0_u64, to: count) {
    Ok(value: done) => {
    }
    Err(error: fault) => {
      put_fault(buffer: buffer, fault: fault);
    }
  }
  return unit;
}
