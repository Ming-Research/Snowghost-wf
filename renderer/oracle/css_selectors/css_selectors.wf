alias AnPlusB = pkg::css::selectors::AnPlusB;
alias Args = std::text::Args;
alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias AttributeNamespace = pkg::dom::AttributeNamespace;
alias ComponentList = pkg::css::syntax::ComponentList;
alias ComponentRange = pkg::css::rules::ComponentRange;
alias DirectoryRead = std::fs::DirectoryRead;
alias Document = pkg::dom::Document;
alias DomError = pkg::dom::DomError;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias Links = pkg::dom::Links;
alias MatchContext = pkg::css::selectors::MatchContext;
alias Namespace = pkg::dom::Namespace;
alias NodeData = pkg::dom::NodeData;
alias NodeId = pkg::dom::NodeId;
alias OutputStream = std::io::OutputStream;
alias SelectorList = pkg::css::selectors::SelectorList;
alias TextSpan = pkg::dom::TextSpan;
alias TreeError = pkg::html::tree_builder::TreeError;
alias add_attribute = pkg::dom::add_attribute;
alias append_child = pkg::dom::append_child;
alias args_count = std::text::args_count;
alias atom_div = pkg::base::static_atoms::atom_div;
alias atom_id = pkg::base::static_atoms::atom_id;
alias atom_intern = pkg::base::atom::atom_intern;
alias atom_table_new = pkg::base::atom::atom_table_new;
alias close_directory = std::fs::close_directory;
alias create_node = pkg::dom::create_node;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias parse_an_plus_b = pkg::css::selectors::parse_an_plus_b;
alias parse_component_values = pkg::css::syntax::parse_component_values;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias parse_document = pkg::html::tree_builder::parse_document;
alias parse_selector_list = pkg::css::selectors::parse_selector_list;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_hex = pkg::oracle::support::put_hex;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;
alias selector_matches = pkg::css::selectors::selector_matches;
alias store_text = pkg::dom::store_text;

enum BuildFault {
  Oversize();
  Parse(error: TreeError);
  Links();
  NoRoot();
  Refused(error: DomError);
  Interning();
}

enum Step {
  Next(node: NodeId);
  Done();
  Broken();
}

const null_word: Array<u8, 4> = "null";

const undefined_word: Array<u8, 9> = "undefined";

const root_word: Array<u8, 4> = "root";

const target_word: Array<u8, 6> = "target";

const any_namespace_word: Array<u8, 13> = "any-namespace";

const any_namespace_first: Array<u8, 18> = "any-namespace-div1";

const any_namespace_second: Array<u8, 18> = "any-namespace-div2";

const no_namespace_word: Array<u8, 12> = "no-namespace";

const no_namespace_first: Array<u8, 17> = "no-namespace-div1";

const no_namespace_second: Array<u8, 17> = "no-namespace-div2";

const null_text: Array<u8, 4> = "null";

const item_separator: Array<u8, 2> = ", ";

const escape_prefix: Array<u8, 2> = "\\u";

const selectors_too_large: Array<u8, 19> = "\"driver: too large\"";

const element_without_id: Array<u8, 28> = "\"driver: element without id\"";

const id_outside_text: Array<u8, 29> = "\"driver: id outside the text\"";

const refused_tokenizer: Array<u8, 27> = "\"driver: tokenizer refused\"";

const case_too_large: Array<u8, 24> = "\"driver: case too large\"";

const components_too_many: Array<u8, 33> = "\"driver: component list too long\"";

const usage_text: Array<u8, 42> = "usage: css_selectors_oracle CONTENT CASES\n";

const unreadable_text: Array<u8, 34> = "css_selectors_oracle: cannot read ";

const malformed_text: Array<u8, 50> = "css_selectors_oracle: malformed case file at byte ";

const unbuilt_text: Array<u8, 49> = "css_selectors_oracle: cannot build the document: ";

const oversize_text: Array<u8, 22> = "content file too large";

const parse_too_large_text: Array<u8, 23> = "parse failed (TooLarge)";

const parse_refused_text: Array<u8, 18> = "parse failed (Dom ";

const links_text: Array<u8, 27> = "tree links are inconsistent";

const no_root_text: Array<u8, 26> = "no element has the id root";

const refused_text: Array<u8, 30> = "a document operation refused (";

const interning_text: Array<u8, 26> = "atom_intern refused a name";

const invalid_node_text: Array<u8, 11> = "InvalidNode";

const wrong_kind_text: Array<u8, 9> = "WrongKind";

const dom_too_large_text: Array<u8, 8> = "TooLarge";

const content_ceiling: u64 = 1073741824_u64;

const source_ceiling: u64 = 16777216_u64;

const component_ceiling: u64 = 4294967295_u64;

const list_ceiling: u64 = 4294967296_u64;

const an_plus_b_kind: u64 = 0_u64;

const selector_kind: u64 = 1_u64;

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge_files(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_files(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads and builds the content document named by the first argument, then reads the case file named by the second and prints its cases; returns 0 when everything was read, built and well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 3_u64;
  if usable {
  } else {
    put_text(buffer: &report, text: &usage_text[0_u64..usage_text.len]);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let source = &content.inner[0_u64..length];
      let atoms = atom_table_new();
      let small = length <= content_ceiling;
      if small {
      } else {
        let fault = BuildFault::Oversize();
        report_unbuilt(err: err, files: files, report: &report, fault: fault);
        return 2_u8;
      }
      match build_document(source: source, atoms: &atoms) {
        Ok(value: document) => {
          let elements = box_slots_new::<NodeId>(capacity: 256_u64);
          let walked = collect_elements(document: &document, elements: &elements);
          if walked {
          } else {
            let fault = BuildFault::Links();
            report_unbuilt(err: err, files: files, report: &report, fault: fault);
            return 2_u8;
          }
          let placed = elements.inner.len;
          let order = &elements.inner[0_u64..placed];
          let target = find_id(document: &document, elements: order, value: &target_word[0_u64..target_word.len]);
          let code = judge_cases(args: args, cwd: cwd, out: out, err: err, files: files, report: &report, document: &document, elements: order, target: target, atoms: &atoms);
          return code;
        }
        Err(error: fault) => {
          report_unbuilt(err: err, files: files, report: &report, fault: fault);
          return 2_u8;
        }
      }
    }
    Err(error: problem) => {
      report_unreadable(err: err, files: files, report: &report, args: args, position: 1_u64, problem: problem);
      return 2_u8;
    }
  }
}

fn judge_cases(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, document: &Document, elements: &[NodeId], target: Option<NodeId>, atoms: &AtomTable) -> code: u8 reads(args), reads(cwd), reads(document), reads(elements), writes(out), writes(err), writes(files), writes(report), writes(atoms) waits {
  doc "Reads the case file named by the second argument and prints its cases against document, whose elements in tree order are elements; returns 0 when the file was read and well formed and 2 otherwise.";
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 2_u64) {
    Ok(value: cases) => {
      let length = cases.inner.len;
      let text = &cases.inner[0_u64..length];
      let complete = print_cases(text: text, document: document, elements: elements, target: target, atoms: atoms, out: out, err: err, files: files, report: report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      report_unreadable(err: err, files: files, report: report, args: args, position: 2_u64, problem: problem);
      return 2_u8;
    }
  }
}

fn report_unreadable(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, position: u64, problem: std::io::IoError) -> result: unit reads(args), writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the file the argument at position names cannot be read.";
  put_text(buffer: report, text: &unreadable_text[0_u64..unreadable_text.len]);
  put_argument(buffer: report, args: args, position: position);
  put_host_error(buffer: report, error: problem);
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  put_text(buffer: report, text: &malformed_text[0_u64..malformed_text.len]);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_unbuilt(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, fault: BuildFault) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error why the content document could not be built.";
  put_text(buffer: report, text: &unbuilt_text[0_u64..unbuilt_text.len]);
  match fault {
    Oversize() => {
      put_text(buffer: report, text: &oversize_text[0_u64..oversize_text.len]);
    }
    Parse(error: failure) => {
      match failure {
        TooLarge() => {
          put_text(buffer: report, text: &parse_too_large_text[0_u64..parse_too_large_text.len]);
        }
        Dom(error: refusal) => {
          put_text(buffer: report, text: &parse_refused_text[0_u64..parse_refused_text.len]);
          put_dom_error(buffer: report, refusal: refusal);
          put_byte(buffer: report, value: ')'_u8);
        }
      }
    }
    Links() => {
      put_text(buffer: report, text: &links_text[0_u64..links_text.len]);
    }
    NoRoot() => {
      put_text(buffer: report, text: &no_root_text[0_u64..no_root_text.len]);
    }
    Refused(error: refusal) => {
      put_text(buffer: report, text: &refused_text[0_u64..refused_text.len]);
      put_dom_error(buffer: report, refusal: refusal);
      put_byte(buffer: report, value: ')'_u8);
    }
    Interning() => {
      put_text(buffer: report, text: &interning_text[0_u64..interning_text.len]);
    }
  }
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn put_dom_error(buffer: &Box<Slots<u8>>, refusal: DomError) -> result: unit writes(buffer) {
  doc "Appends the name of a DomError.";
  match refusal {
    InvalidNode() => {
      put_text(buffer: buffer, text: &invalid_node_text[0_u64..invalid_node_text.len]);
    }
    WrongKind() => {
      put_text(buffer: buffer, text: &wrong_kind_text[0_u64..wrong_kind_text.len]);
    }
    TooLarge() => {
      put_text(buffer: buffer, text: &dom_too_large_text[0_u64..dom_too_large_text.len]);
    }
  }
  return unit;
}

fn build_document(source: &[u8], atoms: &AtomTable) -> result: Result<Document, BuildFault> reads(source), writes(atoms) contract {
  requires source^.len <= 1073741824_u64;
} {
  doc "Parses source as a whole document with scripting off and adds the special elements under the first element in tree order whose id is `root`.";
  let scripting = False();
  let parsed = parse_document(source: source, scripting: scripting, atoms: atoms);
  match move parsed {
    Ok(value: document) => {
      let elements = box_slots_new::<NodeId>(capacity: 256_u64);
      let walked = collect_elements(document: &document, elements: &elements);
      if walked {
      } else {
        let fault = BuildFault::Links();
        return Err<Document, BuildFault>(error: fault);
      }
      let placed = elements.inner.len;
      let found = find_id(document: &document, elements: &elements.inner[0_u64..placed], value: &root_word[0_u64..root_word.len]);
      let root = match found {
        Some(value: holder) => {
          give holder;
        }
        None() => {
          let fault = BuildFault::NoRoot();
          return Err<Document, BuildFault>(error: fault);
        }
      }
      let null_name = match atom_intern(table: atoms, name: &null_word[0_u64..null_word.len]) {
        Ok(value: name) => {
          give name;
        }
        Err(error: refusal) => {
          let fault = BuildFault::Interning();
          return Err<Document, BuildFault>(error: fault);
        }
      }
      let undefined_name = match atom_intern(table: atoms, name: &undefined_word[0_u64..undefined_word.len]) {
        Ok(value: name) => {
          give name;
        }
        Err(error: refusal) => {
          let fault = BuildFault::Interning();
          return Err<Document, BuildFault>(error: fault);
        }
      }
      match add_special_elements(document: &document, root: root, null_name: null_name, undefined_name: undefined_name) {
        Ok(value: done) => {
        }
        Err(error: refusal) => {
          let fault = BuildFault::Refused(error: refusal);
          return Err<Document, BuildFault>(error: fault);
        }
      }
      return Ok<Document, BuildFault>(value: move document);
    }
    Err(error: failure) => {
      let fault = BuildFault::Parse(error: failure);
      return Err<Document, BuildFault>(error: fault);
    }
  }
}

fn add_special_elements(document: &Document, root: NodeId, null_name: Atom, undefined_name: Atom) -> result: Result<unit, DomError> writes(document) {
  doc "Appends to root, in the order WPT's setupSpecialElements does, the elements of it that pkg::dom can represent: the HTML elements null and undefined, then div#any-namespace holding div#any-namespace-div1 and div#any-namespace-div2, then div#no-namespace holding div#no-namespace-div1 and div#no-namespace-div2.";
  let div = Atom(index: atom_div);
  let null_element = propagate new_element(document: document, name: null_name);
  let null_placed = propagate append_child(document: document, parent: root, child: null_element);
  let undefined_element = propagate new_element(document: document, name: undefined_name);
  let undefined_placed = propagate append_child(document: document, parent: root, child: undefined_element);
  let any_namespace = propagate new_element(document: document, name: div);
  let any_named = propagate set_id(document: document, element: any_namespace, value: &any_namespace_word[0_u64..any_namespace_word.len]);
  let any_first = propagate new_element(document: document, name: div);
  let any_first_named = propagate set_id(document: document, element: any_first, value: &any_namespace_first[0_u64..any_namespace_first.len]);
  let any_first_placed = propagate append_child(document: document, parent: any_namespace, child: any_first);
  let any_second = propagate new_element(document: document, name: div);
  let any_second_named = propagate set_id(document: document, element: any_second, value: &any_namespace_second[0_u64..any_namespace_second.len]);
  let any_second_placed = propagate append_child(document: document, parent: any_namespace, child: any_second);
  let any_placed = propagate append_child(document: document, parent: root, child: any_namespace);
  let no_namespace = propagate new_element(document: document, name: div);
  let no_named = propagate set_id(document: document, element: no_namespace, value: &no_namespace_word[0_u64..no_namespace_word.len]);
  let no_first = propagate new_element(document: document, name: div);
  let no_first_named = propagate set_id(document: document, element: no_first, value: &no_namespace_first[0_u64..no_namespace_first.len]);
  let no_first_placed = propagate append_child(document: document, parent: no_namespace, child: no_first);
  let no_second = propagate new_element(document: document, name: div);
  let no_second_named = propagate set_id(document: document, element: no_second, value: &no_namespace_second[0_u64..no_namespace_second.len]);
  let no_second_placed = propagate append_child(document: document, parent: no_namespace, child: no_second);
  let no_placed = propagate append_child(document: document, parent: root, child: no_namespace);
  return Ok<unit, DomError>(value: unit);
}

fn new_element(document: &Document, name: Atom) -> result: Result<NodeId, DomError> writes(document) {
  doc "Creates an HTML element named name with no attributes, parent or template contents.";
  let attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  let none = None<NodeId>();
  let html = Namespace::Html();
  let data = NodeData::Element(namespace: html, local_name: name, attributes: move attributes, template_contents: none);
  let made = propagate create_node(document: document, data: move data);
  return Ok<NodeId, DomError>(value: made);
}

fn set_id(document: &Document, element: NodeId, value: &[u8]) -> result: Result<unit, DomError> reads(value), writes(document) contract {
  requires value^.len <= 1073741824_u64;
} {
  doc "Stores value and adds it to element as its id attribute, in no namespace.";
  let stored = propagate store_text(document: document, text: value);
  let plain = AttributeNamespace::NoNamespace();
  let name = Atom(index: atom_id);
  let made = Attribute(namespace: plain, name: name, value: stored);
  let added = propagate add_attribute(document: document, element: element, attribute: made);
  return Ok<unit, DomError>(value: unit);
}

fn links_of(document: &Document, node: NodeId) -> links: Option<Links> reads(document) {
  doc "Returns the links of node, or None when it names no node.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let links = document^.nodes.inner[index].links;
    return Some<Links>(value: links);
  }
  return None<Links>();
}

fn same_link(first: Option<NodeId>, second: Option<NodeId>) -> same: Bool pure {
  doc "Tells whether two links name the same node, or both name none.";
  match first {
    Some(value: left) => {
      match second {
        Some(value: right) => {
          return left.index == right.index;
        }
        None() => {
          return False();
        }
      }
    }
    None() => {
      match second {
        Some(value: right) => {
          return False();
        }
        None() => {
          return True();
        }
      }
    }
  }
}

fn is_element(document: &Document, node: NodeId) -> result: Bool reads(document) {
  doc "Tells whether node names an Element node.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let data = &document^.nodes.inner[index].data;
    match data^ {
      Element(..) => {
        return True();
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return False();
}

fn push_node(list: &Box<Slots<NodeId>>, node: NodeId) -> placed: Bool writes(list) {
  doc "Appends node, doubling a full list within 2^32 entries; False at that ceiling.";
  let length = list^.inner.len;
  let capacity = list^.inner.cap;
  if length < capacity {
    place_back(window: &list^.inner, value: node);
    return True();
  }
  if capacity >= list_ceiling {
    return False();
  }
  if capacity < 8_u64 {
    grow(cell: list, capacity: 16_u64);
  } else {
    let doubled = capacity + capacity;
    grow(cell: list, capacity: doubled);
  }
  place_back(window: &list^.inner, value: node);
  return True();
}

fn first_child_of(document: &Document, parent: NodeId, links: Links) -> step: Step reads(document) {
  doc "Returns the first child that links, the links of parent, name, Done when there is none, and Broken when that child does not name parent as its parent or has a previous sibling.";
  match links.first_child {
    Some(value: child) => {
      match links_of(document: document, node: child) {
        Some(value: child_links) => {
          let owner = Some<NodeId>(value: parent);
          let owned = same_link(first: child_links.parent, second: owner);
          let none = None<NodeId>();
          let first = same_link(first: child_links.previous_sibling, second: none);
          let consistent = band(owned, first);
          if consistent {
            return Step::Next(node: child);
          }
          return Step::Broken();
        }
        None() => {
          return Step::Broken();
        }
      }
    }
    None() => {
      return Step::Done();
    }
  }
}

fn step_after(document: &Document, node: NodeId) -> step: Step reads(document) {
  doc "Returns the node after the subtree of node in tree order: the next sibling of node or of its nearest ancestor that has one, Done when the climb reaches the document root, and Broken when a node has no parent before that or a sibling does not link back. The climb takes at most one step per node.";
  let count = document^.nodes.inner.len;
  let at = node;
  for (up in 0_u64..count) {
    let links = match links_of(document: document, node: at) {
      Some(value: found) => {
        give found;
      }
      None() => {
        return Step::Broken();
      }
    }
    let parent = match links.parent {
      Some(value: holder) => {
        give holder;
      }
      None() => {
        return Step::Broken();
      }
    }
    match links.next_sibling {
      Some(value: sibling) => {
        match links_of(document: document, node: sibling) {
          Some(value: sibling_links) => {
            let owner = Some<NodeId>(value: parent);
            let owned = same_link(first: sibling_links.parent, second: owner);
            let before = Some<NodeId>(value: at);
            let chained = same_link(first: sibling_links.previous_sibling, second: before);
            let consistent = band(owned, chained);
            if consistent {
              return Step::Next(node: sibling);
            }
            return Step::Broken();
          }
          None() => {
            return Step::Broken();
          }
        }
      }
      None() => {
      }
    }
    if parent.index == 0_u32 {
      return Step::Done();
    }
    set at = parent;
  }
  return Step::Broken();
}

fn collect_elements(document: &Document, elements: &Box<Slots<NodeId>>) -> complete: Bool reads(document), writes(elements) {
  doc "Appends every Element node of the document tree to elements in tree order: a preorder walk from the document root through first children and next siblings, which never enters template contents. Returns False when the links are inconsistent, when the walk takes more steps than there are nodes, or when the list would pass its ceiling.";
  let count = document^.nodes.inner.len;
  let root = NodeId(index: 0_u32);
  let root_links = match links_of(document: document, node: root) {
    Some(value: found) => {
      give found;
    }
    None() => {
      return False();
    }
  }
  let current = first_child_of(document: document, parent: root, links: root_links);
  for (step in 0_u64..count) {
    let node = match current {
      Next(node: visited) => {
        give visited;
      }
      Done() => {
        return True();
      }
      Broken() => {
        return False();
      }
    }
    let links = match links_of(document: document, node: node) {
      Some(value: found) => {
        give found;
      }
      None() => {
        return False();
      }
    }
    let element = is_element(document: document, node: node);
    if element {
      let placed = push_node(list: elements, node: node);
      if placed {
      } else {
        return False();
      }
    }
    let descent = first_child_of(document: document, parent: node, links: links);
    match descent {
      Next(node: child) => {
        set current = Step::Next(node: child);
      }
      Done() => {
        set current = step_after(document: document, node: node);
      }
      Broken() => {
        return False();
      }
    }
  }
  match current {
    Next(node: visited) => {
      return False();
    }
    Done() => {
      return True();
    }
    Broken() => {
      return False();
    }
  }
}

fn element_id(document: &Document, node: NodeId) -> id: Option<TextSpan> reads(document) {
  doc "Returns the value span of the id attribute of node, the attribute in no namespace named id, or None when node is no Element or has no such attribute.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let data = &document^.nodes.inner[index].data;
    match data^ {
      Element(namespace: kind, local_name: local, attributes: list, template_contents: held) => {
        let count = list^.inner.len;
        for (at in 0_u64..count) {
          let item = list^.inner[at];
          let plain = match item.namespace {
            NoNamespace() => {
              give True();
            }
            XLink() => {
              give False();
            }
            Xml() => {
              give False();
            }
            XmlNs() => {
              give False();
            }
          }
          let named = item.name.index == atom_id;
          let found = band(plain, named);
          if found {
            return Some<TextSpan>(value: item.value);
          }
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return None<TextSpan>();
}

fn span_equals(document: &Document, span: TextSpan, value: &[u8]) -> same: Bool reads(document), reads(value) {
  doc "Tells whether the stored text span names equals value byte for byte; False when the span lies outside the storage.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = document^.text.inner.len;
  let ordered = start <= end;
  let within = end <= length;
  let located = band(ordered, within);
  if located {
  } else {
    return False();
  }
  let stored = &document^.text.inner[start..end];
  let size = value^.len;
  if stored^.len == size {
  } else {
    return False();
  }
  for (at in 0_u64..size) {
    if stored^[at] == value^[at] {
    } else {
      return False();
    }
  }
  return True();
}

fn find_id(document: &Document, elements: &[NodeId], value: &[u8]) -> found: Option<NodeId> reads(document), reads(elements), reads(value) {
  doc "Returns the first of elements whose id attribute equals value, as getElementById does when elements is the document's elements in tree order, or None.";
  let count = elements^.len;
  for (at in 0_u64..count) {
    let node = elements^[at];
    match element_id(document: document, node: node) {
      Some(value: span) => {
        let same = span_equals(document: document, span: span, value: value);
        if same {
          return Some<NodeId>(value: node);
        }
      }
      None() => {
      }
    }
  }
  return None<NodeId>();
}

fn print_cases(text: &[u8], document: &Document, elements: &[NodeId], target: Option<NodeId>, atoms: &AtomTable, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), reads(document), reads(elements), writes(atoms), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file: a header line holding KIND and the byte length in decimal, separated by one space, that many bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case, including a KIND other than 0 and 1.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    if position < length {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let separator = space_before(text: text, start: position, end: header_end);
    let kind = match parse_decimal(text: text, start: position, end: separator) {
      Some(value: case_kind) => {
        give case_kind;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let known = kind <= selector_kind;
    if known {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let size_start = separator +wrap 1_u64;
    let size = match parse_decimal(text: text, start: size_start, end: header_end) {
      Some(value: case_size) => {
        give case_size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let data_start = header_end +wrap 1_u64;
    let data_end = data_start +wrap size;
    let ordered = data_start <= data_end;
    let terminated = data_end < length;
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    if text^[data_end] == '\n'_u8 {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let source = &text^[data_start..data_end];
    print_case(source: source, kind: kind, document: document, elements: elements, target: target, atoms: atoms, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = data_end +wrap 1_u64;
  }
  return True();
}

fn space_before(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first space in text from start to end, or end when there is none or the range leaves text.";
  let within = end <= text^.len;
  if within {
  } else {
    return end;
  }
  for (index in start..end) {
    if text^[index] == ' '_u8 {
      return index;
    }
  }
  return end;
}

fn print_case(source: &[u8], kind: u64, document: &Document, elements: &[NodeId], target: Option<NodeId>, atoms: &AtomTable, buffer: &Box<Slots<u8>>) -> result: unit reads(source), reads(document), reads(elements), writes(atoms), writes(buffer) {
  doc "Tokenizes one case's input and appends its line: the kind's result, or the string naming why the input could not be passed as a component range.";
  let small = source^.len <= source_ceiling;
  if small {
    match parse_component_values(source: source) {
      Ok(value: list) => {
        let count = list.components.inner.len;
        let fits = count <= component_ceiling;
        if fits {
          let last = cvt.wrap::<u64, u32>(count);
          let whole = ComponentRange(start: 0_u32, end: last);
          if kind == an_plus_b_kind {
            put_an_plus_b(buffer: buffer, list: &list, range: whole);
          } else {
            put_selector(buffer: buffer, list: &list, range: whole, document: document, elements: elements, target: target, atoms: atoms);
          }
        } else {
          put_text(buffer: buffer, text: &components_too_many[0_u64..components_too_many.len]);
        }
      }
      Err(error: refusal) => {
        put_text(buffer: buffer, text: &refused_tokenizer[0_u64..refused_tokenizer.len]);
      }
    }
  } else {
    put_text(buffer: buffer, text: &case_too_large[0_u64..case_too_large.len]);
  }
  put_byte(buffer: buffer, value: '\n'_u8);
  return unit;
}

fn put_an_plus_b(buffer: &Box<Slots<u8>>, list: &ComponentList, range: ComponentRange) -> result: unit reads(list), writes(buffer) {
  doc "Appends parse_an_plus_b's result over range as `[A, B]`, or `null` when it returns None.";
  match parse_an_plus_b(values: list, range: range) {
    Some(value: parsed) => {
      put_byte(buffer: buffer, value: '['_u8);
      put_signed(buffer: buffer, value: parsed.a);
      put_text(buffer: buffer, text: &item_separator[0_u64..item_separator.len]);
      put_signed(buffer: buffer, value: parsed.b);
      put_byte(buffer: buffer, value: ']'_u8);
    }
    None() => {
      put_text(buffer: buffer, text: &null_text[0_u64..null_text.len]);
    }
  }
  return unit;
}

fn put_signed(buffer: &Box<Slots<u8>>, value: i32) -> result: unit writes(buffer) {
  doc "Appends the decimal spelling of value, with a minus sign when it is negative. The magnitude of a negative value is the two's complement of its bits, which is exact for every i32 including the least.";
  let bits = cvt.wrap::<i32, u32>(value);
  if value < 0_i32 {
    put_byte(buffer: buffer, value: '-'_u8);
    let magnitude = 0_u32 -wrap bits;
    let wide_magnitude = cvt::<u32, u64>(magnitude);
    put_decimal(buffer: buffer, value: wide_magnitude);
  } else {
    let wide_bits = cvt::<u32, u64>(bits);
    put_decimal(buffer: buffer, value: wide_bits);
  }
  return unit;
}

fn put_selector(buffer: &Box<Slots<u8>>, list: &ComponentList, range: ComponentRange, document: &Document, elements: &[NodeId], target: Option<NodeId>, atoms: &AtomTable) -> result: unit reads(list), reads(document), reads(elements), writes(atoms), writes(buffer) {
  doc "Parses range as a selector list and appends `null` when it is Invalid, the too-large string when it is TooLarge, and otherwise the JSON array of the ids of the elements that match it, in the order of elements.";
  match parse_selector_list(values: list, range: range, atoms: atoms) {
    Ok(value: selectors) => {
      put_matches(buffer: buffer, selectors: &selectors, document: document, elements: elements, target: target, atoms: atoms);
    }
    Err(error: failure) => {
      match failure {
        Invalid() => {
          put_text(buffer: buffer, text: &null_text[0_u64..null_text.len]);
        }
        TooLarge() => {
          put_text(buffer: buffer, text: &selectors_too_large[0_u64..selectors_too_large.len]);
        }
      }
    }
  }
  return unit;
}

fn put_matches(buffer: &Box<Slots<u8>>, selectors: &SelectorList, document: &Document, elements: &[NodeId], target: Option<NodeId>, atoms: &AtomTable) -> result: unit reads(selectors), reads(document), reads(elements), reads(atoms), writes(buffer) {
  doc "Calls selector_matches on each of elements, with target as the match context's target and no scope, and appends the JSON array of the ids of those that match.";
  put_byte(buffer: buffer, value: '['_u8);
  let started = False();
  let count = elements^.len;
  for (at in 0_u64..count) {
    let node = elements^[at];
    let none = None<NodeId>();
    let context = MatchContext(target: target, scope: none);
    let matched = selector_matches(list: selectors, document: document, atoms: atoms, element: node, context: context);
    if matched {
      if started {
        put_text(buffer: buffer, text: &item_separator[0_u64..item_separator.len]);
      }
      set started = True();
      put_id(buffer: buffer, document: document, node: node);
    }
  }
  put_byte(buffer: buffer, value: ']'_u8);
  return unit;
}

fn put_id(buffer: &Box<Slots<u8>>, document: &Document, node: NodeId) -> result: unit reads(document), writes(buffer) {
  doc "Appends the id attribute value of node as a JSON string, escaping a quotation mark, a reverse solidus and every byte below 0x20; the element-without-id string when node has no id attribute, and the outside-the-text string when its span leaves the text storage.";
  let span = match element_id(document: document, node: node) {
    Some(value: found) => {
      give found;
    }
    None() => {
      put_text(buffer: buffer, text: &element_without_id[0_u64..element_without_id.len]);
      return unit;
    }
  }
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = document^.text.inner.len;
  let ordered = start <= end;
  let within = end <= length;
  let located = band(ordered, within);
  if located {
  } else {
    put_text(buffer: buffer, text: &id_outside_text[0_u64..id_outside_text.len]);
    return unit;
  }
  let stored = &document^.text.inner[start..end];
  let size = stored^.len;
  put_byte(buffer: buffer, value: '"'_u8);
  for (at in 0_u64..size) {
    let byte = stored^[at];
    let quote = byte == '"'_u8;
    let solidus = byte == '\\'_u8;
    let marked = bor(quote, solidus);
    if marked {
      put_byte(buffer: buffer, value: '\\'_u8);
      put_byte(buffer: buffer, value: byte);
    } else if byte < 32_u8 {
      put_text(buffer: buffer, text: &escape_prefix[0_u64..escape_prefix.len]);
      let code = cvt::<u8, u64>(byte);
      let lowercase = False();
      put_hex(buffer: buffer, value: code, width: 4_u64, uppercase: lowercase);
    } else {
      put_byte(buffer: buffer, value: byte);
    }
  }
  put_byte(buffer: buffer, value: '"'_u8);
  return unit;
}
