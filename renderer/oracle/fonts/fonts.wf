alias DirectoryRead = std::fs::DirectoryRead;
alias FontSet = pkg::layout::text::FontSet;
alias HandleFactory = std::io::HandleFactory;
alias close_directory = std::fs::close_directory;
alias font_set_add = pkg::layout::text::font_set_add;
alias font_set_new = pkg::layout::text::font_set_new;
alias open_directory_path = pkg::oracle::support::open_directory_path;
alias put_text = pkg::oracle::support::put_text;
alias read_directory_file = pkg::oracle::support::read_directory_file;

const font_files: Array<u8, 955> = "DejaVuSans.ttf\nDejaVuSans-Bold.ttf\nwqy-zenhei.ttc\nLoma.otf\nipag.ttf\nFreeSans.ttf\nFreeSerif.ttf\nFreeMono.ttf\nopens___.ttf\nDejaVuSerif.ttf\nLiberationSerif-Regular.ttf\nunifont.otf\nunifont_jp.otf\nunifont_sample.otf\nunifont_csur.otf\nunifont_upper.otf\nunifont_upper_sample.otf\nNotoColorEmoji.ttf\nLiberationSerif-Bold.ttf\nLiberationSerif-Italic.ttf\nLiberationSerif-BoldItalic.ttf\nLiberationSans-Regular.ttf\nLiberationSans-Bold.ttf\nLiberationSans-Italic.ttf\nLiberationSans-BoldItalic.ttf\nLiberationMono-Regular.ttf\nLiberationMono-Bold.ttf\nLiberationMono-Italic.ttf\nLiberationMono-BoldItalic.ttf\nDejaVuSansMono.ttf\nDejaVuSansMono-Bold.ttf\nDejaVuSansMono-Oblique.ttf\nDejaVuSansMono-BoldOblique.ttf\nDejaVuSerif-Bold.ttf\nFreeSansBold.ttf\nFreeSansOblique.ttf\nFreeSansBoldOblique.ttf\nFreeSerifBold.ttf\nFreeSerifItalic.ttf\nFreeSerifBoldItalic.ttf\nFreeMonoBold.ttf\nFreeMonoOblique.ttf\nFreeMonoBoldOblique.ttf\nLoma-Bold.otf\nLoma-Oblique.otf\nLoma-BoldOblique.otf\nipagp.ttf\n";

const font_families: Array<u8, 589> = "DejaVu Sans\nDejaVu Sans\nWenQuanYi Zen Hei\nLoma\nIPAGothic\nFreeSans\nFreeSerif\nFreeMono\nOpenSymbol\nDejaVu Serif\nLiberation Serif\nUnifont\nUnifont-JP\nUnifont Sample\nUnifont CSUR\nUnifont Upper\nUnifont Sample\nNoto Color Emoji\nLiberation Serif\nLiberation Serif\nLiberation Serif\nLiberation Sans\nLiberation Sans\nLiberation Sans\nLiberation Sans\nLiberation Mono\nLiberation Mono\nLiberation Mono\nLiberation Mono\nDejaVu Sans Mono\nDejaVu Sans Mono\nDejaVu Sans Mono\nDejaVu Sans Mono\nDejaVu Serif\nFreeSans\nFreeSans\nFreeSans\nFreeSerif\nFreeSerif\nFreeSerif\nFreeMono\nFreeMono\nFreeMono\nLoma\nLoma\nLoma\nIPAPGothic\n";

const font_names: Array<u8, 750> = "DejaVuSans\nDejaVuSans-Bold\nWenQuanYiZenHei\nLoma\nIPAGothic\nFreeSans\nFreeSerif\nFreeMono\nOpenSymbol\nDejaVuSerif\nLiberationSerif\nUnifont\nUnifont-JP\nUnifontSample\nUnifontCSUR\nUnifontUpper\nUnifontSample\nNotoColorEmoji\nLiberationSerif-Bold\nLiberationSerif-Italic\nLiberationSerif-BoldItalic\nLiberationSans\nLiberationSans-Bold\nLiberationSans-Italic\nLiberationSans-BoldItalic\nLiberationMono\nLiberationMono-Bold\nLiberationMono-Italic\nLiberationMono-BoldItalic\nDejaVuSansMono\nDejaVuSansMono-Bold\nDejaVuSansMono-Oblique\nDejaVuSansMono-BoldOblique\nDejaVuSerif-Bold\nFreeSansBold\nFreeSansOblique\nFreeSansBoldOblique\nFreeSerifBold\nFreeSerifItalic\nFreeSerifBoldItalic\nFreeMonoBold\nFreeMonoOblique\nFreeMonoBoldOblique\nLoma-Bold\nLoma-Oblique\nLoma-BoldOblique\nIPAPGothic\n";

const font_weights: Array<u16, 47> =[400_u16, 700_u16, 500_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 400_u16, 700_u16, 400_u16, 700_u16, 400_u16, 700_u16, 400_u16, 700_u16, 400_u16, 700_u16, 400_u16, 700_u16, 400_u16, 700_u16, 400_u16, 700_u16, 700_u16, 600_u16, 400_u16, 600_u16, 700_u16, 400_u16, 700_u16, 700_u16, 400_u16, 700_u16, 700_u16, 400_u16, 700_u16, 400_u16];

const font_italics: Array<u8, 47> =[0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 1_u8, 1_u8, 0_u8, 0_u8, 1_u8, 1_u8, 0_u8, 0_u8, 1_u8, 1_u8, 0_u8, 0_u8, 1_u8, 1_u8, 0_u8, 0_u8, 1_u8, 1_u8, 0_u8, 1_u8, 1_u8, 0_u8, 1_u8, 1_u8, 0_u8, 1_u8, 1_u8, 0_u8];

const font_total: u64 = 47_u64;

const face_ceiling: u64 = 268435456_u64;

const collection_tag: u32 = 1953784678_u32;

const newline: u8 = 10_u8;

struct Field {
  doc "Where one line of a newline-separated constant lies: from start to end, end before its newline.";
  start: u64;
  end: u64;
}

fn field_of(text: &[u8], index: u64) -> field: Field reads(text) {
  doc "Returns the line at index of text, whose lines each end with a newline; an empty field at the end of text past its last line.";
  let length = text^.len;
  let line = 0_u64;
  let start = 0_u64;
  for (at in 0_u64..length) {
    let byte = text^[at];
    let ends = byte == newline;
    if ends {
      let found = line == index;
      if found {
        let field = Field(start: start, end: at);
        return field;
      }
      set line = line +sat 1_u64;
      set start = at +sat 1_u64;
    }
  }
  let field = Field(start: length, end: length);
  return field;
}

fn font_file_count() -> count: u64 pure {
  doc "Returns the length of the font table.";
  return font_total;
}

fn put_field(buffer: &Box<Slots<u8>>, text: &[u8], face: u64) -> result: unit reads(text), writes(buffer) {
  doc "Appends the line at index face of text to buffer.";
  let field = field_of(text: text, index: face);
  let length = text^.len;
  let ordered = field.start <= field.end;
  let inside = field.end <= length;
  let valid = band(ordered, inside);
  if valid {
    put_text(buffer: buffer, text: &text^[field.start..field.end]);
  }
  return unit;
}

fn put_face_file(buffer: &Box<Slots<u8>>, face: u64) -> result: unit writes(buffer) {
  doc "Appends the face's line of font_files.";
  put_field(buffer: buffer, text: &font_files[0_u64..font_files.len], face: face);
  return unit;
}

fn put_face_name(buffer: &Box<Slots<u8>>, face: u64) -> result: unit writes(buffer) {
  doc "Appends the face's line of font_names.";
  put_field(buffer: buffer, text: &font_names[0_u64..font_names.len], face: face);
  return unit;
}

fn read_be(data: &Box<Slots<u8>>, at: u64, width: u64) -> result: u64 reads(data) {
  doc "Returns the big-endian unsigned number of width bytes at at, or 0 when it does not lie within data.";
  let length = data^.inner.len;
  let value = 0_u64;
  if at <= length {
    let room = length - at;
    if width <= room {
      for (offset in 0_u64..width) {
        let position = at + offset;
        let byte = cvt::<u8, u64>(data^.inner[position]);
        let shifted = ishl.wrap(value, 8_u32);
        set value = ior(shifted, byte);
      }
    }
  }
  return value;
}

fn first_face_of(data: &Box<Slots<u8>>) -> result: unit writes(data) {
  doc "Turns a font collection into its first face as an sfnt by copying that face's table directory over the collection header: the table records keep their offsets from the start of the file, and the header and the first directory are the only bytes the copy overwrites, since a collection's tables follow every directory. Data that is no collection is left as it is.";
  let tag = read_be(data: data, at: 0_u64, width: 4_u64);
  let collection = cvt::<u32, u64>(collection_tag);
  let is_collection = tag == collection;
  if is_collection {
  } else {
    return unit;
  }
  let directory = read_be(data: data, at: 12_u64, width: 4_u64);
  let count_at = directory +sat 4_u64;
  let tables = read_be(data: data, at: count_at, width: 2_u64);
  let small = tables <= 65535_u64;
  if small {
  } else {
    return unit;
  }
  let records = tables * 16_u64;
  let size = records + 12_u64;
  let length = data^.inner.len;
  let source_end = directory +sat size;
  let inside = source_end <= length;
  if inside {
    for (offset in 0_u64..size) {
      let from = directory +sat offset;
      let fits = from < data^.inner.len;
      let lands = offset < data^.inner.len;
      let both = band(fits, lands);
      if both {
        let byte = data^.inner[from];
        set data^.inner[offset] = byte;
      }
    }
  }
  return unit;
}

fn load_fonts(factory: &HandleFactory, cwd: &DirectoryRead, directory: &[u8]) -> result: Result<FontSet, FontsError> reads(cwd), reads(directory), writes(factory) waits {
  doc "Opens the directory, reads and adds each face of the table in order, and closes the directory.";
  let fonts = font_set_new();
  let unopened = FontsError::Unreadable(face: 0_u64);
  match open_directory_path(factory: factory, root: cwd, name: directory) {
    Ok(value: folder) => {
      let files = &font_files[0_u64..font_files.len];
      let families = &font_families[0_u64..font_families.len];
      for (face in 0_u64..font_total) {
        let file = field_of(text: files, index: face);
        let family = field_of(text: families, index: face);
        let file_ordered = file.start <= file.end;
        let file_inside = file.end <= files^.len;
        let family_ordered = family.start <= family.end;
        let family_inside = family.end <= families^.len;
        let file_valid = band(file_ordered, file_inside);
        let family_valid = band(family_ordered, family_inside);
        let fields_valid = band(file_valid, family_valid);
        let weight_known = face < font_weights.len;
        let italic_known = face < font_italics.len;
        let styles_known = band(weight_known, italic_known);
        let valid = band(fields_valid, styles_known);
        if valid {
        } else {
          let closed = close_directory(factory: factory, directory: move folder);
          let refused = FontsError::Refused(face: face);
          return Err<FontSet, FontsError>(error: refused);
        }
        match read_directory_file(factory: factory, directory: &folder, name: &files^[file.start..file.end]) {
          Ok(value: data) => {
            first_face_of(data: &data);
            let length = data.inner.len;
            if length > face_ceiling {
              let closed = close_directory(factory: factory, directory: move folder);
              let unreadable = FontsError::Unreadable(face: face);
              return Err<FontSet, FontsError>(error: unreadable);
            }
            let weight = font_weights[face];
            let italic_flag = font_italics[face];
            let italic = italic_flag != 0_u8;
            match font_set_add(fonts: &fonts, family: &families^[family.start..family.end], weight: weight, italic: italic, data: &data.inner[0_u64..length]) {
              Ok(value: added) => {
              }
              Err(error: problem) => {
                let closed = close_directory(factory: factory, directory: move folder);
                let refused = FontsError::Refused(face: face);
                return Err<FontSet, FontsError>(error: refused);
              }
            }
          }
          Err(error: problem) => {
            let closed = close_directory(factory: factory, directory: move folder);
            let unreadable = FontsError::Unreadable(face: face);
            return Err<FontSet, FontsError>(error: unreadable);
          }
        }
      }
      let closed = close_directory(factory: factory, directory: move folder);
      return Ok<FontSet, FontsError>(value: move fonts);
    }
    Err(error: problem) => {
      return Err<FontSet, FontsError>(error: unopened);
    }
  }
}
