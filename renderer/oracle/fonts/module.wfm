alias DirectoryRead = std::fs::DirectoryRead;
alias FontSet = pkg::layout::text::FontSet;
alias HandleFactory = std::io::HandleFactory;

public enum FontsError {
  Unreadable(face: u64);
  Refused(face: u64);
}

public fn load_fonts(factory: &HandleFactory, cwd: &DirectoryRead, directory: &[u8]) -> result: Result<FontSet, FontsError> reads(cwd), reads(directory), writes(factory) waits doc "Reads the installed faces the reference browser draws with on the oracle's host from the files of that name in the directory that the relative path in directory names below cwd (the Makefile's oracle-fonts target copies them from /usr/share/fonts into build/fonts, since std::fs opens no symbolic link), and adds them to a new FontSet with pkg::layout::text::font_set_add in this order, which is the fallback order: index: file (family, weight, italic): 0: DejaVuSans.ttf (DejaVu Sans, 400); 1: DejaVuSans-Bold.ttf (DejaVu Sans, 700); 2: wqy-zenhei.ttc (WenQuanYi Zen Hei, 500); 3: Loma.otf (Loma, 400); 4: ipag.ttf (IPAGothic, 400); 5: FreeSans.ttf (FreeSans, 400); 6: FreeSerif.ttf (FreeSerif, 400); 7: FreeMono.ttf (FreeMono, 400); 8: opens___.ttf (OpenSymbol, 400); 9: DejaVuSerif.ttf (DejaVu Serif, 400); 10: LiberationSerif-Regular.ttf (Liberation Serif, 400); 11: unifont.otf (Unifont, 400); 12: unifont_jp.otf (Unifont-JP, 400); 13: unifont_sample.otf (Unifont Sample, 400); 14: unifont_csur.otf (Unifont CSUR, 400); 15: unifont_upper.otf (Unifont Upper, 400); 16: unifont_upper_sample.otf (Unifont Sample, 400); 17: NotoColorEmoji.ttf (Noto Color Emoji, 400); 18: LiberationSerif-Bold.ttf (Liberation Serif, 700); 19: LiberationSerif-Italic.ttf (Liberation Serif, 400, italic); 20: LiberationSerif-BoldItalic.ttf (Liberation Serif, 700, italic); 21: LiberationSans-Regular.ttf (Liberation Sans, 400); 22: LiberationSans-Bold.ttf (Liberation Sans, 700); 23: LiberationSans-Italic.ttf (Liberation Sans, 400, italic); 24: LiberationSans-BoldItalic.ttf (Liberation Sans, 700, italic); 25: LiberationMono-Regular.ttf (Liberation Mono, 400); 26: LiberationMono-Bold.ttf (Liberation Mono, 700); 27: LiberationMono-Italic.ttf (Liberation Mono, 400, italic); 28: LiberationMono-BoldItalic.ttf (Liberation Mono, 700, italic); 29: DejaVuSansMono.ttf (DejaVu Sans Mono, 400); 30: DejaVuSansMono-Bold.ttf (DejaVu Sans Mono, 700); 31: DejaVuSansMono-Oblique.ttf (DejaVu Sans Mono, 400, italic); 32: DejaVuSansMono-BoldOblique.ttf (DejaVu Sans Mono, 700, italic); 33: DejaVuSerif-Bold.ttf (DejaVu Serif, 700); 34: FreeSansBold.ttf (FreeSans, 600); 35: FreeSansOblique.ttf (FreeSans, 400, italic); 36: FreeSansBoldOblique.ttf (FreeSans, 600, italic); 37: FreeSerifBold.ttf (FreeSerif, 700); 38: FreeSerifItalic.ttf (FreeSerif, 400, italic); 39: FreeSerifBoldItalic.ttf (FreeSerif, 700, italic); 40: FreeMonoBold.ttf (FreeMono, 700); 41: FreeMonoOblique.ttf (FreeMono, 400, italic); 42: FreeMonoBoldOblique.ttf (FreeMono, 700, italic); 43: Loma-Bold.otf (Loma, 700); 44: Loma-Oblique.otf (Loma, 400, italic); 45: Loma-BoldOblique.otf (Loma, 700, italic); 46: ipagp.ttf (IPAPGothic, 400). The first eighteen are the reference's per-character fallback order, fontconfig's sort for the pattern :lang=en-us:scalable=true, which Chromium consults for a character that no face of an element's font-family list maps (research/investigations/layout/runs/text-fallback.txt); the rest are the remaining styles of the installed families, which only a font-family list selects. A font collection (wqy-zenhei.ttc) is given to load_face as its first face, its table directory moved to the front of the data. Unreadable(face) when a file cannot be read or is longer than load_face accepts, Refused(face) when font_set_add refuses it.";

public fn font_file_count() -> count: u64 pure doc "Returns the number of faces load_fonts adds.";

public fn put_face_file(buffer: &Box<Slots<u8>>, face: u64) -> result: unit writes(buffer) doc "Appends the file name of the face at index face of load_fonts' order to buffer; nothing for an index past it.";

public fn put_face_name(buffer: &Box<Slots<u8>>, face: u64) -> result: unit writes(buffer) doc "Appends the PostScript name of the face at index face of load_fonts' order, the name Chromium's CSS.getPlatformFontsForNode reports, to buffer; nothing for an index past it.";
