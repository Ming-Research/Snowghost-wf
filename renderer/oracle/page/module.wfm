alias Args = std::text::Args;
alias AtomTable = pkg::base::atom::AtomTable;
alias DirectoryRead = std::fs::DirectoryRead;
alias Document = pkg::dom::Document;
alias Environment = pkg::css::values::Environment;
alias HandleFactory = std::io::HandleFactory;
alias RuleStore = pkg::style::RuleStore;
alias StyleError = pkg::style::StyleError;
alias Traversal = pkg::style::Traversal;

public enum PageError {
  Unreadable();
  TooLarge();
  Unparsed();
  Style(public failure: StyleError);
}

public struct Page {
  public document: Document;
  public atoms: AtomTable;
  public traversal: Traversal;
  public store: RuleStore;
}

public fn default_environment() -> made: Environment pure doc "Returns the oracles' environment: a 1280 by 720 px viewport, a 16 px root font size, and the x-height and zero advance of the default fonts of the reference's host, Liberation Serif, Liberation Sans and DejaVu Sans Mono (research/investigations/style/DESIGN.md).";

public fn load_page(factory: &HandleFactory, cwd: &DirectoryRead, args: &Args, page: u64, sheet: u64, environment: Environment) -> result: Result<Page, PageError> reads(cwd), reads(args), writes(factory) waits doc "Reads the page named by the invocation argument at position page and the user-agent sheet at position sheet, parses the page without scripting, builds its traversal, and fills a rule store as the style oracle does: the user-agent sheet, then in document order each style element and each stylesheet link whose media holds and whose href ends with the SUFFIX of a later SUFFIX=SHEET argument (from position sheet + 1, the longest suffix winning), then the style attributes. A link no argument maps is skipped. Unreadable when a file cannot be read, TooLarge past the style stage's input sizes, Unparsed when the page cannot be parsed, Style when the style stage refuses.";
