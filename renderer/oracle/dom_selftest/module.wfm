alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The dom_selftest entry. Checks interning and the static atoms, builds a small document with every pkg::dom operation, checks the error every refused operation returns, then writes the document in the html5lib tree format and compares it byte for byte with the expected tree held in expected_tree. Prints the tree, a line naming each failed check, and `dom_selftest: passed` when every check passes; exits with 0 exactly then, and with 1 otherwise.";
