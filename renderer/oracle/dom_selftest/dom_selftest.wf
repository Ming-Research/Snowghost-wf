fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Runs the self-test into a report, prints the report and exits with 0 exactly when every check passed and the report was written.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_err, handles: files, stdin: unused_stdin) = move inputs;
  let closed = close_directory(factory: &files, directory: move unused_cwd);
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let failures = selftest(report: &report);
  let written = flush(factory: &files, output: &out, buffer: &report);
  if failures == 0_u64 {
    if written {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}

fn selftest(report: &Box<Slots<u8>>) -> failures: u64 writes(report) {
  doc "Checks interning, builds the tree, checks every refused operation, then serializes the tree into report and compares it with expected_tree. The refusals run before the serialization, so the comparison also shows that they left the tree unchanged. Returns the number of failed checks.";
  let atoms = atom_table_new();
  let atom_failures = check_atoms(atoms: &atoms, report: report);
  let custom = intern_index(atoms: &atoms, name: &custom_word[0_u64..custom_word.len]);
  let custom_index = cvt.wrap::<u64, u32>(custom);
  let quirks = QuirksMode::NoQuirks();
  let document = document_new(quirks: quirks);
  match build(document: &document, custom: custom_index) {
    Ok(value: tree) => {
      let error_failures = check_errors(document: &document, atoms: &atoms, tree: tree, custom: custom, report: report);
      let merge_passed = check_merge_storage();
      let merge_failures = verdict(report: report, number: 24_u64, passed: merge_passed);
      let serialized = box_slots_new::<u8>(capacity: 4096_u64);
      let complete = serialize_document(document: &document, atoms: &atoms, out: &serialized);
      let length = serialized.inner.len;
      let written = &serialized.inner[0_u64..length];
      put_text(buffer: report, text: written);
      let expected = &expected_tree[0_u64..expected_tree.len];
      let same = same_bytes(first: written, second: expected);
      let matched = band(complete, same);
      let tree_failures = if matched {
        give 0_u64;
      } else {
        put_text(buffer: report, text: &mismatch_text[0_u64..mismatch_text.len]);
        give 1_u64;
      }
      let checks = atom_failures +sat error_failures;
      let summed = checks +sat merge_failures;
      let total = summed +sat tree_failures;
      if total == 0_u64 {
        put_text(buffer: report, text: &passed_text[0_u64..passed_text.len]);
      }
      return total;
    }
    Err(error: problem) => {
      put_text(buffer: report, text: &build_failed_text[0_u64..build_failed_text.len]);
      let total = atom_failures +sat 1_u64;
      return total;
    }
  }
}

fn verdict(report: &Box<Slots<u8>>, number: u64, passed: Bool) -> failed: u64 writes(report) contract {
  ensures failed <= 1_u64;
} {
  doc "Returns 0 for a passed check, and 1 after reporting `dom_selftest: check N failed` for a failed one.";
  if passed {
    return 0_u64;
  }
  put_text(buffer: report, text: &check_failed_text[0_u64..check_failed_text.len]);
  put_decimal(buffer: report, value: number);
  put_text(buffer: report, text: &failed_suffix[0_u64..failed_suffix.len]);
  return 1_u64;
}

fn intern_index(atoms: &AtomTable, name: &[u8]) -> index: u64 reads(name), writes(atoms) contract {
  requires name^.len <= 65536_u64;
} {
  doc "Returns the index atom_intern gives name, or 2^64 - 1 when it refuses.";
  match atom_intern(table: atoms, name: name) {
    Ok(value: atom) => {
      let wide = cvt::<u32, u64>(atom.index);
      return wide;
    }
    Err(error: problem) => {
      return 18446744073709551615_u64;
    }
  }
}

fn find_index(atoms: &AtomTable, name: &[u8]) -> index: u64 reads(atoms), reads(name) {
  doc "Returns the index atom_find gives name, or 2^64 - 1 when it finds none.";
  match atom_find(table: atoms, name: name) {
    Some(value: atom) => {
      let wide = cvt::<u32, u64>(atom.index);
      return wide;
    }
    None() => {
      return 18446744073709551615_u64;
    }
  }
}

fn check_atoms(atoms: &AtomTable, report: &Box<Slots<u8>>) -> failed: u64 writes(atoms), writes(report) {
  doc "Check 1: every static name interns to the index its constant names, and the table gains no atom doing so. Check 2: interning div twice gives one atom, atom_div. Check 3: clipPath and xlink:href intern to atom_clip__path and atom_xlink_href. Check 4: atom_find finds div and not x-unknown, and adds nothing. Check 5: the first new name, x-custom, takes the index after the static atoms, and atom_find then finds it.";
  let count = static_atom_ends.len;
  let text_length = static_atom_text.len;
  let start = 0_u64;
  let all_static = True();
  for (index in 0_u64..count) {
    let end = cvt::<u32, u64>(static_atom_ends[index]);
    let ordered = start <= end;
    let inside = end <= text_length;
    let valid = band(ordered, inside);
    if valid {
      let interned = intern_index(atoms: atoms, name: &static_atom_text[start..end]);
      if interned == index {
      } else {
        set all_static = False();
      }
    } else {
      set all_static = False();
    }
    set start = end;
  }
  let unchanged = atoms^.spans.inner.len == count;
  let static_passed = band(all_static, unchanged);
  let first_failed = verdict(report: report, number: 1_u64, passed: static_passed);
  let div_first = intern_index(atoms: atoms, name: &div_word[0_u64..div_word.len]);
  let div_second = intern_index(atoms: atoms, name: &div_word[0_u64..div_word.len]);
  let div_constant = cvt::<u32, u64>(atom_div);
  let div_same = div_first == div_second;
  let div_static = div_first == div_constant;
  let div_passed = band(div_same, div_static);
  let second_failed = verdict(report: report, number: 2_u64, passed: div_passed);
  let clip = intern_index(atoms: atoms, name: &clip_path_word[0_u64..clip_path_word.len]);
  let clip_constant = cvt::<u32, u64>(atom_clip__path);
  let link = intern_index(atoms: atoms, name: &xlink_href_word[0_u64..xlink_href_word.len]);
  let link_constant = cvt::<u32, u64>(atom_xlink_href);
  let clip_passed = clip == clip_constant;
  let link_passed = link == link_constant;
  let named_passed = band(clip_passed, link_passed);
  let third_failed = verdict(report: report, number: 3_u64, passed: named_passed);
  let found_div = find_index(atoms: atoms, name: &div_word[0_u64..div_word.len]);
  let found_unknown = find_index(atoms: atoms, name: &unknown_word[0_u64..unknown_word.len]);
  let div_found = found_div == div_constant;
  let unknown_missing = found_unknown == 18446744073709551615_u64;
  let still_static = atoms^.spans.inner.len == count;
  let find_seen = band(div_found, unknown_missing);
  let find_passed = band(find_seen, still_static);
  let fourth_failed = verdict(report: report, number: 4_u64, passed: find_passed);
  let custom = intern_index(atoms: atoms, name: &custom_word[0_u64..custom_word.len]);
  let custom_found = find_index(atoms: atoms, name: &custom_word[0_u64..custom_word.len]);
  let custom_next = custom == count;
  let custom_kept = custom_found == custom;
  let custom_passed = band(custom_next, custom_kept);
  let fifth_failed = verdict(report: report, number: 5_u64, passed: custom_passed);
  let early = first_failed + second_failed;
  let middle = early + third_failed;
  let late = middle + fourth_failed;
  let failed = late + fifth_failed;
  return failed;
}

fn element(document: &Document, space_kind: Namespace, name: u32) -> result: Result<NodeId, DomError> writes(document) {
  doc "Creates an element with no attributes and no template contents.";
  let attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  let none = None<NodeId>();
  let local = Atom(index: name);
  let data = NodeData::Element(namespace: space_kind, local_name: local, attributes: move attributes, template_contents: none);
  let made = propagate create_node(document: document, data: move data);
  return Ok<NodeId, DomError>(value: made);
}

fn attribute(document: &Document, holder: NodeId, space_kind: AttributeNamespace, name: u32, value: &[u8]) -> result: Result<unit, DomError> reads(value), writes(document) contract {
  requires value^.len <= 1073741824_u64;
} {
  doc "Stores value and adds the attribute to holder.";
  let stored = propagate store_text(document: document, text: value);
  let local = Atom(index: name);
  let made = Attribute(namespace: space_kind, name: local, value: stored);
  let added = propagate add_attribute(document: document, element: holder, attribute: made);
  return Ok<unit, DomError>(value: unit);
}

fn build(document: &Document, custom: u32) -> result: Result<Tree, DomError> writes(document) {
  doc "Builds the tree expected_tree spells, using every operation: head goes in with insert_before, the second lang is refused as a repeat, text merges in place and after relocation, span is moved with append_child and then inserted before itself, which leaves it in place, the paragraph and then span are moved to the end of body, a div is inserted before the paragraph and detached again, template contents live in a Fragment, math is moved before svg, and a div between span and template is detached.";
  let root = NodeId(index: 0_u32);
  let empty = propagate store_text(document: document, text: &doctype_word[0_u64..0_u64]);
  let doctype_name = propagate store_text(document: document, text: &doctype_word[0_u64..doctype_word.len]);
  let doctype_data = NodeData::DocumentType(name: doctype_name, public_id: empty, system_id: empty);
  let doctype = propagate create_node(document: document, data: move doctype_data);
  let doctype_placed = propagate append_child(document: document, parent: root, child: doctype);
  let html_space = Namespace::Html();
  let html = propagate element(document: document, space_kind: html_space, name: atom_html);
  let html_placed = propagate append_child(document: document, parent: root, child: html);
  let body = propagate element(document: document, space_kind: html_space, name: atom_body);
  let body_placed = propagate append_child(document: document, parent: html, child: body);
  let head = propagate element(document: document, space_kind: html_space, name: atom_head);
  let head_placed = propagate insert_before(document: document, parent: html, child: head, reference: body);
  let plain = AttributeNamespace::NoNamespace();
  let lang_added = propagate attribute(document: document, holder: html, space_kind: plain, name: atom_lang, value: &en_word[0_u64..en_word.len]);
  let lang_repeated = propagate attribute(document: document, holder: html, space_kind: plain, name: atom_lang, value: &fr_word[0_u64..fr_word.len]);
  let id_added = propagate attribute(document: document, holder: body, space_kind: plain, name: atom_id, value: &main_word[0_u64..main_word.len]);
  let class_added = propagate attribute(document: document, holder: body, space_kind: plain, name: atom_class, value: &x_word[0_u64..x_word.len]);
  let paragraph = propagate element(document: document, space_kind: html_space, name: atom_p);
  let paragraph_placed = propagate append_child(document: document, parent: body, child: paragraph);
  let none = None<NodeId>();
  let hello_added = propagate insert_text(document: document, parent: paragraph, before: none, text: &hello_text[0_u64..hello_text.len]);
  let world_added = propagate insert_text(document: document, parent: paragraph, before: none, text: &world_text[0_u64..world_text.len]);
  let bold = propagate element(document: document, space_kind: html_space, name: atom_b);
  let bold_placed = propagate append_child(document: document, parent: paragraph, child: bold);
  let bold_filled = propagate insert_text(document: document, parent: bold, before: none, text: &bold_text[0_u64..bold_text.len]);
  let bang_added = propagate insert_text(document: document, parent: paragraph, before: none, text: &bang_text[0_u64..bang_text.len]);
  let before_bold = Some<NodeId>(value: bold);
  let again_added = propagate insert_text(document: document, parent: paragraph, before: before_bold, text: &again_text[0_u64..again_text.len]);
  let span = propagate element(document: document, space_kind: html_space, name: atom_span);
  let span_placed = propagate append_child(document: document, parent: paragraph, child: span);
  let span_moved = propagate append_child(document: document, parent: body, child: span);
  let span_kept = propagate insert_before(document: document, parent: body, child: span, reference: span);
  let paragraph_last = propagate append_child(document: document, parent: body, child: paragraph);
  let span_last = propagate append_child(document: document, parent: body, child: span);
  let first = propagate element(document: document, space_kind: html_space, name: atom_div);
  let first_placed = propagate insert_before(document: document, parent: body, child: first, reference: paragraph);
  let first_detached = propagate detach(document: document, node: first);
  let gone = propagate element(document: document, space_kind: html_space, name: atom_div);
  let gone_placed = propagate append_child(document: document, parent: body, child: gone);
  let gone_filled = propagate insert_text(document: document, parent: gone, before: none, text: &gone_text[0_u64..gone_text.len]);
  let fragment_data = NodeData::Fragment();
  let fragment = propagate create_node(document: document, data: move fragment_data);
  let template_attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  let template_name = Atom(index: atom_template);
  let contents = Some<NodeId>(value: fragment);
  let template_data = NodeData::Element(namespace: html_space, local_name: template_name, attributes: move template_attributes, template_contents: contents);
  let template = propagate create_node(document: document, data: move template_data);
  let template_placed = propagate append_child(document: document, parent: body, child: template);
  let inside = propagate element(document: document, space_kind: html_space, name: custom);
  let inside_placed = propagate append_child(document: document, parent: fragment, child: inside);
  let inside_filled = propagate insert_text(document: document, parent: inside, before: none, text: &inside_text[0_u64..inside_text.len]);
  let svg_space = Namespace::Svg();
  let svg = propagate element(document: document, space_kind: svg_space, name: atom_svg);
  let svg_placed = propagate append_child(document: document, parent: body, child: svg);
  let xlink = AttributeNamespace::XLink();
  let href_added = propagate attribute(document: document, holder: svg, space_kind: xlink, name: atom_href, value: &href_text[0_u64..href_text.len]);
  let view_added = propagate attribute(document: document, holder: svg, space_kind: plain, name: atom_view__box, value: &view_box_text[0_u64..view_box_text.len]);
  let clip = propagate element(document: document, space_kind: svg_space, name: atom_clip__path);
  let clip_placed = propagate append_child(document: document, parent: svg, child: clip);
  let math_space = Namespace::MathMl();
  let math = propagate element(document: document, space_kind: math_space, name: atom_math);
  let math_placed = propagate append_child(document: document, parent: body, child: math);
  let identifier = propagate element(document: document, space_kind: math_space, name: atom_mi);
  let identifier_placed = propagate append_child(document: document, parent: math, child: identifier);
  let url_added = propagate attribute(document: document, holder: math, space_kind: plain, name: atom_definition__u__r__l, value: &url_text[0_u64..url_text.len]);
  let math_moved = propagate insert_before(document: document, parent: body, child: math, reference: svg);
  let gone_detached = propagate detach(document: document, node: gone);
  let remark = propagate store_text(document: document, text: &comment_text[0_u64..comment_text.len]);
  let comment_data = NodeData::Comment(data: remark);
  let comment = propagate create_node(document: document, data: move comment_data);
  let comment_placed = propagate append_child(document: document, parent: root, child: comment);
  let tree = Tree(root: root, doctype: doctype, html: html, head: head, body: body, paragraph: paragraph, bold: bold, gone: gone);
  return Ok<Tree, DomError>(value: tree);
}

fn record(report: &Box<Slots<u8>>, number: u64, result: Result<unit, DomError>, wanted: DomError) -> failed: u64 writes(report) contract {
  ensures failed <= 1_u64;
} {
  doc "Returns 0 when result is the error wanted, and 1 after reporting check number otherwise.";
  let passed = match result {
    Ok(value: unused) => {
      give False();
    }
    Err(error: got) => {
      give eeq(got, wanted);
    }
  }
  let failed = verdict(report: report, number: number, passed: passed);
  return failed;
}

fn record_node(report: &Box<Slots<u8>>, number: u64, result: Result<NodeId, DomError>, wanted: DomError) -> failed: u64 writes(report) contract {
  ensures failed <= 1_u64;
} {
  doc "Returns 0 when result is the error wanted, and 1 after reporting check number otherwise.";
  let passed = match result {
    Ok(value: unused) => {
      give False();
    }
    Err(error: got) => {
      give eeq(got, wanted);
    }
  }
  let failed = verdict(report: report, number: number, passed: passed);
  return failed;
}

fn check_errors(document: &Document, atoms: &AtomTable, tree: Tree, custom: u64, report: &Box<Slots<u8>>) -> failed: u64 writes(document), writes(atoms), writes(report) {
  doc "Checks 6 to 22: each refused operation returns its error. InvalidNode for identifiers past the node count, for a node made its own child or the child of its descendant, for a reference or before that is not a child of parent, and for template contents that name no node; WrongKind for an attribute on a doctype or on the root; TooLarge for the 65537th attribute of an element. Check 23: x-custom keeps its index after the table has grown past 65536 atoms. Check 25: insert_text refuses a before that is a child of another node, whose previous sibling is a Text node it must not merge into. Check 26: the div detached from between span and template has no parent or siblings left. Checks 27 to 29: InvalidNode for a node with no children made its own child, which refuse_cycle decides without a walk, and for html, which has children, appended under or inserted into a descendant several levels down.";
  let invalid = DomError::InvalidNode();
  let wrong = DomError::WrongKind();
  let too_large = DomError::TooLarge();
  let bad = NodeId(index: invalid_index);
  let none = None<NodeId>();
  let letter = &x_word[0_u64..x_word.len];
  let r6 = append_child(document: document, parent: tree.root, child: bad);
  let f6 = record(report: report, number: 6_u64, result: r6, wanted: invalid);
  let r7 = append_child(document: document, parent: bad, child: tree.html);
  let f7 = record(report: report, number: 7_u64, result: r7, wanted: invalid);
  let r8 = append_child(document: document, parent: tree.html, child: tree.html);
  let f8 = record(report: report, number: 8_u64, result: r8, wanted: invalid);
  let r9 = append_child(document: document, parent: tree.paragraph, child: tree.body);
  let f9 = record(report: report, number: 9_u64, result: r9, wanted: invalid);
  let r10 = insert_before(document: document, parent: tree.body, child: tree.paragraph, reference: tree.head);
  let f10 = record(report: report, number: 10_u64, result: r10, wanted: invalid);
  let r11 = insert_before(document: document, parent: tree.body, child: bad, reference: tree.paragraph);
  let f11 = record(report: report, number: 11_u64, result: r11, wanted: invalid);
  let r12 = insert_before(document: document, parent: tree.paragraph, child: tree.body, reference: tree.bold);
  let f12 = record(report: report, number: 12_u64, result: r12, wanted: invalid);
  let r13 = detach(document: document, node: bad);
  let f13 = record(report: report, number: 13_u64, result: r13, wanted: invalid);
  let r14 = insert_text(document: document, parent: bad, before: none, text: letter);
  let f14 = record(report: report, number: 14_u64, result: r14, wanted: invalid);
  let before_head = Some<NodeId>(value: tree.head);
  let r15 = insert_text(document: document, parent: tree.body, before: before_head, text: letter);
  let f15 = record(report: report, number: 15_u64, result: r15, wanted: invalid);
  let before_bad = Some<NodeId>(value: bad);
  let r16 = insert_text(document: document, parent: tree.paragraph, before: before_bad, text: letter);
  let f16 = record(report: report, number: 16_u64, result: r16, wanted: invalid);
  let before_bold = Some<NodeId>(value: tree.bold);
  let r25 = insert_text(document: document, parent: tree.body, before: before_bold, text: letter);
  let f25 = record(report: report, number: 25_u64, result: r25, wanted: invalid);
  let plain = AttributeNamespace::NoNamespace();
  let empty = TextSpan(start: 0_u32, end: 0_u32);
  let class_name = Atom(index: atom_class);
  let sample = Attribute(namespace: plain, name: class_name, value: empty);
  let r17 = add_attribute(document: document, element: bad, attribute: sample);
  let f17 = record(report: report, number: 17_u64, result: r17, wanted: invalid);
  let r18 = add_attribute(document: document, element: tree.doctype, attribute: sample);
  let f18 = record(report: report, number: 18_u64, result: r18, wanted: wrong);
  let r19 = add_attribute(document: document, element: tree.root, attribute: sample);
  let f19 = record(report: report, number: 19_u64, result: r19, wanted: wrong);
  let orphan_attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  let html_space = Namespace::Html();
  let template_name = Atom(index: atom_template);
  let missing = Some<NodeId>(value: bad);
  let orphan_data = NodeData::Element(namespace: html_space, local_name: template_name, attributes: move orphan_attributes, template_contents: missing);
  let r20 = create_node(document: document, data: move orphan_data);
  let f20 = record_node(report: report, number: 20_u64, result: r20, wanted: invalid);
  let r21 = check_attribute_ceiling(document: document, atoms: atoms);
  let f21 = record(report: report, number: 21_u64, result: r21, wanted: too_large);
  let r22 = insert_before(document: document, parent: tree.body, child: tree.body, reference: tree.paragraph);
  let f22 = record(report: report, number: 22_u64, result: r22, wanted: invalid);
  let r27 = append_child(document: document, parent: tree.head, child: tree.head);
  let f27 = record(report: report, number: 27_u64, result: r27, wanted: invalid);
  let r28 = append_child(document: document, parent: tree.bold, child: tree.html);
  let f28 = record(report: report, number: 28_u64, result: r28, wanted: invalid);
  let r29 = insert_before(document: document, parent: tree.paragraph, child: tree.html, reference: tree.bold);
  let f29 = record(report: report, number: 29_u64, result: r29, wanted: invalid);
  let custom_found = find_index(atoms: atoms, name: &custom_word[0_u64..custom_word.len]);
  let grown = atoms^.spans.inner.len > attribute_count;
  let kept = custom_found == custom;
  let stable = band(grown, kept);
  let f23 = verdict(report: report, number: 23_u64, passed: stable);
  let s7 = f6 + f7;
  let s8 = s7 + f8;
  let s9 = s8 + f9;
  let s10 = s9 + f10;
  let s11 = s10 + f11;
  let s12 = s11 + f12;
  let s13 = s12 + f13;
  let s14 = s13 + f14;
  let s15 = s14 + f15;
  let s16 = s15 + f16;
  let s17 = s16 + f17;
  let s18 = s17 + f18;
  let s19 = s18 + f19;
  let s20 = s19 + f20;
  let s21 = s20 + f21;
  let s22 = s21 + f22;
  let s23 = s22 + f23;
  let s25 = s23 + f25;
  let detached = detached_links(document: document, node: tree.gone);
  let f26 = verdict(report: report, number: 26_u64, passed: detached);
  let s26 = s25 + f26;
  let s27 = s26 + f27;
  let s28 = s27 + f28;
  let failed = s28 + f29;
  return failed;
}

fn check_attribute_ceiling(document: &Document, atoms: &AtomTable) -> result: Result<unit, DomError> writes(document), writes(atoms) {
  doc "Gives a detached div 65536 attributes named n0 to n65535, checking that a repeat of n0 is still accepted as a no-op at the ceiling, then returns what adding n65536 returns: TooLarge when add_attribute holds its ceiling. A step that fails otherwise returns WrongKind, which the check does not accept.";
  let html_space = Namespace::Html();
  let many = propagate element(document: document, space_kind: html_space, name: atom_div);
  let empty = TextSpan(start: 0_u32, end: 0_u32);
  let plain = AttributeNamespace::NoNamespace();
  let scratch = box_slots_new::<u8>(capacity: 16_u64);
  for (number in 0_u64..attribute_count) {
    let named = propagate numbered_atom(atoms: atoms, scratch: &scratch, number: number);
    let made = Attribute(namespace: plain, name: named, value: empty);
    let added = propagate add_attribute(document: document, element: many, attribute: made);
  }
  let first = propagate numbered_atom(atoms: atoms, scratch: &scratch, number: 0_u64);
  let repeat = Attribute(namespace: plain, name: first, value: empty);
  let repeated = propagate add_attribute(document: document, element: many, attribute: repeat);
  let last = propagate numbered_atom(atoms: atoms, scratch: &scratch, number: attribute_count);
  let extra = Attribute(namespace: plain, name: last, value: empty);
  let outcome = add_attribute(document: document, element: many, attribute: extra);
  return outcome;
}

fn numbered_atom(atoms: &AtomTable, scratch: &Box<Slots<u8>>, number: u64) -> result: Result<Atom, DomError> writes(atoms), writes(scratch) {
  doc "Interns n followed by the decimal spelling of number; a refusal is reported as WrongKind, which no check here expects.";
  truncate(buffer: scratch, length: 0_u64);
  put_text(buffer: scratch, text: &n_word[0_u64..n_word.len]);
  put_decimal(buffer: scratch, value: number);
  let length = scratch^.inner.len;
  let short = length <= 65536_u64;
  if short {
    match atom_intern(table: atoms, name: &scratch^.inner[0_u64..length]) {
      Ok(value: atom) => {
        return Ok<Atom, DomError>(value: atom);
      }
      Err(error: problem) => {
      }
    }
  }
  let wrong = DomError::WrongKind();
  return Err<Atom, DomError>(error: wrong);
}

fn links_of(document: &Document, node: NodeId) -> links: Option<Links> reads(document) {
  doc "Returns the links of node, or None when it names no node.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let links = document^.nodes.inner[index].links;
    return Some<Links>(value: links);
  }
  return None<Links>();
}

fn same_link(first: Option<NodeId>, second: Option<NodeId>) -> same: Bool pure {
  doc "Tells whether two links name the same node, or both name none.";
  match first {
    Some(value: left) => {
      match second {
        Some(value: right) => {
          return left.index == right.index;
        }
        None() => {
          return False();
        }
      }
    }
    None() => {
      match second {
        Some(value: right) => {
          return False();
        }
        None() => {
          return True();
        }
      }
    }
  }
}

fn same_bytes(first: &[u8], second: &[u8]) -> result: Bool reads(first), reads(second) {
  doc "Tells whether first and second hold the same bytes.";
  let length = first^.len;
  if length == second^.len {
  } else {
    return False();
  }
  for (at in 0_u64..length) {
    if first^[at] == second^[at] {
    } else {
      return False();
    }
  }
  return True();
}

fn check_merge_storage() -> passed: Bool pure {
  doc "Check 24, on a document of its own: merging into a Text node whose text ends the storage grows the storage by the new text alone, merging after other text was stored grows it by the node's text and the new text, and the node then holds all of it.";
  let quirks = QuirksMode::NoQuirks();
  let document = document_new(quirks: quirks);
  match merge_steps(document: &document) {
    Ok(value: result) => {
      return result;
    }
    Err(error: problem) => {
      return False();
    }
  }
}

fn merge_steps(document: &Document) -> result: Result<Bool, DomError> writes(document) {
  doc "Runs check 24 on document, a fresh one: node 1 is the paragraph and node 2 its Text node.";
  let root = NodeId(index: 0_u32);
  let html_space = Namespace::Html();
  let paragraph = propagate element(document: document, space_kind: html_space, name: atom_p);
  let placed = propagate append_child(document: document, parent: root, child: paragraph);
  let none = None<NodeId>();
  let hello_added = propagate insert_text(document: document, parent: paragraph, before: none, text: &hello_text[0_u64..hello_text.len]);
  let first = document^.text.inner.len;
  let world_added = propagate insert_text(document: document, parent: paragraph, before: none, text: &world_text[0_u64..world_text.len]);
  let second = document^.text.inner.len;
  let other = propagate store_text(document: document, text: &x_word[0_u64..x_word.len]);
  let third = document^.text.inner.len;
  let bang_added = propagate insert_text(document: document, parent: paragraph, before: none, text: &bang_text[0_u64..bang_text.len]);
  let fourth = document^.text.inner.len;
  let in_place = first +sat world_text.len;
  let moved_size = second +sat bang_text.len;
  let relocated = third +sat moved_size;
  let grew_in_place = second == in_place;
  let grew_relocated = fourth == relocated;
  let text_node = NodeId(index: 2_u32);
  let held = node_text(document: document, node: text_node, expected: &merged_text[0_u64..merged_text.len]);
  let sizes = band(grew_in_place, grew_relocated);
  let result = band(sizes, held);
  return Ok<Bool, DomError>(value: result);
}

fn node_text(document: &Document, node: NodeId, expected: &[u8]) -> equal: Bool reads(document), reads(expected) {
  doc "Tells whether node is a Text node holding expected.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let data = &document^.nodes.inner[index].data;
    match data^ {
      Text(data: span_ref) => {
        let span = span_ref^;
        let start = cvt::<u32, u64>(span.start);
        let end = cvt::<u32, u64>(span.end);
        let length = document^.text.inner.len;
        if start <= end {
          if end <= length {
            let same = same_bytes(first: &document^.text.inner[start..end], second: expected);
            return same;
          }
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Element(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return False();
}

fn detached_links(document: &Document, node: NodeId) -> detached: Bool reads(document) {
  doc "Tells whether node has no parent and no siblings.";
  match links_of(document: document, node: node) {
    Some(value: links) => {
      let none = None<NodeId>();
      let orphan = same_link(first: links.parent, second: none);
      let no_previous = same_link(first: links.previous_sibling, second: none);
      let no_next = same_link(first: links.next_sibling, second: none);
      let alone = band(no_previous, no_next);
      return band(orphan, alone);
    }
    None() => {
      return False();
    }
  }
}
