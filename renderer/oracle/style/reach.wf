alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias Document = pkg::dom::Document;
alias DomError = pkg::dom::DomError;
alias NodeId = pkg::dom::NodeId;
alias NodeData = pkg::dom::NodeData;
alias Namespace = pkg::dom::Namespace;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias RuleStore = pkg::style::RuleStore;
alias append_child = pkg::dom::append_child;
alias atom_intern = pkg::base::atom::atom_intern;
alias create_node = pkg::dom::create_node;
alias detach = pkg::dom::detach;
alias insert_before = pkg::dom::insert_before;
alias store_text = pkg::dom::store_text;
alias build_traversal = pkg::style::build_traversal;
alias match_elements = pkg::style::match_elements;
alias rematched = pkg::style::rematched;
alias structural_restyle = pkg::style::structural_restyle;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_text = pkg::oracle::support::put_text;

const reach_label: Array<u8, 6> = "reach ";

fn run_reach(store: &RuleStore, document: &Document, atoms: &AtomTable, script: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(store), reads(script), writes(document), writes(atoms), writes(out), writes(err), writes(files) waits {
  doc "Full matches before and after every B/X edit, mapped by NodeId; compares only surviving elements, checks structural_restyle after the edit, and reports reach I set S changed C missing M (or full changed C), with first NODE on a miss. Returns 1 if any edit misses an element, 2 on a refused input, otherwise 0. S sheets were loaded before this call. A third match uses the original traversal to align rows for rematched: matching reads positions and ancestry from the edited DOM, not traversal parent rows. Intersection of the old and rebuilt traversal membership excludes detached and inserted subtrees.";
  let notes = box_slots_new::<u8>(capacity: 4096_u64);
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edits = 0_u64;
  let status = 0_u8;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return 2_u8;
    }
    if start < end {
      if script^[start] == 83_u8 {
      } else {
        let line = &script^[start..end];
        let parent = match structure_parent(document: document, line: line) {
          Some(value: found) => {
            give found;
          }
          None() => {
            put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
            let reported = flush(factory: files, output: err, buffer: &notes);
            return 2_u8;
          }
        }
        let (edit_previous, edit_next) = structure_neighbours(document: document, line: line);
        let before = match build_traversal(document: document) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let old = match match_elements(store: store, document: document, atoms: atoms, traversal: &before) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let applied = match apply_structure_line(document: document, atoms: atoms, line: line) {
          Some(..) => {
            give True();
          }
          None() => {
            give False();
          }
        }
        if applied {
        } else {
          put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &notes);
          return 2_u8;
        }
        let after = match build_traversal(document: document) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let new = match match_elements(store: store, document: document, atoms: atoms, traversal: &after) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let aligned = match match_elements(store: store, document: document, atoms: atoms, traversal: &before) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let row_changes = rematched(old: &old, new: &aligned);
        let wanted = match structural_restyle(store: store, document: document, atoms: atoms, parent: parent, previous: edit_previous, next: edit_next) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let count = document^.nodes.inner.len;
        if count > 4294967296_u64 {
          return 2_u8;
        }
        let no = False();
        let in_set = box_array_filled::<Bool>(count: count, value: no);
        let listed = wanted.nodes.inner.len;
        for (k in 0_u64..listed) {
          let index = cvt::<u32, u64>(wanted.nodes.inner[k].index);
          if index < in_set.inner.len {
            set in_set.inner[index] = True();
          }
        }
        let changed = box_array_filled::<Bool>(count: count, value: no);
        for (node in 0_u64..count) {
          if node < before.order.inner.len {
            if node < after.order.inner.len {
              let old_row = cvt::<u32, u64>(before.order.inner[node]);
              let new_row = cvt::<u32, u64>(after.order.inner[node]);
              if old_row < before.elements.inner.len {
                if new_row < after.elements.inner.len {
                  if old_row < row_changes.inner.len {
                    set changed.inner[node] = row_changes.inner[old_row];
                  }
                }
              }
            }
          }
        }
        let flagged = 0_u64;
        let missing = 0_u64;
        let first_missing = 0_u64;
        for (node in 0_u64..count) {
          if changed.inner[node] {
            set flagged = flagged +sat 1_u64;
            let covered = bor(wanted.full, in_set.inner[node]);
            if covered {
            } else {
              if missing == 0_u64 {
                set first_missing = node;
              }
              set missing = missing +sat 1_u64;
            }
          }
        }
        set edits = edits +sat 1_u64;
        put_text(buffer: &notes, text: &reach_label[0_u64..reach_label.len]);
        put_decimal(buffer: &notes, value: edits);
        if wanted.full {
          put_text(buffer: &notes, text: &full_label[0_u64..full_label.len]);
        } else {
          put_text(buffer: &notes, text: &set_label[0_u64..set_label.len]);
          put_decimal(buffer: &notes, value: listed);
        }
        put_text(buffer: &notes, text: &changed_label[0_u64..changed_label.len]);
        put_decimal(buffer: &notes, value: flagged);
        if wanted.full {
        } else {
          put_text(buffer: &notes, text: &missing_label[0_u64..missing_label.len]);
          put_decimal(buffer: &notes, value: missing);
        }
        if missing > 0_u64 {
          set status = 1_u8;
          put_text(buffer: &notes, text: &first_label[0_u64..first_label.len]);
          put_decimal(buffer: &notes, value: first_missing);
        }
        put_byte(buffer: &notes, value: 10_u8);
        let flushed = flush(factory: files, output: out, buffer: &notes);
        if flushed {
        } else {
          return 2_u8;
        }
      }
    }
  }
  return status;
}
