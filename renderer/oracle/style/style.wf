alias add_style_attributes = pkg::style::add_style_attributes;
alias add_presentational_hints = pkg::style::add_presentational_hints;
alias add_style_element = pkg::style::add_style_element;
alias args_count = std::text::args_count;
alias argument_bytes = pkg::oracle::support::argument_bytes;
alias atom_table_new = pkg::base::atom::atom_table_new;
alias build_traversal = pkg::style::build_traversal;
alias close_directory = std::fs::close_directory;
alias compute_styles = pkg::style::compute_styles;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias inherited_pass = pkg::style::inherited_pass;
alias intern_styles = pkg::style::intern_styles;
alias match_elements = pkg::style::match_elements;
alias media_holds = pkg::style::media_holds;
alias origin_author = pkg::style::origin_author;
alias origin_user_agent = pkg::style::origin_user_agent;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias parse_document = pkg::html::tree_builder::parse_document;
alias open_directory_path = pkg::oracle::support::open_directory_path;
alias read_directory_file = pkg::oracle::support::read_directory_file;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_keyword = pkg::css::values::put_keyword;
alias pseudo_after = pkg::style::pseudo_after;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;
alias reset_pass = pkg::style::reset_pass;
alias rule_count = pkg::style::rule_count;
alias rule_store_new = pkg::style::rule_store_new;
alias sheet_sources = pkg::style::sheet_sources;
alias sizing_auto = pkg::css::values::sizing_auto;
alias sizing_keyword = pkg::css::values::sizing_keyword;
alias sizing_none = pkg::css::values::sizing_none;
alias sizing_normal = pkg::css::values::sizing_normal;
alias sizing_number = pkg::css::values::sizing_number;

const header_text: Array<u8, 1277> = "index\tname\tdisplay\tposition\tfloat\tclear\toverflow-x\toverflow-y\tbox-sizing\tvisibility\tz-index\twidth\theight\tmin-width\tmin-height\tmax-width\tmax-height\ttop\tright\tbottom\tleft\tmargin-top\tmargin-right\tmargin-bottom\tmargin-left\tpadding-top\tpadding-right\tpadding-bottom\tpadding-left\tborder-top-width\tborder-right-width\tborder-bottom-width\tborder-left-width\tborder-top-style\tborder-right-style\tborder-bottom-style\tborder-left-style\tborder-top-color\tborder-right-color\tborder-bottom-color\tborder-left-color\tfont-family\tfont-size\tfont-weight\tfont-style\tline-height\tcolor\ttext-align\ttext-indent\ttext-transform\twhite-space\tletter-spacing\tword-spacing\tvertical-align\ttext-decoration-line\tlist-style-type\tbackground-color\tflex-direction\tflex-wrap\tjustify-content\talign-items\talign-content\tjustify-items\trow-gap\tcolumn-gap\tgrid-template-columns\tgrid-template-rows\tgrid-template-areas\tgrid-auto-flow\tgrid-auto-columns\tgrid-auto-rows\torder\tflex-grow\tflex-shrink\tflex-basis\talign-self\tjustify-self\tgrid-row-start\tgrid-row-end\tgrid-column-start\tgrid-column-end\taspect-ratio\tborder-collapse\tborder-spacing\ttable-layout\tcaption-side\tcontent\tcounter-reset\tcounter-increment\tcounter-set\tquotes\tlist-style-position\toverflow-wrap\tword-break\tcolumn-count\tcolumn-width\tcolumn-fill\tbreak-inside\tunicode-bidi\n";

const before_name: Array<u8, 8> = "::before";

const after_name: Array<u8, 7> = "::after";

const usage_text: Array<u8, 143> = "usage: style_oracle dump|match|inherited|reset|all REPS PAGE UA [SUFFIX=SHEET ...]\n       style_oracle delta SCRIPT PAGE UA [SUFFIX=SHEET ...]\n";

const mode_words: Array<u8, 36> = "dump match inherited reset all delta";

const unreadable_text: Array<u8, 27> = "style_oracle: cannot read: ";

const large_text: Array<u8, 40> = "style_oracle: an input is past its size\n";

const unparsed_text: Array<u8, 40> = "style_oracle: the page cannot be parsed\n";

const refused_text: Array<u8, 39> = "style_oracle: the style stage refused: ";

const too_large_word: Array<u8, 10> = "too large\n";

const inconsistent_word: Array<u8, 13> = "inconsistent\n";

const unmapped_text: Array<u8, 36> = "style_oracle: no sheet for the link ";

const elements_label: Array<u8, 10> = " elements ";

const rules_label: Array<u8, 7> = " rules ";

const distinct_label: Array<u8, 10> = " distinct ";

const auto_word: Array<u8, 4> = "auto";

const none_word: Array<u8, 4> = "none";

const normal_word: Array<u8, 6> = "normal";

const italic_word: Array<u8, 6> = "italic";

const px_word: Array<u8, 2> = "px";

const calc_word: Array<u8, 5> = "calc(";

const zero_px: Array<u8, 3> = "0px";

const rgb_word: Array<u8, 4> = "rgb(";

const rgba_word: Array<u8, 5> = "rgba(";

const separator: Array<u8, 2> = ", ";

const decoration_words: Array<u8, 37> = "underline overline line-through blink";

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, drives one invocation and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, clock: clock, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = drive(args: &args, cwd: &cwd, clock: &clock, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn report(err: &OutputStream, files: &HandleFactory, text: &[u8]) -> result: unit reads(text), writes(err), writes(files) waits {
  doc "Writes text to standard error.";
  let buffer = box_slots_new::<u8>(capacity: 128_u64);
  put_text(buffer: &buffer, text: text);
  let written = flush(factory: files, output: err, buffer: &buffer);
  return unit;
}

fn report_style(err: &OutputStream, files: &HandleFactory, failure: StyleError) -> result: unit writes(err), writes(files) waits {
  doc "Reports a refusal of the style stage.";
  let buffer = box_slots_new::<u8>(capacity: 128_u64);
  put_text(buffer: &buffer, text: &refused_text[0_u64..refused_text.len]);
  match failure {
    TooLarge() => {
      put_text(buffer: &buffer, text: &too_large_word[0_u64..too_large_word.len]);
    }
    Inconsistent() => {
      put_text(buffer: &buffer, text: &inconsistent_word[0_u64..inconsistent_word.len]);
    }
  }
  let written = flush(factory: files, output: err, buffer: &buffer);
  return unit;
}

fn mode_of(args: &Args) -> mode: Option<u64> reads(args) {
  doc "The mode word's number in mode_words, or None.";
  match argument_bytes(args: args, position: 1_u64) {
    Some(value: bytes) => {
      let n = mode_words.len;
      let length = bytes.inner.len;
      let found = word_number(list: &mode_words[0_u64..n], text: &bytes.inner[0_u64..length]);
      return found;
    }
    None() => {
      return None<u64>();
    }
  }
}

fn word_number(list: &[u8], text: &[u8]) -> found: Option<u64> reads(list), reads(text) {
  doc "The number of the space-separated word of list equal to text byte for byte, or None.";
  let length = list^.len;
  let size = text^.len;
  let word = 0_u64;
  let start = 0_u64;
  let stop = length +sat 1_u64;
  for (at in 0_u64..stop) {
    let boundary = at >= length;
    let space = if boundary {
      give True();
    } else {
      give list^[at] == 32_u8;
    }
    if space {
      let width = at -sat start;
      if width == size {
        let same = True();
        for (k in 0_u64..size) {
          let index = start +sat k;
          let inside = index < length;
          if inside {
            if list^[index] != text^[k] {
              set same = False();
            }
          }
        }
        if same {
          return Some<u64>(value: word);
        }
      }
      set word = word +sat 1_u64;
      set start = at +sat 1_u64;
    }
  }
  return None<u64>();
}

fn ends_with(text: &[u8], suffix: &[u8]) -> found: Bool reads(text), reads(suffix) {
  doc "True when text ends with suffix.";
  let length = text^.len;
  let size = suffix^.len;
  if size > length {
    return False();
  }
  let offset = length - size;
  for (k in 0_u64..size) {
    let at = offset + k;
    if text^[at] != suffix^[k] {
      return False();
    }
  }
  return True();
}

fn last_equals(bytes: &[u8]) -> at: Option<u64> reads(bytes) {
  doc "The index of the last = in bytes, or None.";
  let length = bytes^.len;
  for (step in 0_u64..length) {
    let back = length - step;
    let at = back - 1_u64;
    if bytes^[at] == 61_u8 {
      return Some<u64>(value: at);
    }
  }
  return None<u64>();
}

fn mapped_sheet(args: &Args, document: &Document, href: TextSpan) -> position: Option<u64> reads(args), reads(document) {
  doc "The argument position, from 5, whose SUFFIX the link's href ends with, the longest such suffix winning, or None.";
  let start = cvt::<u32, u64>(href.start);
  let end = cvt::<u32, u64>(href.end);
  let length = document^.text.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return None<u64>();
  }
  let count = args_count(args: args);
  let best = None<u64>();
  let best_size = 0_u64;
  for (position in 5_u64..count) {
    match argument_bytes(args: args, position: position) {
      Some(value: bytes) => {
        let size = bytes.inner.len;
        match last_equals(bytes: &bytes.inner[0_u64..size]) {
          Some(value: equals) => {
            let fits = equals <= size;
            if fits {
              let matched = ends_with(text: &document^.text.inner[start..end], suffix: &bytes.inner[0_u64..equals]);
              let longer = equals > best_size;
              let better = band(matched, longer);
              if better {
                set best = Some<u64>(value: position);
                set best_size = equals;
              }
            }
          }
          None() => {
          }
        }
      }
      None() => {
      }
    }
  }
  return best;
}

fn read_mapped(files: &HandleFactory, cwd: &DirectoryRead, args: &Args, position: u64) -> result: Result<Box<Slots<u8>>, IoError> reads(cwd), reads(args), writes(files) waits {
  doc "Reads the SHEET file of a SUFFIX=SHEET argument through a one-argument view: the path after its last =.";
  let found = read_suffix_path(factory: files, cwd: cwd, args: args, position: position);
  return move found;
}

fn drive(args: &Args, cwd: &DirectoryRead, clock: &Clock, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(clock), writes(out), writes(err), writes(files) waits {
  doc "Reads the invocation, builds the document and the rule store, and runs the mode.";
  let count = args_count(args: args);
  let enough = count >= 5_u64;
  let mode = match mode_of(args: args) {
    Some(value: found) => {
      give found;
    }
    None() => {
      report(err: err, files: files, text: &usage_text[0_u64..usage_text.len]);
      return 2_u8;
    }
  }
  if enough {
  } else {
    report(err: err, files: files, text: &usage_text[0_u64..usage_text.len]);
    return 2_u8;
  }
  let delta = mode == 5_u64;
  let reps = if delta {
    give 0_u64;
  } else {
    let parsed_reps = match argument_bytes(args: args, position: 2_u64) {
      Some(value: bytes) => {
        let size = bytes.inner.len;
        let parsed = parse_decimal(text: &bytes.inner[0_u64..size], start: 0_u64, end: size);
        let number = match parsed {
          Some(value: n) => {
            give n;
          }
          None() => {
            report(err: err, files: files, text: &usage_text[0_u64..usage_text.len]);
            return 2_u8;
          }
        }
        give number;
      }
      None() => {
        report(err: err, files: files, text: &usage_text[0_u64..usage_text.len]);
        return 2_u8;
      }
    }
    give parsed_reps;
  }
  let page = match read_argument_file(factory: files, cwd: cwd, args: args, position: 3_u64) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      report(err: err, files: files, text: &unreadable_text[0_u64..unreadable_text.len]);
      return 2_u8;
    }
  }
  let length = page.inner.len;
  let small = length <= 1073741824_u64;
  if small {
  } else {
    report(err: err, files: files, text: &large_text[0_u64..large_text.len]);
    return 2_u8;
  }
  let atoms = atom_table_new();
  let scripting = False();
  let parsed = parse_document(source: &page.inner[0_u64..length], scripting: scripting, atoms: &atoms);
  let document = match move parsed {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      report(err: err, files: files, text: &unparsed_text[0_u64..unparsed_text.len]);
      return 2_u8;
    }
  }
  let traversal = match build_traversal(document: &document) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  let no = False();
  let yes = True();
  let serif = FontMetrics(x_height: 0.45898437_f32, zero_advance: 0.5_f32, x_rounds_up: no);
  let sans = FontMetrics(x_height: 0.5283203_f32, zero_advance: 0.55615232_f32, x_rounds_up: no);
  let mono = FontMetrics(x_height: 0.546875_f32, zero_advance: 0.6020508_f32, x_rounds_up: yes);
  let environment = Environment(width: 1.28e3_f32, height: 7.2e2_f32, root_font_size: 16.0_f32, serif: serif, sans: sans, mono: mono);
  let store = rule_store_new();
  let ua = match read_argument_file(factory: files, cwd: cwd, args: args, position: 4_u64) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      report(err: err, files: files, text: &unreadable_text[0_u64..unreadable_text.len]);
      return 2_u8;
    }
  }
  let ua_size = ua.inner.len;
  let ua_small = ua_size <= 16777216_u64;
  if ua_small {
  } else {
    report(err: err, files: files, text: &large_text[0_u64..large_text.len]);
    return 2_u8;
  }
  match add_sheet(store: &store, source: &ua.inner[0_u64..ua_size], origin: origin_user_agent, environment: environment, atoms: &atoms) {
    Ok(..) => {
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  let script = if delta {
    let read = match read_argument_file(factory: files, cwd: cwd, args: args, position: 2_u64) {
      Ok(value: found) => {
        give move found;
      }
      Err(..) => {
        report(err: err, files: files, text: &unreadable_text[0_u64..unreadable_text.len]);
        return 2_u8;
      }
    }
    give move read;
  } else {
    let empty = box_slots_new::<u8>(capacity: 0_u64);
    give move empty;
  }
  let sources = sheet_sources(document: &document, traversal: &traversal);
  let source_count = sources.inner.len;
  for (k in 0_u64..source_count) {
    let source = sources.inner[k];
    match source {
      StyleElement(node: styled) => {
        match add_style_element(store: &store, document: &document, node: styled, environment: environment, atoms: &atoms) {
          Ok(..) => {
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
      }
      Link(node: linked, href: link_href, media: link_media) => {
        let applies = match link_media {
          Some(value: span) => {
            give media_holds(document: &document, span: span, environment: environment);
          }
          None() => {
            give True();
          }
        }
        if applies {
          match mapped_sheet(args: args, document: &document, href: link_href) {
            Some(value: position) => {
              let sheet = match read_mapped(files: files, cwd: cwd, args: args, position: position) {
                Ok(value: found) => {
                  give move found;
                }
                Err(..) => {
                  report(err: err, files: files, text: &unreadable_text[0_u64..unreadable_text.len]);
                  return 2_u8;
                }
              }
              let size = sheet.inner.len;
              let fits = size <= 16777216_u64;
              if fits {
              } else {
                report(err: err, files: files, text: &large_text[0_u64..large_text.len]);
                return 2_u8;
              }
              match add_sheet(store: &store, source: &sheet.inner[0_u64..size], origin: origin_author, environment: environment, atoms: &atoms) {
                Ok(..) => {
                }
                Err(error: failure) => {
                  report_style(err: err, files: files, failure: failure);
                  return 2_u8;
                }
              }
            }
            None() => {
              report(err: err, files: files, text: &unmapped_text[0_u64..unmapped_text.len]);
              let buffer = box_slots_new::<u8>(capacity: 128_u64);
              put_span(buffer: &buffer, document: &document, span: link_href);
              put_byte(buffer: &buffer, value: 10_u8);
              let written = flush(factory: files, output: err, buffer: &buffer);
            }
          }
        }
      }
    }
  }
  if delta {
    let script_size = script.inner.len;
    let notes = box_slots_new::<u8>(capacity: 256_u64);
    let added = add_script_sheets(store: &store, script: &script.inner[0_u64..script_size], environment: environment, atoms: &atoms, notes: &notes);
    if added {
    } else {
      let reported = flush(factory: files, output: err, buffer: &notes);
      return 2_u8;
    }
  }
  match add_style_attributes(store: &store, document: &document, traversal: &traversal, atoms: &atoms) {
    Ok(..) => {
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  match add_presentational_hints(store: &store, document: &document, traversal: &traversal, atoms: &atoms) {
    Ok(..) => {
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  if delta {
    let script_size = script.inner.len;
    let code = run_delta(store: &store, document: &document, atoms: &atoms, traversal: &traversal, environment: environment, script: &script.inner[0_u64..script_size], clock: clock, out: out, err: err, files: files);
    return code;
  }
  if mode == 0_u64 {
    let styles = match compute_styles(store: &store, document: &document, atoms: &atoms, traversal: &traversal, environment: environment) {
      Ok(value: found) => {
        give move found;
      }
      Err(error: failure) => {
        report_style(err: err, files: files, failure: failure);
        return 2_u8;
      }
    }
    let written = dump(styles: &styles, document: &document, atoms: &atoms, traversal: &traversal, out: out, files: files);
    if written {
      return 0_u8;
    }
    return 2_u8;
  }
  let distinct = box_slots_new::<u64>(capacity: 8_u64);
  for (rep in 0_u64..reps) {
    match run_parts(mode: mode, store: &store, document: &document, atoms: &atoms, traversal: &traversal, environment: environment) {
      Ok(value: counts) => {
        set distinct = move counts;
      }
      Err(error: failure) => {
        report_style(err: err, files: files, failure: failure);
        return 2_u8;
      }
    }
  }
  let buffer = box_slots_new::<u8>(capacity: 256_u64);
  put_argument(buffer: &buffer, args: args, position: 1_u64);
  put_text(buffer: &buffer, text: &elements_label[0_u64..elements_label.len]);
  put_decimal(buffer: &buffer, value: traversal.elements.inner.len);
  put_text(buffer: &buffer, text: &rules_label[0_u64..rules_label.len]);
  let rules = rule_count(store: &store);
  put_decimal(buffer: &buffer, value: rules);
  let groups = distinct.inner.len;
  if groups > 0_u64 {
    put_text(buffer: &buffer, text: &distinct_label[0_u64..distinct_label.len]);
    for (g in 0_u64..groups) {
      if g > 0_u64 {
        put_byte(buffer: &buffer, value: 32_u8);
      }
      put_decimal(buffer: &buffer, value: distinct.inner[g]);
    }
  }
  put_byte(buffer: &buffer, value: 10_u8);
  let written = flush(factory: files, output: out, buffer: &buffer);
  return 0_u8;
}

fn run_parts(mode: u64, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment) -> result: Result<Box<Slots<u64>>, StyleError> reads(store), reads(document), reads(traversal), writes(atoms) {
  doc "Runs the stage up to the part mode names, 1 match, 2 inherited, 3 reset, 4 all, and returns, after all, the distinct counts of the seven hashed groups and the custom sets, then the sizes of the four other groups' tables and of the list tables and generated text they name.";
  let counts = box_slots_new::<u64>(capacity: 8_u64);
  let cascade = propagate match_elements(store: store, document: document, atoms: atoms, traversal: traversal);
  if mode <= 1_u64 {
    return Ok<Box<Slots<u64>>, StyleError>(value: move counts);
  }
  let inherited = propagate inherited_pass(store: store, cascade: &cascade, document: document, atoms: atoms, traversal: traversal, environment: environment);
  if mode <= 2_u64 {
    return Ok<Box<Slots<u64>>, StyleError>(value: move counts);
  }
  let resets = propagate reset_pass(store: store, cascade: &cascade, inherited: &inherited, atoms: atoms, traversal: traversal, environment: environment);
  if mode <= 3_u64 {
    return Ok<Box<Slots<u64>>, StyleError>(value: move counts);
  }
  let styles = propagate intern_styles(inherited: &inherited, resets: &resets, traversal: traversal);
  put_count(cell: &counts, value: styles.boxes.inner.len);
  put_count(cell: &counts, value: styles.sizes.inner.len);
  put_count(cell: &counts, value: styles.spacings.inner.len);
  put_count(cell: &counts, value: styles.borders.inner.len);
  put_count(cell: &counts, value: styles.fonts.inner.len);
  put_count(cell: &counts, value: styles.texts.inner.len);
  put_count(cell: &counts, value: styles.backgrounds.inner.len);
  put_count(cell: &counts, value: styles.custom_sets);
  put_count(cell: &counts, value: styles.containers.inner.len);
  put_count(cell: &counts, value: styles.items.inner.len);
  put_count(cell: &counts, value: styles.tables.inner.len);
  put_count(cell: &counts, value: styles.contents.inner.len);
  put_count(cell: &counts, value: styles.tracks.inner.len);
  put_count(cell: &counts, value: styles.track_lists.inner.len);
  put_count(cell: &counts, value: styles.line_names.inner.len);
  put_count(cell: &counts, value: styles.area_maps.inner.len);
  put_count(cell: &counts, value: styles.named_areas.inner.len);
  put_count(cell: &counts, value: styles.content_lists.inner.len);
  put_count(cell: &counts, value: styles.content_items.inner.len);
  put_count(cell: &counts, value: styles.counter_lists.inner.len);
  put_count(cell: &counts, value: styles.counter_changes.inner.len);
  put_count(cell: &counts, value: styles.quote_lists.inner.len);
  put_count(cell: &counts, value: styles.quote_pairs.inner.len);
  put_count(cell: &counts, value: styles.generated_text.inner.len);
  return Ok<Box<Slots<u64>>, StyleError>(value: move counts);
}

fn put_count(cell: &Box<Slots<u64>>, value: u64) -> result: unit writes(cell) {
  doc "Appends one count.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +sat 8_u64;
    let bounded = doubled <= 1048576_u64;
    if bounded {
      grow(cell: cell, capacity: doubled);
    }
  }
  let room = cell^.inner.len < cell^.inner.cap;
  if room {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn put_span(buffer: &Box<Slots<u8>>, document: &Document, span: TextSpan) -> result: unit reads(document), writes(buffer) {
  doc "Appends the document text of span.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = document^.text.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
    put_text(buffer: buffer, text: &document^.text.inner[start..end]);
  }
  return unit;
}

fn put_atom(buffer: &Box<Slots<u8>>, atoms: &AtomTable, index: u32) -> result: unit reads(atoms), writes(buffer) {
  doc "Appends the text of the atom at index.";
  let at = cvt::<u32, u64>(index);
  let known = at < atoms^.spans.inner.len;
  if known {
  } else {
    return unit;
  }
  let span = atoms^.spans.inner[at];
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = atoms^.text.inner.len;
  let ordered = start <= end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
    put_text(buffer: buffer, text: &atoms^.text.inner[start..end]);
  }
  return unit;
}

fn put_number(buffer: &Box<Slots<u8>>, value: f64) -> result: unit writes(buffer) {
  doc "Appends value with at most six significant digits and no trailing zeros, as Chromium serializes a number.";
  let zero = feq(value, 0.0_f64);
  let finite_low = fgt(value, -1.0e30_f64);
  let finite_high = flt(value, 1.0e30_f64);
  let finite = band(finite_low, finite_high);
  let arg_1 = bnot(finite);
  let unusable = bor(zero, arg_1);
  if unusable {
    put_byte(buffer: buffer, value: 48_u8);
    return unit;
  }
  let negative = flt(value, 0.0_f64);
  let magnitude = if negative {
    give fneg(value);
  } else {
    give value;
  }
  let scaled = magnitude;
  let exponent = 5_i64;
  for (step in 0_u64..80_u64) {
    let big = fge(scaled, 1.0e6_f64);
    let tiny = flt(scaled, 1.0e5_f64);
    if big {
      set scaled = fdiv.strict(scaled, 10.0_f64);
      set exponent = exponent +sat 1_i64;
    } else if tiny {
      set scaled = fmul.strict(scaled, 10.0_f64);
      set exponent = exponent -sat 1_i64;
    } else {
      break;
    }
  }
  let rounded = froundeven(scaled);
  let fits = cvt.defined::<f64, u64>(rounded);
  let digits_value = if fits {
    give cvt::<f64, u64>(rounded);
  } else {
    give 100000_u64;
  }
  if digits_value >= 1000000_u64 {
    set digits_value = 100000_u64;
    set exponent = exponent +sat 1_i64;
  }
  let small = exponent < -6_i64;
  if small {
    put_byte(buffer: buffer, value: 48_u8);
    return unit;
  }
  if negative {
    put_byte(buffer: buffer, value: 45_u8);
  }
  let digits = array_filled::<u8, 6>(value: 48_u8);
  let rest = digits_value;
  for (k in 0_u64..6_u64) {
    let place = 5_u64 - k;
    let digit = rest % 10_u64;
    set rest = rest / 10_u64;
    let byte = cvt::<u64, u8>(digit);
    set digits[place] = byte +sat 48_u8;
  }
  let last = 6_u64;
  for (k in 0_u64..6_u64) {
    let at = 5_u64 - k;
    if digits[at] == 48_u8 {
      set last = at;
    } else {
      break;
    }
  }
  if exponent >= 5_i64 {
    put_text(buffer: buffer, text: &digits[0_u64..6_u64]);
    let zeros = exponent -sat 5_i64;
    let count = cvt.wrap::<i64, u64>(zeros);
    for (z in 0_u64..count) {
      put_byte(buffer: buffer, value: 48_u8);
    }
    return unit;
  }
  if exponent >= 0_i64 {
    let point_raw = exponent +sat 1_i64;
    let point = cvt.wrap::<i64, u64>(point_raw);
    let whole_end = if point <= 6_u64 {
      give point;
    } else {
      give 6_u64;
    }
    put_text(buffer: buffer, text: &digits[0_u64..whole_end]);
    if last > whole_end {
      if last <= 6_u64 {
        put_byte(buffer: buffer, value: 46_u8);
        put_text(buffer: buffer, text: &digits[whole_end..last]);
      }
    }
    return unit;
  }
  put_byte(buffer: buffer, value: 48_u8);
  put_byte(buffer: buffer, value: 46_u8);
  let leading_raw = -1_i64 -sat exponent;
  let leading = cvt.wrap::<i64, u64>(leading_raw);
  for (z in 0_u64..leading) {
    put_byte(buffer: buffer, value: 48_u8);
  }
  let end = if last > 6_u64 {
    give 6_u64;
  } else {
    give last;
  }
  put_text(buffer: buffer, text: &digits[0_u64..end]);
  return unit;
}

fn put_px(buffer: &Box<Slots<u8>>, value: f32) -> result: unit writes(buffer) {
  doc "Appends a length in px.";
  let wide = cvt::<f32, f64>(value);
  put_number(buffer: buffer, value: wide);
  put_text(buffer: buffer, text: &px_word[0_u64..px_word.len]);
  return unit;
}

fn put_length_percentage(buffer: &Box<Slots<u8>>, value: LengthPercentage) -> result: unit writes(buffer) {
  doc "Appends a length, a percentage, or calc(P% + Npx) for both, as Chromium serializes a computed length-percentage.";
  let no_px = feq(value.px, 0.0_f32);
  if value.has_percent {
    let percent = cvt::<f32, f64>(value.percent);
    if no_px {
      put_number(buffer: buffer, value: percent);
      put_byte(buffer: buffer, value: 37_u8);
      return unit;
    }
    put_text(buffer: buffer, text: &calc_word[0_u64..calc_word.len]);
    put_number(buffer: buffer, value: percent);
    put_byte(buffer: buffer, value: 37_u8);
    let negative = flt(value.px, 0.0_f32);
    if negative {
      put_byte(buffer: buffer, value: 32_u8);
      put_byte(buffer: buffer, value: 45_u8);
      put_byte(buffer: buffer, value: 32_u8);
      let magnitude = fneg(value.px);
      put_px(buffer: buffer, value: magnitude);
    } else {
      put_byte(buffer: buffer, value: 32_u8);
      put_byte(buffer: buffer, value: 43_u8);
      put_byte(buffer: buffer, value: 32_u8);
      put_px(buffer: buffer, value: value.px);
    }
    put_byte(buffer: buffer, value: 41_u8);
    return unit;
  }
  put_px(buffer: buffer, value: value.px);
  return unit;
}

fn put_sizing(buffer: &Box<Slots<u8>>, longhand: u8, value: Sizing) -> result: unit writes(buffer) {
  doc "Appends a sizing value: auto, none, normal, a keyword of the longhand, a number, or a length-percentage.";
  if value.kind == sizing_auto {
    put_text(buffer: buffer, text: &auto_word[0_u64..auto_word.len]);
    return unit;
  }
  if value.kind == sizing_none {
    put_text(buffer: buffer, text: &none_word[0_u64..none_word.len]);
    return unit;
  }
  if value.kind == sizing_normal {
    put_text(buffer: buffer, text: &normal_word[0_u64..normal_word.len]);
    return unit;
  }
  if value.kind == sizing_keyword {
    put_keyword(out: buffer, longhand: longhand, keyword: value.keyword);
    return unit;
  }
  if value.kind == sizing_number {
    let number = cvt::<f32, f64>(value.value.px);
    put_number(buffer: buffer, value: number);
    return unit;
  }
  put_length_percentage(buffer: buffer, value: value.value);
  return unit;
}

fn channel(value: f32) -> byte: u64 pure {
  doc "An Rgb channel rounded to an integer from 0 to 255.";
  let wide = cvt::<f32, f64>(value);
  let rounded = froundeven(wide);
  let low = flt(rounded, 0.0_f64);
  if low {
    return 0_u64;
  }
  let high = fgt(rounded, 255.0_f64);
  if high {
    return 255_u64;
  }
  let fits = cvt.defined::<f64, u64>(rounded);
  if fits {
    let made = cvt::<f64, u64>(rounded);
    return made;
  }
  return 0_u64;
}

fn put_color(buffer: &Box<Slots<u8>>, color: Color) -> result: unit writes(buffer) {
  doc "Appends an Rgb color as rgb(r, g, b), or rgba(r, g, b, a) below full alpha with the alpha taken to eight bits and written with at most two decimals.";
  let r = channel(value: color.first);
  let g = channel(value: color.second);
  let b = channel(value: color.third);
  let alpha = cvt::<f32, f64>(color.alpha);
  let byte_alpha = fmul.strict(alpha, 255.0_f64);
  let alpha_byte = froundeven(byte_alpha);
  let full_alpha = fge(alpha_byte, 255.0_f64);
  if full_alpha {
    put_text(buffer: buffer, text: &rgb_word[0_u64..rgb_word.len]);
  } else {
    put_text(buffer: buffer, text: &rgba_word[0_u64..rgba_word.len]);
  }
  put_decimal(buffer: buffer, value: r);
  put_text(buffer: buffer, text: &separator[0_u64..separator.len]);
  put_decimal(buffer: buffer, value: g);
  put_text(buffer: buffer, text: &separator[0_u64..separator.len]);
  put_decimal(buffer: buffer, value: b);
  if full_alpha {
  } else {
    put_text(buffer: buffer, text: &separator[0_u64..separator.len]);
    let fraction = fdiv.strict(alpha_byte, 255.0_f64);
    let hundredths = fmul.strict(fraction, 1.0e2_f64);
    let rounded = froundeven(hundredths);
    let two = fdiv.strict(rounded, 1.0e2_f64);
    put_number(buffer: buffer, value: two);
  }
  put_byte(buffer: buffer, value: 41_u8);
  return unit;
}

fn put_color_ref(buffer: &Box<Slots<u8>>, reference: ColorRef, current: Color) -> result: unit writes(buffer) {
  doc "Appends a color, currentcolor resolved to the element's color.";
  if reference.current {
    put_color(buffer: buffer, color: current);
    return unit;
  }
  put_color(buffer: buffer, color: reference.color);
  return unit;
}

fn plain_name(atoms: &AtomTable, index: u32) -> plain: Bool reads(atoms) {
  doc "True when the atom's text is one CSS identifier: letters, digits, hyphens, underscores and non-ASCII bytes, not starting with a digit.";
  let at = cvt::<u32, u64>(index);
  let known = at < atoms^.spans.inner.len;
  if known {
  } else {
    return False();
  }
  let span = atoms^.spans.inner[at];
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = atoms^.text.inner.len;
  let ordered = start < end;
  let inside = end <= length;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return False();
  }
  let first = atoms^.text.inner[start];
  let arg_2 = first >= 48_u8;
  let arg_3 = first <= 57_u8;
  let digit_first = band(arg_2, arg_3);
  if digit_first {
    return False();
  }
  for (k in start..end) {
    let byte = atoms^.text.inner[k];
    let arg_4 = byte >= 97_u8;
    let arg_5 = byte <= 122_u8;
    let lower = band(arg_4, arg_5);
    let arg_6 = byte >= 65_u8;
    let arg_7 = byte <= 90_u8;
    let upper = band(arg_6, arg_7);
    let arg_8 = byte >= 48_u8;
    let arg_9 = byte <= 57_u8;
    let digit = band(arg_8, arg_9);
    let dash = byte == 45_u8;
    let under = byte == 95_u8;
    let high = byte >= 128_u8;
    let letter = bor(lower, upper);
    let mark = bor(dash, under);
    let some = bor(letter, digit);
    let other = bor(mark, high);
    let allowed = bor(some, other);
    if allowed {
    } else {
      return False();
    }
  }
  return True();
}

fn put_families(buffer: &Box<Slots<u8>>, styles: &Styles, atoms: &AtomTable, start: u32, end: u32) -> result: unit reads(styles), reads(atoms), writes(buffer) {
  doc "Appends a family list: generic and single-identifier names bare, others double-quoted, separated by a comma and a space.";
  let low = cvt::<u32, u64>(start);
  let high = cvt::<u32, u64>(end);
  let count = styles^.families.inner.len;
  let ordered = low <= high;
  let inside = high <= count;
  let usable = band(ordered, inside);
  if usable {
  } else {
    return unit;
  }
  for (k in low..high) {
    if k > low {
      put_text(buffer: buffer, text: &separator[0_u64..separator.len]);
    }
    let family = styles^.families.inner[k];
    let plain = plain_name(atoms: atoms, index: family.name.index);
    let bare = bor(family.generic, plain);
    if bare {
      put_atom(buffer: buffer, atoms: atoms, index: family.name.index);
    } else {
      put_byte(buffer: buffer, value: 34_u8);
      put_atom(buffer: buffer, atoms: atoms, index: family.name.index);
      put_byte(buffer: buffer, value: 34_u8);
    }
  }
  return unit;
}

fn put_decoration(buffer: &Box<Slots<u8>>, bits: u8) -> result: unit writes(buffer) {
  doc "Appends text-decoration-line: none, or its lines separated by spaces.";
  if bits == 0_u8 {
    put_text(buffer: buffer, text: &none_word[0_u64..none_word.len]);
    return unit;
  }
  let first = True();
  let n = decoration_words.len;
  for (k in 0_u64..4_u64) {
    let shift = cvt::<u64, u8>(k);
    let arg_10 = cvt::<u8, u32>(shift);
    let mask = ishl(1_u8, arg_10);
    let held = iand(bits, mask);
    if held != 0_u8 {
      if first {
        set first = False();
      } else {
        put_byte(buffer: buffer, value: 32_u8);
      }
      put_nth_word(buffer: buffer, list: &decoration_words[0_u64..n], index: k);
    }
  }
  return unit;
}

fn put_nth_word(buffer: &Box<Slots<u8>>, list: &[u8], index: u64) -> result: unit reads(list), writes(buffer) {
  doc "Appends word number index of the space-separated list.";
  let length = list^.len;
  let word = 0_u64;
  let start = 0_u64;
  let stop = length +sat 1_u64;
  for (at in 0_u64..stop) {
    let boundary = at >= length;
    let space = if boundary {
      give True();
    } else {
      give list^[at] == 32_u8;
    }
    if space {
      if word == index {
        let ordered = start <= at;
        let inside = at <= length;
        let usable = band(ordered, inside);
        if usable {
          put_text(buffer: buffer, text: &list^[start..at]);
        }
        return unit;
      }
      set word = word +sat 1_u64;
      set start = at +sat 1_u64;
    }
  }
  return unit;
}

fn put_tab(buffer: &Box<Slots<u8>>) -> result: unit writes(buffer) {
  doc "Appends a tab.";
  put_byte(buffer: buffer, value: 9_u8);
  return unit;
}

fn local_name(document: &Document, node: NodeId) -> name: u32 reads(document) {
  doc "The atom index of an element's local name, or 0.";
  let index = cvt::<u32, u64>(node.index);
  let known = index < document^.nodes.inner.len;
  if known {
  } else {
    return 0_u32;
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(namespace: space, local_name: local, attributes: list, template_contents: held) => {
      return local^.index;
    }
    DocumentRoot(..) => {
    }
    DocumentType(..) => {
    }
    Text(..) => {
    }
    Comment(..) => {
    }
    Fragment() => {
    }
  }
  return 0_u32;
}

fn put_element(buffer: &Box<Slots<u8>>, styles: &Styles, atoms: &AtomTable, style: ComputedStyle) -> result: unit reads(styles), reads(atoms), writes(buffer) {
  doc "Appends a styled node's 55 values of the first batch, each after a tab.";
  let box_at = cvt::<u32, u64>(style.box);
  let size_at = cvt::<u32, u64>(style.size);
  let spacing_at = cvt::<u32, u64>(style.spacing);
  let border_at = cvt::<u32, u64>(style.border);
  let font_at = cvt::<u32, u64>(style.font);
  let text_at = cvt::<u32, u64>(style.text);
  let background_at = cvt::<u32, u64>(style.background);
  let b1 = box_at < styles^.boxes.inner.len;
  let b2 = size_at < styles^.sizes.inner.len;
  let b3 = spacing_at < styles^.spacings.inner.len;
  let b4 = border_at < styles^.borders.inner.len;
  let b5 = font_at < styles^.fonts.inner.len;
  let b6 = text_at < styles^.texts.inner.len;
  let b7 = background_at < styles^.backgrounds.inner.len;
  let c1 = band(b1, b2);
  let c2 = band(b3, b4);
  let c3 = band(b5, b6);
  let c4 = band(c1, c2);
  let c5 = band(c3, b7);
  let all = band(c4, c5);
  if all {
  } else {
    return unit;
  }
  let box_group = styles^.boxes.inner[box_at];
  let size = styles^.sizes.inner[size_at];
  let spacing = styles^.spacings.inner[spacing_at];
  let border = styles^.borders.inner[border_at];
  let font = styles^.fonts.inner[font_at];
  let text = styles^.texts.inner[text_at];
  let background = styles^.backgrounds.inner[background_at];
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 0_u8, keyword: box_group.display);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 1_u8, keyword: box_group.position);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 2_u8, keyword: box_group.float);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 3_u8, keyword: box_group.clear);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 4_u8, keyword: box_group.overflow_x);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 5_u8, keyword: box_group.overflow_y);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 6_u8, keyword: box_group.box_sizing);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 7_u8, keyword: box_group.visibility);
  put_tab(buffer: buffer);
  if box_group.z_auto {
    put_text(buffer: buffer, text: &auto_word[0_u64..auto_word.len]);
  } else {
    let negative = box_group.z_index < 0_i32;
    if negative {
      put_byte(buffer: buffer, value: 45_u8);
      let wide = cvt::<i32, i64>(box_group.z_index);
      let magnitude = 0_i64 -sat wide;
      let unsigned = cvt.wrap::<i64, u64>(magnitude);
      put_decimal(buffer: buffer, value: unsigned);
    } else {
      let unsigned = cvt.wrap::<i32, u64>(box_group.z_index);
      put_decimal(buffer: buffer, value: unsigned);
    }
  }
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 9_u8, value: size.width);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 10_u8, value: size.height);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 11_u8, value: size.min_width);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 12_u8, value: size.min_height);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 13_u8, value: size.max_width);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 14_u8, value: size.max_height);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 15_u8, value: size.top);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 16_u8, value: size.right);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 17_u8, value: size.bottom);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 18_u8, value: size.left);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 19_u8, value: spacing.margin_top);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 20_u8, value: spacing.margin_right);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 21_u8, value: spacing.margin_bottom);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 22_u8, value: spacing.margin_left);
  put_tab(buffer: buffer);
  put_length_percentage(buffer: buffer, value: spacing.padding_top);
  put_tab(buffer: buffer);
  put_length_percentage(buffer: buffer, value: spacing.padding_right);
  put_tab(buffer: buffer);
  put_length_percentage(buffer: buffer, value: spacing.padding_bottom);
  put_tab(buffer: buffer);
  put_length_percentage(buffer: buffer, value: spacing.padding_left);
  put_tab(buffer: buffer);
  put_px(buffer: buffer, value: border.top_width);
  put_tab(buffer: buffer);
  put_px(buffer: buffer, value: border.right_width);
  put_tab(buffer: buffer);
  put_px(buffer: buffer, value: border.bottom_width);
  put_tab(buffer: buffer);
  put_px(buffer: buffer, value: border.left_width);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 31_u8, keyword: border.top_style);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 32_u8, keyword: border.right_style);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 33_u8, keyword: border.bottom_style);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 34_u8, keyword: border.left_style);
  put_tab(buffer: buffer);
  put_color_ref(buffer: buffer, reference: border.top_color, current: text.color);
  put_tab(buffer: buffer);
  put_color_ref(buffer: buffer, reference: border.right_color, current: text.color);
  put_tab(buffer: buffer);
  put_color_ref(buffer: buffer, reference: border.bottom_color, current: text.color);
  put_tab(buffer: buffer);
  put_color_ref(buffer: buffer, reference: border.left_color, current: text.color);
  put_tab(buffer: buffer);
  put_families(buffer: buffer, styles: styles, atoms: atoms, start: font.families_start, end: font.families_end);
  put_tab(buffer: buffer);
  put_px(buffer: buffer, value: font.size);
  put_tab(buffer: buffer);
  let weight = cvt::<f32, f64>(font.weight);
  put_number(buffer: buffer, value: weight);
  put_tab(buffer: buffer);
  if font.style == 0_u8 {
    put_text(buffer: buffer, text: &normal_word[0_u64..normal_word.len]);
  } else {
    put_text(buffer: buffer, text: &italic_word[0_u64..italic_word.len]);
  }
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 43_u8, value: font.line_height);
  put_tab(buffer: buffer);
  put_color(buffer: buffer, color: text.color);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 45_u8, keyword: text.text_align);
  put_tab(buffer: buffer);
  put_length_percentage(buffer: buffer, value: text.text_indent);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 47_u8, keyword: text.text_transform);
  put_tab(buffer: buffer);
  put_keyword(out: buffer, longhand: 48_u8, keyword: text.white_space);
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 49_u8, value: text.letter_spacing);
  put_tab(buffer: buffer);
  if text.word_spacing.kind == sizing_normal {
    put_text(buffer: buffer, text: &zero_px[0_u64..zero_px.len]);
  } else {
    put_sizing(buffer: buffer, longhand: 50_u8, value: text.word_spacing);
  }
  put_tab(buffer: buffer);
  put_sizing(buffer: buffer, longhand: 51_u8, value: text.vertical_align);
  put_tab(buffer: buffer);
  put_decoration(buffer: buffer, bits: text.decoration_line);
  put_tab(buffer: buffer);
  put_atom(buffer: buffer, atoms: atoms, index: text.list_style_type.index);
  put_tab(buffer: buffer);
  put_color_ref(buffer: buffer, reference: background.color, current: text.color);
  return unit;
}

fn dump(styles: &Styles, document: &Document, atoms: &AtomTable, traversal: &Traversal, out: &OutputStream, files: &HandleFactory) -> written: Bool reads(styles), reads(document), reads(atoms), reads(traversal), writes(out), writes(files) waits {
  doc "Writes the header, one line per element and one line per ::before and ::after whose content is not none, after the elements in document order.";
  let buffer = box_slots_new::<u8>(capacity: 65536_u64);
  put_text(buffer: &buffer, text: &header_text[0_u64..header_text.len]);
  let count = traversal^.elements.inner.len;
  let listed = styles^.elements.inner.len;
  for (k in 0_u64..count) {
    let inside = k < listed;
    if inside {
      put_decimal(buffer: &buffer, value: k);
      put_tab(buffer: &buffer);
      let node = traversal^.elements.inner[k];
      let name = local_name(document: document, node: node);
      put_atom(buffer: &buffer, atoms: atoms, index: name);
      put_element(buffer: &buffer, styles: styles, atoms: atoms, style: styles^.elements.inner[k]);
      put_second(buffer: &buffer, styles: styles, atoms: atoms, document: document, element: node, style: styles^.elements.inner[k]);
      put_byte(buffer: &buffer, value: 10_u8);
    }
    let full = buffer.inner.len >= 60000_u64;
    if full {
      let ok = flush(factory: files, output: out, buffer: &buffer);
      if ok {
      } else {
        return False();
      }
    }
  }
  let pseudos = styles^.pseudos.inner.len;
  for (p in 0_u64..pseudos) {
    let pseudo = styles^.pseudos.inner[p];
    let origin = cvt::<u32, u64>(pseudo.element);
    let content_at = cvt::<u32, u64>(pseudo.style.content);
    let known_origin = origin < count;
    let known_content = content_at < styles^.contents.inner.len;
    let known = band(known_origin, known_content);
    if known {
      let content_id = styles^.contents.inner[content_at].content;
      let generates = content_id > 1_u32;
      if generates {
        put_decimal(buffer: &buffer, value: origin);
        put_tab(buffer: &buffer);
        if pseudo.kind == pseudo_after {
          put_text(buffer: &buffer, text: &after_name[0_u64..after_name.len]);
        } else {
          put_text(buffer: &buffer, text: &before_name[0_u64..before_name.len]);
        }
        let node = traversal^.elements.inner[origin];
        put_element(buffer: &buffer, styles: styles, atoms: atoms, style: pseudo.style);
        put_second(buffer: &buffer, styles: styles, atoms: atoms, document: document, element: node, style: pseudo.style);
        put_byte(buffer: &buffer, value: 10_u8);
      }
    }
    let full = buffer.inner.len >= 60000_u64;
    if full {
      let ok = flush(factory: files, output: out, buffer: &buffer);
      if ok {
      } else {
        return False();
      }
    }
  }
  let ok = flush(factory: files, output: out, buffer: &buffer);
  return ok;
}

fn read_suffix_path(factory: &HandleFactory, cwd: &DirectoryRead, args: &Args, position: u64) -> result: Result<Box<Slots<u8>>, IoError> reads(cwd), reads(args), writes(factory) waits {
  doc "Reads the file whose relative path follows the last = of the argument at position: its directories opened from cwd one by one, then its last component.";
  let bytes = match argument_bytes(args: args, position: position) {
    Some(value: found) => {
      give move found;
    }
    None() => {
      let empty = box_slots_new::<u8>(capacity: 0_u64);
      give move empty;
    }
  }
  let size = bytes.inner.len;
  let equals = match last_equals(bytes: &bytes.inner[0_u64..size]) {
    Some(value: at) => {
      give at;
    }
    None() => {
      give 0_u64;
    }
  }
  let start = equals +sat 1_u64;
  let slash = start;
  let has_slash = False();
  for (k in start..size) {
    if bytes.inner[k] == 47_u8 {
      set slash = k;
      set has_slash = True();
    }
  }
  let name_start = if has_slash {
    give slash +sat 1_u64;
  } else {
    give start;
  }
  let ordered = name_start <= size;
  let start_ordered = start <= slash;
  let slash_inside = slash <= size;
  let arg_11 = band(start_ordered, slash_inside);
  let usable = band(ordered, arg_11);
  if usable {
  } else {
    let empty = box_slots_new::<u8>(capacity: 0_u64);
    return Ok<Box<Slots<u8>>, IoError>(value: move empty);
  }
  if has_slash {
    let directory = match open_directory_path(factory: factory, root: cwd, name: &bytes.inner[start..slash]) {
      Ok(value: found) => {
        give move found;
      }
      Err(error: problem) => {
        return Err<Box<Slots<u8>>, IoError>(error: problem);
      }
    }
    let read = read_directory_file(factory: factory, directory: &directory, name: &bytes.inner[name_start..size]);
    close_directory(factory: factory, directory: move directory);
    return move read;
  }
  let read = read_directory_file(factory: factory, directory: cwd, name: &bytes.inner[name_start..size]);
  return move read;
}
