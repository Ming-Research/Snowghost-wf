alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias AttributeNamespace = pkg::dom::AttributeNamespace;
alias Clock = std::time::Clock;
alias Instant = std::time::Instant;
alias Document = pkg::dom::Document;
alias Environment = pkg::css::values::Environment;
alias HandleFactory = std::io::HandleFactory;
alias NodeId = pkg::dom::NodeId;
alias OutputStream = std::io::OutputStream;
alias RuleStore = pkg::style::RuleStore;
alias StyleError = pkg::style::StyleError;
alias Styles = pkg::style::Styles;
alias TextSpan = pkg::dom::TextSpan;
alias Traversal = pkg::style::Traversal;
alias add_sheet = pkg::style::add_sheet;
alias ComputedStyle = pkg::style::ComputedStyle;
alias Restyled = pkg::style::Restyled;
alias StyleState = pkg::style::StyleState;
alias restyle_state = pkg::style::restyle;
alias style_state = pkg::style::style_state;
alias Cascade = pkg::style::Cascade;
alias RestyleSet = pkg::style::RestyleSet;
alias class_restyle = pkg::style::class_restyle;
alias match_elements = pkg::style::match_elements;
alias rematched = pkg::style::rematched;
alias atom_intern = pkg::base::atom::atom_intern;
alias compute_styles = pkg::style::compute_styles;
alias flush = pkg::oracle::support::flush;
alias layout_changes = pkg::style::layout_changes;
alias line_end = pkg::oracle::support::line_end;
alias nanoseconds_from = std::time::nanoseconds_from;
alias now = std::time::now;
alias origin_author = pkg::style::origin_author;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_text = pkg::oracle::support::put_text;
alias set_attribute = pkg::dom::set_attribute;
alias store_text = pkg::dom::store_text;

const class_name: Array<u8, 5> = "class";

const edit_label: Array<u8, 5> = "edit ";

const restyle_label: Array<u8, 8> = "restyle ";

const visited_label: Array<u8, 9> = " visited ";

const differ_label: Array<u8, 8> = " differ ";

const rebuilt_label: Array<u8, 8> = " rebuilt";

const set_us_label: Array<u8, 8> = " set_us ";

const restyle_us_label: Array<u8, 12> = " restyle_us ";

const set_label: Array<u8, 5> = " set ";

const full_label: Array<u8, 5> = " full";

const rematched_label: Array<u8, 11> = " rematched ";

const missing_label: Array<u8, 9> = " missing ";

const first_label: Array<u8, 7> = " first ";

const changed_label: Array<u8, 9> = " changed ";

const time_label: Array<u8, 9> = " time_us ";

const flags_label: Array<u8, 6> = "flags ";

const dump_label: Array<u8, 5> = "dump ";

const line_label: Array<u8, 17> = "edit script line ";

const refused_label: Array<u8, 10> = " refused: ";

const operation_reason: Array<u8, 28> = "the operation does not apply";

const syntax_reason: Array<u8, 20> = "unreadable operation";

const sheet_late_reason: Array<u8, 34> = "a style sheet line follows an edit";

fn field_end(line: &[u8], start: u64) -> end: u64 reads(line) {
  doc "The index of the first space at or after start in line, or the length of line when there is none.";
  let length = line^.len;
  if start >= length {
    return length;
  }
  for (at in start..length) {
    if line^[at] == 32_u8 {
      return at;
    }
  }
  return length;
}

fn read_number(line: &[u8], start: u64) -> (found: Bool, value: u64, next: u64) reads(line) {
  doc "Parses the field of line that starts at start as a decimal number, and returns where the next field starts, past the space that ends this one.";
  let length = line^.len;
  let no = False();
  let yes = True();
  if start >= length {
    return no, 0_u64, length;
  }
  let end = field_end(line: line, start: start);
  match parse_decimal(text: line, start: start, end: end) {
    Some(value: number) => {
      let next = end +sat 1_u64;
      return yes, number, next;
    }
    None() => {
      return no, 0_u64, length;
    }
  }
}

fn node_id_of(value: u64) -> node: Option<NodeId> pure {
  doc "The node identifier with index value, or None when value does not fit one.";
  if value < 4294967295_u64 {
    let index = cvt::<u64, u32>(value);
    let id = NodeId(index: index);
    return Some<NodeId>(value: id);
  }
  return None<NodeId>();
}

fn class_span(document: &Document, holder: NodeId, class_atom: u32) -> (is_element: Bool, has_class: Bool, span: TextSpan) reads(document) {
  doc "Whether holder is an Element, whether it has an attribute class without a namespace, and the span of that attribute's value, within the document's text.";
  let no = False();
  let yes = True();
  let none = TextSpan(start: 0_u32, end: 0_u32);
  let at = cvt::<u32, u64>(holder.index);
  if at < document^.nodes.inner.len {
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Element(namespace: space, local_name: name, attributes: list, template_contents: contents) => {
        let count = list^.inner.len;
        for (k in 0_u64..count) {
          let held = list^.inner[k];
          let plain_space = AttributeNamespace::NoNamespace();
          let plain = eeq(held.namespace, plain_space);
          let named = held.name.index == class_atom;
          let same = band(plain, named);
          if same {
            let start = cvt::<u32, u64>(held.value.start);
            let end = cvt::<u32, u64>(held.value.end);
            let ordered = start <= end;
            let inside = end <= document^.text.inner.len;
            let usable = band(ordered, inside);
            if usable {
              return yes, yes, held.value;
            }
            return yes, no, none;
          }
        }
        return yes, no, none;
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return no, no, none;
}

fn put_without_token(buffer: &Box<Slots<u8>>, value: &[u8], token: &[u8]) -> found: Bool reads(value), reads(token), writes(buffer) {
  doc "Appends value without its last whole token equal to token, and the space before it (the space after it for a first token); False, with nothing appended, when value has no such token. A token is a run between spaces.";
  let length = value^.len;
  let size = token^.len;
  if size == 0_u64 {
    return False();
  }
  let best = length;
  let seen = False();
  for (start in 0_u64..length) {
    let end = start +sat size;
    if end <= length {
      let before_ok = if start == 0_u64 {
        give True();
      } else {
        let previous = start - 1_u64;
        give value^[previous] == 32_u8;
      }
      let after_ok = if end == length {
        give True();
      } else {
        give value^[end] == 32_u8;
      }
      let edges = band(before_ok, after_ok);
      if edges {
        let same = True();
        for (k in 0_u64..size) {
          let at = start +sat k;
          if at < length {
            if value^[at] != token^[k] {
              set same = False();
            }
          }
        }
        if same {
          set best = start;
          set seen = True();
        }
      }
    }
  }
  if seen {
  } else {
    return False();
  }
  let end = best +sat size;
  let cut_start = if best > 0_u64 {
    give best - 1_u64;
  } else {
    give best;
  }
  let cut_end = if best > 0_u64 {
    give end;
  } else {
    let after = end +sat 1_u64;
    give imin(after, length);
  }
  if cut_start <= cut_end {
    if cut_end <= length {
      put_text(buffer: buffer, text: &value^[0_u64..cut_start]);
      put_text(buffer: buffer, text: &value^[cut_end..length]);
      return True();
    }
  }
  return False();
}

fn edit_class(document: &Document, holder: NodeId, class_atom: u32, token: &[u8], add: Bool) -> ok: Bool reads(token), writes(document) {
  doc "Adds token to the class attribute of the Element holder, after the other tokens and creating the attribute when it has none, or removes it from there; False when holder is no Element, when a removed token is not in the class attribute, or when the attribute cannot be stored.";
  let (is_element, has_class, span) = class_span(document: document, holder: holder, class_atom: class_atom);
  if is_element {
  } else {
    return False();
  }
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let scratch = box_slots_new::<u8>(capacity: 256_u64);
  if add {
    if has_class {
      if start < end {
        if end <= document^.text.inner.len {
          put_text(buffer: &scratch, text: &document^.text.inner[start..end]);
          put_byte(buffer: &scratch, value: 32_u8);
        }
      }
    }
    put_text(buffer: &scratch, text: token);
  } else {
    if has_class {
    } else {
      return False();
    }
    let removed = if start <= end {
      if end <= document^.text.inner.len {
        give put_without_token(buffer: &scratch, value: &document^.text.inner[start..end], token: token);
      } else {
        give False();
      }
    } else {
      give False();
    }
    if removed {
    } else {
      return False();
    }
  }
  let size = scratch.inner.len;
  if size > 1073741824_u64 {
    return False();
  }
  match store_text(document: document, text: &scratch.inner[0_u64..size]) {
    Ok(value: stored) => {
      let plain = AttributeNamespace::NoNamespace();
      let name = Atom(index: class_atom);
      let attribute = Attribute(namespace: plain, name: name, value: stored);
      match set_attribute(document: document, element: holder, attribute: attribute) {
        Ok(..) => {
          return True();
        }
        Err(..) => {
          return False();
        }
      }
    }
    Err(..) => {
      return False();
    }
  }
}

fn class_index(atoms: &AtomTable) -> index: u32 writes(atoms) {
  doc "The atom of the attribute name class, or 4294967295 when the table refuses it, which no attribute carries.";
  match atom_intern(table: atoms, name: &class_name[0_u64..class_name.len]) {
    Ok(value: found) => {
      return found.index;
    }
    Err(..) => {
      return 4294967295_u32;
    }
  }
}

fn add_script_sheets(store: &RuleStore, script: &[u8], environment: Environment, atoms: &AtomTable, notes: &Box<Slots<u8>>) -> ok: Bool reads(script), writes(store), writes(atoms), writes(notes) {
  doc "Adds the text of each S line of the script as an author style sheet, and checks that every other line is empty, an edit (C, K, N, B or X) or a request (P), and that no S line follows an edit.";
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edited = False();
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return False();
    }
    if start < end {
      let kind = script^[start];
      let body = start +sat 2_u64;
      if kind == 83_u8 {
        if edited {
          put_failure(notes: notes, number: number, reason: &sheet_late_reason[0_u64..sheet_late_reason.len]);
          return False();
        }
        if body <= end {
          let width = end - body;
          if width > 16777216_u64 {
            put_failure(notes: notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
            return False();
          }
          match add_sheet(store: store, source: &script^[body..end], origin: origin_author, environment: environment, atoms: atoms) {
            Ok(..) => {
            }
            Err(..) => {
              put_failure(notes: notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
              return False();
            }
          }
        }
      } else if kind == 80_u8 {
      } else {
        let is_c = kind == 67_u8;
        let is_k = kind == 75_u8;
        let is_n = kind == 78_u8;
        let is_b = kind == 66_u8;
        let is_x = kind == 88_u8;
        let structure_edit = bor(is_b, is_x);
        let class_edit = bor(is_c, is_k);
        let ordinary = bor(class_edit, is_n);
        let known = bor(ordinary, structure_edit);
        if known {
          set edited = True();
        } else {
          put_failure(notes: notes, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          return False();
        }
      }
    }
  }
  return True();
}

fn put_failure(notes: &Box<Slots<u8>>, number: u64, reason: &[u8]) -> result: unit reads(reason), writes(notes) {
  doc "Appends `edit script line NUMBER refused: REASON` to notes.";
  put_text(buffer: notes, text: &line_label[0_u64..line_label.len]);
  put_decimal(buffer: notes, value: number);
  put_text(buffer: notes, text: &refused_label[0_u64..refused_label.len]);
  put_text(buffer: notes, text: reason);
  put_byte(buffer: notes, value: 10_u8);
  return unit;
}

fn requested(dumps: &Box<Slots<u64>>, number: u64) -> found: Bool reads(dumps) {
  doc "Whether the script has a P line for edit number.";
  let count = dumps^.inner.len;
  for (k in 0_u64..count) {
    if dumps^.inner[k] == number {
      return True();
    }
  }
  return False();
}

fn collect_requests(script: &[u8], dumps: &Box<Slots<u64>>) -> result: unit reads(script), writes(dumps) {
  doc "Lists the edit numbers of the P lines of the script.";
  let length = script^.len;
  let at = 0_u64;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    let listed = end <= length;
    let second = start +sat 1_u64;
    let long = second < end;
    let usable = band(listed, long);
    if usable {
      if script^[start] == 80_u8 {
        let (found, wanted, unused_next) = read_number(line: &script^[start..end], start: 2_u64);
        if found {
          put_u64(cell: dumps, value: wanted);
        }
      }
    }
  }
  return unit;
}

fn count_flags(changed: &Box<Array<Bool>>) -> count: u64 reads(changed) {
  doc "The number of true slots.";
  let total = changed^.inner.len;
  let count = 0_u64;
  for (k in 0_u64..total) {
    if changed^.inner[k] {
      set count = count +sat 1_u64;
    }
  }
  return count;
}

fn put_flags(buffer: &Box<Slots<u8>>, changed: &Box<Array<Bool>>, traversal: &Traversal) -> result: unit reads(changed), reads(traversal), writes(buffer) {
  doc "Appends, each after a space, the preorder index in traversal of every element whose slot, at its NodeId index, is true.";
  let total = traversal^.elements.inner.len;
  for (k in 0_u64..total) {
    let at = cvt::<u32, u64>(traversal^.elements.inner[k].index);
    if at < changed^.inner.len {
      if changed^.inner[at] {
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: k);
      }
    }
  }
  return unit;
}

fn run_delta(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment, script: &[u8], clock: &Clock, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(store), reads(traversal), reads(script), writes(document), writes(atoms), writes(clock), writes(out), writes(err), writes(files) waits {
  doc "Computes the styles of the document, then applies each edit line of the script (C and K add and remove a class token, N changes nothing), recomputes the styles after it, and reports `edit I changed COUNT time_us US`, I counting the edits from 1, COUNT the elements pkg::style::layout_changes flags between the styles before and after the edit and US the microseconds that call took; the new styles become the old ones. For an edit number a P line names, the line `flags I` and the flagged indices, then the line `dump I` and the style dump of the styles after the edit, follow (P 0 names the unedited document and prints the dump alone). Returns 0, or 2 after naming the failure on err.";
  let notes = box_slots_new::<u8>(capacity: 4096_u64);
  let dumps = box_slots_new::<u64>(capacity: 16_u64);
  collect_requests(script: script, dumps: &dumps);
  let class_atom = class_index(atoms: atoms);
  let old = match compute_styles(store: store, document: document, atoms: atoms, traversal: traversal, environment: environment) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  let base_requested = requested(dumps: &dumps, number: 0_u64);
  if base_requested {
    put_text(buffer: &notes, text: &dump_label[0_u64..dump_label.len]);
    put_decimal(buffer: &notes, value: 0_u64);
    put_byte(buffer: &notes, value: 10_u8);
    let flushed = flush(factory: files, output: out, buffer: &notes);
    let written = dump(styles: &old, document: document, atoms: atoms, traversal: traversal, out: out, files: files);
    if written {
    } else {
      return 2_u8;
    }
  }
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edits = 0_u64;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return 2_u8;
    }
    if start < end {
      let kind = script^[start];
      let skipped_s = kind == 83_u8;
      let skipped_p = kind == 80_u8;
      let skipped = bor(skipped_s, skipped_p);
      if skipped {
      } else {
        set edits = edits +sat 1_u64;
        let is_n = kind == 78_u8;
        if is_n {
        } else {
          let applied = apply_class_edit(document: document, class_atom: class_atom, line: &script^[start..end]);
          if applied {
          } else {
            put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
            let reported = flush(factory: files, output: err, buffer: &notes);
            return 2_u8;
          }
        }
        let new = match compute_styles(store: store, document: document, atoms: atoms, traversal: traversal, environment: environment) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let started = now(clock: clock);
        let changed = layout_changes(old: &old, new: &new);
        let finished = now(clock: clock);
        let elapsed = nanoseconds_from(earlier: started, later: finished);
        let micros = elapsed / 1000_u64;
        let flagged = count_flags(changed: &changed);
        put_text(buffer: &notes, text: &edit_label[0_u64..edit_label.len]);
        put_decimal(buffer: &notes, value: edits);
        put_text(buffer: &notes, text: &changed_label[0_u64..changed_label.len]);
        put_decimal(buffer: &notes, value: flagged);
        put_text(buffer: &notes, text: &time_label[0_u64..time_label.len]);
        put_decimal(buffer: &notes, value: micros);
        put_byte(buffer: &notes, value: 10_u8);
        let wanted = requested(dumps: &dumps, number: edits);
        if wanted {
          put_text(buffer: &notes, text: &flags_label[0_u64..flags_label.len]);
          put_decimal(buffer: &notes, value: edits);
          put_flags(buffer: &notes, changed: &changed, traversal: traversal);
          put_byte(buffer: &notes, value: 10_u8);
          put_text(buffer: &notes, text: &dump_label[0_u64..dump_label.len]);
          put_decimal(buffer: &notes, value: edits);
          put_byte(buffer: &notes, value: 10_u8);
        }
        let flushed = flush(factory: files, output: out, buffer: &notes);
        if wanted {
          let written = dump(styles: &new, document: document, atoms: atoms, traversal: traversal, out: out, files: files);
          if written {
          } else {
            return 2_u8;
          }
        }
        set old = move new;
      }
    }
  }
  return 0_u8;
}

fn apply_class_edit(document: &Document, class_atom: u32, line: &[u8]) -> ok: Bool reads(line), writes(document) {
  doc "Applies a C or K line, `C NODE TOKEN` or `K NODE TOKEN`, to the live document: adds the token to the class attribute of the element, or removes it.";
  let length = line^.len;
  if length < 5_u64 {
    return False();
  }
  let kind = line^[0_u64];
  let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
  if node_found {
  } else {
    return False();
  }
  let node = match node_id_of(value: node_value) {
    Some(value: found) => {
      give found;
    }
    None() => {
      return False();
    }
  }
  if after_node < length {
  } else {
    return False();
  }
  let add = kind == 67_u8;
  let done = edit_class(document: document, holder: node, class_atom: class_atom, token: &line^[after_node..length], add: add);
  return done;
}

fn put_u64(cell: &Box<Slots<u64>>, value: u64) -> result: unit writes(cell) {
  doc "Appends value, doubling the window when full.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity *sat 2_u64;
    let wanted = imax(doubled, 16_u64);
    let bounded = imin(wanted, 1073741824_u64);
    if bounded <= length {
      return unit;
    }
    grow(cell: cell, capacity: bounded);
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn run_restyle(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, script: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(store), reads(traversal), reads(script), writes(document), writes(atoms), writes(out), writes(err), writes(files) waits {
  doc "Checks pkg::style::class_restyle against a full rematch. For each C or K line of the script, in order: the restyle set class_restyle gives for the line's element and class token, then the edit, then the elements whose winning declarations differ between match_elements before and after it (pkg::style::rematched). Reports `restyle I set S rematched R missing M`, or `restyle I full rematched R` when the set is full, I counting the C and K lines from 1, S the set's size, R the elements rematched flags and M those of them outside the set, followed by ` first P`, the preorder index of the first, when M is not 0. S lines were added before; N lines change nothing; any other line is refused. Returns 0, or 2 after naming the failure on err.";
  let notes = box_slots_new::<u8>(capacity: 4096_u64);
  let class_atom = class_index(atoms: atoms);
  let old = match match_elements(store: store, document: document, atoms: atoms, traversal: traversal) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edits = 0_u64;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return 2_u8;
    }
    if start < end {
      let kind = script^[start];
      let is_s = kind == 83_u8;
      let is_p = kind == 80_u8;
      let is_n = kind == 78_u8;
      let is_c = kind == 67_u8;
      let is_k = kind == 75_u8;
      let passive = bor(is_s, is_p);
      let quiet = bor(passive, is_n);
      let class_edit = bor(is_c, is_k);
      let known = bor(quiet, class_edit);
      if known {
      } else {
        put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
        let reported = flush(factory: files, output: err, buffer: &notes);
        return 2_u8;
      }
      if class_edit {
        set edits = edits +sat 1_u64;
        let line = &script^[start..end];
        let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
        let size = line^.len;
        let token_ok = after_node < size;
        let parsed = band(node_found, token_ok);
        let node = match node_id_of(value: node_value) {
          Some(value: found) => {
            give found;
          }
          None() => {
            put_failure(notes: &notes, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
            let reported = flush(factory: files, output: err, buffer: &notes);
            return 2_u8;
          }
        }
        if parsed {
        } else {
          put_failure(notes: &notes, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &notes);
          return 2_u8;
        }
        let restyle = match class_restyle(store: store, document: document, atoms: atoms, traversal: traversal, node: node, class: &line^[after_node..size]) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let applied = apply_class_edit(document: document, class_atom: class_atom, line: line);
        if applied {
        } else {
          put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &notes);
          return 2_u8;
        }
        let new = match match_elements(store: store, document: document, atoms: atoms, traversal: traversal) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let changed = rematched(old: &old, new: &new);
        let count = changed.inner.len;
        let outside = False();
        let bounded = count <= 4294967296_u64;
        if bounded {
        } else {
          return 2_u8;
        }
        let in_set = box_array_filled::<Bool>(count: count, value: outside);
        let listed = restyle.elements.inner.len;
        for (k in 0_u64..listed) {
          let index = cvt::<u32, u64>(restyle.elements.inner[k]);
          if index < in_set.inner.len {
            set in_set.inner[index] = True();
          }
        }
        let flagged = 0_u64;
        let missing = 0_u64;
        let first_missing = 0_u64;
        for (i in 0_u64..count) {
          if changed.inner[i] {
            set flagged = flagged +sat 1_u64;
            let covered = bor(restyle.full, in_set.inner[i]);
            if covered {
            } else {
              if missing == 0_u64 {
                set first_missing = i;
              }
              set missing = missing +sat 1_u64;
            }
          }
        }
        put_text(buffer: &notes, text: &restyle_label[0_u64..restyle_label.len]);
        put_decimal(buffer: &notes, value: edits);
        if restyle.full {
          put_text(buffer: &notes, text: &full_label[0_u64..full_label.len]);
        } else {
          put_text(buffer: &notes, text: &set_label[0_u64..set_label.len]);
          put_decimal(buffer: &notes, value: listed);
        }
        put_text(buffer: &notes, text: &rematched_label[0_u64..rematched_label.len]);
        put_decimal(buffer: &notes, value: flagged);
        put_text(buffer: &notes, text: &missing_label[0_u64..missing_label.len]);
        put_decimal(buffer: &notes, value: missing);
        if missing > 0_u64 {
          put_text(buffer: &notes, text: &first_label[0_u64..first_label.len]);
          put_decimal(buffer: &notes, value: first_missing);
        }
        put_byte(buffer: &notes, value: 10_u8);
        let flushed = flush(factory: files, output: out, buffer: &notes);
        set old = move new;
      }
    }
  }
  return 0_u8;
}

fn style_line(styles: &Styles, atoms: &AtomTable, document: &Document, node: NodeId, style: ComputedStyle) -> line: Box<Slots<u8>> reads(styles), reads(atoms), reads(document) {
  doc "The values the dump writes for one element or pseudo-element with style, without its index and name.";
  let buffer = box_slots_new::<u8>(capacity: 512_u64);
  put_element(buffer: &buffer, styles: styles, atoms: atoms, style: style);
  put_second(buffer: &buffer, styles: styles, atoms: atoms, document: document, element: node, style: style);
  return move buffer;
}

fn same_line(first: &Box<Slots<u8>>, second: &Box<Slots<u8>>) -> same: Bool reads(first), reads(second) {
  doc "Whether two buffers hold the same bytes.";
  let length = first^.inner.len;
  if length != second^.inner.len {
    return False();
  }
  for (k in 0_u64..length) {
    if k < second^.inner.len {
      if first^.inner[k] != second^.inner[k] {
        return False();
      }
    }
  }
  return True();
}

fn differing(first: &Styles, second: &Styles, document: &Document, atoms: &AtomTable, traversal: &Traversal) -> (count: u64, at: u64) reads(first), reads(second), reads(document), reads(atoms), reads(traversal) {
  doc "The number of elements and pseudo-elements whose dump values differ between two results for the same document, compared as the dump writes them (each line rendered from its own tables, so identifiers need not agree), and the index of the first: an element's preorder index, or the element count plus a pseudo-element's number. Pseudo-element lists of different lengths count as one difference at the shorter length.";
  let count = traversal^.elements.inner.len;
  let differ = 0_u64;
  let first_at = 0_u64;
  for (k in 0_u64..count) {
    let in_first = k < first^.elements.inner.len;
    let in_second = k < second^.elements.inner.len;
    if in_first {
      if in_second {
        let node = traversal^.elements.inner[k];
        let a = style_line(styles: first, atoms: atoms, document: document, node: node, style: first^.elements.inner[k]);
        let b = style_line(styles: second, atoms: atoms, document: document, node: node, style: second^.elements.inner[k]);
        let same = same_line(first: &a, second: &b);
        if same {
        } else {
          if differ == 0_u64 {
            set first_at = k;
          }
          set differ = differ +sat 1_u64;
        }
      }
    }
  }
  let a_pseudos = first^.pseudos.inner.len;
  let b_pseudos = second^.pseudos.inner.len;
  let shorter = imin(a_pseudos, b_pseudos);
  for (p in 0_u64..shorter) {
    if p < second^.pseudos.inner.len {
      let a_entry = first^.pseudos.inner[p];
      let b_entry = second^.pseudos.inner[p];
      let origin = cvt::<u32, u64>(a_entry.element);
      let same_origin = a_entry.element == b_entry.element;
      let same_kind = a_entry.kind == b_entry.kind;
      let same_place = band(same_origin, same_kind);
      let lines_same = if origin < count {
        let node = traversal^.elements.inner[origin];
        let a = style_line(styles: first, atoms: atoms, document: document, node: node, style: a_entry.style);
        let b = style_line(styles: second, atoms: atoms, document: document, node: node, style: b_entry.style);
        give same_line(first: &a, second: &b);
      } else {
        give False();
      }
      let same = band(same_place, lines_same);
      if same {
      } else {
        if differ == 0_u64 {
          set first_at = count +sat p;
        }
        set differ = differ +sat 1_u64;
      }
    }
  }
  if a_pseudos != b_pseudos {
    if differ == 0_u64 {
      set first_at = count +sat shorter;
    }
    set differ = differ +sat 1_u64;
  }
  return differ, first_at;
}

fn run_incremental(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment, script: &[u8], check: Bool, clock: &Clock, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(store), reads(traversal), reads(script), writes(document), writes(atoms), writes(clock), writes(out), writes(err), writes(files) waits {
  doc "Checks pkg::style::restyle against a full style run. Keeps a StyleState of the document; for each C or K line, in order: the restyle set class_restyle gives, then the edit, then restyle, then compute_styles of the edited document, compared with the kept styles value by value (differing). Reports `restyle I set S visited V changed C differ D`, with ` rebuilt` when restyle rebuilt every node and ` full` in place of the set for a full set, and ` first P` when D is not 0, then ` set_us A restyle_us B`, the microseconds class_restyle and restyle took, each read after the work it ends (stamps). Without check (mode restyletime) the full run and the comparison are skipped and D is 0, so that a profile of many edits holds the restyle alone. S lines were added before; N lines change nothing; any other line is refused. Returns 0, or 2 after naming the failure on err.";
  let notes = box_slots_new::<u8>(capacity: 4096_u64);
  let class_atom = class_index(atoms: atoms);
  let state = match style_state(store: store, document: document, atoms: atoms, traversal: traversal, environment: environment) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, failure: failure);
      return 2_u8;
    }
  }
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edits = 0_u64;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return 2_u8;
    }
    if start < end {
      let kind = script^[start];
      let is_s = kind == 83_u8;
      let is_p = kind == 80_u8;
      let is_n = kind == 78_u8;
      let is_c = kind == 67_u8;
      let is_k = kind == 75_u8;
      let passive = bor(is_s, is_p);
      let quiet = bor(passive, is_n);
      let class_edit = bor(is_c, is_k);
      let known = bor(quiet, class_edit);
      if known {
      } else {
        put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
        let reported = flush(factory: files, output: err, buffer: &notes);
        return 2_u8;
      }
      if class_edit {
        set edits = edits +sat 1_u64;
        let line = &script^[start..end];
        let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
        let size = line^.len;
        let token_ok = after_node < size;
        let parsed = band(node_found, token_ok);
        let node = match node_id_of(value: node_value) {
          Some(value: found) => {
            give found;
          }
          None() => {
            put_failure(notes: &notes, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
            let reported = flush(factory: files, output: err, buffer: &notes);
            return 2_u8;
          }
        }
        if parsed {
        } else {
          put_failure(notes: &notes, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &notes);
          return 2_u8;
        }
        let applied = apply_class_edit(document: document, class_atom: class_atom, line: line);
        if applied {
        } else {
          put_failure(notes: &notes, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &notes);
          return 2_u8;
        }
        let set_started = now(clock: clock);
        let wanted = match set_after(started: set_started, store: store, document: document, atoms: atoms, traversal: traversal, node: node, class: &line^[after_node..size]) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let set_finished = stamp_set(clock: clock, witness: &wanted);
        let done = match restyle_after(started: set_finished, state: &state, store: store, document: document, atoms: atoms, traversal: traversal, environment: environment, wanted: &wanted) {
          Ok(value: found) => {
            give move found;
          }
          Err(error: failure) => {
            report_style(err: err, files: files, failure: failure);
            return 2_u8;
          }
        }
        let restyle_finished = stamp_state(clock: clock, witness: &state);
        let set_ns = nanoseconds_from(earlier: set_started, later: set_finished);
        let restyle_ns = nanoseconds_from(earlier: set_finished, later: restyle_finished);
        let differ = 0_u64;
        let first_at = 0_u64;
        if check {
          let fresh = match compute_styles(store: store, document: document, atoms: atoms, traversal: traversal, environment: environment) {
            Ok(value: found) => {
              give move found;
            }
            Err(error: failure) => {
              report_style(err: err, files: files, failure: failure);
              return 2_u8;
            }
          }
          let (differ_count, differ_at) = differing(first: &state.styles, second: &fresh, document: document, atoms: atoms, traversal: traversal);
          set differ = differ_count;
          set first_at = differ_at;
        }
        put_text(buffer: &notes, text: &restyle_label[0_u64..restyle_label.len]);
        put_decimal(buffer: &notes, value: edits);
        if wanted.full {
          put_text(buffer: &notes, text: &full_label[0_u64..full_label.len]);
        } else {
          put_text(buffer: &notes, text: &set_label[0_u64..set_label.len]);
          put_decimal(buffer: &notes, value: wanted.elements.inner.len);
        }
        put_text(buffer: &notes, text: &visited_label[0_u64..visited_label.len]);
        put_decimal(buffer: &notes, value: done.visited);
        put_text(buffer: &notes, text: &changed_label[0_u64..changed_label.len]);
        put_decimal(buffer: &notes, value: done.changed.inner.len);
        put_text(buffer: &notes, text: &differ_label[0_u64..differ_label.len]);
        put_decimal(buffer: &notes, value: differ);
        if differ > 0_u64 {
          put_text(buffer: &notes, text: &first_label[0_u64..first_label.len]);
          put_decimal(buffer: &notes, value: first_at);
        }
        if done.full {
          put_text(buffer: &notes, text: &rebuilt_label[0_u64..rebuilt_label.len]);
        }
        let set_us = set_ns / 1000_u64;
        let restyle_us = restyle_ns / 1000_u64;
        put_text(buffer: &notes, text: &set_us_label[0_u64..set_us_label.len]);
        put_decimal(buffer: &notes, value: set_us);
        put_text(buffer: &notes, text: &restyle_us_label[0_u64..restyle_us_label.len]);
        put_decimal(buffer: &notes, value: restyle_us);
        put_byte(buffer: &notes, value: 10_u8);
        let flushed = flush(factory: files, output: out, buffer: &notes);
      }
    }
  }
  return 0_u8;
}

fn set_after(started: Instant, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, node: NodeId, class: &[u8]) -> result: Result<RestyleSet, StyleError> reads(store), reads(document), reads(atoms), reads(traversal), reads(class) {
  doc "class_restyle, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken.";
  let made = class_restyle(store: store, document: document, atoms: atoms, traversal: traversal, node: node, class: class);
  return move made;
}

fn restyle_after(started: Instant, state: &StyleState, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, environment: Environment, wanted: &RestyleSet) -> result: Result<Restyled, StyleError> reads(store), reads(document), reads(traversal), reads(wanted), writes(state), writes(atoms) {
  doc "restyle, called with the reading that starts its interval as an argument.";
  let made = restyle_state(state: state, store: store, document: document, atoms: atoms, traversal: traversal, environment: environment, wanted: wanted);
  return move made;
}

fn stamp_set(clock: &Clock, witness: &RestyleSet) -> result: Instant reads(witness), writes(clock) {
  doc "Reads the clock after every earlier statement that writes witness.";
  let held = witness^.elements.inner.len;
  let made = now(clock: clock);
  return made;
}

fn stamp_state(clock: &Clock, witness: &StyleState) -> result: Instant reads(witness), writes(clock) {
  doc "Reads the clock after every earlier statement that writes witness.";
  let held = witness^.styles.elements.inner.len;
  let made = now(clock: clock);
  return made;
}
