alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;

public fn read_argument_file(factory: &HandleFactory, cwd: &DirectoryRead, args: &Args, position: u64) -> result: Result<Box<Slots<u8>>, IoError> reads(cwd), reads(args), writes(factory) doc "Reads the whole file that the invocation argument at position names, relative to cwd, into one window whose len is the file's size. A missing argument or one that names no relative path is InvalidInput, and a file past 2^30 bytes is FileTooLarge.";

public fn read_directory_file(factory: &HandleFactory, directory: &DirectoryRead, name: &[u8]) -> result: Result<Box<Slots<u8>>, IoError> reads(directory), reads(name), writes(factory) doc "Reads the whole file that the bytes of name, one path component, name below directory into one window whose len is the file's size. A file past 2^30 bytes is FileTooLarge.";

public fn open_directory_path(factory: &HandleFactory, root: &DirectoryRead, name: &[u8]) -> result: Result<DirectoryRead, IoError> reads(root), reads(name), writes(factory) doc "Opens the directory that the relative path in the bytes of name names below root, one component at a time, closing every intermediate directory. Empty components are skipped; a path with no component is InvalidPath.";

public fn argument_bytes(args: &Args, position: u64) -> result: Option<Box<Slots<u8>>> reads(args) doc "Copies the bytes of the invocation argument at position into a window whose len is the argument's length, or returns None when there is no such argument or it is longer than 65536 bytes.";

public fn put_argument(buffer: &Box<Slots<u8>>, args: &Args, position: u64) -> result: unit reads(args), writes(buffer) doc "Appends the bytes of the invocation argument at position to buffer; appends nothing when there is no such argument or it is longer than 65536 bytes.";

public fn io_error_code(error: IoError) -> result: u32 pure doc "Returns the host's error code that error carries, such as an errno value, or 0 for an error the support module made itself.";

public fn put_host_error(buffer: &Box<Slots<u8>>, error: IoError) -> result: unit writes(buffer) doc "Appends ` (host error N)` to buffer when error carries a nonzero host code N, and nothing otherwise.";

public fn line_end(text: &[u8], start: u64) -> result: u64 reads(text) doc "Returns the index of the first line feed at or after start in text, or the length of text when there is none. A start past the end returns the length of text.";

public fn parse_decimal(text: &[u8], start: u64, end: u64) -> result: Option<u64> reads(text) doc "Parses text from start to end as an unsigned decimal number of 1 to 18 ASCII digits; returns None for any other bytes, including an empty range and a range outside text.";

public fn put_byte(buffer: &Box<Slots<u8>>, value: u8) -> result: unit writes(buffer) doc "Appends one byte to buffer, doubling its capacity when it is full. The capacity stops growing at 2^32 bytes, and a byte past that is dropped, so callers flush buffer at least once per output line.";

public fn put_text(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) doc "Appends every byte of text to buffer.";

public fn put_decimal(buffer: &Box<Slots<u8>>, value: u64) -> result: unit writes(buffer) doc "Appends the decimal spelling of value to buffer, without leading zeros.";

public fn put_hex(buffer: &Box<Slots<u8>>, value: u64, width: u64, uppercase: Bool) -> result: unit writes(buffer) doc "Appends the hexadecimal spelling of value to buffer with at least width digits, padded with leading zeros, and at most 16; the digits above 9 are uppercase or lowercase letters as uppercase says.";

public fn put_summary(buffer: &Box<Slots<u8>>, name: &[u8], cases: u64, passed: u64, failed: u64) -> result: unit reads(name), writes(buffer) doc "Appends the summary line `NAME: C cases, P passed, F failed` and a line feed to buffer.";

public fn truncate(buffer: &Box<Slots<u8>>, length: u64) -> result: unit writes(buffer) doc "Removes the bytes of buffer past length; a buffer no longer than length is unchanged.";

public fn flush(factory: &HandleFactory, output: &OutputStream, buffer: &Box<Slots<u8>>) -> result: Bool writes(factory), writes(output), writes(buffer) doc "Writes every byte of buffer to output and empties buffer. Returns False when output refuses a write; buffer is emptied either way.";
