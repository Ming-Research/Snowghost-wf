alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The text_properties_oracle entry, invoked as `text_properties_oracle PAIRS` with PAIRS naming, relative to the working directory, a file of lines `FIRST SECOND`, each two values of 1 to 8 lowercase hexadecimal digits separated by one space and ending with a line feed. It prints, for every code point from 0 to 10FFFF in ascending order, one line `CODE GC CCC EP DECOMPOSITION`: CODE in lowercase hexadecimal without leading zeros; GC the two-letter abbreviation of pkg::text::properties::general_category (Lu, Ll, Lt, Lm, Lo, Mn, Mc, Me, Nd, Nl, No, Pc, Pd, Ps, Pe, Pi, Pf, Po, Sm, Sc, Sk, So, Zs, Zl, Zp, Cc, Cf, Cs, Co or Cn); CCC pkg::text::normalization::canonical_combining_class in decimal; EP 1 when is_extended_pictographic holds and 0 otherwise; and DECOMPOSITION `-` when canonical_decomposition returns None, otherwise FIRST,SECOND in lowercase hexadecimal. Then, for each line of PAIRS in order, it prints `C FIRST SECOND RESULT`, the pair as read and RESULT canonical_composition's value in lowercase hexadecimal or `-` for None. It exits with 0 after printing, and with 2, with a message on standard error, when the invocation does not have exactly one argument, PAIRS cannot be read or holds a line of any other shape, or standard output refuses a write.";
