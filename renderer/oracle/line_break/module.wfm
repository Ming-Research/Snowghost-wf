alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The line_break_oracle entry, invoked as `line_break_oracle PATH` with PATH naming LineBreakTest.txt relative to the working directory. It runs find_line_breaks on every test line of the file and compares each position with the file's marker: Prohibited must stand where the file has no break, Allowed or Mandatory where it has one. It also checks each Mandatory placement against the hard-break rule, and that the result does not depend on the prior content of opportunities. It prints up to 10 failing cases and then the summary line `line_break: C cases, P passed, F failed`, and exits with 0 exactly when the file holds at least one case and every case passes, 1 when a case fails, and 2 when the file cannot be read.";
