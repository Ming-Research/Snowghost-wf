alias Args = std::text::Args;
alias BreakOpportunity = pkg::text::line_break::BreakOpportunity;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias find_line_breaks = pkg::text::line_break::find_line_breaks;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_hex = pkg::oracle::support::put_hex;
alias put_summary = pkg::oracle::support::put_summary;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;

const summary_name: Array<u8, 10> =[108_u8, 105_u8, 110_u8, 101_u8, 95_u8, 98_u8, 114_u8, 101_u8, 97_u8, 107_u8];

const line_word: Array<u8, 5> =[108_u8, 105_u8, 110_u8, 101_u8, 32_u8];

const expected_word: Array<u8, 11> =[58_u8, 32_u8, 101_u8, 120_u8, 112_u8, 101_u8, 99_u8, 116_u8, 101_u8, 100_u8, 32_u8];

const actual_word: Array<u8, 8> =[32_u8, 97_u8, 99_u8, 116_u8, 117_u8, 97_u8, 108_u8, 32_u8];

const for_word: Array<u8, 5> =[32_u8, 102_u8, 111_u8, 114_u8, 32_u8];

const parse_failure: Array<u8, 29> =[58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 112_u8, 97_u8, 114_u8, 115_u8, 101_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 116_u8, 101_u8, 115_u8, 116_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 10_u8];

const unstable_prefix: Array<u8, 30> =[58_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 111_u8, 112_u8, 112_u8, 111_u8, 114_u8, 116_u8, 117_u8, 110_u8, 105_u8, 116_u8, 121_u8, 32_u8, 97_u8, 116_u8, 32_u8, 112_u8, 111_u8, 115_u8, 105_u8, 116_u8, 105_u8, 111_u8, 110_u8, 32_u8];

const unstable_suffix: Array<u8, 47> =[32_u8, 100_u8, 101_u8, 112_u8, 101_u8, 110_u8, 100_u8, 115_u8, 32_u8, 111_u8, 110_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 112_u8, 114_u8, 105_u8, 111_u8, 114_u8, 32_u8, 99_u8, 111_u8, 110_u8, 116_u8, 101_u8, 110_u8, 116_u8, 32_u8, 111_u8, 102_u8, 32_u8, 111_u8, 112_u8, 112_u8, 111_u8, 114_u8, 116_u8, 117_u8, 110_u8, 105_u8, 116_u8, 105_u8, 101_u8, 115_u8, 10_u8];

const usage_text: Array<u8, 30> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 95_u8, 98_u8, 114_u8, 101_u8, 97_u8, 107_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 31> =[108_u8, 105_u8, 110_u8, 101_u8, 95_u8, 98_u8, 114_u8, 101_u8, 97_u8, 107_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const no_cases_text: Array<u8, 52> =[108_u8, 105_u8, 110_u8, 101_u8, 95_u8, 98_u8, 114_u8, 101_u8, 97_u8, 107_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 116_u8, 101_u8, 115_u8, 116_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 104_u8, 111_u8, 108_u8, 100_u8, 115_u8, 32_u8, 110_u8, 111_u8, 32_u8, 116_u8, 101_u8, 115_u8, 116_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 10_u8];

const shown_failure_limit: u64 = 10_u64;

const line_ceiling: u64 = 65536_u64;

const number_sign: u8 = 35_u8;

const space: u8 = 32_u8;

const tab: u8 = 9_u8;

const sign_lead: u8 = 195_u8;

const multiplication_sign_trail: u8 = 151_u8;

const division_sign_trail: u8 = 183_u8;

const digit_zero: u8 = 48_u8;

const digit_nine: u8 = 57_u8;

const upper_a: u8 = 65_u8;

const upper_f: u8 = 70_u8;

const lower_a: u8 = 97_u8;

const lower_f: u8 = 102_u8;

const no_hex_digit: u8 = 16_u8;

const no_break_marker: u8 = 0_u8;

const break_marker: u8 = 1_u8;

const no_marker: u8 = 2_u8;

const prohibited_glyph: u8 = 120_u8;

const allowed_glyph: u8 = 47_u8;

const mandatory_glyph: u8 = 33_u8;

const line_feed: u8 = 10_u8;

struct Tally {
  cases: u64;
  passed: u64;
  failed: u64;
}

fn run(inputs: Inputs) -> status: ExitStatus pure {
  doc "Destructures the inputs, judges the file and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Reads the file named by the one argument, judges its test lines, prints the summary and returns the exit code.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let tally = judge_lines(text: text, out: out, files: files, report: &report);
      let name = &summary_name[0_u64..summary_name.len];
      put_summary(buffer: &report, name: name, cases: tally.cases, passed: tally.passed, failed: tally.failed);
      let written = flush(factory: files, output: out, buffer: &report);
      let empty = tally.cases == 0_u64;
      if empty {
        let message = &no_cases_text[0_u64..no_cases_text.len];
        put_text(buffer: &report, text: message);
        let noted = flush(factory: files, output: err, buffer: &report);
        return 1_u8;
      }
      let clean = tally.failed == 0_u64;
      if clean {
        return 0_u8;
      }
      return 1_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn judge_lines(text: &[u8], out: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> tally: Tally reads(text), writes(out), writes(files), writes(report) {
  doc "Walks the file line by line, skipping empty lines and lines that start with a number sign, and judges every other line as one case. Line numbers count from 1. The first shown_failure_limit failing cases are reported and flushed as they are found.";
  let length = text^.len;
  let start = 0_u64;
  let line_number = 0_u64;
  let cases = 0_u64;
  let passed = 0_u64;
  let failed = 0_u64;
  loop @lines {
    let more = start < length;
    if more {
    } else {
      break @lines;
    }
    let end = line_end(text: text, start: start);
    set line_number = line_number +wrap 1_u64;
    let first = text^[start];
    let blank = first == line_feed;
    let comment = first == number_sign;
    let skipped = bor(blank, comment);
    if skipped {
    } else {
      set cases = cases +wrap 1_u64;
      let shown = failed < shown_failure_limit;
      let stop = comment_start(text: text, start: start, end: end);
      let passing = judge_case(text: text, start: start, stop: stop, line_number: line_number, shown: shown, report: report);
      if passing {
        set passed = passed +wrap 1_u64;
      } else {
        set failed = failed +wrap 1_u64;
        let written = flush(factory: files, output: out, buffer: report);
      }
    }
    set start = end +wrap 1_u64;
  }
  return Tally(cases: cases, passed: passed, failed: failed);
}

fn comment_start(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first number sign from start to end, where the line's comment begins, or end.";
  let length = text^.len;
  let within = end <= length;
  if within {
  } else {
    return end;
  }
  let ordered = start <= end;
  if ordered {
  } else {
    return end;
  }
  for (at in start..end) {
    let byte = text^[at];
    let found = byte == number_sign;
    if found {
      return at;
    }
  }
  return end;
}

fn is_blank(byte: u8) -> result: Bool pure {
  doc "Tells whether byte separates two fields of a test line: a space or a tab.";
  let spaced = byte == space;
  let tabbed = byte == tab;
  let blank = bor(spaced, tabbed);
  return blank;
}

fn skip_blanks(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first byte from from to stop that is not blank, or stop.";
  let length = text^.len;
  let at = from;
  loop @skip {
    let before_stop = at < stop;
    let inside = at < length;
    let readable = band(before_stop, inside);
    if readable {
    } else {
      return stop;
    }
    let byte = text^[at];
    let blank = is_blank(byte: byte);
    if blank {
    } else {
      return at;
    }
    set at = at +wrap 1_u64;
  }
  return stop;
}

fn field_end(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first blank byte from from to stop, or stop: the end of the field that starts at from.";
  let length = text^.len;
  let at = from;
  loop @scan {
    let before_stop = at < stop;
    let inside = at < length;
    let readable = band(before_stop, inside);
    if readable {
    } else {
      return stop;
    }
    let byte = text^[at];
    let blank = is_blank(byte: byte);
    if blank {
      return at;
    }
    set at = at +wrap 1_u64;
  }
  return stop;
}

fn marker_value(text: &[u8], from: u64, end: u64) -> result: u8 reads(text) {
  doc "Classifies the field from from to end: no_break_marker for the UTF-8 bytes of U+00D7 MULTIPLICATION SIGN, break_marker for those of U+00F7 DIVISION SIGN, and no_marker for anything else.";
  let length = text^.len;
  let size = end -wrap from;
  let pair = size == 2_u64;
  let within = end <= length;
  let ordered = from < end;
  let sized = band(pair, ordered);
  let usable = band(sized, within);
  if usable {
  } else {
    return no_marker;
  }
  let second_at = from +wrap 1_u64;
  let second_inside = second_at < length;
  if second_inside {
  } else {
    return no_marker;
  }
  let lead = text^[from];
  let trail = text^[second_at];
  let led = lead == sign_lead;
  if led {
  } else {
    return no_marker;
  }
  let no_break = trail == multiplication_sign_trail;
  if no_break {
    return no_break_marker;
  }
  let breaking = trail == division_sign_trail;
  if breaking {
    return break_marker;
  }
  return no_marker;
}

fn hex_digit(byte: u8) -> result: u8 pure {
  doc "Returns the value of one ASCII hexadecimal digit, of either case, or no_hex_digit for any other byte.";
  let decimal_low = byte >= digit_zero;
  let decimal_high = byte <= digit_nine;
  let decimal = band(decimal_low, decimal_high);
  if decimal {
    return byte -wrap digit_zero;
  }
  let upper_low = byte >= upper_a;
  let upper_high = byte <= upper_f;
  let upper = band(upper_low, upper_high);
  if upper {
    let offset = byte -wrap upper_a;
    return offset +wrap 10_u8;
  }
  let lower_low = byte >= lower_a;
  let lower_high = byte <= lower_f;
  let lower = band(lower_low, lower_high);
  if lower {
    let offset = byte -wrap lower_a;
    return offset +wrap 10_u8;
  }
  return no_hex_digit;
}

fn code_point_value(text: &[u8], from: u64, end: u64) -> result: Option<u32> reads(text) {
  doc "Parses the field from from to end as a code point of 1 to 6 hexadecimal digits; returns None for any other field.";
  let length = text^.len;
  let size = end -wrap from;
  let ordered = from < end;
  let within = end <= length;
  let short = size <= 6_u64;
  let located = band(ordered, within);
  let usable = band(located, short);
  if usable {
  } else {
    return None<u32>();
  }
  let value = 0_u32;
  for (at in from..end) {
    let byte = text^[at];
    let digit = hex_digit(byte: byte);
    let valid = digit < no_hex_digit;
    if valid {
    } else {
      return None<u32>();
    }
    let widened = cvt::<u8, u32>(digit);
    let shifted = ishl.wrap(value, 4_u32);
    set value = ior(shifted, widened);
  }
  return Some<u32>(value: value);
}

fn parse_case(text: &[u8], start: u64, stop: u64, code_points: &Box<Slots<u32>>, markers: &Box<Slots<u8>>) -> parsed: Bool reads(text), writes(code_points), writes(markers) {
  doc "Parses the fields of one test line from start to stop, which alternate between a marker and a code point and begin and end with a marker. The first marker stands at the start of the text and is not recorded; the marker after the i-th code point is recorded as markers[i]. Returns False when the fields have any other shape.";
  let at = start;
  let expect_marker = True();
  let seen_first = False();
  loop @fields {
    set at = skip_blanks(text: text, from: at, stop: stop);
    let more = at < stop;
    if more {
    } else {
      break @fields;
    }
    let end = field_end(text: text, from: at, stop: stop);
    if expect_marker {
      let marker = marker_value(text: text, from: at, end: end);
      let known = marker < no_marker;
      if known {
      } else {
        return False();
      }
      if seen_first {
        let room = markers^.inner.len < markers^.inner.cap;
        if room {
          place_back(window: &markers^.inner, value: marker);
        } else {
          return False();
        }
      } else {
        set seen_first = True();
      }
      set expect_marker = False();
    } else {
      match code_point_value(text: text, from: at, end: end) {
        Some(value: code_point) => {
          let room = code_points^.inner.len < code_points^.inner.cap;
          if room {
            place_back(window: &code_points^.inner, value: code_point);
          } else {
            return False();
          }
        }
        None() => {
          return False();
        }
      }
      set expect_marker = True();
    }
    set at = end;
  }
  let count = code_points^.inner.len;
  let nonempty = count > 0_u64;
  let paired = markers^.inner.len == count;
  let ended_on_marker = bnot(expect_marker);
  let shaped = band(nonempty, paired);
  let complete = band(shaped, ended_on_marker);
  return complete;
}

fn mandatory_expected(text: &[u32], index: u64) -> result: Bool reads(text) {
  doc "Tells whether the opportunity after text[index] must be Mandatory: at the end of the text (LB3), after U+000A, U+000B, U+000C, U+0085, U+2028 or U+2029 (LB4, LB5), and after U+000D that U+000A does not follow (LB5).";
  let count = text^.len;
  let inside = index < count;
  if inside {
  } else {
    return False();
  }
  let following = index +wrap 1_u64;
  let last = following == count;
  if last {
    return True();
  }
  let value = text^[index];
  let line_feed_point = value == 10_u32;
  let line_tabulation = value == 11_u32;
  let form_feed = value == 12_u32;
  let next_line = value == 133_u32;
  let line_separator = value == 8232_u32;
  let paragraph_separator = value == 8233_u32;
  let first_pair = bor(line_feed_point, line_tabulation);
  let second_pair = bor(form_feed, next_line);
  let third_pair = bor(line_separator, paragraph_separator);
  let first_four = bor(first_pair, second_pair);
  let hard = bor(first_four, third_pair);
  if hard {
    return True();
  }
  let carriage_return = value == 13_u32;
  if carriage_return {
    let following_inside = following < count;
    if following_inside {
      let next = text^[following];
      let crlf = next == 10_u32;
      if crlf {
        return False();
      }
    }
    return True();
  }
  return False();
}

fn breaks_with_fill(text: &[u32], fill: BreakOpportunity) -> result: Box<Slots<BreakOpportunity>> reads(text) {
  doc "Fills a fresh window of one opportunity per code point with fill and lets find_line_breaks write it.";
  let count = text^.len;
  let bounded = count <= line_ceiling;
  if bounded {
  } else {
    let empty = box_slots_new::<BreakOpportunity>(capacity: 0_u64);
    return move empty;
  }
  let built = box_slots_new::<BreakOpportunity>(capacity: count);
  for @fill (
    at in 0_u64..count,
    invariant grown: built.inner.len == at
  ) {
    place_back(window: &built.inner, value: fill);
  }
  let opportunities = &built.inner[0_u64..count];
  find_line_breaks(text: text, opportunities: opportunities);
  return move built;
}

fn opportunity_glyph(opportunity: BreakOpportunity) -> result: u8 pure {
  doc "Spells one opportunity in a marker string: x for Prohibited, / for Allowed and ! for Mandatory.";
  match opportunity {
    Prohibited() => {
      return prohibited_glyph;
    }
    Allowed() => {
      return allowed_glyph;
    }
    Mandatory() => {
      return mandatory_glyph;
    }
  }
}

fn expected_glyph(marker: u8, mandatory: Bool) -> result: u8 pure {
  doc "Spells the expected opportunity in a marker string: x where the file has no break, ! where it has a break the hard-break rule makes Mandatory, and / for every other break.";
  let no_break = marker == no_break_marker;
  if no_break {
    return prohibited_glyph;
  }
  if mandatory {
    return mandatory_glyph;
  }
  return allowed_glyph;
}

fn position_passes(actual: BreakOpportunity, marker: u8, mandatory: Bool) -> result: Bool pure {
  doc "Compares one opportunity with its expectation: Prohibited exactly where the file has no break, and Mandatory exactly where the hard-break rule requires it.";
  let prohibited = BreakOpportunity::Prohibited();
  let is_mandatory_value = BreakOpportunity::Mandatory();
  let actual_prohibited = eeq(actual, prohibited);
  let actual_mandatory = eeq(actual, is_mandatory_value);
  let expected_no_break = marker == no_break_marker;
  let break_agrees = eeq(actual_prohibited, expected_no_break);
  let mandatory_agrees = eeq(actual_mandatory, mandatory);
  let agrees = band(break_agrees, mandatory_agrees);
  return agrees;
}

fn put_line_prefix(report: &Box<Slots<u8>>, line_number: u64) -> result: unit writes(report) {
  doc "Writes `line N` to the report.";
  let word = &line_word[0_u64..line_word.len];
  put_text(buffer: report, text: word);
  put_decimal(buffer: report, value: line_number);
  return unit;
}

fn put_mismatch(report: &Box<Slots<u8>>, line_number: u64, text: &[u32], markers: &[u8], actual: &[BreakOpportunity]) -> result: unit reads(text), reads(markers), reads(actual), writes(report) {
  doc "Writes `line N: expected E actual A for C` and a line feed, where E and A are marker strings with one glyph per code point and C lists the code points in hexadecimal.";
  put_line_prefix(report: report, line_number: line_number);
  let expected_label = &expected_word[0_u64..expected_word.len];
  put_text(buffer: report, text: expected_label);
  let count = text^.len;
  for (index in 0_u64..count) {
    let marker_inside = index < markers^.len;
    if marker_inside {
      let marker = markers^[index];
      let mandatory = mandatory_expected(text: text, index: index);
      let glyph = expected_glyph(marker: marker, mandatory: mandatory);
      put_byte(buffer: report, value: glyph);
    }
  }
  let actual_label = &actual_word[0_u64..actual_word.len];
  put_text(buffer: report, text: actual_label);
  for (index in 0_u64..count) {
    let actual_inside = index < actual^.len;
    if actual_inside {
      let opportunity = actual^[index];
      let glyph = opportunity_glyph(opportunity: opportunity);
      put_byte(buffer: report, value: glyph);
    }
  }
  let for_label = &for_word[0_u64..for_word.len];
  put_text(buffer: report, text: for_label);
  for (index in 0_u64..count) {
    let separated = index > 0_u64;
    if separated {
      put_byte(buffer: report, value: space);
    }
    let code_point = text^[index];
    let widened = cvt::<u32, u64>(code_point);
    let uppercase = True();
    put_hex(buffer: report, value: widened, width: 4_u64, uppercase: uppercase);
  }
  put_byte(buffer: report, value: line_feed);
  return unit;
}

fn judge_case(text: &[u8], start: u64, stop: u64, line_number: u64, shown: Bool, report: &Box<Slots<u8>>) -> passed: Bool reads(text), writes(report) {
  doc "Parses one test line, runs find_line_breaks twice, once over a window filled with Prohibited and once over one filled with Mandatory, and compares every position of the first result with the file and with the second result. Writes a report of a failing case when shown is True.";
  let span = stop -wrap start;
  let ordered = start <= stop;
  let bounded = span <= line_ceiling;
  let usable = band(ordered, bounded);
  let code_points = box_slots_new::<u32>(capacity: 0_u64);
  let markers = box_slots_new::<u8>(capacity: 0_u64);
  let parsed = False();
  if usable {
    set code_points = box_slots_new::<u32>(capacity: span);
    set markers = box_slots_new::<u8>(capacity: span);
    set parsed = parse_case(text: text, start: start, stop: stop, code_points: &code_points, markers: &markers);
  }
  if parsed {
  } else {
    if shown {
      put_line_prefix(report: report, line_number: line_number);
      let message = &parse_failure[0_u64..parse_failure.len];
      put_text(buffer: report, text: message);
    }
    return False();
  }
  let count = code_points.inner.len;
  let points = &code_points.inner[0_u64..count];
  let marker_count = markers.inner.len;
  let expected = &markers.inner[0_u64..marker_count];
  let prohibited = BreakOpportunity::Prohibited();
  let mandatory = BreakOpportunity::Mandatory();
  let first = breaks_with_fill(text: points, fill: prohibited);
  let second = breaks_with_fill(text: points, fill: mandatory);
  let first_count = first.inner.len;
  let actual = &first.inner[0_u64..first_count];
  let passing = True();
  for (index in 0_u64..count) {
    let first_inside = index < first.inner.len;
    let second_inside = index < second.inner.len;
    let marker_inside = index < expected^.len;
    let results_inside = band(first_inside, second_inside);
    let inside = band(results_inside, marker_inside);
    if inside {
    } else {
      set passing = False();
      break;
    }
    let opportunity = first.inner[index];
    let repeated = second.inner[index];
    let stable = eeq(opportunity, repeated);
    if stable {
    } else {
      if shown {
        put_line_prefix(report: report, line_number: line_number);
        let prefix = &unstable_prefix[0_u64..unstable_prefix.len];
        put_text(buffer: report, text: prefix);
        put_decimal(buffer: report, value: index);
        let suffix = &unstable_suffix[0_u64..unstable_suffix.len];
        put_text(buffer: report, text: suffix);
      }
      return False();
    }
    let marker = expected^[index];
    let hard = mandatory_expected(text: points, index: index);
    let agrees = position_passes(actual: opportunity, marker: marker, mandatory: hard);
    if agrees {
    } else {
      set passing = False();
    }
  }
  if passing {
    return True();
  }
  if shown {
    put_mismatch(report: report, line_number: line_number, text: points, markers: expected, actual: actual);
  }
  return False();
}
