alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias IdnaError = pkg::text::idna::IdnaError;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias domain_to_ascii = pkg::text::idna::domain_to_ascii;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_hex = pkg::oracle::support::put_hex;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;

const sentinel_prefix: Array<u8, 10> =[115_u8, 101_u8, 110_u8, 116_u8, 105_u8, 110_u8, 101_u8, 108_u8, 0_u8, 255_u8];

const null_text: Array<u8, 4> =[110_u8, 117_u8, 108_u8, 108_u8];

const fault_prefix_damaged: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 112_u8, 114_u8, 101_u8, 102_u8, 105_u8, 120_u8, 32_u8, 100_u8, 97_u8, 109_u8, 97_u8, 103_u8, 101_u8, 100_u8, 34_u8];

const fault_changed_on_refusal: Array<u8, 35> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 111_u8, 117_u8, 116_u8, 112_u8, 117_u8, 116_u8, 32_u8, 99_u8, 104_u8, 97_u8, 110_u8, 103_u8, 101_u8, 100_u8, 32_u8, 111_u8, 110_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 97_u8, 108_u8, 34_u8];

const fault_non_ascii: Array<u8, 26> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 110_u8, 111_u8, 110_u8, 45_u8, 65_u8, 83_u8, 67_u8, 73_u8, 73_u8, 32_u8, 111_u8, 117_u8, 116_u8, 112_u8, 117_u8, 116_u8, 34_u8];

const fault_too_large: Array<u8, 19> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const fault_case_too_large: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const unicode_escape: Array<u8, 4> =[92_u8, 117_u8, 48_u8, 48_u8];

const usage_text: Array<u8, 24> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 25> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const malformed_text: Array<u8, 41> =[105_u8, 100_u8, 110_u8, 97_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 32_u8];

const domain_ceiling: u64 = 16777216_u64;

const largest_value: u64 = 4294967295_u64;

const line_feed: u8 = 10_u8;

const space: u8 = 32_u8;

const quotation_mark: u8 = 34_u8;

const reverse_solidus: u8 = 92_u8;

const first_printable: u8 = 32_u8;

const first_non_ascii: u8 = 128_u8;

const digit_zero: u8 = 48_u8;

const digit_nine: u8 = 57_u8;

const lower_a: u8 = 97_u8;

const lower_f: u8 = 102_u8;

const no_hex_digit: u8 = 16_u8;

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, line_number: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that line line_number of the case file, counted from 1, is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: line_number);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file one line at a time, prints one line per case and flushes it at once. A case of more than domain_ceiling values is only checked for its form. Returns False after reporting the first malformed line.";
  let length = text^.len;
  let position = 0_u64;
  let line_number = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    set line_number = line_number +wrap 1_u64;
    let end = line_end(text: text, start: position);
    let terminated = end < length;
    if terminated {
    } else {
      report_malformed(err: err, files: files, report: report, line_number: line_number);
      return False();
    }
    let count = token_count(text: text, start: position, end: end);
    let fits = count <= domain_ceiling;
    let points = box_slots_new::<u32>(capacity: 0_u64);
    if fits {
      set points = box_slots_new::<u32>(capacity: count);
    }
    let parsed = parse_case(text: text, start: position, end: end, points: &points);
    if parsed {
    } else {
      report_malformed(err: err, files: files, report: report, line_number: line_number);
      return False();
    }
    if fits {
      print_case(points: &points, buffer: report);
    } else {
      let message = &fault_case_too_large[0_u64..fault_case_too_large.len];
      put_text(buffer: report, text: message);
    }
    put_byte(buffer: report, value: line_feed);
    let written = flush(factory: files, output: out, buffer: report);
    set position = end +wrap 1_u64;
  }
  return True();
}

fn token_count(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the number of tokens that the spaces from start to end separate: 0 for an empty range, and otherwise one more than the number of spaces.";
  let length = text^.len;
  let ordered = start < end;
  let within = end <= length;
  let usable = band(ordered, within);
  if usable {
  } else {
    return 0_u64;
  }
  let count = 1_u64;
  for (at in start..end) {
    let byte = text^[at];
    let separator = byte == space;
    if separator {
      set count = count +wrap 1_u64;
    }
  }
  return count;
}

fn hex_digit(byte: u8) -> result: u8 pure {
  doc "Returns the value of one lowercase ASCII hexadecimal digit, or no_hex_digit for any other byte.";
  let decimal_low = byte >= digit_zero;
  let decimal_high = byte <= digit_nine;
  let decimal = band(decimal_low, decimal_high);
  if decimal {
    return byte -wrap digit_zero;
  }
  let lower_low = byte >= lower_a;
  let lower_high = byte <= lower_f;
  let lower = band(lower_low, lower_high);
  if lower {
    let offset = byte -wrap lower_a;
    return offset +wrap 10_u8;
  }
  return no_hex_digit;
}

fn store_token(points: &Box<Slots<u32>>, value: u64, digits: u64) -> stored: Bool writes(points) {
  doc "Ends one token of digits digits and value value: returns False for an empty token, and otherwise appends the value to points when it has room and returns True.";
  let empty = digits == 0_u64;
  if empty {
    return False();
  }
  let room = points^.inner.len < points^.inner.cap;
  if room {
    let narrowed = cvt.wrap::<u64, u32>(value);
    place_back(window: &points^.inner, value: narrowed);
  }
  return True();
}

fn parse_case(text: &[u8], start: u64, end: u64, points: &Box<Slots<u32>>) -> parsed: Bool reads(text), writes(points) {
  doc "Parses one case line from start to end: nothing, or tokens of lowercase hexadecimal digits separated by single spaces, each at most largest_value. Appends each value to points while points has room. Returns False for an empty token, any other byte, or a value past largest_value; the value stays at most largest_value before each shift, so it cannot overflow.";
  let length = text^.len;
  let ordered = start <= end;
  let within = end <= length;
  let usable = band(ordered, within);
  if usable {
  } else {
    return False();
  }
  let empty = start == end;
  if empty {
    return True();
  }
  let value = 0_u64;
  let digits = 0_u64;
  for (at in start..end) {
    let byte = text^[at];
    let separator = byte == space;
    if separator {
      let stored = store_token(points: points, value: value, digits: digits);
      if stored {
      } else {
        return False();
      }
      set value = 0_u64;
      set digits = 0_u64;
    } else {
      let digit = hex_digit(byte: byte);
      let valid = digit < no_hex_digit;
      if valid {
      } else {
        return False();
      }
      let widened = cvt::<u8, u64>(digit);
      let shifted = ishl.wrap(value, 4_u32);
      set value = ior(shifted, widened);
      let bounded = value <= largest_value;
      if bounded {
      } else {
        return False();
      }
      set digits = digits +wrap 1_u64;
    }
  }
  let stored = store_token(points: points, value: value, digits: digits);
  return stored;
}

fn sentinel_output() -> made: Box<Slots<u8>> pure {
  doc "Takes one window that holds the bytes of sentinel_prefix and has no spare capacity, so an append must grow it.";
  let count = sentinel_prefix.len;
  let built = box_slots_new::<u8>(capacity: count);
  for @fill (
    at in 0_u64..count,
    invariant grown: built.inner.len == at
  ) {
    let byte = sentinel_prefix[at];
    place_back(window: &built.inner, value: byte);
  }
  return move built;
}

fn prefix_intact(output: &Box<Slots<u8>>) -> intact: Bool reads(output) {
  doc "Tells whether output still starts with the bytes of sentinel_prefix.";
  let count = sentinel_prefix.len;
  let length = output^.inner.len;
  let long = length >= count;
  if long {
  } else {
    return False();
  }
  for (at in 0_u64..count) {
    let inside = at < output^.inner.len;
    if inside {
    } else {
      return False();
    }
    let byte = output^.inner[at];
    let expected = sentinel_prefix[at];
    let same = byte == expected;
    if same {
    } else {
      return False();
    }
  }
  return True();
}

fn print_case(points: &Box<Slots<u32>>, buffer: &Box<Slots<u8>>) -> result: unit reads(points), writes(buffer) {
  doc "Runs domain_to_ascii on the values of points after the sentinel prefix and appends the case's line without its line feed: the prefix fault when the prefix is not intact, the result string or its fault on success, and on a refusal the refusal fault when bytes follow the prefix, and otherwise null for Invalid or the TooLarge fault.";
  let count = points^.inner.len;
  let domain = &points^.inner[0_u64..count];
  let small = domain^.len <= domain_ceiling;
  if small {
  } else {
    let message = &fault_case_too_large[0_u64..fault_case_too_large.len];
    put_text(buffer: buffer, text: message);
    return unit;
  }
  let output = sentinel_output();
  let result = domain_to_ascii(domain: domain, output: &output);
  let intact = prefix_intact(output: &output);
  if intact {
  } else {
    let message = &fault_prefix_damaged[0_u64..fault_prefix_damaged.len];
    put_text(buffer: buffer, text: message);
    return unit;
  }
  match result {
    Ok(value: done) => {
      put_result(buffer: buffer, output: &output);
    }
    Err(error: refusal) => {
      let unchanged = output.inner.len == sentinel_prefix.len;
      if unchanged {
      } else {
        let message = &fault_changed_on_refusal[0_u64..fault_changed_on_refusal.len];
        put_text(buffer: buffer, text: message);
        return unit;
      }
      match refusal {
        Invalid() => {
          let message = &null_text[0_u64..null_text.len];
          put_text(buffer: buffer, text: message);
        }
        TooLarge() => {
          let message = &fault_too_large[0_u64..fault_too_large.len];
          put_text(buffer: buffer, text: message);
        }
      }
    }
  }
  return unit;
}

fn put_result(buffer: &Box<Slots<u8>>, output: &Box<Slots<u8>>) -> result: unit reads(output), writes(buffer) {
  doc "Appends the bytes of output after the sentinel prefix as one JSON string, or the non-ASCII fault when one of them is 0x80 or above.";
  let length = output^.inner.len;
  let start = sentinel_prefix.len;
  for (at in start..length) {
    let byte = output^.inner[at];
    let ascii = byte < first_non_ascii;
    if ascii {
    } else {
      let message = &fault_non_ascii[0_u64..fault_non_ascii.len];
      put_text(buffer: buffer, text: message);
      return unit;
    }
  }
  put_byte(buffer: buffer, value: quotation_mark);
  for (at in start..length) {
    let byte = output^.inner[at];
    put_json_byte(buffer: buffer, byte: byte);
  }
  put_byte(buffer: buffer, value: quotation_mark);
  return unit;
}

fn put_json_byte(buffer: &Box<Slots<u8>>, byte: u8) -> result: unit writes(buffer) {
  doc "Appends one byte of a JSON string: a quotation mark or reverse solidus after a reverse solidus, a byte below 0x20 as a \\u00XX escape, and every other byte unchanged.";
  let quote = byte == quotation_mark;
  let solidus = byte == reverse_solidus;
  let escaped = bor(quote, solidus);
  if escaped {
    put_byte(buffer: buffer, value: reverse_solidus);
    put_byte(buffer: buffer, value: byte);
    return unit;
  }
  let control = byte < first_printable;
  if control {
    let escape = &unicode_escape[0_u64..unicode_escape.len];
    put_text(buffer: buffer, text: escape);
    let widened = cvt::<u8, u64>(byte);
    let uppercase = True();
    put_hex(buffer: buffer, value: widened, width: 2_u64, uppercase: uppercase);
    return unit;
  }
  put_byte(buffer: buffer, value: byte);
  return unit;
}
