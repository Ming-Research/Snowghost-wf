const pixel_text: Array<u8, 7> =[112_u8, 105_u8, 120_u8, 101_u8, 108_u8, 32_u8, 40_u8];

const is_text: Array<u8, 5> =[41_u8, 32_u8, 105_u8, 115_u8, 32_u8];

const list_line_text: Array<u8, 5> =[108_u8, 105_u8, 110_u8, 101_u8, 32_u8];

const malformed_line_text: Array<u8, 59> =[58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 44_u8, 32_u8, 101_u8, 120_u8, 112_u8, 101_u8, 99_u8, 116_u8, 101_u8, 100_u8, 32_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 78_u8, 65_u8, 77_u8, 69_u8, 32_u8, 111_u8, 114_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 78_u8, 65_u8, 77_u8, 69_u8, 10_u8];

const checksum_text: Array<u8, 9> =[99_u8, 104_u8, 101_u8, 99_u8, 107_u8, 115_u8, 117_u8, 109_u8, 32_u8];

const comma_text: Array<u8, 2> =[44_u8, 32_u8];

const shown_failure_limit: u64 = 10_u64;

const sample_stride: u64 = 4093_u64;

const no_command: u8 = 0_u8;

const check_command: u8 = 1_u8;

const time_command: u8 = 2_u8;

const no_case: u8 = 0_u8;

const valid_case: u8 = 1_u8;

const invalid_case: u8 = 2_u8;

const line_feed: u8 = 10_u8;

const space: u8 = 32_u8;

const left_parenthesis: u8 = 40_u8;

const right_parenthesis: u8 = 41_u8;

const question_mark: u8 = 63_u8;

struct Tally {
  cases: u64;
  passed: u64;
  failed: u64;
}

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, runs the selected command and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn bytes_equal(left: &[u8], right: &[u8]) -> result: Bool reads(left), reads(right) {
  doc "Tells whether two byte ranges hold the same bytes.";
  let length = left^.len;
  let same_length = length == right^.len;
  if same_length {
  } else {
    return False();
  }
  for (at in 0_u64..length) {
    let right_inside = at < right^.len;
    if right_inside {
    } else {
      return False();
    }
    let left_byte = left^[at];
    let right_byte = right^[at];
    let same = left_byte == right_byte;
    if same {
    } else {
      return False();
    }
  }
  return True();
}

fn command_code(args: &Args) -> result: u8 reads(args) {
  doc "Classifies the first argument: check_command for `check`, time_command for `time`, and no_command for anything else or no argument.";
  match argument_bytes(args: args, position: 1_u64) {
    Some(value: word) => {
      let length = word.inner.len;
      let spelled = &word.inner[0_u64..length];
      let check = &check_word[0_u64..check_word.len];
      let is_check = bytes_equal(left: spelled, right: check);
      if is_check {
        return check_command;
      }
      let time = &time_word[0_u64..time_word.len];
      let is_time = bytes_equal(left: spelled, right: time);
      if is_time {
        return time_command;
      }
      return no_command;
    }
    None() => {
      return no_command;
    }
  }
}

fn judge(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Selects the command from the arguments and returns its exit code, or prints the usage and returns 2.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let command = command_code(args: args);
  let is_check = command == check_command;
  let check_shape = count == 4_u64;
  let checking = band(is_check, check_shape);
  if checking {
    let check_code = run_check(args: args, cwd: cwd, out: out, err: err, files: files, report: &report);
    return check_code;
  }
  let is_time = command == time_command;
  let time_shape = count >= 4_u64;
  let timing = band(is_time, time_shape);
  if timing {
    let time_code = run_time(args: args, cwd: cwd, out: out, err: err, files: files, report: &report);
    return time_code;
  }
  report_usage(err: err, files: files, report: &report);
  return 2_u8;
}

fn report_usage(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Prints the usage line on standard error.";
  let usage = &usage_text[0_u64..usage_text.len];
  put_text(buffer: report, text: usage);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn put_argument_problem(report: &Box<Slots<u8>>, args: &Args, reason: &[u8], position: u64, problem: IoError) -> result: unit reads(args), reads(reason), writes(report) {
  doc "Writes `png_oracle: REASON ARGUMENT` and the host error code, naming the argument at position.";
  let prefix = &program_prefix[0_u64..program_prefix.len];
  put_text(buffer: report, text: prefix);
  put_text(buffer: report, text: reason);
  put_argument(buffer: report, args: args, position: position);
  put_host_error(buffer: report, error: problem);
  return unit;
}

fn report_argument(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, reason: &[u8], position: u64, problem: IoError) -> result: unit reads(args), reads(reason), writes(err), writes(files), writes(report) waits {
  doc "Prints `png_oracle: REASON ARGUMENT` and the host error code on standard error, naming the argument at position.";
  put_argument_problem(report: report, args: args, reason: reason, position: position, problem: problem);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_directory(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, problem: IoError) -> result: unit reads(args), writes(err), writes(files), writes(report) waits {
  doc "Prints on standard error that DIR, the third argument, cannot be opened, with the host error code and the reminder that open_directory refuses a symbolic link.";
  let reason = &cannot_open_text[0_u64..cannot_open_text.len];
  put_argument_problem(report: report, args: args, reason: reason, position: 3_u64, problem: problem);
  let hint = &symlink_hint_text[0_u64..symlink_hint_text.len];
  put_text(buffer: report, text: hint);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn run_check(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files), writes(report) waits {
  doc "The check command: reads LIST, opens DIR, judges every case and prints the summary.";
  let unreadable = &cannot_read_text[0_u64..cannot_read_text.len];
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 2_u64) {
    Ok(value: list) => {
      match argument_bytes(args: args, position: 3_u64) {
        Some(value: directory_name) => {
          let name_length = directory_name.inner.len;
          let name_view = &directory_name.inner[0_u64..name_length];
          match open_directory_path(factory: files, root: cwd, name: name_view) {
            Ok(value: directory) => {
              let list_length = list.inner.len;
              let text = &list.inner[0_u64..list_length];
              let tally = check_cases(text: text, directory: &directory, out: out, files: files, report: report);
              close_directory(factory: files, directory: move directory);
              let name = &summary_name[0_u64..summary_name.len];
              put_summary(buffer: report, name: name, cases: tally.cases, passed: tally.passed, failed: tally.failed);
              let written = flush(factory: files, output: out, buffer: report);
              let empty = tally.cases == 0_u64;
              if empty {
                let message = &no_cases_text[0_u64..no_cases_text.len];
                put_text(buffer: report, text: message);
                let noted = flush(factory: files, output: err, buffer: report);
                return 1_u8;
              }
              let clean = tally.failed == 0_u64;
              if clean {
                return 0_u8;
              }
              return 1_u8;
            }
            Err(error: problem) => {
              report_directory(err: err, files: files, report: report, args: args, problem: problem);
              return 2_u8;
            }
          }
        }
        None() => {
          let too_long = IoError::InvalidInput(code: 0_u32, origin: 0_u8);
          report_directory(err: err, files: files, report: report, args: args, problem: too_long);
          return 2_u8;
        }
      }
    }
    Err(error: problem) => {
      report_argument(err: err, files: files, report: report, args: args, reason: unreadable, position: 2_u64, problem: problem);
      return 2_u8;
    }
  }
}

fn check_cases(text: &[u8], directory: &DirectoryRead, out: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> tally: Tally reads(text), reads(directory), writes(out), writes(files), writes(report) waits {
  doc "Judges every nonempty line of the case list as one case. The first shown_failure_limit failing cases are reported and flushed as they are found.";
  let length = text^.len;
  let start = 0_u64;
  let line_number = 0_u64;
  let cases = 0_u64;
  let passed = 0_u64;
  let failed = 0_u64;
  loop @lines {
    let more = start < length;
    if more {
    } else {
      break @lines;
    }
    let end = line_end(text: text, start: start);
    set line_number = line_number +wrap 1_u64;
    let blank = end == start;
    if blank {
    } else {
      set cases = cases +wrap 1_u64;
      let shown = failed < shown_failure_limit;
      let passing = check_case(text: text, start: start, end: end, line_number: line_number, directory: directory, files: files, shown: shown, report: report);
      if passing {
        set passed = passed +wrap 1_u64;
      } else {
        set failed = failed +wrap 1_u64;
        let written = flush(factory: files, output: out, buffer: report);
      }
    }
    set start = end +wrap 1_u64;
  }
  return Tally(cases: cases, passed: passed, failed: failed);
}

fn case_kind(text: &[u8], start: u64, end: u64) -> result: u8 reads(text) {
  doc "Classifies the word from start to end of a case line: valid_case, invalid_case, or no_case for any other word.";
  let ordered = start <= end;
  let within = end <= text^.len;
  let located = band(ordered, within);
  if located {
  } else {
    return no_case;
  }
  let word = &text^[start..end];
  let valid = &valid_word[0_u64..valid_word.len];
  let is_valid = bytes_equal(left: word, right: valid);
  if is_valid {
    return valid_case;
  }
  let invalid = &invalid_word[0_u64..invalid_word.len];
  let is_invalid = bytes_equal(left: word, right: invalid);
  if is_invalid {
    return invalid_case;
  }
  return no_case;
}

fn first_space(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first space from start to end, or end.";
  let within = end <= text^.len;
  let ordered = start <= end;
  let located = band(ordered, within);
  if located {
  } else {
    return end;
  }
  for (at in start..end) {
    let byte = text^[at];
    let found = byte == space;
    if found {
      return at;
    }
  }
  return end;
}

fn joined_name(name: &[u8], suffix: &[u8]) -> result: Box<Slots<u8>> reads(name), reads(suffix) {
  doc "Returns a fresh window holding the bytes of name followed by those of suffix.";
  let built = box_slots_new::<u8>(capacity: 0_u64);
  put_text(buffer: &built, text: name);
  put_text(buffer: &built, text: suffix);
  return move built;
}

fn put_name_prefix(report: &Box<Slots<u8>>, name: &[u8]) -> result: unit reads(name), writes(report) {
  doc "Writes `NAME: ` to the report.";
  put_text(buffer: report, text: name);
  let separator = &separator_text[0_u64..separator_text.len];
  put_text(buffer: report, text: separator);
  return unit;
}

fn put_unreadable(report: &Box<Slots<u8>>, name: &[u8], file_name: &[u8], problem: IoError) -> result: unit reads(name), reads(file_name), writes(report) {
  doc "Writes `NAME: cannot read FILE`, the host error code and a line feed to the report.";
  put_name_prefix(report: report, name: name);
  let reason = &cannot_read_text[0_u64..cannot_read_text.len];
  put_text(buffer: report, text: reason);
  put_text(buffer: report, text: file_name);
  put_host_error(buffer: report, error: problem);
  put_byte(buffer: report, value: line_feed);
  return unit;
}

fn put_png_error(report: &Box<Slots<u8>>, problem: PngError) -> result: unit writes(report) {
  doc "Writes `decode failed with Malformed` or `decode failed with TooLarge` to the report.";
  let reason = &decode_failed_text[0_u64..decode_failed_text.len];
  put_text(buffer: report, text: reason);
  match problem {
    Malformed() => {
      let spelled = &malformed_name[0_u64..malformed_name.len];
      put_text(buffer: report, text: spelled);
    }
    TooLarge() => {
      let spelled = &too_large_name[0_u64..too_large_name.len];
      put_text(buffer: report, text: spelled);
    }
  }
  return unit;
}

fn check_case(text: &[u8], start: u64, end: u64, line_number: u64, directory: &DirectoryRead, files: &HandleFactory, shown: Bool, report: &Box<Slots<u8>>) -> passed: Bool reads(text), reads(directory), writes(files), writes(report) waits {
  doc "Judges the case line from start to end: reads DIR/NAME.png and decodes it; an invalid case passes when decoding fails, and a valid one when compare_image accepts the image against DIR/NAME.rgba. Writes the reason of a failing case when shown is True.";
  let gap = first_space(text: text, start: start, end: end);
  let kind = case_kind(text: text, start: start, end: gap);
  let name_start = gap +wrap 1_u64;
  let known = kind != no_case;
  let named = name_start < end;
  let within = end <= text^.len;
  let shaped = band(known, named);
  let usable = band(shaped, within);
  if usable {
  } else {
    if shown {
      let word = &list_line_text[0_u64..list_line_text.len];
      put_text(buffer: report, text: word);
      put_decimal(buffer: report, value: line_number);
      let reason = &malformed_line_text[0_u64..malformed_line_text.len];
      put_text(buffer: report, text: reason);
    }
    return False();
  }
  let name = &text^[name_start..end];
  let png_extension = &png_suffix[0_u64..png_suffix.len];
  let png_name = joined_name(name: name, suffix: png_extension);
  let png_length = png_name.inner.len;
  let png_view = &png_name.inner[0_u64..png_length];
  match read_directory_file(factory: files, directory: directory, name: png_view) {
    Ok(value: data) => {
      let data_length = data.inner.len;
      let data_view = &data.inner[0_u64..data_length];
      let decoded = decode_png(data: data_view);
      let expects_error = kind == invalid_case;
      if expects_error {
        match move decoded {
          Ok(value: image) => {
            if shown {
              put_name_prefix(report: report, name: name);
              let reason = &unexpected_success_text[0_u64..unexpected_success_text.len];
              put_text(buffer: report, text: reason);
            }
            return False();
          }
          Err(error: problem) => {
            return True();
          }
        }
      }
      match move decoded {
        Ok(value: image) => {
          let rgba_extension = &rgba_suffix[0_u64..rgba_suffix.len];
          let rgba_name = joined_name(name: name, suffix: rgba_extension);
          let rgba_length = rgba_name.inner.len;
          let rgba_view = &rgba_name.inner[0_u64..rgba_length];
          match read_directory_file(factory: files, directory: directory, name: rgba_view) {
            Ok(value: reference) => {
              let reference_length = reference.inner.len;
              let reference_view = &reference.inner[0_u64..reference_length];
              let matching = compare_image(image: &image, reference: reference_view, name: name, shown: shown, report: report);
              return matching;
            }
            Err(error: problem) => {
              if shown {
                put_unreadable(report: report, name: name, file_name: rgba_view, problem: problem);
              }
              return False();
            }
          }
        }
        Err(error: problem) => {
          if shown {
            put_name_prefix(report: report, name: name);
            put_png_error(report: report, problem: problem);
            put_byte(buffer: report, value: line_feed);
          }
          return False();
        }
      }
    }
    Err(error: problem) => {
      if shown {
        put_unreadable(report: report, name: name, file_name: png_view, problem: problem);
      }
      return False();
    }
  }
}

fn little_endian_u32(bytes: &[u8], at: u64) -> result: u32 reads(bytes) {
  doc "Reads the little-endian u32 at index at of bytes; bytes past the end read as zero.";
  let value = 0_u32;
  let remaining = 4_u64;
  loop @bytes {
    let finished = remaining == 0_u64;
    if finished {
      break @bytes;
    }
    set remaining = remaining -wrap 1_u64;
    let index = at +wrap remaining;
    let inside = index < bytes^.len;
    let byte = 0_u8;
    if inside {
      set byte = bytes^[index];
    }
    let widened = cvt::<u8, u32>(byte);
    let shifted = ishl.wrap(value, 8_u32);
    set value = ior(shifted, widened);
  }
  return value;
}

fn put_size(report: &Box<Slots<u8>>, width: u32, height: u32) -> result: unit writes(report) {
  doc "Writes `WxH` to the report.";
  let wide = cvt::<u32, u64>(width);
  put_decimal(buffer: report, value: wide);
  let by = &by_text[0_u64..by_text.len];
  put_text(buffer: report, text: by);
  let high = cvt::<u32, u64>(height);
  put_decimal(buffer: report, value: high);
  return unit;
}

fn put_rgba(report: &Box<Slots<u8>>, bytes: &[u8], at: u64) -> result: unit reads(bytes), writes(report) {
  doc "Writes the four bytes of bytes from at as `(R, G, B, A)` in decimal; a byte past the end is written as a question mark.";
  put_byte(buffer: report, value: left_parenthesis);
  for (channel in 0_u64..4_u64) {
    let separated = channel > 0_u64;
    if separated {
      let comma = &comma_text[0_u64..comma_text.len];
      put_text(buffer: report, text: comma);
    }
    let index = at +wrap channel;
    let inside = index < bytes^.len;
    if inside {
      let byte = bytes^[index];
      let widened = cvt::<u8, u64>(byte);
      put_decimal(buffer: report, value: widened);
    } else {
      put_byte(buffer: report, value: question_mark);
    }
  }
  put_byte(buffer: report, value: right_parenthesis);
  return unit;
}

fn compare_image(image: &Image, reference: &[u8], name: &[u8], shown: Bool, report: &Box<Slots<u8>>) -> passed: Bool reads(image), reads(reference), reads(name), writes(report) {
  doc "Compares a decoded image with its reference: the width and height, the pixel byte count against width * height * 4, and then every pixel byte, reporting the first differing pixel with its x, y and both RGBA values. A reference whose length is not 8 + width * height * 4 fails the case as a malformed reference.";
  let reference_length = reference^.len;
  let expected_width = little_endian_u32(bytes: reference, at: 0_u64);
  let expected_height = little_endian_u32(bytes: reference, at: 4_u64);
  let width = image^.width;
  let height = image^.height;
  let wide = cvt::<u32, u64>(expected_width);
  let high = cvt::<u32, u64>(expected_height);
  let area = wide *checked high;
  let expected_bytes = 0_u64;
  let sized = False();
  match area {
    Ok(value: pixel_count) => {
      let bytes = pixel_count *checked 4_u64;
      match bytes {
        Ok(value: byte_count) => {
          set expected_bytes = byte_count;
          set sized = True();
        }
        Err(error: overflow) => {
        }
      }
    }
    Err(error: overflow) => {
    }
  }
  let headed = reference_length >= 8_u64;
  let pixel_part = reference_length -wrap 8_u64;
  let complete = pixel_part == expected_bytes;
  let framed = band(headed, sized);
  let well_formed = band(framed, complete);
  if well_formed {
  } else {
    if shown {
      put_name_prefix(report: report, name: name);
      let prefix = &reference_malformed_text[0_u64..reference_malformed_text.len];
      put_text(buffer: report, text: prefix);
      put_decimal(buffer: report, value: reference_length);
      let suffix = &reference_bytes_text[0_u64..reference_bytes_text.len];
      put_text(buffer: report, text: suffix);
    }
    return False();
  }
  let same_width = width == expected_width;
  let same_height = height == expected_height;
  let same_size = band(same_width, same_height);
  if same_size {
  } else {
    if shown {
      put_name_prefix(report: report, name: name);
      let label = &size_text[0_u64..size_text.len];
      put_text(buffer: report, text: label);
      put_size(report: report, width: width, height: height);
      let expected = &expected_text[0_u64..expected_text.len];
      put_text(buffer: report, text: expected);
      put_size(report: report, width: expected_width, height: expected_height);
      put_byte(buffer: report, value: line_feed);
    }
    return False();
  }
  let actual_bytes = image^.pixels.inner.len;
  let counted = actual_bytes == expected_bytes;
  if counted {
  } else {
    if shown {
      put_name_prefix(report: report, name: name);
      put_decimal(buffer: report, value: actual_bytes);
      let label = &pixel_bytes_text[0_u64..pixel_bytes_text.len];
      put_text(buffer: report, text: label);
      let expected = &expected_text[0_u64..expected_text.len];
      put_text(buffer: report, text: expected);
      put_decimal(buffer: report, value: expected_bytes);
      put_byte(buffer: report, value: line_feed);
    }
    return False();
  }
  let pixels = &image^.pixels.inner[0_u64..actual_bytes];
  for (index in 0_u64..actual_bytes) {
    let reference_index = index +wrap 8_u64;
    let reference_inside = reference_index < reference_length;
    if reference_inside {
    } else {
      return False();
    }
    let actual = pixels^[index];
    let expected = reference^[reference_index];
    let same = actual == expected;
    if same {
    } else {
      if shown {
        put_pixel_mismatch(report: report, name: name, pixels: pixels, reference: reference, index: index, width: wide);
      }
      return False();
    }
  }
  return True();
}

fn put_pixel_mismatch(report: &Box<Slots<u8>>, name: &[u8], pixels: &[u8], reference: &[u8], index: u64, width: u64) -> result: unit reads(name), reads(pixels), reads(reference), writes(report) {
  doc "Writes `NAME: pixel (X, Y) is (R, G, B, A), expected (R, G, B, A)` and a line feed for the pixel that holds pixel byte index.";
  let channel = index % 4_u64;
  let first_byte = index -wrap channel;
  let pixel = index / 4_u64;
  let column = 0_u64;
  let row = 0_u64;
  let has_width = width > 0_u64;
  if has_width {
    set column = pixel % width;
    set row = pixel / width;
  }
  put_name_prefix(report: report, name: name);
  let label = &pixel_text[0_u64..pixel_text.len];
  put_text(buffer: report, text: label);
  put_decimal(buffer: report, value: column);
  let comma = &comma_text[0_u64..comma_text.len];
  put_text(buffer: report, text: comma);
  put_decimal(buffer: report, value: row);
  let is_label = &is_text[0_u64..is_text.len];
  put_text(buffer: report, text: is_label);
  put_rgba(report: report, bytes: pixels, at: first_byte);
  let expected = &expected_text[0_u64..expected_text.len];
  put_text(buffer: report, text: expected);
  let reference_byte = first_byte +wrap 8_u64;
  put_rgba(report: report, bytes: reference, at: reference_byte);
  put_byte(buffer: report, value: line_feed);
  return unit;
}

fn sample_sum(total: u64, image: &Image) -> result: u64 reads(image) {
  doc "Adds every sample_stride-th pixel byte of image, starting with the first, to total, wrapping as the reference's unsigned sum does.";
  let length = image^.pixels.inner.len;
  let sum = total;
  let at = 0_u64;
  loop @samples {
    let inside = at < length;
    if inside {
    } else {
      break @samples;
    }
    let byte = image^.pixels.inner[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum +wrap widened;
    let next = at +wrap sample_stride;
    let advanced = next > at;
    if advanced {
    } else {
      break @samples;
    }
    set at = next;
  }
  return sum;
}

fn run_time(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files), writes(report) waits {
  doc "The time command: for each FILE argument, reads the file once and then decodes it REPEAT times, adding sample_sum of each image to the checksum; prints `checksum N` when every decode succeeds.";
  let repeat = 0_u64;
  let counted = False();
  match argument_bytes(args: args, position: 2_u64) {
    Some(value: word) => {
      let length = word.inner.len;
      let spelled = &word.inner[0_u64..length];
      match parse_decimal(text: spelled, start: 0_u64, end: length) {
        Some(value: parsed) => {
          set repeat = parsed;
          set counted = True();
        }
        None() => {
        }
      }
    }
    None() => {
    }
  }
  if counted {
  } else {
    report_usage(err: err, files: files, report: report);
    return 2_u8;
  }
  let count = args_count(args: args);
  let checksum = 0_u64;
  for (position in 3_u64..count) {
    match read_argument_file(factory: files, cwd: cwd, args: args, position: position) {
      Ok(value: data) => {
        let data_length = data.inner.len;
        let data_view = &data.inner[0_u64..data_length];
        for (round in 0_u64..repeat) {
          let decoded = decode_png(data: data_view);
          match move decoded {
            Ok(value: image) => {
              set checksum = sample_sum(total: checksum, image: &image);
            }
            Err(error: problem) => {
              let prefix = &program_prefix[0_u64..program_prefix.len];
              put_text(buffer: report, text: prefix);
              put_argument(buffer: report, args: args, position: position);
              let separator = &separator_text[0_u64..separator_text.len];
              put_text(buffer: report, text: separator);
              put_png_error(report: report, problem: problem);
              put_byte(buffer: report, value: line_feed);
              let written = flush(factory: files, output: err, buffer: report);
              return 1_u8;
            }
          }
        }
      }
      Err(error: problem) => {
        let unreadable = &cannot_read_text[0_u64..cannot_read_text.len];
        report_argument(err: err, files: files, report: report, args: args, reason: unreadable, position: position, problem: problem);
        return 2_u8;
      }
    }
  }
  let label = &checksum_text[0_u64..checksum_text.len];
  put_text(buffer: report, text: label);
  put_decimal(buffer: report, value: checksum);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: out, buffer: report);
  return 0_u8;
}
