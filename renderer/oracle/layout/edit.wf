alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias AttributeNamespace = pkg::dom::AttributeNamespace;
alias Document = pkg::dom::Document;
alias DomError = pkg::dom::DomError;
alias Environment = pkg::css::values::Environment;
alias FontSet = pkg::layout::text::FontSet;
alias HandleFactory = std::io::HandleFactory;
alias Namespace = pkg::dom::Namespace;
alias NodeData = pkg::dom::NodeData;
alias NodeId = pkg::dom::NodeId;
alias OutputStream = std::io::OutputStream;
alias Page = pkg::oracle::page::Page;
alias TextSpan = pkg::dom::TextSpan;
alias Viewport = pkg::layout::Viewport;
alias add_sheet = pkg::style::add_sheet;
alias append_child = pkg::dom::append_child;
alias atom_intern = pkg::base::atom::atom_intern;
alias create_node = pkg::dom::create_node;
alias detach = pkg::dom::detach;
alias flush = pkg::oracle::support::flush;
alias insert_before = pkg::dom::insert_before;
alias line_end = pkg::oracle::support::line_end;
alias origin_author = pkg::style::origin_author;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_hex = pkg::oracle::support::put_hex;
alias put_text = pkg::oracle::support::put_text;
alias set_attribute = pkg::dom::set_attribute;
alias set_text = pkg::dom::set_text;
alias store_text = pkg::dom::store_text;
alias truncate = pkg::oracle::support::truncate;

const fnv_basis: u64 = 14695981039346656037_u64;

const fnv_prime: u64 = 1099511628211_u64;

const paragraph_name: Array<u8, 1> = "p";

const class_name: Array<u8, 5> = "class";

const base_label: Array<u8, 10> = "base hash ";

const edit_label: Array<u8, 5> = "edit ";

const hash_label: Array<u8, 6> = " hash ";

const bytes_label: Array<u8, 7> = " bytes ";

const created_label: Array<u8, 8> = "created ";

const element_label: Array<u8, 2> = "E ";

const text_label: Array<u8, 2> = "T ";

const arena_label: Array<u8, 2> = "N ";

const line_label: Array<u8, 17> = "edit script line ";

const refused_label: Array<u8, 10> = " refused: ";

const sheet_late_reason: Array<u8, 34> = "a style sheet line follows an edit";

const operation_reason: Array<u8, 28> = "the operation does not apply";

const syntax_reason: Array<u8, 20> = "unreadable operation";

const render_reason: Array<u8, 25> = "the pipeline fails (stage";

fn fnv1a(bytes: &[u8]) -> hash: u64 reads(bytes) {
  doc "The 64-bit FNV-1a hash of bytes.";
  let state = fnv_basis;
  let length = bytes^.len;
  for (at in 0_u64..length) {
    let byte = cvt::<u8, u64>(bytes^[at]);
    let mixed = ixor(state, byte);
    set state = mixed *wrap fnv_prime;
  }
  return state;
}

fn field_end(line: &[u8], start: u64) -> end: u64 reads(line) {
  doc "The index of the first space at or after start in line, or the length of line when there is none.";
  let length = line^.len;
  if start >= length {
    return length;
  }
  for (at in start..length) {
    if line^[at] == 32_u8 {
      return at;
    }
  }
  return length;
}

fn read_number(line: &[u8], start: u64) -> (found: Bool, value: u64, next: u64) reads(line) {
  doc "Parses the field of line that starts at start as a decimal number, and returns where the next field starts, past the space that ends this one.";
  let length = line^.len;
  let no = False();
  let yes = True();
  if start >= length {
    return no, 0_u64, length;
  }
  let end = field_end(line: line, start: start);
  match parse_decimal(text: line, start: start, end: end) {
    Some(value: number) => {
      let next = end +sat 1_u64;
      return yes, number, next;
    }
    None() => {
      return no, 0_u64, length;
    }
  }
}

fn node_id_of(value: u64) -> node: Option<NodeId> pure {
  doc "The node identifier with index value, or None when value does not fit one.";
  if value < 4294967295_u64 {
    let index = cvt::<u64, u32>(value);
    let id = NodeId(index: index);
    return Some<NodeId>(value: id);
  }
  return None<NodeId>();
}

fn put_unescaped(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) {
  doc "Appends text with each backslash pair resolved: `\\\\` is a backslash and `\\n` a line feed; a backslash before any other byte stays.";
  let length = text^.len;
  let skip = False();
  for (at in 0_u64..length) {
    if skip {
      set skip = False();
    } else {
      let byte = text^[at];
      let next = at +sat 1_u64;
      if byte == 92_u8 {
        if next < length {
          let following = text^[next];
          if following == 92_u8 {
            put_byte(buffer: buffer, value: 92_u8);
            set skip = True();
          } else if following == 110_u8 {
            put_byte(buffer: buffer, value: 10_u8);
            set skip = True();
          } else {
            put_byte(buffer: buffer, value: byte);
          }
        } else {
          put_byte(buffer: buffer, value: byte);
        }
      } else {
        put_byte(buffer: buffer, value: byte);
      }
    }
  }
  return unit;
}

fn put_escaped(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) {
  doc "Appends text with each backslash written as two and each line feed as a backslash and n.";
  let length = text^.len;
  for (at in 0_u64..length) {
    let byte = text^[at];
    if byte == 92_u8 {
      put_byte(buffer: buffer, value: 92_u8);
      put_byte(buffer: buffer, value: 92_u8);
    } else if byte == 10_u8 {
      put_byte(buffer: buffer, value: 92_u8);
      put_byte(buffer: buffer, value: 110_u8);
    } else {
      put_byte(buffer: buffer, value: byte);
    }
  }
  return unit;
}

fn text_span_at(document: &Document, node: NodeId) -> span: Option<TextSpan> reads(document) {
  doc "The data span of the Text node, within the document's text, or None for any other node.";
  let at = cvt::<u32, u64>(node.index);
  if at < document^.nodes.inner.len {
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Text(data: found) => {
        let held = found^;
        let start = cvt::<u32, u64>(held.start);
        let end = cvt::<u32, u64>(held.end);
        let ordered = start <= end;
        let inside = end <= document^.text.inner.len;
        let usable = band(ordered, inside);
        if usable {
          return Some<TextSpan>(value: held);
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Element(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return None<TextSpan>();
}

fn splice_bytes(old: &[u8], offset: u64, removed: u64, inserted: &[u8], scratch: &Box<Slots<u8>>) -> ok: Bool reads(old), reads(inserted), writes(scratch) {
  doc "Appends to scratch the bytes of old with removed bytes at offset replaced by inserted; False, with nothing appended, when the removed range is not inside old.";
  let length = old^.len;
  if offset > length {
    return False();
  }
  let rest = offset +sat removed;
  if rest > length {
    return False();
  }
  put_text(buffer: scratch, text: &old^[0_u64..offset]);
  put_text(buffer: scratch, text: inserted);
  put_text(buffer: scratch, text: &old^[rest..length]);
  return True();
}

fn splice_text(document: &Document, node: NodeId, offset: u64, removed: u64, inserted: &[u8]) -> ok: Bool reads(inserted), writes(document) {
  doc "Replaces removed bytes at offset of the Text node's data with inserted: the new data is stored and set_text points the node at it.";
  match text_span_at(document: document, node: node) {
    Some(value: span) => {
      let start = cvt::<u32, u64>(span.start);
      let end = cvt::<u32, u64>(span.end);
      let scratch = box_slots_new::<u8>(capacity: 1024_u64);
      let spliced = if start <= end {
        if end <= document^.text.inner.len {
          give splice_bytes(old: &document^.text.inner[start..end], offset: offset, removed: removed, inserted: inserted, scratch: &scratch);
        } else {
          give False();
        }
      } else {
        give False();
      }
      if spliced {
      } else {
        return False();
      }
      let size = scratch.inner.len;
      if size > 1073741824_u64 {
        return False();
      }
      match store_text(document: document, text: &scratch.inner[0_u64..size]) {
        Ok(value: stored) => {
          match set_text(document: document, node: node, data: stored) {
            Ok(..) => {
              return True();
            }
            Err(..) => {
              return False();
            }
          }
        }
        Err(..) => {
          return False();
        }
      }
    }
    None() => {
      return False();
    }
  }
}

fn class_span(document: &Document, holder: NodeId, class_atom: u32) -> (is_element: Bool, has_class: Bool, span: TextSpan) reads(document) {
  doc "Whether holder is an Element, whether it has an attribute class without a namespace, and the span of that attribute's value, within the document's text.";
  let no = False();
  let yes = True();
  let none = TextSpan(start: 0_u32, end: 0_u32);
  let at = cvt::<u32, u64>(holder.index);
  if at < document^.nodes.inner.len {
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Element(namespace: space, local_name: name, attributes: list, template_contents: contents) => {
        let count = list^.inner.len;
        for (k in 0_u64..count) {
          let held = list^.inner[k];
          let plain_space = AttributeNamespace::NoNamespace();
          let plain = eeq(held.namespace, plain_space);
          let named = held.name.index == class_atom;
          let same = band(plain, named);
          if same {
            let start = cvt::<u32, u64>(held.value.start);
            let end = cvt::<u32, u64>(held.value.end);
            let ordered = start <= end;
            let inside = end <= document^.text.inner.len;
            let usable = band(ordered, inside);
            if usable {
              return yes, yes, held.value;
            }
            return yes, no, none;
          }
        }
        return yes, no, none;
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return no, no, none;
}

fn put_without_token(buffer: &Box<Slots<u8>>, value: &[u8], token: &[u8]) -> found: Bool reads(value), reads(token), writes(buffer) {
  doc "Appends value without its last whole token equal to token, and the space before it (the space after it for a first token); False, with nothing appended, when value has no such token. A token is a run between spaces.";
  let length = value^.len;
  let size = token^.len;
  if size == 0_u64 {
    return False();
  }
  let best = length;
  let seen = False();
  for (start in 0_u64..length) {
    let end = start +sat size;
    if end <= length {
      let before_ok = if start == 0_u64 {
        give True();
      } else {
        let previous = start - 1_u64;
        give value^[previous] == 32_u8;
      }
      let after_ok = if end == length {
        give True();
      } else {
        give value^[end] == 32_u8;
      }
      let edges = band(before_ok, after_ok);
      if edges {
        let same = True();
        for (k in 0_u64..size) {
          let at = start +sat k;
          if at < length {
            if value^[at] != token^[k] {
              set same = False();
            }
          }
        }
        if same {
          set best = start;
          set seen = True();
        }
      }
    }
  }
  if seen {
  } else {
    return False();
  }
  let end = best +sat size;
  let cut_start = if best > 0_u64 {
    give best - 1_u64;
  } else {
    give best;
  }
  let cut_end = if best > 0_u64 {
    give end;
  } else {
    let after = end +sat 1_u64;
    give imin(after, length);
  }
  if cut_start <= cut_end {
    if cut_end <= length {
      put_text(buffer: buffer, text: &value^[0_u64..cut_start]);
      put_text(buffer: buffer, text: &value^[cut_end..length]);
      return True();
    }
  }
  return False();
}

fn edit_class(document: &Document, holder: NodeId, class_atom: u32, token: &[u8], add: Bool) -> ok: Bool reads(token), writes(document) {
  doc "Adds token to the class attribute of the Element holder, after the other tokens and creating the attribute when it has none, or removes it from there; False when holder is no Element, when a removed token is not in the class attribute, or when the attribute cannot be stored.";
  let (is_element, has_class, span) = class_span(document: document, holder: holder, class_atom: class_atom);
  if is_element {
  } else {
    return False();
  }
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let scratch = box_slots_new::<u8>(capacity: 256_u64);
  if add {
    if has_class {
      if start < end {
        if end <= document^.text.inner.len {
          put_text(buffer: &scratch, text: &document^.text.inner[start..end]);
          put_byte(buffer: &scratch, value: 32_u8);
        }
      }
    }
    put_text(buffer: &scratch, text: token);
  } else {
    if has_class {
    } else {
      return False();
    }
    let removed = if start <= end {
      if end <= document^.text.inner.len {
        give put_without_token(buffer: &scratch, value: &document^.text.inner[start..end], token: token);
      } else {
        give False();
      }
    } else {
      give False();
    }
    if removed {
    } else {
      return False();
    }
  }
  let size = scratch.inner.len;
  if size > 1073741824_u64 {
    return False();
  }
  match store_text(document: document, text: &scratch.inner[0_u64..size]) {
    Ok(value: stored) => {
      let plain = AttributeNamespace::NoNamespace();
      let name = Atom(index: class_atom);
      let attribute = Attribute(namespace: plain, name: name, value: stored);
      match set_attribute(document: document, element: holder, attribute: attribute) {
        Ok(..) => {
          return True();
        }
        Err(..) => {
          return False();
        }
      }
    }
    Err(..) => {
      return False();
    }
  }
}

fn class_index(atoms: &AtomTable) -> index: u32 writes(atoms) {
  doc "The atom of the attribute name class, or 4294967295 when the table refuses it, which no attribute carries.";
  match atom_intern(table: atoms, name: &class_name[0_u64..class_name.len]) {
    Ok(value: found) => {
      return found.index;
    }
    Err(..) => {
      return 4294967295_u32;
    }
  }
}

fn make_paragraph(page: &Page, parent: NodeId, before: Option<NodeId>, text: &[u8]) -> result: Result<NodeId, DomError> reads(text), writes(page) contract {
  requires text^.len <= 1073741824_u64;
} {
  doc "Creates an HTML p element holding one Text node of text and inserts it into parent before the node before names, or at the end when there is none.";
  let name = match atom_intern(table: &page^.atoms, name: &paragraph_name[0_u64..paragraph_name.len]) {
    Ok(value: found) => {
      give found;
    }
    Err(..) => {
      let refused = DomError::TooLarge();
      return Err<NodeId, DomError>(error: refused);
    }
  }
  let attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  let no_template = None<NodeId>();
  let html_space = Namespace::Html();
  let element_data = NodeData::Element(namespace: html_space, local_name: name, attributes: move attributes, template_contents: no_template);
  let paragraph = propagate create_node(document: &page^.document, data: move element_data);
  let stored = propagate store_text(document: &page^.document, text: text);
  let text_data = NodeData::Text(data: stored);
  let words = propagate create_node(document: &page^.document, data: move text_data);
  let filled = propagate append_child(document: &page^.document, parent: paragraph, child: words);
  match before {
    Some(value: reference) => {
      let placed = propagate insert_before(document: &page^.document, parent: parent, child: paragraph, reference: reference);
    }
    None() => {
      let placed = propagate append_child(document: &page^.document, parent: parent, child: paragraph);
    }
  }
  return Ok<NodeId, DomError>(value: paragraph);
}

fn apply_edit(page: &Page, line: &[u8], report: &Box<Slots<u8>>) -> ok: Bool reads(line), writes(page), writes(report) {
  doc "Applies the edit line spells to the live document: T inserts text, D deletes text, C and K add and remove a class token, B inserts a paragraph (and appends `created NODE` to report), X detaches a node. False when the line does not parse or the operation is refused.";
  let length = line^.len;
  if length < 3_u64 {
    return False();
  }
  let kind = line^[0_u64];
  let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
  if node_found {
  } else {
    return False();
  }
  let node_option = node_id_of(value: node_value);
  let node = match node_option {
    Some(value: found) => {
      give found;
    }
    None() => {
      return False();
    }
  }
  if kind == 88_u8 {
    match detach(document: &page^.document, node: node) {
      Ok(..) => {
        return True();
      }
      Err(..) => {
        return False();
      }
    }
  }
  if after_node > length {
    return False();
  }
  if kind == 84_u8 {
    let (offset_found, offset, after_offset) = read_number(line: line, start: after_node);
    if offset_found {
    } else {
      return False();
    }
    if after_offset > length {
      return False();
    }
    let scratch = box_slots_new::<u8>(capacity: 256_u64);
    put_unescaped(buffer: &scratch, text: &line^[after_offset..length]);
    let size = scratch.inner.len;
    let done = splice_text(document: &page^.document, node: node, offset: offset, removed: 0_u64, inserted: &scratch.inner[0_u64..size]);
    return done;
  }
  if kind == 68_u8 {
    let (offset_found, offset, after_offset) = read_number(line: line, start: after_node);
    if offset_found {
    } else {
      return False();
    }
    let (count_found, count, after_count) = read_number(line: line, start: after_offset);
    if count_found {
    } else {
      return False();
    }
    let empty = box_slots_new::<u8>(capacity: 0_u64);
    let done = splice_text(document: &page^.document, node: node, offset: offset, removed: count, inserted: &empty.inner[0_u64..0_u64]);
    return done;
  }
  if kind == 67_u8 {
    let class_atom = class_index(atoms: &page^.atoms);
    let adding = True();
    let done = edit_class(document: &page^.document, holder: node, class_atom: class_atom, token: &line^[after_node..length], add: adding);
    return done;
  }
  if kind == 75_u8 {
    let class_atom = class_index(atoms: &page^.atoms);
    let adding = False();
    let done = edit_class(document: &page^.document, holder: node, class_atom: class_atom, token: &line^[after_node..length], add: adding);
    return done;
  }
  if kind == 66_u8 {
    if after_node >= length {
      return False();
    }
    let before_option = if line^[after_node] == 45_u8 {
      give None<NodeId>();
    } else {
      let (before_found, before_value, unused_next) = read_number(line: line, start: after_node);
      if before_found {
        give node_id_of(value: before_value);
      } else {
        give None<NodeId>();
      }
    }
    let wanted_before = line^[after_node] != 45_u8;
    let resolved = match before_option {
      Some(value: reference) => {
        give True();
      }
      None() => {
        give False();
      }
    }
    if wanted_before {
      if resolved {
      } else {
        return False();
      }
    }
    let text_gap = field_end(line: line, start: after_node);
    let text_start = text_gap +sat 1_u64;
    if text_start > length {
      return False();
    }
    let scratch = box_slots_new::<u8>(capacity: 256_u64);
    put_unescaped(buffer: &scratch, text: &line^[text_start..length]);
    let size = scratch.inner.len;
    if size > 1073741824_u64 {
      return False();
    }
    match make_paragraph(page: page, parent: node, before: before_option, text: &scratch.inner[0_u64..size]) {
      Ok(value: made) => {
        put_text(buffer: report, text: &created_label[0_u64..created_label.len]);
        let wide = cvt::<u32, u64>(made.index);
        put_decimal(buffer: report, value: wide);
        put_byte(buffer: report, value: 10_u8);
        return True();
      }
      Err(..) => {
        return False();
      }
    }
  }
  return False();
}

fn put_failure(report: &Box<Slots<u8>>, number: u64, reason: &[u8]) -> result: unit reads(reason), writes(report) {
  doc "Appends `edit script line NUMBER refused: REASON` to report.";
  put_text(buffer: report, text: &line_label[0_u64..line_label.len]);
  put_decimal(buffer: report, value: number);
  put_text(buffer: report, text: &refused_label[0_u64..refused_label.len]);
  put_text(buffer: report, text: reason);
  return unit;
}

fn collect_script(page: &Page, environment: Environment, script: &[u8], dumps: &Box<Slots<u64>>, report: &Box<Slots<u8>>) -> ok: Bool reads(script), writes(page), writes(dumps), writes(report) {
  doc "The first pass over the script: each S line adds its text as an author style sheet, which must come before the first edit, and each P line lists an edit number in dumps. Every other line must be empty or an edit (T, D, C, K, B or X).";
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edited = False();
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return False();
    }
    if start < end {
      let kind = script^[start];
      let body = start +sat 2_u64;
      if kind == 83_u8 {
        if edited {
          put_failure(report: report, number: number, reason: &sheet_late_reason[0_u64..sheet_late_reason.len]);
          return False();
        }
        if body <= end {
          let width = end - body;
          if width > 16777216_u64 {
            put_failure(report: report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
            return False();
          }
          match add_sheet(store: &page^.store, source: &script^[body..end], origin: origin_author, environment: environment, atoms: &page^.atoms) {
            Ok(..) => {
            }
            Err(..) => {
              put_failure(report: report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
              return False();
            }
          }
        }
      } else if kind == 80_u8 {
        let (found, wanted, unused_next) = read_number(line: &script^[start..end], start: 2_u64);
        if found {
          put_u64(cell: dumps, value: wanted);
        } else {
          put_failure(report: report, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          return False();
        }
      } else {
        let is_t = kind == 84_u8;
        let is_d = kind == 68_u8;
        let is_c = kind == 67_u8;
        let is_k = kind == 75_u8;
        let is_b = kind == 66_u8;
        let is_x = kind == 88_u8;
        let first = bor(is_t, is_d);
        let second = bor(is_c, is_k);
        let third = bor(is_b, is_x);
        let early = bor(first, second);
        let known = bor(early, third);
        if known {
          set edited = True();
        } else {
          put_failure(report: report, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          return False();
        }
      }
    }
  }
  return True();
}

fn put_u64(cell: &Box<Slots<u64>>, value: u64) -> result: unit writes(cell) {
  doc "Appends value, doubling the window when full.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity *sat 2_u64;
    let wanted = imax(doubled, 16_u64);
    let bounded = imin(wanted, 1073741824_u64);
    if bounded <= length {
      return unit;
    }
    grow(cell: cell, capacity: bounded);
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn requested(dumps: &Box<Slots<u64>>, number: u64) -> found: Bool reads(dumps) {
  doc "Whether a P line asked for the dump of edit number.";
  let count = dumps^.inner.len;
  for (k in 0_u64..count) {
    if dumps^.inner[k] == number {
      return True();
    }
  }
  return False();
}

fn report_dump(buffer: &Box<Slots<u8>>, dump: &Box<Slots<u8>>, label: &[u8], number: u64, print: Bool) -> hash: u64 reads(label), writes(buffer), writes(dump) {
  doc "Appends `LABEL NUMBER hash H bytes N` to buffer for the bytes dump holds, H being their FNV-1a hash in 16 hexadecimal digits, followed by the bytes themselves when print holds; empties dump. The base line has no number, which label spells as `base hash `.";
  let size = dump^.inner.len;
  let hashed = fnv1a(bytes: &dump^.inner[0_u64..size]);
  put_text(buffer: buffer, text: label);
  if number != 18446744073709551615_u64 {
    put_decimal(buffer: buffer, value: number);
    put_text(buffer: buffer, text: &hash_label[0_u64..hash_label.len]);
  }
  let lowercase = False();
  put_hex(buffer: buffer, value: hashed, width: 16_u64, uppercase: lowercase);
  put_text(buffer: buffer, text: &bytes_label[0_u64..bytes_label.len]);
  put_decimal(buffer: buffer, value: size);
  put_byte(buffer: buffer, value: 10_u8);
  if print {
    put_text(buffer: buffer, text: &dump^.inner[0_u64..size]);
  }
  truncate(buffer: dump, length: 0_u64);
  return hashed;
}

fn run_edits(page: &Page, fonts: &FontSet, environment: Environment, viewport: Viewport, script: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(fonts), reads(script), writes(page), writes(out), writes(err), writes(files) waits {
  doc "Runs an edit script on the live document of page: it applies the S lines, runs the whole pipeline on the unedited document and reports `base hash H bytes N`, then applies each edit and reports `edit I hash H bytes N`, I counting the edits from 1, after rerunning the whole pipeline; a P line requests the full dump of that edit (0 for the unedited document), which follows its hash line. Returns 0, or 2 after naming the failing line on err.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let dump = box_slots_new::<u8>(capacity: 65536_u64);
  let dumps = box_slots_new::<u64>(capacity: 16_u64);
  let collected = collect_script(page: page, environment: environment, script: script, dumps: &dumps, report: &report);
  if collected {
  } else {
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  let stage = rebuild_dump(page: page, fonts: fonts, environment: environment, viewport: viewport, buffer: &dump);
  if stage == 0_u8 {
  } else {
    let code = stage_failure(err: err, files: files, stage: stage);
    return code;
  }
  let print_base = requested(dumps: &dumps, number: 0_u64);
  let no_number = 18446744073709551615_u64;
  let base_hash = report_dump(buffer: &report, dump: &dump, label: &base_label[0_u64..base_label.len], number: no_number, print: print_base);
  let written = flush(factory: files, output: out, buffer: &report);
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edits = 0_u64;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return 2_u8;
    }
    if start < end {
      let kind = script^[start];
      let skipped_s = kind == 83_u8;
      let skipped_p = kind == 80_u8;
      let skipped = bor(skipped_s, skipped_p);
      if skipped {
      } else {
        set edits = edits +sat 1_u64;
        let applied = apply_edit(page: page, line: &script^[start..end], report: &report);
        if applied {
        } else {
          put_failure(report: &report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &report);
          return 2_u8;
        }
        let rebuilt = rebuild_dump(page: page, fonts: fonts, environment: environment, viewport: viewport, buffer: &dump);
        if rebuilt == 0_u8 {
        } else {
          put_failure(report: &report, number: number, reason: &render_reason[0_u64..render_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &report);
          let code = stage_failure(err: err, files: files, stage: rebuilt);
          return code;
        }
        let print = requested(dumps: &dumps, number: edits);
        let hashed = report_dump(buffer: &report, dump: &dump, label: &edit_label[0_u64..edit_label.len], number: edits, print: print);
        let flushed = flush(factory: files, output: out, buffer: &report);
        if flushed {
        } else {
          return 2_u8;
        }
      }
    }
  }
  return 0_u8;
}

fn list_nodes(page: &Page, buffer: &Box<Slots<u8>>) -> listed: Bool reads(page), writes(buffer) {
  doc "Appends, for each element and Text node in tree order, an E line `E NODE DEPTH NAME DESCENDANTS INDEX` (DEPTH counting the element ancestors, DESCENDANTS the elements below, INDEX the position in the traversal) or a T line `T NODE PARENT LENGTH DATA` with backslash and line feed escaped, then the line `N COUNT` with the number of nodes the document holds, which are the identifiers a later insertion takes. False when the document is too large to number.";
  let nodes = page^.document.nodes.inner.len;
  let count = page^.traversal.elements.inner.len;
  let small = count < 4294967295_u64;
  let few_nodes = nodes < 1073741824_u64;
  let usable = band(small, few_nodes);
  if usable {
  } else {
    return False();
  }
  let element_of = box_array_filled::<u32>(count: nodes, value: 4294967295_u32);
  let depths = box_array_filled::<u64>(count: count, value: 0_u64);
  let below = box_array_filled::<u64>(count: count, value: 0_u64);
  for (i in 0_u64..count) {
    let node = page^.traversal.elements.inner[i];
    let at = cvt::<u32, u64>(node.index);
    if at < element_of.inner.len {
      set element_of.inner[at] = cvt::<u64, u32>(i);
    }
    if i < page^.traversal.parents.inner.len {
      let parent = cvt::<u32, u64>(page^.traversal.parents.inner[i]);
      if parent < i {
        if i < depths.inner.len {
          set depths.inner[i] = depths.inner[parent] +sat 1_u64;
        }
      }
    }
  }
  for (step in 0_u64..count) {
    let remaining = count -sat step;
    let i = remaining -sat 1_u64;
    if i < page^.traversal.parents.inner.len {
      let parent = cvt::<u32, u64>(page^.traversal.parents.inner[i]);
      if parent < i {
        if i < below.inner.len {
          let contribution = below.inner[i] +sat 1_u64;
          set below.inner[parent] = below.inner[parent] +sat contribution;
        }
      }
    }
  }
  let stack = box_slots_new::<NodeId>(capacity: 64_u64);
  if 0_u64 < nodes {
    let root_child = page^.document.nodes.inner[0_u64].links.first_child;
    match root_child {
      Some(value: first) => {
        let pushed = push_node(stack: &stack, node: first);
      }
      None() => {
      }
    }
  }
  for (step in 0_u64..nodes) {
    let depth = stack.inner.len;
    if depth == 0_u64 {
      break;
    }
    let node = take_back(window: &stack.inner);
    let at = cvt::<u32, u64>(node.index);
    if at < nodes {
      let sibling_link = page^.document.nodes.inner[at].links.next_sibling;
      match sibling_link {
        Some(value: sibling) => {
          let pushed = push_node(stack: &stack, node: sibling);
        }
        None() => {
        }
      }
      let index = cvt::<u32, u64>(element_of.inner[at]);
      let span_option = text_span_at(document: &page^.document, node: node);
      if index < count {
        put_text(buffer: buffer, text: &element_label[0_u64..element_label.len]);
        put_decimal(buffer: buffer, value: at);
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: depths.inner[index]);
        put_byte(buffer: buffer, value: 32_u8);
        put_name(buffer: buffer, atoms: &page^.atoms, document: &page^.document, node: node);
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: below.inner[index]);
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: index);
        put_byte(buffer: buffer, value: 10_u8);
      }
      match span_option {
        Some(value: span) => {
          let start = cvt::<u32, u64>(span.start);
          let end = cvt::<u32, u64>(span.end);
          let parent_link = page^.document.nodes.inner[at].links.parent;
          let parent_index = match parent_link {
            Some(value: parent) => {
              give cvt::<u32, u64>(parent.index);
            }
            None() => {
              give 0_u64;
            }
          }
          put_text(buffer: buffer, text: &text_label[0_u64..text_label.len]);
          put_decimal(buffer: buffer, value: at);
          put_byte(buffer: buffer, value: 32_u8);
          put_decimal(buffer: buffer, value: parent_index);
          put_byte(buffer: buffer, value: 32_u8);
          let size = end -sat start;
          put_decimal(buffer: buffer, value: size);
          put_byte(buffer: buffer, value: 32_u8);
          if start <= end {
            if end <= page^.document.text.inner.len {
              put_escaped(buffer: buffer, text: &page^.document.text.inner[start..end]);
            }
          }
          put_byte(buffer: buffer, value: 10_u8);
        }
        None() => {
        }
      }
      let child_link = page^.document.nodes.inner[at].links.first_child;
      match child_link {
        Some(value: child) => {
          let pushed = push_node(stack: &stack, node: child);
        }
        None() => {
        }
      }
    }
  }
  put_text(buffer: buffer, text: &arena_label[0_u64..arena_label.len]);
  put_decimal(buffer: buffer, value: nodes);
  put_byte(buffer: buffer, value: 10_u8);
  return True();
}
