struct StyleUpdate {
  doc "Whether a style edit was retained and its layout-boundary time in microseconds, excluding compute_styles.";
  applied: Bool;
  micros: u64;
}

struct Built {
  doc "One run of the pipeline after the traversal: the kept style state, whose styles the layout reads, the font picks and the laid-out layout.";
  state: StyleState;
  picks: FontPicks;
  layout: Layout;
}

fn fnv1a(bytes: &[u8]) -> hash: u64 reads(bytes) {
  doc "The 64-bit FNV-1a hash of bytes.";
  let state = fnv_basis;
  let length = bytes^.len;
  for (at in 0_u64..length) {
    let byte = cvt::<u8, u64>(bytes^[at]);
    let mixed = ixor(state, byte);
    set state = mixed *wrap fnv_prime;
  }
  return state;
}

fn field_end(line: &[u8], start: u64) -> end: u64 reads(line) {
  doc "The index of the first space at or after start in line, or the length of line when there is none.";
  let length = line^.len;
  if start >= length {
    return length;
  }
  for (at in start..length) {
    if line^[at] == 32_u8 {
      return at;
    }
  }
  return length;
}

fn read_number(line: &[u8], start: u64) -> (found: Bool, value: u64, next: u64) reads(line) {
  doc "Parses the field of line that starts at start as a decimal number, and returns where the next field starts, past the space that ends this one.";
  let length = line^.len;
  let no = False();
  let yes = True();
  if start >= length {
    return no, 0_u64, length;
  }
  let end = field_end(line: line, start: start);
  match parse_decimal(text: line, start: start, end: end) {
    Some(value: number) => {
      let next = end +sat 1_u64;
      return yes, number, next;
    }
    None() => {
      return no, 0_u64, length;
    }
  }
}

fn node_id_of(value: u64) -> node: Option<NodeId> pure {
  doc "The node identifier with index value, or None when value does not fit one.";
  if value < 4294967295_u64 {
    let index = cvt::<u64, u32>(value);
    let id = NodeId(index: index);
    return Some<NodeId>(value: id);
  }
  return None<NodeId>();
}

fn put_unescaped(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) {
  doc "Appends text with each backslash pair resolved: `\\\\` is a backslash and `\\n` a line feed; a backslash before any other byte stays.";
  let length = text^.len;
  let skip = False();
  for (at in 0_u64..length) {
    if skip {
      set skip = False();
    } else {
      let byte = text^[at];
      let next = at +sat 1_u64;
      if byte == 92_u8 {
        if next < length {
          let following = text^[next];
          if following == 92_u8 {
            put_byte(buffer: buffer, value: 92_u8);
            set skip = True();
          } else if following == 110_u8 {
            put_byte(buffer: buffer, value: 10_u8);
            set skip = True();
          } else {
            put_byte(buffer: buffer, value: byte);
          }
        } else {
          put_byte(buffer: buffer, value: byte);
        }
      } else {
        put_byte(buffer: buffer, value: byte);
      }
    }
  }
  return unit;
}

fn put_escaped(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) {
  doc "Appends text with each backslash written as two and each line feed as a backslash and n.";
  let length = text^.len;
  for (at in 0_u64..length) {
    let byte = text^[at];
    if byte == 92_u8 {
      put_byte(buffer: buffer, value: 92_u8);
      put_byte(buffer: buffer, value: 92_u8);
    } else if byte == 10_u8 {
      put_byte(buffer: buffer, value: 92_u8);
      put_byte(buffer: buffer, value: 110_u8);
    } else {
      put_byte(buffer: buffer, value: byte);
    }
  }
  return unit;
}

fn text_span_at(document: &Document, node: NodeId) -> span: Option<TextSpan> reads(document) {
  doc "The data span of the Text node, within the document's text, or None for any other node.";
  let at = cvt::<u32, u64>(node.index);
  if at < document^.nodes.inner.len {
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Text(data: found) => {
        let held = found^;
        let start = cvt::<u32, u64>(held.start);
        let end = cvt::<u32, u64>(held.end);
        let ordered = start <= end;
        let inside = end <= document^.text.inner.len;
        let usable = band(ordered, inside);
        if usable {
          return Some<TextSpan>(value: held);
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Element(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return None<TextSpan>();
}

fn splice_bytes(old: &[u8], offset: u64, removed: u64, inserted: &[u8], scratch: &Box<Slots<u8>>) -> ok: Bool reads(old), reads(inserted), writes(scratch) {
  doc "Appends to scratch the bytes of old with removed bytes at offset replaced by inserted; False, with nothing appended, when the removed range is not inside old.";
  let length = old^.len;
  if offset > length {
    return False();
  }
  let rest = offset +sat removed;
  if rest > length {
    return False();
  }
  put_text(buffer: scratch, text: &old^[0_u64..offset]);
  put_text(buffer: scratch, text: inserted);
  put_text(buffer: scratch, text: &old^[rest..length]);
  return True();
}

fn splice_text(document: &Document, node: NodeId, offset: u64, removed: u64, inserted: &[u8]) -> ok: Bool reads(inserted), writes(document) {
  doc "Replaces removed bytes at offset of the Text node's data with inserted: the new data is stored and set_text points the node at it.";
  match text_span_at(document: document, node: node) {
    Some(value: span) => {
      let start = cvt::<u32, u64>(span.start);
      let end = cvt::<u32, u64>(span.end);
      let scratch = box_slots_new::<u8>(capacity: 1024_u64);
      let spliced = if start <= end {
        if end <= document^.text.inner.len {
          give splice_bytes(old: &document^.text.inner[start..end], offset: offset, removed: removed, inserted: inserted, scratch: &scratch);
        } else {
          give False();
        }
      } else {
        give False();
      }
      if spliced {
      } else {
        return False();
      }
      let size = scratch.inner.len;
      if size > 1073741824_u64 {
        return False();
      }
      match store_text(document: document, text: &scratch.inner[0_u64..size]) {
        Ok(value: stored) => {
          match set_text(document: document, node: node, data: stored) {
            Ok(..) => {
              return True();
            }
            Err(..) => {
              return False();
            }
          }
        }
        Err(..) => {
          return False();
        }
      }
    }
    None() => {
      return False();
    }
  }
}

fn class_span(document: &Document, holder: NodeId, class_atom: u32) -> (is_element: Bool, has_class: Bool, span: TextSpan) reads(document) {
  doc "Whether holder is an Element, whether it has an attribute class without a namespace, and the span of that attribute's value, within the document's text.";
  let no = False();
  let yes = True();
  let none = TextSpan(start: 0_u32, end: 0_u32);
  let at = cvt::<u32, u64>(holder.index);
  if at < document^.nodes.inner.len {
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Element(namespace: space, local_name: name, attributes: list, template_contents: contents) => {
        let count = list^.inner.len;
        for (k in 0_u64..count) {
          let held = list^.inner[k];
          let plain_space = AttributeNamespace::NoNamespace();
          let plain = eeq(held.namespace, plain_space);
          let named = held.name.index == class_atom;
          let same = band(plain, named);
          if same {
            let start = cvt::<u32, u64>(held.value.start);
            let end = cvt::<u32, u64>(held.value.end);
            let ordered = start <= end;
            let inside = end <= document^.text.inner.len;
            let usable = band(ordered, inside);
            if usable {
              return yes, yes, held.value;
            }
            return yes, no, none;
          }
        }
        return yes, no, none;
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return no, no, none;
}

fn put_without_token(buffer: &Box<Slots<u8>>, value: &[u8], token: &[u8]) -> found: Bool reads(value), reads(token), writes(buffer) {
  doc "Appends value without its last whole token equal to token, and the space before it (the space after it for a first token); False, with nothing appended, when value has no such token. A token is a run between spaces.";
  let length = value^.len;
  let size = token^.len;
  if size == 0_u64 {
    return False();
  }
  let best = length;
  let seen = False();
  for (start in 0_u64..length) {
    let end = start +sat size;
    if end <= length {
      let before_ok = if start == 0_u64 {
        give True();
      } else {
        let previous = start - 1_u64;
        give value^[previous] == 32_u8;
      }
      let after_ok = if end == length {
        give True();
      } else {
        give value^[end] == 32_u8;
      }
      let edges = band(before_ok, after_ok);
      if edges {
        let same = True();
        for (k in 0_u64..size) {
          let at = start +sat k;
          if at < length {
            if value^[at] != token^[k] {
              set same = False();
            }
          }
        }
        if same {
          set best = start;
          set seen = True();
        }
      }
    }
  }
  if seen {
  } else {
    return False();
  }
  let end = best +sat size;
  let cut_start = if best > 0_u64 {
    give best - 1_u64;
  } else {
    give best;
  }
  let cut_end = if best > 0_u64 {
    give end;
  } else {
    let after = end +sat 1_u64;
    give imin(after, length);
  }
  if cut_start <= cut_end {
    if cut_end <= length {
      put_text(buffer: buffer, text: &value^[0_u64..cut_start]);
      put_text(buffer: buffer, text: &value^[cut_end..length]);
      return True();
    }
  }
  return False();
}

fn edit_class(document: &Document, holder: NodeId, class_atom: u32, token: &[u8], add: Bool) -> ok: Bool reads(token), writes(document) {
  doc "Adds token to the class attribute of the Element holder, after the other tokens and creating the attribute when it has none, or removes it from there; False when holder is no Element, when a removed token is not in the class attribute, or when the attribute cannot be stored.";
  let (is_element, has_class, span) = class_span(document: document, holder: holder, class_atom: class_atom);
  if is_element {
  } else {
    return False();
  }
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let scratch = box_slots_new::<u8>(capacity: 256_u64);
  if add {
    if has_class {
      if start < end {
        if end <= document^.text.inner.len {
          put_text(buffer: &scratch, text: &document^.text.inner[start..end]);
          put_byte(buffer: &scratch, value: 32_u8);
        }
      }
    }
    put_text(buffer: &scratch, text: token);
  } else {
    if has_class {
    } else {
      return False();
    }
    let removed = if start <= end {
      if end <= document^.text.inner.len {
        give put_without_token(buffer: &scratch, value: &document^.text.inner[start..end], token: token);
      } else {
        give False();
      }
    } else {
      give False();
    }
    if removed {
    } else {
      return False();
    }
  }
  let size = scratch.inner.len;
  if size > 1073741824_u64 {
    return False();
  }
  match store_text(document: document, text: &scratch.inner[0_u64..size]) {
    Ok(value: stored) => {
      let plain = AttributeNamespace::NoNamespace();
      let name = Atom(index: class_atom);
      let attribute = Attribute(namespace: plain, name: name, value: stored);
      match set_attribute(document: document, element: holder, attribute: attribute) {
        Ok(..) => {
          return True();
        }
        Err(..) => {
          return False();
        }
      }
    }
    Err(..) => {
      return False();
    }
  }
}

fn class_index(atoms: &AtomTable) -> index: u32 writes(atoms) {
  doc "The atom of the attribute name class, or 4294967295 when the table refuses it, which no attribute carries.";
  match atom_intern(table: atoms, name: &class_name[0_u64..class_name.len]) {
    Ok(value: found) => {
      return found.index;
    }
    Err(..) => {
      return 4294967295_u32;
    }
  }
}

fn make_paragraph(page: &Page, parent: NodeId, before: Option<NodeId>, text: &[u8]) -> result: Result<NodeId, DomError> reads(text), writes(page) contract {
  requires text^.len <= 1073741824_u64;
} {
  doc "Creates an HTML p element holding one Text node of text and inserts it into parent before the node before names, or at the end when there is none.";
  let name = match atom_intern(table: &page^.atoms, name: &paragraph_name[0_u64..paragraph_name.len]) {
    Ok(value: found) => {
      give found;
    }
    Err(..) => {
      let refused = DomError::TooLarge();
      return Err<NodeId, DomError>(error: refused);
    }
  }
  let attributes = box_slots_new::<Attribute>(capacity: 0_u64);
  let no_template = None<NodeId>();
  let html_space = Namespace::Html();
  let element_data = NodeData::Element(namespace: html_space, local_name: name, attributes: move attributes, template_contents: no_template);
  let paragraph = propagate create_node(document: &page^.document, data: move element_data);
  let stored = propagate store_text(document: &page^.document, text: text);
  let text_data = NodeData::Text(data: stored);
  let words = propagate create_node(document: &page^.document, data: move text_data);
  let filled = propagate append_child(document: &page^.document, parent: paragraph, child: words);
  match before {
    Some(value: reference) => {
      let placed = propagate insert_before(document: &page^.document, parent: parent, child: paragraph, reference: reference);
    }
    None() => {
      let placed = propagate append_child(document: &page^.document, parent: parent, child: paragraph);
    }
  }
  return Ok<NodeId, DomError>(value: paragraph);
}

fn structure_neighbours(page: &Page, line: &[u8]) -> (previous: Option<NodeId>, next: Option<NodeId>) reads(page), reads(line) {
  doc "The children of the edited parent on either side of a B or X line's edit point, read before the edit: X's node's previous and next siblings; B's BEFORE and the child before it, or the parent's last child when BEFORE is -. Both None for any other line or a node the document does not hold.";
  let nothing = None<NodeId>();
  let length = line^.len;
  if length < 3_u64 {
    return nothing, nothing;
  }
  let kind = line^[0_u64];
  let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
  if node_found {
  } else {
    return nothing, nothing;
  }
  let node = match node_id_of(value: node_value) {
    Some(value: found) => {
      give found;
    }
    None() => {
      return nothing, nothing;
    }
  }
  let at = cvt::<u32, u64>(node.index);
  if at < page^.document.nodes.inner.len {
  } else {
    return nothing, nothing;
  }
  let links = page^.document.nodes.inner[at].links;
  if kind == 88_u8 {
    return links.previous_sibling, links.next_sibling;
  }
  if kind == 66_u8 {
  } else {
    return nothing, nothing;
  }
  if after_node >= length {
    return nothing, nothing;
  }
  if line^[after_node] == 45_u8 {
    return links.last_child, nothing;
  }
  let (before_found, before_value, unused_next) = read_number(line: line, start: after_node);
  if before_found {
  } else {
    return nothing, nothing;
  }
  match node_id_of(value: before_value) {
    Some(value: before) => {
      let before_at = cvt::<u32, u64>(before.index);
      if before_at < page^.document.nodes.inner.len {
        let before_links = page^.document.nodes.inner[before_at].links;
        let reference = Some<NodeId>(value: before);
        return before_links.previous_sibling, reference;
      }
      return nothing, nothing;
    }
    None() => {
      return nothing, nothing;
    }
  }
}

fn structure_parent(page: &Page, line: &[u8]) -> parent: Option<NodeId> reads(page), reads(line) {
  doc "The element whose children a B or X line changes, read before the edit: B's PARENT, or the parent X's node has in the live document; None for any other line or a node that has no parent.";
  let length = line^.len;
  if length < 3_u64 {
    return None<NodeId>();
  }
  let kind = line^[0_u64];
  let inserting = kind == 66_u8;
  let removing = kind == 88_u8;
  let structural = bor(inserting, removing);
  if structural {
  } else {
    return None<NodeId>();
  }
  let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
  if node_found {
  } else {
    return None<NodeId>();
  }
  let node = match node_id_of(value: node_value) {
    Some(value: found) => {
      give found;
    }
    None() => {
      return None<NodeId>();
    }
  }
  if inserting {
    return Some<NodeId>(value: node);
  }
  let at = cvt::<u32, u64>(node.index);
  if at < page^.document.nodes.inner.len {
    let parent = page^.document.nodes.inner[at].links.parent;
    return parent;
  }
  return None<NodeId>();
}

fn apply_edit(page: &Page, line: &[u8], report: &Box<Slots<u8>>) -> ok: Bool reads(line), writes(page), writes(report) {
  doc "Applies the edit line spells to the live document: T inserts text, D deletes text, C and K add and remove a class token, B inserts a paragraph (and appends `created NODE` to report), X detaches a node. False when the line does not parse or the operation is refused.";
  let length = line^.len;
  if length < 3_u64 {
    return False();
  }
  let kind = line^[0_u64];
  let (node_found, node_value, after_node) = read_number(line: line, start: 2_u64);
  if node_found {
  } else {
    return False();
  }
  let node_option = node_id_of(value: node_value);
  let node = match node_option {
    Some(value: found) => {
      give found;
    }
    None() => {
      return False();
    }
  }
  if kind == 88_u8 {
    match detach(document: &page^.document, node: node) {
      Ok(..) => {
        return True();
      }
      Err(..) => {
        return False();
      }
    }
  }
  if after_node > length {
    return False();
  }
  if kind == 84_u8 {
    let (offset_found, offset, after_offset) = read_number(line: line, start: after_node);
    if offset_found {
    } else {
      return False();
    }
    if after_offset > length {
      return False();
    }
    let scratch = box_slots_new::<u8>(capacity: 256_u64);
    put_unescaped(buffer: &scratch, text: &line^[after_offset..length]);
    let size = scratch.inner.len;
    let done = splice_text(document: &page^.document, node: node, offset: offset, removed: 0_u64, inserted: &scratch.inner[0_u64..size]);
    return done;
  }
  if kind == 68_u8 {
    let (offset_found, offset, after_offset) = read_number(line: line, start: after_node);
    if offset_found {
    } else {
      return False();
    }
    let (count_found, count, after_count) = read_number(line: line, start: after_offset);
    if count_found {
    } else {
      return False();
    }
    let empty = box_slots_new::<u8>(capacity: 0_u64);
    let done = splice_text(document: &page^.document, node: node, offset: offset, removed: count, inserted: &empty.inner[0_u64..0_u64]);
    return done;
  }
  if kind == 67_u8 {
    let class_atom = class_index(atoms: &page^.atoms);
    let adding = True();
    let done = edit_class(document: &page^.document, holder: node, class_atom: class_atom, token: &line^[after_node..length], add: adding);
    return done;
  }
  if kind == 75_u8 {
    let class_atom = class_index(atoms: &page^.atoms);
    let adding = False();
    let done = edit_class(document: &page^.document, holder: node, class_atom: class_atom, token: &line^[after_node..length], add: adding);
    return done;
  }
  if kind == 66_u8 {
    if after_node >= length {
      return False();
    }
    let before_option = if line^[after_node] == 45_u8 {
      give None<NodeId>();
    } else {
      let (before_found, before_value, unused_next) = read_number(line: line, start: after_node);
      if before_found {
        give node_id_of(value: before_value);
      } else {
        give None<NodeId>();
      }
    }
    let wanted_before = line^[after_node] != 45_u8;
    let resolved = match before_option {
      Some(value: reference) => {
        give True();
      }
      None() => {
        give False();
      }
    }
    if wanted_before {
      if resolved {
      } else {
        return False();
      }
    }
    let text_gap = field_end(line: line, start: after_node);
    let text_start = text_gap +sat 1_u64;
    if text_start > length {
      return False();
    }
    let scratch = box_slots_new::<u8>(capacity: 256_u64);
    put_unescaped(buffer: &scratch, text: &line^[text_start..length]);
    let size = scratch.inner.len;
    if size > 1073741824_u64 {
      return False();
    }
    match make_paragraph(page: page, parent: node, before: before_option, text: &scratch.inner[0_u64..size]) {
      Ok(value: made) => {
        put_text(buffer: report, text: &created_label[0_u64..created_label.len]);
        let wide = cvt::<u32, u64>(made.index);
        put_decimal(buffer: report, value: wide);
        put_byte(buffer: report, value: 10_u8);
        return True();
      }
      Err(..) => {
        return False();
      }
    }
  }
  return False();
}

fn put_failure(report: &Box<Slots<u8>>, number: u64, reason: &[u8]) -> result: unit reads(reason), writes(report) {
  doc "Appends `edit script line NUMBER refused: REASON` to report.";
  put_text(buffer: report, text: &line_label[0_u64..line_label.len]);
  put_decimal(buffer: report, value: number);
  put_text(buffer: report, text: &refused_label[0_u64..refused_label.len]);
  put_text(buffer: report, text: reason);
  return unit;
}

fn collect_script(page: &Page, environment: Environment, script: &[u8], dumps: &Box<Slots<u64>>, report: &Box<Slots<u8>>) -> ok: Bool reads(script), writes(page), writes(dumps), writes(report) {
  doc "The first pass over the script: each S line adds its text as an author style sheet, which must come before the first edit, and each P line lists an edit number in dumps. Every other line must be empty or an edit (T, D, C, K, B or X).";
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edited = False();
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return False();
    }
    if start < end {
      let kind = script^[start];
      let body = start +sat 2_u64;
      if kind == 83_u8 {
        if edited {
          put_failure(report: report, number: number, reason: &sheet_late_reason[0_u64..sheet_late_reason.len]);
          return False();
        }
        if body <= end {
          let width = end - body;
          if width > 16777216_u64 {
            put_failure(report: report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
            return False();
          }
          match add_sheet(store: &page^.store, source: &script^[body..end], origin: origin_author, environment: environment, atoms: &page^.atoms) {
            Ok(..) => {
            }
            Err(..) => {
              put_failure(report: report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
              return False();
            }
          }
        }
      } else if kind == 80_u8 {
        let (found, wanted, unused_next) = read_number(line: &script^[start..end], start: 2_u64);
        if found {
          put_u64(cell: dumps, value: wanted);
        } else {
          put_failure(report: report, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          return False();
        }
      } else {
        let is_t = kind == 84_u8;
        let is_d = kind == 68_u8;
        let is_c = kind == 67_u8;
        let is_k = kind == 75_u8;
        let is_b = kind == 66_u8;
        let is_x = kind == 88_u8;
        let first = bor(is_t, is_d);
        let second = bor(is_c, is_k);
        let third = bor(is_b, is_x);
        let early = bor(first, second);
        let known = bor(early, third);
        if known {
          set edited = True();
        } else {
          put_failure(report: report, number: number, reason: &syntax_reason[0_u64..syntax_reason.len]);
          return False();
        }
      }
    }
  }
  return True();
}

fn put_u64(cell: &Box<Slots<u64>>, value: u64) -> result: unit writes(cell) {
  doc "Appends value, doubling the window when full.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity *sat 2_u64;
    let wanted = imax(doubled, 16_u64);
    let bounded = imin(wanted, 1073741824_u64);
    if bounded <= length {
      return unit;
    }
    grow(cell: cell, capacity: bounded);
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn requested(dumps: &Box<Slots<u64>>, number: u64) -> found: Bool reads(dumps) {
  doc "Whether a P line asked for the dump of edit number.";
  let count = dumps^.inner.len;
  for (k in 0_u64..count) {
    if dumps^.inner[k] == number {
      return True();
    }
  }
  return False();
}

fn report_dump(buffer: &Box<Slots<u8>>, dump: &Box<Slots<u8>>, label: &[u8], number: u64, print: Bool) -> hash: u64 reads(label), writes(buffer), writes(dump) {
  doc "Appends `LABEL NUMBER hash H bytes N` to buffer for the bytes dump holds, H being their FNV-1a hash in 16 hexadecimal digits, followed by the bytes themselves when print holds; empties dump. The base line has no number, which label spells as `base hash `.";
  let size = dump^.inner.len;
  let hashed = fnv1a(bytes: &dump^.inner[0_u64..size]);
  put_text(buffer: buffer, text: label);
  if number != 18446744073709551615_u64 {
    put_decimal(buffer: buffer, value: number);
    put_text(buffer: buffer, text: &hash_label[0_u64..hash_label.len]);
  }
  let lowercase = False();
  put_hex(buffer: buffer, value: hashed, width: 16_u64, uppercase: lowercase);
  put_text(buffer: buffer, text: &bytes_label[0_u64..bytes_label.len]);
  put_decimal(buffer: buffer, value: size);
  put_byte(buffer: buffer, value: 10_u8);
  if print {
    put_text(buffer: buffer, text: &dump^.inner[0_u64..size]);
  }
  truncate(buffer: dump, length: 0_u64);
  return hashed;
}

fn build_page(page: &Page, fonts: &FontSet, environment: Environment, viewport: Viewport, preserve: Bool) -> result: Result<Built, u8> reads(fonts), writes(page) {
  doc "Runs the pipeline on the live document of page up to the laid-out layout: its traversal, the styles, the font matching, the layout's build and lay_out. The refusal is the stage rebuild_dump numbers: 4 the traversal, 5 the styles, 1 the font matching, 2 the layout.";
  let previous = match build_traversal(document: &page^.document) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      return Err<Built, u8>(error: 4_u8);
    }
  }
  swap(first: &page^.traversal, second: &previous);
  let state = match style_state(store: &page^.store, document: &page^.document, atoms: &page^.atoms, traversal: &page^.traversal, environment: environment) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      return Err<Built, u8>(error: 5_u8);
    }
  }
  let picks = match pick_all(fonts: fonts, styles: &state.styles, atoms: &page^.atoms) {
    Some(value: found) => {
      give move found;
    }
    None() => {
      return Err<Built, u8>(error: 1_u8);
    }
  }
  let layout = match build_layout(document: &page^.document, traversal: &page^.traversal, styles: &state.styles, atoms: &page^.atoms, fonts: fonts, picks: &picks, viewport: viewport) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      return Err<Built, u8>(error: 2_u8);
    }
  }
  lay_out(layout: &layout, document: &page^.document, styles: &state.styles, fonts: fonts, picks: &picks);
  if preserve {
    swap(first: &page^.traversal, second: &previous);
  }
  let built = Built(state: move state, picks: move picks, layout: move layout);
  return Ok<Built, u8>(value: move built);
}

fn dump_layout(page: &Page, styles: &Styles, layout: &Layout, buffer: &Box<Slots<u8>>) -> stage: u8 reads(page), reads(styles), reads(layout), writes(buffer) {
  doc "Places the boxes of layout and appends its dump, with the page's traversal and styles, to buffer; 0, or 3 when the dump fails.";
  let placed = place_boxes(layout: layout);
  let placed_count = placed.inner.len;
  let written = write_dump(document: &page^.document, atoms: &page^.atoms, traversal: &page^.traversal, styles: styles, placed: &placed.inner[0_u64..placed_count], buffer: buffer);
  if written {
    return 0_u8;
  }
  return 3_u8;
}

fn text_edit_node(line: &[u8]) -> node: Option<NodeId> reads(line) {
  doc "The Text node a T or D edit line changes, or None for any other line.";
  let length = line^.len;
  if length < 3_u64 {
    return None<NodeId>();
  }
  let kind = line^[0_u64];
  let inserts = kind == 84_u8;
  let deletes = kind == 68_u8;
  let textual = bor(inserts, deletes);
  if textual {
  } else {
    return None<NodeId>();
  }
  let (found, value, unused_next) = read_number(line: line, start: 2_u64);
  if found {
    let made = node_id_of(value: value);
    return made;
  }
  return None<NodeId>();
}

fn same_bytes(first: &Box<Slots<u8>>, second: &Box<Slots<u8>>) -> same: Bool reads(first), reads(second) {
  doc "Tells whether two buffers hold the same bytes.";
  let length = first^.inner.len;
  if length != second^.inner.len {
    return False();
  }
  for (at in 0_u64..length) {
    if first^.inner[at] != second^.inner[at] {
      return False();
    }
  }
  return True();
}

fn stamp(clock: &Clock, witness: &Layout) -> result: Instant reads(witness), writes(clock) {
  doc "Reads the clock after every earlier statement that writes witness: the read of witness makes this call conflict with them, so no overlapping lowering [PAR-1] can take the reading before the work it ends has finished.";
  let (contexts, paragraphs) = layout_counts(layout: witness);
  let made = now(clock: clock);
  return made;
}

fn stamp_styles(clock: &Clock, witness: &Styles) -> result: Instant reads(witness), writes(clock) {
  doc "Reads the clock after every earlier statement that writes witness, as stamp does for a layout.";
  let held = witness^.elements.inner.len;
  let made = now(clock: clock);
  return made;
}

fn styles_after(started: Instant, page: &Page, structural: Bool, environment: Environment) -> result: Result<StyleState, u8> writes(page) {
  doc "Builds the traversal again for a structural edit, then runs the style stage on the live document into a new kept state, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken. Fails with stage 4 (the traversal) or 5 (the styles).";
  if structural {
    match build_traversal(document: &page^.document) {
      Ok(value: found) => {
        set page^.traversal = move found;
      }
      Err(..) => {
        return Err<StyleState, u8>(error: 4_u8);
      }
    }
  }
  match style_state(store: &page^.store, document: &page^.document, atoms: &page^.atoms, traversal: &page^.traversal, environment: environment) {
    Ok(value: found) => {
      return Ok<StyleState, u8>(value: move found);
    }
    Err(..) => {
      return Err<StyleState, u8>(error: 5_u8);
    }
  }
}

fn delta_after(started: Instant, old: &Styles, new: &Styles) -> changed: Box<Array<Bool>> reads(old), reads(new) {
  doc "layout_changes, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken.";
  let changed = layout_changes(old: old, new: new);
  return move changed;
}

fn picks_after(started: Instant, fonts: &FontSet, styles: &Styles, atoms: &AtomTable) -> picks: Option<FontPicks> reads(fonts), reads(styles), reads(atoms) {
  doc "pick_all, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken.";
  let picks = pick_all(fonts: fonts, styles: styles, atoms: atoms);
  return move picks;
}

fn incremental_after(started: Instant, page: &Page, fonts: &FontSet, kept: &Built, node: NodeId) -> applied: Bool reads(page), reads(fonts), writes(kept) {
  doc "apply_incremental, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken.";
  let applied = apply_incremental(page: page, fonts: fonts, kept: kept, node: node);
  return applied;
}

fn apply_incremental(page: &Page, fonts: &FontSet, kept: &Built, node: NodeId) -> applied: Bool reads(page), reads(fonts), writes(kept) {
  doc "Records the change of the Text node's data in the kept layout with text_changed and brings it up to date with update, in the kept styles and font picks; False when either refuses.";
  match text_changed(layout: &kept^.layout, document: &page^.document, node: node) {
    Ok(..) => {
    }
    Err(..) => {
      return False();
    }
  }
  match update(layout: &kept^.layout, document: &page^.document, styles: &kept^.state.styles, fonts: fonts, picks: &kept^.picks) {
    Ok(..) => {
      return True();
    }
    Err(..) => {
      return False();
    }
  }
}

fn apply_style_incremental(page: &Page, fonts: &FontSet, kept: &Built, node: NodeId, token: &[u8], structure: Option<NodeId>, previous: Option<NodeId>, next: Option<NodeId>, inserted: Option<NodeId>, removed: Option<NodeId>, environment: Environment, viewport: Viewport, timing: Bool, compare: Bool, clock: &Clock, report: &Box<Slots<u8>>, number: u64) -> result: Result<StyleUpdate, u8> reads(token), reads(fonts), writes(page), writes(kept), writes(clock), writes(report) {
  doc "For a C or K edit, the class token on node: times the style stage's restyle (class_restyle and restyle on the kept state), refuses an edit that changes what box construction reads (Restyled.structural, or a generated content reading the class attribute), then times the marking (styles_restyled), new font picks and update. For a B or X edit, whose parent structure names, keeps stable style slots and marks the structural restyle delta with structure_changed (apply_structure_edit). Timing reports a separate style edit line with delta_us (the marking, or the delta and marking), picks_us, full_us and style_us; full_us uses fresh font picks, build_layout and lay_out on the same new styles, without styles or placement. Checking reports the retained update counts on a separate style edit line. A refusal is reported by the caller, which resynchronizes to a full build; a style, font or full-comparator failure names its pipeline stage.";
  match structure {
    Some(value: parent) => {
      let done = propagate apply_structure_edit(page: page, fonts: fonts, kept: kept, parent: parent, previous: previous, next: next, inserted: inserted, removed: removed, environment: environment, viewport: viewport, timing: timing, compare: compare, clock: clock, report: report, number: number);
      return Ok<StyleUpdate, u8>(value: done);
    }
    None() => {
    }
  }
  let style_started = now(clock: clock);
  let done = match restyle_after(started: style_started, page: page, kept: kept, node: node, token: token, environment: environment) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: stage) => {
      return Err<StyleUpdate, u8>(error: stage);
    }
  }
  let style_finished = stamp_styles(clock: clock, witness: &kept^.state.styles);
  let style_ns = nanoseconds_from(earlier: style_started, later: style_finished);
  let class_id = class_index(atoms: &page^.atoms);
  let class_atom = Atom(index: class_id);
  let at = cvt::<u32, u64>(node.index);
  let reads_class = if at < page^.traversal.order.inner.len {
    let position = cvt::<u32, u64>(page^.traversal.order.inner[at]);
    give pseudo_reads_attribute(state: &kept^.state, element: position, name: class_atom);
  } else {
    give True();
  }
  let refused_style = bor(done.structural, reads_class);
  if refused_style {
    let no = False();
    let refused = StyleUpdate(applied: no, micros: 0_u64);
    return Ok<StyleUpdate, u8>(value: refused);
  }
  let yes_extend = True();
  let started = now(clock: clock);
  let count = done.changed.inner.len;
  let marked = marks_after(started: started, layout: &kept^.layout, traversal: &page^.traversal, changed: &done.changed.inner[0_u64..count]);
  let after_delta = stamp(clock: clock, witness: &kept^.layout);
  match marked {
    Ok(..) => {
    }
    Err(..) => {
      let no = False();
      let refused = StyleUpdate(applied: no, micros: 0_u64);
      return Ok<StyleUpdate, u8>(value: refused);
    }
  }
  let finished_update = propagate finish_style_edit(page: page, fonts: fonts, kept: kept, viewport: viewport, timing: timing, compare: compare, clock: clock, report: report, number: number, started: started, after_delta: after_delta, style_ns: style_ns, extend: yes_extend);
  return Ok<StyleUpdate, u8>(value: finished_update);
}

fn structure_after(started: Instant, page: &Page, kept: &Built, environment: Environment, parent: NodeId, previous: Option<NodeId>, next: Option<NodeId>, inserted: Option<NodeId>, removed: Option<NodeId>) -> result: Result<Restyled, StyleError> writes(page), writes(kept) {
  doc "The structural style update, anchored after the clock reading by its argument, as restyle_after anchors a class update.";
  let done = propagate structure_restyle(state: &kept^.state, store: &page^.store, document: &page^.document, atoms: &page^.atoms, traversal: &page^.traversal, environment: environment, parent: parent, previous: previous, next: next, inserted: inserted, removed: removed);
  return Ok<Restyled, StyleError>(value: move done);
}

fn structure_flags(started: Instant, page: &Page, done: &Restyled, removed: Option<NodeId>) -> result: Result<Box<Array<Bool>>, u8> reads(page), reads(done) {
  doc "Translates changed stable slots to the temporary NodeId flags and marks every detached subtree node. This O(nodes) allocation belongs to layout's structural delta and is removed by M2 step 4.";
  let nodes = page^.document.nodes.inner.len;
  if nodes > 4294967296_u64 {
    return Err<Box<Array<Bool>>, u8>(error: 5_u8);
  }
  let no = False();
  let changed = box_array_filled::<Bool>(count: nodes, value: no);
  let listed = done^.changed.inner.len;
  for (k in 0_u64..listed) {
    let raw = iand(done^.changed.inner[k], 2147483647_u32);
    let slot = cvt::<u32, u64>(raw);
    if slot < page^.traversal.elements.inner.len {
      let at = cvt::<u32, u64>(page^.traversal.elements.inner[slot].index);
      if at < nodes {
        set changed.inner[at] = True();
      }
    }
  }
  match removed {
    Some(value: root) => {
      let stack = box_slots_new::<NodeId>(capacity: 64_u64);
      let pushed = push_node(stack: &stack, node: root);
      for (step in 0_u64..nodes) {
        if stack.inner.len == 0_u64 {
          break;
        }
        let node = take_back(window: &stack.inner);
        let at = cvt::<u32, u64>(node.index);
        if at < nodes {
          set changed.inner[at] = True();
          if node.index != root.index {
            match page^.document.nodes.inner[at].links.next_sibling {
              Some(value: next) => {
                let pushed_next = push_node(stack: &stack, node: next^);
              }
              None() => {
              }
            }
          }
          match page^.document.nodes.inner[at].links.first_child {
            Some(value: first) => {
              let pushed_first = push_node(stack: &stack, node: first^);
            }
            None() => {
            }
          }
        }
      }
    }
    None() => {
    }
  }
  return Ok<Box<Array<Bool>>, u8>(value: move changed);
}

fn apply_structure_edit(page: &Page, fonts: &FontSet, kept: &Built, parent: NodeId, previous: Option<NodeId>, next: Option<NodeId>, inserted: Option<NodeId>, removed: Option<NodeId>, environment: Environment, viewport: Viewport, timing: Bool, compare: Bool, clock: &Clock, report: &Box<Slots<u8>>, number: u64) -> result: Result<StyleUpdate, u8> reads(fonts), writes(page), writes(kept), writes(clock), writes(report) {
  doc "Times the stable-slot structural restyle, tries the private complete-block splice with the stable frontier, translating slots to dense flags only for structure_changed after an explicit fallback. The kept tables and pseudo identities retain every old reference, so both style arguments share the kept result. A full request takes the previous full traversal/state path.";
  let style_started = now(clock: clock);
  let done = match structure_after(started: style_started, page: page, kept: kept, environment: environment, parent: parent, previous: previous, next: next, inserted: inserted, removed: removed) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      return Err<StyleUpdate, u8>(error: 5_u8);
    }
  }
  let style_finished = stamp_styles(clock: clock, witness: &kept^.state.styles);
  let style_ns = nanoseconds_from(earlier: style_started, later: style_finished);
  if done.full {
    put_text(buffer: report, text: &structure_fallback_label[0_u64..structure_fallback_label.len]);
    put_decimal(buffer: report, value: number);
    put_byte(buffer: report, value: 10_u8);
    let rebuilt = propagate full_structure_edit(page: page, fonts: fonts, kept: kept, prior_style_ns: style_ns, parent: parent, inserted: inserted, removed: removed, environment: environment, viewport: viewport, timing: timing, compare: compare, clock: clock, report: report, number: number);
    return Ok<StyleUpdate, u8>(value: rebuilt);
  }
  let started = now(clock: clock);
  let extended = extend_after(started: started, fonts: fonts, picks: &kept^.picks, styles: &kept^.state.styles, atoms: &page^.atoms);
  if extended {
  } else {
    return Err<StyleUpdate, u8>(error: 1_u8);
  }
  let changed_count = done.changed.inner.len;
  let stable = True();
  let splice_reason = match structure_splice(layout: &kept^.layout, document: &page^.document, styles: &kept^.state.styles, traversal: &page^.traversal, atoms: &page^.atoms, changed: &done.changed.inner[0_u64..changed_count], parent: parent, before: next, inserted: inserted, removed: removed, references_stable: stable, fonts: fonts, picks: &kept^.picks) {
    Ok(value: reason) => {
      give reason;
    }
    Err(..) => {
      give 9_u32;
    }
  }
  put_structure_path(buffer: report, number: number, reason: splice_reason);
  let no = False();
  let marked = if splice_reason == 0_u32 {
    give Ok<unit, LayoutError>(value: unit);
  } else {
    let changed = propagate structure_flags(started: started, page: page, done: &done, removed: removed);
    let nodes = changed.inner.len;
    let rebuilt = structure_changed(layout: &kept^.layout, document: &page^.document, old: &kept^.state.styles, new: &kept^.state.styles, traversal: &page^.traversal, atoms: &page^.atoms, changed: &changed.inner[0_u64..nodes], parent: parent);
    give rebuilt;
  }
  let after_delta = stamp(clock: clock, witness: &kept^.layout);
  match marked {
    Ok(..) => {
    }
    Err(..) => {
      let refused = StyleUpdate(applied: no, micros: 0_u64);
      return Ok<StyleUpdate, u8>(value: refused);
    }
  }
  let extend = True();
  let updated = propagate finish_style_edit(page: page, fonts: fonts, kept: kept, viewport: viewport, timing: timing, compare: compare, clock: clock, report: report, number: number, started: started, after_delta: after_delta, style_ns: style_ns, extend: extend);
  if updated.applied {
    let (built_contexts, built_paragraphs, reused) = structure_counts(layout: &kept^.layout);
    put_text(buffer: report, text: &structure_edit_label[0_u64..structure_edit_label.len]);
    put_decimal(buffer: report, value: number);
    put_text(buffer: report, text: &contexts_label[0_u64..contexts_label.len]);
    put_decimal(buffer: report, value: built_contexts);
    put_text(buffer: report, text: &paragraphs_label[0_u64..paragraphs_label.len]);
    put_decimal(buffer: report, value: built_paragraphs);
    put_text(buffer: report, text: &reused_label[0_u64..reused_label.len]);
    put_decimal(buffer: report, value: reused);
    put_byte(buffer: report, value: 10_u8);
  }
  return Ok<StyleUpdate, u8>(value: updated);
}

fn full_structure_edit(page: &Page, fonts: &FontSet, kept: &Built, prior_style_ns: u64, parent: NodeId, inserted: Option<NodeId>, removed: Option<NodeId>, environment: Environment, viewport: Viewport, timing: Bool, compare: Bool, clock: &Clock, report: &Box<Slots<u8>>, number: u64) -> result: Result<StyleUpdate, u8> reads(fonts), writes(page), writes(kept), writes(clock), writes(report) {
  doc "A B or X edit: builds the traversal and a new style state outside the incremental interval, then times layout_changes against the kept styles and structure_changed for the context parent's children are in, replaces the kept state, and finishes as finish_style_edit does, adding a structure edit line.";
  put_structure_path(buffer: report, number: number, reason: 4_u32);
  let style_started = now(clock: clock);
  let yes = True();
  let fresh = match styles_after(started: style_started, page: page, structural: yes, environment: environment) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: stage) => {
      return Err<StyleUpdate, u8>(error: stage);
    }
  }
  let style_finished = stamp_styles(clock: clock, witness: &fresh.styles);
  let full_style_ns = nanoseconds_from(earlier: style_started, later: style_finished);
  let style_ns = prior_style_ns +sat full_style_ns;
  let started = now(clock: clock);
  let changed = delta_after(started: started, old: &kept^.state.styles, new: &fresh.styles);
  let changed_count = changed.inner.len;
  let marked = structure_changed(layout: &kept^.layout, document: &page^.document, old: &kept^.state.styles, new: &fresh.styles, traversal: &page^.traversal, atoms: &page^.atoms, changed: &changed.inner[0_u64..changed_count], parent: parent);
  let after_delta = stamp(clock: clock, witness: &kept^.layout);
  match marked {
    Ok(..) => {
    }
    Err(..) => {
      let no = False();
      let refused = StyleUpdate(applied: no, micros: 0_u64);
      return Ok<StyleUpdate, u8>(value: refused);
    }
  }
  set kept^.state = move fresh;
  let no_extend = False();
  let finished_update = propagate finish_style_edit(page: page, fonts: fonts, kept: kept, viewport: viewport, timing: timing, compare: compare, clock: clock, report: report, number: number, started: started, after_delta: after_delta, style_ns: style_ns, extend: no_extend);
  if finished_update.applied {
    let (built_contexts, built_paragraphs, reused) = structure_counts(layout: &kept^.layout);
    put_text(buffer: report, text: &structure_edit_label[0_u64..structure_edit_label.len]);
    put_decimal(buffer: report, value: number);
    put_text(buffer: report, text: &contexts_label[0_u64..contexts_label.len]);
    put_decimal(buffer: report, value: built_contexts);
    put_text(buffer: report, text: &paragraphs_label[0_u64..paragraphs_label.len]);
    put_decimal(buffer: report, value: built_paragraphs);
    put_text(buffer: report, text: &reused_label[0_u64..reused_label.len]);
    put_decimal(buffer: report, value: reused);
    put_byte(buffer: report, value: 10_u8);
  }
  return Ok<StyleUpdate, u8>(value: finished_update);
}

fn finish_style_edit(page: &Page, fonts: &FontSet, kept: &Built, viewport: Viewport, timing: Bool, compare: Bool, clock: &Clock, report: &Box<Slots<u8>>, number: u64, started: Instant, after_delta: Instant, style_ns: u64, extend: Bool) -> result: Result<StyleUpdate, u8> reads(page), reads(fonts), writes(kept), writes(clock), writes(report) {
  doc "The part of a style edit after the marking: the font picks of the kept styles, extended with the font groups the kept tables gained when extend holds (extend_picks) and made again otherwise, and update, timed from started; then the style edit line, with the timings and, when compare also holds, the full layout comparator, or the update counts. Replaces the kept picks; an update refusal returns not applied.";
  if extend {
    let extended = extend_after(started: after_delta, fonts: fonts, picks: &kept^.picks, styles: &kept^.state.styles, atoms: &page^.atoms);
    if extended {
    } else {
      return Err<StyleUpdate, u8>(error: 1_u8);
    }
  } else {
    let fresh_picks = match picks_after(started: after_delta, fonts: fonts, styles: &kept^.state.styles, atoms: &page^.atoms) {
      Some(value: found) => {
        give move found;
      }
      None() => {
        return Err<StyleUpdate, u8>(error: 1_u8);
      }
    }
    set kept^.picks = move fresh_picks;
  }
  let after_picks = stamp_picks(clock: clock, witness: &kept^.picks);
  match update(layout: &kept^.layout, document: &page^.document, styles: &kept^.state.styles, fonts: fonts, picks: &kept^.picks) {
    Ok(..) => {
    }
    Err(..) => {
      let no = False();
      let refused = StyleUpdate(applied: no, micros: 0_u64);
      return Ok<StyleUpdate, u8>(value: refused);
    }
  }
  let finished = stamp(clock: clock, witness: &kept^.layout);
  let elapsed = nanoseconds_from(earlier: started, later: finished);
  let micros = elapsed / 1000_u64;
  if timing {
    let delta_ns = nanoseconds_from(earlier: started, later: after_delta);
    let picks_ns = nanoseconds_from(earlier: after_delta, later: after_picks);
    let delta_us = delta_ns / 1000_u64;
    let picks_us = picks_ns / 1000_u64;
    let full_us = if compare {
      let full_started = now(clock: clock);
      let full_picks = match picks_after(started: full_started, fonts: fonts, styles: &kept^.state.styles, atoms: &page^.atoms) {
        Some(value: found) => {
          give move found;
        }
        None() => {
          return Err<StyleUpdate, u8>(error: 1_u8);
        }
      }
      let full_layout = match build_layout(document: &page^.document, traversal: &page^.traversal, styles: &kept^.state.styles, atoms: &page^.atoms, fonts: fonts, picks: &full_picks, viewport: viewport) {
        Ok(value: found) => {
          give move found;
        }
        Err(..) => {
          return Err<StyleUpdate, u8>(error: 2_u8);
        }
      }
      lay_out(layout: &full_layout, document: &page^.document, styles: &kept^.state.styles, fonts: fonts, picks: &full_picks);
      let full_finished = stamp(clock: clock, witness: &full_layout);
      let full_ns = nanoseconds_from(earlier: full_started, later: full_finished);
      give full_ns / 1000_u64;
    } else {
      give 0_u64;
    }
    put_text(buffer: report, text: &style_edit_label[0_u64..style_edit_label.len]);
    put_decimal(buffer: report, value: number);
    put_text(buffer: report, text: &delta_us_label[0_u64..delta_us_label.len]);
    put_decimal(buffer: report, value: delta_us);
    put_text(buffer: report, text: &picks_us_label[0_u64..picks_us_label.len]);
    put_decimal(buffer: report, value: picks_us);
    put_text(buffer: report, text: &full_us_label[0_u64..full_us_label.len]);
    put_decimal(buffer: report, value: full_us);
    put_text(buffer: report, text: &style_us_label[0_u64..style_us_label.len]);
    let style_us = style_ns / 1000_u64;
    put_decimal(buffer: report, value: style_us);
  } else {
    put_text(buffer: report, text: &style_edit_label[0_u64..style_edit_label.len]);
    put_decimal(buffer: report, value: number);
    put_counts(buffer: report, layout: &kept^.layout);
  }
  put_byte(buffer: report, value: 10_u8);
  let yes = True();
  let done = StyleUpdate(applied: yes, micros: micros);
  return Ok<StyleUpdate, u8>(value: done);
}

fn extend_after(started: Instant, fonts: &FontSet, picks: &FontPicks, styles: &Styles, atoms: &AtomTable) -> extended: Bool reads(fonts), reads(styles), reads(atoms), writes(picks) {
  doc "extend_picks with the styles' font groups and families, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken.";
  let groups = styles^.fonts.inner.len;
  let families = styles^.families.inner.len;
  match extend_picks(fonts: fonts, picks: picks, groups: &styles^.fonts.inner[0_u64..groups], families: &styles^.families.inner[0_u64..families], atoms: atoms) {
    Ok(..) => {
      return True();
    }
    Err(..) => {
      return False();
    }
  }
}

fn stamp_picks(clock: &Clock, witness: &FontPicks) -> result: Instant reads(witness), writes(clock) {
  doc "Reads the clock after every earlier statement that writes witness, as stamp does for a layout.";
  let held = witness^.choices.inner.len;
  let made = now(clock: clock);
  return made;
}

fn restyle_after(started: Instant, page: &Page, kept: &Built, node: NodeId, token: &[u8], environment: Environment) -> result: Result<Restyled, u8> reads(token), writes(page), writes(kept) {
  doc "class_restyle for the class token on node, then restyle on the kept state, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken. Fails with stage 5.";
  let wanted = match class_restyle(store: &page^.store, document: &page^.document, atoms: &page^.atoms, traversal: &page^.traversal, node: node, class: token) {
    Ok(value: found) => {
      give move found;
    }
    Err(..) => {
      return Err<Restyled, u8>(error: 5_u8);
    }
  }
  match restyle(state: &kept^.state, store: &page^.store, document: &page^.document, atoms: &page^.atoms, traversal: &page^.traversal, environment: environment, wanted: &wanted) {
    Ok(value: done) => {
      return Ok<Restyled, u8>(value: move done);
    }
    Err(..) => {
      return Err<Restyled, u8>(error: 5_u8);
    }
  }
}

fn marks_after(started: Instant, layout: &Layout, traversal: &Traversal, changed: &[u32]) -> result: Result<unit, LayoutError> reads(traversal), reads(changed), writes(layout) {
  doc "styles_restyled, called with the reading that starts its interval as an argument, so that the work cannot begin before the reading is taken.";
  let marked = styles_restyled(layout: layout, traversal: traversal, changed: changed);
  return marked;
}

fn put_structure_path(buffer: &Box<Slots<u8>>, number: u64, reason: u32) -> result: unit writes(buffer) {
  doc "Reports every structural attempt before either route can refuse: splice 1 reason 0 means local publication, splice 0 carries an explicit fallback reason.";
  put_text(buffer: buffer, text: &structure_path_label[0_u64..15_u64]);
  put_decimal(buffer: buffer, value: number);
  put_text(buffer: buffer, text: &splice_mode_label[0_u64..8_u64]);
  let local = if reason == 0_u32 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  put_decimal(buffer: buffer, value: local);
  put_text(buffer: buffer, text: &splice_reason_label[0_u64..8_u64]);
  let wide = cvt::<u32, u64>(reason);
  put_decimal(buffer: buffer, value: wide);
  put_byte(buffer: buffer, value: 10_u8);
  return unit;
}

fn put_counts(buffer: &Box<Slots<u8>>, layout: &Layout) -> result: unit reads(layout), writes(buffer) {
  doc "Appends the established update counts followed by boundary payload-entry, block and index visits, fallback count and refusal reason. Boundary visits exclude reference replay, so a nonzero fallback count disqualifies an ordinary-path locality assertion.";
  let (prepared, contexts, paragraphs, held_entries, entries) = update_counts(layout: layout);
  put_text(buffer: buffer, text: &prepared_label[0_u64..prepared_label.len]);
  put_decimal(buffer: buffer, value: prepared);
  put_text(buffer: buffer, text: &contexts_label[0_u64..contexts_label.len]);
  put_decimal(buffer: buffer, value: contexts);
  put_text(buffer: buffer, text: &paragraphs_label[0_u64..paragraphs_label.len]);
  put_decimal(buffer: buffer, value: paragraphs);
  put_text(buffer: buffer, text: &held_label[0_u64..held_label.len]);
  put_decimal(buffer: buffer, value: held_entries);
  put_text(buffer: buffer, text: &entries_label[0_u64..entries_label.len]);
  put_decimal(buffer: buffer, value: entries);
  let (physical_entries, physical_blocks, indexes, fallbacks, reason) = boundary_counts(layout: layout);
  put_text(buffer: buffer, text: &boundary_entries_label[0_u64..boundary_entries_label.len]);
  put_decimal(buffer: buffer, value: physical_entries);
  put_text(buffer: buffer, text: &boundary_blocks_label[0_u64..boundary_blocks_label.len]);
  put_decimal(buffer: buffer, value: physical_blocks);
  put_text(buffer: buffer, text: &boundary_indexes_label[0_u64..boundary_indexes_label.len]);
  put_decimal(buffer: buffer, value: indexes);
  put_text(buffer: buffer, text: &boundary_fallbacks_label[0_u64..boundary_fallbacks_label.len]);
  put_decimal(buffer: buffer, value: fallbacks);
  put_text(buffer: buffer, text: &boundary_reason_label[0_u64..boundary_reason_label.len]);
  let wide_reason = cvt::<u32, u64>(reason);
  put_decimal(buffer: buffer, value: wide_reason);
  return unit;
}

fn run_edits(page: &Page, fonts: &FontSet, environment: Environment, viewport: Viewport, script: &[u8], timing: Bool, compare: Bool, clock: &Clock, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(fonts), reads(script), writes(page), writes(clock), writes(out), writes(err), writes(files) waits {
  doc "Runs the edit script on the live document, applying S lines before building the base. T/D edits update the retained text layout; C/K edits recompute styles, compare layout-relevant values, pick fonts and update the retained layout; B/X edits restyle stable slots and build again the context that holds the changed children (structure_changed), reporting a structure edit line with its counts. Checking compares each successful retained dump, using its own styles, byte for byte with a full rebuild and reports inc same, inc DIFF or inc refused. P requests dumps; a differing retained dump follows inc dump. A refusal or difference resynchronizes to the full build. Timing reports the existing edit I us U and update_counts format; style U excludes the separately reported style_us and includes the delta, font picks, marking and update. A separate style edit line reports delta_us, picks_us and the full layout comparator full_us, which runs only when compare holds and is 0 otherwise, so that no full layout runs between timed edits (mode edittime). No edit kind rebuilds without trying the retained path first. Checking style edit lines expose the retained counts. Refusals remain explicit, even when resynchronized. Returns 0, or 2 after reporting a failing script or pipeline stage.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let transfers_valid = boundary_transfer_check();
  if transfers_valid {
  } else {
    put_text(buffer: &report, text: &boundary_failure[0_u64..boundary_failure.len]);
    let reported = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  let dump = box_slots_new::<u8>(capacity: 65536_u64);
  let other = box_slots_new::<u8>(capacity: 65536_u64);
  let dumps = box_slots_new::<u64>(capacity: 16_u64);
  let collected = collect_script(page: page, environment: environment, script: script, dumps: &dumps, report: &report);
  if collected {
  } else {
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  let preserve_traversal = False();
  let kept = match build_page(page: page, fonts: fonts, environment: environment, viewport: viewport, preserve: preserve_traversal) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: stage) => {
      let code = stage_failure(err: err, files: files, stage: stage);
      return code;
    }
  }
  let publication_valid = reference_publication_check(styles: &kept.state.styles);
  if publication_valid {
  } else {
    put_text(buffer: &report, text: &boundary_failure[0_u64..boundary_failure.len]);
    let publication_reported = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  let dumped = dump_layout(page: page, styles: &kept.state.styles, layout: &kept.layout, buffer: &dump);
  if dumped == 0_u8 {
  } else {
    let code = stage_failure(err: err, files: files, stage: dumped);
    return code;
  }
  let print_base = requested(dumps: &dumps, number: 0_u64);
  let no_number = 18446744073709551615_u64;
  let base_hash = report_dump(buffer: &report, dump: &dump, label: &base_label[0_u64..base_label.len], number: no_number, print: print_base);
  let written = flush(factory: files, output: out, buffer: &report);
  let length = script^.len;
  let at = 0_u64;
  let number = 0_u64;
  let edits = 0_u64;
  for (step in 0_u64..length) {
    if at >= length {
      break;
    }
    let end = line_end(text: script, start: at);
    let start = at;
    set at = end +sat 1_u64;
    set number = number +sat 1_u64;
    if end > length {
      return 2_u8;
    }
    if start < end {
      let kind = script^[start];
      let skipped_s = kind == 83_u8;
      let skipped_p = kind == 80_u8;
      let skipped = bor(skipped_s, skipped_p);
      if skipped {
      } else {
        set edits = edits +sat 1_u64;
        let structure = structure_parent(page: page, line: &script^[start..end]);
        let (edit_previous, edit_next) = structure_neighbours(page: page, line: &script^[start..end]);
        let inserted = if kind == 66_u8 {
          give node_id_of(value: page^.document.nodes.inner.len);
        } else {
          give None<NodeId>();
        }
        let removed = if kind == 88_u8 {
          let (found, value, after) = read_number(line: &script^[start..end], start: 2_u64);
          give node_id_of(value: value);
        } else {
          give None<NodeId>();
        }
        let applied = apply_edit(page: page, line: &script^[start..end], report: &report);
        if applied {
        } else {
          put_failure(report: &report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
          let reported = flush(factory: files, output: err, buffer: &report);
          return 2_u8;
        }
        let textual = text_edit_node(line: &script^[start..end]);
        let incremental = match textual {
          Some(value: node) => {
            if timing {
              let started = now(clock: clock);
              let done = incremental_after(started: started, page: page, fonts: fonts, kept: &kept, node: node);
              let finished = stamp(clock: clock, witness: &kept.layout);
              let elapsed = nanoseconds_from(earlier: started, later: finished);
              put_text(buffer: &report, text: &edit_label[0_u64..edit_label.len]);
              put_decimal(buffer: &report, value: edits);
              if done {
                let micros = elapsed / 1000_u64;
                put_text(buffer: &report, text: &us_label[0_u64..us_label.len]);
                put_decimal(buffer: &report, value: micros);
                put_counts(buffer: &report, layout: &kept.layout);
                put_byte(buffer: &report, value: 10_u8);
                let flushed = flush(factory: files, output: out, buffer: &report);
                give 1_u8;
              } else {
                put_text(buffer: &report, text: &inc_refused[0_u64..inc_refused.len]);
                put_byte(buffer: &report, value: 10_u8);
                give 2_u8;
              }
            } else {
              let done = apply_incremental(page: page, fonts: fonts, kept: &kept, node: node);
              if done {
                give 3_u8;
              } else {
                give 2_u8;
              }
            }
          }
          None() => {
            let class_added = kind == 67_u8;
            let class_removed = kind == 75_u8;
            let structural = match structure {
              Some(..) => {
                give True();
              }
              None() => {
                give False();
              }
            }
            let restyled = bor(class_added, class_removed);
            let styled = bor(restyled, structural);
            if styled {
              let (node_found, node_value, unused_next) = read_number(line: &script^[start..end], start: 2_u64);
              let node = match node_id_of(value: node_value) {
                Some(value: found) => {
                  give found;
                }
                None() => {
                  put_failure(report: &report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
                  let reported = flush(factory: files, output: err, buffer: &report);
                  return 2_u8;
                }
              }
              if node_found {
              } else {
                put_failure(report: &report, number: number, reason: &operation_reason[0_u64..operation_reason.len]);
                let reported = flush(factory: files, output: err, buffer: &report);
                return 2_u8;
              }
              let token_lo = start +sat unused_next;
              let token_from = imin(token_lo, end);
              let changed = match apply_style_incremental(page: page, fonts: fonts, kept: &kept, node: node, token: &script^[token_from..end], structure: structure, previous: edit_previous, next: edit_next, inserted: inserted, removed: removed, environment: environment, viewport: viewport, timing: timing, compare: compare, clock: clock, report: &report, number: edits) {
                Ok(value: done) => {
                  give done;
                }
                Err(error: stage) => {
                  put_failure(report: &report, number: number, reason: &render_reason[0_u64..render_reason.len]);
                  let reported = flush(factory: files, output: err, buffer: &report);
                  let code = stage_failure(err: err, files: files, stage: stage);
                  return code;
                }
              }
              if timing {
                put_text(buffer: &report, text: &edit_label[0_u64..edit_label.len]);
                put_decimal(buffer: &report, value: edits);
                if changed.applied {
                  put_text(buffer: &report, text: &us_label[0_u64..us_label.len]);
                  put_decimal(buffer: &report, value: changed.micros);
                  put_counts(buffer: &report, layout: &kept.layout);
                  put_byte(buffer: &report, value: 10_u8);
                  let flushed = flush(factory: files, output: out, buffer: &report);
                  give 1_u8;
                } else {
                  put_text(buffer: &report, text: &inc_refused[0_u64..inc_refused.len]);
                  put_byte(buffer: &report, value: 10_u8);
                  give 2_u8;
                }
              } else if changed.applied {
                give 3_u8;
              } else {
                give 2_u8;
              }
            } else {
              if timing {
                put_text(buffer: &report, text: &edit_label[0_u64..edit_label.len]);
                put_decimal(buffer: &report, value: edits);
                put_text(buffer: &report, text: &full_label[0_u64..full_label.len]);
                put_byte(buffer: &report, value: 10_u8);
              }
              give 0_u8;
            }
          }
        }
        if incremental == 1_u8 {
        } else {
          let preserve_comparison = incremental == 3_u8;
          let rebuilt = match build_page(page: page, fonts: fonts, environment: environment, viewport: viewport, preserve: preserve_comparison) {
            Ok(value: found) => {
              give move found;
            }
            Err(error: stage) => {
              put_failure(report: &report, number: number, reason: &render_reason[0_u64..render_reason.len]);
              let reported = flush(factory: files, output: err, buffer: &report);
              let code = stage_failure(err: err, files: files, stage: stage);
              return code;
            }
          }
          if timing {
            let flushed = flush(factory: files, output: out, buffer: &report);
            set kept = move rebuilt;
          } else {
            let full_stage = dump_layout(page: page, styles: &rebuilt.state.styles, layout: &rebuilt.layout, buffer: &dump);
            if full_stage == 0_u8 {
            } else {
              let code = stage_failure(err: err, files: files, stage: full_stage);
              return code;
            }
            let same = if incremental == 3_u8 {
              let kept_stage = dump_layout(page: page, styles: &kept.state.styles, layout: &kept.layout, buffer: &other);
              let identical = same_bytes(first: &dump, second: &other);
              truncate(buffer: &other, length: 0_u64);
              let kept_dumped = kept_stage == 0_u8;
              let (kept_contexts, kept_paragraphs) = layout_counts(layout: &kept.layout);
              let (full_contexts, full_paragraphs) = layout_counts(layout: &rebuilt.layout);
              let contexts_same = kept_contexts == full_contexts;
              let paragraphs_same = kept_paragraphs == full_paragraphs;
              let counts_same = band(contexts_same, paragraphs_same);
              let dump_same = band(identical, kept_dumped);
              give band(dump_same, counts_same);
            } else {
              give False();
            }
            let print = requested(dumps: &dumps, number: edits);
            let silent = False();
            let hashed = report_dump(buffer: &report, dump: &dump, label: &edit_label[0_u64..edit_label.len], number: edits, print: silent);
            if incremental == 3_u8 {
              let size = report.inner.len;
              if size > 0_u64 {
                let trimmed = size - 1_u64;
                truncate(buffer: &report, length: trimmed);
              }
              if same {
                put_text(buffer: &report, text: &inc_same[0_u64..inc_same.len]);
              } else {
                put_text(buffer: &report, text: &inc_differs[0_u64..inc_differs.len]);
              }
              put_byte(buffer: &report, value: 10_u8);
            } else if incremental == 2_u8 {
              let size = report.inner.len;
              if size > 0_u64 {
                let trimmed = size - 1_u64;
                truncate(buffer: &report, length: trimmed);
              }
              put_text(buffer: &report, text: &inc_refused[0_u64..inc_refused.len]);
              put_byte(buffer: &report, value: 10_u8);
            }
            if print {
              let printed = dump_layout(page: page, styles: &rebuilt.state.styles, layout: &rebuilt.layout, buffer: &report);
              let differs = incremental == 3_u8;
              let unequal = bnot(same);
              let both = band(differs, unequal);
              if both {
                put_text(buffer: &report, text: &inc_dump_label[0_u64..inc_dump_label.len]);
                let printed_kept = dump_layout(page: page, styles: &kept.state.styles, layout: &kept.layout, buffer: &report);
              }
            }
            let flushed = flush(factory: files, output: out, buffer: &report);
            if flushed {
            } else {
              return 2_u8;
            }
            let resync = bnot(same);
            if resync {
              if preserve_comparison {
                match build_traversal(document: &page^.document) {
                  Ok(value: fresh) => {
                    set page^.traversal = move fresh;
                  }
                  Err(..) => {
                    return 2_u8;
                  }
                }
              }
              set kept = move rebuilt;
            } else {
              let discarded = move rebuilt;
            }
          }
        }
      }
    }
  }
  return 0_u8;
}

fn list_nodes(page: &Page, buffer: &Box<Slots<u8>>) -> listed: Bool reads(page), writes(buffer) {
  doc "Appends, for each element and Text node in tree order, an E line `E NODE DEPTH NAME DESCENDANTS INDEX` (DEPTH counting the element ancestors, DESCENDANTS the elements below, INDEX the position in the traversal) or a T line `T NODE PARENT LENGTH DATA` with backslash and line feed escaped, then the line `N COUNT` with the number of nodes the document holds, which are the identifiers a later insertion takes. False when the document is too large to number.";
  let nodes = page^.document.nodes.inner.len;
  let count = page^.traversal.elements.inner.len;
  let small = count < 4294967295_u64;
  let few_nodes = nodes < 1073741824_u64;
  let usable = band(small, few_nodes);
  if usable {
  } else {
    return False();
  }
  let element_of = box_array_filled::<u32>(count: nodes, value: 4294967295_u32);
  let depths = box_array_filled::<u64>(count: count, value: 0_u64);
  let below = box_array_filled::<u64>(count: count, value: 0_u64);
  for (i in 0_u64..count) {
    let node = page^.traversal.elements.inner[i];
    let at = cvt::<u32, u64>(node.index);
    if at < element_of.inner.len {
      set element_of.inner[at] = cvt::<u64, u32>(i);
    }
    if i < page^.traversal.parents.inner.len {
      let parent = cvt::<u32, u64>(page^.traversal.parents.inner[i]);
      if parent < i {
        if i < depths.inner.len {
          set depths.inner[i] = depths.inner[parent] +sat 1_u64;
        }
      }
    }
  }
  for (step in 0_u64..count) {
    let remaining = count -sat step;
    let i = remaining -sat 1_u64;
    if i < page^.traversal.parents.inner.len {
      let parent = cvt::<u32, u64>(page^.traversal.parents.inner[i]);
      if parent < i {
        if i < below.inner.len {
          let contribution = below.inner[i] +sat 1_u64;
          set below.inner[parent] = below.inner[parent] +sat contribution;
        }
      }
    }
  }
  let stack = box_slots_new::<NodeId>(capacity: 64_u64);
  if 0_u64 < nodes {
    let root_child = page^.document.nodes.inner[0_u64].links.first_child;
    match root_child {
      Some(value: first) => {
        let pushed = push_node(stack: &stack, node: first);
      }
      None() => {
      }
    }
  }
  for (step in 0_u64..nodes) {
    let depth = stack.inner.len;
    if depth == 0_u64 {
      break;
    }
    let node = take_back(window: &stack.inner);
    let at = cvt::<u32, u64>(node.index);
    if at < nodes {
      let sibling_link = page^.document.nodes.inner[at].links.next_sibling;
      match sibling_link {
        Some(value: sibling) => {
          let pushed = push_node(stack: &stack, node: sibling);
        }
        None() => {
        }
      }
      let index = cvt::<u32, u64>(element_of.inner[at]);
      let span_option = text_span_at(document: &page^.document, node: node);
      if index < count {
        put_text(buffer: buffer, text: &element_label[0_u64..element_label.len]);
        put_decimal(buffer: buffer, value: at);
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: depths.inner[index]);
        put_byte(buffer: buffer, value: 32_u8);
        put_name(buffer: buffer, atoms: &page^.atoms, document: &page^.document, node: node);
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: below.inner[index]);
        put_byte(buffer: buffer, value: 32_u8);
        put_decimal(buffer: buffer, value: index);
        put_byte(buffer: buffer, value: 10_u8);
      }
      match span_option {
        Some(value: span) => {
          let start = cvt::<u32, u64>(span.start);
          let end = cvt::<u32, u64>(span.end);
          let parent_link = page^.document.nodes.inner[at].links.parent;
          let parent_index = match parent_link {
            Some(value: parent) => {
              give cvt::<u32, u64>(parent.index);
            }
            None() => {
              give 0_u64;
            }
          }
          put_text(buffer: buffer, text: &text_label[0_u64..text_label.len]);
          put_decimal(buffer: buffer, value: at);
          put_byte(buffer: buffer, value: 32_u8);
          put_decimal(buffer: buffer, value: parent_index);
          put_byte(buffer: buffer, value: 32_u8);
          let size = end -sat start;
          put_decimal(buffer: buffer, value: size);
          put_byte(buffer: buffer, value: 32_u8);
          if start <= end {
            if end <= page^.document.text.inner.len {
              put_escaped(buffer: buffer, text: &page^.document.text.inner[start..end]);
            }
          }
          put_byte(buffer: buffer, value: 10_u8);
        }
        None() => {
        }
      }
      let child_link = page^.document.nodes.inner[at].links.first_child;
      match child_link {
        Some(value: child) => {
          let pushed = push_node(stack: &stack, node: child);
        }
        None() => {
        }
      }
    }
  }
  put_text(buffer: buffer, text: &arena_label[0_u64..arena_label.len]);
  put_decimal(buffer: buffer, value: nodes);
  put_byte(buffer: buffer, value: 10_u8);
  return True();
}
