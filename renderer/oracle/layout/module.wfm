alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The layout_oracle entry, invoked as `layout_oracle MODE REPS PAGE UA [SUFFIX=SHEET ...]` with the style oracle's arguments, from the repository root, with the installed fonts copied into build/fonts. It loads the page and its sheets with pkg::oracle::page, computes styles, loads the fonts and picks each font group's faces, then: dump builds and lays out the page once and writes the format of tests/layout/layout_oracle.mjs to standard output; build repeats REPS times the box tree's construction with its text preparation, and layout repeats construction and layout, each printing the mode, the element, context and paragraph counts and REPS. Exits 2 when the invocation, a file, the page, the style stage or the layout stage fails.";
