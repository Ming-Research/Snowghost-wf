alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The layout_oracle entry, invoked as `layout_oracle MODE REPS PAGE UA [SUFFIX=SHEET ...]` with the style oracle's arguments, from the repository root, with the installed fonts copied into build/fonts. It loads the page and its sheets with pkg::oracle::page, computes styles and loads the fonts, then: dump matches the fonts, builds and lays out the page once and writes the format of tests/layout/layout_oracle.mjs to standard output; boxes, text and layout repeat REPS times the stage's parts in nested order, so that the time of each part is the difference between consecutive modes: boxes builds the box tree, text also matches each font group's faces (pkg::layout::text::pick_fonts) and prepares every paragraph's text (font matching, shaping and break opportunities), and layout also lays the tree out; each prints the mode, the element, context and paragraph counts and REPS. Exits 2 when the invocation, a file, the page, the style stage or the layout stage fails.";
