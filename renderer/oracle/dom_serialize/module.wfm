alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;

public fn serialize_document(document: &Document, atoms: &AtomTable, out: &Box<Slots<u8>>) -> complete: Bool reads(document), reads(atoms), writes(out) doc "Appends the children of the document's root, node 0, to out in the html5lib tree-construction tests' `#document` format, the first child at depth 0. Every line is `| `, two spaces per level of depth, the node's text and a line feed: `<!DOCTYPE name>`, or `<!DOCTYPE name \"public\" \"system\">` when either identifier is nonempty; `<name>` for an HTML element and `<svg name>` or `<math name>` for a foreign one; text in quotation marks; `<!-- data -->` for a comment. The bytes of names, identifiers, text and comments are written raw. An element's attributes follow it one level deeper as `name=\"value\"`, the name prefixed by `xlink `, `xml ` or `xmlns ` for a namespaced attribute and the lines ordered by those written names in byte order. Then an element with template contents has a `content` line one level deeper and the contents' children one level below that, and then its own children one level deeper. A DocumentRoot or Fragment node met as a child is written as the line `<unexpected document root>` or `<unexpected fragment>` with its children below it, and a span or atom that lies outside its storage as `<span outside the text>`, so the output differs from every expected tree. Returns False, after the lines written so far, when a node's links are inconsistent (a child that does not name its parent, siblings that do not chain, a first child that the chain does not reach) or the walk takes more steps than the document has nodes, which only a cycle makes, or the walk's stack would pass 2^32 entries; True when the whole tree was written.";
