alias Atom = pkg::base::atom::Atom;
alias AtomTable = pkg::base::atom::AtomTable;
alias Attribute = pkg::dom::Attribute;
alias Document = pkg::dom::Document;
alias Links = pkg::dom::Links;
alias NodeId = pkg::dom::NodeId;
alias TextSpan = pkg::dom::TextSpan;
alias put_byte = pkg::oracle::support::put_byte;
alias put_text = pkg::oracle::support::put_text;
alias truncate = pkg::oracle::support::truncate;

enum Visit {
  Enter(node: NodeId, depth: u64);
  Content(fragment: NodeId, depth: u64);
}

const line_start: Array<u8, 2> =[124_u8, 32_u8];

const indent: Array<u8, 2> =[32_u8, 32_u8];

const doctype_open: Array<u8, 10> =[60_u8, 33_u8, 68_u8, 79_u8, 67_u8, 84_u8, 89_u8, 80_u8, 69_u8, 32_u8];

const comment_open: Array<u8, 5> =[60_u8, 33_u8, 45_u8, 45_u8, 32_u8];

const comment_close: Array<u8, 4> =[32_u8, 45_u8, 45_u8, 62_u8];

const content_word: Array<u8, 7> =[99_u8, 111_u8, 110_u8, 116_u8, 101_u8, 110_u8, 116_u8];

const svg_prefix: Array<u8, 4> =[115_u8, 118_u8, 103_u8, 32_u8];

const math_prefix: Array<u8, 5> =[109_u8, 97_u8, 116_u8, 104_u8, 32_u8];

const xlink_prefix: Array<u8, 6> =[120_u8, 108_u8, 105_u8, 110_u8, 107_u8, 32_u8];

const xml_prefix: Array<u8, 4> =[120_u8, 109_u8, 108_u8, 32_u8];

const xmlns_prefix: Array<u8, 6> =[120_u8, 109_u8, 108_u8, 110_u8, 115_u8, 32_u8];

const value_open: Array<u8, 2> =[61_u8, 34_u8];

const bad_span_text: Array<u8, 23> =[60_u8, 115_u8, 112_u8, 97_u8, 110_u8, 32_u8, 111_u8, 117_u8, 116_u8, 115_u8, 105_u8, 100_u8, 101_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 116_u8, 101_u8, 120_u8, 116_u8, 62_u8];

const unexpected_root_text: Array<u8, 26> =[60_u8, 117_u8, 110_u8, 101_u8, 120_u8, 112_u8, 101_u8, 99_u8, 116_u8, 101_u8, 100_u8, 32_u8, 100_u8, 111_u8, 99_u8, 117_u8, 109_u8, 101_u8, 110_u8, 116_u8, 32_u8, 114_u8, 111_u8, 111_u8, 116_u8, 62_u8];

const unexpected_fragment_text: Array<u8, 21> =[60_u8, 117_u8, 110_u8, 101_u8, 120_u8, 112_u8, 101_u8, 99_u8, 116_u8, 101_u8, 100_u8, 32_u8, 102_u8, 114_u8, 97_u8, 103_u8, 109_u8, 101_u8, 110_u8, 116_u8, 62_u8];

fn serialize_document(document: &Document, atoms: &AtomTable, out: &Box<Slots<u8>>) -> complete: Bool reads(document), reads(atoms), writes(out) {
  doc "Walks the tree with an explicit stack instead of recursion: a popped element pushes its children in reverse, and then its template contents on top, so the contents are written first, under a `content` line. The walk stops with False when push_children finds broken links, when it takes more steps than there are nodes, or when the stack would pass its ceiling.";
  let stack = box_slots_new::<Visit>(capacity: 16_u64);
  let root = NodeId(index: 0_u32);
  let seeded = push_children(document: document, stack: &stack, parent: root, depth: 0_u64);
  if seeded {
  } else {
    return False();
  }
  let budget = document^.nodes.inner.len;
  let visits = 0_u64;
  loop @walk {
    if stack.inner.len == 0_u64 {
      break @walk;
    }
    if visits >= budget {
      return False();
    }
    set visits = visits + 1_u64;
    let visit = take_back(window: &stack.inner);
    match visit {
      Enter(node: current, depth: level) => {
        write_node(document: document, atoms: atoms, out: out, node: current, depth: level);
        let deeper = level +sat 1_u64;
        let pushed = push_children(document: document, stack: &stack, parent: current, depth: deeper);
        if pushed {
        } else {
          return False();
        }
        let contents = template_contents(document: document, node: current);
        match contents {
          Some(value: inner) => {
            let pending = Visit::Content(fragment: inner, depth: deeper);
            let placed = push_visit(stack: &stack, visit: pending);
            if placed {
            } else {
              return False();
            }
          }
          None() => {
          }
        }
      }
      Content(fragment: holder, depth: level) => {
        line_start_at(out: out, depth: level);
        put_text(buffer: out, text: &content_word[0_u64..content_word.len]);
        put_byte(buffer: out, value: 10_u8);
        let deeper = level +sat 1_u64;
        let pushed = push_children(document: document, stack: &stack, parent: holder, depth: deeper);
        if pushed {
        } else {
          return False();
        }
      }
    }
  }
  return True();
}

fn links_of(document: &Document, node: NodeId) -> links: Option<Links> reads(document) {
  doc "Returns the links of node, or None when it names no node.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let links = document^.nodes.inner[index].links;
    return Some<Links>(value: links);
  }
  return None<Links>();
}

fn push_children(document: &Document, stack: &Box<Slots<Visit>>, parent: NodeId, depth: u64) -> pushed: Bool reads(document), writes(stack) {
  doc "Pushes the children of parent from the last to the first, so that the first is popped first, and checks the links on the way: each child names parent as its parent and the child after it as its next sibling, and the first one reached from the last is parent's first child. The walk takes at most one step per node. Returns False when a link breaks those rules or the stack would pass its ceiling.";
  let count = document^.nodes.inner.len;
  match links_of(document: document, node: parent) {
    Some(value: parent_links) => {
      let current = parent_links.last_child;
      let after = None<NodeId>();
      let holder = Some<NodeId>(value: parent);
      for (step in 0_u64..count) {
        match current {
          Some(value: child) => {
            match links_of(document: document, node: child) {
              Some(value: links) => {
                let owned = same_link(first: links.parent, second: holder);
                let chained = same_link(first: links.next_sibling, second: after);
                let consistent = band(owned, chained);
                if consistent {
                } else {
                  return False();
                }
                let pending = Visit::Enter(node: child, depth: depth);
                let placed = push_visit(stack: stack, visit: pending);
                if placed {
                } else {
                  return False();
                }
                set after = current;
                set current = links.previous_sibling;
              }
              None() => {
                return False();
              }
            }
          }
          None() => {
            let started = same_link(first: after, second: parent_links.first_child);
            return started;
          }
        }
      }
      return False();
    }
    None() => {
      return False();
    }
  }
}

fn same_link(first: Option<NodeId>, second: Option<NodeId>) -> same: Bool pure {
  doc "Tells whether two links name the same node, or both name none.";
  match first {
    Some(value: left) => {
      match second {
        Some(value: right) => {
          return left.index == right.index;
        }
        None() => {
          return False();
        }
      }
    }
    None() => {
      match second {
        Some(value: right) => {
          return False();
        }
        None() => {
          return True();
        }
      }
    }
  }
}

fn push_visit(stack: &Box<Slots<Visit>>, visit: Visit) -> placed: Bool writes(stack) {
  doc "Pushes visit, doubling a full stack within 2^32 entries; False at that ceiling.";
  let length = stack^.inner.len;
  let capacity = stack^.inner.cap;
  if length < capacity {
    place_back(window: &stack^.inner, value: visit);
    return True();
  }
  if capacity >= 4294967296_u64 {
    return False();
  }
  if capacity < 8_u64 {
    grow(cell: stack, capacity: 16_u64);
  } else {
    let doubled = capacity + capacity;
    grow(cell: stack, capacity: doubled);
  }
  place_back(window: &stack^.inner, value: visit);
  return True();
}

fn template_contents(document: &Document, node: NodeId) -> contents: Option<NodeId> reads(document) {
  doc "Returns the template contents of an element, and None for every other node.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
    let data = &document^.nodes.inner[index].data;
    match data^ {
      Element(namespace: kind, local_name: local, attributes: list, template_contents: held) => {
        return held^;
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return None<NodeId>();
}

fn line_start_at(out: &Box<Slots<u8>>, depth: u64) -> result: unit writes(out) {
  doc "Writes `| ` and two spaces per level of depth.";
  put_text(buffer: out, text: &line_start[0_u64..line_start.len]);
  for (level in 0_u64..depth) {
    put_text(buffer: out, text: &indent[0_u64..indent.len]);
  }
  return unit;
}

fn put_span(document: &Document, out: &Box<Slots<u8>>, span: TextSpan) -> result: unit reads(document), writes(out) {
  doc "Writes the stored text span names, or a marker when it lies outside the storage.";
  let start = cvt::<u32, u64>(span.start);
  let end = cvt::<u32, u64>(span.end);
  let length = document^.text.inner.len;
  if start <= end {
    if end <= length {
      put_text(buffer: out, text: &document^.text.inner[start..end]);
      return unit;
    }
  }
  put_text(buffer: out, text: &bad_span_text[0_u64..bad_span_text.len]);
  return unit;
}

fn put_atom(atoms: &AtomTable, out: &Box<Slots<u8>>, atom: Atom) -> result: unit reads(atoms), writes(out) {
  doc "Writes the text of atom, or a marker when the table has no such atom.";
  let index = cvt::<u32, u64>(atom.index);
  if index < atoms^.spans.inner.len {
    let span = atoms^.spans.inner[index];
    let start = cvt::<u32, u64>(span.start);
    let end = cvt::<u32, u64>(span.end);
    let length = atoms^.text.inner.len;
    if start <= end {
      if end <= length {
        put_text(buffer: out, text: &atoms^.text.inner[start..end]);
        return unit;
      }
    }
  }
  put_text(buffer: out, text: &bad_span_text[0_u64..bad_span_text.len]);
  return unit;
}

fn span_empty(span: TextSpan) -> empty: Bool pure {
  doc "Tells whether span holds no bytes.";
  return span.start >= span.end;
}

fn write_node(document: &Document, atoms: &AtomTable, out: &Box<Slots<u8>>, node: NodeId, depth: u64) -> result: unit reads(document), reads(atoms), writes(out) {
  doc "Writes the line of one node, and an element's attributes below it: `<!DOCTYPE name>` with quoted identifiers when either is nonempty, `<name>` with `svg ` or `math ` before a foreign name, text in quotes and `<!-- text -->`; a DocumentRoot or Fragment node, which is never a child in a well-formed tree, gets a marker line.";
  let index = cvt::<u32, u64>(node.index);
  if index < document^.nodes.inner.len {
  } else {
    line_start_at(out: out, depth: depth);
    put_text(buffer: out, text: &bad_span_text[0_u64..bad_span_text.len]);
    put_byte(buffer: out, value: 10_u8);
    return unit;
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    DocumentRoot(..) => {
      line_start_at(out: out, depth: depth);
      put_text(buffer: out, text: &unexpected_root_text[0_u64..unexpected_root_text.len]);
      put_byte(buffer: out, value: 10_u8);
    }
    DocumentType(name: doctype_name, public_id: public_ref, system_id: system_ref) => {
      line_start_at(out: out, depth: depth);
      put_text(buffer: out, text: &doctype_open[0_u64..doctype_open.len]);
      put_span(document: document, out: out, span: doctype_name^);
      let no_public = span_empty(span: public_ref^);
      let no_system = span_empty(span: system_ref^);
      let bare = band(no_public, no_system);
      if bare {
      } else {
        put_byte(buffer: out, value: 32_u8);
        put_byte(buffer: out, value: 34_u8);
        put_span(document: document, out: out, span: public_ref^);
        put_byte(buffer: out, value: 34_u8);
        put_byte(buffer: out, value: 32_u8);
        put_byte(buffer: out, value: 34_u8);
        put_span(document: document, out: out, span: system_ref^);
        put_byte(buffer: out, value: 34_u8);
      }
      put_byte(buffer: out, value: 62_u8);
      put_byte(buffer: out, value: 10_u8);
    }
    Element(namespace: kind, local_name: local, attributes: list, template_contents: held) => {
      line_start_at(out: out, depth: depth);
      put_byte(buffer: out, value: 60_u8);
      match kind^ {
        Html() => {
        }
        Svg() => {
          put_text(buffer: out, text: &svg_prefix[0_u64..svg_prefix.len]);
        }
        MathMl() => {
          put_text(buffer: out, text: &math_prefix[0_u64..math_prefix.len]);
        }
      }
      put_atom(atoms: atoms, out: out, atom: local^);
      put_byte(buffer: out, value: 62_u8);
      put_byte(buffer: out, value: 10_u8);
      let deeper = depth +sat 1_u64;
      write_attributes(document: document, atoms: atoms, out: out, list: list, depth: deeper);
    }
    Text(data: span) => {
      line_start_at(out: out, depth: depth);
      put_byte(buffer: out, value: 34_u8);
      put_span(document: document, out: out, span: span^);
      put_byte(buffer: out, value: 34_u8);
      put_byte(buffer: out, value: 10_u8);
    }
    Comment(data: span) => {
      line_start_at(out: out, depth: depth);
      put_text(buffer: out, text: &comment_open[0_u64..comment_open.len]);
      put_span(document: document, out: out, span: span^);
      put_text(buffer: out, text: &comment_close[0_u64..comment_close.len]);
      put_byte(buffer: out, value: 10_u8);
    }
    Fragment() => {
      line_start_at(out: out, depth: depth);
      put_text(buffer: out, text: &unexpected_fragment_text[0_u64..unexpected_fragment_text.len]);
      put_byte(buffer: out, value: 10_u8);
    }
  }
  return unit;
}

fn attribute_key(atoms: &AtomTable, key: &Box<Slots<u8>>, item: Attribute) -> result: unit reads(atoms), writes(key) {
  doc "Replaces key with the name the tree format writes for attribute: its namespace prefix and a space, then its local name.";
  truncate(buffer: key, length: 0_u64);
  match item.namespace {
    NoNamespace() => {
    }
    XLink() => {
      put_text(buffer: key, text: &xlink_prefix[0_u64..xlink_prefix.len]);
    }
    Xml() => {
      put_text(buffer: key, text: &xml_prefix[0_u64..xml_prefix.len]);
    }
    XmlNs() => {
      put_text(buffer: key, text: &xmlns_prefix[0_u64..xmlns_prefix.len]);
    }
  }
  put_atom(atoms: atoms, out: key, atom: item.name);
  return unit;
}

fn write_attributes(document: &Document, atoms: &AtomTable, out: &Box<Slots<u8>>, list: &Box<Slots<Attribute>>, depth: u64) -> result: unit reads(document), reads(atoms), reads(list), writes(out) {
  doc "Writes one `name=\"value\"` line per attribute, ordered by written name and then by position, so that a repeated name shows once per attribute that has it: each pass selects the least name and position above the ones written last. The quadratic cost suits a test's few attributes.";
  let count = list^.inner.len;
  let last = box_slots_new::<u8>(capacity: 16_u64);
  let best = box_slots_new::<u8>(capacity: 16_u64);
  let candidate = box_slots_new::<u8>(capacity: 16_u64);
  let started = False();
  let last_position = 0_u64;
  for (pass in 0_u64..count) {
    let chosen = None<Attribute>();
    let chosen_position = 0_u64;
    for (at in 0_u64..count) {
      let item = list^.inner[at];
      attribute_key(atoms: atoms, key: &candidate, item: item);
      let candidate_length = candidate.inner.len;
      let last_length = last.inner.len;
      let best_length = best.inner.len;
      let later_name = precedes(first: &last.inner[0_u64..last_length], second: &candidate.inner[0_u64..candidate_length]);
      let same_name = same_bytes(first: &last.inner[0_u64..last_length], second: &candidate.inner[0_u64..candidate_length]);
      let later_position = at > last_position;
      let same_later = band(same_name, later_position);
      let beyond = bor(later_name, same_later);
      let fresh = bnot(started);
      let above = bor(fresh, beyond);
      if above {
        let better = match chosen {
          Some(value: held) => {
            give precedes(first: &candidate.inner[0_u64..candidate_length], second: &best.inner[0_u64..best_length]);
          }
          None() => {
            give True();
          }
        }
        if better {
          truncate(buffer: &best, length: 0_u64);
          put_text(buffer: &best, text: &candidate.inner[0_u64..candidate_length]);
          set chosen = Some<Attribute>(value: item);
          set chosen_position = at;
        }
      }
    }
    match chosen {
      Some(value: picked) => {
        let best_length = best.inner.len;
        line_start_at(out: out, depth: depth);
        put_text(buffer: out, text: &best.inner[0_u64..best_length]);
        put_text(buffer: out, text: &value_open[0_u64..value_open.len]);
        put_span(document: document, out: out, span: picked.value);
        put_byte(buffer: out, value: 34_u8);
        put_byte(buffer: out, value: 10_u8);
        truncate(buffer: &last, length: 0_u64);
        put_text(buffer: &last, text: &best.inner[0_u64..best_length]);
        set last_position = chosen_position;
        set started = True();
      }
      None() => {
      }
    }
  }
  return unit;
}

fn precedes(first: &[u8], second: &[u8]) -> result: Bool reads(first), reads(second) {
  doc "Tells whether first comes strictly before second in byte order, a proper prefix first.";
  let first_length = first^.len;
  let second_length = second^.len;
  let shorter = if first_length < second_length {
    give first_length;
  } else {
    give second_length;
  }
  for (at in 0_u64..shorter) {
    let left = first^[at];
    let right = second^[at];
    if left < right {
      return True();
    }
    if left > right {
      return False();
    }
  }
  return first_length < second_length;
}

fn same_bytes(first: &[u8], second: &[u8]) -> result: Bool reads(first), reads(second) {
  doc "Tells whether first and second hold the same bytes.";
  let length = first^.len;
  if length == second^.len {
  } else {
    return False();
  }
  for (at in 0_u64..length) {
    if first^[at] == second^[at] {
    } else {
      return False();
    }
  }
  return True();
}
