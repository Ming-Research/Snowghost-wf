alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure doc "The css_color_oracle entry, invoked as `css_color_oracle PATH` with PATH naming the case file that tests/css/color_oracle.py writes, relative to the working directory: per case, the byte length in decimal, a line feed, the bytes and a line feed. For every case it runs parse_component_values, then pkg::css::color::parse_color over the whole component list, and prints one line: null for Invalid, \"currentcolor\" for CurrentColor, or [SPACE, FIRST, SECOND, THIRD, ALPHA] for a color, with SPACE the space's name in color_oracle.py's SPACES, whose order is ColorSpace's, and each channel converted exactly to f64 and written as pkg::oracle::css_json::put_f64 writes it, or null when its bit in missing is set. A color whose missing has a bit other than 0 to 3 set prints as the JSON string `\"driver: invalid missing bits\"`, one with a set bit whose channel is not zero, either zero counting, as `\"driver: nonzero missing channel\"`, and one with a channel that is NaN and not missing as `\"driver: NaN channel\"`. A case that parse_component_values refuses prints as `\"driver: tokenizer refused\"`. It exits with 0 after printing every case, and with 2, after the cases before it, when the case file cannot be read or is malformed.";
