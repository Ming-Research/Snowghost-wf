const space_rec2020: Array<u8, 9> =[34_u8, 114_u8, 101_u8, 99_u8, 50_u8, 48_u8, 50_u8, 48_u8, 34_u8];

const space_xyz_d50: Array<u8, 9> =[34_u8, 120_u8, 121_u8, 122_u8, 45_u8, 100_u8, 53_u8, 48_u8, 34_u8];

const space_xyz_d65: Array<u8, 9> =[34_u8, 120_u8, 121_u8, 122_u8, 45_u8, 100_u8, 54_u8, 53_u8, 34_u8];

const current_color_text: Array<u8, 14> =[34_u8, 99_u8, 117_u8, 114_u8, 114_u8, 101_u8, 110_u8, 116_u8, 99_u8, 111_u8, 108_u8, 111_u8, 114_u8, 34_u8];

const null_text: Array<u8, 4> =[110_u8, 117_u8, 108_u8, 108_u8];

const item_separator: Array<u8, 2> =[44_u8, 32_u8];

const refused_tokenizer: Array<u8, 27> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 105_u8, 122_u8, 101_u8, 114_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 34_u8];

const fault_too_large: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const fault_too_many: Array<u8, 33> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 110_u8, 101_u8, 110_u8, 116_u8, 32_u8, 108_u8, 105_u8, 115_u8, 116_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 34_u8];

const fault_missing_bits: Array<u8, 30> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 110_u8, 103_u8, 32_u8, 98_u8, 105_u8, 116_u8, 115_u8, 34_u8];

const fault_missing_value: Array<u8, 33> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 110_u8, 111_u8, 110_u8, 122_u8, 101_u8, 114_u8, 111_u8, 32_u8, 109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 110_u8, 103_u8, 32_u8, 99_u8, 104_u8, 97_u8, 110_u8, 110_u8, 101_u8, 108_u8, 34_u8];

const fault_nan: Array<u8, 21> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 78_u8, 97_u8, 78_u8, 32_u8, 99_u8, 104_u8, 97_u8, 110_u8, 110_u8, 101_u8, 108_u8, 34_u8];

const usage_text: Array<u8, 29> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 99_u8, 115_u8, 115_u8, 95_u8, 99_u8, 111_u8, 108_u8, 111_u8, 114_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 30> =[99_u8, 115_u8, 115_u8, 95_u8, 99_u8, 111_u8, 108_u8, 111_u8, 114_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const malformed_text: Array<u8, 46> =[99_u8, 115_u8, 115_u8, 95_u8, 99_u8, 111_u8, 108_u8, 111_u8, 114_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 98_u8, 121_u8, 116_u8, 101_u8, 32_u8];

const source_ceiling: u64 = 16777216_u64;

const component_ceiling: u64 = 4294967295_u64;

const stray_bits: u8 = 240_u8;

const first_bit: u8 = 1_u8;

const second_bit: u8 = 2_u8;

const third_bit: u8 = 4_u8;

const alpha_bit: u8 = 8_u8;

const line_feed: u8 = 10_u8;

const left_square_bracket: u8 = 91_u8;

const right_square_bracket: u8 = 93_u8;

enum ColorFault {
  MissingBits();
  MissingValue();
  NotANumber();
}

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file: a decimal length line, that many bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let size = match parse_decimal(text: text, start: position, end: header_end) {
      Some(value: case_size) => {
        give case_size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let data_start = header_end +wrap 1_u64;
    let data_end = data_start +wrap size;
    let ordered = data_start <= data_end;
    let terminated = data_end < length;
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let terminator = text^[data_end];
    let closed = terminator == line_feed;
    if closed {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    print_case(text: text, start: data_start, end: data_end, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = data_end +wrap 1_u64;
  }
  return True();
}

fn print_case(text: &[u8], start: u64, end: u64, buffer: &Box<Slots<u8>>) -> result: unit reads(text), writes(buffer) {
  doc "Tokenizes the bytes of one case from start to end, parses the whole component list as a color and appends its JSON line, the refusal string when parse_component_values refuses it, or the fault string when the case is longer than parse_component_values admits.";
  let ordered = start <= end;
  let within = end <= text^.len;
  let located = band(ordered, within);
  let admitted = False();
  if located {
    let source = &text^[start..end];
    let small = source^.len <= source_ceiling;
    if small {
      match parse_component_values(source: source) {
        Ok(value: list) => {
          put_parsed(buffer: buffer, list: &list);
        }
        Err(error: refusal) => {
          let message = &refused_tokenizer[0_u64..refused_tokenizer.len];
          put_text(buffer: buffer, text: message);
        }
      }
      set admitted = True();
    }
  }
  if admitted {
  } else {
    let message = &fault_too_large[0_u64..fault_too_large.len];
    put_text(buffer: buffer, text: message);
  }
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_parsed(buffer: &Box<Slots<u8>>, list: &ComponentList) -> result: unit reads(list), writes(buffer) {
  doc "Parses the whole of list with parse_color and appends the result as JSON: null for Invalid, \"currentcolor\", the color, or a fault string in place of a color whose missing bits or channels break the interface.";
  let count = list^.components.inner.len;
  let fits = count <= component_ceiling;
  if fits {
  } else {
    let message = &fault_too_many[0_u64..fault_too_many.len];
    put_text(buffer: buffer, text: message);
    return unit;
  }
  let last = cvt.wrap::<u64, u32>(count);
  let whole = ComponentRange(start: 0_u32, end: last);
  match parse_color(values: list, range: whole) {
    Ok(value: parsed) => {
      match parsed {
        CurrentColor() => {
          let text = &current_color_text[0_u64..current_color_text.len];
          put_text(buffer: buffer, text: text);
        }
        Value(color: value) => {
          match check_color(color: value) {
            Ok(value: valid) => {
              put_color(buffer: buffer, color: value);
            }
            Err(error: fault) => {
              put_color_fault(buffer: buffer, fault: fault);
            }
          }
        }
      }
    }
    Err(error: failure) => {
      let text = &null_text[0_u64..null_text.len];
      put_text(buffer: buffer, text: text);
    }
  }
  return unit;
}

fn check_color(color: Color) -> result: Result<unit, ColorFault> pure {
  doc "Checks what the interface requires of a color's missing bits: MissingBits when a bit other than 0 to 3 is set, MissingValue when a set bit's channel is not zero, positive or negative, and NotANumber when a channel whose bit is clear is NaN; channels are checked first, second, third, alpha.";
  let extra = iand(color.missing, stray_bits);
  let stray = extra != 0_u8;
  if stray {
    let fault = ColorFault::MissingBits();
    return Err<unit, ColorFault>(error: fault);
  }
  let first = propagate check_channel(value: color.first, missing: color.missing, bit: first_bit);
  let second = propagate check_channel(value: color.second, missing: color.missing, bit: second_bit);
  let third = propagate check_channel(value: color.third, missing: color.missing, bit: third_bit);
  let alpha = propagate check_channel(value: color.alpha, missing: color.missing, bit: alpha_bit);
  return Ok<unit, ColorFault>(value: unit);
}

fn check_channel(value: f32, missing: u8, bit: u8) -> result: Result<unit, ColorFault> pure {
  doc "Checks one channel: a zero when bit is set in missing, and not NaN when it is clear.";
  let flag = iand(missing, bit);
  let absent = flag != 0_u8;
  if absent {
    let zero = feq(value, 0.0_f32);
    if zero {
      return Ok<unit, ColorFault>(value: unit);
    }
    let fault = ColorFault::MissingValue();
    return Err<unit, ColorFault>(error: fault);
  }
  let number = feq(value, value);
  if number {
    return Ok<unit, ColorFault>(value: unit);
  }
  let fault = ColorFault::NotANumber();
  return Err<unit, ColorFault>(error: fault);
}

fn put_color_fault(buffer: &Box<Slots<u8>>, fault: ColorFault) -> result: unit writes(buffer) {
  doc "Appends fault as a JSON string: \"driver: invalid missing bits\", \"driver: nonzero missing channel\" or \"driver: NaN channel\".";
  match fault {
    MissingBits() => {
      let text = &fault_missing_bits[0_u64..fault_missing_bits.len];
      put_text(buffer: buffer, text: text);
    }
    MissingValue() => {
      let text = &fault_missing_value[0_u64..fault_missing_value.len];
      put_text(buffer: buffer, text: text);
    }
    NotANumber() => {
      let text = &fault_nan[0_u64..fault_nan.len];
      put_text(buffer: buffer, text: text);
    }
  }
  return unit;
}

fn put_color(buffer: &Box<Slots<u8>>, color: Color) -> result: unit writes(buffer) {
  doc "Appends color as [SPACE, FIRST, SECOND, THIRD, ALPHA]: the space's name, then each channel as put_f64 writes its exact f64 value, or null when its bit in missing is set.";
  let separator = &item_separator[0_u64..item_separator.len];
  put_byte(buffer: buffer, value: left_square_bracket);
  put_space(buffer: buffer, space: color.space);
  put_text(buffer: buffer, text: separator);
  put_channel(buffer: buffer, value: color.first, missing: color.missing, bit: first_bit);
  put_text(buffer: buffer, text: separator);
  put_channel(buffer: buffer, value: color.second, missing: color.missing, bit: second_bit);
  put_text(buffer: buffer, text: separator);
  put_channel(buffer: buffer, value: color.third, missing: color.missing, bit: third_bit);
  put_text(buffer: buffer, text: separator);
  put_channel(buffer: buffer, value: color.alpha, missing: color.missing, bit: alpha_bit);
  put_byte(buffer: buffer, value: right_square_bracket);
  return unit;
}

fn put_channel(buffer: &Box<Slots<u8>>, value: f32, missing: u8, bit: u8) -> result: unit writes(buffer) {
  doc "Appends null when bit is set in missing, and otherwise value converted exactly to f64 as put_f64 writes it.";
  let flag = iand(missing, bit);
  let absent = flag != 0_u8;
  if absent {
    let text = &null_text[0_u64..null_text.len];
    put_text(buffer: buffer, text: text);
    return unit;
  }
  let wide = cvt::<f32, f64>(value);
  put_f64(buffer: buffer, value: wide);
  return unit;
}

fn put_space(buffer: &Box<Slots<u8>>, space: ColorSpace) -> result: unit writes(buffer) {
  doc "Appends the name of space as a JSON string, as color_oracle.py's SPACES spells it.";
  match space {
    Rgb() => {
      let text = &space_rgb[0_u64..space_rgb.len];
      put_text(buffer: buffer, text: text);
    }
    Lab() => {
      let text = &space_lab[0_u64..space_lab.len];
      put_text(buffer: buffer, text: text);
    }
    Lch() => {
      let text = &space_lch[0_u64..space_lch.len];
      put_text(buffer: buffer, text: text);
    }
    Oklab() => {
      let text = &space_oklab[0_u64..space_oklab.len];
      put_text(buffer: buffer, text: text);
    }
    Oklch() => {
      let text = &space_oklch[0_u64..space_oklch.len];
      put_text(buffer: buffer, text: text);
    }
    Srgb() => {
      let text = &space_srgb[0_u64..space_srgb.len];
      put_text(buffer: buffer, text: text);
    }
    SrgbLinear() => {
      let text = &space_srgb_linear[0_u64..space_srgb_linear.len];
      put_text(buffer: buffer, text: text);
    }
    DisplayP3() => {
      let text = &space_display_p3[0_u64..space_display_p3.len];
      put_text(buffer: buffer, text: text);
    }
    A98Rgb() => {
      let text = &space_a98_rgb[0_u64..space_a98_rgb.len];
      put_text(buffer: buffer, text: text);
    }
    ProphotoRgb() => {
      let text = &space_prophoto_rgb[0_u64..space_prophoto_rgb.len];
      put_text(buffer: buffer, text: text);
    }
    Rec2020() => {
      let text = &space_rec2020[0_u64..space_rec2020.len];
      put_text(buffer: buffer, text: text);
    }
    XyzD50() => {
      let text = &space_xyz_d50[0_u64..space_xyz_d50.len];
      put_text(buffer: buffer, text: text);
    }
    XyzD65() => {
      let text = &space_xyz_d65[0_u64..space_xyz_d65.len];
      put_text(buffer: buffer, text: text);
    }
  }
  return unit;
}
