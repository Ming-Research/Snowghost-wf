const space_rgb: Array<u8, 5> =[34_u8, 114_u8, 103_u8, 98_u8, 34_u8];

const space_lab: Array<u8, 5> =[34_u8, 108_u8, 97_u8, 98_u8, 34_u8];

const space_lch: Array<u8, 5> =[34_u8, 108_u8, 99_u8, 104_u8, 34_u8];

const space_oklab: Array<u8, 7> =[34_u8, 111_u8, 107_u8, 108_u8, 97_u8, 98_u8, 34_u8];

