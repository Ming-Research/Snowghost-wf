alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias Face = pkg::font::Face;
alias FaceMetrics = pkg::font::FaceMetrics;
alias FontError = pkg::font::FontError;
alias GlyphClass = pkg::font::GlyphClass;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias face_metrics = pkg::font::face_metrics;
alias flush = pkg::oracle::support::flush;
alias glyph_advance = pkg::font::glyph_advance;
alias glyph_class = pkg::font::glyph_class;
alias load_face = pkg::font::load_face;
alias nominal_glyph = pkg::font::nominal_glyph;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_hex = pkg::oracle::support::put_hex;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;

const metrics_word: Array<u8, 7> =[109_u8, 101_u8, 116_u8, 114_u8, 105_u8, 99_u8, 115_u8];

const cmap_word: Array<u8, 5> =[99_u8, 109_u8, 97_u8, 112_u8, 32_u8];

const advance_word: Array<u8, 8> =[97_u8, 100_u8, 118_u8, 97_u8, 110_u8, 99_u8, 101_u8, 32_u8];

const class_word: Array<u8, 6> =[99_u8, 108_u8, 97_u8, 115_u8, 115_u8, 32_u8];

const end_line: Array<u8, 4> =[101_u8, 110_u8, 100_u8, 10_u8];

const refused_invalid_line: Array<u8, 16> =[114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8, 73_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 10_u8];

const refused_unsupported_line: Array<u8, 20> =[114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8, 85_u8, 110_u8, 115_u8, 117_u8, 112_u8, 112_u8, 111_u8, 114_u8, 116_u8, 101_u8, 100_u8, 10_u8];

const refused_too_large_line: Array<u8, 17> =[114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8, 84_u8, 111_u8, 111_u8, 76_u8, 97_u8, 114_u8, 103_u8, 101_u8, 10_u8];

const font_too_large_line: Array<u8, 23> =[100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 102_u8, 111_u8, 110_u8, 116_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 10_u8];

const usage_text: Array<u8, 29> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 102_u8, 111_u8, 110_u8, 116_u8, 95_u8, 102_u8, 97_u8, 99_u8, 101_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 70_u8, 79_u8, 78_u8, 84_u8, 10_u8];

const unreadable_text: Array<u8, 30> =[102_u8, 111_u8, 110_u8, 116_u8, 95_u8, 102_u8, 97_u8, 99_u8, 101_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const unwritable_text: Array<u8, 50> =[102_u8, 111_u8, 110_u8, 116_u8, 95_u8, 102_u8, 97_u8, 99_u8, 101_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 115_u8, 116_u8, 97_u8, 110_u8, 100_u8, 97_u8, 114_u8, 100_u8, 32_u8, 111_u8, 117_u8, 116_u8, 112_u8, 117_u8, 116_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8, 97_u8, 32_u8, 119_u8, 114_u8, 105_u8, 116_u8, 101_u8, 10_u8];

const face_ceiling: u64 = 268435456_u64;

const surrogate_first: u64 = 55296_u64;

const surrogate_after: u64 = 57344_u64;

const code_space: u64 = 1114112_u64;

const flush_threshold: u64 = 65536_u64;

const output_capacity: u64 = 131072_u64;

const report_capacity: u64 = 4096_u64;

const space: u8 = 32_u8;

const line_feed: u8 = 10_u8;

const minus_sign: u8 = 45_u8;

const digit_zero: u8 = 48_u8;

const digit_one: u8 = 49_u8;

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints the font's dump and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = judge_font(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_font(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the font the one argument names and prints its dump, its refusal or the fault line. Returns 0 when standard output took every line, and 2, after a message on standard error, for a wrong argument count, an unreadable font or a refused write.";
  let report = box_slots_new::<u8>(capacity: report_capacity);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let noted = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  let delivered = False();
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let data = &content.inner[0_u64..length];
      set delivered = print_font(data: data, out: out, files: files);
    }
    Err(error: problem) => {
      let oversized = file_too_large(problem: problem);
      if oversized {
        let fault = &font_too_large_line[0_u64..font_too_large_line.len];
        set delivered = print_line(line: fault, out: out, files: files);
      } else {
        let message = &unreadable_text[0_u64..unreadable_text.len];
        put_text(buffer: &report, text: message);
        put_argument(buffer: &report, args: args, position: 1_u64);
        put_host_error(buffer: &report, error: problem);
        put_byte(buffer: &report, value: line_feed);
        let noted = flush(factory: files, output: err, buffer: &report);
        return 2_u8;
      }
    }
  }
  if delivered {
    return 0_u8;
  }
  let message = &unwritable_text[0_u64..unwritable_text.len];
  put_text(buffer: &report, text: message);
  let noted = flush(factory: files, output: err, buffer: &report);
  return 2_u8;
}

fn file_too_large(problem: IoError) -> result: Bool pure {
  doc "Tells whether a read failed because the file is too large to read: FileTooLarge, which read_argument_file also returns for a file past its 2^30-byte limit.";
  match problem {
    NotFound(..) => {
      return False();
    }
    PermissionDenied(..) => {
      return False();
    }
    AlreadyExists(..) => {
      return False();
    }
    NotDirectory(..) => {
      return False();
    }
    IsDirectory(..) => {
      return False();
    }
    DirectoryNotEmpty(..) => {
      return False();
    }
    ReadOnly(..) => {
      return False();
    }
    ResourceBusy(..) => {
      return False();
    }
    InvalidInput(..) => {
      return False();
    }
    InvalidPath(..) => {
      return False();
    }
    Unsupported(..) => {
      return False();
    }
    TimedOut(..) => {
      return False();
    }
    BrokenPipe(..) => {
      return False();
    }
    WriteZero(..) => {
      return False();
    }
    UnexpectedEnd(..) => {
      return False();
    }
    ConnectionRefused(..) => {
      return False();
    }
    ConnectionReset(..) => {
      return False();
    }
    ConnectionAborted(..) => {
      return False();
    }
    NotConnected(..) => {
      return False();
    }
    AddressInUse(..) => {
      return False();
    }
    AddressUnavailable(..) => {
      return False();
    }
    ResourceExhausted(..) => {
      return False();
    }
    FileTooLarge(..) => {
      return True();
    }
    NoSpace(..) => {
      return False();
    }
    QuotaExceeded(..) => {
      return False();
    }
    CrossDevice(..) => {
      return False();
    }
    DeviceFailure(..) => {
      return False();
    }
    Other(..) => {
      return False();
    }
  }
}

fn print_line(line: &[u8], out: &OutputStream, files: &HandleFactory) -> delivered: Bool reads(line), writes(out), writes(files) waits {
  doc "Prints one line on standard output; returns False when standard output refuses the write.";
  let output = box_slots_new::<u8>(capacity: report_capacity);
  put_text(buffer: &output, text: line);
  let sent = flush(factory: files, output: out, buffer: &output);
  return sent;
}

fn print_font(data: &[u8], out: &OutputStream, files: &HandleFactory) -> delivered: Bool reads(data), writes(out), writes(files) waits {
  doc "Prints the fault line for data longer than load_face accepts, without calling it; otherwise loads data with load_face and prints the face's dump or the line that names the refusal. Returns False when standard output refuses a write.";
  let fits = data^.len <= face_ceiling;
  if fits {
  } else {
    let fault = &font_too_large_line[0_u64..font_too_large_line.len];
    let sent = print_line(line: fault, out: out, files: files);
    return sent;
  }
  match load_face(data: data) {
    Ok(value: face) => {
      let output = box_slots_new::<u8>(capacity: output_capacity);
      let dumped = put_dump(face: &face, out: out, files: files, output: &output);
      return dumped;
    }
    Err(error: refusal) => {
      let output = box_slots_new::<u8>(capacity: report_capacity);
      put_refusal(buffer: &output, refusal: refusal);
      let sent = flush(factory: files, output: out, buffer: &output);
      return sent;
    }
  }
}

fn put_refusal(buffer: &Box<Slots<u8>>, refusal: FontError) -> result: unit writes(buffer) {
  doc "Writes the line that names load_face's refusal: `refused Invalid`, `refused Unsupported` or `refused TooLarge`.";
  match refusal {
    Invalid() => {
      let line = &refused_invalid_line[0_u64..refused_invalid_line.len];
      put_text(buffer: buffer, text: line);
    }
    Unsupported() => {
      let line = &refused_unsupported_line[0_u64..refused_unsupported_line.len];
      put_text(buffer: buffer, text: line);
    }
    TooLarge() => {
      let line = &refused_too_large_line[0_u64..refused_too_large_line.len];
      put_text(buffer: buffer, text: line);
    }
  }
  return unit;
}

fn drain(files: &HandleFactory, out: &OutputStream, output: &Box<Slots<u8>>) -> delivered: Bool writes(files), writes(out), writes(output) waits {
  doc "Flushes output to standard output once it holds flush_threshold bytes. Returns False when that flush fails and True otherwise.";
  let full = output^.inner.len >= flush_threshold;
  if full {
    let sent = flush(factory: files, output: out, buffer: output);
    return sent;
  }
  return True();
}

fn put_dump(face: &Face, out: &OutputStream, files: &HandleFactory, output: &Box<Slots<u8>>) -> delivered: Bool reads(face), writes(out), writes(files), writes(output) waits {
  doc "Prints the metrics line, the cmap lines of the scalar values below and above the surrogates, the advance and class lines and `end`, flushing output whenever it fills and once at the end. Returns False when a flush fails.";
  let metrics = face_metrics(face: face);
  put_metrics(buffer: output, metrics: metrics);
  let below = put_mappings(face: face, from: 0_u64, to: surrogate_first, out: out, files: files, output: output);
  let above = put_mappings(face: face, from: surrogate_after, to: code_space, out: out, files: files, output: output);
  let glyph_count = cvt::<u16, u64>(metrics.glyph_count);
  let advances = put_advances(face: face, count: glyph_count, out: out, files: files, output: output);
  let classes = put_classes(face: face, count: glyph_count, out: out, files: files, output: output);
  let ending = &end_line[0_u64..end_line.len];
  put_text(buffer: output, text: ending);
  let last = flush(factory: files, output: out, buffer: output);
  let mapped = band(below, above);
  let listed = band(advances, classes);
  let written = band(mapped, listed);
  let complete = band(written, last);
  return complete;
}

fn put_metrics(buffer: &Box<Slots<u8>>, metrics: FaceMetrics) -> result: unit writes(buffer) {
  doc "Writes the metrics line: `metrics` and the eleven fields of metrics in declared order, each after one space, use_typo_metrics as 1 for True and 0 for False.";
  let label = &metrics_word[0_u64..metrics_word.len];
  put_text(buffer: buffer, text: label);
  let units = cvt::<u16, u64>(metrics.units_per_em);
  put_unsigned_field(buffer: buffer, value: units);
  let glyphs = cvt::<u16, u64>(metrics.glyph_count);
  put_unsigned_field(buffer: buffer, value: glyphs);
  let ascender = cvt::<i16, i64>(metrics.hhea_ascender);
  put_signed_field(buffer: buffer, value: ascender);
  let descender = cvt::<i16, i64>(metrics.hhea_descender);
  put_signed_field(buffer: buffer, value: descender);
  let line_gap = cvt::<i16, i64>(metrics.hhea_line_gap);
  put_signed_field(buffer: buffer, value: line_gap);
  let typo_ascender = cvt::<i16, i64>(metrics.typo_ascender);
  put_signed_field(buffer: buffer, value: typo_ascender);
  let typo_descender = cvt::<i16, i64>(metrics.typo_descender);
  put_signed_field(buffer: buffer, value: typo_descender);
  let typo_line_gap = cvt::<i16, i64>(metrics.typo_line_gap);
  put_signed_field(buffer: buffer, value: typo_line_gap);
  let typo_flag = metrics.use_typo_metrics;
  let flag_digit = if typo_flag {
    give digit_one;
  } else {
    give digit_zero;
  }
  put_byte(buffer: buffer, value: space);
  put_byte(buffer: buffer, value: flag_digit);
  let win_ascent = cvt::<u16, u64>(metrics.win_ascent);
  put_unsigned_field(buffer: buffer, value: win_ascent);
  let win_descent = cvt::<u16, u64>(metrics.win_descent);
  put_unsigned_field(buffer: buffer, value: win_descent);
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_unsigned_field(buffer: &Box<Slots<u8>>, value: u64) -> result: unit writes(buffer) {
  doc "Appends one space and the decimal spelling of value.";
  put_byte(buffer: buffer, value: space);
  put_decimal(buffer: buffer, value: value);
  return unit;
}

fn put_signed_field(buffer: &Box<Slots<u8>>, value: i64) -> result: unit writes(buffer) {
  doc "Appends one space and the decimal spelling of value, a negative value after a minus sign.";
  put_byte(buffer: buffer, value: space);
  let bits = cvt.wrap::<i64, u64>(value);
  let negative = value < 0_i64;
  if negative {
    put_byte(buffer: buffer, value: minus_sign);
    let magnitude = 0_u64 -wrap bits;
    put_decimal(buffer: buffer, value: magnitude);
  } else {
    put_decimal(buffer: buffer, value: bits);
  }
  return unit;
}

fn put_mappings(face: &Face, from: u64, to: u64, out: &OutputStream, files: &HandleFactory, output: &Box<Slots<u8>>) -> delivered: Bool reads(face), writes(out), writes(files), writes(output) waits {
  doc "Prints `cmap SCALAR GLYPH` for every code point from from up to to, which lie below 2^32, whose nominal glyph is not 0, flushing output whenever it fills. Returns False when a flush fails.";
  let label = &cmap_word[0_u64..cmap_word.len];
  let lowercase = False();
  let sent_all = True();
  for (value in from..to) {
    let scalar = cvt.wrap::<u64, u32>(value);
    let glyph = nominal_glyph(face: face, scalar: scalar);
    let mapped = glyph != 0_u16;
    if mapped {
      put_text(buffer: output, text: label);
      put_hex(buffer: output, value: value, width: 1_u64, uppercase: lowercase);
      let number = cvt::<u16, u64>(glyph);
      put_unsigned_field(buffer: output, value: number);
      put_byte(buffer: output, value: line_feed);
      let sent = drain(files: files, out: out, output: output);
      set sent_all = band(sent_all, sent);
    }
  }
  return sent_all;
}

fn put_advances(face: &Face, count: u64, out: &OutputStream, files: &HandleFactory, output: &Box<Slots<u8>>) -> delivered: Bool reads(face), writes(out), writes(files), writes(output) waits {
  doc "Prints `advance GLYPH ADVANCE` for every glyph below count, which is at most 65536, flushing output whenever it fills. Returns False when a flush fails.";
  let label = &advance_word[0_u64..advance_word.len];
  let sent_all = True();
  for (index in 0_u64..count) {
    let glyph = cvt.wrap::<u64, u16>(index);
    let advance = glyph_advance(face: face, glyph: glyph);
    let width = cvt::<u16, u64>(advance);
    put_text(buffer: output, text: label);
    put_decimal(buffer: output, value: index);
    put_unsigned_field(buffer: output, value: width);
    put_byte(buffer: output, value: line_feed);
    let sent = drain(files: files, out: out, output: output);
    set sent_all = band(sent_all, sent);
  }
  return sent_all;
}

fn put_classes(face: &Face, count: u64, out: &OutputStream, files: &HandleFactory, output: &Box<Slots<u8>>) -> delivered: Bool reads(face), writes(out), writes(files), writes(output) waits {
  doc "Prints `class GLYPH CLASS` for every glyph below count, which is at most 65536, flushing output whenever it fills. Returns False when a flush fails.";
  let label = &class_word[0_u64..class_word.len];
  let sent_all = True();
  for (index in 0_u64..count) {
    let glyph = cvt.wrap::<u64, u16>(index);
    let kind = glyph_class(face: face, glyph: glyph);
    let number = class_number(kind: kind);
    put_text(buffer: output, text: label);
    put_decimal(buffer: output, value: index);
    put_unsigned_field(buffer: output, value: number);
    put_byte(buffer: output, value: line_feed);
    let sent = drain(files: files, out: out, output: output);
    set sent_all = band(sent_all, sent);
  }
  return sent_all;
}

fn class_number(kind: GlyphClass) -> result: u64 pure {
  doc "Returns the number the dump gives a glyph class: 0 to 4 in GlyphClass's declared order.";
  match kind {
    Unclassified() => {
      return 0_u64;
    }
    Base() => {
      return 1_u64;
    }
    Ligature() => {
      return 2_u64;
    }
    Mark() => {
      return 3_u64;
    }
    Component() => {
      return 4_u64;
    }
  }
}
