alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias Face = pkg::font::Face;
alias FontError = pkg::font::FontError;
alias GlyphRun = pkg::font::GlyphRun;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias Script = pkg::font::Script;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias load_face = pkg::font::load_face;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;
alias shape_run = pkg::font::shape_run;

const usage_text: Array<u8, 39> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 102_u8, 111_u8, 110_u8, 116_u8, 95_u8, 115_u8, 104_u8, 97_u8, 112_u8, 101_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 70_u8, 79_u8, 78_u8, 84_u8, 46_u8, 46_u8, 46_u8, 32_u8, 67_u8, 65_u8, 83_u8, 69_u8, 83_u8, 10_u8];

const program_prefix: Array<u8, 19> =[102_u8, 111_u8, 110_u8, 116_u8, 95_u8, 115_u8, 104_u8, 97_u8, 112_u8, 101_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8];

const cannot_read_text: Array<u8, 12> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const refused_text: Array<u8, 18> =[108_u8, 111_u8, 97_u8, 100_u8, 95_u8, 102_u8, 97_u8, 99_u8, 101_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8];

const invalid_text: Array<u8, 11> =[32_u8, 40_u8, 73_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 41_u8, 10_u8];

const unsupported_text: Array<u8, 15> =[32_u8, 40_u8, 85_u8, 110_u8, 115_u8, 117_u8, 112_u8, 112_u8, 111_u8, 114_u8, 116_u8, 101_u8, 100_u8, 41_u8, 10_u8];

const too_large_text: Array<u8, 12> =[32_u8, 40_u8, 84_u8, 111_u8, 111_u8, 76_u8, 97_u8, 114_u8, 103_u8, 101_u8, 41_u8, 10_u8];

const oversized_text: Array<u8, 34> =[32_u8, 105_u8, 115_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 101_u8, 114_u8, 32_u8, 116_u8, 104_u8, 97_u8, 110_u8, 32_u8, 108_u8, 111_u8, 97_u8, 100_u8, 95_u8, 102_u8, 97_u8, 99_u8, 101_u8, 32_u8, 97_u8, 99_u8, 99_u8, 101_u8, 112_u8, 116_u8, 115_u8, 10_u8];

const malformed_text: Array<u8, 23> =[109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 32_u8];

const of_text: Array<u8, 4> =[32_u8, 111_u8, 102_u8, 32_u8];

const unwritable_text: Array<u8, 32> =[115_u8, 116_u8, 97_u8, 110_u8, 100_u8, 97_u8, 114_u8, 100_u8, 32_u8, 111_u8, 117_u8, 116_u8, 112_u8, 117_u8, 116_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 32_u8, 97_u8, 32_u8, 119_u8, 114_u8, 105_u8, 116_u8, 101_u8, 10_u8];

const shape_fault: Array<u8, 19> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const length_fault: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const item_separator: Array<u8, 2> =[44_u8, 32_u8];

const face_ceiling: u64 = 268435456_u64;

const shape_ceiling: u64 = 16777216_u64;

const script_count: u64 = 4_u64;

const font_limit: u64 = 65536_u64;

const flush_threshold: u64 = 65536_u64;

const output_capacity: u64 = 131072_u64;

const report_capacity: u64 = 4096_u64;

const space: u8 = 32_u8;

const line_feed: u8 = 10_u8;

const minus_sign: u8 = 45_u8;

const left_square_bracket: u8 = 91_u8;

const right_square_bracket: u8 = 93_u8;

const digit_zero: u8 = 48_u8;

const digit_nine: u8 = 57_u8;

const lower_a: u8 = 97_u8;

const lower_f: u8 = 102_u8;

const no_hex_digit: u8 = 16_u8;

const value_digit_limit: u64 = 8_u64;

struct Header {
  font: u64;
  script: u64;
  count: u64;
}

fn run(inputs: Inputs) -> status: ExitStatus pure {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Loads the fonts, the arguments before the last, reads the case file, the last argument, and prints its cases. Returns the code print_cases returns, or 2, after a message on standard error, when the arguments name no font or more than font_limit fonts, or a font or the case file cannot be used.";
  let report = box_slots_new::<u8>(capacity: report_capacity);
  let count = args_count(args: args);
  let font_count = count -wrap 2_u64;
  let cases_position = count -wrap 1_u64;
  let some_font = count >= 3_u64;
  let few_fonts = font_count <= font_limit;
  let usable = band(some_font, few_fonts);
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let noted = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match load_fonts(args: args, cwd: cwd, err: err, files: files, report: &report, font_count: font_count) {
    Some(value: faces) => {
      match read_argument_file(factory: files, cwd: cwd, args: args, position: cases_position) {
        Ok(value: content) => {
          let length = content.inner.len;
          let text = &content.inner[0_u64..length];
          let loaded = faces.inner.len;
          let face_view = &faces.inner[0_u64..loaded];
          let code = print_cases(text: text, faces: face_view, args: args, cases_position: cases_position, out: out, err: err, files: files, report: &report);
          return code;
        }
        Err(error: problem) => {
          report_unreadable(err: err, files: files, report: &report, args: args, position: cases_position, problem: problem);
          return 2_u8;
        }
      }
    }
    None() => {
      return 2_u8;
    }
  }
}

fn put_program_prefix(report: &Box<Slots<u8>>) -> result: unit writes(report) {
  doc "Writes `font_shape_oracle: ` to the report.";
  let prefix = &program_prefix[0_u64..program_prefix.len];
  put_text(buffer: report, text: prefix);
  return unit;
}

fn report_unreadable(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, position: u64, problem: IoError) -> result: unit reads(args), writes(err), writes(files), writes(report) {
  doc "Prints `font_shape_oracle: cannot read FILE` on standard error, naming the argument at position, with the host error code.";
  put_program_prefix(report: report);
  let reason = &cannot_read_text[0_u64..cannot_read_text.len];
  put_text(buffer: report, text: reason);
  put_argument(buffer: report, args: args, position: position);
  put_host_error(buffer: report, error: problem);
  put_byte(buffer: report, value: line_feed);
  let noted = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_oversized(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, position: u64) -> result: unit reads(args), writes(err), writes(files), writes(report) {
  doc "Prints `font_shape_oracle: FONT is longer than load_face accepts` on standard error, naming the argument at position.";
  put_program_prefix(report: report);
  put_argument(buffer: report, args: args, position: position);
  let reason = &oversized_text[0_u64..oversized_text.len];
  put_text(buffer: report, text: reason);
  let noted = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_refusal(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, position: u64, refusal: FontError) -> result: unit reads(args), writes(err), writes(files), writes(report) {
  doc "Prints `font_shape_oracle: load_face refused FONT (ERROR)` on standard error, naming the argument at position and the FontError variant.";
  put_program_prefix(report: report);
  let reason = &refused_text[0_u64..refused_text.len];
  put_text(buffer: report, text: reason);
  put_argument(buffer: report, args: args, position: position);
  match refusal {
    Invalid() => {
      let name = &invalid_text[0_u64..invalid_text.len];
      put_text(buffer: report, text: name);
    }
    Unsupported() => {
      let name = &unsupported_text[0_u64..unsupported_text.len];
      put_text(buffer: report, text: name);
    }
    TooLarge() => {
      let name = &too_large_text[0_u64..too_large_text.len];
      put_text(buffer: report, text: name);
    }
  }
  let noted = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn load_fonts(args: &Args, cwd: &DirectoryRead, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, font_count: u64) -> faces: Option<Box<Slots<Face>>> reads(args), reads(cwd), writes(err), writes(files), writes(report) contract {
  requires font_count <= 65536_u64;
} {
  doc "Loads the font_count fonts that the arguments from position 1 name, each once with load_face, in order. Returns None, after a message on standard error, when a font cannot be read, is longer than load_face accepts or is refused.";
  let loaded = box_slots_new::<Face>(capacity: font_count);
  for @fonts (
    index in 0_u64..font_count,
    invariant filled: loaded.inner.len == index
  ) {
    let position = index +wrap 1_u64;
    match read_argument_file(factory: files, cwd: cwd, args: args, position: position) {
      Ok(value: content) => {
        let length = content.inner.len;
        let data = &content.inner[0_u64..length];
        let fits = data^.len <= face_ceiling;
        if fits {
        } else {
          report_oversized(err: err, files: files, report: report, args: args, position: position);
          return None<Box<Slots<Face>>>();
        }
        match load_face(data: data) {
          Ok(value: face) => {
            place_back(window: &loaded.inner, value: move face);
          }
          Err(error: refusal) => {
            report_refusal(err: err, files: files, report: report, args: args, position: position, refusal: refusal);
            return None<Box<Slots<Face>>>();
          }
        }
      }
      Err(error: problem) => {
        report_unreadable(err: err, files: files, report: report, args: args, position: position, problem: problem);
        return None<Box<Slots<Face>>>();
      }
    }
  }
  return Some<Box<Slots<Face>>>(value: move loaded);
}

fn print_cases(text: &[u8], faces: &[Face], args: &Args, cases_position: u64, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> code: u8 reads(text), reads(faces), reads(args), writes(out), writes(err), writes(files), writes(report) {
  doc "Walks the case file two lines per case and prints each case's line, flushing standard output whenever the lines fill output and at the end. Returns 0 after the last case, and 2, after a message on standard error, for the first malformed case, once the lines of the cases before it are flushed, or when standard output refused a write.";
  let output = box_slots_new::<u8>(capacity: output_capacity);
  let length = text^.len;
  let face_count = faces^.len;
  let position = 0_u64;
  let line_number = 1_u64;
  let sent_all = True();
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let values_start = header_end +wrap 1_u64;
    let values_end = line_end(text: text, start: values_start);
    let closed = values_end < length;
    let well_formed = False();
    match parse_header(text: text, start: position, end: header_end) {
      Some(value: header) => {
        let font_index = header.font;
        let script_index = header.script;
        let expected = header.count;
        let font_known = font_index < face_count;
        let script_known = script_index < script_count;
        let indexed = band(font_known, script_known);
        let usable = band(indexed, closed);
        if usable {
          let counter = box_slots_new::<u32>(capacity: 0_u64);
          match parse_values(text: text, start: values_start, end: values_end, values: &counter) {
            Some(value: found) => {
              let counted = found == expected;
              if counted {
                set well_formed = True();
                let fits = found <= shape_ceiling;
                if fits {
                  let values = box_slots_new::<u32>(capacity: found);
                  let refound = parse_values(text: text, start: values_start, end: values_end, values: &values);
                  let stored = values.inner.len;
                  let view = &values.inner[0_u64..stored];
                  let face = &faces^[font_index];
                  let script = script_of(index: script_index);
                  let sent = print_case(face: face, script: script, values: view, output: &output, out: out, files: files);
                  set sent_all = band(sent_all, sent);
                } else {
                  put_length_fault(output: &output);
                  let sent = drain(files: files, out: out, output: &output);
                  set sent_all = band(sent_all, sent);
                }
              }
            }
            None() => {
            }
          }
        }
      }
      None() => {
      }
    }
    if well_formed {
    } else {
      let flushed = flush(factory: files, output: out, buffer: &output);
      put_program_prefix(report: report);
      let reason = &malformed_text[0_u64..malformed_text.len];
      put_text(buffer: report, text: reason);
      put_decimal(buffer: report, value: line_number);
      let of_label = &of_text[0_u64..of_text.len];
      put_text(buffer: report, text: of_label);
      put_argument(buffer: report, args: args, position: cases_position);
      put_byte(buffer: report, value: line_feed);
      let noted = flush(factory: files, output: err, buffer: report);
      return 2_u8;
    }
    set position = values_end +wrap 1_u64;
    set line_number = line_number +wrap 2_u64;
  }
  let last = flush(factory: files, output: out, buffer: &output);
  let delivered = band(sent_all, last);
  if delivered {
    return 0_u8;
  }
  put_program_prefix(report: report);
  let reason = &unwritable_text[0_u64..unwritable_text.len];
  put_text(buffer: report, text: reason);
  let noted = flush(factory: files, output: err, buffer: report);
  return 2_u8;
}

fn space_or_end(text: &[u8], from: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first space from from to end, or end, which it also returns when from is past end or end is past the text.";
  let within = end <= text^.len;
  let ordered = from <= end;
  let located = band(within, ordered);
  if located {
  } else {
    return end;
  }
  for (at in from..end) {
    let byte = text^[at];
    let found = byte == space;
    if found {
      return at;
    }
  }
  return end;
}

fn parse_header(text: &[u8], start: u64, end: u64) -> header: Option<Header> reads(text) {
  doc "Parses the header line from start to end: FONT, SCRIPT and COUNT, three decimal numbers of 1 to 18 digits separated by single spaces. Returns None for a line of any other shape.";
  let first_end = space_or_end(text: text, from: start, end: end);
  let second_start = first_end +wrap 1_u64;
  let second_end = space_or_end(text: text, from: second_start, end: end);
  let third_start = second_end +wrap 1_u64;
  let first = parse_decimal(text: text, start: start, end: first_end);
  let second = parse_decimal(text: text, start: second_start, end: second_end);
  let third = parse_decimal(text: text, start: third_start, end: end);
  match first {
    Some(value: font) => {
      match second {
        Some(value: script) => {
          match third {
            Some(value: count) => {
              let parsed = Header(font: font, script: script, count: count);
              return Some<Header>(value: parsed);
            }
            None() => {
              return None<Header>();
            }
          }
        }
        None() => {
          return None<Header>();
        }
      }
    }
    None() => {
      return None<Header>();
    }
  }
}

fn hex_digit(byte: u8) -> result: u8 pure {
  doc "Returns the value of one ASCII lowercase hexadecimal digit, or no_hex_digit for any other byte.";
  let decimal_low = byte >= digit_zero;
  let decimal_high = byte <= digit_nine;
  let decimal = band(decimal_low, decimal_high);
  if decimal {
    return byte -wrap digit_zero;
  }
  let letter_low = byte >= lower_a;
  let letter_high = byte <= lower_f;
  let letter = band(letter_low, letter_high);
  if letter {
    let offset = byte -wrap lower_a;
    return offset +wrap 10_u8;
  }
  return no_hex_digit;
}

fn parse_values(text: &[u8], start: u64, end: u64, values: &Box<Slots<u32>>) -> found: Option<u64> reads(text), writes(values) {
  doc "Parses the values line from start to end: nothing, or values of 1 to 8 lowercase hexadecimal digits separated by single spaces, so every value fits in u32. Appends each value to values while it has room and returns how many values the line holds, or None for a line of any other shape.";
  let within = end <= text^.len;
  let ordered = start <= end;
  let located = band(within, ordered);
  if located {
  } else {
    return None<u64>();
  }
  let empty = start == end;
  if empty {
    return Some<u64>(value: 0_u64);
  }
  let count = 0_u64;
  let at = start;
  loop @values {
    let value = 0_u32;
    let digits = 0_u64;
    loop @digits {
      let inside = at < end;
      if inside {
      } else {
        break @digits;
      }
      let byte = text^[at];
      let digit = hex_digit(byte: byte);
      let valid = digit < no_hex_digit;
      if valid {
      } else {
        break @digits;
      }
      set digits = digits +wrap 1_u64;
      let long = digits > value_digit_limit;
      if long {
        return None<u64>();
      }
      let widened = cvt::<u8, u32>(digit);
      let shifted = ishl.wrap(value, 4_u32);
      set value = ior(shifted, widened);
      set at = at +wrap 1_u64;
    }
    let none = digits == 0_u64;
    if none {
      return None<u64>();
    }
    let room = values^.inner.len < values^.inner.cap;
    if room {
      place_back(window: &values^.inner, value: value);
    }
    set count = count +wrap 1_u64;
    let finished = at >= end;
    if finished {
      break @values;
    }
    let separator = text^[at];
    let spaced = separator == space;
    if spaced {
    } else {
      return None<u64>();
    }
    set at = at +wrap 1_u64;
  }
  return Some<u64>(value: count);
}

fn script_of(index: u64) -> script: Script pure {
  doc "Returns the script a SCRIPT index below script_count names: Common, Latin, Greek or Cyrillic for 0 to 3.";
  let common = index == 0_u64;
  if common {
    return Script::Common();
  }
  let latin = index == 1_u64;
  if latin {
    return Script::Latin();
  }
  let greek = index == 2_u64;
  if greek {
    return Script::Greek();
  }
  return Script::Cyrillic();
}

fn drain(files: &HandleFactory, out: &OutputStream, output: &Box<Slots<u8>>) -> delivered: Bool writes(files), writes(out), writes(output) {
  doc "Flushes output to standard output once it holds flush_threshold bytes. Returns False when that flush fails and True otherwise.";
  let full = output^.inner.len >= flush_threshold;
  if full {
    let sent = flush(factory: files, output: out, buffer: output);
    return sent;
  }
  return True();
}

fn put_length_fault(output: &Box<Slots<u8>>) -> result: unit writes(output) {
  doc "Appends the line of a case longer than shape_run accepts: the JSON string \"driver: case too large\".";
  let fault = &length_fault[0_u64..length_fault.len];
  put_text(buffer: output, text: fault);
  put_byte(buffer: output, value: line_feed);
  return unit;
}

fn print_case(face: &Face, script: Script, values: &[u32], output: &Box<Slots<u8>>, out: &OutputStream, files: &HandleFactory) -> delivered: Bool reads(face), reads(values), writes(output), writes(out), writes(files) {
  doc "Appends the case's line to output: the run shape_run returns for values in script with face as put_run writes it, the fault string for TooLarge, or, without calling shape_run, the length fault string for values longer than it accepts. Flushes output whenever it fills; returns False when a flush fails.";
  let fits = values^.len <= shape_ceiling;
  if fits {
  } else {
    put_length_fault(output: output);
    let sent = drain(files: files, out: out, output: output);
    return sent;
  }
  let sent_all = True();
  match shape_run(face: face, text: values, script: script) {
    Ok(value: glyphs) => {
      set sent_all = put_run(shaped: &glyphs, output: output, out: out, files: files);
    }
    Err(error: problem) => {
      match problem {
        TooLarge() => {
          let fault = &shape_fault[0_u64..shape_fault.len];
          put_text(buffer: output, text: fault);
        }
      }
    }
  }
  put_byte(buffer: output, value: line_feed);
  let sent = drain(files: files, out: out, output: output);
  let complete = band(sent_all, sent);
  return complete;
}

fn put_run(shaped: &GlyphRun, output: &Box<Slots<u8>>, out: &OutputStream, files: &HandleFactory) -> delivered: Bool reads(shaped), writes(output), writes(out), writes(files) {
  doc "Appends shaped as a JSON array holding, for each ShapedGlyph in order, the array [glyph, cluster, x_advance, y_advance, x_offset, y_offset] in decimal, items separated by a comma and a space. Flushes output whenever it fills; returns False when a flush fails.";
  let count = shaped^.glyphs.inner.len;
  let separator = &item_separator[0_u64..item_separator.len];
  let sent_all = True();
  put_byte(buffer: output, value: left_square_bracket);
  for (index in 0_u64..count) {
    let later = index > 0_u64;
    if later {
      put_text(buffer: output, text: separator);
    }
    let item = shaped^.glyphs.inner[index];
    put_byte(buffer: output, value: left_square_bracket);
    let glyph = cvt::<u16, u64>(item.glyph);
    put_decimal(buffer: output, value: glyph);
    put_text(buffer: output, text: separator);
    let cluster = cvt::<u32, u64>(item.cluster);
    put_decimal(buffer: output, value: cluster);
    let x_advance = cvt::<i32, i64>(item.x_advance);
    put_signed_item(buffer: output, value: x_advance);
    let y_advance = cvt::<i32, i64>(item.y_advance);
    put_signed_item(buffer: output, value: y_advance);
    let x_offset = cvt::<i32, i64>(item.x_offset);
    put_signed_item(buffer: output, value: x_offset);
    let y_offset = cvt::<i32, i64>(item.y_offset);
    put_signed_item(buffer: output, value: y_offset);
    put_byte(buffer: output, value: right_square_bracket);
    let sent = drain(files: files, out: out, output: output);
    set sent_all = band(sent_all, sent);
  }
  put_byte(buffer: output, value: right_square_bracket);
  return sent_all;
}

fn put_signed_item(buffer: &Box<Slots<u8>>, value: i64) -> result: unit writes(buffer) {
  doc "Appends a comma, a space and the decimal spelling of value, a negative value after a minus sign.";
  let separator = &item_separator[0_u64..item_separator.len];
  put_text(buffer: buffer, text: separator);
  let bits = cvt.wrap::<i64, u64>(value);
  let negative = value < 0_i64;
  if negative {
    put_byte(buffer: buffer, value: minus_sign);
    let magnitude = 0_u64 -wrap bits;
    put_decimal(buffer: buffer, value: magnitude);
  } else {
    put_decimal(buffer: buffer, value: bits);
  }
  return unit;
}
