alias Component = pkg::css::syntax::Component;
alias ComponentList = pkg::css::syntax::ComponentList;
alias Span = pkg::css::syntax::Span;

public enum ComponentFault {
  InvalidEnd(public at: u64);
  InvalidSpan(public at: u64);
  InvalidCodePoint(public at: u64);
}

public fn put_components(buffer: &Box<Slots<u8>>, list: &ComponentList, from: u64, to: u64) -> result: Result<unit, ComponentFault> reads(list), writes(buffer) doc "Appends the components of list from index from up to index to as one JSON array in css-parsing-tests' representation, with each number's value as the string `f64:` and the 16 lowercase hexadecimal digits of its bits. A Function or block component is written as an array holding its head and its contents, the components after it up to its end index, and the walk continues at that end. InvalidEnd names a component index at or past the list's end, or a Function or block whose end index does not lie after it and at most at to; InvalidSpan a component whose span leaves list.text; InvalidCodePoint a Delim that is no Unicode scalar value. On a fault it appends nothing: what it appended is removed.";

public fn put_fault(buffer: &Box<Slots<u8>>, fault: ComponentFault) -> result: unit writes(buffer) doc "Appends fault as a JSON string that names it and the component index it carries, such as `\"driver: invalid end at 7\"`, `\"driver: invalid span at 7\"` or `\"driver: invalid code point at 7\"`.";

public fn put_string(buffer: &Box<Slots<u8>>, list: &ComponentList, span: Span) -> result: Bool reads(list), writes(buffer) doc "Appends the bytes of list.text that span covers as a JSON string, escaping a quotation mark, a reverse solidus and every byte below 0x20, and returns True; returns False and appends nothing when span ends before it starts or past the end of list.text.";

public fn nested_end(component: Component) -> result: Option<u32> pure doc "Returns the end index of a Function or block component, the index after its last content component, and None for every component that has no contents.";

public fn put_f64(buffer: &Box<Slots<u8>>, value: f64) -> result: unit writes(buffer) doc "Appends value as a JSON string: `f64:` and the 16 lowercase hexadecimal digits of its bits, the form put_components gives every number's value.";
