alias Args = std::text::Args;
alias Attribute = pkg::html::tokenizer::Attribute;
alias ContentState = pkg::html::tokenizer::ContentState;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias Span = pkg::html::tokenizer::Span;
alias Token = pkg::html::tokenizer::Token;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias next_token = pkg::html::tokenizer::next_token;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_hex = pkg::oracle::support::put_hex;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;
alias token_text_new = pkg::html::tokenizer::token_text_new;
alias tokenizer_new = pkg::html::tokenizer::tokenizer_new;
alias truncate = pkg::oracle::support::truncate;

const head_doctype: Array<u8, 12> =[91_u8, 34_u8, 68_u8, 79_u8, 67_u8, 84_u8, 89_u8, 80_u8, 69_u8, 34_u8, 44_u8, 32_u8];

const head_start_tag: Array<u8, 13> =[91_u8, 34_u8, 83_u8, 116_u8, 97_u8, 114_u8, 116_u8, 84_u8, 97_u8, 103_u8, 34_u8, 44_u8, 32_u8];

const head_end_tag: Array<u8, 11> =[91_u8, 34_u8, 69_u8, 110_u8, 100_u8, 84_u8, 97_u8, 103_u8, 34_u8, 44_u8, 32_u8];

const head_comment: Array<u8, 12> =[91_u8, 34_u8, 67_u8, 111_u8, 109_u8, 109_u8, 101_u8, 110_u8, 116_u8, 34_u8, 44_u8, 32_u8];

const head_character: Array<u8, 15> =[91_u8, 34_u8, 67_u8, 104_u8, 97_u8, 114_u8, 97_u8, 99_u8, 116_u8, 101_u8, 114_u8, 34_u8, 44_u8, 32_u8, 34_u8];

const close_character: Array<u8, 2> =[34_u8, 93_u8];

const null_text: Array<u8, 4> =[110_u8, 117_u8, 108_u8, 108_u8];

const true_text: Array<u8, 4> =[116_u8, 114_u8, 117_u8, 101_u8];

const false_text: Array<u8, 5> =[102_u8, 97_u8, 108_u8, 115_u8, 101_u8];

const item_separator: Array<u8, 2> =[44_u8, 32_u8];

const member_separator: Array<u8, 2> =[58_u8, 32_u8];

const fault_span: Array<u8, 31> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 115_u8, 112_u8, 97_u8, 110_u8, 32_u8, 105_u8, 110_u8, 32_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 32_u8];

const fault_attributes: Array<u8, 42> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 97_u8, 116_u8, 116_u8, 114_u8, 105_u8, 98_u8, 117_u8, 116_u8, 101_u8, 32_u8, 114_u8, 97_u8, 110_u8, 103_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 32_u8];

const fault_repeated: Array<u8, 42> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 114_u8, 101_u8, 112_u8, 101_u8, 97_u8, 116_u8, 101_u8, 100_u8, 32_u8, 97_u8, 116_u8, 116_u8, 114_u8, 105_u8, 98_u8, 117_u8, 116_u8, 101_u8, 32_u8, 110_u8, 97_u8, 109_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 32_u8];

const fault_no_end: Array<u8, 30> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 110_u8, 111_u8, 32_u8, 101_u8, 110_u8, 100_u8, 32_u8, 111_u8, 102_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 102_u8, 116_u8, 101_u8, 114_u8, 32_u8];

const fault_no_end_tail: Array<u8, 7> =[32_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 115_u8];

const fault_last_tag: Array<u8, 33> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 108_u8, 97_u8, 115_u8, 116_u8, 32_u8, 115_u8, 116_u8, 97_u8, 114_u8, 116_u8, 32_u8, 116_u8, 97_u8, 103_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 34_u8];

const fault_too_large: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const usage_text: Array<u8, 34> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 104_u8, 116_u8, 109_u8, 108_u8, 95_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 105_u8, 122_u8, 101_u8, 114_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 35> =[104_u8, 116_u8, 109_u8, 108_u8, 95_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 105_u8, 122_u8, 101_u8, 114_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const malformed_text: Array<u8, 51> =[104_u8, 116_u8, 109_u8, 108_u8, 95_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 105_u8, 122_u8, 101_u8, 114_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 98_u8, 121_u8, 116_u8, 101_u8, 32_u8];

const unicode_escape: Array<u8, 4> =[92_u8, 117_u8, 48_u8, 48_u8];

const last_tag_ceiling: u64 = 1024_u64;

const source_ceiling: u64 = 1073741824_u64;

const state_count: u64 = 6_u64;

const token_allowance: u64 = 64_u64;

const tokens_per_byte: u64 = 4_u64;

const line_feed: u8 = 10_u8;

const space: u8 = 32_u8;

const quotation_mark: u8 = 34_u8;

const reverse_solidus: u8 = 92_u8;

const left_square_bracket: u8 = 91_u8;

const right_square_bracket: u8 = 93_u8;

const left_curly_bracket: u8 = 123_u8;

const right_curly_bracket: u8 = 125_u8;

const first_printable: u8 = 32_u8;

enum Fault {
  InvalidSpan(token: u64);
  InvalidAttributes(token: u64);
  RepeatedAttribute(token: u64);
  NoEndOfFile(tokens: u64);
  LastTagTooLong();
  CaseTooLarge();
}

fn run(inputs: Inputs) -> status: ExitStatus pure {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn space_index(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first space in text at or after from and before stop, or stop when there is none.";
  let length = text^.len;
  let at = from;
  loop @scan {
    let inside = at < length;
    let before = at < stop;
    let more = band(inside, before);
    if more {
    } else {
      return stop;
    }
    let byte = text^[at];
    let found = byte == space;
    if found {
      return at;
    }
    set at = at +wrap 1_u64;
  }
  return stop;
}

fn content_state(index: u64) -> result: Option<ContentState> pure {
  doc "Returns the content state that index names in the case file's order: Data, Rcdata, Rawtext, ScriptData, Plaintext and CdataSection; None past the last.";
  let data = index == 0_u64;
  let rcdata = index == 1_u64;
  let rawtext = index == 2_u64;
  let script_data = index == 3_u64;
  let plaintext = index == 4_u64;
  let cdata_section = index == 5_u64;
  let state = ContentState::Data();
  if data {
    set state = ContentState::Data();
  } else if rcdata {
    set state = ContentState::Rcdata();
  } else if rawtext {
    set state = ContentState::Rawtext();
  } else if script_data {
    set state = ContentState::ScriptData();
  } else if plaintext {
    set state = ContentState::Plaintext();
  } else if cdata_section {
    set state = ContentState::CdataSection();
  } else {
    return None<ContentState>();
  }
  return Some<ContentState>(value: state);
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) {
  doc "Walks the case file: a header line of three decimal fields separated by single spaces, the last start tag's bytes, the input's bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let state_end = space_index(text: text, from: position, stop: header_end);
    let last_field = state_end +wrap 1_u64;
    let last_field_end = space_index(text: text, from: last_field, stop: header_end);
    let input_field = last_field_end +wrap 1_u64;
    let state_index = parse_decimal(text: text, start: position, end: state_end);
    let last_size = parse_decimal(text: text, start: last_field, end: last_field_end);
    let input_size = parse_decimal(text: text, start: input_field, end: header_end);
    let state = match state_index {
      Some(value: index) => {
        give content_state(index: index);
      }
      None() => {
        give None<ContentState>();
      }
    }
    let initial = match state {
      Some(value: named) => {
        give named;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let last_length = match last_size {
      Some(value: size) => {
        give size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let input_length = match input_size {
      Some(value: size) => {
        give size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let last_start = header_end +wrap 1_u64;
    let last_end = last_start +wrap last_length;
    let input_end = last_end +wrap input_length;
    let tag_ordered = last_start <= last_end;
    let input_ordered = last_end <= input_end;
    let terminated = input_end < length;
    let ordered = band(tag_ordered, input_ordered);
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let terminator = text^[input_end];
    let closed = terminator == line_feed;
    if closed {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let last = &text^[last_start..last_end];
    let source = &text^[last_end..input_end];
    print_case(state: initial, last: last, source: source, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = input_end +wrap 1_u64;
  }
  return True();
}

fn print_case(state: ContentState, last: &[u8], source: &[u8], buffer: &Box<Slots<u8>>) -> result: unit reads(last), reads(source), writes(buffer) {
  doc "Tokenizes one case and appends its JSON line; on a fault it removes what the case appended and appends the fault string instead.";
  let mark = buffer^.inner.len;
  match put_tokens(buffer: buffer, state: state, last: last, source: source) {
    Ok(value: done) => {
    }
    Err(error: fault) => {
      truncate(buffer: buffer, length: mark);
      put_fault(buffer: buffer, fault: fault);
    }
  }
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_fault(buffer: &Box<Slots<u8>>, fault: Fault) -> result: unit writes(buffer) {
  doc "Appends a fault as a JSON string such as \"driver: invalid span in token 3\".";
  match fault {
    InvalidSpan(token: index) => {
      let message = &fault_span[0_u64..fault_span.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: index);
      put_byte(buffer: buffer, value: quotation_mark);
    }
    InvalidAttributes(token: index) => {
      let message = &fault_attributes[0_u64..fault_attributes.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: index);
      put_byte(buffer: buffer, value: quotation_mark);
    }
    RepeatedAttribute(token: index) => {
      let message = &fault_repeated[0_u64..fault_repeated.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: index);
      put_byte(buffer: buffer, value: quotation_mark);
    }
    NoEndOfFile(tokens: count) => {
      let message = &fault_no_end[0_u64..fault_no_end.len];
      put_text(buffer: buffer, text: message);
      put_decimal(buffer: buffer, value: count);
      let tail = &fault_no_end_tail[0_u64..fault_no_end_tail.len];
      put_text(buffer: buffer, text: tail);
      put_byte(buffer: buffer, value: quotation_mark);
    }
    LastTagTooLong() => {
      let message = &fault_last_tag[0_u64..fault_last_tag.len];
      put_text(buffer: buffer, text: message);
    }
    CaseTooLarge() => {
      let message = &fault_too_large[0_u64..fault_too_large.len];
      put_text(buffer: buffer, text: message);
    }
  }
  return unit;
}

fn put_tokens(buffer: &Box<Slots<u8>>, state: ContentState, last: &[u8], source: &[u8]) -> result: Result<unit, Fault> reads(last), reads(source), writes(buffer) {
  doc "Runs a tokenizer in state with last as its last start tag over source and appends the tokens up to EndOfFile as one JSON array. Consecutive Characters tokens share one Character entry, left open until another token or the end closes it; an empty one opens nothing. The token count stops at 4 times the source length plus 64, above what the standard's tokenization emits even at one Characters token per character, since each source byte yields at most a few characters or tokens.";
  let short_tag = last^.len <= last_tag_ceiling;
  if short_tag {
  } else {
    let fault = Fault::LastTagTooLong();
    return Err<unit, Fault>(error: fault);
  }
  let small = source^.len <= source_ceiling;
  if small {
  } else {
    let fault = Fault::CaseTooLarge();
    return Err<unit, Fault>(error: fault);
  }
  let tokenizer = tokenizer_new(state: state, last_start_tag: last);
  let output = token_text_new();
  let length = source^.len;
  let scaled = length *wrap tokens_per_byte;
  let limit = scaled +wrap token_allowance;
  let count = 0_u64;
  let open = False();
  let separated = False();
  put_byte(buffer: buffer, value: left_square_bracket);
  loop @tokens {
    let allowed = count < limit;
    if allowed {
    } else {
      let fault = Fault::NoEndOfFile(tokens: count);
      return Err<unit, Fault>(error: fault);
    }
    let token = next_token(tokenizer: &tokenizer, source: source, output: &output);
    let ended = is_end_of_file(token: token);
    if ended {
      break @tokens;
    }
    let text_length = output.text.inner.len;
    let text = &output.text.inner[0_u64..text_length];
    let attribute_count = output.attributes.inner.len;
    let attributes = &output.attributes.inner[0_u64..attribute_count];
    match characters_of(token: token) {
      Some(value: data) => {
        let valid = propagate check_span(text: text, span: data, at: count);
        let empty = data.start == data.end;
        if empty {
        } else {
          if open {
          } else {
            if separated {
              let separator = &item_separator[0_u64..item_separator.len];
              put_text(buffer: buffer, text: separator);
            }
            let head = &head_character[0_u64..head_character.len];
            put_text(buffer: buffer, text: head);
            set open = True();
            set separated = True();
          }
          let written = propagate put_span_bytes(buffer: buffer, text: text, span: data, at: count);
        }
      }
      None() => {
        if open {
          let closing = &close_character[0_u64..close_character.len];
          put_text(buffer: buffer, text: closing);
          set open = False();
        }
        if separated {
          let separator = &item_separator[0_u64..item_separator.len];
          put_text(buffer: buffer, text: separator);
        }
        set separated = True();
        let written = propagate put_token(buffer: buffer, token: token, text: text, attributes: attributes, at: count);
      }
    }
    set count = count +wrap 1_u64;
  }
  if open {
    let closing = &close_character[0_u64..close_character.len];
    put_text(buffer: buffer, text: closing);
  }
  put_byte(buffer: buffer, value: right_square_bracket);
  return Ok<unit, Fault>(value: unit);
}

fn is_end_of_file(token: Token) -> result: Bool pure {
  doc "Tells whether token is EndOfFile.";
  match token {
    EndOfFile() => {
      return True();
    }
    Doctype(..) => {
      return False();
    }
    StartTag(..) => {
      return False();
    }
    EndTag(..) => {
      return False();
    }
    Comment(..) => {
      return False();
    }
    Characters(..) => {
      return False();
    }
  }
}

fn characters_of(token: Token) -> result: Option<Span> pure {
  doc "Returns the data span of a Characters token, and None for every other token.";
  match token {
    Characters(data: character_data) => {
      return Some<Span>(value: character_data);
    }
    Doctype(..) => {
      return None<Span>();
    }
    StartTag(..) => {
      return None<Span>();
    }
    EndTag(..) => {
      return None<Span>();
    }
    Comment(..) => {
      return None<Span>();
    }
    EndOfFile() => {
      return None<Span>();
    }
  }
}

fn put_token(buffer: &Box<Slots<u8>>, token: Token, text: &[u8], attributes: &[Attribute], at: u64) -> result: Result<unit, Fault> reads(text), reads(attributes), writes(buffer) {
  doc "Appends one DOCTYPE, StartTag, EndTag or Comment token, the token at index at, in html5lib-tests' representation. Appends nothing for Characters and EndOfFile, which put_tokens handles.";
  match token {
    Doctype(name: doctype_name, public_id: doctype_public, system_id: doctype_system, force_quirks: quirks) => {
      let head = &head_doctype[0_u64..head_doctype.len];
      put_text(buffer: buffer, text: head);
      let separator = &item_separator[0_u64..item_separator.len];
      let named = propagate put_optional_span(buffer: buffer, text: text, span: doctype_name, at: at);
      put_text(buffer: buffer, text: separator);
      let identified = propagate put_optional_span(buffer: buffer, text: text, span: doctype_public, at: at);
      put_text(buffer: buffer, text: separator);
      let located = propagate put_optional_span(buffer: buffer, text: text, span: doctype_system, at: at);
      put_text(buffer: buffer, text: separator);
      if quirks {
        let flag = &false_text[0_u64..false_text.len];
        put_text(buffer: buffer, text: flag);
      } else {
        let flag = &true_text[0_u64..true_text.len];
        put_text(buffer: buffer, text: flag);
      }
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    StartTag(name: tag_name, first_attribute: first_index, end_attribute: end_index, self_closing: closing_flag) => {
      let head = &head_start_tag[0_u64..head_start_tag.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_span(buffer: buffer, text: text, span: tag_name, at: at);
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
      let listed = propagate put_attributes(buffer: buffer, text: text, attributes: attributes, first: first_index, end: end_index, at: at);
      if closing_flag {
        put_text(buffer: buffer, text: separator);
        let flag = &true_text[0_u64..true_text.len];
        put_text(buffer: buffer, text: flag);
      }
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    EndTag(name: tag_name) => {
      let head = &head_end_tag[0_u64..head_end_tag.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_span(buffer: buffer, text: text, span: tag_name, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Comment(data: comment_data) => {
      let head = &head_comment[0_u64..head_comment.len];
      put_text(buffer: buffer, text: head);
      let written = propagate put_span(buffer: buffer, text: text, span: comment_data, at: at);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Characters(..) => {
    }
    EndOfFile() => {
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn put_attributes(buffer: &Box<Slots<u8>>, text: &[u8], attributes: &[Attribute], first: u32, end: u32, at: u64) -> result: Result<unit, Fault> reads(text), reads(attributes), writes(buffer) {
  doc "Appends the attributes from index first up to index end as one JSON object of name and value strings in order. A range that ends before it starts or past the end of attributes is the fault InvalidAttributes, and a name equal to an earlier one of the range is the fault RepeatedAttribute, both of the token at index at.";
  let from = cvt::<u32, u64>(first);
  let to = cvt::<u32, u64>(end);
  let ordered = from <= to;
  let within = to <= attributes^.len;
  let valid = band(ordered, within);
  if valid {
  } else {
    let fault = Fault::InvalidAttributes(token: at);
    return Err<unit, Fault>(error: fault);
  }
  put_byte(buffer: buffer, value: left_curly_bracket);
  for (index in from..to) {
    let later = index > from;
    if later {
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
    }
    let attribute = attributes^[index];
    let named = propagate put_span(buffer: buffer, text: text, span: attribute.name, at: at);
    let joiner = &member_separator[0_u64..member_separator.len];
    put_text(buffer: buffer, text: joiner);
    let valued = propagate put_span(buffer: buffer, text: text, span: attribute.value, at: at);
    let earlier = &attributes^[from..index];
    let repeated = repeats_name(text: text, earlier: earlier, name: attribute.name);
    if repeated {
      let fault = Fault::RepeatedAttribute(token: at);
      return Err<unit, Fault>(error: fault);
    }
  }
  put_byte(buffer: buffer, value: right_curly_bracket);
  return Ok<unit, Fault>(value: unit);
}

fn repeats_name(text: &[u8], earlier: &[Attribute], name: Span) -> result: Bool reads(text), reads(earlier) {
  doc "Tells whether the name of any attribute in earlier spells the same bytes of text as name.";
  let count = earlier^.len;
  for (index in 0_u64..count) {
    let attribute = earlier^[index];
    let same = same_bytes(text: text, left: attribute.name, right: name);
    if same {
      return True();
    }
  }
  return False();
}

fn same_bytes(text: &[u8], left: Span, right: Span) -> result: Bool reads(text) {
  doc "Tells whether the bytes of text that left and right cover are equal; a span that ends before it starts or past the end of text equals nothing.";
  let length = text^.len;
  let left_first = cvt::<u32, u64>(left.start);
  let left_last = cvt::<u32, u64>(left.end);
  let right_first = cvt::<u32, u64>(right.start);
  let right_last = cvt::<u32, u64>(right.end);
  let left_ordered = left_first <= left_last;
  let left_within = left_last <= length;
  let right_ordered = right_first <= right_last;
  let right_within = right_last <= length;
  let left_valid = band(left_ordered, left_within);
  let right_valid = band(right_ordered, right_within);
  let valid = band(left_valid, right_valid);
  if valid {
  } else {
    return False();
  }
  let left_bytes = &text^[left_first..left_last];
  let right_bytes = &text^[right_first..right_last];
  let count = left_bytes^.len;
  let equal_length = count == right_bytes^.len;
  if equal_length {
  } else {
    return False();
  }
  for (offset in 0_u64..count) {
    let left_byte = left_bytes^[offset];
    let right_byte = right_bytes^[offset];
    let differs = left_byte != right_byte;
    if differs {
      return False();
    }
  }
  return True();
}

fn put_optional_span(buffer: &Box<Slots<u8>>, text: &[u8], span: Option<Span>, at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends a present span as a JSON string and an absent one as null.";
  match span {
    Some(value: present) => {
      let written = propagate put_span(buffer: buffer, text: text, span: present, at: at);
    }
    None() => {
      let absent = &null_text[0_u64..null_text.len];
      put_text(buffer: buffer, text: absent);
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn check_span(text: &[u8], span: Span, at: u64) -> result: Result<unit, Fault> reads(text) {
  doc "Returns the fault InvalidSpan of the token at index at when span ends before it starts or past the end of text.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first <= last;
  let within = last <= text^.len;
  let valid = band(ordered, within);
  if valid {
  } else {
    let fault = Fault::InvalidSpan(token: at);
    return Err<unit, Fault>(error: fault);
  }
  return Ok<unit, Fault>(value: unit);
}

fn put_span(buffer: &Box<Slots<u8>>, text: &[u8], span: Span, at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends the bytes of text that span covers as a JSON string, or returns put_span_bytes' fault.";
  put_byte(buffer: buffer, value: quotation_mark);
  let written = propagate put_span_bytes(buffer: buffer, text: text, span: span, at: at);
  put_byte(buffer: buffer, value: quotation_mark);
  return Ok<unit, Fault>(value: unit);
}

fn put_span_bytes(buffer: &Box<Slots<u8>>, text: &[u8], span: Span, at: u64) -> result: Result<unit, Fault> reads(text), writes(buffer) {
  doc "Appends the bytes of text that span covers as the inside of a JSON string. A span that ends before it starts or past the end of text is the fault InvalidSpan of the token at index at.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first <= last;
  let within = last <= text^.len;
  let valid = band(ordered, within);
  if valid {
  } else {
    let fault = Fault::InvalidSpan(token: at);
    return Err<unit, Fault>(error: fault);
  }
  for (index in first..last) {
    let byte = text^[index];
    put_json_byte(buffer: buffer, byte: byte);
  }
  return Ok<unit, Fault>(value: unit);
}

fn put_json_byte(buffer: &Box<Slots<u8>>, byte: u8) -> result: unit writes(buffer) {
  doc "Appends one byte of a JSON string: a quotation mark or reverse solidus after a reverse solidus, a byte below 0x20 as a \\u00XX escape, and every other byte, WTF-8 included, unchanged.";
  let quote = byte == quotation_mark;
  let solidus = byte == reverse_solidus;
  let escaped = bor(quote, solidus);
  if escaped {
    put_byte(buffer: buffer, value: reverse_solidus);
    put_byte(buffer: buffer, value: byte);
    return unit;
  }
  let control = byte < first_printable;
  if control {
    let escape = &unicode_escape[0_u64..unicode_escape.len];
    put_text(buffer: buffer, text: escape);
    let widened = cvt::<u8, u64>(byte);
    let uppercase = True();
    put_hex(buffer: buffer, value: widened, width: 2_u64, uppercase: uppercase);
    return unit;
  }
  put_byte(buffer: buffer, value: byte);
  return unit;
}
