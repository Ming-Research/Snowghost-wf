const usage_text: Array<u8, 23> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 117_u8, 114_u8, 108_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 24> =[117_u8, 114_u8, 108_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const malformed_text: Array<u8, 40> =[117_u8, 114_u8, 108_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 98_u8, 121_u8, 116_u8, 101_u8, 32_u8];

const unicode_escape: Array<u8, 4> =[92_u8, 117_u8, 48_u8, 48_u8];

const input_ceiling: u64 = 268435456_u64;

const line_feed: u8 = 10_u8;

const space: u8 = 32_u8;

const quotation_mark: u8 = 34_u8;

const number_sign: u8 = 35_u8;

const full_stop: u8 = 46_u8;

const solidus: u8 = 47_u8;

const colon: u8 = 58_u8;

const question_mark: u8 = 63_u8;

const commercial_at: u8 = 64_u8;

const reverse_solidus: u8 = 92_u8;

const first_printable: u8 = 32_u8;

struct CaseHeader {
  has_base: Bool;
  input_length: u64;
  base_length: u64;
}

enum Fault {
  InvalidSpan();
  SpanOrder();
  HostKindMismatch();
  OpaqueHost();
  HrefMismatch();
}

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn field_end(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first space in text at or after start and before end, or end when there is none or the range lies outside text.";
  let within = end <= text^.len;
  if within {
  } else {
    return end;
  }
  for (at in start..end) {
    let byte = text^[at];
    let found = byte == space;
    if found {
      return at;
    }
  }
  return end;
}

fn parse_header(text: &[u8], start: u64, end: u64) -> result: Option<CaseHeader> reads(text) {
  doc "Parses the header line of one case, the bytes of text from start to end: three decimal numbers separated by single spaces, HAS_BASE, INPUT_LENGTH and BASE_LENGTH. HAS_BASE is 0 or 1, and BASE_LENGTH is 0 when HAS_BASE is 0. Returns None for any other header.";
  let first_end = field_end(text: text, start: start, end: end);
  let second_start = first_end +wrap 1_u64;
  let second_end = field_end(text: text, start: second_start, end: end);
  let third_start = second_end +wrap 1_u64;
  let flag = parse_decimal(text: text, start: start, end: first_end);
  let input = parse_decimal(text: text, start: second_start, end: second_end);
  let base = parse_decimal(text: text, start: third_start, end: end);
  match flag {
    Some(value: flag_value) => {
      match input {
        Some(value: input_length) => {
          match base {
            Some(value: base_length) => {
              let with_base = flag_value == 1_u64;
              let without_base = flag_value == 0_u64;
              let no_base_bytes = base_length == 0_u64;
              let consistent = band(without_base, no_base_bytes);
              let admitted = bor(with_base, consistent);
              if admitted {
                let header = CaseHeader(has_base: with_base, input_length: input_length, base_length: base_length);
                return Some<CaseHeader>(value: header);
              }
              return None<CaseHeader>();
            }
            None() => {
              return None<CaseHeader>();
            }
          }
        }
        None() => {
          return None<CaseHeader>();
        }
      }
    }
    None() => {
      return None<CaseHeader>();
    }
  }
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file: a header line, the input's bytes, the base's bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let parsed = parse_header(text: text, start: position, end: header_end);
    let header = match parsed {
      Some(value: case_header) => {
        give case_header;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let input_start = header_end +wrap 1_u64;
    let input_end = input_start +wrap header.input_length;
    let base_end = input_end +wrap header.base_length;
    let input_ordered = input_start <= input_end;
    let base_ordered = input_end <= base_end;
    let ordered = band(input_ordered, base_ordered);
    let terminated = base_end < length;
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let terminator = text^[base_end];
    let closed = terminator == line_feed;
    if closed {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    print_case(text: text, input_start: input_start, input_end: input_end, base_end: base_end, has_base: header.has_base, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = base_end +wrap 1_u64;
  }
  return True();
}

fn print_case(text: &[u8], input_start: u64, input_end: u64, base_end: u64, has_base: Bool, buffer: &Box<Slots<u8>>) -> result: unit reads(text), writes(buffer) {
  doc "Appends the line of one case whose input is the bytes of text from input_start to input_end and whose base, when has_base is True, follows up to base_end. With a base it parses the base with parse_url, and the input with parse_url_with_base against it; without one it parses the input with parse_url. An input or base longer than parse_url admits prints the fault string \"driver: case too large\".";
  let input_ordered = input_start <= input_end;
  let base_ordered = input_end <= base_end;
  let ordered = band(input_ordered, base_ordered);
  let within = base_end <= text^.len;
  let located = band(ordered, within);
  if located {
  } else {
    let message = &case_too_large_text[0_u64..case_too_large_text.len];
    put_driver_text(buffer: buffer, text: message);
    put_byte(buffer: buffer, value: line_feed);
    return unit;
  }
  let input = &text^[input_start..input_end];
  let base = &text^[input_end..base_end];
  let small_input = input^.len <= input_ceiling;
  let small_base = base^.len <= input_ceiling;
  let small = band(small_input, small_base);
  if small {
  } else {
    let message = &case_too_large_text[0_u64..case_too_large_text.len];
    put_driver_text(buffer: buffer, text: message);
    put_byte(buffer: buffer, value: line_feed);
    return unit;
  }
  if has_base {
    match parse_url(input: base) {
      Ok(value: base_url) => {
        match check_url(url: &base_url) {
          Ok(value: consistent) => {
            let parsed = parse_url_with_base(input: input, base: &base_url);
            put_result(buffer: buffer, result: move parsed);
          }
          Err(error: fault) => {
            let in_base = True();
            put_fault(buffer: buffer, fault: fault, in_base: in_base);
          }
        }
      }
      Err(error: refusal) => {
        match refusal {
          Failure() => {
            let message = &base_refused_text[0_u64..base_refused_text.len];
            put_driver_text(buffer: buffer, text: message);
          }
          TooLarge() => {
            let message = &too_large_text[0_u64..too_large_text.len];
            put_driver_text(buffer: buffer, text: message);
          }
        }
      }
    }
  } else {
    let parsed = parse_url(input: input);
    put_result(buffer: buffer, result: move parsed);
  }
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_result(buffer: &Box<Slots<u8>>, result: Result<Url, UrlError>) -> done: unit writes(buffer) {
  doc "Appends null for a refused input, the fault string \"driver: too large\" for TooLarge, and for a parsed URL its getters as one JSON object, or the fault string of the first check it fails.";
  match move result {
    Ok(value: url) => {
      match check_url(url: &url) {
        Ok(value: consistent) => {
          put_getters(buffer: buffer, url: &url);
        }
        Err(error: fault) => {
          let in_base = False();
          put_fault(buffer: buffer, fault: fault, in_base: in_base);
        }
      }
    }
    Err(error: refusal) => {
      match refusal {
        Failure() => {
          let text = &null_text[0_u64..null_text.len];
          put_text(buffer: buffer, text: text);
        }
        TooLarge() => {
          let message = &too_large_text[0_u64..too_large_text.len];
          put_driver_text(buffer: buffer, text: message);
        }
      }
    }
  }
  return unit;
}

fn put_driver_text(buffer: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(buffer) {
  doc "Appends the JSON string `\"driver: TEXT\"`; text holds no byte that JSON escapes.";
  let prefix = &fault_prefix[0_u64..fault_prefix.len];
  put_text(buffer: buffer, text: prefix);
  put_text(buffer: buffer, text: text);
  put_byte(buffer: buffer, value: quotation_mark);
  return unit;
}

fn put_fault(buffer: &Box<Slots<u8>>, fault: Fault, in_base: Bool) -> result: unit writes(buffer) {
  doc "Appends a fault as a JSON string such as \"driver: invalid span\", or \"driver: base record: invalid span\" when in_base says the base's record has it.";
  let prefix = &fault_prefix[0_u64..fault_prefix.len];
  put_text(buffer: buffer, text: prefix);
  if in_base {
    let base_label = &base_record_text[0_u64..base_record_text.len];
    put_text(buffer: buffer, text: base_label);
  }
  match fault {
    InvalidSpan() => {
      let message = &invalid_span_text[0_u64..invalid_span_text.len];
      put_text(buffer: buffer, text: message);
    }
    SpanOrder() => {
      let message = &span_order_text[0_u64..span_order_text.len];
      put_text(buffer: buffer, text: message);
    }
    HostKindMismatch() => {
      let message = &host_kind_text[0_u64..host_kind_text.len];
      put_text(buffer: buffer, text: message);
    }
    OpaqueHost() => {
      let message = &opaque_host_text[0_u64..opaque_host_text.len];
      put_text(buffer: buffer, text: message);
    }
    HrefMismatch() => {
      let message = &mismatch_text[0_u64..mismatch_text.len];
      put_text(buffer: buffer, text: message);
    }
  }
  put_byte(buffer: buffer, value: quotation_mark);
  return unit;
}

fn span_empty(span: UrlSpan) -> result: Bool pure {
  doc "Tells whether span covers no byte.";
  let empty = span.start == span.end;
  return empty;
}

fn host_absent(kind: HostKind) -> result: Bool pure {
  doc "Tells whether kind is Absent, the null host.";
  match kind {
    Absent() => {
      return True();
    }
    Domain() => {
      return False();
    }
    Ipv4() => {
      return False();
    }
    Ipv6() => {
      return False();
    }
    Opaque() => {
      return False();
    }
    Empty() => {
      return False();
    }
  }
}

fn host_without_text(kind: HostKind) -> result: Bool pure {
  doc "Tells whether kind is Absent or Empty, the host kinds whose host span the interface requires to be empty.";
  match kind {
    Absent() => {
      return True();
    }
    Empty() => {
      return True();
    }
    Domain() => {
      return False();
    }
    Ipv4() => {
      return False();
    }
    Ipv6() => {
      return False();
    }
    Opaque() => {
      return False();
    }
  }
}

fn check_span(span: UrlSpan, length: u64) -> result: Result<unit, Fault> pure {
  doc "InvalidSpan when span ends before it starts or past length, the length of href.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first <= last;
  let within = last <= length;
  let valid = band(ordered, within);
  if valid {
    return Ok<unit, Fault>(value: unit);
  }
  let fault = Fault::InvalidSpan();
  return Err<unit, Fault>(error: fault);
}

fn check_optional_span(span: Option<UrlSpan>, length: u64) -> result: Result<unit, Fault> pure {
  doc "Checks span as check_span does when it is Some.";
  match span {
    Some(value: present) => {
      let present_valid = propagate check_span(span: present, length: length);
    }
    None() => {
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn follow(span: UrlSpan, reached: u32) -> result: Result<u32, Fault> pure {
  doc "SpanOrder when span starts before reached, the end of the span before it in the interface's order; otherwise returns the end of span.";
  let after = span.start >= reached;
  if after {
    return Ok<u32, Fault>(value: span.end);
  }
  let fault = Fault::SpanOrder();
  return Err<u32, Fault>(error: fault);
}

fn follow_optional(span: Option<UrlSpan>, reached: u32) -> result: Result<u32, Fault> pure {
  doc "Follows span as follow does when it is Some, and returns reached unchanged when it is None.";
  match span {
    Some(value: present) => {
      let next = propagate follow(span: present, reached: reached);
      return Ok<u32, Fault>(value: next);
    }
    None() => {
      return Ok<u32, Fault>(value: reached);
    }
  }
}

fn check_url(url: &Url) -> result: Result<unit, Fault> reads(url) {
  doc "Checks that the record agrees with its href, in this order: every span lies within href and starts at or before its end (InvalidSpan); the spans scheme, username, password, host, path, query and fragment follow one another in that order without overlap (SpanOrder); the host span is empty when host_kind is Absent or Empty (HostKindMismatch); opaque_path is True only when host_kind is Absent (OpaqueHost); and href is what rebuild_href writes (HrefMismatch).";
  let length = url^.href.inner.len;
  let scheme = url^.scheme;
  let username = url^.username;
  let password = url^.password;
  let host = url^.host;
  let path = url^.path;
  let query = url^.query;
  let fragment = url^.fragment;
  let scheme_valid = propagate check_span(span: scheme, length: length);
  let username_valid = propagate check_span(span: username, length: length);
  let password_valid = propagate check_span(span: password, length: length);
  let host_valid = propagate check_span(span: host, length: length);
  let path_valid = propagate check_span(span: path, length: length);
  let query_valid = propagate check_optional_span(span: query, length: length);
  let fragment_valid = propagate check_optional_span(span: fragment, length: length);
  let after_username = propagate follow(span: username, reached: scheme.end);
  let after_password = propagate follow(span: password, reached: after_username);
  let after_host = propagate follow(span: host, reached: after_password);
  let after_path = propagate follow(span: path, reached: after_host);
  let after_query = propagate follow_optional(span: query, reached: after_path);
  let after_fragment = propagate follow_optional(span: fragment, reached: after_query);
  let kind = url^.host_kind;
  let textless = host_without_text(kind: kind);
  let host_empty = span_empty(span: host);
  if textless {
    if host_empty {
    } else {
      let fault = Fault::HostKindMismatch();
      return Err<unit, Fault>(error: fault);
    }
  }
  let absent = host_absent(kind: kind);
  let opaque_path = url^.opaque_path;
  if opaque_path {
    if absent {
    } else {
      let fault = Fault::OpaqueHost();
      return Err<unit, Fault>(error: fault);
    }
  }
  let rebuilt = propagate rebuild_href(url: url);
  let rebuilt_length = rebuilt.inner.len;
  let same_length = rebuilt_length == length;
  if same_length {
  } else {
    let fault = Fault::HrefMismatch();
    return Err<unit, Fault>(error: fault);
  }
  let href = &url^.href.inner[0_u64..length];
  let expected = &rebuilt.inner[0_u64..rebuilt_length];
  for (at in 0_u64..length) {
    let byte = href^[at];
    let wanted = expected^[at];
    let equal = byte == wanted;
    if equal {
    } else {
      let fault = Fault::HrefMismatch();
      return Err<unit, Fault>(error: fault);
    }
  }
  return Ok<unit, Fault>(value: unit);
}

fn place_span(buffer: &Box<Slots<u8>>, href: &[u8], span: UrlSpan) -> result: Result<unit, Fault> reads(href), writes(buffer) {
  doc "Appends the bytes of href that span covers to buffer. HrefMismatch when span is nonempty and does not start at the len of buffer, where the serializer writes its component; InvalidSpan when span lies outside href.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first <= last;
  let within = last <= href^.len;
  let valid = band(ordered, within);
  if valid {
  } else {
    let fault = Fault::InvalidSpan();
    return Err<unit, Fault>(error: fault);
  }
  let empty = first == last;
  if empty {
    return Ok<unit, Fault>(value: unit);
  }
  let placed = buffer^.inner.len == first;
  if placed {
  } else {
    let fault = Fault::HrefMismatch();
    return Err<unit, Fault>(error: fault);
  }
  let content = &href^[first..last];
  put_text(buffer: buffer, text: content);
  return Ok<unit, Fault>(value: unit);
}

fn starts_with_two_solidi(href: &[u8], span: UrlSpan) -> result: Bool reads(href) {
  doc "Tells whether the bytes of href that span covers start with //.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first < last;
  let within = last <= href^.len;
  let located = band(ordered, within);
  if located {
  } else {
    return False();
  }
  let second = first + 1_u64;
  let room = second < last;
  if room {
  } else {
    return False();
  }
  let leading = href^[first] == solidus;
  let following = href^[second] == solidus;
  let both = band(leading, following);
  return both;
}

fn rebuild_href(url: &Url) -> result: Result<Box<Slots<u8>>, Fault> reads(url) {
  doc "Writes the URL serializer's output for the record's components, taking each component's bytes from its span of href: the scheme and a colon; when host_kind is not Absent, // and, when username or password is nonempty, the username, a colon and the password when the password is nonempty, and @, then the host and a colon and the decimal port when port is Some; when host_kind is Absent, /. when opaque_path is False and the path starts with //; then the path, ? and the query when query is Some, and # and the fragment when fragment is Some. HrefMismatch when host_kind is Absent and username or password is nonempty or port is Some, since href then cannot hold them, and when a nonempty span does not start where the serializer writes its component.";
  let length = url^.href.inner.len;
  let href = &url^.href.inner[0_u64..length];
  let rebuilt = box_slots_new::<u8>(capacity: 256_u64);
  let username = url^.username;
  let password = url^.password;
  let path = url^.path;
  let placed_scheme = propagate place_span(buffer: &rebuilt, href: href, span: url^.scheme);
  put_byte(buffer: &rebuilt, value: colon);
  let username_empty = span_empty(span: username);
  let password_empty = span_empty(span: password);
  let absent = host_absent(kind: url^.host_kind);
  if absent {
    let absent_port = url^.port;
    let port_absent = match absent_port {
      Some(value: number) => {
        give False();
      }
      None() => {
        give True();
      }
    }
    let credentials_empty = band(username_empty, password_empty);
    let unheld = band(credentials_empty, port_absent);
    if unheld {
    } else {
      let fault = Fault::HrefMismatch();
      return Err<Box<Slots<u8>>, Fault>(error: fault);
    }
    let opaque_path = url^.opaque_path;
    let doubled = starts_with_two_solidi(href: href, span: path);
    if opaque_path {
    } else if doubled {
      put_byte(buffer: &rebuilt, value: solidus);
      put_byte(buffer: &rebuilt, value: full_stop);
    }
  } else {
    put_byte(buffer: &rebuilt, value: solidus);
    put_byte(buffer: &rebuilt, value: solidus);
    let credentials_empty = band(username_empty, password_empty);
    if credentials_empty {
    } else {
      let placed_username = propagate place_span(buffer: &rebuilt, href: href, span: username);
      if password_empty {
      } else {
        put_byte(buffer: &rebuilt, value: colon);
        let placed_password = propagate place_span(buffer: &rebuilt, href: href, span: password);
      }
      put_byte(buffer: &rebuilt, value: commercial_at);
    }
    let placed_host = propagate place_span(buffer: &rebuilt, href: href, span: url^.host);
    let port_value = url^.port;
    match port_value {
      Some(value: number) => {
        put_byte(buffer: &rebuilt, value: colon);
        let widened = cvt::<u16, u64>(number);
        put_decimal(buffer: &rebuilt, value: widened);
      }
      None() => {
      }
    }
  }
  let placed_path = propagate place_span(buffer: &rebuilt, href: href, span: path);
  let query_value = url^.query;
  match query_value {
    Some(value: query) => {
      put_byte(buffer: &rebuilt, value: question_mark);
      let placed_query = propagate place_span(buffer: &rebuilt, href: href, span: query);
    }
    None() => {
    }
  }
  let fragment_value = url^.fragment;
  match fragment_value {
    Some(value: fragment) => {
      put_byte(buffer: &rebuilt, value: number_sign);
      let placed_fragment = propagate place_span(buffer: &rebuilt, href: href, span: fragment);
    }
    None() => {
    }
  }
  return Ok<Box<Slots<u8>>, Fault>(value: move rebuilt);
}

fn put_getters(buffer: &Box<Slots<u8>>, url: &Url) -> result: unit reads(url), writes(buffer) {
  doc "Appends the URL API's getters of a checked record as one JSON object: href; protocol, the scheme and a colon; username; password; host, the host and, when port is Some, a colon and the decimal port; hostname, the host; port, the decimal port or empty; pathname, the path; search, empty when query is None or empty and otherwise ? and the query; hash, empty when fragment is None or empty and otherwise # and the fragment.";
  let length = url^.href.inner.len;
  let port_value = url^.port;
  let href = &url^.href.inner[0_u64..length];
  let opening = &object_start[0_u64..object_start.len];
  put_text(buffer: buffer, text: opening);
  for (at in 0_u64..length) {
    let byte = href^[at];
    put_json_byte(buffer: buffer, byte: byte);
  }
  let protocol_key = &key_protocol[0_u64..key_protocol.len];
  put_text(buffer: buffer, text: protocol_key);
  put_json_span(buffer: buffer, href: href, span: url^.scheme);
  put_byte(buffer: buffer, value: colon);
  let username_key = &key_username[0_u64..key_username.len];
  put_text(buffer: buffer, text: username_key);
  put_json_span(buffer: buffer, href: href, span: url^.username);
  let password_key = &key_password[0_u64..key_password.len];
  put_text(buffer: buffer, text: password_key);
  put_json_span(buffer: buffer, href: href, span: url^.password);
  let host_key = &key_host[0_u64..key_host.len];
  put_text(buffer: buffer, text: host_key);
  put_json_span(buffer: buffer, href: href, span: url^.host);
  match port_value {
    Some(value: number) => {
      put_byte(buffer: buffer, value: colon);
      let widened = cvt::<u16, u64>(number);
      put_decimal(buffer: buffer, value: widened);
    }
    None() => {
    }
  }
  let hostname_key = &key_hostname[0_u64..key_hostname.len];
  put_text(buffer: buffer, text: hostname_key);
  put_json_span(buffer: buffer, href: href, span: url^.host);
  let port_key = &key_port[0_u64..key_port.len];
  put_text(buffer: buffer, text: port_key);
  match port_value {
    Some(value: number) => {
      let widened = cvt::<u16, u64>(number);
      put_decimal(buffer: buffer, value: widened);
    }
    None() => {
    }
  }
  let pathname_key = &key_pathname[0_u64..key_pathname.len];
  put_text(buffer: buffer, text: pathname_key);
  put_json_span(buffer: buffer, href: href, span: url^.path);
  let search_key = &key_search[0_u64..key_search.len];
  put_text(buffer: buffer, text: search_key);
  put_json_marked(buffer: buffer, href: href, span: url^.query, mark: question_mark);
  let hash_key = &key_hash[0_u64..key_hash.len];
  put_text(buffer: buffer, text: hash_key);
  put_json_marked(buffer: buffer, href: href, span: url^.fragment, mark: number_sign);
  let closing = &object_end[0_u64..object_end.len];
  put_text(buffer: buffer, text: closing);
  return unit;
}

fn put_json_marked(buffer: &Box<Slots<u8>>, href: &[u8], span: Option<UrlSpan>, mark: u8) -> result: unit reads(href), writes(buffer) {
  doc "Appends mark and the bytes of href that span covers, escaped for a JSON string, when span is Some and nonempty, and nothing otherwise.";
  match span {
    Some(value: present) => {
      let empty = span_empty(span: present);
      if empty {
      } else {
        put_byte(buffer: buffer, value: mark);
        put_json_span(buffer: buffer, href: href, span: present);
      }
    }
    None() => {
    }
  }
  return unit;
}

fn put_json_span(buffer: &Box<Slots<u8>>, href: &[u8], span: UrlSpan) -> result: unit reads(href), writes(buffer) {
  doc "Appends the bytes of href that span covers, escaped for a JSON string; appends nothing for a span outside href, which check_url has already refused.";
  let first = cvt::<u32, u64>(span.start);
  let last = cvt::<u32, u64>(span.end);
  let ordered = first <= last;
  let within = last <= href^.len;
  let valid = band(ordered, within);
  if valid {
    for (at in first..last) {
      let byte = href^[at];
      put_json_byte(buffer: buffer, byte: byte);
    }
  }
  return unit;
}

fn put_json_byte(buffer: &Box<Slots<u8>>, byte: u8) -> result: unit writes(buffer) {
  doc "Appends one byte of a JSON string: a quotation mark or reverse solidus after a reverse solidus, a byte below 0x20 as a \\u00XX escape, and every other byte unchanged.";
  let quote = byte == quotation_mark;
  let backslash = byte == reverse_solidus;
  let escaped = bor(quote, backslash);
  if escaped {
    put_byte(buffer: buffer, value: reverse_solidus);
    put_byte(buffer: buffer, value: byte);
    return unit;
  }
  let control = byte < first_printable;
  if control {
    let escape = &unicode_escape[0_u64..unicode_escape.len];
    put_text(buffer: buffer, text: escape);
    let widened = cvt::<u8, u64>(byte);
    let uppercase = True();
    put_hex(buffer: buffer, value: widened, width: 2_u64, uppercase: uppercase);
    return unit;
  }
  put_byte(buffer: buffer, value: byte);
  return unit;
}
