alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The text_oracle entry, invoked as `text_oracle FONTS CASES` with both paths relative to the working directory: FONTS the directory pkg::oracle::fonts::load_fonts reads the installed faces from, CASES a case file in the format tests/layout/text_oracle.mjs describes. It writes one line `F<TAB>N<TAB>NAME` per face of the set, N its index and NAME its PostScript name, then one result line per case in the case file's order, in that script's result format: for a text case, the case's text shaped as one paragraph of one run by pkg::layout::text with the case's family list, size, weight, style, spacing and wrapping, its width the sum of each face segment's advances in order, summed in f32 segment by segment as the reference sums its runs, times 64 and rounded up, its faces each segment's face index, with b appended when it draws with synthetic bold, and its scalar count, one entry per face in order of first use, and its breaks and emergency breaks the indices whose break is allowed or mandatory and emergency; for an extents case, the face_extents of the primary face of the case's family list at its size: ascent plus descent, ascent plus descent plus line gap, and the baseline, ascent plus half the line gap rounded down, and ten x-heights in 1/64 px, truncated. It exits with 0 after the last case, and with 2, after a message on standard error, when the arguments are not two, the faces or the case file cannot be read, a case is malformed, pick_fonts or shape_paragraph fails, or standard output refuses a write.";
