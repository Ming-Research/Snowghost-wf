alias OutputStream = std::io::OutputStream;
alias RuleItem = pkg::css::rules::RuleItem;
alias RuleItems = pkg::css::rules::RuleItems;
alias RulesError = pkg::css::rules::RulesError;
alias Span = pkg::css::syntax::Span;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias line_end = pkg::oracle::support::line_end;
alias nested_end = pkg::oracle::css_json::nested_end;
alias parse_block_contents = pkg::css::rules::parse_block_contents;
alias parse_component_values = pkg::css::syntax::parse_component_values;
alias parse_declaration_list = pkg::css::rules::parse_declaration_list;
