alias put_byte = pkg::oracle::support::put_byte;
alias put_components = pkg::oracle::css_json::put_components;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_fault = pkg::oracle::css_json::put_fault;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_string = pkg::oracle::css_json::put_string;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;
alias truncate = pkg::oracle::support::truncate;

const head_qualified_rule: Array<u8, 19> =[91_u8, 34_u8, 113_u8, 117_u8, 97_u8, 108_u8, 105_u8, 102_u8, 105_u8, 101_u8, 100_u8, 32_u8, 114_u8, 117_u8, 108_u8, 101_u8, 34_u8, 44_u8, 32_u8];

const head_at_rule: Array<u8, 12> =[91_u8, 34_u8, 97_u8, 116_u8, 45_u8, 114_u8, 117_u8, 108_u8, 101_u8, 34_u8, 44_u8, 32_u8];

const head_declaration: Array<u8, 16> =[91_u8, 34_u8, 100_u8, 101_u8, 99_u8, 108_u8, 97_u8, 114_u8, 97_u8, 116_u8, 105_u8, 111_u8, 110_u8, 34_u8, 44_u8, 32_u8];

const error_invalid: Array<u8, 20> =[91_u8, 34_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 34_u8, 44_u8, 32_u8, 34_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 34_u8, 93_u8];

const error_empty: Array<u8, 18> =[91_u8, 34_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 34_u8, 44_u8, 32_u8, 34_u8, 101_u8, 109_u8, 112_u8, 116_u8, 121_u8, 34_u8, 93_u8];

const error_extra_input: Array<u8, 24> =[91_u8, 34_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 34_u8, 44_u8, 32_u8, 34_u8, 101_u8, 120_u8, 116_u8, 114_u8, 97_u8, 45_u8, 105_u8, 110_u8, 112_u8, 117_u8, 116_u8, 34_u8, 93_u8];

const null_text: Array<u8, 4> =[110_u8, 117_u8, 108_u8, 108_u8];

const true_text: Array<u8, 4> =[116_u8, 114_u8, 117_u8, 101_u8];

const false_text: Array<u8, 5> =[102_u8, 97_u8, 108_u8, 115_u8, 101_u8];

const item_separator: Array<u8, 2> =[44_u8, 32_u8];

const range_separator: Array<u8, 2> =[46_u8, 46_u8];

const refused_tokenizer: Array<u8, 27> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 116_u8, 111_u8, 107_u8, 101_u8, 110_u8, 105_u8, 122_u8, 101_u8, 114_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 34_u8];

const refused_rules: Array<u8, 23> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 114_u8, 117_u8, 108_u8, 101_u8, 115_u8, 32_u8, 114_u8, 101_u8, 102_u8, 117_u8, 115_u8, 101_u8, 100_u8, 34_u8];

const fault_too_large: Array<u8, 24> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 97_u8, 114_u8, 103_u8, 101_u8, 34_u8];

const fault_too_many: Array<u8, 33> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 99_u8, 111_u8, 109_u8, 112_u8, 111_u8, 110_u8, 101_u8, 110_u8, 116_u8, 32_u8, 108_u8, 105_u8, 115_u8, 116_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 34_u8];

const fault_range: Array<u8, 23> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 114_u8, 97_u8, 110_u8, 103_u8, 101_u8, 32_u8];

const fault_name: Array<u8, 26> =[34_u8, 100_u8, 114_u8, 105_u8, 118_u8, 101_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 110_u8, 97_u8, 109_u8, 101_u8, 32_u8, 115_u8, 112_u8, 97_u8, 110_u8];

const fault_item: Array<u8, 9> =[32_u8, 105_u8, 110_u8, 32_u8, 105_u8, 116_u8, 101_u8, 109_u8, 32_u8];

const usage_text: Array<u8, 29> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 99_u8, 115_u8, 115_u8, 95_u8, 114_u8, 117_u8, 108_u8, 101_u8, 115_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 32_u8, 80_u8, 65_u8, 84_u8, 72_u8, 10_u8];

const unreadable_text: Array<u8, 30> =[99_u8, 115_u8, 115_u8, 95_u8, 114_u8, 117_u8, 108_u8, 101_u8, 115_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 32_u8];

const malformed_text: Array<u8, 46> =[99_u8, 115_u8, 115_u8, 95_u8, 114_u8, 117_u8, 108_u8, 101_u8, 115_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 109_u8, 97_u8, 108_u8, 102_u8, 111_u8, 114_u8, 109_u8, 101_u8, 100_u8, 32_u8, 99_u8, 97_u8, 115_u8, 101_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 97_u8, 116_u8, 32_u8, 98_u8, 121_u8, 116_u8, 101_u8, 32_u8];

const source_ceiling: u64 = 16777216_u64;

const component_ceiling: u64 = 4294967295_u64;

const top_level: u64 = 18446744073709551615_u64;

const blocked_start: u64 = 18446744073709551614_u64;

const suite_count: u64 = 6_u64;

const first_one_suite: u64 = 4_u64;

const stylesheet_suite: u64 = 0_u64;

const rule_list_suite: u64 = 1_u64;

const declaration_list_suite: u64 = 2_u64;

const one_rule_suite: u64 = 4_u64;

const line_feed: u8 = 10_u8;

const space: u8 = 32_u8;

const quotation_mark: u8 = 34_u8;

const left_square_bracket: u8 = 91_u8;

const right_square_bracket: u8 = 93_u8;

enum RuleFault {
  InvalidRange(item: u64, start: u32, end: u32);
  InvalidName(item: u64);
  Printing(fault: ComponentFault);
}

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, prints every case and closes the working directory.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the case file named by the one argument and prints its cases; returns 0 when the whole file was well formed and 2 otherwise.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let complete = print_cases(text: text, out: out, err: err, files: files, report: &report);
      if complete {
        return 0_u8;
      }
      return 2_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn report_malformed(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, position: u64) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports on standard error that the case starting at byte position of the case file is malformed.";
  let message = &malformed_text[0_u64..malformed_text.len];
  put_text(buffer: report, text: message);
  put_decimal(buffer: report, value: position);
  put_byte(buffer: report, value: line_feed);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn space_before(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first space in text from start to end, or end when there is none or the range leaves text.";
  let within = end <= text^.len;
  if within {
  } else {
    return end;
  }
  for (index in start..end) {
    let byte = text^[index];
    let found = byte == space;
    if found {
      return index;
    }
  }
  return end;
}

fn print_cases(text: &[u8], out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> complete: Bool reads(text), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Walks the case file: a header line holding the suite index and the byte length in decimal, separated by one space, that many bytes, then a line feed. Prints one line per case and flushes it at once. Returns False after reporting the first malformed case, including a suite index past the last suite.";
  let length = text^.len;
  let position = 0_u64;
  loop @cases {
    let more = position < length;
    if more {
    } else {
      break @cases;
    }
    let header_end = line_end(text: text, start: position);
    let separator = space_before(text: text, start: position, end: header_end);
    let suite = match parse_decimal(text: text, start: position, end: separator) {
      Some(value: case_suite) => {
        give case_suite;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let known = suite < suite_count;
    if known {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let size_start = separator +wrap 1_u64;
    let size = match parse_decimal(text: text, start: size_start, end: header_end) {
      Some(value: case_size) => {
        give case_size;
      }
      None() => {
        report_malformed(err: err, files: files, report: report, position: position);
        return False();
      }
    }
    let data_start = header_end +wrap 1_u64;
    let data_end = data_start +wrap size;
    let ordered = data_start <= data_end;
    let terminated = data_end < length;
    let located = band(ordered, terminated);
    if located {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    let terminator = text^[data_end];
    let closed = terminator == line_feed;
    if closed {
    } else {
      report_malformed(err: err, files: files, report: report, position: position);
      return False();
    }
    print_case(text: text, start: data_start, end: data_end, suite: suite, buffer: report);
    let written = flush(factory: files, output: out, buffer: report);
    set position = data_end +wrap 1_u64;
  }
  return True();
}

fn print_case(text: &[u8], start: u64, end: u64, suite: u64, buffer: &Box<Slots<u8>>) -> result: unit reads(text), writes(buffer) {
  doc "Tokenizes the bytes of one case from start to end, parses the component list with the suite's function and appends its JSON line, the refusal string when parse_component_values refuses it, or the fault string when the case is longer than parse_component_values admits.";
  let ordered = start <= end;
  let within = end <= text^.len;
  let located = band(ordered, within);
  let admitted = False();
  if located {
    let source = &text^[start..end];
    let small = source^.len <= source_ceiling;
    if small {
      match parse_component_values(source: source) {
        Ok(value: list) => {
          put_suite(buffer: buffer, list: &list, suite: suite);
        }
        Err(error: refusal) => {
          let message = &refused_tokenizer[0_u64..refused_tokenizer.len];
          put_text(buffer: buffer, text: message);
        }
      }
      set admitted = True();
    }
  }
  if admitted {
  } else {
    let message = &fault_too_large[0_u64..fault_too_large.len];
    put_text(buffer: buffer, text: message);
  }
  put_byte(buffer: buffer, value: line_feed);
  return unit;
}

fn put_suite(buffer: &Box<Slots<u8>>, list: &ComponentList, suite: u64) -> result: unit reads(list), writes(buffer) {
  doc "Parses the whole of list with the function of suite, an index below suite_count, and appends the result as JSON: the item array of a list suite, the one item or its error of a one suite, the refusal string when a list function refuses, or a fault string in place of everything else when the result names an invalid range or span.";
  let mark = buffer^.inner.len;
  let count = list^.components.inner.len;
  let fits = count <= component_ceiling;
  if fits {
  } else {
    let message = &fault_too_many[0_u64..fault_too_many.len];
    put_text(buffer: buffer, text: message);
    return unit;
  }
  let components = &list^.components.inner[0_u64..count];
  let table = parent_table(components: components);
  let placed = table.inner.len;
  let parents = &table.inner[0_u64..placed];
  let last = cvt.wrap::<u64, u32>(count);
  let whole = ComponentRange(start: 0_u32, end: last);
  let listed = suite < first_one_suite;
  if listed {
    match parse_list(values: list, range: whole, suite: suite) {
      Ok(value: items) => {
        let outcome = put_items(buffer: buffer, list: list, parents: parents, items: &items);
        settle(buffer: buffer, mark: mark, outcome: outcome);
      }
      Err(error: refusal) => {
        let message = &refused_rules[0_u64..refused_rules.len];
        put_text(buffer: buffer, text: message);
      }
    }
    return unit;
  }
  match parse_one(values: list, range: whole, suite: suite) {
    Ok(value: item) => {
      let only = 0_u64;
      let outcome = put_item(buffer: buffer, list: list, parents: parents, item: item, index: only);
      settle(buffer: buffer, mark: mark, outcome: outcome);
    }
    Err(error: failure) => {
      put_one_error(buffer: buffer, failure: failure);
    }
  }
  return unit;
}

fn parse_list(values: &ComponentList, range: ComponentRange, suite: u64) -> result: Result<RuleItems, RulesError> reads(values) {
  doc "Runs the list function of suite: parse_stylesheet, parse_rule_list, parse_declaration_list, or parse_block_contents for every other index.";
  let stylesheet = suite == stylesheet_suite;
  if stylesheet {
    let parsed = parse_stylesheet(values: values, range: range);
    return move parsed;
  }
  let rule_list = suite == rule_list_suite;
  if rule_list {
    let parsed = parse_rule_list(values: values, range: range);
    return move parsed;
  }
  let declaration_list = suite == declaration_list_suite;
  if declaration_list {
    let parsed = parse_declaration_list(values: values, range: range);
    return move parsed;
  }
  let parsed = parse_block_contents(values: values, range: range);
  return move parsed;
}

fn parse_one(values: &ComponentList, range: ComponentRange, suite: u64) -> result: Result<RuleItem, OneError> reads(values) {
  doc "Runs the one function of suite: parse_one_rule, or parse_one_declaration for every other index.";
  let one_rule = suite == one_rule_suite;
  if one_rule {
    let parsed = parse_one_rule(values: values, range: range);
    return parsed;
  }
  let parsed = parse_one_declaration(values: values, range: range);
  return parsed;
}

fn settle(buffer: &Box<Slots<u8>>, mark: u64, outcome: Result<unit, RuleFault>) -> result: unit writes(buffer) {
  doc "Keeps what was appended after mark when outcome is Ok, and replaces it with the fault string otherwise.";
  match outcome {
    Ok(value: done) => {
    }
    Err(error: fault) => {
      truncate(buffer: buffer, length: mark);
      put_rule_fault(buffer: buffer, fault: fault);
    }
  }
  return unit;
}

fn put_rule_fault(buffer: &Box<Slots<u8>>, fault: RuleFault) -> result: unit writes(buffer) {
  doc "Appends a fault as a JSON string: \"driver: invalid range S..E in item N\", \"driver: invalid name span in item N\", or the component fault's own string.";
  match fault {
    InvalidRange(item: index, start: first, end: last) => {
      let message = &fault_range[0_u64..fault_range.len];
      put_text(buffer: buffer, text: message);
      let wide_first = cvt::<u32, u64>(first);
      put_decimal(buffer: buffer, value: wide_first);
      let dots = &range_separator[0_u64..range_separator.len];
      put_text(buffer: buffer, text: dots);
      let wide_last = cvt::<u32, u64>(last);
      put_decimal(buffer: buffer, value: wide_last);
      let where = &fault_item[0_u64..fault_item.len];
      put_text(buffer: buffer, text: where);
      put_decimal(buffer: buffer, value: index);
      put_byte(buffer: buffer, value: quotation_mark);
    }
    InvalidName(item: index) => {
      let message = &fault_name[0_u64..fault_name.len];
      put_text(buffer: buffer, text: message);
      let where = &fault_item[0_u64..fault_item.len];
      put_text(buffer: buffer, text: where);
      put_decimal(buffer: buffer, value: index);
      put_byte(buffer: buffer, value: quotation_mark);
    }
    Printing(fault: component_fault) => {
      put_fault(buffer: buffer, fault: component_fault);
    }
  }
  return unit;
}

fn put_one_error(buffer: &Box<Slots<u8>>, failure: OneError) -> result: unit writes(buffer) {
  doc "Appends a one function's error in css-parsing-tests' representation: [\"error\", \"empty\"], [\"error\", \"extra-input\"] or [\"error\", \"invalid\"].";
  match failure {
    Empty() => {
      let text = &error_empty[0_u64..error_empty.len];
      put_text(buffer: buffer, text: text);
    }
    ExtraInput() => {
      let text = &error_extra_input[0_u64..error_extra_input.len];
      put_text(buffer: buffer, text: text);
    }
    Invalid() => {
      let text = &error_invalid[0_u64..error_invalid.len];
      put_text(buffer: buffer, text: text);
    }
  }
  return unit;
}

fn put_items(buffer: &Box<Slots<u8>>, list: &ComponentList, parents: &[u64], items: &RuleItems) -> result: Result<unit, RuleFault> reads(list), reads(parents), reads(items), writes(buffer) {
  doc "Appends every item of items as one JSON array, in order, judging ranges against parents, parent_table's table of list; stops at the first item that names an invalid range or span.";
  let count = items^.items.inner.len;
  let entries = &items^.items.inner[0_u64..count];
  put_byte(buffer: buffer, value: left_square_bracket);
  for (index in 0_u64..count) {
    let later = index > 0_u64;
    if later {
      let separator = &item_separator[0_u64..item_separator.len];
      put_text(buffer: buffer, text: separator);
    }
    let item = entries^[index];
    let written = propagate put_item(buffer: buffer, list: list, parents: parents, item: item, index: index);
  }
  put_byte(buffer: buffer, value: right_square_bracket);
  return Ok<unit, RuleFault>(value: unit);
}

fn put_item(buffer: &Box<Slots<u8>>, list: &ComponentList, parents: &[u64], item: RuleItem, index: u64) -> result: Result<unit, RuleFault> reads(list), reads(parents), writes(buffer) {
  doc "Appends one item in css-parsing-tests' representation: [\"qualified rule\", PRELUDE, BLOCK], [\"at-rule\", NAME, PRELUDE, BLOCK or null], [\"declaration\", NAME, VALUE, IMPORTANT] or [\"error\", \"invalid\"], each range as the array of the components it names, judged against parents, parent_table's table of list. Index is the item's position, which a fault names.";
  let separator = &item_separator[0_u64..item_separator.len];
  match item {
    QualifiedRule(prelude: rule_prelude, block: rule_block) => {
      let head = &head_qualified_rule[0_u64..head_qualified_rule.len];
      put_text(buffer: buffer, text: head);
      let preluded = propagate put_range(buffer: buffer, list: list, parents: parents, range: rule_prelude, index: index);
      put_text(buffer: buffer, text: separator);
      let blocked = propagate put_range(buffer: buffer, list: list, parents: parents, range: rule_block, index: index);
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    AtRule(name: rule_name, prelude: rule_prelude, block: rule_block) => {
      let head = &head_at_rule[0_u64..head_at_rule.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_name(buffer: buffer, list: list, name: rule_name, index: index);
      put_text(buffer: buffer, text: separator);
      let preluded = propagate put_range(buffer: buffer, list: list, parents: parents, range: rule_prelude, index: index);
      put_text(buffer: buffer, text: separator);
      match rule_block {
        Some(value: contents) => {
          let blocked = propagate put_range(buffer: buffer, list: list, parents: parents, range: contents, index: index);
        }
        None() => {
          let absent = &null_text[0_u64..null_text.len];
          put_text(buffer: buffer, text: absent);
        }
      }
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Declaration(name: rule_name, value: rule_value, important: rule_important) => {
      let head = &head_declaration[0_u64..head_declaration.len];
      put_text(buffer: buffer, text: head);
      let named = propagate put_name(buffer: buffer, list: list, name: rule_name, index: index);
      put_text(buffer: buffer, text: separator);
      let valued = propagate put_range(buffer: buffer, list: list, parents: parents, range: rule_value, index: index);
      put_text(buffer: buffer, text: separator);
      if rule_important {
        let flag = &true_text[0_u64..true_text.len];
        put_text(buffer: buffer, text: flag);
      } else {
        let flag = &false_text[0_u64..false_text.len];
        put_text(buffer: buffer, text: flag);
      }
      put_byte(buffer: buffer, value: right_square_bracket);
    }
    Invalid() => {
      let text = &error_invalid[0_u64..error_invalid.len];
      put_text(buffer: buffer, text: text);
    }
  }
  return Ok<unit, RuleFault>(value: unit);
}

fn put_name(buffer: &Box<Slots<u8>>, list: &ComponentList, name: Span, index: u64) -> result: Result<unit, RuleFault> reads(list), writes(buffer) {
  doc "Appends the name that span name covers in list.text as a JSON string; a span that leaves list.text is the fault InvalidName of the item at index.";
  let named = put_string(buffer: buffer, list: list, span: name);
  if named {
    return Ok<unit, RuleFault>(value: unit);
  }
  let fault = RuleFault::InvalidName(item: index);
  return Err<unit, RuleFault>(error: fault);
}

fn put_range(buffer: &Box<Slots<u8>>, list: &ComponentList, parents: &[u64], range: ComponentRange, index: u64) -> result: Result<unit, RuleFault> reads(list), reads(parents), writes(buffer) {
  doc "Appends the components that range names as one JSON array. A range that is not a run of siblings of list, as range_is_siblings judges it against parents, parent_table's table of list, is the fault InvalidRange of the item at index, and a fault of a component inside it is the fault Printing.";
  let count = list^.components.inner.len;
  let components = &list^.components.inner[0_u64..count];
  let first = cvt::<u32, u64>(range.start);
  let last = cvt::<u32, u64>(range.end);
  let siblings = range_is_siblings(components: components, parents: parents, start: first, end: last);
  if siblings {
  } else {
    let fault = RuleFault::InvalidRange(item: index, start: range.start, end: range.end);
    return Err<unit, RuleFault>(error: fault);
  }
  match put_components(buffer: buffer, list: list, from: first, to: last) {
    Ok(value: done) => {
      return Ok<unit, RuleFault>(value: unit);
    }
    Err(error: component_fault) => {
      let fault = RuleFault::Printing(fault: component_fault);
      return Err<unit, RuleFault>(error: fault);
    }
  }
}

fn parent_table(components: &[Component]) -> table: Box<Slots<u64>> reads(components) contract {
  requires components^.len <= 4294967295_u64;
} {
  doc "Returns, in one pass over components in order, the index of each component's innermost enclosing Function or block, or top_level for a component at the top level. A Function or block whose end index does not lie after it and within its parent is invalid, and it and every later component inside that parent get blocked_start, since every nonempty run that starts there reaches it; components inside a Function or block that a run steps over are never reached, so an invalid one among them blocks only its own parent's remainder.";
  let count = components^.len;
  let table = box_slots_new::<u64>(capacity: count);
  let container = top_level;
  let limit = count;
  let at = 0_u64;
  loop @walk {
    loop @close {
      let closing = at == limit;
      let nested = container != top_level;
      let finished = band(closing, nested);
      if finished {
      } else {
        break @close;
      }
      set container = parent_of(table: &table, index: container);
      set limit = enclosing_limit(components: components, parent: container);
    }
    let more = at < count;
    if more {
    } else {
      break @walk;
    }
    let component = components^[at];
    let next = at +wrap 1_u64;
    match nested_end(component: component) {
      Some(value: written_end) => {
        let closing = cvt::<u32, u64>(written_end);
        let after = closing >= next;
        let enclosed = closing <= limit;
        let valid = band(after, enclosed);
        if valid {
          place_parent(table: &table, parent: container);
          set container = at;
          set limit = closing;
          set at = next;
        } else {
          loop @block {
            let inside = at < limit;
            if inside {
            } else {
              break @block;
            }
            place_parent(table: &table, parent: blocked_start);
            set at = at +wrap 1_u64;
          }
        }
      }
      None() => {
        place_parent(table: &table, parent: container);
        set at = next;
      }
    }
  }
  return move table;
}

fn place_parent(table: &Box<Slots<u64>>, parent: u64) -> result: unit writes(table) {
  doc "Appends parent to table when it has room; parent_table sizes table to hold one entry per component, so it always has.";
  let room = table^.inner.len < table^.inner.cap;
  if room {
    place_back(window: &table^.inner, value: parent);
  }
  return unit;
}

fn parent_of(table: &Box<Slots<u64>>, index: u64) -> result: u64 reads(table) {
  doc "Returns the entry of table at index, which parent_table has already placed for every Function or block it enters, or top_level past the entries placed.";
  let placed = index < table^.inner.len;
  if placed {
    return table^.inner[index];
  }
  return top_level;
}

fn enclosing_limit(components: &[Component], parent: u64) -> result: u64 reads(components) {
  doc "Returns the index after the last component that parent holds: the component count for top_level, the end index of the Function or block at parent, and 0 for blocked_start or any other index, which holds nothing.";
  let count = components^.len;
  let top = parent == top_level;
  if top {
    return count;
  }
  let present = parent < count;
  if present {
  } else {
    return 0_u64;
  }
  let component = components^[parent];
  match nested_end(component: component) {
    Some(value: written_end) => {
      let closing = cvt::<u32, u64>(written_end);
      return closing;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn range_is_siblings(components: &[Component], parents: &[u64], start: u64, end: u64) -> result: Bool reads(components), reads(parents) {
  doc "Returns whether start to end names a run of siblings with their contents: start at most end, end at most the component count, and, for a nonempty run, end at most the end of start's parent in parents, the table parent_table computes, with every component the walk from start reaches by stepping over contents inside that parent, the walk landing exactly on end. A Function or block whose end index does not lie after it and within its parent makes every run that reaches it invalid: parent_table blocks every start after it inside its parent, and the walk refuses it when a run steps onto it. The walk is linear in the length of the run.";
  let count = components^.len;
  let ordered = start <= end;
  let inside = end <= count;
  let located = band(ordered, inside);
  if located {
  } else {
    return False();
  }
  let empty = start == end;
  if empty {
    return True();
  }
  let listed = start < parents^.len;
  if listed {
  } else {
    return False();
  }
  let parent = parents^[start];
  let limit = enclosing_limit(components: components, parent: parent);
  let within = end <= limit;
  if within {
  } else {
    return False();
  }
  let at = start;
  loop @siblings {
    let finished = at == end;
    if finished {
      return True();
    }
    let short = at < end;
    let present = at < count;
    let walkable = band(short, present);
    if walkable {
    } else {
      return False();
    }
    let component = components^[at];
    let next = at +wrap 1_u64;
    match nested_end(component: component) {
      Some(value: written_end) => {
        let closing = cvt::<u32, u64>(written_end);
        let after = closing >= next;
        let enclosed = closing <= end;
        let valid = band(after, enclosed);
        if valid {
        } else {
          return False();
        }
        set next = closing;
      }
      None() => {
      }
    }
    set at = next;
  }
}
