const code_point_word: Array<u8, 11> =[99_u8, 111_u8, 100_u8, 101_u8, 32_u8, 112_u8, 111_u8, 105_u8, 110_u8, 116_u8, 32_u8];

const colon_word: Array<u8, 2> =[58_u8, 32_u8];

const composed_call: Array<u8, 6> =[116_u8, 111_u8, 78_u8, 70_u8, 67_u8, 40_u8];

const decomposed_call: Array<u8, 6> =[116_u8, 111_u8, 78_u8, 70_u8, 68_u8, 40_u8];

const column_word: Array<u8, 1> =[99_u8];

const scalar_word: Array<u8, 1> =[88_u8];

const is_word: Array<u8, 5> =[41_u8, 32_u8, 105_u8, 115_u8, 32_u8];

const expected_word: Array<u8, 11> =[44_u8, 32_u8, 101_u8, 120_u8, 112_u8, 101_u8, 99_u8, 116_u8, 101_u8, 100_u8, 32_u8];

const too_large_text: Array<u8, 20> =[41_u8, 32_u8, 114_u8, 101_u8, 116_u8, 117_u8, 114_u8, 110_u8, 101_u8, 100_u8, 32_u8, 84_u8, 111_u8, 111_u8, 76_u8, 97_u8, 114_u8, 103_u8, 101_u8, 10_u8];

const prefix_word: Array<u8, 43> =[41_u8, 32_u8, 100_u8, 105_u8, 100_u8, 32_u8, 110_u8, 111_u8, 116_u8, 32_u8, 107_u8, 101_u8, 101_u8, 112_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 111_u8, 117_u8, 116_u8, 112_u8, 117_u8, 116_u8, 39_u8, 115_u8, 32_u8, 112_u8, 114_u8, 105_u8, 111_u8, 114_u8, 32_u8, 99_u8, 111_u8, 110_u8, 116_u8, 101_u8, 110_u8, 116_u8, 115_u8, 32_u8];

