const oversized_text: Array<u8, 58> =[41_u8, 32_u8, 119_u8, 97_u8, 115_u8, 32_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 117_u8, 110_u8, 58_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 105_u8, 110_u8, 112_u8, 117_u8, 116_u8, 32_u8, 105_u8, 115_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 101_u8, 114_u8, 32_u8, 116_u8, 104_u8, 97_u8, 110_u8, 32_u8, 110_u8, 111_u8, 114_u8, 109_u8, 97_u8, 108_u8, 105_u8, 122_u8, 101_u8, 32_u8, 97_u8, 99_u8, 99_u8, 101_u8, 112_u8, 116_u8, 115_u8, 10_u8];

const empty_word: Array<u8, 7> =[40_u8, 101_u8, 109_u8, 112_u8, 116_u8, 121_u8, 41_u8];

const elision_word: Array<u8, 4> =[32_u8, 46_u8, 46_u8, 46_u8];

const invariant_sources: Array<u8, 10> =[1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8];

const invariant_expectations: Array<u8, 10> =[2_u8, 2_u8, 2_u8, 4_u8, 4_u8, 3_u8, 3_u8, 3_u8, 5_u8, 5_u8];

const composed_invariants: u64 = 5_u64;

const invariant_count: u64 = 10_u64;

const column_count: u64 = 5_u64;

const shown_failure_limit: u64 = 10_u64;

const shown_code_point_limit: u64 = 64_u64;

const line_ceiling: u64 = 65536_u64;

const normalize_ceiling: u64 = 268435456_u64;

const code_space: u64 = 1114112_u64;

const surrogate_first: u64 = 55296_u64;

const surrogate_last: u64 = 57343_u64;

const largest_code_point: u32 = 1114111_u32;

const prefix_length: u64 = 2_u64;

const prefix_first: u32 = 8491_u32;

const composed_prefix_last: u32 = 65_u32;

const decomposed_prefix_last: u32 = 837_u32;

const reused_output_capacity: u64 = 64_u64;

const outcome_passed: u8 = 0_u8;

const outcome_mismatch: u8 = 1_u8;

const outcome_prefix: u8 = 2_u8;

const outcome_too_large: u8 = 3_u8;

const outcome_oversized: u8 = 4_u8;

const listed: u8 = 1_u8;

const number_sign: u8 = 35_u8;

const at_sign: u8 = 64_u8;

const semicolon: u8 = 59_u8;

const space: u8 = 32_u8;

const tab: u8 = 9_u8;

const line_feed: u8 = 10_u8;

const digit_zero: u8 = 48_u8;

const digit_nine: u8 = 57_u8;

const upper_a: u8 = 65_u8;

const upper_f: u8 = 70_u8;

const lower_a: u8 = 97_u8;

const lower_f: u8 = 102_u8;

const no_hex_digit: u8 = 16_u8;

struct Tally {
  cases: u64;
  passed: u64;
  failed: u64;
}

struct Scan {
  lines: u64;
  unparsed_line: u64;
}

fn run(inputs: Inputs) -> status: ExitStatus pure {
  doc "Destructures the inputs, judges the file and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = judge_file(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn judge_file(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Reads the file named by the one argument, checks that every test line parses while it marks each code point that is the whole c1 of a test line, judges the test lines and then every unmarked scalar value, prints the summary and returns the exit code.";
  let report = box_slots_new::<u8>(capacity: 4096_u64);
  let count = args_count(args: args);
  let usable = count == 2_u64;
  if usable {
  } else {
    let usage = &usage_text[0_u64..usage_text.len];
    put_text(buffer: &report, text: usage);
    let written = flush(factory: files, output: err, buffer: &report);
    return 2_u8;
  }
  match read_argument_file(factory: files, cwd: cwd, args: args, position: 1_u64) {
    Ok(value: content) => {
      let length = content.inner.len;
      let text = &content.inner[0_u64..length];
      let seen = box_array_filled::<u8>(count: code_space, value: 0_u8);
      let scan = scan_lines(text: text, seen: &seen);
      let unparsed = scan.unparsed_line > 0_u64;
      if unparsed {
        let message = &unparsed_text[0_u64..unparsed_text.len];
        put_text(buffer: &report, text: message);
        put_decimal(buffer: &report, value: scan.unparsed_line);
        let of_label = &of_word[0_u64..of_word.len];
        put_text(buffer: &report, text: of_label);
        put_argument(buffer: &report, args: args, position: 1_u64);
        put_byte(buffer: &report, value: line_feed);
        let noted = flush(factory: files, output: err, buffer: &report);
        return 2_u8;
      }
      let empty = scan.lines == 0_u64;
      if empty {
        let message = &no_lines_text[0_u64..no_lines_text.len];
        put_text(buffer: &report, text: message);
        put_argument(buffer: &report, args: args, position: 1_u64);
        put_byte(buffer: &report, value: line_feed);
        let noted = flush(factory: files, output: err, buffer: &report);
        return 2_u8;
      }
      let listed_tally = judge_lines(text: text, out: out, files: files, report: &report);
      let scalar_tally = judge_code_points(seen: &seen, failed_before: listed_tally.failed, out: out, files: files, report: &report);
      let cases = listed_tally.cases +wrap scalar_tally.cases;
      let passed = listed_tally.passed +wrap scalar_tally.passed;
      let failed = listed_tally.failed +wrap scalar_tally.failed;
      let name = &summary_name[0_u64..summary_name.len];
      put_summary(buffer: &report, name: name, cases: cases, passed: passed, failed: failed);
      let written = flush(factory: files, output: out, buffer: &report);
      let clean = failed == 0_u64;
      let some = cases > 0_u64;
      let success = band(clean, some);
      if success {
        return 0_u8;
      }
      return 1_u8;
    }
    Err(error: problem) => {
      let message = &unreadable_text[0_u64..unreadable_text.len];
      put_text(buffer: &report, text: message);
      put_argument(buffer: &report, args: args, position: 1_u64);
      put_host_error(buffer: &report, error: problem);
      put_byte(buffer: &report, value: line_feed);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
  }
}

fn is_test_line(text: &[u8], start: u64) -> result: Bool reads(text) {
  doc "Tells whether the line that starts at start is a test line: not empty, and not starting with a number sign, which begins a comment line, or an at sign, which begins a part header.";
  let length = text^.len;
  let inside = start < length;
  if inside {
  } else {
    return False();
  }
  let first = text^[start];
  let blank = first == line_feed;
  let comment = first == number_sign;
  let header = first == at_sign;
  let blank_or_comment = bor(blank, comment);
  let skipped = bor(blank_or_comment, header);
  return bnot(skipped);
}

fn scan_lines(text: &[u8], seen: &Box<Array<u8>>) -> scan: Scan reads(text), writes(seen) {
  doc "Parses every test line and marks seen at each code point that is the whole c1 of one. Returns the number of test lines and the number, counting from 1, of the first line that does not parse, or 0 when every one parses.";
  let length = text^.len;
  let start = 0_u64;
  let line_number = 0_u64;
  let lines = 0_u64;
  loop @lines {
    let more = start < length;
    if more {
    } else {
      break @lines;
    }
    let end = line_end(text: text, start: start);
    set line_number = line_number +wrap 1_u64;
    let testing = is_test_line(text: text, start: start);
    if testing {
      set lines = lines +wrap 1_u64;
      let points = box_slots_new::<u32>(capacity: 0_u64);
      let bounds = box_slots_new::<u64>(capacity: 0_u64);
      let parsed = read_case(text: text, start: start, end: end, points: &points, bounds: &bounds);
      if parsed {
      } else {
        return Scan(lines: lines, unparsed_line: line_number);
      }
      let first_bounded = 1_u64 < bounds.inner.len;
      let has_point = 0_u64 < points.inner.len;
      let readable = band(first_bounded, has_point);
      if readable {
        let first_end = bounds.inner[1_u64];
        let single = first_end == 1_u64;
        if single {
          let code_point = points.inner[0_u64];
          let index = cvt::<u32, u64>(code_point);
          let inside = index < seen^.inner.len;
          if inside {
            set seen^.inner[index] = listed;
          }
        }
      }
    }
    set start = end +wrap 1_u64;
  }
  return Scan(lines: lines, unparsed_line: 0_u64);
}

fn read_case(text: &[u8], start: u64, end: u64, points: &Box<Slots<u32>>, bounds: &Box<Slots<u64>>) -> parsed: Bool reads(text), writes(points), writes(bounds) {
  doc "Gives points room for every code point of the test line from start to end and bounds room for six offsets, then parses the line with parse_case. Returns False for a line longer than line_ceiling.";
  let span = end -wrap start;
  let ordered = start <= end;
  let bounded = span <= line_ceiling;
  let usable = band(ordered, bounded);
  if usable {
  } else {
    return False();
  }
  set points^ = box_slots_new::<u32>(capacity: span);
  set bounds^ = box_slots_new::<u64>(capacity: 6_u64);
  let stop = comment_start(text: text, start: start, end: end);
  let parsed = parse_case(text: text, start: start, stop: stop, points: points, bounds: bounds);
  return parsed;
}

fn comment_start(text: &[u8], start: u64, end: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first number sign from start to end, where the line's comment begins, or end.";
  let length = text^.len;
  let within = end <= length;
  if within {
  } else {
    return end;
  }
  let ordered = start <= end;
  if ordered {
  } else {
    return end;
  }
  for (at in start..end) {
    let byte = text^[at];
    let found = byte == number_sign;
    if found {
      return at;
    }
  }
  return end;
}

fn is_blank(byte: u8) -> result: Bool pure {
  doc "Tells whether byte separates two code points of a column: a space or a tab.";
  let spaced = byte == space;
  let tabbed = byte == tab;
  let blank = bor(spaced, tabbed);
  return blank;
}

fn skip_blanks(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first byte from from to stop that is not blank, or stop.";
  let length = text^.len;
  let at = from;
  loop @skip {
    let before_stop = at < stop;
    let inside = at < length;
    let readable = band(before_stop, inside);
    if readable {
    } else {
      return stop;
    }
    let byte = text^[at];
    let blank = is_blank(byte: byte);
    if blank {
    } else {
      return at;
    }
    set at = at +wrap 1_u64;
  }
  return stop;
}

fn field_end(text: &[u8], from: u64, stop: u64) -> result: u64 reads(text) {
  doc "Returns the index of the first blank byte or semicolon from from to stop, or stop: the end of the code point that starts at from.";
  let length = text^.len;
  let at = from;
  loop @scan {
    let before_stop = at < stop;
    let inside = at < length;
    let readable = band(before_stop, inside);
    if readable {
    } else {
      return stop;
    }
    let byte = text^[at];
    let blank = is_blank(byte: byte);
    let separator = byte == semicolon;
    let ended = bor(blank, separator);
    if ended {
      return at;
    }
    set at = at +wrap 1_u64;
  }
  return stop;
}

fn hex_digit(byte: u8) -> result: u8 pure {
  doc "Returns the value of one ASCII hexadecimal digit, of either case, or no_hex_digit for any other byte.";
  let decimal_low = byte >= digit_zero;
  let decimal_high = byte <= digit_nine;
  let decimal = band(decimal_low, decimal_high);
  if decimal {
    return byte -wrap digit_zero;
  }
  let upper_low = byte >= upper_a;
  let upper_high = byte <= upper_f;
  let upper = band(upper_low, upper_high);
  if upper {
    let offset = byte -wrap upper_a;
    return offset +wrap 10_u8;
  }
  let lower_low = byte >= lower_a;
  let lower_high = byte <= lower_f;
  let lower = band(lower_low, lower_high);
  if lower {
    let offset = byte -wrap lower_a;
    return offset +wrap 10_u8;
  }
  return no_hex_digit;
}

fn code_point_value(text: &[u8], from: u64, end: u64) -> result: Option<u32> reads(text) {
  doc "Parses the field from from to end as a code point of 1 to 6 hexadecimal digits no greater than largest_code_point; returns None for any other field.";
  let length = text^.len;
  let size = end -wrap from;
  let ordered = from < end;
  let within = end <= length;
  let short = size <= 6_u64;
  let located = band(ordered, within);
  let usable = band(located, short);
  if usable {
  } else {
    return None<u32>();
  }
  let value = 0_u32;
  for (at in from..end) {
    let byte = text^[at];
    let digit = hex_digit(byte: byte);
    let valid = digit < no_hex_digit;
    if valid {
    } else {
      return None<u32>();
    }
    let widened = cvt::<u8, u32>(digit);
    let shifted = ishl.wrap(value, 4_u32);
    set value = ior(shifted, widened);
  }
  let in_range = value <= largest_code_point;
  if in_range {
    return Some<u32>(value: value);
  }
  return None<u32>();
}

fn parse_case(text: &[u8], start: u64, stop: u64, points: &Box<Slots<u32>>, bounds: &Box<Slots<u64>>) -> parsed: Bool reads(text), writes(points), writes(bounds) {
  doc "Parses the five columns of one test line from start to stop, each one or more code points separated by blanks and ended by a semicolon, with only blanks after the fifth semicolon. Appends every code point to points in order and appends to bounds 0 and then the len of points after each column, so column k spans from bounds[k - 1] to bounds[k]. Returns False when the line has any other shape.";
  let first_room = bounds^.inner.len < bounds^.inner.cap;
  if first_room {
    place_back(window: &bounds^.inner, value: 0_u64);
  } else {
    return False();
  }
  let at = start;
  for (column in 0_u64..column_count) {
    let column_start = points^.inner.len;
    loop @fields {
      set at = skip_blanks(text: text, from: at, stop: stop);
      let more = at < stop;
      let inside = at < text^.len;
      let readable = band(more, inside);
      if readable {
      } else {
        return False();
      }
      let byte = text^[at];
      let separator = byte == semicolon;
      if separator {
        break @fields;
      }
      let end = field_end(text: text, from: at, stop: stop);
      match code_point_value(text: text, from: at, end: end) {
        Some(value: code_point) => {
          let room = points^.inner.len < points^.inner.cap;
          if room {
            place_back(window: &points^.inner, value: code_point);
          } else {
            return False();
          }
        }
        None() => {
          return False();
        }
      }
      set at = end;
    }
    let column_end = points^.inner.len;
    let filled = column_end > column_start;
    if filled {
    } else {
      return False();
    }
    let room = bounds^.inner.len < bounds^.inner.cap;
    if room {
      place_back(window: &bounds^.inner, value: column_end);
    } else {
      return False();
    }
    set at = at +wrap 1_u64;
  }
  let rest = skip_blanks(text: text, from: at, stop: stop);
  let finished = rest >= stop;
  return finished;
}

fn judge_lines(text: &[u8], out: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> tally: Tally reads(text), writes(out), writes(files), writes(report) {
  doc "Walks the file line by line and judges every test line as one case. Line numbers count from 1. The first shown_failure_limit failing cases are reported and flushed as they are found. A line that does not parse, which scan_lines has already ruled out, fails.";
  let length = text^.len;
  let start = 0_u64;
  let line_number = 0_u64;
  let cases = 0_u64;
  let passed = 0_u64;
  let failed = 0_u64;
  loop @lines {
    let more = start < length;
    if more {
    } else {
      break @lines;
    }
    let end = line_end(text: text, start: start);
    set line_number = line_number +wrap 1_u64;
    let testing = is_test_line(text: text, start: start);
    if testing {
      set cases = cases +wrap 1_u64;
      let shown = failed < shown_failure_limit;
      let points = box_slots_new::<u32>(capacity: 0_u64);
      let bounds = box_slots_new::<u64>(capacity: 0_u64);
      let parsed = read_case(text: text, start: start, end: end, points: &points, bounds: &bounds);
      let passing = False();
      if parsed {
        let point_count = points.inner.len;
        let point_slice = &points.inner[0_u64..point_count];
        let bound_count = bounds.inner.len;
        let bound_slice = &bounds.inner[0_u64..bound_count];
        set passing = judge_case(points: point_slice, bounds: bound_slice, line_number: line_number, shown: shown, report: report);
      }
      if passing {
        set passed = passed +wrap 1_u64;
      } else {
        set failed = failed +wrap 1_u64;
        let written = flush(factory: files, output: out, buffer: report);
      }
    }
    set start = end +wrap 1_u64;
  }
  return Tally(cases: cases, passed: passed, failed: failed);
}

fn prefix_last(composed: Bool) -> result: u32 pure {
  doc "Returns the second code point of the sentinel prefix: 0041, which composes with many marks, for Composed, and 0345, of combining class 240, for Decomposed. The first is 212B, which both forms change.";
  if composed {
    return composed_prefix_last;
  }
  return decomposed_prefix_last;
}

fn fill_prefix(output: &Box<Slots<u32>>, composed: Bool) -> result: unit writes(output) {
  doc "Empties output and places the sentinel prefix of the form in it, growing it when it has less room than the prefix.";
  loop @empty {
    let held = output^.inner.len > 0_u64;
    if held {
      let dropped = take_back(window: &output^.inner);
    } else {
      break @empty;
    }
  }
  let small = output^.inner.cap < prefix_length;
  if small {
    grow(cell: output, capacity: prefix_length);
  }
  let last = prefix_last(composed: composed);
  let first_room = output^.inner.len < output^.inner.cap;
  if first_room {
    place_back(window: &output^.inner, value: prefix_first);
  }
  let last_room = output^.inner.len < output^.inner.cap;
  if last_room {
    place_back(window: &output^.inner, value: last);
  }
  return unit;
}

fn prefix_kept(output: &Box<Slots<u32>>, composed: Bool) -> result: Bool reads(output) {
  doc "Tells whether output starts with the sentinel prefix of the form.";
  let long_enough = output^.inner.len >= prefix_length;
  if long_enough {
  } else {
    return False();
  }
  let last = prefix_last(composed: composed);
  let first_inside = 0_u64 < output^.inner.len;
  let last_inside = 1_u64 < output^.inner.len;
  let both_inside = band(first_inside, last_inside);
  if both_inside {
  } else {
    return False();
  }
  let first_value = output^.inner[0_u64];
  let last_value = output^.inner[1_u64];
  let first_kept = first_value == prefix_first;
  let last_kept = last_value == last;
  let kept = band(first_kept, last_kept);
  return kept;
}

fn judge_call(composed: Bool, source: &[u32], expected: &[u32], output: &Box<Slots<u32>>) -> outcome: u8 reads(source), reads(expected), writes(output) {
  doc "Runs normalize with Composed or Decomposed as composed says over source, appending to output, which holds the sentinel prefix, and compares the result: outcome_passed when output holds the prefix followed by exactly expected, outcome_prefix when it does not start with the prefix, outcome_mismatch when what follows differs, outcome_too_large when normalize returns TooLarge, and outcome_oversized when source is too long for normalize to accept.";
  let fits = source^.len <= normalize_ceiling;
  if fits {
  } else {
    return outcome_oversized;
  }
  let form = if composed {
    give NormalizationForm::Composed();
  } else {
    give NormalizationForm::Decomposed();
  }
  match normalize(form: form, text: source, output: output) {
    Ok(value: done) => {
    }
    Err(error: problem) => {
      return outcome_too_large;
    }
  }
  let kept = prefix_kept(output: output, composed: composed);
  if kept {
  } else {
    return outcome_prefix;
  }
  let total = output^.inner.len;
  let written = total -wrap prefix_length;
  let expected_count = expected^.len;
  let same_count = written == expected_count;
  if same_count {
  } else {
    return outcome_mismatch;
  }
  for (index in 0_u64..expected_count) {
    let at = index +wrap prefix_length;
    let inside = at < output^.inner.len;
    if inside {
    } else {
      return outcome_mismatch;
    }
    let actual_value = output^.inner[at];
    let expected_value = expected^[index];
    let same = actual_value == expected_value;
    if same {
    } else {
      return outcome_mismatch;
    }
  }
  return outcome_passed;
}

fn put_code_points(report: &Box<Slots<u8>>, points: &[u32], from: u64) -> result: unit reads(points), writes(report) {
  doc "Writes the code points of points from index from in hexadecimal, at least four digits each, separated by spaces: at most shown_code_point_limit of them and then ` ...` when more follow, or `(empty)` when there is none.";
  let count = points^.len;
  let some = from < count;
  if some {
  } else {
    let empty_label = &empty_word[0_u64..empty_word.len];
    put_text(buffer: report, text: empty_label);
    return unit;
  }
  let shown = 0_u64;
  for (index in from..count) {
    let enough = shown >= shown_code_point_limit;
    if enough {
      let elision = &elision_word[0_u64..elision_word.len];
      put_text(buffer: report, text: elision);
      return unit;
    }
    let separated = shown > 0_u64;
    if separated {
      put_byte(buffer: report, value: space);
    }
    let code_point = points^[index];
    let widened = cvt::<u32, u64>(code_point);
    let uppercase = True();
    put_hex(buffer: report, value: widened, width: 4_u64, uppercase: uppercase);
    set shown = shown +wrap 1_u64;
  }
  return unit;
}

fn put_call(report: &Box<Slots<u8>>, composed: Bool) -> result: unit writes(report) {
  doc "Writes `toNFC(` or `toNFD(`.";
  if composed {
    let label = &composed_call[0_u64..composed_call.len];
    put_text(buffer: report, text: label);
  } else {
    let label = &decomposed_call[0_u64..decomposed_call.len];
    put_text(buffer: report, text: label);
  }
  return unit;
}

fn put_outcome(report: &Box<Slots<u8>>, outcome: u8, composed: Bool, expected: &[u32], output: &Box<Slots<u32>>) -> result: unit reads(expected), reads(output), writes(report) {
  doc "Completes a failure report after the call's argument: `) is A, expected E` for a mismatch, with A what follows the prefix in output; `) did not keep the output's prior contents P; the output is O` when the prefix is gone; `) returned TooLarge`; or `) was not run: ...` for an input too long for normalize. Ends with a line feed.";
  let too_large = outcome == outcome_too_large;
  if too_large {
    let message = &too_large_text[0_u64..too_large_text.len];
    put_text(buffer: report, text: message);
    return unit;
  }
  let oversized = outcome == outcome_oversized;
  if oversized {
    let message = &oversized_text[0_u64..oversized_text.len];
    put_text(buffer: report, text: message);
    return unit;
  }
  let total = output^.inner.len;
  let actual = &output^.inner[0_u64..total];
  let prefix_lost = outcome == outcome_prefix;
  if prefix_lost {
    let prefix_label = &prefix_word[0_u64..prefix_word.len];
    put_text(buffer: report, text: prefix_label);
    let first = cvt::<u32, u64>(prefix_first);
    let last_value = prefix_last(composed: composed);
    let last = cvt::<u32, u64>(last_value);
    let uppercase = True();
    put_hex(buffer: report, value: first, width: 4_u64, uppercase: uppercase);
    put_byte(buffer: report, value: space);
    put_hex(buffer: report, value: last, width: 4_u64, uppercase: uppercase);
    let output_label = &output_word[0_u64..output_word.len];
    put_text(buffer: report, text: output_label);
    put_code_points(report: report, points: actual, from: 0_u64);
  } else {
    let is_label = &is_word[0_u64..is_word.len];
    put_text(buffer: report, text: is_label);
    put_code_points(report: report, points: actual, from: prefix_length);
    let expected_label = &expected_word[0_u64..expected_word.len];
    put_text(buffer: report, text: expected_label);
    put_code_points(report: report, points: expected, from: 0_u64);
  }
  put_byte(buffer: report, value: line_feed);
  return unit;
}

fn judge_case(points: &[u32], bounds: &[u64], line_number: u64, shown: Bool, report: &Box<Slots<u8>>) -> passed: Bool reads(points), reads(bounds), writes(report) {
  doc "Checks the ten invariants of one test line in the order of invariant_sources and invariant_expectations, the first composed_invariants with Composed and the rest with Decomposed, each call appending to a fresh output that holds only the sentinel prefix and has no room past it. Stops at the first invariant that fails and reports it when shown is True.";
  let bound_count = bounds^.len;
  let point_count = points^.len;
  for (index in 0_u64..invariant_count) {
    let source_number = invariant_sources[index];
    let expected_number = invariant_expectations[index];
    let source_column = cvt::<u8, u64>(source_number);
    let expected_column = cvt::<u8, u64>(expected_number);
    let composed = index < composed_invariants;
    let source_inside = source_column < bound_count;
    let expected_inside = expected_column < bound_count;
    let source_positive = source_column > 0_u64;
    let expected_positive = expected_column > 0_u64;
    let sources_ok = band(source_inside, source_positive);
    let expectations_ok = band(expected_inside, expected_positive);
    let columns_ok = band(sources_ok, expectations_ok);
    if columns_ok {
    } else {
      return False();
    }
    let source_before = source_column -wrap 1_u64;
    let expected_before = expected_column -wrap 1_u64;
    let source_low = bounds^[source_before];
    let source_high = bounds^[source_column];
    let expected_low = bounds^[expected_before];
    let expected_high = bounds^[expected_column];
    let source_ordered = source_low <= source_high;
    let source_within = source_high <= point_count;
    let expected_ordered = expected_low <= expected_high;
    let expected_within = expected_high <= point_count;
    let source_ok = band(source_ordered, source_within);
    let expected_ok = band(expected_ordered, expected_within);
    let ranges_ok = band(source_ok, expected_ok);
    if ranges_ok {
    } else {
      return False();
    }
    let source = &points^[source_low..source_high];
    let expected = &points^[expected_low..expected_high];
    let output = box_slots_new::<u32>(capacity: prefix_length);
    fill_prefix(output: &output, composed: composed);
    let outcome = judge_call(composed: composed, source: source, expected: expected, output: &output);
    let passing = outcome == outcome_passed;
    if passing {
    } else {
      if shown {
        let line_label = &line_word[0_u64..line_word.len];
        put_text(buffer: report, text: line_label);
        put_decimal(buffer: report, value: line_number);
        let colon_label = &colon_word[0_u64..colon_word.len];
        put_text(buffer: report, text: colon_label);
        put_call(report: report, composed: composed);
        let column_label = &column_word[0_u64..column_word.len];
        put_text(buffer: report, text: column_label);
        put_decimal(buffer: report, value: source_column);
        put_outcome(report: report, outcome: outcome, composed: composed, expected: expected, output: &output);
      }
      return False();
    }
  }
  return True();
}

fn judge_code_point(value: u64, output: &Box<Slots<u32>>, shown: Bool, report: &Box<Slots<u8>>) -> passed: Bool writes(output), writes(report) {
  doc "Checks that toNFC and toNFD of the one code point value give it back unchanged, each call appending to output after the sentinel prefix; reports the first failing form when shown is True.";
  let code_point = cvt.wrap::<u64, u32>(value);
  let single = array_filled::<u32, 1>(value: code_point);
  let source = &single[0_u64..1_u64];
  let composed = True();
  loop @forms {
    fill_prefix(output: output, composed: composed);
    let outcome = judge_call(composed: composed, source: source, expected: source, output: output);
    let passing = outcome == outcome_passed;
    if passing {
    } else {
      if shown {
        let label = &code_point_word[0_u64..code_point_word.len];
        put_text(buffer: report, text: label);
        let uppercase = True();
        put_hex(buffer: report, value: value, width: 4_u64, uppercase: uppercase);
        let colon_label = &colon_word[0_u64..colon_word.len];
        put_text(buffer: report, text: colon_label);
        put_call(report: report, composed: composed);
        let scalar_label = &scalar_word[0_u64..scalar_word.len];
        put_text(buffer: report, text: scalar_label);
        put_outcome(report: report, outcome: outcome, composed: composed, expected: source, output: output);
      }
      return False();
    }
    if composed {
      set composed = False();
    } else {
      break @forms;
    }
  }
  return True();
}

fn judge_code_points(seen: &Box<Array<u8>>, failed_before: u64, out: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> tally: Tally reads(seen), writes(out), writes(files), writes(report) {
  doc "Judges every Unicode scalar value that seen does not mark as one case, reusing one output for every call. Failures are reported while failed_before and the failures found here together stay below shown_failure_limit.";
  let output = box_slots_new::<u32>(capacity: reused_output_capacity);
  let cases = 0_u64;
  let passed = 0_u64;
  let failed = 0_u64;
  for (value in 0_u64..code_space) {
    let below_surrogates = value < surrogate_first;
    let above_surrogates = value > surrogate_last;
    let scalar = bor(below_surrogates, above_surrogates);
    let inside = value < seen^.inner.len;
    let marked = if inside {
      give seen^.inner[value] == listed;
    } else {
      give False();
    }
    let unmarked = bnot(marked);
    let judged = band(scalar, unmarked);
    if judged {
      set cases = cases +wrap 1_u64;
      let failed_total = failed_before +wrap failed;
      let shown = failed_total < shown_failure_limit;
      let passing = judge_code_point(value: value, output: &output, shown: shown, report: report);
      if passing {
        set passed = passed +wrap 1_u64;
      } else {
        set failed = failed +wrap 1_u64;
        let written = flush(factory: files, output: out, buffer: report);
      }
    }
  }
  return Tally(cases: cases, passed: passed, failed: failed);
}
