const of_word: Array<u8, 4> =[32_u8, 111_u8, 102_u8, 32_u8];

const no_lines_text: Array<u8, 38> =[110_u8, 111_u8, 114_u8, 109_u8, 97_u8, 108_u8, 105_u8, 122_u8, 97_u8, 116_u8, 105_u8, 111_u8, 110_u8, 95_u8, 111_u8, 114_u8, 97_u8, 99_u8, 108_u8, 101_u8, 58_u8, 32_u8, 110_u8, 111_u8, 32_u8, 116_u8, 101_u8, 115_u8, 116_u8, 32_u8, 108_u8, 105_u8, 110_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8];

