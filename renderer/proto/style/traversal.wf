alias Document = pkg::dom::Document;
alias Links = pkg::dom::Links;
alias NodeId = pkg::dom::NodeId;

const depth_ceiling: u64 = 4096_u64;

const element_ceiling: u64 = 4294967294_u64;

const node_ceiling: u64 = 4294967296_u64;

const unvisited: u32 = 4294967295_u32;

enum Step {
  Next(node: NodeId);
  Done();
  Broken();
}

struct Walk {
  elements: Box<Slots<NodeId>>;
  parents: Box<Slots<u32>>;
  depths: Box<Slots<u32>>;
  deepest: u64;
}

struct Ranges {
  child_start: Box<Array<u32>>;
  child_end: Box<Array<u32>>;
  children: Box<Array<u32>>;
}

struct Levels {
  level_start: Box<Array<u32>>;
  level_elements: Box<Array<NodeId>>;
  level_parents: Box<Array<u32>>;
  level_positions: Box<Array<u32>>;
}

fn narrow(value: u64) -> result: Result<u32, StyleError> pure {
  doc "Returns value as a u32, or TooLarge when it does not fit.";
  let fits = value <= 4294967295_u64;
  if fits {
    let narrowed = cvt::<u64, u32>(value);
    return Ok<u32, StyleError>(value: narrowed);
  }
  let failure = StyleError::TooLarge();
  return Err<u32, StyleError>(error: failure);
}

fn inconsistent<T: drop>() -> result: Result<T, StyleError> pure {
  doc "Returns the Inconsistent refusal.";
  let failure = StyleError::Inconsistent();
  return Err<T, StyleError>(error: failure);
}

fn build_traversal(document: &Document) -> result: Result<Traversal, StyleError> reads(document) {
  doc "Walks the elements, then derives the child ranges and the level arrays from their parents and depths.";
  let walk = propagate walk_elements(document: document);
  let Walk(elements: elements, parents: parents, depths: depths, deepest: deepest) = move walk;
  let count = elements.inner.len;
  let listed = parents.inner.len;
  let measured = depths.inner.len;
  let same_parents = listed == count;
  let same_depths = measured == count;
  let aligned = band(same_parents, same_depths);
  if aligned {
  } else {
    return inconsistent::<Traversal>();
  }
  let small = count <= element_ceiling;
  if small {
  } else {
    let failure = StyleError::TooLarge();
    return Err<Traversal, StyleError>(error: failure);
  }
  let document_slot = cvt::<u64, u32>(count);
  for (at in 0_u64..count) {
    let raw = parents.inner[at];
    if raw == unvisited {
      set parents.inner[at] = document_slot;
    }
  }
  let bounded = deepest <= depth_ceiling;
  if bounded {
  } else {
    let failure = StyleError::TooDeep();
    return Err<Traversal, StyleError>(error: failure);
  }
  let listed_elements = &elements.inner[0_u64..count];
  let listed_parents = &parents.inner[0_u64..count];
  let listed_depths = &depths.inner[0_u64..count];
  let ranges = propagate child_ranges(parents: listed_parents);
  let levels = propagate level_arrays(elements: listed_elements, parents: listed_parents, depths: listed_depths, deepest: deepest);
  let Ranges(child_start: child_start, child_end: child_end, children: children) = move ranges;
  let Levels(level_start: level_start, level_elements: level_elements, level_parents: level_parents, level_positions: level_positions) = move levels;
  let made = Traversal(elements: move elements, parents: move parents, child_start: move child_start, child_end: move child_end, children: move children, level_start: move level_start, level_elements: move level_elements, level_parents: move level_parents, level_positions: move level_positions);
  return Ok<Traversal, StyleError>(value: move made);
}

fn links_of(document: &Document, node: NodeId) -> links: Option<Links> reads(document) {
  doc "Returns the links of node, or None when it names no node.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  let known = index < count;
  if known {
    let links = document^.nodes.inner[index].links;
    return Some<Links>(value: links);
  }
  return None<Links>();
}

fn is_element(document: &Document, node: NodeId) -> element: Bool reads(document) {
  doc "Tells whether node names an Element node.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  let known = index < count;
  if known {
  } else {
    return False();
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(..) => {
      return True();
    }
    DocumentRoot(..) => {
    }
    DocumentType(..) => {
    }
    Text(..) => {
    }
    Comment(..) => {
    }
    Fragment() => {
    }
  }
  return False();
}

fn first_step(links: Links) -> step: Step pure {
  doc "Returns the step to the first child that links name, or Done when there is none.";
  match links.first_child {
    Some(value: child) => {
      return Step::Next(node: child);
    }
    None() => {
      return Step::Done();
    }
  }
}

fn step_after(document: &Document, node: NodeId) -> step: Step reads(document) {
  doc "Returns the node after the subtree of node in tree order: the next sibling of node or of its nearest ancestor that has one, Done when the climb reaches the document root, and Broken when a node has no parent before that. The climb takes at most one step per node.";
  let count = document^.nodes.inner.len;
  let at = node;
  for (up in 0_u64..count) {
    let links = match links_of(document: document, node: at) {
      Some(value: found) => {
        give found;
      }
      None() => {
        return Step::Broken();
      }
    }
    match links.next_sibling {
      Some(value: sibling) => {
        return Step::Next(node: sibling);
      }
      None() => {
      }
    }
    let parent = match links.parent {
      Some(value: holder) => {
        give holder;
      }
      None() => {
        return Step::Broken();
      }
    }
    if parent.index == 0_u32 {
      return Step::Done();
    }
    set at = parent;
  }
  return Step::Broken();
}

fn walk_elements(document: &Document) -> result: Result<Walk, StyleError> reads(document) {
  doc "Visits the document tree in tree order from the document root, through first children and next siblings, and lists each Element node with its parent element's preorder index, unvisited for a parent that is the document root, and its depth. The walk takes at most one step per node; Inconsistent when it would take more, visits an element twice or meets an element whose parent is neither the document root nor an element visited before it; TooDeep past depth_ceiling.";
  let nodes = document^.nodes.inner.len;
  let small = nodes <= node_ceiling;
  if small {
  } else {
    let failure = StyleError::TooLarge();
    return Err<Walk, StyleError>(error: failure);
  }
  let order = box_array_filled::<u32>(count: nodes, value: unvisited);
  let elements = box_slots_new::<NodeId>(capacity: 0_u64);
  let parents = box_slots_new::<u32>(capacity: 0_u64);
  let depths = box_slots_new::<u32>(capacity: 0_u64);
  let deepest = 0_u64;
  let root = NodeId(index: 0_u32);
  let root_links = match links_of(document: document, node: root) {
    Some(value: found) => {
      give found;
    }
    None() => {
      return inconsistent::<Walk>();
    }
  }
  let current = first_step(links: root_links);
  for (step in 0_u64..nodes) {
    let node = match current {
      Next(node: visited) => {
        give visited;
      }
      Done() => {
        let walked = Walk(elements: move elements, parents: move parents, depths: move depths, deepest: deepest);
        return Ok<Walk, StyleError>(value: move walked);
      }
      Broken() => {
        return inconsistent::<Walk>();
      }
    }
    let links = match links_of(document: document, node: node) {
      Some(value: found) => {
        give found;
      }
      None() => {
        return inconsistent::<Walk>();
      }
    }
    let element = is_element(document: document, node: node);
    if element {
      let index = cvt::<u32, u64>(node.index);
      let known = index < order.inner.len;
      if known {
      } else {
        return inconsistent::<Walk>();
      }
      let seen = order.inner[index] != unvisited;
      if seen {
        return inconsistent::<Walk>();
      }
      let position = elements.inner.len;
      let room = position < element_ceiling;
      if room {
      } else {
        let failure = StyleError::TooLarge();
        return Err<Walk, StyleError>(error: failure);
      }
      let holder = match links.parent {
        Some(value: found) => {
          give found;
        }
        None() => {
          return inconsistent::<Walk>();
        }
      }
      let parent_index = cvt::<u32, u64>(holder.index);
      let at_root = parent_index == 0_u64;
      let parent_position = if at_root {
        give unvisited;
      } else {
        let listed = parent_index < order.inner.len;
        if listed {
        } else {
          return inconsistent::<Walk>();
        }
        give order.inner[parent_index];
      }
      let depth = if at_root {
        give 0_u64;
      } else {
        let wide = cvt::<u32, u64>(parent_position);
        let measured = wide < depths.inner.len;
        if measured {
        } else {
          return inconsistent::<Walk>();
        }
        let above = cvt::<u32, u64>(depths.inner[wide]);
        let bounded = above < depth_ceiling;
        if bounded {
        } else {
          let failure = StyleError::TooDeep();
          return Err<Walk, StyleError>(error: failure);
        }
        give above + 1_u64;
      }
      let shallow = depth <= depth_ceiling;
      if shallow {
      } else {
        let failure = StyleError::TooDeep();
        return Err<Walk, StyleError>(error: failure);
      }
      let narrow_position = cvt::<u64, u32>(position);
      let narrow_depth = cvt::<u64, u32>(depth);
      set order.inner[index] = narrow_position;
      let placed = propagate push::<NodeId>(cell: &elements, value: node, ceiling: node_ceiling);
      let linked = propagate push::<u32>(cell: &parents, value: parent_position, ceiling: node_ceiling);
      let deep = propagate push::<u32>(cell: &depths, value: narrow_depth, ceiling: node_ceiling);
      set deepest = imax(deepest, depth);
    }
    match first_step(links: links) {
      Next(node: child) => {
        set current = Step::Next(node: child);
      }
      Done() => {
        set current = step_after(document: document, node: node);
      }
      Broken() => {
        return inconsistent::<Walk>();
      }
    }
  }
  match current {
    Next(node: visited) => {
      return inconsistent::<Walk>();
    }
    Done() => {
      let walked = Walk(elements: move elements, parents: move parents, depths: move depths, deepest: deepest);
      return Ok<Walk, StyleError>(value: move walked);
    }
    Broken() => {
      return inconsistent::<Walk>();
    }
  }
}

fn parent_slot(parents: &[u32], at: u64) -> slot: Result<u64, StyleError> reads(parents) contract {
  requires at < parents^.len;
} {
  doc "Returns the parent of the element at preorder index at as an index of the n + 1 child ranges: the parent's preorder index, or n for a root, whose recorded parent is n. Inconsistent when the recorded parent neither is n nor precedes the element.";
  let count = parents^.len;
  let raw = parents^[at];
  let wide = cvt::<u32, u64>(raw);
  if wide == count {
    return Ok<u64, StyleError>(value: count);
  }
  let before = wide < at;
  if before {
    return Ok<u64, StyleError>(value: wide);
  }
  return inconsistent::<u64>();
}

fn child_ranges(parents: &[u32]) -> result: Result<Ranges, StyleError> reads(parents) contract {
  requires parents^.len <= 4294967294_u64;
} {
  doc "Counts each parent's children, lays the runs out in parent order, the document's last, and fills each run in preorder.";
  let count = parents^.len;
  let slots = count + 1_u64;
  let counts = box_array_filled::<u64>(count: slots, value: 0_u64);
  for (at in 0_u64..count) {
    let parent = propagate parent_slot(parents: parents, at: at);
    let listed = parent < counts.inner.len;
    if listed {
    } else {
      return inconsistent::<Ranges>();
    }
    let seen = counts.inner[parent];
    let room = seen < count;
    if room {
    } else {
      return inconsistent::<Ranges>();
    }
    set counts.inner[parent] = seen + 1_u64;
  }
  let child_start = box_array_filled::<u32>(count: slots, value: 0_u32);
  let child_end = box_array_filled::<u32>(count: slots, value: 0_u32);
  let fill = box_array_filled::<u64>(count: slots, value: 0_u64);
  let running = 0_u64;
  for (slot in 0_u64..slots) {
    let first = propagate narrow(value: running);
    set child_start.inner[slot] = first;
    set fill.inner[slot] = running;
    let children_here = counts.inner[slot];
    let total = running +sat children_here;
    let within = total <= count;
    if within {
    } else {
      return inconsistent::<Ranges>();
    }
    set running = total;
  }
  let children = box_array_filled::<u32>(count: count, value: 0_u32);
  for (at in 0_u64..count) {
    let parent = propagate parent_slot(parents: parents, at: at);
    let listed = parent < fill.inner.len;
    if listed {
    } else {
      return inconsistent::<Ranges>();
    }
    let place = fill.inner[parent];
    let room = place < children.inner.len;
    if room {
    } else {
      return inconsistent::<Ranges>();
    }
    let child = propagate narrow(value: at);
    set children.inner[place] = child;
    set fill.inner[parent] = place + 1_u64;
  }
  for (slot in 0_u64..slots) {
    let last = propagate narrow(value: fill.inner[slot]);
    set child_end.inner[slot] = last;
  }
  let made = Ranges(child_start: move child_start, child_end: move child_end, children: move children);
  return Ok<Ranges, StyleError>(value: move made);
}

fn level_arrays(elements: &[NodeId], parents: &[u32], depths: &[u32], deepest: u64) -> result: Result<Levels, StyleError> reads(elements), reads(parents), reads(depths) contract {
  requires elements^.len <= 4294967294_u64;
  requires parents^.len == elements^.len;
  requires depths^.len == elements^.len;
  requires deepest <= 4096_u64;
} {
  doc "Lays the elements out level by level after the document's slot at position 0, each level in preorder, and records each element's level position and its parent's position within the previous level.";
  let count = elements^.len;
  let slots = count + 1_u64;
  let levels = deepest + 3_u64;
  let sizes = box_array_filled::<u64>(count: levels, value: 0_u64);
  set sizes.inner[0_u64] = 1_u64;
  for (at in 0_u64..count) {
    let depth = cvt::<u32, u64>(depths^[at]);
    let bounded = depth <= deepest;
    if bounded {
    } else {
      return inconsistent::<Levels>();
    }
    let level = depth + 1_u64;
    let seen = sizes.inner[level];
    let room = seen < count;
    if room {
    } else {
      return inconsistent::<Levels>();
    }
    set sizes.inner[level] = seen + 1_u64;
  }
  let level_start = box_array_filled::<u32>(count: levels, value: 0_u32);
  let fill = box_array_filled::<u64>(count: levels, value: 0_u64);
  let running = 0_u64;
  for (level in 0_u64..levels) {
    let first = propagate narrow(value: running);
    set level_start.inner[level] = first;
    set fill.inner[level] = running;
    let size = sizes.inner[level];
    let total = running +sat size;
    let within = total <= slots;
    if within {
    } else {
      return inconsistent::<Levels>();
    }
    set running = total;
  }
  let document_root = NodeId(index: 0_u32);
  let level_elements = box_array_filled::<NodeId>(count: slots, value: document_root);
  let level_parents = box_array_filled::<u32>(count: slots, value: 0_u32);
  let level_positions = box_array_filled::<u32>(count: count, value: 0_u32);
  for (at in 0_u64..count) {
    let depth = cvt::<u32, u64>(depths^[at]);
    let bounded = depth <= deepest;
    if bounded {
    } else {
      return inconsistent::<Levels>();
    }
    let level = depth + 1_u64;
    let position = fill.inner[level];
    let room = position < slots;
    if room {
    } else {
      return inconsistent::<Levels>();
    }
    set fill.inner[level] = position + 1_u64;
    set level_elements.inner[position] = elements^[at];
    let narrow_position = propagate narrow(value: position);
    set level_positions.inner[at] = narrow_position;
    let parent = cvt::<u32, u64>(parents^[at]);
    let relative = if parent == count {
      give 0_u64;
    } else {
      let before = parent < at;
      if before {
      } else {
        return inconsistent::<Levels>();
      }
      let parent_position = cvt::<u32, u64>(level_positions.inner[parent]);
      let previous_start = cvt::<u32, u64>(level_start.inner[depth]);
      let inside = previous_start <= parent_position;
      if inside {
      } else {
        return inconsistent::<Levels>();
      }
      give parent_position - previous_start;
    }
    let narrow_relative = propagate narrow(value: relative);
    set level_parents.inner[position] = narrow_relative;
  }
  let made = Levels(level_start: move level_start, level_elements: move level_elements, level_parents: move level_parents, level_positions: move level_positions);
  return Ok<Levels, StyleError>(value: move made);
}
