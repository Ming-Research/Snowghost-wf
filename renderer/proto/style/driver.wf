alias Args = std::text::Args;
alias AtomTable = pkg::base::atom::AtomTable;
alias DirectoryRead = std::fs::DirectoryRead;
alias Document = pkg::dom::Document;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias TreeError = pkg::html::tree_builder::TreeError;
alias args_count = std::text::args_count;
alias argument_bytes = pkg::oracle::support::argument_bytes;
alias atom_table_new = pkg::base::atom::atom_table_new;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias parse_document = pkg::html::tree_builder::parse_document;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_hex = pkg::oracle::support::put_hex;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;

enum Shape {
  LevelOrder();
  PreorderHalving();
  FlatMatch();
  InternPass();
  CheckAll();
}

const page_ceiling: u64 = 1073741824_u64;

const shape_a_word: Array<u8, 1> = "A";

const shape_b_word: Array<u8, 1> = "B";

const shape_c_word: Array<u8, 1> = "C";

const intern_word: Array<u8, 6> = "intern";

const check_word: Array<u8, 5> = "check";

const usage_text: Array<u8, 54> = "usage: proto_style A|B|C|intern|check REPS PAGE SHEET\n";

const unreadable_text: Array<u8, 26> = "proto_style: cannot read: ";

const sheet_large_text: Array<u8, 40> = "proto_style: sheet past 16777216 bytes: ";

const page_large_text: Array<u8, 40> = "proto_style: page past 1073741824 bytes\n";

const unparsed_text: Array<u8, 43> = "proto_style: the page cannot be parsed: dom";

const parse_large_text: Array<u8, 49> = "proto_style: the page cannot be parsed: too large";

const refused_text: Array<u8, 24> = "proto_style: style stage";

const too_large_text: Array<u8, 19> = " refused: too large";

const too_deep_text: Array<u8, 18> = " refused: too deep";

const inconsistent_text: Array<u8, 37> = " refused: inconsistent traversal data";

const differs_text: Array<u8, 27> = "proto_style: check failed: ";

const differs_from_text: Array<u8, 28> = " differs from C at preorder ";

const element_word: Array<u8, 8> = "element ";

const in_text: Array<u8, 4> = " in ";

const display_word: Array<u8, 7> = "display";

const float_word: Array<u8, 5> = "float";

const position_word: Array<u8, 8> = "position";

const overflow_word: Array<u8, 8> = "overflow";

const count_word: Array<u8, 17> = "the element count";

const group_word: Array<u8, 6> = "group ";

const slot_word: Array<u8, 6> = " slot ";

const intern_failed_text: Array<u8, 73> = "proto_style: check failed: the intern pass does not reproduce C's groups\n";

const elements_label: Array<u8, 10> = " elements ";

const rules_label: Array<u8, 7> = " rules ";

const reps_label: Array<u8, 6> = " reps ";

const checksum_label: Array<u8, 10> = " checksum ";

const distinct_label: Array<u8, 9> = " distinct";

const none_word: Array<u8, 4> = "none";

const agree_word: Array<u8, 6> = " agree";

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, drives one invocation and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = drive(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn same_bytes(text: &[u8], word: &[u8]) -> same: Bool reads(text), reads(word) {
  doc "Tells whether text equals word byte for byte.";
  let size = word^.len;
  if text^.len == size {
  } else {
    return False();
  }
  for (at in 0_u64..size) {
    if text^[at] == word^[at] {
    } else {
      return False();
    }
  }
  return True();
}

fn parse_shape(args: &Args) -> shape: Option<Shape> reads(args) {
  doc "Reads SHAPE, the first argument.";
  let text = match argument_bytes(args: args, position: 1_u64) {
    Some(value: found) => {
      give move found;
    }
    None() => {
      return None<Shape>();
    }
  }
  let length = text.inner.len;
  let word = &text.inner[0_u64..length];
  let is_a = same_bytes(text: word, word: &shape_a_word[0_u64..shape_a_word.len]);
  if is_a {
    let found = Shape::LevelOrder();
    return Some<Shape>(value: found);
  }
  let is_b = same_bytes(text: word, word: &shape_b_word[0_u64..shape_b_word.len]);
  if is_b {
    let found = Shape::PreorderHalving();
    return Some<Shape>(value: found);
  }
  let is_c = same_bytes(text: word, word: &shape_c_word[0_u64..shape_c_word.len]);
  if is_c {
    let found = Shape::FlatMatch();
    return Some<Shape>(value: found);
  }
  let is_intern = same_bytes(text: word, word: &intern_word[0_u64..intern_word.len]);
  if is_intern {
    let found = Shape::InternPass();
    return Some<Shape>(value: found);
  }
  let is_check = same_bytes(text: word, word: &check_word[0_u64..check_word.len]);
  if is_check {
    let found = Shape::CheckAll();
    return Some<Shape>(value: found);
  }
  return None<Shape>();
}

fn parse_reps(args: &Args) -> reps: Option<u64> reads(args) {
  doc "Reads REPS, the second argument, a decimal count.";
  let text = match argument_bytes(args: args, position: 2_u64) {
    Some(value: found) => {
      give move found;
    }
    None() => {
      return None<u64>();
    }
  }
  let length = text.inner.len;
  let parsed = parse_decimal(text: &text.inner[0_u64..length], start: 0_u64, end: length);
  return parsed;
}

fn report_line(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(err), writes(files), writes(report) waits {
  doc "Writes text on standard error.";
  put_text(buffer: report, text: text);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_unreadable(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, position: u64, problem: IoError) -> result: unit reads(args), writes(err), writes(files), writes(report) waits {
  doc "Reports that the file the argument at position names cannot be read.";
  put_text(buffer: report, text: &unreadable_text[0_u64..unreadable_text.len]);
  put_argument(buffer: report, args: args, position: position);
  put_host_error(buffer: report, error: problem);
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_style(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, failure: StyleError) -> result: unit writes(err), writes(files), writes(report) waits {
  doc "Reports a style refusal.";
  put_text(buffer: report, text: &refused_text[0_u64..refused_text.len]);
  match failure {
    TooLarge() => {
      put_text(buffer: report, text: &too_large_text[0_u64..too_large_text.len]);
    }
    TooDeep() => {
      put_text(buffer: report, text: &too_deep_text[0_u64..too_deep_text.len]);
    }
    Inconsistent() => {
      put_text(buffer: report, text: &inconsistent_text[0_u64..inconsistent_text.len]);
    }
  }
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn drive(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the invocation, parses the page, builds the traversal arrays and the rule store once, and runs the shape; returns the exit code.";
  let report = box_slots_new::<u8>(capacity: 256_u64);
  let count = args_count(args: args);
  let enough = count >= 4_u64;
  let shape = parse_shape(args: args);
  let reps = parse_reps(args: args);
  let chosen = match shape {
    Some(value: found) => {
      give found;
    }
    None() => {
      report_line(err: err, files: files, report: &report, text: &usage_text[0_u64..usage_text.len]);
      return 2_u8;
    }
  }
  let repetitions = match reps {
    Some(value: found) => {
      give found;
    }
    None() => {
      report_line(err: err, files: files, report: &report, text: &usage_text[0_u64..usage_text.len]);
      return 2_u8;
    }
  }
  if enough {
  } else {
    report_line(err: err, files: files, report: &report, text: &usage_text[0_u64..usage_text.len]);
    return 2_u8;
  }
  let page = match read_argument_file(factory: files, cwd: cwd, args: args, position: 3_u64) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: problem) => {
      report_unreadable(err: err, files: files, report: &report, args: args, position: 3_u64, problem: problem);
      return 2_u8;
    }
  }
  let length = page.inner.len;
  let small = length <= page_ceiling;
  if small {
  } else {
    report_line(err: err, files: files, report: &report, text: &page_large_text[0_u64..page_large_text.len]);
    return 2_u8;
  }
  let atoms = atom_table_new();
  let scripting = True();
  let parsed = parse_document(source: &page.inner[0_u64..length], scripting: scripting, atoms: &atoms);
  let document = match move parsed {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      match failure {
        TooLarge() => {
          report_line(err: err, files: files, report: &report, text: &parse_large_text[0_u64..parse_large_text.len]);
        }
        Dom(error: refusal) => {
          report_line(err: err, files: files, report: &report, text: &unparsed_text[0_u64..unparsed_text.len]);
        }
      }
      return 2_u8;
    }
  }
  let built = build_traversal(document: &document);
  let traversal = match move built {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, report: &report, failure: failure);
      return 2_u8;
    }
  }
  let store = rule_store_new();
  for (position in 4_u64..count) {
    let sheet = match read_argument_file(factory: files, cwd: cwd, args: args, position: position) {
      Ok(value: found) => {
        give move found;
      }
      Err(error: problem) => {
        report_unreadable(err: err, files: files, report: &report, args: args, position: position, problem: problem);
        return 2_u8;
      }
    }
    let size = sheet.inner.len;
    let fits = size <= 16777216_u64;
    if fits {
    } else {
      put_text(buffer: &report, text: &sheet_large_text[0_u64..sheet_large_text.len]);
      put_argument(buffer: &report, args: args, position: position);
      put_byte(buffer: &report, value: '\n'_u8);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
    match add_sheet(store: &store, source: &sheet.inner[0_u64..size], atoms: &atoms) {
      Ok(value: added) => {
      }
      Err(error: failure) => {
        report_style(err: err, files: files, report: &report, failure: failure);
        return 2_u8;
      }
    }
  }
  match add_style_elements(store: &store, document: &document, traversal: &traversal, atoms: &atoms) {
    Ok(value: added) => {
    }
    Err(error: failure) => {
      report_style(err: err, files: files, report: &report, failure: failure);
      return 2_u8;
    }
  }
  let code = run_shape(shape: chosen, reps: repetitions, store: &store, document: &document, atoms: &atoms, traversal: &traversal, out: out, err: err, files: files, report: &report);
  return code;
}

fn put_header(buffer: &Box<Slots<u8>>, name: &[u8], elements: u64, rules: u64, reps: u64) -> result: unit reads(name), writes(buffer) {
  doc "Appends the start of the result line: the shape, the element count, the rule count and REPS.";
  put_text(buffer: buffer, text: name);
  put_text(buffer: buffer, text: &elements_label[0_u64..elements_label.len]);
  put_decimal(buffer: buffer, value: elements);
  put_text(buffer: buffer, text: &rules_label[0_u64..rules_label.len]);
  put_decimal(buffer: buffer, value: rules);
  put_text(buffer: buffer, text: &reps_label[0_u64..reps_label.len]);
  put_decimal(buffer: buffer, value: reps);
  return unit;
}

fn put_checksum(buffer: &Box<Slots<u8>>, checksum: Option<u64>) -> result: unit writes(buffer) {
  doc "Appends the checksum in sixteen hexadecimal digits, or none when no result was computed.";
  put_text(buffer: buffer, text: &checksum_label[0_u64..checksum_label.len]);
  match checksum {
    Some(value: sum) => {
      let lower = False();
      put_hex(buffer: buffer, value: sum, width: 16_u64, uppercase: lower);
    }
    None() => {
      put_text(buffer: buffer, text: &none_word[0_u64..none_word.len]);
    }
  }
  return unit;
}

fn put_distinct(buffer: &Box<Slots<u8>>, interned: &Interned) -> result: unit reads(interned), writes(buffer) {
  doc "Appends each group's distinct value count.";
  put_text(buffer: buffer, text: &distinct_label[0_u64..distinct_label.len]);
  for (group in 0_u64..4_u64) {
    put_byte(buffer: buffer, value: ' '_u8);
    let distinct = table_of(interned: interned, group: group);
    put_decimal(buffer: buffer, value: distinct);
  }
  return unit;
}

fn run_shape(shape: Shape, reps: u64, store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> code: u8 reads(store), reads(document), reads(atoms), reads(traversal), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Runs the chosen shape REPS times, keeping the last result, and prints the result line; for check, runs and compares every shape once.";
  let elements = traversal^.elements.inner.len;
  let rules = rule_count(store: store);
  match shape {
    LevelOrder() => {
      let last = None<Box<Array<Computed>>>();
      for (rep in 0_u64..reps) {
        match style_shape_a(store: store, document: document, atoms: atoms, traversal: traversal) {
          Ok(value: made) => {
            set last = Some<Box<Array<Computed>>>(value: move made);
          }
          Err(error: failure) => {
            report_style(err: err, files: files, report: report, failure: failure);
            return 2_u8;
          }
        }
      }
      let checksum = match move last {
        Some(value: made) => {
          let slots = made.inner.len;
          let positions = traversal^.level_positions.inner.len;
          let sum = checksum_levels(results: &made.inner[0_u64..slots], positions: &traversal^.level_positions.inner[0_u64..positions]);
          give Some<u64>(value: sum);
        }
        None() => {
          give None<u64>();
        }
      }
      put_header(buffer: report, name: &shape_a_word[0_u64..shape_a_word.len], elements: elements, rules: rules, reps: reps);
      put_checksum(buffer: report, checksum: checksum);
    }
    PreorderHalving() => {
      let last = None<Box<Array<Computed>>>();
      for (rep in 0_u64..reps) {
        match style_shape_b(store: store, document: document, atoms: atoms, traversal: traversal) {
          Ok(value: made) => {
            set last = Some<Box<Array<Computed>>>(value: move made);
          }
          Err(error: failure) => {
            report_style(err: err, files: files, report: report, failure: failure);
            return 2_u8;
          }
        }
      }
      let checksum = checksum_last(last: move last);
      put_header(buffer: report, name: &shape_b_word[0_u64..shape_b_word.len], elements: elements, rules: rules, reps: reps);
      put_checksum(buffer: report, checksum: checksum);
    }
    FlatMatch() => {
      let last = None<Box<Array<Computed>>>();
      for (rep in 0_u64..reps) {
        match style_shape_c(store: store, document: document, atoms: atoms, traversal: traversal) {
          Ok(value: made) => {
            set last = Some<Box<Array<Computed>>>(value: move made);
          }
          Err(error: failure) => {
            report_style(err: err, files: files, report: report, failure: failure);
            return 2_u8;
          }
        }
      }
      let checksum = checksum_last(last: move last);
      put_header(buffer: report, name: &shape_c_word[0_u64..shape_c_word.len], elements: elements, rules: rules, reps: reps);
      put_checksum(buffer: report, checksum: checksum);
    }
    InternPass() => {
      let styled = style_shape_c(store: store, document: document, atoms: atoms, traversal: traversal);
      let styles = match move styled {
        Ok(value: made) => {
          give move made;
        }
        Err(error: failure) => {
          report_style(err: err, files: files, report: report, failure: failure);
          return 2_u8;
        }
      }
      let count = styles.inner.len;
      let values = &styles.inner[0_u64..count];
      let last = None<Interned>();
      for (rep in 0_u64..reps) {
        match intern_pass(styles: values) {
          Ok(value: made) => {
            set last = Some<Interned>(value: move made);
          }
          Err(error: failure) => {
            report_style(err: err, files: files, report: report, failure: failure);
            return 2_u8;
          }
        }
      }
      put_header(buffer: report, name: &intern_word[0_u64..intern_word.len], elements: elements, rules: rules, reps: reps);
      match move last {
        Some(value: made) => {
          let sum = checksum_interned(interned: &made);
          let found = Some<u64>(value: sum);
          put_checksum(buffer: report, checksum: found);
          put_distinct(buffer: report, interned: &made);
        }
        None() => {
          let missing = None<u64>();
          put_checksum(buffer: report, checksum: missing);
        }
      }
    }
    CheckAll() => {
      let code = check_all(store: store, document: document, atoms: atoms, traversal: traversal, err: err, files: files, report: report);
      if code == 0_u8 {
      } else {
        return code;
      }
    }
  }
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: out, buffer: report);
  return 0_u8;
}

fn checksum_last(last: Option<Box<Array<Computed>>>) -> checksum: Option<u64> pure {
  doc "Returns the checksum of a preorder result, or None when there is none.";
  match move last {
    Some(value: made) => {
      let slots = made.inner.len;
      let sum = checksum_preorder(results: &made.inner[0_u64..slots]);
      return Some<u64>(value: sum);
    }
    None() => {
      return None<u64>();
    }
  }
}

fn check_all(store: &RuleStore, document: &Document, atoms: &AtomTable, traversal: &Traversal, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> code: u8 reads(store), reads(document), reads(atoms), reads(traversal), writes(err), writes(files), writes(report) waits {
  doc "Runs A, B and C once, compares A and B with C element by element, checks the intern pass on C's result and appends the check line to report; returns 0 when everything agrees, 1 after reporting the first difference, 2 after a refusal.";
  let elements = traversal^.elements.inner.len;
  let rules = rule_count(store: store);
  let level_made = style_shape_a(store: store, document: document, atoms: atoms, traversal: traversal);
  let halving_made = style_shape_b(store: store, document: document, atoms: atoms, traversal: traversal);
  let flat_made = style_shape_c(store: store, document: document, atoms: atoms, traversal: traversal);
  let level = match move level_made {
    Ok(value: made) => {
      give move made;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, report: report, failure: failure);
      return 2_u8;
    }
  }
  let halving = match move halving_made {
    Ok(value: made) => {
      give move made;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, report: report, failure: failure);
      return 2_u8;
    }
  }
  let flat = match move flat_made {
    Ok(value: made) => {
      give move made;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, report: report, failure: failure);
      return 2_u8;
    }
  }
  let level_count = level.inner.len;
  let halving_count = halving.inner.len;
  let flat_count = flat.inner.len;
  let position_count = traversal^.level_positions.inner.len;
  let flat_values = &flat.inner[0_u64..flat_count];
  let level_values = &level.inner[0_u64..level_count];
  let halving_values = &halving.inner[0_u64..halving_count];
  let positions = &traversal^.level_positions.inner[0_u64..position_count];
  let (level_at, level_field) = first_difference_levels(results: level_values, positions: positions, reference: flat_values);
  if level_field == 0_u64 {
  } else {
    report_difference(err: err, files: files, report: report, shape: &shape_a_word[0_u64..shape_a_word.len], element: level_at, field: level_field);
    return 1_u8;
  }
  let (halving_at, halving_field) = first_difference(results: halving_values, reference: flat_values);
  if halving_field == 0_u64 {
  } else {
    report_difference(err: err, files: files, report: report, shape: &shape_b_word[0_u64..shape_b_word.len], element: halving_at, field: halving_field);
    return 1_u8;
  }
  let interned = match intern_pass(styles: flat_values) {
    Ok(value: made) => {
      give move made;
    }
    Err(error: failure) => {
      report_style(err: err, files: files, report: report, failure: failure);
      return 2_u8;
    }
  }
  let sound = verify_interned(styles: flat_values, interned: &interned);
  if sound {
  } else {
    report_line(err: err, files: files, report: report, text: &intern_failed_text[0_u64..intern_failed_text.len]);
    return 1_u8;
  }
  let sum = checksum_preorder(results: flat_values);
  let found = Some<u64>(value: sum);
  put_header(buffer: report, name: &check_word[0_u64..check_word.len], elements: elements, rules: rules, reps: 1_u64);
  put_text(buffer: report, text: &agree_word[0_u64..agree_word.len]);
  put_checksum(buffer: report, checksum: found);
  put_distinct(buffer: report, interned: &interned);
  return 0_u8;
}

fn report_difference(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, shape: &[u8], element: u64, field: u64) -> result: unit reads(shape), writes(err), writes(files), writes(report) waits {
  doc "Reports the first difference: the shape, the element's preorder index and the field, one of the four keywords or a group slot, as compare_values numbers them.";
  put_text(buffer: report, text: &differs_text[0_u64..differs_text.len]);
  put_text(buffer: report, text: shape);
  put_text(buffer: report, text: &differs_from_text[0_u64..differs_from_text.len]);
  put_text(buffer: report, text: &element_word[0_u64..element_word.len]);
  put_decimal(buffer: report, value: element);
  put_text(buffer: report, text: &in_text[0_u64..in_text.len]);
  if field == 1_u64 {
    put_text(buffer: report, text: &display_word[0_u64..display_word.len]);
  } else if field == 2_u64 {
    put_text(buffer: report, text: &float_word[0_u64..float_word.len]);
  } else if field == 3_u64 {
    put_text(buffer: report, text: &position_word[0_u64..position_word.len]);
  } else if field == 4_u64 {
    put_text(buffer: report, text: &overflow_word[0_u64..overflow_word.len]);
  } else if field == count_field {
    put_text(buffer: report, text: &count_word[0_u64..count_word.len]);
  } else {
    let value_index = field -wrap 5_u64;
    let group = value_index / 8_u64;
    let slot = value_index % 8_u64;
    put_text(buffer: report, text: &group_word[0_u64..group_word.len]);
    put_decimal(buffer: report, value: group);
    put_text(buffer: report, text: &slot_word[0_u64..slot_word.len]);
    put_decimal(buffer: report, value: slot);
  }
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}
