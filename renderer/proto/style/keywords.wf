const fnv_offset: u64 = 14695981039346656037_u64;

const fnv_prime: u64 = 1099511628211_u64;

const name_display: Array<u8, 7> = "display";

const name_float: Array<u8, 5> = "float";

const name_position: Array<u8, 8> = "position";

const name_overflow: Array<u8, 8> = "overflow";

const name_media: Array<u8, 5> = "media";

const name_supports: Array<u8, 8> = "supports";

const kw_inline: Array<u8, 6> = "inline";

const kw_block: Array<u8, 5> = "block";

const kw_none: Array<u8, 4> = "none";

const kw_contents: Array<u8, 8> = "contents";

const kw_list_item: Array<u8, 9> = "list-item";

const kw_inline_block: Array<u8, 12> = "inline-block";

const kw_flow_root: Array<u8, 9> = "flow-root";

const kw_flow: Array<u8, 4> = "flow";

const kw_run_in: Array<u8, 6> = "run-in";

const kw_table: Array<u8, 5> = "table";

const kw_inline_table: Array<u8, 12> = "inline-table";

const kw_table_row_group: Array<u8, 15> = "table-row-group";

const kw_table_header_group: Array<u8, 18> = "table-header-group";

const kw_table_footer_group: Array<u8, 18> = "table-footer-group";

const kw_table_row: Array<u8, 9> = "table-row";

const kw_table_cell: Array<u8, 10> = "table-cell";

const kw_table_column_group: Array<u8, 18> = "table-column-group";

const kw_table_column: Array<u8, 12> = "table-column";

const kw_table_caption: Array<u8, 13> = "table-caption";

const kw_flex: Array<u8, 4> = "flex";

const kw_inline_flex: Array<u8, 11> = "inline-flex";

const kw_grid: Array<u8, 4> = "grid";

const kw_inline_grid: Array<u8, 11> = "inline-grid";

const kw_ruby: Array<u8, 4> = "ruby";

const kw_ruby_base: Array<u8, 9> = "ruby-base";

const kw_ruby_text: Array<u8, 9> = "ruby-text";

const kw_ruby_base_container: Array<u8, 19> = "ruby-base-container";

const kw_ruby_text_container: Array<u8, 19> = "ruby-text-container";

const kw_math: Array<u8, 4> = "math";

const kw_left: Array<u8, 4> = "left";

const kw_right: Array<u8, 5> = "right";

const kw_inline_start: Array<u8, 12> = "inline-start";

const kw_inline_end: Array<u8, 10> = "inline-end";

const kw_static: Array<u8, 6> = "static";

const kw_relative: Array<u8, 8> = "relative";

const kw_absolute: Array<u8, 8> = "absolute";

const kw_fixed: Array<u8, 5> = "fixed";

const kw_sticky: Array<u8, 6> = "sticky";

const kw_visible: Array<u8, 7> = "visible";

const kw_hidden: Array<u8, 6> = "hidden";

const kw_clip: Array<u8, 4> = "clip";

const kw_scroll: Array<u8, 6> = "scroll";

const kw_auto: Array<u8, 4> = "auto";

enum Property {
  Display();
  Floating();
  Positioning();
  Overflowing();
  Other();
}

fn ascii_lower(byte: u8) -> lower: u8 pure {
  doc "Returns byte with an ASCII capital letter turned into its small letter.";
  let above = byte >= 'A'_u8;
  let below = byte <= 'Z'_u8;
  let capital = band(above, below);
  if capital {
    let shifted = byte + 32_u8;
    return shifted;
  }
  return byte;
}

fn same_word(text: &[u8], word: &[u8]) -> same: Bool reads(text), reads(word) {
  doc "Tells whether text equals word ASCII case-insensitively, word being written in small letters.";
  let size = word^.len;
  if text^.len == size {
  } else {
    return False();
  }
  for (at in 0_u64..size) {
    let lowered = ascii_lower(byte: text^[at]);
    if lowered == word^[at] {
    } else {
      return False();
    }
  }
  return True();
}

fn fnv_byte(hash: u64, byte: u8) -> next: u64 pure {
  doc "Feeds one byte to a 64-bit FNV-1a hash.";
  let wide = cvt::<u8, u64>(byte);
  let mixed = ixor(hash, wide);
  let scrambled = mixed *wrap fnv_prime;
  return scrambled;
}

fn fnv_bytes(hash: u64, bytes: &[u8]) -> next: u64 reads(bytes) {
  doc "Feeds every byte of bytes to a 64-bit FNV-1a hash, in order.";
  let current = hash;
  let count = bytes^.len;
  for (at in 0_u64..count) {
    set current = fnv_byte(hash: current, byte: bytes^[at]);
  }
  return current;
}

fn fnv_lower_bytes(hash: u64, bytes: &[u8]) -> next: u64 reads(bytes) {
  doc "Feeds every byte of bytes, ASCII capital letters as small ones, to a 64-bit FNV-1a hash.";
  let current = hash;
  let count = bytes^.len;
  for (at in 0_u64..count) {
    let lowered = ascii_lower(byte: bytes^[at]);
    set current = fnv_byte(hash: current, byte: lowered);
  }
  return current;
}

fn fnv_u32(hash: u64, value: u32) -> next: u64 pure {
  doc "Feeds the four bytes of value, least significant first, to a 64-bit FNV-1a hash.";
  let current = hash;
  let rest = value;
  for (at in 0_u64..4_u64) {
    let low = iand(rest, 255_u32);
    let byte = cvt::<u32, u8>(low);
    set current = fnv_byte(hash: current, byte: byte);
    set rest = ishr(rest, 8_u32);
  }
  return current;
}

fn property_of(name: &[u8]) -> property: Property reads(name) {
  doc "Classifies a declaration's name: one of the four keyword properties, or another property.";
  let display = same_word(text: name, word: &name_display[0_u64..name_display.len]);
  if display {
    return Property::Display();
  }
  let floating = same_word(text: name, word: &name_float[0_u64..name_float.len]);
  if floating {
    return Property::Floating();
  }
  let positioning = same_word(text: name, word: &name_position[0_u64..name_position.len]);
  if positioning {
    return Property::Positioning();
  }
  let overflowing = same_word(text: name, word: &name_overflow[0_u64..name_overflow.len]);
  if overflowing {
    return Property::Overflowing();
  }
  return Property::Other();
}

fn is_conditional_group(name: &[u8]) -> conditional: Bool reads(name) {
  doc "Tells whether an at-rule name is media or supports, ASCII case-insensitively.";
  let media = same_word(text: name, word: &name_media[0_u64..name_media.len]);
  if media {
    return True();
  }
  let supports = same_word(text: name, word: &name_supports[0_u64..name_supports.len]);
  return supports;
}

fn display_keyword(text: &[u8]) -> keyword: Option<DisplayKeyword> reads(text) {
  doc "Returns the display keyword text names ASCII case-insensitively, or None when it names none of DisplayKeyword's.";
  let is_inline = same_word(text: text, word: &kw_inline[0_u64..kw_inline.len]);
  if is_inline {
    let found = DisplayKeyword::Inline();
    return Some<DisplayKeyword>(value: found);
  }
  let is_block = same_word(text: text, word: &kw_block[0_u64..kw_block.len]);
  if is_block {
    let found = DisplayKeyword::Block();
    return Some<DisplayKeyword>(value: found);
  }
  let is_none = same_word(text: text, word: &kw_none[0_u64..kw_none.len]);
  if is_none {
    let found = DisplayKeyword::None();
    return Some<DisplayKeyword>(value: found);
  }
  let is_contents = same_word(text: text, word: &kw_contents[0_u64..kw_contents.len]);
  if is_contents {
    let found = DisplayKeyword::Contents();
    return Some<DisplayKeyword>(value: found);
  }
  let is_list_item = same_word(text: text, word: &kw_list_item[0_u64..kw_list_item.len]);
  if is_list_item {
    let found = DisplayKeyword::ListItem();
    return Some<DisplayKeyword>(value: found);
  }
  let is_inline_block = same_word(text: text, word: &kw_inline_block[0_u64..kw_inline_block.len]);
  if is_inline_block {
    let found = DisplayKeyword::InlineBlock();
    return Some<DisplayKeyword>(value: found);
  }
  let is_flow_root = same_word(text: text, word: &kw_flow_root[0_u64..kw_flow_root.len]);
  if is_flow_root {
    let found = DisplayKeyword::FlowRoot();
    return Some<DisplayKeyword>(value: found);
  }
  let is_flow = same_word(text: text, word: &kw_flow[0_u64..kw_flow.len]);
  if is_flow {
    let found = DisplayKeyword::Flow();
    return Some<DisplayKeyword>(value: found);
  }
  let is_run_in = same_word(text: text, word: &kw_run_in[0_u64..kw_run_in.len]);
  if is_run_in {
    let found = DisplayKeyword::RunIn();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table = same_word(text: text, word: &kw_table[0_u64..kw_table.len]);
  if is_table {
    let found = DisplayKeyword::Table();
    return Some<DisplayKeyword>(value: found);
  }
  let is_inline_table = same_word(text: text, word: &kw_inline_table[0_u64..kw_inline_table.len]);
  if is_inline_table {
    let found = DisplayKeyword::InlineTable();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_row_group = same_word(text: text, word: &kw_table_row_group[0_u64..kw_table_row_group.len]);
  if is_table_row_group {
    let found = DisplayKeyword::TableRowGroup();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_header_group = same_word(text: text, word: &kw_table_header_group[0_u64..kw_table_header_group.len]);
  if is_table_header_group {
    let found = DisplayKeyword::TableHeaderGroup();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_footer_group = same_word(text: text, word: &kw_table_footer_group[0_u64..kw_table_footer_group.len]);
  if is_table_footer_group {
    let found = DisplayKeyword::TableFooterGroup();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_row = same_word(text: text, word: &kw_table_row[0_u64..kw_table_row.len]);
  if is_table_row {
    let found = DisplayKeyword::TableRow();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_cell = same_word(text: text, word: &kw_table_cell[0_u64..kw_table_cell.len]);
  if is_table_cell {
    let found = DisplayKeyword::TableCell();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_column_group = same_word(text: text, word: &kw_table_column_group[0_u64..kw_table_column_group.len]);
  if is_table_column_group {
    let found = DisplayKeyword::TableColumnGroup();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_column = same_word(text: text, word: &kw_table_column[0_u64..kw_table_column.len]);
  if is_table_column {
    let found = DisplayKeyword::TableColumn();
    return Some<DisplayKeyword>(value: found);
  }
  let is_table_caption = same_word(text: text, word: &kw_table_caption[0_u64..kw_table_caption.len]);
  if is_table_caption {
    let found = DisplayKeyword::TableCaption();
    return Some<DisplayKeyword>(value: found);
  }
  let is_flex = same_word(text: text, word: &kw_flex[0_u64..kw_flex.len]);
  if is_flex {
    let found = DisplayKeyword::Flex();
    return Some<DisplayKeyword>(value: found);
  }
  let is_inline_flex = same_word(text: text, word: &kw_inline_flex[0_u64..kw_inline_flex.len]);
  if is_inline_flex {
    let found = DisplayKeyword::InlineFlex();
    return Some<DisplayKeyword>(value: found);
  }
  let is_grid = same_word(text: text, word: &kw_grid[0_u64..kw_grid.len]);
  if is_grid {
    let found = DisplayKeyword::Grid();
    return Some<DisplayKeyword>(value: found);
  }
  let is_inline_grid = same_word(text: text, word: &kw_inline_grid[0_u64..kw_inline_grid.len]);
  if is_inline_grid {
    let found = DisplayKeyword::InlineGrid();
    return Some<DisplayKeyword>(value: found);
  }
  let is_ruby = same_word(text: text, word: &kw_ruby[0_u64..kw_ruby.len]);
  if is_ruby {
    let found = DisplayKeyword::Ruby();
    return Some<DisplayKeyword>(value: found);
  }
  let is_ruby_base = same_word(text: text, word: &kw_ruby_base[0_u64..kw_ruby_base.len]);
  if is_ruby_base {
    let found = DisplayKeyword::RubyBase();
    return Some<DisplayKeyword>(value: found);
  }
  let is_ruby_text = same_word(text: text, word: &kw_ruby_text[0_u64..kw_ruby_text.len]);
  if is_ruby_text {
    let found = DisplayKeyword::RubyText();
    return Some<DisplayKeyword>(value: found);
  }
  let is_ruby_base_container = same_word(text: text, word: &kw_ruby_base_container[0_u64..kw_ruby_base_container.len]);
  if is_ruby_base_container {
    let found = DisplayKeyword::RubyBaseContainer();
    return Some<DisplayKeyword>(value: found);
  }
  let is_ruby_text_container = same_word(text: text, word: &kw_ruby_text_container[0_u64..kw_ruby_text_container.len]);
  if is_ruby_text_container {
    let found = DisplayKeyword::RubyTextContainer();
    return Some<DisplayKeyword>(value: found);
  }
  let is_math = same_word(text: text, word: &kw_math[0_u64..kw_math.len]);
  if is_math {
    let found = DisplayKeyword::Math();
    return Some<DisplayKeyword>(value: found);
  }
  return None<DisplayKeyword>();
}

