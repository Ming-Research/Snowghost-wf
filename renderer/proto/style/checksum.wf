const count_field: u64 = 37_u64;

const missing_value: u64 = 18446744073709551615_u64;

fn display_ordinal(keyword: DisplayKeyword) -> ordinal: u64 pure {
  doc "Returns the position of keyword in DisplayKeyword's declaration.";
  match keyword {
    Inline() => {
      return 0_u64;
    }
    Block() => {
      return 1_u64;
    }
    None() => {
      return 2_u64;
    }
    Contents() => {
      return 3_u64;
    }
    ListItem() => {
      return 4_u64;
    }
    InlineBlock() => {
      return 5_u64;
    }
    FlowRoot() => {
      return 6_u64;
    }
    Flow() => {
      return 7_u64;
    }
    RunIn() => {
      return 8_u64;
    }
    Table() => {
      return 9_u64;
    }
    InlineTable() => {
      return 10_u64;
    }
    TableRowGroup() => {
      return 11_u64;
    }
    TableHeaderGroup() => {
      return 12_u64;
    }
    TableFooterGroup() => {
      return 13_u64;
    }
    TableRow() => {
      return 14_u64;
    }
    TableCell() => {
      return 15_u64;
    }
    TableColumnGroup() => {
      return 16_u64;
    }
    TableColumn() => {
      return 17_u64;
    }
    TableCaption() => {
      return 18_u64;
    }
    Flex() => {
      return 19_u64;
    }
    InlineFlex() => {
      return 20_u64;
    }
    Grid() => {
      return 21_u64;
    }
    InlineGrid() => {
      return 22_u64;
    }
    Ruby() => {
      return 23_u64;
    }
    RubyBase() => {
      return 24_u64;
    }
    RubyText() => {
      return 25_u64;
    }
    RubyBaseContainer() => {
      return 26_u64;
    }
    RubyTextContainer() => {
      return 27_u64;
    }
    Math() => {
      return 28_u64;
    }
  }
}

fn float_ordinal(keyword: FloatKeyword) -> ordinal: u64 pure {
  doc "Returns the position of keyword in FloatKeyword's declaration.";
  match keyword {
    None() => {
      return 0_u64;
    }
    Left() => {
      return 1_u64;
    }
    Right() => {
      return 2_u64;
    }
    InlineStart() => {
      return 3_u64;
    }
    InlineEnd() => {
      return 4_u64;
    }
  }
}

fn position_ordinal(keyword: PositionKeyword) -> ordinal: u64 pure {
  doc "Returns the position of keyword in PositionKeyword's declaration.";
  match keyword {
    Static() => {
      return 0_u64;
    }
    Relative() => {
      return 1_u64;
    }
    Absolute() => {
      return 2_u64;
    }
    Fixed() => {
      return 3_u64;
    }
    Sticky() => {
      return 4_u64;
    }
  }
}

fn overflow_ordinal(keyword: OverflowKeyword) -> ordinal: u64 pure {
  doc "Returns the position of keyword in OverflowKeyword's declaration.";
  match keyword {
    Visible() => {
      return 0_u64;
    }
    Hidden() => {
      return 1_u64;
    }
    Clip() => {
      return 2_u64;
    }
    Scroll() => {
      return 3_u64;
    }
    Auto() => {
      return 4_u64;
    }
  }
}

fn mix_word(hash: u64, value: u64) -> next: u64 pure {
  doc "Feeds one 64-bit value to a word-wise FNV-1a hash.";
  let mixed = ixor(hash, value);
  let scrambled = mixed *wrap fnv_prime;
  return scrambled;
}

fn mix_display(hash: u64, keyword: DisplayKeyword) -> next: u64 pure {
  doc "Feeds a display keyword's ordinal to the checksum.";
  let ordinal = display_ordinal(keyword: keyword);
  let mixed = mix_word(hash: hash, value: ordinal);
  return mixed;
}

fn mix_float(hash: u64, keyword: FloatKeyword) -> next: u64 pure {
  doc "Feeds a float keyword's ordinal to the checksum.";
  let ordinal = float_ordinal(keyword: keyword);
  let mixed = mix_word(hash: hash, value: ordinal);
  return mixed;
}

fn mix_position(hash: u64, keyword: PositionKeyword) -> next: u64 pure {
  doc "Feeds a position keyword's ordinal to the checksum.";
  let ordinal = position_ordinal(keyword: keyword);
  let mixed = mix_word(hash: hash, value: ordinal);
  return mixed;
}

fn mix_overflow(hash: u64, keyword: OverflowKeyword) -> next: u64 pure {
  doc "Feeds an overflow keyword's ordinal to the checksum.";
  let ordinal = overflow_ordinal(keyword: keyword);
  let mixed = mix_word(hash: hash, value: ordinal);
  return mixed;
}

fn mix_computed(hash: u64, computed: Computed) -> next: u64 pure {
  doc "Feeds one element's values to the checksum: the four keywords' ordinals, then the 32 group values. Each step feeds the hash the step before it made, so --par finds no two independent statements to hand to two lanes on every element.";
  let first = mix_display(hash: hash, keyword: computed.boxing.display);
  let second = mix_float(hash: first, keyword: computed.boxing.float);
  let third = mix_position(hash: second, keyword: computed.boxing.position);
  let current = mix_overflow(hash: third, keyword: computed.boxing.overflow);
  for (slot in 0_u64..16_u64) {
    set current = mix_word(hash: current, value: computed.inherited[slot]);
  }
  for (slot in 0_u64..16_u64) {
    set current = mix_word(hash: current, value: computed.reset[slot]);
  }
  return current;
}

fn checksum_preorder(results: &[Computed]) -> checksum: u64 reads(results) {
  doc "Returns the checksum of a preorder result: its element count, then every element's values in preorder.";
  let count = results^.len;
  let current = mix_word(hash: fnv_offset, value: count);
  for (at in 0_u64..count) {
    set current = mix_computed(hash: current, computed: results^[at]);
  }
  return current;
}

fn checksum_levels(results: &[Computed], positions: &[u32]) -> checksum: u64 reads(results), reads(positions) {
  doc "Returns the checksum of a level-order result read back in preorder through positions, the traversal's level positions, so it equals checksum_preorder of the same values in preorder. A position outside results feeds a marker value instead, so the checksum then differs.";
  let count = positions^.len;
  let current = mix_word(hash: fnv_offset, value: count);
  for (at in 0_u64..count) {
    let position = cvt::<u32, u64>(positions^[at]);
    let inside = position < results^.len;
    if inside {
      set current = mix_computed(hash: current, computed: results^[position]);
    } else {
      set current = mix_word(hash: current, value: missing_value);
    }
  }
  return current;
}

fn checksum_interned(interned: &Interned) -> checksum: u64 reads(interned) {
  doc "Returns the checksum of an intern pass: its entries in order, then each group's distinct count.";
  let count = interned^.ids.inner.len;
  let current = mix_word(hash: fnv_offset, value: count);
  for (at in 0_u64..count) {
    let item = cvt::<u32, u64>(interned^.ids.inner[at]);
    set current = mix_word(hash: current, value: item);
  }
  for (group in 0_u64..4_u64) {
    let distinct = table_of(interned: interned, group: group);
    set current = mix_word(hash: current, value: distinct);
  }
  return current;
}

fn compare_values(first: Computed, second: Computed) -> field: u64 pure {
  doc "Returns 0 when first and second hold the same values, and otherwise the first field that differs: 1 to 4 for display, float, position and overflow, and 5 + 8 * g + s for slot s of group g.";
  let same_display = eeq(first.boxing.display, second.boxing.display);
  if same_display {
  } else {
    return 1_u64;
  }
  let same_float = eeq(first.boxing.float, second.boxing.float);
  if same_float {
  } else {
    return 2_u64;
  }
  let same_position = eeq(first.boxing.position, second.boxing.position);
  if same_position {
  } else {
    return 3_u64;
  }
  let same_overflow = eeq(first.boxing.overflow, second.boxing.overflow);
  if same_overflow {
  } else {
    return 4_u64;
  }
  for (slot in 0_u64..16_u64) {
    if first.inherited[slot] == second.inherited[slot] {
    } else {
      let field = slot + 5_u64;
      return field;
    }
  }
  for (slot in 0_u64..16_u64) {
    if first.reset[slot] == second.reset[slot] {
    } else {
      let field = slot + 21_u64;
      return field;
    }
  }
  return 0_u64;
}

fn first_difference(results: &[Computed], reference: &[Computed]) -> (element: u64, field: u64) reads(results), reads(reference) {
  doc "Returns the first preorder index at which results differs from reference and the field, as compare_values numbers it; field count_field when the element counts differ, and field 0 when they agree.";
  let count = reference^.len;
  if results^.len == count {
  } else {
    return 0_u64, count_field;
  }
  for (at in 0_u64..count) {
    let field = compare_values(first: results^[at], second: reference^[at]);
    if field == 0_u64 {
    } else {
      return at, field;
    }
  }
  return 0_u64, 0_u64;
}

fn first_difference_levels(results: &[Computed], positions: &[u32], reference: &[Computed]) -> (element: u64, field: u64) reads(results), reads(positions), reads(reference) {
  doc "As first_difference for a level-order result read back in preorder through positions.";
  let count = reference^.len;
  if positions^.len == count {
  } else {
    return 0_u64, count_field;
  }
  for (at in 0_u64..count) {
    let position = cvt::<u32, u64>(positions^[at]);
    let inside = position < results^.len;
    if inside {
    } else {
      return at, count_field;
    }
    let field = compare_values(first: results^[position], second: reference^[at]);
    if field == 0_u64 {
    } else {
      return at, field;
    }
  }
  return 0_u64, 0_u64;
}
