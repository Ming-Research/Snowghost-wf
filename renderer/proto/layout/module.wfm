alias Document = pkg::dom::Document;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Styles = pkg::proto::style::Styles;
alias Traversal = pkg::proto::style::Traversal;

public enum LayoutError {
  TooLarge();
  Inconsistent();
}

enum Flow {
  Open(margin: u64);
  Close(margin: u64);
  Text(index: u64);
  Nested(index: u64);
}

struct Paragraph {
  text: Box<Slots<u32>>;
}

struct Context {
  width: u64;
  floated: Bool;
  flow: Box<Slots<Flow>>;
  paragraphs: Box<Slots<Paragraph>>;
  lines: Box<Array<u64>>;
  children: Box<Slots<Context>>;
  height: u64;
}

struct Share {
  scalars: u64;
  paragraphs: u64;
  children: u64;
  floated: Bool;
}

struct Open {
  text: Box<Slots<u32>>;
  space: Bool;
}

public struct Layout {
  root: Context;
  contexts: u64;
  paragraphs: u64;
  scalars: u64;
}

public fn build_layout(document: &Document, traversal: &Traversal, styles: &Styles) -> result: Result<Layout, LayoutError> reads(document), reads(traversal), reads(styles) doc "Builds the owned tree of formatting contexts of document from each element's computed display, float, position and overflow in styles, both indexed by traversal's preorder, which build_traversal and compute_styles return for document. The root context is 800 px wide and holds the document's root elements. Inside a context, walked in tree order: an element with display none is skipped with its subtree, and one with display contents stands for its children; an element establishes a child context when its float is not none (a float, a third of the enclosing width), its position is absolute or fixed (the enclosing width), its display is table-cell or its parent's display is flex, inline-flex, grid or inline-grid (a quarter of the enclosing width), its display is inline-block, inline-table, inline-flex or inline-grid (half the enclosing width), or it is block-level with an overflow other than visible (the enclosing width); the context holds that element's children. A block-level child context, one that is not a float, absolutely positioned or inline-level, takes its place in the enclosing flow; an inline-level one adds U+FFFC to the open paragraph. Any other element whose display is inline, or one of the ruby displays, adds its children to the open paragraph; the remaining displays are block-level: they end the open paragraph and add an opening and a closing block edge, each with the element's margin (16 px for p, h1 to h6, ul, ol, dl, blockquote, figure and pre, 8 px for hr, 0 otherwise), around their children. A br element adds U+2028. Text adds its data, decoded from UTF-8 with U+FFFD for each ill-formed byte, with every run of tab, line feed, form feed, carriage return and space collapsed to one space and none at the start of a paragraph; a paragraph ends at a block edge, a block-level child context or the end of its context, without a trailing space, and is kept only when it holds a scalar value. A context is floated when a float is among its child contexts. Each paragraph's line count is kept beside the paragraphs, one per paragraph, so that L2's loop writes whole elements, the one element write Whitefoot's loop permission [PAR-2] admits. TooLarge past 2^30 scalar values in one paragraph or 2^32 items in one context; Inconsistent when the document's links, traversal or styles disagree.";

public fn lay_out(layout: &Layout, paragraphs_first: Bool) -> checksum: u64 writes(layout) doc "Lays out every context of layout and returns a 64-bit checksum of the result. A context lays out its child contexts first, the run of them split in halves as independent work, and then its own flow in order. A paragraph breaks into lines by greedy filling of its context's width, each scalar value 8 px wide and the combining diacritical marks (U+0300 to U+036F, U+1AB0 to U+1AFF, U+1DC0 to U+1DFF, U+20D0 to U+20FF and U+FE20 to U+FE2F) 0 px, at the opportunities pkg::text::line_break::find_line_breaks finds; a segment wider than a line takes a line of its own, and a mandatory opportunity ends its line. A line is 20 px high. The flow stacks paragraphs and in-flow child contexts, and adjacent block edges collapse to their largest margin; a context's height is the flow's total. With paragraphs_first False (L1) a context breaks each paragraph's lines when its flow reaches it; with paragraphs_first True (L2) a context that is not floated first breaks all its paragraphs in one counted loop, each iteration writing its own paragraph's line count, and then stacks its flow, while a floated context proceeds as in L1. The checksum folds every context's height and every paragraph's line count in tree order, so L1 and L2 return the same one.";

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The proto_layout entry, invoked as `proto_layout MODE REPS PAGE SHEET...` with the paths and the rule store of proto_style. It parses PAGE, builds the traversal arrays and the rule store, computes styles with pkg::proto::style::compute_styles and builds the context tree with build_layout, all once; MODE L1 or L2 then lays the tree out REPS times with lay_out, profile prints, after the usual counts, the scalar values of floated contexts and then the REPS largest contexts by own scalar values, each as its scalar values, paragraphs, child contexts and whether it is floated, and check lays it out once in each mode and compares the checksums, exiting 1 when they differ. On success it prints one line to standard output: the mode, the element, context, paragraph and scalar value counts, REPS, the root context's height and the checksum of the last layout in hexadecimal. Exits 2 when the invocation, a file, the page, a sheet or the context tree cannot be used.";
