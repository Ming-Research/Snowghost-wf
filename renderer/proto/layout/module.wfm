alias Document = pkg::dom::Document;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Styles = pkg::proto::style::Styles;
alias Traversal = pkg::proto::style::Traversal;

public enum LayoutError {
  TooLarge();
  Inconsistent();
}

enum Flow {
  Open(margin: u64);
  Close(margin: u64);
  Text(index: u64);
  Nested(index: u64);
  Float(index: u64);
}

public enum Plan {
  Sequential();
  FloatFree();
  Speculative();
}

struct Band {
  top: u64;
  bottom: u64;
  width: u64;
}

enum Piece {
  Bytes(start: u64, end: u64);
  Scalar(value: u32);
}

struct Paragraph {
  text: Box<Slots<u32>>;
  first: u64;
  count: u64;
  lines: u64;
}

struct Context {
  width: u64;
  floated: Bool;
  flow: Box<Slots<Flow>>;
  pieces: Box<Slots<Piece>>;
  paragraphs: Box<Slots<Paragraph>>;
  children: Box<Slots<Context>>;
  height: u64;
  rebroken: u64;
  rebroken_scalars: u64;
}

struct Share {
  scalars: u64;
  paragraphs: u64;
  children: u64;
  floated: Bool;
}

struct Open {
  first: u64;
  size: u64;
}

public struct Layout {
  root: Context;
  contexts: u64;
  paragraphs: u64;
  scalars: u64;
}

public fn build_layout(document: &Document, traversal: &Traversal, styles: &Styles) -> result: Result<Layout, LayoutError> reads(document), reads(traversal), reads(styles) doc "Builds the owned tree of formatting contexts of document from each element's computed display, float, position and overflow in styles, both indexed by traversal's preorder, which build_traversal and compute_styles return for document. The root context is 800 px wide and holds the document's root elements. Inside a context, walked in tree order: an element with display none is skipped with its subtree, and one with display contents stands for its children; an element establishes a child context when its float is not none (a float, a third of the enclosing width), its position is absolute or fixed (the enclosing width), its display is table-cell or its parent's display is flex, inline-flex, grid or inline-grid (a quarter of the enclosing width), its display is inline-block, inline-table, inline-flex or inline-grid (half the enclosing width), or it is block-level with an overflow other than visible (the enclosing width); the context holds that element's children. A block-level child context, one that is not a float, absolutely positioned or inline-level, takes its place in the enclosing flow; an inline-level one adds U+FFFC to the open paragraph. Any other element whose display is inline, or one of the ruby displays, adds its children to the open paragraph; the remaining displays are block-level: they end the open paragraph and add an opening and a closing block edge, each with the element's margin (16 px for p, h1 to h6, ul, ol, dl, blockquote, figure and pre, 8 px for hr, 0 otherwise), around their children. A br element adds U+2028. Text adds its data, decoded from UTF-8 with U+FFFD for each ill-formed byte, with every run of tab, line feed, form feed, carriage return and space collapsed to one space and none at the start of a paragraph; a paragraph ends at a block edge, a block-level child context or the end of its context, without a trailing space, and is kept only when it holds a scalar value. The walk records a paragraph's text as pieces, each a text node's bytes or one inserted scalar value, and after each context's walk one counted loop decodes every paragraph's pieces into the text reserved for it during the walk, each iteration writing its own paragraph's text. A float's child context also takes its place in the enclosing flow as an anchor, before the open paragraph, and the context is floated. Each paragraph keeps its own line count. TooLarge past 2^30 bytes and inserted scalar values in one paragraph or 2^32 items in one context; Inconsistent when the document's links, traversal or styles disagree.";

public fn lay_out(layout: &Layout, plan: Plan) -> checksum: u64 writes(layout) doc "Lays out every context of layout and returns a 64-bit checksum of the result. A context lays out its child contexts first, the run of them split in halves as independent work, and then its own flow in order. A paragraph breaks into lines by greedy filling of its lines' widths, each scalar value 8 px wide and the combining diacritical marks (U+0300 to U+036F, U+1AB0 to U+1AFF, U+1DC0 to U+1DFF, U+20D0 to U+20FF and U+FE20 to U+FE2F) 0 px, at the opportunities pkg::text::line_break::find_line_breaks finds; a segment wider than its line takes a line of its own, and a mandatory opportunity ends its line. A line is 20 px high. The flow stacks paragraphs and in-flow child contexts, and adjacent block edges collapse to their largest margin. A float's anchor places its context with its top at the flow's height plus the pending margin, as wide as that context and as high as its laid-out height; floats do not push each other. A line is the context's width minus the widths of the floats whose vertical range meets the line's, at least 0. A context's height is the larger of the flow's total and the lowest float bottom. With plan Sequential (L1) a context breaks each paragraph's lines when its flow reaches it; with FloatFree (L2) a context that is not floated first breaks all its paragraphs at its width in one counted loop, each iteration writing its own paragraph's line count, and then stacks its flow, while a floated context proceeds as in L1; with Speculative (L3) every context does so, and its flow breaks again the paragraphs whose top lies above the lowest float bottom placed before them, counting them and their scalar values in the context. The checksum folds every context's height and every paragraph's line count in tree order, so every plan returns the same one.";

public fn run(inputs: Inputs) -> status: ExitStatus pure waits doc "The proto_layout entry, invoked as `proto_layout MODE REPS PAGE SHEET...` with the paths and the rule store of proto_style. It parses PAGE, builds the traversal arrays and the rule store, computes styles with pkg::proto::style::compute_styles and builds the context tree with build_layout, all once; MODE L1, L2 or L3 then lays the tree out REPS times with lay_out in plan Sequential, FloatFree or Speculative, profile prints, after the usual counts, the scalar values of floated contexts and then the REPS largest contexts by own scalar values, each as its scalar values, paragraphs, child contexts and whether it is floated, build builds the context tree, parse parses the page, traverse builds the traversal arrays and rules builds a fresh rule store from the sheets, read again, and the page's style elements, each REPS more times, printing as the checksum a count summed over them (scalar values, nodes, elements or stores), and check lays it out once in each plan and compares the checksums, exiting 1 when they differ, and then appends to the result line the paragraphs and scalar values L3 broke again, the scalar values of the largest paragraph and the number of floats. On success it prints one line to standard output: the mode, the element, context, paragraph and scalar value counts, REPS, the root context's height and the checksum of the last layout in hexadecimal. Exits 2 when the invocation, a file, the page, a sheet or the context tree cannot be used.";
