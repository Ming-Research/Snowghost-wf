const share_ceiling: u64 = 1073741824_u64;

fn own_scalars(context: &Context) -> scalars: u64 reads(context) {
  doc "Returns the number of scalar values in context's own paragraphs.";
  let paragraphs = context^.paragraphs.inner.len;
  let scalars = 0_u64;
  for (at in 0_u64..paragraphs) {
    set scalars = scalars +wrap context^.paragraphs.inner[at].text.inner.len;
  }
  return scalars;
}

fn collect_shares(context: &Context, shares: &Box<Slots<Share>>) -> result: unit reads(context), writes(shares) {
  doc "Appends one share per context of context's tree, in tree order.";
  let scalars = own_scalars(context: context);
  let share = Share(scalars: scalars, paragraphs: context^.paragraphs.inner.len, children: context^.children.inner.len, floated: context^.floated);
  let kept = push_share(cell: shares, value: share);
  let children = context^.children.inner.len;
  for (at in 0_u64..children) {
    collect_shares(context: &context^.children.inner[at], shares: shares);
  }
  return unit;
}

fn push_share(cell: &Box<Slots<Share>>, value: Share) -> pushed: Bool writes(cell) {
  doc "Appends value within share_ceiling.";
  let pushed = push_item::<Share>(cell: cell, value: value, ceiling: share_ceiling);
  return pushed;
}

fn profile_layout(layout: &Layout) -> shares: Box<Slots<Share>> reads(layout) {
  doc "Returns every context's share of the layout work, in tree order.";
  let shares = box_slots_new::<Share>(capacity: 0_u64);
  collect_shares(context: &layout^.root, shares: &shares);
  return move shares;
}

fn fix_up_totals(context: &Context) -> totals: Array<u64, 4> reads(context) {
  doc "Returns, over context's tree, the paragraphs and scalar values the last layout broke again, the scalar values of the largest paragraph and the number of float anchors.";
  let totals = array_filled::<u64, 4>(value: 0_u64);
  set totals[0_u64] = context^.rebroken;
  set totals[1_u64] = context^.rebroken_scalars;
  let paragraphs = context^.paragraphs.inner.len;
  for (at in 0_u64..paragraphs) {
    let length = context^.paragraphs.inner[at].text.inner.len;
    set totals[2_u64] = larger(first: totals[2_u64], second: length);
  }
  let items = context^.flow.inner.len;
  for (at in 0_u64..items) {
    let item = context^.flow.inner[at];
    match item {
      Float(..) => {
        set totals[3_u64] = totals[3_u64] +wrap 1_u64;
      }
      Open(..) => {
      }
      Close(..) => {
      }
      Text(..) => {
      }
      Nested(..) => {
      }
    }
  }
  let children = context^.children.inner.len;
  for (at in 0_u64..children) {
    let below = fix_up_totals(context: &context^.children.inner[at]);
    set totals[0_u64] = totals[0_u64] +wrap below[0_u64];
    set totals[1_u64] = totals[1_u64] +wrap below[1_u64];
    set totals[2_u64] = larger(first: totals[2_u64], second: below[2_u64]);
    set totals[3_u64] = totals[3_u64] +wrap below[3_u64];
  }
  return totals;
}
