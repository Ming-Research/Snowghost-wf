alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Args = std::text::Args;
alias AtomTable = pkg::base::atom::AtomTable;
alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias StyleError = pkg::proto::style::StyleError;
alias add_sheet = pkg::proto::style::add_sheet;
alias add_style_elements = pkg::proto::style::add_style_elements;
alias args_count = std::text::args_count;
alias argument_bytes = pkg::oracle::support::argument_bytes;
alias atom_table_new = pkg::base::atom::atom_table_new;
alias build_traversal = pkg::proto::style::build_traversal;
alias close_directory = std::fs::close_directory;
alias compute_styles = pkg::proto::style::compute_styles;
alias exit_status = std::process::exit_status;
alias flush = pkg::oracle::support::flush;
alias parse_decimal = pkg::oracle::support::parse_decimal;
alias parse_document = pkg::html::tree_builder::parse_document;
alias put_argument = pkg::oracle::support::put_argument;
alias put_byte = pkg::oracle::support::put_byte;
alias put_decimal = pkg::oracle::support::put_decimal;
alias put_hex = pkg::oracle::support::put_hex;
alias put_host_error = pkg::oracle::support::put_host_error;
alias put_text = pkg::oracle::support::put_text;
alias read_argument_file = pkg::oracle::support::read_argument_file;
alias rule_store_new = pkg::proto::style::rule_store_new;

enum Mode {
  ContextsOnly();
  ParagraphsToo();
  Speculative();
  CheckAll();
  Profile();
}

const page_ceiling: u64 = 1073741824_u64;

const l1_word: Array<u8, 2> = "L1";

const l2_word: Array<u8, 2> = "L2";

const l3_word: Array<u8, 2> = "L3";

const check_word: Array<u8, 5> = "check";

const profile_word: Array<u8, 7> = "profile";

const floated_label: Array<u8, 17> = " floated_scalars ";

const top_label: Array<u8, 5> = " top ";

const usage_text: Array<u8, 59> = "usage: proto_layout L1|L2|L3|check|profile REPS PAGE SHEET\n";

const unreadable_text: Array<u8, 27> = "proto_layout: cannot read: ";

const sheet_large_text: Array<u8, 41> = "proto_layout: sheet past 16777216 bytes: ";

const page_large_text: Array<u8, 41> = "proto_layout: page past 1073741824 bytes\n";

const unparsed_text: Array<u8, 40> = "proto_layout: the page cannot be parsed\n";

const style_refused_text: Array<u8, 36> = "proto_layout: the style stage fails\n";

const layout_refused_text: Array<u8, 47> = "proto_layout: the context tree cannot be built\n";

const differs_text: Array<u8, 49> = "proto_layout: check failed: L1, L2 and L3 differ\n";

const elements_label: Array<u8, 10> = " elements ";

const contexts_label: Array<u8, 10> = " contexts ";

const paragraphs_label: Array<u8, 12> = " paragraphs ";

const scalars_label: Array<u8, 9> = " scalars ";

const reps_label: Array<u8, 6> = " reps ";

const height_label: Array<u8, 8> = " height ";

const checksum_label: Array<u8, 10> = " checksum ";

const agree_word: Array<u8, 6> = " agree";

const rebroken_label: Array<u8, 10> = " rebroken ";

const largest_label: Array<u8, 9> = " largest ";

const floats_label: Array<u8, 8> = " floats ";

fn run(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Destructures the inputs, drives one invocation and closes the working directory.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let code = drive(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return exit_status(code: code);
}

fn same_bytes(text: &[u8], word: &[u8]) -> same: Bool reads(text), reads(word) {
  doc "Tells whether text equals word byte for byte.";
  let size = word^.len;
  if text^.len == size {
  } else {
    return False();
  }
  for (at in 0_u64..size) {
    if text^[at] == word^[at] {
    } else {
      return False();
    }
  }
  return True();
}

fn parse_mode(args: &Args) -> mode: Option<Mode> reads(args) {
  doc "Reads MODE, the first argument.";
  let text = match argument_bytes(args: args, position: 1_u64) {
    Some(value: found) => {
      give move found;
    }
    None() => {
      return None<Mode>();
    }
  }
  let length = text.inner.len;
  let word = &text.inner[0_u64..length];
  let is_l1 = same_bytes(text: word, word: &l1_word[0_u64..l1_word.len]);
  if is_l1 {
    let found = Mode::ContextsOnly();
    return Some<Mode>(value: found);
  }
  let is_l2 = same_bytes(text: word, word: &l2_word[0_u64..l2_word.len]);
  if is_l2 {
    let found = Mode::ParagraphsToo();
    return Some<Mode>(value: found);
  }
  let is_l3 = same_bytes(text: word, word: &l3_word[0_u64..l3_word.len]);
  if is_l3 {
    let found = Mode::Speculative();
    return Some<Mode>(value: found);
  }
  let is_check = same_bytes(text: word, word: &check_word[0_u64..check_word.len]);
  if is_check {
    let found = Mode::CheckAll();
    return Some<Mode>(value: found);
  }
  let is_profile = same_bytes(text: word, word: &profile_word[0_u64..profile_word.len]);
  if is_profile {
    let found = Mode::Profile();
    return Some<Mode>(value: found);
  }
  return None<Mode>();
}

fn parse_reps(args: &Args) -> reps: Option<u64> reads(args) {
  doc "Reads REPS, the second argument, a decimal count.";
  let text = match argument_bytes(args: args, position: 2_u64) {
    Some(value: found) => {
      give move found;
    }
    None() => {
      return None<u64>();
    }
  }
  let length = text.inner.len;
  let parsed = parse_decimal(text: &text.inner[0_u64..length], start: 0_u64, end: length);
  return parsed;
}

fn report_line(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, text: &[u8]) -> result: unit reads(text), writes(err), writes(files), writes(report) waits {
  doc "Writes text on standard error.";
  put_text(buffer: report, text: text);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn report_unreadable(err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>, args: &Args, position: u64, problem: IoError) -> result: unit reads(args), writes(err), writes(files), writes(report) waits {
  doc "Reports that the file the argument at position names cannot be read.";
  put_text(buffer: report, text: &unreadable_text[0_u64..unreadable_text.len]);
  put_argument(buffer: report, args: args, position: position);
  put_host_error(buffer: report, error: problem);
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: err, buffer: report);
  return unit;
}

fn drive(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> code: u8 reads(args), reads(cwd), writes(out), writes(err), writes(files) waits {
  doc "Reads the invocation, parses the page, computes styles and builds the context tree once, and runs the mode; returns the exit code.";
  let report = box_slots_new::<u8>(capacity: 256_u64);
  let count = args_count(args: args);
  let enough = count >= 4_u64;
  let mode = parse_mode(args: args);
  let reps = parse_reps(args: args);
  let chosen = match mode {
    Some(value: found) => {
      give found;
    }
    None() => {
      report_line(err: err, files: files, report: &report, text: &usage_text[0_u64..usage_text.len]);
      return 2_u8;
    }
  }
  let repetitions = match reps {
    Some(value: found) => {
      give found;
    }
    None() => {
      report_line(err: err, files: files, report: &report, text: &usage_text[0_u64..usage_text.len]);
      return 2_u8;
    }
  }
  if enough {
  } else {
    report_line(err: err, files: files, report: &report, text: &usage_text[0_u64..usage_text.len]);
    return 2_u8;
  }
  let page = match read_argument_file(factory: files, cwd: cwd, args: args, position: 3_u64) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: problem) => {
      report_unreadable(err: err, files: files, report: &report, args: args, position: 3_u64, problem: problem);
      return 2_u8;
    }
  }
  let length = page.inner.len;
  let small = length <= page_ceiling;
  if small {
  } else {
    report_line(err: err, files: files, report: &report, text: &page_large_text[0_u64..page_large_text.len]);
    return 2_u8;
  }
  let atoms = atom_table_new();
  let scripting = True();
  let parsed = parse_document(source: &page.inner[0_u64..length], scripting: scripting, atoms: &atoms);
  let document = match move parsed {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_line(err: err, files: files, report: &report, text: &unparsed_text[0_u64..unparsed_text.len]);
      return 2_u8;
    }
  }
  let built = build_traversal(document: &document);
  let traversal = match move built {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_line(err: err, files: files, report: &report, text: &style_refused_text[0_u64..style_refused_text.len]);
      return 2_u8;
    }
  }
  let store = rule_store_new();
  for (position in 4_u64..count) {
    let sheet = match read_argument_file(factory: files, cwd: cwd, args: args, position: position) {
      Ok(value: found) => {
        give move found;
      }
      Err(error: problem) => {
        report_unreadable(err: err, files: files, report: &report, args: args, position: position, problem: problem);
        return 2_u8;
      }
    }
    let size = sheet.inner.len;
    let fits = size <= 16777216_u64;
    if fits {
    } else {
      put_text(buffer: &report, text: &sheet_large_text[0_u64..sheet_large_text.len]);
      put_argument(buffer: &report, args: args, position: position);
      put_byte(buffer: &report, value: '\n'_u8);
      let written = flush(factory: files, output: err, buffer: &report);
      return 2_u8;
    }
    match add_sheet(store: &store, source: &sheet.inner[0_u64..size], atoms: &atoms) {
      Ok(value: added) => {
      }
      Err(error: failure) => {
        report_line(err: err, files: files, report: &report, text: &style_refused_text[0_u64..style_refused_text.len]);
        return 2_u8;
      }
    }
  }
  match add_style_elements(store: &store, document: &document, traversal: &traversal, atoms: &atoms) {
    Ok(value: added) => {
    }
    Err(error: failure) => {
      report_line(err: err, files: files, report: &report, text: &style_refused_text[0_u64..style_refused_text.len]);
      return 2_u8;
    }
  }
  let styled = compute_styles(store: &store, document: &document, atoms: &atoms, traversal: &traversal);
  let styles = match move styled {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_line(err: err, files: files, report: &report, text: &style_refused_text[0_u64..style_refused_text.len]);
      return 2_u8;
    }
  }
  let laid = build_layout(document: &document, traversal: &traversal, styles: &styles);
  let layout = match move laid {
    Ok(value: found) => {
      give move found;
    }
    Err(error: failure) => {
      report_line(err: err, files: files, report: &report, text: &layout_refused_text[0_u64..layout_refused_text.len]);
      return 2_u8;
    }
  }
  let elements = traversal.elements.inner.len;
  let code = run_mode(mode: chosen, reps: repetitions, layout: &layout, elements: elements, out: out, err: err, files: files, report: &report);
  return code;
}

fn put_result(buffer: &Box<Slots<u8>>, name: &[u8], elements: u64, layout: &Layout, reps: u64, checksum: u64) -> result: unit reads(name), reads(layout), writes(buffer) {
  doc "Appends the result line: the mode, the element, context, paragraph and scalar value counts, REPS, the root context's height and the checksum.";
  put_text(buffer: buffer, text: name);
  put_text(buffer: buffer, text: &elements_label[0_u64..elements_label.len]);
  put_decimal(buffer: buffer, value: elements);
  put_text(buffer: buffer, text: &contexts_label[0_u64..contexts_label.len]);
  put_decimal(buffer: buffer, value: layout^.contexts);
  put_text(buffer: buffer, text: &paragraphs_label[0_u64..paragraphs_label.len]);
  put_decimal(buffer: buffer, value: layout^.paragraphs);
  put_text(buffer: buffer, text: &scalars_label[0_u64..scalars_label.len]);
  put_decimal(buffer: buffer, value: layout^.scalars);
  put_text(buffer: buffer, text: &reps_label[0_u64..reps_label.len]);
  put_decimal(buffer: buffer, value: reps);
  put_text(buffer: buffer, text: &height_label[0_u64..height_label.len]);
  put_decimal(buffer: buffer, value: layout^.root.height);
  put_text(buffer: buffer, text: &checksum_label[0_u64..checksum_label.len]);
  let lower = False();
  put_hex(buffer: buffer, value: checksum, width: 16_u64, uppercase: lower);
  return unit;
}

fn run_mode(mode: Mode, reps: u64, layout: &Layout, elements: u64, out: &OutputStream, err: &OutputStream, files: &HandleFactory, report: &Box<Slots<u8>>) -> code: u8 writes(layout), writes(out), writes(err), writes(files), writes(report) waits {
  doc "Lays the tree out REPS times in the chosen mode and prints the result line; check lays it out once in each mode, compares the checksums and prints L3's fix-up totals.";
  let checksum = fold_basis;
  match mode {
    ContextsOnly() => {
      let plan = Plan::Sequential();
      for (rep in 0_u64..reps) {
        set checksum = lay_out(layout: layout, plan: plan);
      }
      put_result(buffer: report, name: &l1_word[0_u64..l1_word.len], elements: elements, layout: layout, reps: reps, checksum: checksum);
    }
    ParagraphsToo() => {
      let plan = Plan::FloatFree();
      for (rep in 0_u64..reps) {
        set checksum = lay_out(layout: layout, plan: plan);
      }
      put_result(buffer: report, name: &l2_word[0_u64..l2_word.len], elements: elements, layout: layout, reps: reps, checksum: checksum);
    }
    Speculative() => {
      let plan = Plan::Speculative();
      for (rep in 0_u64..reps) {
        set checksum = lay_out(layout: layout, plan: plan);
      }
      put_result(buffer: report, name: &l3_word[0_u64..l3_word.len], elements: elements, layout: layout, reps: reps, checksum: checksum);
    }
    CheckAll() => {
      let sequential = Plan::Sequential();
      let float_free = Plan::FloatFree();
      let speculative = Plan::Speculative();
      let one = lay_out(layout: layout, plan: sequential);
      let two = lay_out(layout: layout, plan: float_free);
      let three = lay_out(layout: layout, plan: speculative);
      let first_pair = one == two;
      let second_pair = one == three;
      let same = band(first_pair, second_pair);
      if same {
      } else {
        report_line(err: err, files: files, report: report, text: &differs_text[0_u64..differs_text.len]);
        return 1_u8;
      }
      put_result(buffer: report, name: &check_word[0_u64..check_word.len], elements: elements, layout: layout, reps: 1_u64, checksum: one);
      put_text(buffer: report, text: &agree_word[0_u64..agree_word.len]);
      let fixed = fix_up_totals(context: &layout^.root);
      put_text(buffer: report, text: &rebroken_label[0_u64..rebroken_label.len]);
      put_decimal(buffer: report, value: fixed[0_u64]);
      put_byte(buffer: report, value: '/'_u8);
      put_decimal(buffer: report, value: fixed[1_u64]);
      put_text(buffer: report, text: &largest_label[0_u64..largest_label.len]);
      put_decimal(buffer: report, value: fixed[2_u64]);
      put_text(buffer: report, text: &floats_label[0_u64..floats_label.len]);
      put_decimal(buffer: report, value: fixed[3_u64]);
    }
    Profile() => {
      let plan = Plan::Sequential();
      let laid = lay_out(layout: layout, plan: plan);
      put_result(buffer: report, name: &profile_word[0_u64..profile_word.len], elements: elements, layout: layout, reps: reps, checksum: laid);
      let shares = profile_layout(layout: layout);
      put_profile(buffer: report, shares: &shares, top: reps);
    }
  }
  put_byte(buffer: report, value: '\n'_u8);
  let written = flush(factory: files, output: out, buffer: report);
  return 0_u8;
}

fn put_share(buffer: &Box<Slots<u8>>, share: Share) -> result: unit writes(buffer) {
  doc "Appends one share as scalars/paragraphs/children/floated.";
  put_byte(buffer: buffer, value: ' '_u8);
  put_decimal(buffer: buffer, value: share.scalars);
  put_byte(buffer: buffer, value: '/'_u8);
  put_decimal(buffer: buffer, value: share.paragraphs);
  put_byte(buffer: buffer, value: '/'_u8);
  put_decimal(buffer: buffer, value: share.children);
  put_byte(buffer: buffer, value: '/'_u8);
  if share.floated {
    put_byte(buffer: buffer, value: 'f'_u8);
  } else {
    put_byte(buffer: buffer, value: '-'_u8);
  }
  return unit;
}

fn put_profile(buffer: &Box<Slots<u8>>, shares: &Box<Slots<Share>>, top: u64) -> result: unit reads(shares), writes(buffer) {
  doc "Appends the floated contexts' scalar values and the top largest shares, each chosen by a scan that skips the ones already printed.";
  let count = shares^.inner.len;
  let floated = 0_u64;
  for (at in 0_u64..count) {
    let share = shares^.inner[at];
    if share.floated {
      set floated = floated +wrap share.scalars;
    }
  }
  put_text(buffer: buffer, text: &floated_label[0_u64..floated_label.len]);
  put_decimal(buffer: buffer, value: floated);
  put_text(buffer: buffer, text: &top_label[0_u64..top_label.len]);
  let fits = count <= 1073741824_u64;
  if fits {
  } else {
    return unit;
  }
  let unprinted = False();
  let printed = box_array_filled::<Bool>(count: count, value: unprinted);
  for (round in 0_u64..top) {
    let best = count;
    let most = 0_u64;
    for (at in 0_u64..count) {
      let taken = printed.inner[at];
      let scalars = shares^.inner[at].scalars;
      let bigger = scalars >= most;
      let fresh = bnot(taken);
      let better = band(bigger, fresh);
      if better {
        set best = at;
        set most = scalars;
      }
    }
    let found = best < count;
    if found {
      let marked = True();
      set printed.inner[best] = marked;
      put_share(buffer: buffer, share: shares^.inner[best]);
    }
  }
  return unit;
}
