alias BreakOpportunity = pkg::text::line_break::BreakOpportunity;
alias find_line_breaks = pkg::text::line_break::find_line_breaks;

const line_height: u64 = 20_u64;

const advance: u64 = 8_u64;

const breakable_ceiling: u64 = 1073741824_u64;

const fold_prime: u64 = 1099511628211_u64;

const fold_basis: u64 = 14695981039346656037_u64;

fn within(value: u32, low: u32, high: u32) -> inside: Bool pure {
  doc "Tells whether value lies in low to high, both included.";
  let above = value >= low;
  let below = value <= high;
  let inside = band(above, below);
  return inside;
}

fn advance_of(value: u32) -> width: u64 pure {
  doc "Returns the fixed advance of value: 0 px for the combining diacritical mark blocks, 8 px otherwise.";
  let marks = within(value: value, low: 768_u32, high: 879_u32);
  let extended = within(value: value, low: 6832_u32, high: 6911_u32);
  let supplement = within(value: value, low: 7616_u32, high: 7679_u32);
  let symbols = within(value: value, low: 8400_u32, high: 8447_u32);
  let halves = within(value: value, low: 65056_u32, high: 65071_u32);
  let first = bor(marks, extended);
  let second = bor(supplement, symbols);
  let some = bor(first, second);
  let combining = bor(some, halves);
  if combining {
    return 0_u64;
  }
  return advance;
}

fn covered(bands: &[Band], top: u64) -> taken: u64 reads(bands) {
  doc "Returns the summed width of the bands whose vertical range meets the line from top to top plus line_height.";
  let count = bands^.len;
  let bottom = top +wrap line_height;
  let taken = 0_u64;
  for (at in 0_u64..count) {
    let starts = bands^[at].top < bottom;
    let ends = bands^[at].bottom > top;
    let meets = band(starts, ends);
    if meets {
      set taken = taken +wrap bands^[at].width;
    }
  }
  return taken;
}

fn line_width(width: u64, bands: &[Band], top: u64) -> room: u64 reads(bands) {
  doc "Returns the width of the line at top: width minus the bands it meets, at least 0.";
  if bands^.len == 0_u64 {
    return width;
  }
  let taken = covered(bands: bands, top: top);
  if taken >= width {
    return 0_u64;
  }
  return width - taken;
}

fn count_lines(text: &[u32], width: u64, top: u64, bands: &[Band]) -> lines: u64 reads(text), reads(bands) {
  doc "Returns the number of lines text fills from top by greedy filling at its break opportunities, each line as wide as line_width gives: a segment, the text up to and including an opportunity, goes on the current line when it fits or the line is empty, and on a new line otherwise; a mandatory opportunity before the end starts a new line. 0 for empty text.";
  let count = text^.len;
  if count == 0_u64 {
    return 0_u64;
  }
  let breakable = count <= breakable_ceiling;
  if breakable {
  } else {
    return 0_u64;
  }
  let prohibited = BreakOpportunity::Prohibited();
  let breaks = box_array_filled::<BreakOpportunity>(count: count, value: prohibited);
  find_line_breaks(text: text, opportunities: &breaks.inner[0_u64..count]);
  let lines = 1_u64;
  let line_top = top;
  let room = line_width(width: width, bands: bands, top: line_top);
  let used = 0_u64;
  let segment = 0_u64;
  let last = count - 1_u64;
  for (at in 0_u64..count) {
    let step = advance_of(value: text^[at]);
    set segment = segment +wrap step;
    let opportunity = breaks.inner[at];
    let ends = match opportunity {
      Prohibited() => {
        give False();
      }
      Allowed() => {
        give True();
      }
      Mandatory() => {
        give True();
      }
    }
    if ends {
      let filled = used +wrap segment;
      let started = used > 0_u64;
      let over = filled > room;
      let wraps = band(started, over);
      if wraps {
        set lines = lines +wrap 1_u64;
        set line_top = line_top +wrap line_height;
        set room = line_width(width: width, bands: bands, top: line_top);
        set used = segment;
      } else {
        set used = filled;
      }
      set segment = 0_u64;
      let mandatory = BreakOpportunity::Mandatory();
      let forced = eeq(opportunity, mandatory);
      let before_end = at < last;
      let breaks_here = band(forced, before_end);
      if breaks_here {
        set lines = lines +wrap 1_u64;
        set line_top = line_top +wrap line_height;
        set room = line_width(width: width, bands: bands, top: line_top);
        set used = 0_u64;
      }
    }
  }
  return lines;
}

fn paragraph_lines(paragraph: &Paragraph, width: u64, top: u64, bands: &[Band]) -> lines: u64 reads(paragraph), reads(bands) {
  doc "Returns the number of lines paragraph fills from top beside bands.";
  let length = paragraph^.text.inner.len;
  let lines = count_lines(text: &paragraph^.text.inner[0_u64..length], width: width, top: top, bands: bands);
  return lines;
}

fn break_all(paragraphs: &[Paragraph], width: u64) -> result: unit writes(paragraphs) {
  doc "L2's and L3's paragraph loop: iteration i breaks paragraph i into lines at the full width and writes only its own line count.";
  let none = box_slots_new::<Band>(capacity: 0_u64);
  let count = paragraphs^.len;
  for (i in 0_u64..count) {
    let counted = paragraph_lines(paragraph: &paragraphs^[i], width: width, top: 0_u64, bands: &none.inner[0_u64..0_u64]);
    set paragraphs^[i].lines = counted;
  }
  return unit;
}

fn larger(first: u64, second: u64) -> result: u64 pure {
  doc "Returns the larger of first and second.";
  if first < second {
    return second;
  }
  return first;
}

fn stack_flow(context: &Context, known: Bool) -> height: u64 writes(context) {
  doc "Stacks context's flow in order, placing each float at its anchor, and returns its height. With known False each paragraph is broken into lines where the flow reaches it; with known True the line counts written before are read, and a paragraph whose top lies above the lowest float bottom so far is broken again and counted in context's rebroken totals.";
  let items = context^.flow.inner.len;
  let paragraphs = context^.paragraphs.inner.len;
  let children = context^.children.inner.len;
  let width = context^.width;
  let bands = box_slots_new::<Band>(capacity: 0_u64);
  let reach = 0_u64;
  let rebroken = 0_u64;
  let rebroken_scalars = 0_u64;
  let height = 0_u64;
  let pending = 0_u64;
  for (at in 0_u64..items) {
    let item = context^.flow.inner[at];
    match item {
      Open(margin: top) => {
        set pending = larger(first: pending, second: top);
      }
      Close(margin: bottom) => {
        set pending = larger(first: pending, second: bottom);
      }
      Text(index: which) => {
        let listed = which < paragraphs;
        if listed {
          let top = height +wrap pending;
          let beside = top < reach;
          let placed_bands = bands.inner.len;
          let lines = if beside {
            let exact = paragraph_lines(paragraph: &context^.paragraphs.inner[which], width: width, top: top, bands: &bands.inner[0_u64..placed_bands]);
            set context^.paragraphs.inner[which].lines = exact;
            if known {
              set rebroken = rebroken +wrap 1_u64;
              set rebroken_scalars = rebroken_scalars +wrap context^.paragraphs.inner[which].text.inner.len;
            }
            give exact;
          } else if known {
            give context^.paragraphs.inner[which].lines;
          } else {
            let counted = paragraph_lines(paragraph: &context^.paragraphs.inner[which], width: width, top: top, bands: &bands.inner[0_u64..0_u64]);
            set context^.paragraphs.inner[which].lines = counted;
            give counted;
          }
          let tall = lines *wrap line_height;
          set height = top +wrap tall;
          set pending = 0_u64;
        }
      }
      Nested(index: which) => {
        let listed = which < children;
        if listed {
          let tall = context^.children.inner[which].height;
          let placed = height +wrap pending;
          set height = placed +wrap tall;
          set pending = 0_u64;
        }
      }
      Float(index: which) => {
        let listed = which < children;
        if listed {
          let top = height +wrap pending;
          let tall = context^.children.inner[which].height;
          let wide = context^.children.inner[which].width;
          let bottom = top +wrap tall;
          let strip = Band(top: top, bottom: bottom, width: wide);
          let kept = push_item::<Band>(cell: &bands, value: strip, ceiling: item_ceiling);
          if kept {
            set reach = larger(first: reach, second: bottom);
          }
        }
      }
    }
  }
  set context^.rebroken = rebroken;
  set context^.rebroken_scalars = rebroken_scalars;
  let total = height +wrap pending;
  let reached = larger(first: total, second: reach);
  return reached;
}

fn lay_run(siblings: &[Context], plan: Plan) -> result: unit writes(siblings) {
  doc "Lays out a run of sibling contexts: one context directly, a longer run as its two halves, which are independent.";
  let count = siblings^.len;
  if count == 0_u64 {
    return unit;
  }
  if count == 1_u64 {
    lay_context(context: &siblings^[0_u64], plan: plan);
    return unit;
  }
  let half = count / 2_u64;
  lay_run(siblings: &siblings^[0_u64..half], plan: plan);
  lay_run(siblings: &siblings^[half..count], plan: plan);
  return unit;
}

fn lay_context(context: &Context, plan: Plan) -> result: unit writes(context) {
  doc "Lays out context's child contexts, then its paragraphs in one loop at its full width when plan is Speculative, or FloatFree and no float is among its boxes, then its flow.";
  let kids = context^.children.inner.len;
  lay_run(siblings: &context^.children.inner[0_u64..kids], plan: plan);
  let ahead = match plan {
    Sequential() => {
      give False();
    }
    FloatFree() => {
      give bnot(context^.floated);
    }
    Speculative() => {
      give True();
    }
  }
  if ahead {
    let count = context^.paragraphs.inner.len;
    let width = context^.width;
    break_all(paragraphs: &context^.paragraphs.inner[0_u64..count], width: width);
  }
  let height = stack_flow(context: context, known: ahead);
  set context^.height = height;
  return unit;
}

fn fold(sum: u64, value: u64) -> result: u64 pure {
  doc "Folds value into sum, FNV-1a style over whole words.";
  let mixed = ixor(sum, value);
  let folded = mixed *wrap fold_prime;
  return folded;
}

fn fold_tree(sum: u64, context: &Context) -> result: u64 reads(context) {
  doc "Folds context's height, its paragraphs' line counts and then its child contexts' trees into sum.";
  let total = fold(sum: sum, value: context^.height);
  let paragraphs = context^.paragraphs.inner.len;
  for (at in 0_u64..paragraphs) {
    set total = fold(sum: total, value: context^.paragraphs.inner[at].lines);
  }
  let children = context^.children.inner.len;
  for (at in 0_u64..children) {
    set total = fold_tree(sum: total, context: &context^.children.inner[at]);
  }
  return total;
}

fn lay_out(layout: &Layout, plan: Plan) -> checksum: u64 writes(layout) {
  doc "Lays out the root context and folds the result.";
  lay_context(context: &layout^.root, plan: plan);
  let checksum = fold_tree(sum: fold_basis, context: &layout^.root);
  return checksum;
}
