alias GeneralCategory = pkg::text::properties::GeneralCategory;
alias Script = pkg::font::Script;
alias general_category = pkg::text::properties::general_category;

const kind_base: u8 = 0_u8;

const kind_mark: u8 = 1_u8;

const kind_ignorable: u8 = 2_u8;

const kind_control: u8 = 3_u8;

const script_common: u8 = 0_u8;

const script_latin: u8 = 1_u8;

const script_greek: u8 = 2_u8;

const script_cyrillic: u8 = 3_u8;

const script_other: u8 = 4_u8;

const script_inherited: u8 = 5_u8;

struct ScalarRange {
  doc "The scalar values first to last of one script's range.";
  first: u32;
  last: u32;
}

const latin_ranges: Array<ScalarRange, 33> =[ScalarRange(first: 65_u32, last: 90_u32), ScalarRange(first: 97_u32, last: 122_u32), ScalarRange(first: 170_u32, last: 170_u32), ScalarRange(first: 186_u32, last: 186_u32), ScalarRange(first: 192_u32, last: 214_u32), ScalarRange(first: 216_u32, last: 246_u32), ScalarRange(first: 248_u32, last: 696_u32), ScalarRange(first: 736_u32, last: 740_u32), ScalarRange(first: 7424_u32, last: 7461_u32), ScalarRange(first: 7468_u32, last: 7516_u32), ScalarRange(first: 7522_u32, last: 7525_u32), ScalarRange(first: 7531_u32, last: 7543_u32), ScalarRange(first: 7545_u32, last: 7614_u32), ScalarRange(first: 7680_u32, last: 7935_u32), ScalarRange(first: 8305_u32, last: 8305_u32), ScalarRange(first: 8319_u32, last: 8319_u32), ScalarRange(first: 8336_u32, last: 8348_u32), ScalarRange(first: 8490_u32, last: 8491_u32), ScalarRange(first: 8498_u32, last: 8498_u32), ScalarRange(first: 8526_u32, last: 8526_u32), ScalarRange(first: 8544_u32, last: 8584_u32), ScalarRange(first: 11360_u32, last: 11391_u32), ScalarRange(first: 42786_u32, last: 42887_u32), ScalarRange(first: 42891_u32, last: 43007_u32), ScalarRange(first: 43824_u32, last: 43866_u32), ScalarRange(first: 43868_u32, last: 43876_u32), ScalarRange(first: 43878_u32, last: 43881_u32), ScalarRange(first: 64256_u32, last: 64262_u32), ScalarRange(first: 65313_u32, last: 65338_u32), ScalarRange(first: 65345_u32, last: 65370_u32), ScalarRange(first: 67456_u32, last: 67514_u32), ScalarRange(first: 122624_u32, last: 122654_u32), ScalarRange(first: 122661_u32, last: 122666_u32)];

const greek_ranges: Array<ScalarRange, 18> =[ScalarRange(first: 880_u32, last: 883_u32), ScalarRange(first: 885_u32, last: 887_u32), ScalarRange(first: 890_u32, last: 893_u32), ScalarRange(first: 895_u32, last: 895_u32), ScalarRange(first: 900_u32, last: 900_u32), ScalarRange(first: 902_u32, last: 902_u32), ScalarRange(first: 904_u32, last: 993_u32), ScalarRange(first: 1008_u32, last: 1023_u32), ScalarRange(first: 7462_u32, last: 7466_u32), ScalarRange(first: 7517_u32, last: 7521_u32), ScalarRange(first: 7526_u32, last: 7530_u32), ScalarRange(first: 7615_u32, last: 7615_u32), ScalarRange(first: 7936_u32, last: 8190_u32), ScalarRange(first: 8486_u32, last: 8486_u32), ScalarRange(first: 43877_u32, last: 43877_u32), ScalarRange(first: 65856_u32, last: 65934_u32), ScalarRange(first: 65952_u32, last: 65952_u32), ScalarRange(first: 119296_u32, last: 119365_u32)];

const cyrillic_ranges: Array<ScalarRange, 9> =[ScalarRange(first: 1024_u32, last: 1156_u32), ScalarRange(first: 1159_u32, last: 1327_u32), ScalarRange(first: 7296_u32, last: 7306_u32), ScalarRange(first: 7467_u32, last: 7467_u32), ScalarRange(first: 7544_u32, last: 7544_u32), ScalarRange(first: 11744_u32, last: 11775_u32), ScalarRange(first: 42560_u32, last: 42655_u32), ScalarRange(first: 65070_u32, last: 65071_u32), ScalarRange(first: 122928_u32, last: 123023_u32)];

fn in_ranges(scalar: u32, ranges: &[ScalarRange]) -> result: Bool reads(ranges) {
  doc "Tells whether one of ranges holds scalar.";
  let count = ranges^.len;
  for (index in 0_u64..count) {
    let range = ranges^[index];
    let low = scalar >= range.first;
    let high = scalar <= range.last;
    let inside = band(low, high);
    if inside {
      return True();
    }
  }
  return False();
}

fn scalar_kind(scalar: u32) -> result: u8 pure {
  doc "Classifies scalar for itemizing: a control (General_Category Cc, U+2028, U+2029 and U+FFFC, which take no advance and are never shaped), a mark (Mn, Mc and Me, which follow their base's face), a default ignorable (Cf and the variation selectors, which the shaper hides, so they follow the face before them), or a base.";
  let line_separator = scalar == 8232_u32;
  let paragraph_separator = scalar == 8233_u32;
  let replacement = scalar == 65532_u32;
  let separator = bor(line_separator, paragraph_separator);
  let fixed = bor(separator, replacement);
  if fixed {
    return kind_control;
  }
  let selector_low = scalar >= 65024_u32;
  let selector_high = scalar <= 65039_u32;
  let selector = band(selector_low, selector_high);
  let supplement_low = scalar >= 917760_u32;
  let supplement_high = scalar <= 917999_u32;
  let supplement = band(supplement_low, supplement_high);
  let mongolian_low = scalar >= 6155_u32;
  let mongolian_high = scalar <= 6159_u32;
  let mongolian = band(mongolian_low, mongolian_high);
  let grapheme_joiner = scalar == 847_u32;
  let selectors = bor(selector, supplement);
  let others = bor(mongolian, grapheme_joiner);
  let hidden = bor(selectors, others);
  if hidden {
    return kind_ignorable;
  }
  let category = general_category(scalar: scalar);
  match category {
    Control() => {
      return kind_control;
    }
    Format() => {
      return kind_ignorable;
    }
    NonspacingMark() => {
      return kind_mark;
    }
    SpacingMark() => {
      return kind_mark;
    }
    EnclosingMark() => {
      return kind_mark;
    }
    UppercaseLetter() => {
      return kind_base;
    }
    LowercaseLetter() => {
      return kind_base;
    }
    TitlecaseLetter() => {
      return kind_base;
    }
    ModifierLetter() => {
      return kind_base;
    }
    OtherLetter() => {
      return kind_base;
    }
    DecimalNumber() => {
      return kind_base;
    }
    LetterNumber() => {
      return kind_base;
    }
    OtherNumber() => {
      return kind_base;
    }
    ConnectorPunctuation() => {
      return kind_base;
    }
    DashPunctuation() => {
      return kind_base;
    }
    OpenPunctuation() => {
      return kind_base;
    }
    ClosePunctuation() => {
      return kind_base;
    }
    InitialPunctuation() => {
      return kind_base;
    }
    FinalPunctuation() => {
      return kind_base;
    }
    OtherPunctuation() => {
      return kind_base;
    }
    MathSymbol() => {
      return kind_base;
    }
    CurrencySymbol() => {
      return kind_base;
    }
    ModifierSymbol() => {
      return kind_base;
    }
    OtherSymbol() => {
      return kind_base;
    }
    SpaceSeparator() => {
      return kind_base;
    }
    LineSeparator() => {
      return kind_control;
    }
    ParagraphSeparator() => {
      return kind_control;
    }
    Surrogate() => {
      return kind_base;
    }
    PrivateUse() => {
      return kind_base;
    }
    Unassigned() => {
      return kind_base;
    }
  }
}

fn letter_class(scalar: u32) -> result: u8 pure {
  doc "Returns 2 for a letter (General_Category L*, ideographs among them), 1 for a number (N*) and 0 for any other scalar, for word-break's letter tests.";
  let category = general_category(scalar: scalar);
  match category {
    UppercaseLetter() => {
      return 2_u8;
    }
    LowercaseLetter() => {
      return 2_u8;
    }
    TitlecaseLetter() => {
      return 2_u8;
    }
    ModifierLetter() => {
      return 2_u8;
    }
    OtherLetter() => {
      return 2_u8;
    }
    DecimalNumber() => {
      return 1_u8;
    }
    LetterNumber() => {
      return 1_u8;
    }
    OtherNumber() => {
      return 1_u8;
    }
    NonspacingMark() => {
      return 0_u8;
    }
    SpacingMark() => {
      return 0_u8;
    }
    EnclosingMark() => {
      return 0_u8;
    }
    ConnectorPunctuation() => {
      return 0_u8;
    }
    DashPunctuation() => {
      return 0_u8;
    }
    OpenPunctuation() => {
      return 0_u8;
    }
    ClosePunctuation() => {
      return 0_u8;
    }
    InitialPunctuation() => {
      return 0_u8;
    }
    FinalPunctuation() => {
      return 0_u8;
    }
    OtherPunctuation() => {
      return 0_u8;
    }
    MathSymbol() => {
      return 0_u8;
    }
    CurrencySymbol() => {
      return 0_u8;
    }
    ModifierSymbol() => {
      return 0_u8;
    }
    OtherSymbol() => {
      return 0_u8;
    }
    SpaceSeparator() => {
      return 0_u8;
    }
    LineSeparator() => {
      return 0_u8;
    }
    ParagraphSeparator() => {
      return 0_u8;
    }
    Control() => {
      return 0_u8;
    }
    Format() => {
      return 0_u8;
    }
    Surrogate() => {
      return 0_u8;
    }
    PrivateUse() => {
      return 0_u8;
    }
    Unassigned() => {
      return 0_u8;
    }
  }
}

fn scalar_script(scalar: u32) -> result: u8 pure {
  doc "Returns the script that itemizing gives scalar: Latin, Greek or Cyrillic for the letters of those scripts' ranges in Unicode's Scripts.txt, inherited for marks and default ignorables, which take the script before them, another script for the remaining letters and spacing marks outside the letterlike-symbol and mathematical-alphanumeric blocks, and Common for everything else (digits, punctuation, symbols, spaces), which also takes the script around it.";
  let kind = scalar_kind(scalar: scalar);
  let mark = kind == kind_mark;
  let ignorable = kind == kind_ignorable;
  let follows = bor(mark, ignorable);
  if follows {
    let spacing = general_category(scalar: scalar);
    match spacing {
      SpacingMark() => {
        return script_other;
      }
      UppercaseLetter() => {
        return script_inherited;
      }
      LowercaseLetter() => {
        return script_inherited;
      }
      TitlecaseLetter() => {
        return script_inherited;
      }
      ModifierLetter() => {
        return script_inherited;
      }
      OtherLetter() => {
        return script_inherited;
      }
      NonspacingMark() => {
        return script_inherited;
      }
      EnclosingMark() => {
        return script_inherited;
      }
      DecimalNumber() => {
        return script_inherited;
      }
      LetterNumber() => {
        return script_inherited;
      }
      OtherNumber() => {
        return script_inherited;
      }
      ConnectorPunctuation() => {
        return script_inherited;
      }
      DashPunctuation() => {
        return script_inherited;
      }
      OpenPunctuation() => {
        return script_inherited;
      }
      ClosePunctuation() => {
        return script_inherited;
      }
      InitialPunctuation() => {
        return script_inherited;
      }
      FinalPunctuation() => {
        return script_inherited;
      }
      OtherPunctuation() => {
        return script_inherited;
      }
      MathSymbol() => {
        return script_inherited;
      }
      CurrencySymbol() => {
        return script_inherited;
      }
      ModifierSymbol() => {
        return script_inherited;
      }
      OtherSymbol() => {
        return script_inherited;
      }
      SpaceSeparator() => {
        return script_inherited;
      }
      LineSeparator() => {
        return script_inherited;
      }
      ParagraphSeparator() => {
        return script_inherited;
      }
      Control() => {
        return script_inherited;
      }
      Format() => {
        return script_inherited;
      }
      Surrogate() => {
        return script_inherited;
      }
      PrivateUse() => {
        return script_inherited;
      }
      Unassigned() => {
        return script_inherited;
      }
    }
  }
  let latin = in_ranges(scalar: scalar, ranges: &latin_ranges[0_u64..33_u64]);
  if latin {
    return script_latin;
  }
  let greek = in_ranges(scalar: scalar, ranges: &greek_ranges[0_u64..18_u64]);
  if greek {
    return script_greek;
  }
  let cyrillic = in_ranges(scalar: scalar, ranges: &cyrillic_ranges[0_u64..9_u64]);
  if cyrillic {
    return script_cyrillic;
  }
  let letterlike_low = scalar >= 8448_u32;
  let letterlike_high = scalar <= 8527_u32;
  let letterlike = band(letterlike_low, letterlike_high);
  let alphanumeric_low = scalar >= 119808_u32;
  let alphanumeric_high = scalar <= 120831_u32;
  let alphanumeric = band(alphanumeric_low, alphanumeric_high);
  let symbolic = bor(letterlike, alphanumeric);
  if symbolic {
    return script_common;
  }
  let letter = letter_class(scalar: scalar);
  let is_letter = letter == 2_u8;
  if is_letter {
    let category = general_category(scalar: scalar);
    match category {
      ModifierLetter() => {
        return script_common;
      }
      UppercaseLetter() => {
        return script_other;
      }
      LowercaseLetter() => {
        return script_other;
      }
      TitlecaseLetter() => {
        return script_other;
      }
      OtherLetter() => {
        return script_other;
      }
      NonspacingMark() => {
        return script_other;
      }
      SpacingMark() => {
        return script_other;
      }
      EnclosingMark() => {
        return script_other;
      }
      DecimalNumber() => {
        return script_other;
      }
      LetterNumber() => {
        return script_other;
      }
      OtherNumber() => {
        return script_other;
      }
      ConnectorPunctuation() => {
        return script_other;
      }
      DashPunctuation() => {
        return script_other;
      }
      OpenPunctuation() => {
        return script_other;
      }
      ClosePunctuation() => {
        return script_other;
      }
      InitialPunctuation() => {
        return script_other;
      }
      FinalPunctuation() => {
        return script_other;
      }
      OtherPunctuation() => {
        return script_other;
      }
      MathSymbol() => {
        return script_other;
      }
      CurrencySymbol() => {
        return script_other;
      }
      ModifierSymbol() => {
        return script_other;
      }
      OtherSymbol() => {
        return script_other;
      }
      SpaceSeparator() => {
        return script_other;
      }
      LineSeparator() => {
        return script_other;
      }
      ParagraphSeparator() => {
        return script_other;
      }
      Control() => {
        return script_other;
      }
      Format() => {
        return script_other;
      }
      Surrogate() => {
        return script_other;
      }
      PrivateUse() => {
        return script_other;
      }
      Unassigned() => {
        return script_other;
      }
    }
  }
  return script_common;
}

fn shaping_script(script: u8) -> result: Script pure {
  doc "Returns the pkg::font script a segment of a resolved script is shaped in: Latin, Greek and Cyrillic as themselves and every other script as Common, which selects a face's default language system.";
  if script == script_latin {
    return Script::Latin();
  }
  if script == script_greek {
    return Script::Greek();
  }
  if script == script_cyrillic {
    return Script::Cyrillic();
  }
  return Script::Common();
}
