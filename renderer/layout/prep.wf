alias Document = pkg::dom::Document;
alias FontGroup = pkg::css::values::FontGroup;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;
alias TextRun = pkg::layout::text::TextRun;
alias ShapedText = pkg::layout::text::ShapedText;
alias reshape_paragraph = pkg::layout::text::reshape_paragraph;
alias shaped_empty = pkg::layout::text::shaped_empty;
alias upper_scalar = pkg::layout::text::upper_scalar;
alias sizing_value = pkg::css::values::sizing_value;
alias Sizing = pkg::css::values::Sizing;

const transform_capitalize: u8 = 1_u8;

const transform_uppercase: u8 = 2_u8;

const transform_lowercase: u8 = 3_u8;

struct Emit {
  doc "The state of one paragraph's white-space processing: whether the last scalar emitted is a collapsible space, whether the walk is at the start of a line (the paragraph's start or after a forced break), whether the last scalar was a letter (for capitalize), and the run being built: its style, its start and whether one is open.";
  last_space: Bool;
  at_start: Bool;
  after_letter: Bool;
  run_style: StyleRef;
  run_start: u64;
  have_run: Bool;
}

fn same_style(first: StyleRef, second: StyleRef) -> same: Bool pure {
  doc "Tells whether two style references name the same style.";
  let element = first.element == second.element;
  let pseudo = first.pseudo == second.pseudo;
  let anonymous = first.anonymous == second.anonymous;
  let both = band(element, pseudo);
  let all = band(both, anonymous);
  return all;
}

fn spacing_px(value: Sizing) -> px: f32 pure {
  doc "The px of a computed letter-spacing or word-spacing: its length, or 0 for normal.";
  if value.kind == sizing_value {
    return value.value.px;
  }
  return 0.0_f32;
}

fn close_run(styles: &Styles, emit: &Emit, paragraph: &Paragraph) -> result: unit reads(styles), writes(emit), writes(paragraph) {
  doc "Ends the open run at the paragraph's current length, recording it with its style's font group, spacing and wrapping, when it holds text.";
  if emit^.have_run {
  } else {
    return unit;
  }
  let end = paragraph^.text.inner.len;
  let start = emit^.run_start;
  set emit^.have_run = False();
  if end <= start {
    return unit;
  }
  let small = end < 4294967295_u64;
  if small {
  } else {
    return unit;
  }
  let style = emit^.run_style;
  let text = text_of(styles: styles, style: style);
  let font = font_index(styles: styles, style: style);
  let white = text.white_space;
  let nowrap = white == white_nowrap;
  let pre = white == white_pre;
  let unwrapped = bor(nowrap, pre);
  let wraps = bnot(unwrapped);
  let letter = spacing_px(value: text.letter_spacing);
  let word = spacing_px(value: text.word_spacing);
  let from = cvt::<u64, u32>(start);
  let to = cvt::<u64, u32>(end);
  let separate = False();
  let run = TextRun(start: from, end: to, font: font, letter_spacing: letter, word_spacing: word, wraps: wraps, word_break: text.word_break, overflow_wrap: text.overflow_wrap, joins: separate);
  let pushed = push_item::<TextRun>(cell: &paragraph^.runs, value: run, ceiling: item_ceiling);
  let listed = push_item::<StyleRef>(cell: &paragraph^.run_styles, value: style, ceiling: item_ceiling);
  return unit;
}

fn put_scalar(styles: &Styles, emit: &Emit, paragraph: &Paragraph, value: u32, style: StyleRef) -> result: unit reads(styles), writes(emit), writes(paragraph) {
  doc "Appends value to the paragraph's text in style's run, closing the open run first when style differs.";
  if emit^.have_run {
    let same = same_style(first: emit^.run_style, second: style);
    if same {
    } else {
      close_run(styles: styles, emit: emit, paragraph: paragraph);
    }
  }
  if emit^.have_run {
  } else {
    set emit^.run_style = style;
    set emit^.run_start = paragraph^.text.inner.len;
    set emit^.have_run = True();
  }
  let pushed = push_item::<u32>(cell: &paragraph^.text, value: value, ceiling: scalar_ceiling);
  return unit;
}

fn is_letter(value: u32) -> letter: Bool pure {
  doc "Tells whether value is an ASCII or Latin-1 letter or a letter of the Latin Extended, Greek or Cyrillic blocks, for capitalize.";
  let upper_left = value >= 65_u32;
  let upper_right = value <= 90_u32;
  let upper = band(upper_left, upper_right);
  let lower_left = value >= 97_u32;
  let lower_right = value <= 122_u32;
  let lower = band(lower_left, lower_right);
  let latin_left = value >= 192_u32;
  let latin_right = value <= 591_u32;
  let latin = band(latin_left, latin_right);
  let multiply_sign = value == 215_u32;
  let divide = value == 247_u32;
  let sign = bor(multiply_sign, divide);
  let latin_letter_not = bnot(sign);
  let latin_letter = band(latin, latin_letter_not);
  let greek_left = value >= 880_u32;
  let greek_right = value <= 1023_u32;
  let greek = band(greek_left, greek_right);
  let cyrillic_left = value >= 1024_u32;
  let cyrillic_right = value <= 1279_u32;
  let cyrillic = band(cyrillic_left, cyrillic_right);
  let ascii = bor(upper, lower);
  let other = bor(greek, cyrillic);
  let some = bor(ascii, latin_letter);
  let found = bor(some, other);
  return found;
}

fn to_lower(value: u32) -> mapped: u32 pure {
  doc "Maps value to lower case over the ranges upper_scalar covers; others unchanged.";
  let upper_left = value >= 65_u32;
  let upper_right = value <= 90_u32;
  let upper = band(upper_left, upper_right);
  if upper {
    return value + 32_u32;
  }
  let latin_left = value >= 192_u32;
  let latin_right = value <= 222_u32;
  let latin = band(latin_left, latin_right);
  let multiply_sign = value == 215_u32;
  let latin_letter_not = bnot(multiply_sign);
  let latin_letter = band(latin, latin_letter_not);
  if latin_letter {
    return value + 32_u32;
  }
  if value == 376_u32 {
    return 255_u32;
  }
  let extended_left = value >= 256_u32;
  let extended_right = value <= 383_u32;
  let extended = band(extended_left, extended_right);
  if extended {
    let even_bits = iand(value, 1_u32);
    let even = even_bits == 0_u32;
    let paired_low = value <= 311_u32;
    let paired_high = value >= 330_u32;
    let paired = bor(paired_low, paired_high);
    let even_pairs = band(paired, even);
    if even_pairs {
      return value + 1_u32;
    }
    let middle_left = value >= 313_u32;
    let middle_right = value <= 328_u32;
    let middle = band(middle_left, middle_right);
    let odd = bnot(even);
    let middle_upper = band(middle, odd);
    if middle_upper {
      return value + 1_u32;
    }
    return value;
  }
  let greek_left = value >= 913_u32;
  let greek_right = value <= 937_u32;
  let greek = band(greek_left, greek_right);
  if greek {
    return value + 32_u32;
  }
  let cyrillic_left = value >= 1040_u32;
  let cyrillic_right = value <= 1071_u32;
  let cyrillic = band(cyrillic_left, cyrillic_right);
  if cyrillic {
    return value + 32_u32;
  }
  let cyrillic_extra_left = value >= 1024_u32;
  let cyrillic_extra_right = value <= 1039_u32;
  let cyrillic_extra = band(cyrillic_extra_left, cyrillic_extra_right);
  if cyrillic_extra {
    return value + 80_u32;
  }
  return value;
}

fn drop_last_space(emit: &Emit, paragraph: &Paragraph) -> result: unit reads(emit), writes(paragraph) {
  doc "Removes the collapsible space the paragraph's text ends with, when the open run holds it and no inline box opens or closes after it: under pre-line a space before a forced break is removed (CSS Text 3, white-space processing).";
  if emit^.have_run {
  } else {
    return unit;
  }
  let length = paragraph^.text.inner.len;
  if length == 0_u64 {
    return unit;
  }
  let last = length - 1_u64;
  let inside = emit^.run_start < length;
  if inside {
  } else {
    return unit;
  }
  if paragraph^.text.inner[last] != 32_u32 {
    return unit;
  }
  let marks = paragraph^.marks.inner.len;
  if marks > 0_u64 {
    let latest = marks - 1_u64;
    let mark = paragraph^.marks.inner[latest];
    let at = match mark {
      Open(at: a, ..) => {
        give cvt::<u32, u64>(a);
      }
      Close(at: a, ..) => {
        give cvt::<u32, u64>(a);
      }
      Atomic(at: a, ..) => {
        give cvt::<u32, u64>(a);
      }
      Node(at: a, ..) => {
        give cvt::<u32, u64>(a);
      }
    }
    if at >= length {
      return unit;
    }
  }
  let removed = take_back(window: &paragraph^.text.inner);
  return unit;
}

fn add_text_scalar(styles: &Styles, emit: &Emit, paragraph: &Paragraph, raw: u32, style: StyleRef) -> result: unit reads(styles), writes(emit), writes(paragraph) {
  doc "Processes one scalar value of text in style as CSS Text 3's white-space processing and text-transform do: under normal, nowrap and pre-line, a space or tab collapses into a preceding collapsible space and is dropped at a line's start, and a line feed is a space under normal and nowrap; under pre, pre-wrap, pre-line and break-spaces a line feed is a forced line break (U+2028); every other scalar is transformed and appended.";
  let text = text_of(styles: styles, style: style);
  let white = text.white_space;
  let normal = white == white_normal;
  let nowrap = white == white_nowrap;
  let pre_line = white == white_pre_line;
  let flat = bor(normal, nowrap);
  let collapsing = bor(flat, pre_line);
  let value = if raw == 13_u32 {
    give 10_u32;
  } else if raw == 12_u32 {
    give 32_u32;
  } else {
    give raw;
  }
  let feed = value == 10_u32;
  let feed_as_space = band(feed, flat);
  let newline_not = bnot(flat);
  let newline = band(feed, newline_not);
  if newline {
    let drops = band(collapsing, emit^.last_space);
    if drops {
      drop_last_space(emit: emit, paragraph: paragraph);
    }
    put_scalar(styles: styles, emit: emit, paragraph: paragraph, value: line_separator, style: style);
    set emit^.last_space = False();
    set emit^.at_start = True();
    set emit^.after_letter = False();
    return unit;
  }
  let space = value == 32_u32;
  let tab = value == 9_u32;
  let blank_pair = bor(space, tab);
  let blank = bor(blank_pair, feed_as_space);
  if blank {
    if collapsing {
      let skip = bor(emit^.at_start, emit^.last_space);
      if skip {
        return unit;
      }
      put_scalar(styles: styles, emit: emit, paragraph: paragraph, value: 32_u32, style: style);
      set emit^.last_space = True();
      set emit^.after_letter = False();
      return unit;
    }
    put_scalar(styles: styles, emit: emit, paragraph: paragraph, value: value, style: style);
    set emit^.last_space = False();
    set emit^.at_start = False();
    set emit^.after_letter = False();
    return unit;
  }
  let transform = text.text_transform;
  let letter = is_letter(value: value);
  let mapped = if transform == transform_uppercase {
    give upper_scalar(value: value);
  } else if transform == transform_lowercase {
    give to_lower(value: value);
  } else if transform == transform_capitalize {
    let first_not = bnot(emit^.after_letter);
    let first = band(letter, first_not);
    if first {
      give upper_scalar(value: value);
    } else {
      give value;
    }
  } else {
    give value;
  }
  put_scalar(styles: styles, emit: emit, paragraph: paragraph, value: mapped, style: style);
  set emit^.last_space = False();
  set emit^.at_start = False();
  set emit^.after_letter = letter;
  return unit;
}

fn add_bytes(styles: &Styles, emit: &Emit, paragraph: &Paragraph, bytes: &[u8], style: StyleRef) -> result: unit reads(styles), reads(bytes), writes(emit), writes(paragraph) {
  doc "Decodes bytes as UTF-8, each ill-formed sequence as U+FFFD, and processes each scalar value with add_text_scalar.";
  let count = bytes^.len;
  let value = 0_u32;
  let needed = 0_u32;
  for (at in 0_u64..count) {
    let byte = bytes^[at];
    let wide = cvt::<u8, u32>(byte);
    let continuation_bits = iand(wide, 192_u32);
    let continuation = continuation_bits == 128_u32;
    let pending = needed > 0_u32;
    let continues = band(pending, continuation);
    if continues {
      let shifted = ishl(value, 6_u32);
      let bits = iand(wide, 63_u32);
      set value = ior(shifted, bits);
      set needed = needed - 1_u32;
      if needed == 0_u32 {
        add_text_scalar(styles: styles, emit: emit, paragraph: paragraph, raw: value, style: style);
      }
    } else {
      if pending {
        add_text_scalar(styles: styles, emit: emit, paragraph: paragraph, raw: 65533_u32, style: style);
        set needed = 0_u32;
      }
      let leads = start_byte(wide: wide);
      if leads == 0_u32 {
        add_text_scalar(styles: styles, emit: emit, paragraph: paragraph, raw: wide, style: style);
      } else if leads == 4_u32 {
        add_text_scalar(styles: styles, emit: emit, paragraph: paragraph, raw: 65533_u32, style: style);
      } else {
        set needed = leads;
        let mask = if leads == 1_u32 {
          give 31_u32;
        } else if leads == 2_u32 {
          give 15_u32;
        } else {
          give 7_u32;
        }
        set value = iand(wide, mask);
      }
    }
  }
  if needed > 0_u32 {
    add_text_scalar(styles: styles, emit: emit, paragraph: paragraph, raw: 65533_u32, style: style);
  }
  return unit;
}

fn start_byte(wide: u32) -> continuations: u32 pure {
  doc "The number of continuation bytes a UTF-8 byte announces: 0 for ASCII, 1 to 3 for a lead byte, 4 for a byte that starts no sequence.";
  if wide < 128_u32 {
    return 0_u32;
  }
  let two = iand(wide, 224_u32);
  if two == 192_u32 {
    return 1_u32;
  }
  let three = iand(wide, 240_u32);
  if three == 224_u32 {
    return 2_u32;
  }
  let four = iand(wide, 248_u32);
  if four == 240_u32 {
    return 3_u32;
  }
  return 4_u32;
}

fn add_mark(paragraph: &Paragraph, mark: Mark) -> result: unit writes(paragraph) {
  doc "Appends mark to the paragraph's inline structure.";
  let pushed = push_item::<Mark>(cell: &paragraph^.marks, value: mark, ceiling: item_ceiling);
  return unit;
}

fn text_index(paragraph: &Paragraph) -> at: u32 reads(paragraph) {
  doc "The paragraph's current text length as a text index.";
  let length = paragraph^.text.inner.len;
  let small = length < 4294967295_u64;
  if small {
    let made = cvt::<u64, u32>(length);
    return made;
  }
  return 4294967294_u32;
}

fn mark_at(mark: Mark) -> at: u64 pure {
  doc "The text index a mark sits at.";
  let found = match mark {
    Open(at: a, ..) => {
      give cvt::<u32, u64>(a);
    }
    Close(at: a, ..) => {
      give cvt::<u32, u64>(a);
    }
    Atomic(at: a, ..) => {
      give cvt::<u32, u64>(a);
    }
    Node(at: a, ..) => {
      give cvt::<u32, u64>(a);
    }
  }
  return found;
}

fn breaks_shaping(styles: &Styles, mark: Mark) -> breaks: Bool reads(styles) {
  doc "Tells whether mark ends the shaping of the text around it: the start of an inline box with an inline-start margin, border or padding or a vertical-align other than baseline, and the end of one with the same at its inline end (CSS Text 3, boundary shaping); every other mark leaves it unbroken.";
  let found = match mark {
    Open(style: owner, ..) => {
      let (start, end) = inline_frame(styles: styles, style: owner, basis: 0_i32);
      let flat = feq(start, 0.0_f32);
      let framed = bnot(flat);
      let shifted = shifted_box(styles: styles, style: owner);
      give bor(framed, shifted);
    }
    Close(style: owner, ..) => {
      let (start, end) = inline_frame(styles: styles, style: owner, basis: 0_i32);
      let flat = feq(end, 0.0_f32);
      let framed = bnot(flat);
      let shifted = shifted_box(styles: styles, style: owner);
      give bor(framed, shifted);
    }
    Atomic(..) => {
      give False();
    }
    Node(..) => {
      give False();
    }
  }
  return found;
}

fn same_families(styles: &Styles, first: FontGroup, second: FontGroup) -> same: Bool reads(styles) {
  doc "Tells whether two font groups name the same font-family list: the same span of the family table, or spans of equal length whose families have the same names and generic flags, since the style stage gives the same list declared on two elements two spans.";
  let starts = first.families_start == second.families_start;
  let ends = first.families_end == second.families_end;
  let shared = band(starts, ends);
  if shared {
    return True();
  }
  let first_start = cvt::<u32, u64>(first.families_start);
  let first_end = cvt::<u32, u64>(first.families_end);
  let second_start = cvt::<u32, u64>(second.families_start);
  let second_end = cvt::<u32, u64>(second.families_end);
  let first_count = first_end -sat first_start;
  let second_count = second_end -sat second_start;
  if first_count != second_count {
    return False();
  }
  let table = styles^.families.inner.len;
  let alike_all = True();
  for (k in 0_u64..first_count) {
    let one = first_start +sat k;
    let two = second_start +sat k;
    let inside_one = one < table;
    let inside_two = two < table;
    let inside = band(inside_one, inside_two);
    let alike = if inside {
      let left = styles^.families.inner[one];
      let right = styles^.families.inner[two];
      let named = left.name.index == right.name.index;
      let kind = left.generic == right.generic;
      let both = band(named, kind);
      give both;
    } else {
      give False();
    }
    set alike_all = band(alike_all, alike);
  }
  return alike_all;
}

fn same_shaping(styles: &Styles, first: TextRun, first_style: StyleRef, second: TextRun, second_style: StyleRef) -> same: Bool reads(styles) {
  doc "Tells whether two adjacent runs shape alike, as Blink's ShapeText compares the fonts of adjacent text items: the same font-family list, size, weight, style and font-variant-caps, and the same letter-spacing and word-spacing, which Blink's font description holds. White-space, word-break, overflow-wrap and tab-size are not in the font, so the reference shapes across a boundary where only they differ, and each run keeps its own.";
  let one = font_of(styles: styles, style: first_style);
  let two = font_of(styles: styles, style: second_style);
  let families = same_families(styles: styles, first: one, second: two);
  let size = feq(one.size, two.size);
  let weight = feq(one.weight, two.weight);
  let slant = one.style == two.style;
  let caps = one.variant_caps == two.variant_caps;
  let sized = band(size, weight);
  let styled = band(slant, caps);
  let face = band(sized, styled);
  let font = band(families, face);
  let letter = feq(first.letter_spacing, second.letter_spacing);
  let word = feq(first.word_spacing, second.word_spacing);
  let spacing = band(letter, word);
  let made = band(font, spacing);
  return made;
}

fn first_mark_from(paragraph: &Paragraph, boundary: u64) -> found: u64 reads(paragraph) {
  doc "The index of the first mark at or after text index boundary, by binary search, since the walk records the marks in text order; the mark count when there is none.";
  let count = paragraph^.marks.inner.len;
  let low = 0_u64;
  let high = count;
  for (step in 0_u64..64_u64) {
    if low >= high {
      break;
    }
    let width = high - low;
    let half = width / 2_u64;
    let middle = low + half;
    if middle < count {
      let mark = paragraph^.marks.inner[middle];
      let at = mark_at(mark: mark);
      if at < boundary {
        set low = middle + 1_u64;
      } else {
        set high = middle;
      }
    } else {
      break;
    }
  }
  return low;
}

fn boundary_breaks(styles: &Styles, paragraph: &Paragraph, boundary: u64) -> broken: Bool reads(styles), reads(paragraph) {
  doc "Whether an inline box edge at text index boundary breaks shaping there (breaks_shaping).";
  let marks = paragraph^.marks.inner.len;
  let first = first_mark_from(paragraph: paragraph, boundary: boundary);
  let broken = False();
  for (m in first..marks) {
    let mark = paragraph^.marks.inner[m];
    let at = mark_at(mark: mark);
    if at != boundary {
      break;
    }
    let stops = breaks_shaping(styles: styles, mark: mark);
    set broken = bor(broken, stops);
  }
  return broken;
}

fn join_runs(styles: &Styles, paragraph: &Paragraph) -> result: unit reads(styles), writes(paragraph) {
  doc "Marks each run that is shaped as one text with the run before it (its joins): the two are contiguous, shape alike (same_shaping) and no inline box edge that breaks shaping lies between them (boundary_breaks), as the reference shapes the text of adjacent inline elements as one when their fonts are alike, so kerning and ligatures cross the element boundary. Every run keeps its own style, spacing and wrapping. Each run's decision reads only the two runs and the marks at their boundary, so the first loop decides them independently and the second writes them.";
  let runs = paragraph^.runs.inner.len;
  let styled = paragraph^.run_styles.inner.len;
  let enough = runs > 1_u64;
  let matched = runs == styled;
  let useful = band(enough, matched);
  if useful {
  } else {
    return unit;
  }
  let unjoined = False();
  let decided = box_array_filled::<Bool>(count: runs, value: unjoined);
  for (r in 1_u64..runs) {
    let before = r - 1_u64;
    let have_runs = r < paragraph^.runs.inner.len;
    let have_styles = r < paragraph^.run_styles.inner.len;
    let have_previous = before < paragraph^.runs.inner.len;
    let have_previous_style = before < paragraph^.run_styles.inner.len;
    let have_current = band(have_runs, have_styles);
    let have_before = band(have_previous, have_previous_style);
    let have_decided = r < decided.inner.len;
    let have_both = band(have_current, have_before);
    let have = band(have_both, have_decided);
    if have {
      let previous = paragraph^.runs.inner[before];
      let previous_style = paragraph^.run_styles.inner[before];
      let run = paragraph^.runs.inner[r];
      let style = paragraph^.run_styles.inner[r];
      let boundary = cvt::<u32, u64>(run.start);
      let adjacent = previous.end == run.start;
      let alike = same_shaping(styles: styles, first: previous, first_style: previous_style, second: run, second_style: style);
      let candidate = band(adjacent, alike);
      let broken = boundary_breaks(styles: styles, paragraph: paragraph, boundary: boundary);
      let free = bnot(broken);
      let joins = band(candidate, free);
      set decided.inner[r] = joins;
    }
  }
  for (r in 0_u64..runs) {
    let held = r < decided.inner.len;
    let listed = r < paragraph^.runs.inner.len;
    let both = band(held, listed);
    if both {
      set paragraph^.runs.inner[r].joins = decided.inner[r];
    }
  }
  return unit;
}

fn prepare_paragraph(bytes: &[u8], generated: &[u8], styles: &Styles, fonts: &FontSet, picks: &FontPicks, paragraph: &Paragraph, previous: &ShapedText, previous_text: &[u32]) -> ok: Bool reads(bytes), reads(generated), reads(styles), reads(fonts), reads(picks), reads(previous), reads(previous_text), writes(paragraph) {
  doc "Turns the paragraph's pieces into its text, runs, run styles and marks, then shapes its text, keeping the shaping of previous, what preparing previous_text gave (empty for a first preparation), where reshape_paragraph allows; False when shaping refuses it.";
  let total = paragraph^.pieces.inner.len;
  let no = False();
  let yes = True();
  let emit = Emit(last_space: no, at_start: yes, after_letter: no, run_style: paragraph^.style, run_start: 0_u64, have_run: no);
  let stored = bytes^.len;
  let made = generated^.len;
  for (at in 0_u64..total) {
    if at < paragraph^.pieces.inner.len {
    } else {
      return False();
    }
    let piece = paragraph^.pieces.inner[at];
    match piece {
      Bytes(start: from, end: to, style: owner, node: source) => {
        let low = cvt::<u32, u64>(from);
        let high = cvt::<u32, u64>(to);
        let ordered = low <= high;
        let inside = high <= stored;
        let usable = band(ordered, inside);
        if usable {
          let begin = text_index(paragraph: paragraph);
          add_bytes(styles: styles, emit: &emit, paragraph: paragraph, bytes: &bytes^[low..high], style: owner);
          if source != no_index {
            let finish = text_index(paragraph: paragraph);
            let mark = Mark::Node(at: begin, end: finish, node: source);
            add_mark(paragraph: paragraph, mark: mark);
          }
        }
      }
      Generated(start: from, end: to, style: owner) => {
        let low = cvt::<u32, u64>(from);
        let high = cvt::<u32, u64>(to);
        let ordered = low <= high;
        let inside = high <= made;
        let usable = band(ordered, inside);
        if usable {
          add_bytes(styles: styles, emit: &emit, paragraph: paragraph, bytes: &generated^[low..high], style: owner);
        }
      }
      Scalar(value: one, style: owner) => {
        add_text_scalar(styles: styles, emit: &emit, paragraph: paragraph, raw: one, style: owner);
        if one == line_separator {
          set emit.at_start = True();
          set emit.last_space = False();
        }
      }
      Begin(style: owner) => {
        let here = text_index(paragraph: paragraph);
        let mark = Mark::Open(at: here, style: owner);
        add_mark(paragraph: paragraph, mark: mark);
      }
      End(style: owner) => {
        let here = text_index(paragraph: paragraph);
        let mark = Mark::Close(at: here, style: owner);
        add_mark(paragraph: paragraph, mark: mark);
      }
      Object(context: child, style: owner) => {
        let here = text_index(paragraph: paragraph);
        put_scalar(styles: styles, emit: &emit, paragraph: paragraph, value: object_mark, style: owner);
        set emit.last_space = False();
        set emit.at_start = False();
        set emit.after_letter = False();
        let mark = Mark::Atomic(at: here, context: child);
        add_mark(paragraph: paragraph, mark: mark);
      }
    }
  }
  close_run(styles: styles, emit: &emit, paragraph: paragraph);
  join_runs(styles: styles, paragraph: paragraph);
  let length = paragraph^.text.inner.len;
  if length == 0_u64 {
    return True();
  }
  if length > 1073741824_u64 {
    return False();
  }
  let runs = paragraph^.runs.inner.len;
  match reshape_paragraph(fonts: fonts, picks: picks, text: &paragraph^.text.inner[0_u64..length], runs: &paragraph^.runs.inner[0_u64..runs], previous: previous, previous_text: previous_text) {
    Ok(value: shaped) => {
      set paragraph^.shaped = move shaped;
      return True();
    }
    Err(..) => {
      return False();
    }
  }
}

fn prepare_context(context: &Context, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> ok: Bool reads(document), reads(styles), reads(fonts), reads(picks), writes(context) {
  doc "Prepares every paragraph of context in one counted loop, each iteration writing only its own paragraph, and then every child context, one per iteration of a second counted loop; False when any paragraph's shaping failed.";
  if context^.retired {
    return True();
  }
  let count = context^.paragraphs.inner.len;
  let stored = document^.text.inner.len;
  let made = styles^.generated_text.inner.len;
  let ok = True();
  for (i in 0_u64..count) {
    if context^.paragraphs.inner[i].retired {
    } else {
      let none = shaped_empty();
      let no_text = array_filled::<u32, 1>(value: 0_u32);
      let done = prepare_paragraph(bytes: &document^.text.inner[0_u64..stored], generated: &styles^.generated_text.inner[0_u64..made], styles: styles, fonts: fonts, picks: picks, paragraph: &context^.paragraphs.inner[i], previous: &none, previous_text: &no_text[0_u64..0_u64]);
      set ok = band(ok, done);
    }
  }
  let children = context^.children.inner.len;
  for (k in 0_u64..children) {
    let done = prepare_context(context: &context^.children.inner[k], document: document, styles: styles, fonts: fonts, picks: picks);
    set ok = band(ok, done);
  }
  return ok;
}
