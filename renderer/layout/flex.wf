alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;
alias Sizing = pkg::css::values::Sizing;
alias sizing_value = pkg::css::values::sizing_value;
alias sizing_auto = pkg::css::values::sizing_auto;
alias sizing_normal = pkg::css::values::sizing_normal;
alias align_normal = pkg::css::values::align_normal;
alias align_stretch = pkg::css::values::align_stretch;
alias align_start = pkg::css::values::align_start;
alias align_end = pkg::css::values::align_end;
alias align_center = pkg::css::values::align_center;
alias align_flex_start = pkg::css::values::align_flex_start;
alias align_flex_end = pkg::css::values::align_flex_end;
alias align_self_start = pkg::css::values::align_self_start;
alias align_self_end = pkg::css::values::align_self_end;
alias align_left = pkg::css::values::align_left;
alias align_right = pkg::css::values::align_right;
alias align_baseline = pkg::css::values::align_baseline;
alias align_last_baseline = pkg::css::values::align_last_baseline;
alias align_space_between = pkg::css::values::align_space_between;
alias align_space_around = pkg::css::values::align_space_around;
alias align_space_evenly = pkg::css::values::align_space_evenly;
alias align_auto = pkg::css::values::align_auto;

const flex_at_start: u8 = 0_u8;

const flex_at_end: u8 = 1_u8;

const flex_at_center: u8 = 2_u8;

const flex_at_stretch: u8 = 3_u8;

const flex_at_baseline: u8 = 4_u8;

const flex_at_between: u8 = 5_u8;

const flex_at_around: u8 = 6_u8;

const flex_at_evenly: u8 = 7_u8;

const flex_infinite: i32 = 2147483647_i32;

struct FlexBox {
  doc "What the flex container tells its items and the passes over them: its direction as the booleans row (the main axis is horizontal), reverse (the main axis runs against the writing direction) and wrapping and wrap_reverse (flex-wrap), its content width, the height its content box is known to have (unknown when indefinite), the gaps along the main and the cross axis, the alignment properties, and whether pkg::layout's update is updating the container (lay_out_child).";
  row: Bool;
  reverse: Bool;
  wrapping: Bool;
  wrap_reverse: Bool;
  content_width: i32;
  inner_height: i32;
  main_gap: i32;
  cross_gap: i32;
  align_items: u8;
  justify_content: u8;
  align_content: u8;
  updating: Bool;
}

struct FlexItem {
  doc "One child context of a flex container as the flex algorithm sees it, in the container's main and cross axes: whether it is a flex item (an absolutely positioned child is not), its order, its margins (auto as zero, with which are auto), its paddings and borders, its flex factors, its border-box sizes (flex base, automatic or given minimum, maximum or unknown, hypothetical, target after flexing, and the main size of its natural layout), its cross-size limits, its alignment as a flex_at constant, the cross size it is stretched to or unknown, its baseline from its border-box top, and its border box's offsets along the main and the cross axis from the content box's start edges.";
  child: u64;
  active: Bool;
  order: i32;
  main_start: i32;
  main_end: i32;
  cross_start: i32;
  cross_end: i32;
  auto_main_start: Bool;
  auto_main_end: Bool;
  auto_cross_start: Bool;
  auto_cross_end: Bool;
  frame_main: i32;
  frame_cross: i32;
  grow: f64;
  shrink: f64;
  base: i32;
  minimum: i32;
  maximum: i32;
  hypothetical: i32;
  target: i32;
  frozen: Bool;
  cross_minimum: i32;
  cross_maximum: i32;
  cross_auto: Bool;
  natural_main: i32;
  natural_width: i32;
  place: u8;
  stretch_to: i32;
  cross_size: i32;
  baseline: i32;
  main_position: i32;
  cross_position: i32;
}

struct FlexLine {
  doc "One flex line over the ordered items first to end (end excluded): its cross size, the largest distance from its start edge to the baseline of an item aligned to baselines, its offset along the cross axis from the content box's start edge, and the sum of its items' hypothetical outer main sizes and gaps.";
  first: u64;
  end: u64;
  cross: i32;
  above: i32;
  position: i32;
  main_sum: i32;
}

struct FlexOffset {
  doc "A pair of offsets.";
  dx: i32;
  dy: i32;
}

fn flex_blank_item() -> made: FlexItem pure {
  doc "An item that is no flex item and holds nothing.";
  let no = False();
  return FlexItem(child: 0_u64, active: no, order: 0_i32, main_start: 0_i32, main_end: 0_i32, cross_start: 0_i32, cross_end: 0_i32, auto_main_start: no, auto_main_end: no, auto_cross_start: no, auto_cross_end: no, frame_main: 0_i32, frame_cross: 0_i32, grow: 0.0_f64, shrink: 0.0_f64, base: 0_i32, minimum: 0_i32, maximum: unknown, hypothetical: 0_i32, target: 0_i32, frozen: no, cross_minimum: unknown, cross_maximum: unknown, cross_auto: no, natural_main: unknown, natural_width: unknown, place: flex_at_start, stretch_to: unknown, cross_size: 0_i32, baseline: 0_i32, main_position: 0_i32, cross_position: 0_i32);
}

fn flex_round(value: f64) -> raw: i32 pure {
  doc "value rounded to the nearest integer, halves away from zero, saturating at plus or minus 2e9.";
  let positive = fge(value, 0.0_f64);
  let magnitude = fabs(value);
  let shifted = fadd.strict(magnitude, 0.5_f64);
  let whole = ffloor(shifted);
  let capped = fmin(whole, 2.0e9_f64);
  let fits = cvt.defined::<f64, i32>(capped);
  if fits {
    let made = cvt::<f64, i32>(capped);
    if positive {
      return made;
    }
    let negated = 0_i32 -sat made;
    return negated;
  }
  return 0_i32;
}

fn flex_place(value: u8, reversed: Bool) -> place: u8 pure {
  doc "The flex_at constant that an align or justify keyword names on an axis that runs against the writing direction when reversed: start, self-start and left name the writing direction's start edge and end, self-end and right its end edge, so they swap with the flex-relative keywords when reversed; stretch, center, baseline and the space distributions name themselves, and keywords with no meaning on the axis fall back to the start.";
  if value == align_flex_start {
    return flex_at_start;
  }
  if value == align_flex_end {
    return flex_at_end;
  }
  let starts_a = value == align_start;
  let starts_b = value == align_self_start;
  let starts_c = value == align_left;
  let starts_ab = bor(starts_a, starts_b);
  let physical_start = bor(starts_ab, starts_c);
  if physical_start {
    if reversed {
      return flex_at_end;
    }
    return flex_at_start;
  }
  let ends_a = value == align_end;
  let ends_b = value == align_self_end;
  let ends_c = value == align_right;
  let ends_ab = bor(ends_a, ends_b);
  let physical_end = bor(ends_ab, ends_c);
  if physical_end {
    if reversed {
      return flex_at_start;
    }
    return flex_at_end;
  }
  if value == align_center {
    return flex_at_center;
  }
  if value == align_stretch {
    return flex_at_stretch;
  }
  if value == align_baseline {
    return flex_at_baseline;
  }
  if value == align_last_baseline {
    return flex_at_end;
  }
  if value == align_space_between {
    return flex_at_between;
  }
  if value == align_space_around {
    return flex_at_around;
  }
  if value == align_space_evenly {
    return flex_at_evenly;
  }
  return flex_at_start;
}

fn flex_gap(value: Sizing, basis: i32) -> raw: i32 pure {
  doc "A computed row-gap or column-gap in layout units: zero for normal, for a percentage of an indefinite basis and when negative.";
  if value.kind == sizing_value {
    let made = size_value(value: value, basis: basis);
    let floor = imax(made, 0_i32);
    return floor;
  }
  return 0_i32;
}

fn flex_item_at(entries: &Box<Slots<FlexItem>>, at: u64) -> item: FlexItem reads(entries) {
  doc "The item at position at of entries, a blank one past the end.";
  if at < entries^.inner.len {
    let found = entries^.inner[at];
    return found;
  }
  let blank = flex_blank_item();
  return blank;
}

fn flex_outer_hypothetical(item: FlexItem) -> outer: i32 pure {
  doc "The hypothetical main size of item with its main margins.";
  let inner = item.hypothetical +sat item.main_start;
  let made = inner +sat item.main_end;
  return made;
}

fn flex_content_widths(child: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> (minimum: i32, maximum: i32) reads(styles), reads(document), reads(fonts), reads(picks), writes(child) {
  doc "The min-content and max-content border-box widths of an item as flex layout uses them to size its content: the content's widths plus the item's paddings and borders, never clamped or replaced by a given width.";
  let style = child^.style;
  let basis = child^.space.basis_width;
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: basis);
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let no = False();
  let (least, most) = intrinsic_content(context: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, skip: no);
  let high = imax(most, least);
  let low_total = least +sat frame;
  let high_total = high +sat frame;
  return low_total, high_total;
}

fn flex_basis_width(styles: &Styles, style: StyleRef) -> raw: i32 reads(styles) {
  doc "The border-box width a definite flex-basis gives an item in a row, against an indefinite basis, or unknown when the basis is auto, content or a percentage.";
  let group = item_of(styles: styles, style: style);
  if group.basis.kind == sizing_value {
    let border = border_edges(styles: styles, style: style);
    let padding = padding_edges(styles: styles, style: style, basis: 0_i32);
    let frame_border = horizontal(edges: border);
    let frame_padding = horizontal(edges: padding);
    let frame = frame_border +sat frame_padding;
    let boxed = box_of(styles: styles, style: style);
    let border_box = boxed.box_sizing == box_sizing_border;
    let content = size_value(value: group.basis, basis: unknown);
    if content >= 0_i32 {
      let made = border_box_from_content(content: content, border_box_sizing: border_box, frame: frame);
      return made;
    }
  }
  return unknown;
}

fn flex_contribution(child: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, row: Bool) -> (minimum: i32, maximum: i32) reads(styles), reads(document), reads(fonts), reads(picks), writes(child) {
  doc "The outer min-content and max-content contributions of an item to its flex container's width (CSS Flexbox 9.9.1): the item's intrinsic sizes, or in a row a definite flex-basis in their place, clamped by its min-width and max-width, plus its horizontal margins.";
  let style = child^.style;
  let (least, most) = intrinsic_sizes(context: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  let margins = margin_edges(styles: styles, style: style, basis: 0_i32);
  let around = horizontal(edges: margins);
  let given = if row {
    give flex_basis_width(styles: styles, style: style);
  } else {
    give unknown;
  }
  if given >= 0_i32 {
    let border = border_edges(styles: styles, style: style);
    let padding = padding_edges(styles: styles, style: style, basis: 0_i32);
    let frame_border = horizontal(edges: border);
    let frame_padding = horizontal(edges: padding);
    let frame = frame_border +sat frame_padding;
    let (minimum, maximum) = width_limits(styles: styles, style: style, basis: 0_i32, frame: frame);
    let clamped = clamp_size(size: given, minimum: minimum, maximum: maximum);
    let floor = imax(clamped, frame);
    let total = floor +sat around;
    return total, total;
  }
  let low = least +sat around;
  let high = most +sat around;
  return low, high;
}

fn intrinsic_flex(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> (minimum: i32, maximum: i32) reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "The content's min-content and max-content widths of a flex container (CSS Flexbox 9.9.1): in a row, the sum of its items' contributions and the gaps between them for the max-content width and, when it does not wrap, the min-content width, and the largest min-content contribution when it wraps; in a column, the largest contribution.";
  let group = container_of(styles: styles, style: context^.style);
  let row = group.flex_direction < 2_u8;
  let wrapping = group.flex_wrap != 0_u8;
  let main_gap = flex_gap(value: group.column_gap, basis: 0_i32);
  let sum_least = 0_i32;
  let sum_most = 0_i32;
  let big_least = 0_i32;
  let big_most = 0_i32;
  let seen = 0_u64;
  let flow_count = events^.len;
  for (k in 0_u64..flow_count) {
    let flow_bound_297 = events^.len;
    if k >= flow_bound_297 {
      break;
    }
    let piece = events^[k];
    match piece {
      Child(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let (low, high) = flex_contribution(child: &context^.children.inner[at], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, row: row);
          set big_least = imax(big_least, low);
          set big_most = imax(big_most, high);
          let spaced_least = sum_least +sat low;
          let spaced_most = sum_most +sat high;
          if seen > 0_u64 {
            set sum_least = spaced_least +sat main_gap;
            set sum_most = spaced_most +sat main_gap;
          } else {
            set sum_least = spaced_least;
            set sum_most = spaced_most;
          }
          set seen = seen +sat 1_u64;
        }
      }
      Open(..) => {
      }
      Close(..) => {
      }
      Text(..) => {
      }
      Float(..) => {
      }
      Out(..) => {
      }
    }
  }
  if row {
    if wrapping {
      return big_least, sum_most;
    }
    return sum_least, sum_most;
  }
  return big_least, big_most;
}

fn flex_divide(total: i32, parts: i32) -> share: i32 pure {
  doc "total divided by parts, truncated toward zero; zero when parts is not positive.";
  if parts > 0_i32 {
    let made = total / parts;
    return made;
  }
  return 0_i32;
}

fn flex_pick(flip: Bool, first: i32, second: i32) -> chosen: i32 pure {
  doc "second when flip holds, else first.";
  if flip {
    return second;
  }
  return first;
}

fn flex_pick_flag(flip: Bool, first: Bool, second: Bool) -> chosen: Bool pure {
  doc "second when flip holds, else first.";
  if flip {
    return second;
  }
  return first;
}

fn flex_axis_i32(row: Bool, horizontal_value: i32, vertical_value: i32) -> chosen: i32 pure {
  doc "The horizontal value of a row's main axis and a column's cross axis, else the vertical one; callers pass row or its negation.";
  if row {
    return horizontal_value;
  }
  return vertical_value;
}

fn flex_scrolls(styles: &Styles, style: StyleRef, row: Bool) -> scrolling: Bool reads(styles) {
  doc "Whether style's box is a scroll container on the horizontal axis (row) or the vertical one, where overflow other than visible or clip scrolls or hides, which makes an item's automatic minimum size zero (CSS Flexbox 4.5).";
  let boxed = box_of(styles: styles, style: style);
  let overflow = if row {
    give boxed.overflow_x;
  } else {
    give boxed.overflow_y;
  }
  let shown = overflow == overflow_visible;
  let clipped = overflow == overflow_clip;
  let open = bor(shown, clipped);
  let made = bnot(open);
  return made;
}

fn flex_content_height(child: &Context, styles: &Styles) -> height: i32 reads(styles), reads(child) {
  doc "The border-box height an item's content needs, its automatic height, as the lowest bottom edge of its laid-out child contexts (with their bottom margins), paragraphs and block boxes below its paddings and borders, plus them; an approximation that sees no margin collapsing through the item's edges. A column item with a given height needs it for its automatic minimum size, where the laid-out height is the given one.";
  let style = child^.style;
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: child^.space.basis_width);
  let top_frame = border.top +sat padding.top;
  let frame_border = vertical(edges: border);
  let frame_padding = vertical(edges: padding);
  let frame = frame_border +sat frame_padding;
  let bottom = top_frame;
  let children = child^.children.inner.len;
  for (c in 0_u64..children) {
    let geometry_read_1 = child_position(context: child, at: c);
    let below = geometry_read_1.y +sat child^.children.inner[c].height;
    let edge = below +sat child^.children.inner[c].margin_bottom;
    set bottom = imax(bottom, edge);
  }
  let paragraphs = child^.paragraphs.inner.len;
  for (p in 0_u64..paragraphs) {
    let geometry_read_2 = paragraph_position(context: child, at: p);
    let edge = geometry_read_2.y +sat child^.paragraphs.inner[p].height;
    set bottom = imax(bottom, edge);
  }
  let blocks = child^.blocks.inner.len;
  for (b in 0_u64..blocks) {
    let geometry_read_3 = block_position(context: child, at: b);
    let edge = geometry_read_3.y +sat child^.blocks.inner[b].height;
    set bottom = imax(bottom, edge);
  }
  let inner = bottom -sat top_frame;
  let made = inner +sat frame;
  return made;
}

fn flex_prepare(child: &Context, item: &FlexItem, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, setup: FlexBox) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(child), writes(item) {
  doc "Gives one child of a flex container its space and, for a flex item, everything the flex algorithm needs of it before flexing (CSS Flexbox 9.2 and 9.3): its margins, paddings, borders and flex factors in the container's axes, its flex base size from flex-basis, width or height, or its content (in a column by laying it out at its cross size, which is kept as its natural layout), its minimum and maximum main sizes with the automatic minimum of 4.5, its hypothetical main size, its cross limits and its alignment. It reads and writes only this child and this item, so a counted loop runs it for every child.";
  let style = child^.style;
  let width = setup.content_width;
  let yes = True();
  let no = False();
  let row = setup.row;
  let column = bnot(row);
  set child^.space = child_space(available: width, basis_width: width, basis_height: setup.inner_height, shrink: yes);
  if item^.active {
  } else {
    return unit;
  }
  let margins = margin_edges(styles: styles, style: style, basis: width);
  let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: width);
  let border_h = horizontal(edges: border);
  let padding_h = horizontal(edges: padding);
  let frame_h = border_h +sat padding_h;
  let border_v = vertical(edges: border);
  let padding_v = vertical(edges: padding);
  let frame_v = border_v +sat padding_v;
  let frame_main = flex_axis_i32(row: row, horizontal_value: frame_h, vertical_value: frame_v);
  let frame_cross = flex_axis_i32(row: column, horizontal_value: frame_h, vertical_value: frame_v);
  let first_main = flex_axis_i32(row: row, horizontal_value: margins.left, vertical_value: margins.top);
  let second_main = flex_axis_i32(row: row, horizontal_value: margins.right, vertical_value: margins.bottom);
  let first_cross = flex_axis_i32(row: column, horizontal_value: margins.left, vertical_value: margins.top);
  let second_cross = flex_axis_i32(row: column, horizontal_value: margins.right, vertical_value: margins.bottom);
  let main_start = flex_pick(flip: setup.reverse, first: first_main, second: second_main);
  let main_end = flex_pick(flip: setup.reverse, first: second_main, second: first_main);
  let cross_start = flex_pick(flip: setup.wrap_reverse, first: first_cross, second: second_cross);
  let cross_end = flex_pick(flip: setup.wrap_reverse, first: second_cross, second: first_cross);
  let auto_first_main = if row {
    give auto_left;
  } else {
    give auto_top;
  }
  let auto_second_main = if row {
    give auto_right;
  } else {
    give auto_bottom;
  }
  let auto_first_cross = if row {
    give auto_top;
  } else {
    give auto_left;
  }
  let auto_second_cross = if row {
    give auto_bottom;
  } else {
    give auto_right;
  }
  let auto_main_start = flex_pick_flag(flip: setup.reverse, first: auto_first_main, second: auto_second_main);
  let auto_main_end = flex_pick_flag(flip: setup.reverse, first: auto_second_main, second: auto_first_main);
  let auto_cross_start = flex_pick_flag(flip: setup.wrap_reverse, first: auto_first_cross, second: auto_second_cross);
  let auto_cross_end = flex_pick_flag(flip: setup.wrap_reverse, first: auto_second_cross, second: auto_first_cross);
  let sizes = size_of(styles: styles, style: style);
  let group = item_of(styles: styles, style: style);
  let boxed = box_of(styles: styles, style: style);
  let border_box = boxed.box_sizing == box_sizing_border;
  let (min_w, max_w) = width_limits(styles: styles, style: style, basis: width, frame: frame_h);
  let (min_h, max_h) = height_limits(styles: styles, style: style, basis: setup.inner_height, frame: frame_v);
  let spec_w = specified_width(styles: styles, style: style, basis: width, frame: frame_h);
  let spec_h = specified_height(styles: styles, style: style, basis: setup.inner_height, frame: frame_v);
  let main_min = flex_axis_i32(row: row, horizontal_value: min_w, vertical_value: min_h);
  let main_max = flex_axis_i32(row: row, horizontal_value: max_w, vertical_value: max_h);
  let main_spec = flex_axis_i32(row: row, horizontal_value: spec_w, vertical_value: spec_h);
  let cross_min = flex_axis_i32(row: column, horizontal_value: min_w, vertical_value: min_h);
  let cross_max = flex_axis_i32(row: column, horizontal_value: max_w, vertical_value: max_h);
  let cross_spec = flex_axis_i32(row: column, horizontal_value: spec_w, vertical_value: spec_h);
  let cross_auto = cross_spec < 0_i32;
  let min_kind = if row {
    give sizes.min_width.kind;
  } else {
    give sizes.min_height.kind;
  }
  let min_auto = min_kind == sizing_auto;
  let scrolls = flex_scrolls(styles: styles, style: style, row: row);
  let percent_base = flex_axis_i32(row: row, horizontal_value: width, vertical_value: setup.inner_height);
  let declared = group.basis.kind == sizing_value;
  let basis_raw = size_value(value: group.basis, basis: percent_base);
  let basis_known = basis_raw >= 0_i32;
  let basis_given = band(declared, basis_known);
  let basis_box = if basis_given {
    give border_box_from_content(content: basis_raw, border_box_sizing: border_box, frame: frame_main);
  } else {
    give unknown;
  }
  let auto_basis = group.basis.kind == sizing_auto;
  let spec_known = main_spec >= 0_i32;
  let uses_spec = band(auto_basis, spec_known);
  let known = bor(basis_given, uses_spec);
  let known_size = if basis_given {
    give basis_box;
  } else if uses_spec {
    give main_spec;
  } else {
    give unknown;
  }
  let content_base = bnot(known);
  let fixed_size = bnot(scrolls);
  let min_applies = band(min_auto, fixed_size);
  let needs_content = bor(content_base, min_applies);
  let place_wanted = if group.align_self == align_auto {
    give setup.align_items;
  } else {
    give group.align_self;
  }
  let place_normal = if place_wanted == align_normal {
    give align_stretch;
  } else {
    give place_wanted;
  }
  let place_raw = flex_place(value: place_normal, reversed: setup.wrap_reverse);
  let auto_cross = bor(auto_cross_start, auto_cross_end);
  let plain_cross = bnot(auto_cross);
  let stretches = band(cross_auto, plain_cross);
  let place_stretch = if place_raw == flex_at_stretch {
    if stretches {
      give flex_at_stretch;
    } else {
      give flex_at_start;
    }
  } else {
    give place_raw;
  }
  let forward_cross = bnot(setup.wrap_reverse);
  let baseline_ok = band(row, forward_cross);
  let place_base = if place_stretch == flex_at_baseline {
    if baseline_ok {
      give flex_at_baseline;
    } else {
      give flex_at_start;
    }
  } else {
    give place_stretch;
  }
  let place = if place_base > flex_at_baseline {
    give flex_at_start;
  } else {
    give place_base;
  }
  let natural_forced = if column {
    let fills = place == flex_at_stretch;
    let single = bnot(setup.wrapping);
    let direct = band(fills, single);
    if direct {
      let around = margins.left +sat margins.right;
      let room = width -sat around;
      let clamped = clamp_size(size: room, minimum: min_w, maximum: max_w);
      give imax(clamped, frame_h);
    } else {
      give unknown;
    }
  } else {
    give unknown;
  }
  let content_least = 0_i32;
  let content_most = 0_i32;
  let natural_main = unknown;
  if needs_content {
    if row {
      let (least, most) = flex_content_widths(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
      set content_least = least;
      set content_most = most;
    } else {
      set child^.space = Space(available: width, basis_width: width, basis_height: setup.inner_height, forced_width: natural_forced, forced_height: unknown, shrink: yes);
      let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: setup.updating);
      set natural_main = child^.height;
      let content_height = if spec_known {
        give flex_content_height(child: child, styles: styles);
      } else {
        give child^.height;
      }
      set content_least = content_height;
      set content_most = content_height;
    }
  }
  let base_content = if row {
    give content_most;
  } else {
    give natural_main;
  }
  let base_size = if known {
    give known_size;
  } else {
    give base_content;
  }
  let base = imax(base_size, frame_main);
  let capped_content = if main_max >= 0_i32 {
    give imin(content_least, main_max);
  } else {
    give content_least;
  }
  let capped_spec = if main_max >= 0_i32 {
    give imin(main_spec, main_max);
  } else {
    give main_spec;
  }
  let suggestion = if spec_known {
    give imin(capped_content, capped_spec);
  } else {
    give capped_content;
  }
  let minimum_raw = if min_auto {
    if scrolls {
      give 0_i32;
    } else {
      give suggestion;
    }
  } else {
    give imax(main_min, 0_i32);
  }
  let minimum = imax(minimum_raw, frame_main);
  let clamped_base = clamp_size(size: base, minimum: minimum, maximum: main_max);
  let hypothetical = imax(clamped_base, frame_main);
  let grow_factor = cvt::<f32, f64>(group.grow);
  let shrink_factor = cvt::<f32, f64>(group.shrink);
  let made = FlexItem(child: item^.child, active: yes, order: item^.order, main_start: main_start, main_end: main_end, cross_start: cross_start, cross_end: cross_end, auto_main_start: auto_main_start, auto_main_end: auto_main_end, auto_cross_start: auto_cross_start, auto_cross_end: auto_cross_end, frame_main: frame_main, frame_cross: frame_cross, grow: grow_factor, shrink: shrink_factor, base: base, minimum: minimum, maximum: main_max, hypothetical: hypothetical, target: hypothetical, frozen: no, cross_minimum: cross_min, cross_maximum: cross_max, cross_auto: cross_auto, natural_main: natural_main, natural_width: natural_forced, place: place, stretch_to: unknown, cross_size: 0_i32, baseline: 0_i32, main_position: 0_i32, cross_position: 0_i32);
  set item^ = made;
  return unit;
}

fn flex_order_of(items: &Box<Slots<FlexItem>>, at: u64) -> order: i32 reads(items) {
  doc "The order of the item at index at, zero past the end.";
  if at < items^.inner.len {
    let found = items^.inner[at].order;
    return found;
  }
  return 0_i32;
}

fn flex_sort(sequence: &Box<Slots<u64>>, items: &Box<Slots<FlexItem>>) -> result: unit reads(items), writes(sequence) {
  doc "Sorts sequence, the indexes of the flex items in document order, by their order, keeping document order among equals (an insertion sort).";
  let count = sequence^.inner.len;
  for (j in 0_u64..count) {
    if j >= sequence^.inner.len {
      break;
    }
    let key = sequence^.inner[j];
    let key_order = flex_order_of(items: items, at: key);
    let hole = j;
    for (step in 0_u64..j) {
      if hole == 0_u64 {
        break;
      }
      let before = hole - 1_u64;
      if before >= sequence^.inner.len {
        break;
      }
      let previous = sequence^.inner[before];
      let previous_order = flex_order_of(items: items, at: previous);
      let later = previous_order > key_order;
      if later {
        if hole < sequence^.inner.len {
          set sequence^.inner[hole] = previous;
        }
        set hole = before;
      } else {
        break;
      }
    }
    if hole < sequence^.inner.len {
      set sequence^.inner[hole] = key;
    }
  }
  return unit;
}

fn flex_collect(context: &Context, events: &[Flow], styles: &Styles, items: &Box<Slots<FlexItem>>) -> sequence: Box<Slots<u64>> reads(context), reads(events), reads(styles), writes(items) {
  doc "Marks the flex items among the children of context, the ones its flow lists as Child, reads their order and returns their indexes sorted by order, then document order.";
  let sequence = box_slots_new::<u64>(capacity: 8_u64);
  let ordered = False();
  let flow_count = events^.len;
  for (k in 0_u64..flow_count) {
    let flow_bound_699 = events^.len;
    if k >= flow_bound_699 {
      break;
    }
    let piece = events^[k];
    match piece {
      Child(context: c) => {
        let at = cvt::<u32, u64>(c);
        let inside = at < context^.children.inner.len;
        let listed = at < items^.inner.len;
        let usable = band(inside, listed);
        if usable {
          let group = item_of(styles: styles, style: context^.children.inner[at].style);
          set items^.inner[at].active = True();
          set items^.inner[at].order = group.order;
          let moved = group.order != 0_i32;
          set ordered = bor(ordered, moved);
          let pushed = push_item::<u64>(cell: &sequence, value: at, ceiling: item_ceiling);
        }
      }
      Open(..) => {
      }
      Close(..) => {
      }
      Text(..) => {
      }
      Float(..) => {
      }
      Out(..) => {
      }
    }
  }
  if ordered {
    flex_sort(sequence: &sequence, items: items);
  }
  return move sequence;
}

fn flex_gather(items: &Box<Slots<FlexItem>>, sequence: &Box<Slots<u64>>) -> lanes: Box<Slots<FlexItem>> reads(items), reads(sequence) {
  doc "The flex items in sequence's order, copies of their entries of items.";
  let count = sequence^.inner.len;
  let lanes = box_slots_new::<FlexItem>(capacity: 8_u64);
  for (k in 0_u64..count) {
    let at = sequence^.inner[k];
    let found = flex_item_at(entries: items, at: at);
    let pushed = push_item::<FlexItem>(cell: &lanes, value: found, ceiling: item_ceiling);
  }
  return move lanes;
}

fn flex_store(lanes: &Box<Slots<FlexItem>>, items: &Box<Slots<FlexItem>>) -> result: unit reads(lanes), writes(items) {
  doc "Copies every lane back to its entry of items.";
  let count = lanes^.inner.len;
  for (k in 0_u64..count) {
    let lane = lanes^.inner[k];
    if lane.child < items^.inner.len {
      set items^.inner[lane.child] = lane;
    }
  }
  return unit;
}

fn flex_load(items: &Box<Slots<FlexItem>>, lanes: &Box<Slots<FlexItem>>) -> result: unit reads(items), writes(lanes) {
  doc "Copies every lane from its entry of items.";
  let count = lanes^.inner.len;
  for (k in 0_u64..count) {
    if k >= lanes^.inner.len {
      break;
    }
    let at = lanes^.inner[k].child;
    let found = flex_item_at(entries: items, at: at);
    set lanes^.inner[k] = found;
  }
  return unit;
}

fn flex_build_lines(lanes: &Box<Slots<FlexItem>>, wrapping: Bool, available: i32, gap: i32) -> lines: Box<Slots<FlexLine>> reads(lanes) {
  doc "Collects the items into flex lines (CSS Flexbox 9.3): one line when the container does not wrap, else consecutive items while their hypothetical outer main sizes and the gaps between them fit in available, each line holding at least one item.";
  let lines = box_slots_new::<FlexLine>(capacity: 4_u64);
  let count = lanes^.inner.len;
  let first = 0_u64;
  let sum = 0_i32;
  for (k in 0_u64..count) {
    if k >= lanes^.inner.len {
      break;
    }
    let lane = lanes^.inner[k];
    let outer = flex_outer_hypothetical(item: lane);
    let started = k > first;
    let spaced = sum +sat gap;
    let grown = spaced +sat outer;
    let overflows = grown > available;
    let pair = band(wrapping, started);
    let breaks = band(pair, overflows);
    if breaks {
      let closed = FlexLine(first: first, end: k, cross: 0_i32, above: 0_i32, position: 0_i32, main_sum: sum);
      let pushed = push_item::<FlexLine>(cell: &lines, value: closed, ceiling: item_ceiling);
      set first = k;
      set sum = outer;
    } else if started {
      set sum = grown;
    } else {
      set sum = outer;
    }
  }
  if count > 0_u64 {
    let closed = FlexLine(first: first, end: count, cross: 0_i32, above: 0_i32, position: 0_i32, main_sum: sum);
    let pushed = push_item::<FlexLine>(cell: &lines, value: closed, ceiling: item_ceiling);
  }
  return move lines;
}

fn flex_resolve(lanes: &Box<Slots<FlexItem>>, first: u64, end: u64, space: i32, gap: i32) -> result: unit writes(lanes) {
  doc "Resolves the flexible lengths of the items first to end of one line against the container's inner main size space (CSS Flexbox 9.7): freezes the inflexible items, then repeats distributing the remaining free space over the unfrozen items by their flex factors (by their scaled shrink factors when shrinking), clamping each to its minimum and maximum, and freezing the violators of the larger total violation, until all are frozen. It sets each item's target and frozen.";
  let total = lanes^.inner.len;
  if end > total {
    return unit;
  }
  let gaps = 0_i32;
  for (k in first..end) {
    if k > first {
      set gaps = gaps +sat gap;
    }
  }
  let hypothetical_sum = gaps;
  for (k in first..end) {
    if k >= lanes^.inner.len {
      break;
    }
    let outer = flex_outer_hypothetical(item: lanes^.inner[k]);
    set hypothetical_sum = hypothetical_sum +sat outer;
  }
  let growing = hypothetical_sum < space;
  let initial_used = gaps;
  for (k in first..end) {
    if k >= lanes^.inner.len {
      break;
    }
    let lane = lanes^.inner[k];
    let factor = if growing {
      give lane.grow;
    } else {
      give lane.shrink;
    }
    let inflexible = fle(factor, 0.0_f64);
    let base_above = lane.base > lane.hypothetical;
    let base_below = lane.base < lane.hypothetical;
    let shrinking = bnot(growing);
    let grows_past = band(growing, base_above);
    let shrinks_past = band(shrinking, base_below);
    let past = bor(grows_past, shrinks_past);
    let frozen = bor(inflexible, past);
    set lanes^.inner[k].frozen = frozen;
    let chosen = if frozen {
      give lane.hypothetical;
    } else {
      give lane.base;
    }
    set lanes^.inner[k].target = chosen;
    let with_start = chosen +sat lane.main_start;
    let outer = with_start +sat lane.main_end;
    set initial_used = initial_used +sat outer;
  }
  let initial_free = space -sat initial_used;
  let wide_initial = cvt::<i32, f64>(initial_free);
  let rounds = end -sat first;
  for (round in 0_u64..rounds) {
    let used = gaps;
    let factors = 0.0_f64;
    let scaled = 0.0_f64;
    let open = 0_u64;
    for (k in first..end) {
      if k >= lanes^.inner.len {
        break;
      }
      let lane = lanes^.inner[k];
      let size = if lane.frozen {
        give lane.target;
      } else {
        give lane.base;
      }
      let with_start = size +sat lane.main_start;
      let outer = with_start +sat lane.main_end;
      set used = used +sat outer;
      if lane.frozen {
      } else {
        let factor = if growing {
          give lane.grow;
        } else {
          give lane.shrink;
        }
        set factors = fadd.strict(factors, factor);
        let inner_base = lane.base -sat lane.frame_main;
        let wide_base = cvt::<i32, f64>(inner_base);
        let weight = fmul.strict(lane.shrink, wide_base);
        set scaled = fadd.strict(scaled, weight);
        set open = open +sat 1_u64;
      }
    }
    if open == 0_u64 {
      break;
    }
    let remaining = space -sat used;
    let below_one = flt(factors, 1.0_f64);
    let remaining_free = if below_one {
      let proportional = fmul.strict(wide_initial, factors);
      let rounded = flex_round(value: proportional);
      let rounded_size = iabs.wrap(rounded);
      let remaining_size = iabs.wrap(remaining);
      let smaller = rounded_size < remaining_size;
      if smaller {
        give rounded;
      } else {
        give remaining;
      }
    } else {
      give remaining;
    }
    let wide_free = cvt::<i32, f64>(remaining_free);
    let violation = 0_i32;
    for (k in first..end) {
      if k >= lanes^.inner.len {
        break;
      }
      let lane = lanes^.inner[k];
      if lane.frozen {
      } else {
        let extra = if growing {
          let positive = remaining_free > 0_i32;
          let weighted = fgt(factors, 0.0_f64);
          let share_ok = band(positive, weighted);
          if share_ok {
            let product = fmul.strict(wide_free, lane.grow);
            let part = fdiv.strict(product, factors);
            give flex_round(value: part);
          } else {
            give 0_i32;
          }
        } else {
          let negative = remaining_free < 0_i32;
          let weighted = fgt(scaled, 0.0_f64);
          let share_ok = band(negative, weighted);
          if share_ok {
            let inner_base = lane.base -sat lane.frame_main;
            let wide_base = cvt::<i32, f64>(inner_base);
            let weight = fmul.strict(lane.shrink, wide_base);
            let product = fmul.strict(wide_free, weight);
            let part = fdiv.strict(product, scaled);
            give flex_round(value: part);
          } else {
            give 0_i32;
          }
        }
        let wanted = lane.base +sat extra;
        let capped = clamp_size(size: wanted, minimum: lane.minimum, maximum: lane.maximum);
        let floored = imax(capped, lane.frame_main);
        set lanes^.inner[k].target = wanted;
        set violation = violation +sat floored;
        set violation = violation -sat wanted;
      }
    }
    for (k in first..end) {
      if k >= lanes^.inner.len {
        break;
      }
      let lane = lanes^.inner[k];
      if lane.frozen {
      } else {
        let capped = clamp_size(size: lane.target, minimum: lane.minimum, maximum: lane.maximum);
        let floored = imax(capped, lane.frame_main);
        let moved = floored -sat lane.target;
        let none = violation == 0_i32;
        let net_up = violation > 0_i32;
        let net_down = violation < 0_i32;
        let moved_up = moved > 0_i32;
        let moved_down = moved < 0_i32;
        let up = band(net_up, moved_up);
        let down = band(net_down, moved_down);
        let either = bor(up, down);
        let freeze = bor(none, either);
        if freeze {
          set lanes^.inner[k].target = floored;
          set lanes^.inner[k].frozen = True();
        }
      }
    }
  }
  return unit;
}

fn flex_align_main(lanes: &Box<Slots<FlexItem>>, first: u64, end: u64, space: i32, gap: i32, justify: u8) -> result: unit writes(lanes) {
  doc "Places the items first to end of one flex line along the main axis (CSS Flexbox 9.5): free space goes to the auto margins when there are any and it is positive, else it is distributed as justify (a flex_at constant) says, where negative free space makes the space distributions start-aligned. It sets each item's main_position, the offset of its border box from the content box's start edge.";
  let total = lanes^.inner.len;
  if end > total {
    return unit;
  }
  let used = 0_i32;
  let items = 0_i32;
  let autos = 0_i32;
  for (k in first..end) {
    if k >= lanes^.inner.len {
      break;
    }
    let lane = lanes^.inner[k];
    let with_start = lane.target +sat lane.main_start;
    let outer = with_start +sat lane.main_end;
    set used = used +sat outer;
    if items > 0_i32 {
      set used = used +sat gap;
    }
    set items = items +sat 1_i32;
    if lane.auto_main_start {
      set autos = autos +sat 1_i32;
    }
    if lane.auto_main_end {
      set autos = autos +sat 1_i32;
    }
  }
  let free = space -sat used;
  let positive = free > 0_i32;
  let has_autos = autos > 0_i32;
  let shares_autos = band(positive, has_autos);
  let share = if shares_autos {
    give flex_divide(total: free, parts: autos);
  } else {
    give 0_i32;
  }
  let offset = 0_i32;
  let between = 0_i32;
  if shares_autos {
  } else if justify == flex_at_end {
    set offset = free;
  } else if justify == flex_at_center {
    set offset = free / 2_i32;
  } else if positive {
    if justify == flex_at_between {
      let slots = items -sat 1_i32;
      set between = flex_divide(total: free, parts: slots);
    } else if justify == flex_at_around {
      let slice = flex_divide(total: free, parts: items);
      set between = slice;
      set offset = slice / 2_i32;
    } else if justify == flex_at_evenly {
      let slots = items +sat 1_i32;
      let slice = flex_divide(total: free, parts: slots);
      set between = slice;
      set offset = slice;
    }
  }
  let cursor = offset;
  let seen = 0_i32;
  for (k in first..end) {
    if k >= lanes^.inner.len {
      break;
    }
    let lane = lanes^.inner[k];
    if seen > 0_i32 {
      set cursor = cursor +sat gap;
      set cursor = cursor +sat between;
    }
    let start_extra = if lane.auto_main_start {
      give share;
    } else {
      give 0_i32;
    }
    let end_extra = if lane.auto_main_end {
      give share;
    } else {
      give 0_i32;
    }
    let before = lane.main_start +sat start_extra;
    let after = lane.main_end +sat end_extra;
    set cursor = cursor +sat before;
    set lanes^.inner[k].main_position = cursor;
    set lanes^.inner[k].main_start = before;
    set lanes^.inner[k].main_end = after;
    set cursor = cursor +sat lane.target;
    set cursor = cursor +sat after;
    set seen = seen +sat 1_i32;
  }
  return unit;
}

fn flex_line_cross(lanes: &Box<Slots<FlexItem>>, first: u64, end: u64) -> (cross: i32, above: i32) reads(lanes) {
  doc "The cross size of the line of the items first to end: the largest outer cross size, where the items aligned to baselines count as one group whose size is the largest distance above their shared baseline plus the largest below it; and that largest distance above the baseline.";
  let total = lanes^.inner.len;
  if end > total {
    return 0_i32, 0_i32;
  }
  let best = 0_i32;
  let above = 0_i32;
  let below = 0_i32;
  for (k in first..end) {
    if k >= lanes^.inner.len {
      break;
    }
    let lane = lanes^.inner[k];
    let with_start = lane.cross_size +sat lane.cross_start;
    let outer = with_start +sat lane.cross_end;
    if lane.place == flex_at_baseline {
      let up = lane.cross_start +sat lane.baseline;
      let down = outer -sat up;
      set above = imax(above, up);
      set below = imax(below, down);
    } else {
      set best = imax(best, outer);
    }
  }
  let group = above +sat below;
  let made = imax(best, group);
  return made, above;
}

fn flex_align_cross(lanes: &Box<Slots<FlexItem>>, first: u64, end: u64, line_cross: i32, line_position: i32, above: i32) -> result: unit writes(lanes) {
  doc "Places the items first to end of one flex line of cross size line_cross at line_position along the cross axis (CSS Flexbox 9.6): auto cross margins take the free space, else each item sits at the start, at the end, in the middle, on the baseline shared by the items aligned to baselines, or stretched to the line (stretch_to, its auto cross size less its margins within its limits). It sets each item's cross_position and stretch_to.";
  let total = lanes^.inner.len;
  if end > total {
    return unit;
  }
  for (k in first..end) {
    if k >= lanes^.inner.len {
      break;
    }
    let lane = lanes^.inner[k];
    let with_start = lane.cross_size +sat lane.cross_start;
    let outer = with_start +sat lane.cross_end;
    let free = line_cross -sat outer;
    let automatic = bor(lane.auto_cross_start, lane.auto_cross_end);
    if automatic {
      let positive = free > 0_i32;
      let start_extra = if positive {
        if lane.auto_cross_end {
          if lane.auto_cross_start {
            give free / 2_i32;
          } else {
            give 0_i32;
          }
        } else {
          give free;
        }
      } else {
        give 0_i32;
      }
      let before = lane.cross_start +sat start_extra;
      set lanes^.inner[k].cross_start = before;
      set lanes^.inner[k].cross_position = line_position +sat before;
      set lanes^.inner[k].stretch_to = unknown;
    } else if lane.place == flex_at_stretch {
      let room_start = line_cross -sat lane.cross_start;
      let room = room_start -sat lane.cross_end;
      let clamped = clamp_size(size: room, minimum: lane.cross_minimum, maximum: lane.cross_maximum);
      let floored = imax(clamped, lane.frame_cross);
      set lanes^.inner[k].stretch_to = floored;
      set lanes^.inner[k].cross_position = line_position +sat lane.cross_start;
    } else if lane.place == flex_at_end {
      let from_end = line_cross -sat lane.cross_end;
      let start = from_end -sat lane.cross_size;
      set lanes^.inner[k].cross_position = line_position +sat start;
      set lanes^.inner[k].stretch_to = unknown;
    } else if lane.place == flex_at_center {
      let half = free / 2_i32;
      let start = lane.cross_start +sat half;
      set lanes^.inner[k].cross_position = line_position +sat start;
      set lanes^.inner[k].stretch_to = unknown;
    } else if lane.place == flex_at_baseline {
      let start = above -sat lane.baseline;
      set lanes^.inner[k].cross_position = line_position +sat start;
      set lanes^.inner[k].stretch_to = unknown;
    } else {
      set lanes^.inner[k].cross_position = line_position +sat lane.cross_start;
      set lanes^.inner[k].stretch_to = unknown;
    }
  }
  return unit;
}

fn flex_place_lines(lines: &Box<Slots<FlexLine>>, wrapping: Bool, cross_size: i32, gap: i32, content: u8) -> result: unit writes(lines) {
  doc "Gives each flex line its cross size and its offset along the cross axis in a container whose inner cross size is cross_size (CSS Flexbox 9.4 and 9.6): the only line of a container that does not wrap fills it; for a container that wraps, positive free space is distributed by align-content (a flex_at constant: stretch grows every line equally) and negative free space starts the lines at the start edge, with gap between lines.";
  let count = lines^.inner.len;
  if count == 0_u64 {
    return unit;
  }
  if wrapping {
  } else {
    set lines^.inner[0_u64].cross = cross_size;
    set lines^.inner[0_u64].position = 0_i32;
    return unit;
  }
  let used = 0_i32;
  let number = 0_i32;
  for (l in 0_u64..count) {
    if l >= lines^.inner.len {
      break;
    }
    if number > 0_i32 {
      set used = used +sat gap;
    }
    set used = used +sat lines^.inner[l].cross;
    set number = number +sat 1_i32;
  }
  let free = cross_size -sat used;
  let positive = free > 0_i32;
  let grow_each = if positive {
    if content == flex_at_stretch {
      give flex_divide(total: free, parts: number);
    } else {
      give 0_i32;
    }
  } else {
    give 0_i32;
  }
  let offset = 0_i32;
  let between = 0_i32;
  if content == flex_at_end {
    set offset = free;
  } else if content == flex_at_center {
    set offset = free / 2_i32;
  } else if positive {
    if content == flex_at_between {
      let slots = number -sat 1_i32;
      set between = flex_divide(total: free, parts: slots);
    } else if content == flex_at_around {
      let slice = flex_divide(total: free, parts: number);
      set between = slice;
      set offset = slice / 2_i32;
    } else if content == flex_at_evenly {
      let slots = number +sat 1_i32;
      let slice = flex_divide(total: free, parts: slots);
      set between = slice;
      set offset = slice;
    }
  }
  let cursor = offset;
  for (l in 0_u64..count) {
    if l >= lines^.inner.len {
      break;
    }
    let size = lines^.inner[l].cross +sat grow_each;
    set lines^.inner[l].cross = size;
    set lines^.inner[l].position = cursor;
    set cursor = cursor +sat size;
    set cursor = cursor +sat gap;
    set cursor = cursor +sat between;
  }
  return unit;
}

fn flex_final(child: &Context, item: &FlexItem, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, setup: FlexBox) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(child), writes(item) {
  doc "Lays out one child at its final main size: a flex item at its target (a row's item at its width target, a column's item at its height target unless its natural layout already has that height) with its cross size its own; an absolutely positioned child in the space it was given, unless the update defers it to position_out_with (deferred_out). A flex item's cross size and baseline are recorded. It reads and writes only this child and this item.";
  if item^.active {
  } else {
    let deferred = deferred_out(child: child, styles: styles, updating: setup.updating);
    if deferred {
      resolve_margins(child: child, styles: styles);
    } else {
      let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: setup.updating);
    }
    return unit;
  }
  let width = setup.content_width;
  let no = False();
  let yes = True();
  if setup.row {
    let space = Space(available: width, basis_width: width, basis_height: setup.inner_height, forced_width: item^.target, forced_height: unknown, shrink: no);
    set child^.space = space;
    let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: setup.updating);
  } else if item^.target != item^.natural_main {
    let space = Space(available: width, basis_width: width, basis_height: setup.inner_height, forced_width: item^.natural_width, forced_height: item^.target, shrink: yes);
    set child^.space = space;
    let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: setup.updating);
  }
  let cross = if setup.row {
    give child^.height;
  } else {
    give child^.width;
  }
  set item^.cross_size = cross;
  let baseline = if child^.has_baseline {
    give child^.baseline;
  } else {
    give child^.height;
  }
  set item^.baseline = baseline;
  return unit;
}

fn flex_stretch(child: &Context, item: &FlexItem, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, setup: FlexBox) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(child), writes(item) {
  doc "Lays a stretched flex item out again at the cross size its line gives it, when that differs from the cross size it has, keeping its main size. It reads and writes only this child and this item.";
  if item^.active {
  } else {
    return unit;
  }
  let wanted = item^.stretch_to;
  if wanted < 0_i32 {
    return unit;
  }
  let width = setup.content_width;
  let no = False();
  if setup.row {
    if child^.height != wanted {
      let space = Space(available: width, basis_width: width, basis_height: setup.inner_height, forced_width: item^.target, forced_height: wanted, shrink: no);
      set child^.space = space;
      let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: setup.updating);
    }
  } else if child^.width != wanted {
    let space = Space(available: width, basis_width: width, basis_height: setup.inner_height, forced_width: wanted, forced_height: item^.target, shrink: no);
    set child^.space = space;
    let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: setup.updating);
  }
  let cross = if setup.row {
    give child^.height;
  } else {
    give child^.width;
  }
  set item^.cross_size = cross;
  let baseline = if child^.has_baseline {
    give child^.baseline;
  } else {
    give child^.height;
  }
  set item^.baseline = baseline;
  return unit;
}

fn flex_shift(styles: &Styles, style: StyleRef, basis_width: i32, basis_height: i32) -> shift: FlexOffset reads(styles) {
  doc "The offset position: relative gives a box.";
  let (dx, dy) = relative_offset(styles: styles, style: style, basis_width: basis_width, basis_height: basis_height);
  return FlexOffset(dx: dx, dy: dy);
}

fn flex_static(child: &Context, styles: &Styles, setup: FlexBox, main_total: i32, cross_total: i32) -> spot: FlexOffset reads(styles), reads(child) {
  doc "The static position of an absolutely positioned child of a flex container (CSS Flexbox 4.1): where its margin box would sit as the only flex item, justified along the main axis by justify-content and aligned along the cross axis by its align-self, as the offset of its border box from the content box's origin.";
  let group = item_of(styles: styles, style: child^.style);
  let wanted = if group.align_self == align_auto {
    give setup.align_items;
  } else {
    give group.align_self;
  }
  let place_cross = flex_place(value: wanted, reversed: setup.wrap_reverse);
  let main_size = if setup.row {
    give child^.width;
  } else {
    give child^.height;
  }
  let cross_size = if setup.row {
    give child^.height;
  } else {
    give child^.width;
  }
  let margin_across = child^.margin_left +sat child^.margin_right;
  let margin_down = child^.margin_top +sat child^.margin_bottom;
  let main_margins = flex_axis_i32(row: setup.row, horizontal_value: margin_across, vertical_value: margin_down);
  let cross_margins = flex_axis_i32(row: setup.row, horizontal_value: margin_down, vertical_value: margin_across);
  let main_used = main_size +sat main_margins;
  let cross_used = cross_size +sat cross_margins;
  let main_free = main_total -sat main_used;
  let cross_free = cross_total -sat cross_used;
  let main_logical = if setup.justify_content == flex_at_end {
    give main_free;
  } else if setup.justify_content == flex_at_center {
    give main_free / 2_i32;
  } else {
    give 0_i32;
  }
  let cross_logical = if place_cross == flex_at_end {
    give cross_free;
  } else if place_cross == flex_at_center {
    give cross_free / 2_i32;
  } else {
    give 0_i32;
  }
  let main_mirrored = main_free -sat main_logical;
  let cross_mirrored = cross_free -sat cross_logical;
  let main_offset = flex_pick(flip: setup.reverse, first: main_logical, second: main_mirrored);
  let cross_offset = flex_pick(flip: setup.wrap_reverse, first: cross_logical, second: cross_mirrored);
  let across = flex_axis_i32(row: setup.row, horizontal_value: main_offset, vertical_value: cross_offset);
  let down = flex_axis_i32(row: setup.row, horizontal_value: cross_offset, vertical_value: main_offset);
  let dx = across +sat child^.margin_left;
  let dy = down +sat child^.margin_top;
  return FlexOffset(dx: dx, dy: dy);
}

fn flex_position(child: &Context, item: &FlexItem, styles: &Styles, setup: FlexBox, content_left: i32, content_top: i32, main_total: i32, cross_total: i32) -> result: unit reads(styles), reads(item), writes(child) {
  doc "Sets the offset of one child's border box from the container's border box: a flex item at its main and cross positions, mirrored along an axis that runs against the writing direction and moved by its relative offset; an absolutely positioned child at the content box's origin, its static position. It reads and writes only this child and this item.";
  if item^.active {
  } else {
    let spot = flex_static(child: child, styles: styles, setup: setup, main_total: main_total, cross_total: cross_total);
    set child^.normal_x = content_left +sat spot.dx;
    set child^.x = content_left +sat spot.dx;
    set child^.normal_y = content_top +sat spot.dy;
    set child^.y = content_top +sat spot.dy;
    return unit;
  }
  let main_size = if setup.row {
    give child^.width;
  } else {
    give child^.height;
  }
  let cross_size = if setup.row {
    give child^.height;
  } else {
    give child^.width;
  }
  let main_end = item^.main_position +sat main_size;
  let main_mirrored = main_total -sat main_end;
  let main_offset = flex_pick(flip: setup.reverse, first: item^.main_position, second: main_mirrored);
  let cross_end = item^.cross_position +sat cross_size;
  let cross_mirrored = cross_total -sat cross_end;
  let cross_offset = flex_pick(flip: setup.wrap_reverse, first: item^.cross_position, second: cross_mirrored);
  let across = flex_axis_i32(row: setup.row, horizontal_value: main_offset, vertical_value: cross_offset);
  let down = flex_axis_i32(row: setup.row, horizontal_value: cross_offset, vertical_value: main_offset);
  let shift = flex_shift(styles: styles, style: child^.style, basis_width: setup.content_width, basis_height: setup.inner_height);
  let left = content_left +sat across;
  let top = content_top +sat down;
  set child^.normal_x = left;
  set child^.x = left +sat shift.dx;
  set child^.normal_y = top;
  set child^.y = top +sat shift.dy;
  return unit;
}

fn lay_out_flex(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out a flex container (CSS Flexbox 9): its width, then every flex item's flex base size and hypothetical main size in a counted loop whose iterations each write only their own child and item, the items sorted by order and collected into lines, each line's flexible lengths resolved and its items aligned along the main axis, every child laid out at its final main size in a second counted loop, the lines' cross sizes, alignment and stretch, the stretched items laid out again in a third, every child's offset set in a fourth, then the container's height and baseline and its absolutely positioned children. The sequential passes walk the items in order, which the freeze loop and the line breaking need.";
  let width = used_width(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set context^.width = width;
  let style = context^.style;
  let basis = context^.space.basis_width;
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: basis);
  let content_left = border.left +sat padding.left;
  let content_top = border.top +sat padding.top;
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let inner = width -sat frame;
  let content_width = imax(inner, 0_i32);
  let frame_vertical_border = vertical(edges: border);
  let frame_vertical_padding = vertical(edges: padding);
  let frame_vertical = frame_vertical_border +sat frame_vertical_padding;
  let forced = context^.space.forced_height;
  let specified = specified_height(styles: styles, style: style, basis: context^.space.basis_height, frame: frame_vertical);
  let forced_known = forced >= 0_i32;
  let specified_known = specified >= 0_i32;
  let definite = bor(forced_known, specified_known);
  let inner_height = if definite {
    let used_definite = used_height(context: context, styles: styles, content: 0_i32);
    let room = used_definite -sat frame_vertical;
    give imax(room, 0_i32);
  } else {
    give unknown;
  }
  let (min_height_box, max_height_box) = height_limits(styles: styles, style: style, basis: context^.space.basis_height, frame: frame_vertical);
  let group = container_of(styles: styles, style: style);
  let direction = group.flex_direction;
  let row = direction < 2_u8;
  let reverse_row = direction == 1_u8;
  let reverse_column = direction == 3_u8;
  let reverse = bor(reverse_row, reverse_column);
  let wrapping = group.flex_wrap != 0_u8;
  let wrap_reverse = group.flex_wrap == 2_u8;
  let column_gap = flex_gap(value: group.column_gap, basis: content_width);
  let row_gap = flex_gap(value: group.row_gap, basis: inner_height);
  let main_gap = if row {
    give column_gap;
  } else {
    give row_gap;
  }
  let cross_gap = if row {
    give row_gap;
  } else {
    give column_gap;
  }
  let justify = flex_place(value: group.justify_content, reversed: reverse);
  let content_value = if group.align_content == align_normal {
    give align_stretch;
  } else {
    give group.align_content;
  }
  let content_place = flex_place(value: content_value, reversed: wrap_reverse);
  let setup = FlexBox(row: row, reverse: reverse, wrapping: wrapping, wrap_reverse: wrap_reverse, content_width: content_width, inner_height: inner_height, main_gap: main_gap, cross_gap: cross_gap, align_items: group.align_items, justify_content: justify, align_content: content_place, updating: context^.dirty);
  let count = context^.children.inner.len;
  let items = box_slots_new::<FlexItem>(capacity: 8_u64);
  for (i in 0_u64..count) {
    let blank = flex_blank_item();
    set blank.child = i;
    let pushed = push_item::<FlexItem>(cell: &items, value: blank, ceiling: item_ceiling);
  }
  let sequence = flex_collect(context: context, events: events, styles: styles, items: &items);
  let prepared = count <= items.inner.len;
  if prepared {
    for (i in 0_u64..count) {
      flex_prepare(child: &context^.children.inner[i], item: &items.inner[i], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, setup: setup);
    }
  }
  let lanes = flex_gather(items: &items, sequence: &sequence);
  let column_room = if definite {
    give inner_height;
  } else if wrapping {
    if max_height_box >= 0_i32 {
      let room = max_height_box -sat frame_vertical;
      give imax(room, 0_i32);
    } else {
      give flex_infinite;
    }
  } else {
    give flex_infinite;
  }
  let available = if row {
    give content_width;
  } else {
    give column_room;
  }
  let lines = flex_build_lines(lanes: &lanes, wrapping: wrapping, available: available, gap: main_gap);
  let line_count = lines.inner.len;
  let widest = 0_i32;
  for (l in 0_u64..line_count) {
    if l >= lines.inner.len {
      break;
    }
    set widest = imax(widest, lines.inner[l].main_sum);
  }
  let main_inner = if row {
    give content_width;
  } else if definite {
    give inner_height;
  } else {
    let used_main = used_height(context: context, styles: styles, content: widest);
    let room = used_main -sat frame_vertical;
    give imax(room, 0_i32);
  }
  for (l in 0_u64..line_count) {
    if l >= lines.inner.len {
      break;
    }
    let first = lines.inner[l].first;
    let end = lines.inner[l].end;
    flex_resolve(lanes: &lanes, first: first, end: end, space: main_inner, gap: main_gap);
    flex_align_main(lanes: &lanes, first: first, end: end, space: main_inner, gap: main_gap, justify: justify);
  }
  flex_store(lanes: &lanes, items: &items);
  let ready_final = count <= items.inner.len;
  if ready_final {
    for (i in 0_u64..count) {
      flex_final(child: &context^.children.inner[i], item: &items.inner[i], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, setup: setup);
    }
  }
  flex_load(items: &items, lanes: &lanes);
  let natural_cross = 0_i32;
  for (l in 0_u64..line_count) {
    if l >= lines.inner.len {
      break;
    }
    let first = lines.inner[l].first;
    let end = lines.inner[l].end;
    let (cross, above) = flex_line_cross(lanes: &lanes, first: first, end: end);
    set lines.inner[l].cross = cross;
    set lines.inner[l].above = above;
    if l > 0_u64 {
      set natural_cross = natural_cross +sat cross_gap;
    }
    set natural_cross = natural_cross +sat cross;
  }
  let used = if row {
    give used_height(context: context, styles: styles, content: natural_cross);
  } else {
    give used_height(context: context, styles: styles, content: main_inner);
  }
  set context^.height = used;
  let used_inner = used -sat frame_vertical;
  let cross_inner = if row {
    give imax(used_inner, 0_i32);
  } else {
    give content_width;
  }
  flex_place_lines(lines: &lines, wrapping: wrapping, cross_size: cross_inner, gap: cross_gap, content: content_place);
  for (l in 0_u64..line_count) {
    if l >= lines.inner.len {
      break;
    }
    let first = lines.inner[l].first;
    let end = lines.inner[l].end;
    let line_cross = lines.inner[l].cross;
    let line_position = lines.inner[l].position;
    let line_above = lines.inner[l].above;
    flex_align_cross(lanes: &lanes, first: first, end: end, line_cross: line_cross, line_position: line_position, above: line_above);
  }
  flex_store(lanes: &lanes, items: &items);
  let ready_stretch = count <= items.inner.len;
  if ready_stretch {
    for (i in 0_u64..count) {
      flex_stretch(child: &context^.children.inner[i], item: &items.inner[i], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, setup: setup);
    }
  }
  let ready_place = count <= items.inner.len;
  if ready_place {
    for (i in 0_u64..count) {
      flex_position(child: &context^.children.inner[i], item: &items.inner[i], styles: styles, setup: setup, content_left: content_left, content_top: content_top, main_total: main_inner, cross_total: cross_inner);
    }
  }
  set context^.has_baseline = False();
  if sequence.inner.len > 0_u64 {
    let first_child = sequence.inner[0_u64];
    if first_child < context^.children.inner.len {
      if first_child < items.inner.len {
        let geometry_read_4 = child_position(context: context, at: first_child);
        let top = geometry_read_4.y;
        let shown = top +sat items.inner[first_child].baseline;
        set context^.baseline = shown;
        set context^.has_baseline = True();
      }
    }
  }
  let positioned_counts = position_out(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  add_own_fragment(context: context);
  return unit;
}
