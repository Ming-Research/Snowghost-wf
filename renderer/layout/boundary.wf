alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;

fn no_boundary_visits() -> made: BoundaryVisits pure {
  doc "Empty physical-work counters for one attempted boundary update.";
  let empty = BoundaryVisits(entries: 0_u64, blocks: 0_u64, indexes: 0_u64, fallbacks: 0_u64, reason: 0_u32);
  return empty;
}

fn add_boundary_visits(first: BoundaryVisits, second: BoundaryVisits) -> made: BoundaryVisits pure {
  doc "Combines physical work from contexts actually updated, without inspecting unmarked contexts or retaining stale counts from earlier edits.";
  let entries = first.entries +sat second.entries;
  let blocks = first.blocks +sat second.blocks;
  let indexes = first.indexes +sat second.indexes;
  let fallbacks = first.fallbacks +sat second.fallbacks;
  let reason = imax(first.reason, second.reason);
  let total = BoundaryVisits(entries: entries, blocks: blocks, indexes: indexes, fallbacks: fallbacks, reason: reason);
  return total;
}

fn empty_block_output() -> made: BlockOutput pure {
  doc "An unpublished block boundary cannot authorize a cutoff.";
  let no = False();
  let empty = BlockOutput(valid: no, width: 0_i32, height: 0_i32, available: 0_i32, content_width: 0_i32, basis_height: -1_i32, top_frame: 0_i32, bottom_frame: 0_i32, margin_top: 0_i32, margin_bottom: 0_i32, reads_floats: no, fragment_source: no, own_barriers: 0_u32, own_free: no, extra_travel: 0_i64, offset: 0_i64, natural: 9223372036854775807_i64, motion_known: no);
  return empty;
}

fn travel_absolute(value: i64) -> magnitude: i64 pure {
  doc "Absolute magnitude for the bounded i32-derived terms and i64 certificate sums.";
  let opposite = 0_i64 -sat value;
  let magnitude = imax(value, opposite);
  return magnitude;
}

fn transfer_fits(origin: i64, travel: i64) -> fits: Bool pure {
  doc "Certifies every counted reference intermediate and old/new difference within the symmetric i32 range. Positive saturation of the certificate rejects; it never wraps into admission.";
  let magnitude = travel_absolute(value: origin);
  let bound = magnitude +sat travel;
  let fits = bound <= 2147483647_i64;
  return fits;
}

fn margin_output(margin: i32) -> made: SequenceOutput pure {
  doc "One unresolved edge; two extrema are retained even when their sum is zero.";
  let output = empty_output();
  set output.count = 1_u64;
  let boundary_value_1 = imax(margin, 0_i32);
  set output.leading_positive = boundary_value_1;
  let boundary_value_2 = imin(margin, 0_i32);
  set output.leading_negative = boundary_value_2;
  let wide = cvt::<i32, i64>(margin);
  let opposite = 0_i64 -sat wide;
  let boundary_value_3 = imax(wide, opposite);
  set output.travel = boundary_value_3;
  return output;
}

fn solid_output(height: i32) -> made: SequenceOutput pure {
  doc "A resolved separator with no external margin.";
  let output = margin_output(margin: 0_i32);
  set output.through = False();
  set output.fragment_first = 1_u8;
  set output.fragment_last = 1_u8;
  let wide = cvt::<i32, i64>(height);
  set output.advance = wide;
  let opposite = 0_i64 -sat wide;
  let boundary_value_4 = imax(wide, opposite);
  set output.travel = boundary_value_4;
  return output;
}

fn baseline_travel(output: &SequenceOutput) -> bound: i64 reads(output) {
  doc "Includes exposed baseline excursions in the exact-arithmetic bound, even when an explicit child height is smaller than its overflowing content.";
  let first_opposite = 0_i64 -sat output^.first_baseline;
  let last_opposite = 0_i64 -sat output^.last_baseline;
  let first = imax(output^.first_baseline, first_opposite);
  let last = imax(output^.last_baseline, last_opposite);
  let excursion = first +sat last;
  let bound = output^.travel +sat excursion;
  return bound;
}

fn paragraph_output(paragraph: &Paragraph) -> made: SequenceOutput reads(paragraph) {
  doc "The paragraph's transfer and first/last baseline offsets; a lineless paragraph contributes the identity strut but remains a live entry.";
  let output = margin_output(margin: 0_i32);
  set output.events = 1_u64;
  set output.motion_known = False();
  set output.min_content = paragraph^.min_content;
  set output.max_content = paragraph^.max_content;
  if paragraph^.empty_fragment {
    set output.fragment_sources = 1_u64;
  }
  let count = paragraph^.lines.inner.len;
  if count > 0_u64 {
    set output.through = False();
    set output.fragment_first = 1_u8;
    set output.fragment_last = 1_u8;
    let boundary_value_5 = cvt::<i32, i64>(paragraph^.height);
    set output.advance = boundary_value_5;
    let height_travel = travel_absolute(value: output.advance);
    set output.travel = height_travel;
    let handle = EntryHandle(owner: paragraph^.block, slot: paragraph^.entry_slot);
    set output.first_line = handle;
    set output.last_line = handle;
    let last = count - 1_u64;
    let first_line = paragraph^.lines.inner[0_u64];
    let last_line = paragraph^.lines.inner[last];
    let first_top = cvt::<i32, i64>(first_line.top);
    let first_base = cvt::<i32, i64>(first_line.baseline);
    let last_top = cvt::<i32, i64>(last_line.top);
    let last_base = cvt::<i32, i64>(last_line.baseline);
    set output.first_baseline = first_top +sat first_base;
    set output.last_baseline = last_top +sat last_base;
    let first_top_travel = travel_absolute(value: first_top);
    let first_base_travel = travel_absolute(value: first_base);
    let last_top_travel = travel_absolute(value: last_top);
    let last_base_travel = travel_absolute(value: last_base);
    let first_travel = first_top_travel +sat first_base_travel;
    let last_travel = last_top_travel +sat last_base_travel;
    let excursions = first_travel +sat last_travel;
    set output.travel = output.travel +sat excursions;
  }
  if paragraph^.beside {
    set output.ordinary = False();
    set output.barriers = 1_u32;
  }
  if paragraph^.atomics.inner.len > 0_u64 {
    set output.ordinary = False();
    set output.barriers = 5_u32;
  }
  return output;
}

fn lift_block_output(inside: &SequenceOutput, measured: BlockOutput) -> made: SequenceOutput reads(inside) {
  doc "Lifts ordinary Open/Close edges: top padding settles the leading strut and bottom padding settles the trailing strut. Unframed empty boxes remain Through. Height constraints and marker-created lines are rejected by the publisher.";
  let leading = margin_output(margin: measured.margin_top);
  let opened = leading;
  if measured.top_frame > 0_i32 {
    let top = solid_output(height: measured.top_frame);
    let boundary_value_6 = join_output(left: &leading, right: &top);
    set opened = boundary_value_6;
  }
  let content = join_output(left: &opened, right: inside);
  let closed = content;
  if measured.bottom_frame > 0_i32 {
    let bottom = solid_output(height: measured.bottom_frame);
    let boundary_value_7 = join_output(left: &content, right: &bottom);
    set closed = boundary_value_7;
  }
  let trailing = margin_output(margin: measured.margin_bottom);
  let output = join_output(left: &closed, right: &trailing);
  set output.count = 1_u64;
  set output.events = inside^.events +sat 2_u64;
  if measured.fragment_source {
    set output.fragment_sources = inside^.fragment_sources +sat 1_u64;
    set output.fragment_first = 2_u8;
    set output.fragment_last = 2_u8;
  } else if output.through {
    set output.fragment_first = 0_u8;
    set output.fragment_last = 0_u8;
  } else {
    set output.fragment_first = 1_u8;
    set output.fragment_last = 1_u8;
  }
  let interior_floor = imin(inside^.natural_floor, measured.natural);
  set output.natural_floor = interior_floor;
  let shifted = shift_motion(output: output, delta: measured.offset);
  set output.natural_floor = shifted.natural_floor;
  set output.float_reach = shifted.float_reach;
  let known = band(inside^.motion_known, measured.motion_known);
  set output.motion_known = known;
  let free_transfer = band(output.free_transfer, measured.own_free);
  set output.free_transfer = free_transfer;
  let barriers = imax(output.barriers, measured.own_barriers);
  set output.barriers = barriers;
  if measured.own_barriers != 0_u32 {
    set output.ordinary = False();
  }
  set output.travel = output.travel +sat measured.extra_travel;
  return output;
}

fn block_output(block: &Block, styles: &Styles, inside: &SequenceOutput, basis_height: i32) -> (transfer: SequenceOutput, size: BlockOutput) reads(block), reads(styles), reads(inside) {
  doc "Combines a completed child reduction with the block's reference geometry and retained float-prefix dependency. Refusal reasons preserve the reference publisher's meaning.";
  let held = block_snapshot(block: block);
  let incoming_floats = block^.output.reads_floats;
  let border = border_edges(styles: styles, style: held.style);
  let padding = padding_edges(styles: styles, style: held.style, basis: held.avail_width);
  let margins = margin_edges(styles: styles, style: held.style, basis: held.avail_width);
  let group = box_of(styles: styles, style: held.style);
  let top = border.top +sat padding.top;
  let bottom = border.bottom +sat padding.bottom;
  let frame = top +sat bottom;
  let specified = specified_height(styles: styles, style: held.style, basis: basis_height, frame: frame);
  let (minimum, maximum) = height_limits(styles: styles, style: held.style, basis: basis_height, frame: frame);
  let yes = True();
  let measured = BlockOutput(valid: yes, width: held.width, height: held.height, available: held.avail_width, content_width: held.content_width, basis_height: basis_height, top_frame: top, bottom_frame: bottom, margin_top: margins.top, margin_bottom: margins.bottom, reads_floats: incoming_floats, fragment_source: block^.split_head, own_barriers: 0_u32, own_free: yes, extra_travel: 0_i64, offset: 0_i64, natural: 9223372036854775807_i64, motion_known: yes);
  let output = lift_block_output(inside: inside, measured: measured);
  let (relative_x, relative_y) = relative_offset(styles: styles, style: held.style, basis_width: held.avail_width, basis_height: unknown);
  let wide_relative = cvt::<i32, i64>(relative_y);
  let excursion = travel_absolute(value: wide_relative);
  set output.travel = output.travel +sat excursion;
  set measured.extra_travel = excursion;
  let own_free = True();
  let reason = 0_u32;
  if incoming_floats {
    let boundary_value_8 = imax(reason, 1_u32);
    set reason = boundary_value_8;
  }
  if output.floats > 0_u64 {
    let boundary_value_9 = imax(reason, 1_u32);
    set reason = boundary_value_9;
  }
  if group.clear != clear_none {
    let boundary_value_10 = imax(reason, 2_u32);
    set reason = boundary_value_10;
  }
  if specified >= 0_i32 {
    set own_free = False();
    let boundary_value_11 = imax(reason, 3_u32);
    set reason = boundary_value_11;
  }
  if minimum > frame {
    set own_free = False();
    let boundary_value_12 = imax(reason, 3_u32);
    set reason = boundary_value_12;
  }
  if maximum >= 0_i32 {
    set own_free = False();
    let boundary_value_13 = imax(reason, 3_u32);
    set reason = boundary_value_13;
  }
  if held.marker {
    if inside^.first_line.slot == no_index {
      set own_free = False();
    }
    let boundary_value_14 = imax(reason, 3_u32);
    set reason = boundary_value_14;
  }
  if output.advance < 0_i64 {
    let boundary_value_15 = imax(reason, 4_u32);
    set reason = boundary_value_15;
  }
  let resolved_height = cvt::<i32, i64>(held.height);
  if output.advance != resolved_height {
    set own_free = False();
    let boundary_value_101 = imax(reason, 4_u32);
    set reason = boundary_value_101;
  }
  if group.position != position_static {
    let boundary_value_16 = imax(reason, 5_u32);
    set reason = boundary_value_16;
  }
  if reason != 0_u32 {
    set output.ordinary = False();
  }
  if own_free {
  } else {
    let height_bound = travel_absolute(value: resolved_height);
    set output.travel = output.travel +sat height_bound;
    set measured.extra_travel = measured.extra_travel +sat height_bound;
  }
  set measured.own_barriers = reason;
  set measured.own_free = own_free;
  let free_transfer = band(inside^.free_transfer, own_free);
  set output.free_transfer = free_transfer;
  let barriers = imax(inside^.barriers, reason);
  set output.barriers = barriers;
  return output, measured;
}

fn prepare_boundary_entry(context: &Context, item: Flow, styles: &Styles, destination: &BoundaryReduction) -> result: unit reads(context), reads(styles), writes(destination.own) {
  doc "Prepares a paragraph, child, float or out-of-flow transfer independently at one event rank. A block waits for its nested reduction; synthesized Close ranks are unused.";
  let own = pending_output(events: 1_u64);
  match item {
    Open(..) => {
    }
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        let transfer = paragraph_output(paragraph: &context^.paragraphs.inner[at]);
        set own = transfer;
      }
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        let transfer = context_entry_output(child: &context^.children.inner[at], styles: styles);
        set own = transfer;
      }
    }
    Float(context: f) => {
      let at = cvt::<u32, u64>(f);
      if at < context^.children.inner.len {
        let transparent = margin_output(margin: 0_i32);
        set own = transparent;
        set own.events = 1_u64;
        set own.ordinary = False();
        let handle = EntryHandle(owner: context^.children.inner[at].block, slot: context^.children.inner[at].entry_slot);
        set own.first_float = handle;
        set own.last_float = handle;
        set own.floats = 1_u64;
        set own.barriers = 1_u32;
      }
    }
    Out(..) => {
      let transparent = margin_output(margin: 0_i32);
      set own = transparent;
      set own.events = 1_u64;
      set own.ordinary = False();
      set own.barriers = 5_u32;
    }
    Close(..) => {
    }
  }
  let motion = entry_motion(context: context, item: item, styles: styles);
  set own.natural_floor = motion.natural_floor;
  set own.float_reach = motion.float_reach;
  set own.motion_known = motion.motion_known;
  set own.travel = own.travel +sat motion.travel;
  set destination^.own = own;
  return unit;
}

fn reduce_sequence(context: &Context, sequence: &EntrySequence, root: u32, styles: &Styles, basis_height: i32, destination: &[BoundaryReduction]) -> made: SequenceOutput reads(context), reads(sequence), reads(styles), writes(destination) {
  doc "Reduces each live AVL node once in post-order. Left, nested block and right use disjoint event slices; only their parent transfer waits for returned totals. Initial owner pages provide direct slot reads without an allocated snapshot; grown directories retain bounded lookup paths.";
  let held = sequence_node(sequence: sequence, slot: root);
  if held.live {
  } else {
    let empty = empty_output();
    return empty;
  }
  let left_node = sequence_node(sequence: sequence, slot: held.left);
  let before = left_node.total_events;
  let after = before +sat held.own_events;
  let count = destination^.len;
  if before >= after {
    let empty = empty_output();
    return empty;
  }
  if after > count {
    let empty = empty_output();
    return empty;
  }
  let left = reduce_sequence(context: context, sequence: sequence, root: held.left, styles: styles, basis_height: basis_height, destination: &destination^[0_u64..before]);
  let right = reduce_sequence(context: context, sequence: sequence, root: held.right, styles: styles, basis_height: basis_height, destination: &destination^[after..count]);
  if before >= destination^.len {
    let empty = empty_output();
    return empty;
  }
  let item = sequence_payload(sequence: sequence, slot: root);
  let own = pending_output(events: held.own_events);
  let measured = empty_block_output();
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      let inside_start = before + 1_u64;
      let inside_end = after - 1_u64;
      if inside_start <= inside_end {
        if at < context^.blocks.inner.len {
          let block = &context^.blocks.inner[at];
          let nested = &block^.entries;
          let inside = reduce_sequence(context: context, sequence: nested, root: nested^.root, styles: styles, basis_height: basis_height, destination: &destination^[inside_start..inside_end]);
          let (transfer, size) = block_output(block: block, styles: styles, inside: &inside, basis_height: basis_height);
          set own = transfer;
          set measured = size;
          let origin = block_origin(context: context, block: b);
          let parent_origin = block_origin(context: context, block: block^.parent);
          let offset = origin.y -sat parent_origin.y;
          let observed = destination^[before].own;
          set measured.offset = offset;
          let natural = if observed.natural_floor == 9223372036854775807_i64 {
            give observed.natural_floor;
          } else {
            give observed.natural_floor -sat offset;
          }
          set measured.natural = natural;
          set measured.motion_known = observed.motion_known;
          let lifted_motion = lift_block_output(inside: &inside, measured: measured);
          set own.natural_floor = lifted_motion.natural_floor;
          set own.float_reach = lifted_motion.float_reach;
          set own.motion_known = lifted_motion.motion_known;
        }
      }
    }
    Text(..) => {
      set own = destination^[before].own;
    }
    Child(..) => {
      set own = destination^[before].own;
    }
    Float(..) => {
      set own = destination^[before].own;
    }
    Out(..) => {
      set own = destination^[before].own;
    }
    Close(..) => {
    }
  }
  let prefix = join_output(left: &left, right: &own);
  let total = join_output(left: &prefix, right: &right);
  if before < destination^.len {
    let reduced = BoundaryReduction(own: own, total: total, block: measured);
    set destination^[before] = reduced;
  }
  return total;
}

fn boundary_ranks(context: &Context) -> made: BoundaryRanks reads(context.blocks.inner), reads(context.paragraphs.inner), reads(context.children.inner) {
  doc "Snapshots only compatibility ranks before publishing page fields, so independent block writes share no context read alias.";
  let blocks = context^.blocks.inner.len;
  let paragraphs = context^.paragraphs.inner.len;
  let children = context^.children.inner.len;
  let block_ranks = box_array_filled::<u64>(count: blocks, value: 0_u64);
  let paragraph_ranks = box_array_filled::<u64>(count: paragraphs, value: 0_u64);
  let child_ranks = box_array_filled::<u64>(count: children, value: 0_u64);
  for (b in 0_u64..blocks) {
    let rank = cvt::<u32, u64>(context^.blocks.inner[b].flow_at);
    set block_ranks.inner[b] = rank;
  }
  for (p in 0_u64..paragraphs) {
    let rank = cvt::<u32, u64>(context^.paragraphs.inner[p].flow_at);
    set paragraph_ranks.inner[p] = rank;
  }
  for (c in 0_u64..children) {
    let rank = cvt::<u32, u64>(context^.children.inner[c].flow_at);
    set child_ranks.inner[c] = rank;
  }
  let ranks = BoundaryRanks(blocks: move block_ranks, paragraphs: move paragraph_ranks, children: move child_ranks);
  return move ranks;
}

fn boundary_event_rank(item: Flow, ranks: &BoundaryRanks) -> made: u64 reads(ranks) {
  doc "Maps a live payload identity to this reference walk's temporary event rank; slot order is never used as document order.";
  let child = no_index;
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < ranks^.blocks.inner.len {
        return ranks^.blocks.inner[at];
      }
    }
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < ranks^.paragraphs.inner.len {
        return ranks^.paragraphs.inner[at];
      }
    }
    Child(context: c) => {
      set child = c;
    }
    Float(context: f) => {
      set child = f;
    }
    Out(context: o) => {
      set child = o;
    }
    Close(..) => {
    }
  }
  let child_at = cvt::<u32, u64>(child);
  if child_at < ranks^.children.inner.len {
    return ranks^.children.inner[child_at];
  }
  return 18446744073709551615_u64;
}

fn store_reduction(nodes: &SlotPages<SequenceNode>, payloads: &SlotPages<Flow>, ranks: &BoundaryRanks, reduced: &[BoundaryReduction]) -> result: unit reads(payloads), reads(ranks), reads(reduced), writes(nodes) {
  doc "Publishes already reduced own/total fields by disjoint page halves. Each live cell is written once; no directory lookup or ancestor repair is performed per entry.";
  match nodes^ {
    Vacant() => {
    }
    Page(values: node_page) => {
      match payloads^ {
        Page(values: payload_page) => {
          let count = node_page^.inner.len;
          for (at in 0_u64..count) {
            if at < node_page^.inner.len {
              if node_page^.inner[at].links.live {
                if at < payload_page^.inner.len {
                  let item = payload_page^.inner[at];
                  let rank = boundary_event_rank(item: item, ranks: ranks);
                  if rank < reduced^.len {
                    set node_page^.inner[at].own = reduced^[rank].own;
                    set node_page^.inner[at].total = reduced^[rank].total;
                  }
                }
              }
            }
          }
        }
        Vacant() => {
        }
        Fork(..) => {
        }
      }
    }
    Fork(left: node_left, right: node_right) => {
      match payloads^ {
        Fork(left: payload_left, right: payload_right) => {
          store_reduction(nodes: &node_left^.inner, payloads: &payload_left^.inner, ranks: ranks, reduced: reduced);
          store_reduction(nodes: &node_right^.inner, payloads: &payload_right^.inner, ranks: ranks, reduced: reduced);
        }
        Vacant() => {
        }
        Page(..) => {
        }
      }
    }
  }
  return unit;
}

fn store_block_reduction(block: &Block, ranks: &BoundaryRanks, reduced: &[BoundaryReduction]) -> result: unit reads(block.flow_at), reads(block.entries.payloads), reads(ranks), reads(reduced), writes(block.entries.nodes), writes(block.boundary), writes(block.output) {
  doc "Publishes one block independently of every other block after all nested reductions have completed.";
  let rank = cvt::<u32, u64>(block^.flow_at);
  if rank < reduced^.len {
    set block^.boundary = reduced^[rank].own;
    set block^.output = reduced^[rank].block;
  }
  store_reduction(nodes: &block^.entries.nodes, payloads: &block^.entries.payloads, ranks: ranks, reduced: reduced);
  return unit;
}

fn publish_boundaries(context: &Context, events: &[Flow], styles: &Styles, basis_height: i32) -> result: unit reads(events), reads(styles), writes(context) {
  doc "Finishes full and partial reference walks with independent leaf transfer preparation, one post-order semantic reduction and independent page publication. The incremental boundary path never calls this full-context operation.";
  let count = flow_length(context: context);
  let empty = empty_output();
  let no_block = empty_block_output();
  let missing = BoundaryReduction(own: empty, total: empty, block: no_block);
  let reduced = box_array_filled::<BoundaryReduction>(count: count, value: missing);
  for (at in 0_u64..count) {
    if at < events^.len {
      prepare_boundary_entry(context: context, item: events^[at], styles: styles, destination: &reduced.inner[at]);
    }
  }
  let ranks = boundary_ranks(context: context);
  let total = reduce_sequence(context: context, sequence: &context^.entries, root: context^.entries.root, styles: styles, basis_height: basis_height, destination: &reduced.inner[0_u64..count]);
  store_reduction(nodes: &context^.entries.nodes, payloads: &context^.entries.payloads, ranks: &ranks, reduced: &reduced.inner[0_u64..count]);
  let blocks = context^.blocks.inner.len;
  for (at in 0_u64..blocks) {
    if at < context^.blocks.inner.len {
      store_block_reduction(block: &context^.blocks.inner[at], ranks: &ranks, reduced: &reduced.inner[0_u64..count]);
    }
  }
  return unit;
}

fn reference_item_output(context: &Context, item: Flow, styles: &Styles, basis_height: i32) -> made: SequenceOutput reads(styles), writes(context) {
  doc "Publishes one settled reference payload while local geometry is decoded. Nested sequence totals must already be current for Open. Returns the own transfer without repairing an index; reference geometry, height and sibling displacement are already settled by the caller. Counters cover directly opened payloads, owner blocks and AVL metadata, excluding shared transfer preparation and earlier reference replay.";
  let owner = no_index;
  let own = empty_output();
  let nested = False();
  match item {
    Open(block: b) => {
      set nested = True();
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
        set owner = context^.blocks.inner[at].parent;
        let root = context^.blocks.inner[at].entries.root;
        let total_field = False();
        let inside = boundary_output(sequence: &context^.blocks.inner[at].entries, slot: root, own: total_field, visits: &context^.boundary_visits);
        let (transfer, size) = block_output(block: &context^.blocks.inner[at], styles: styles, inside: &inside, basis_height: basis_height);
        set own = transfer;
        let measured = size;
        let origin = block_origin(context: context, block: b);
        let parent_origin = block_origin(context: context, block: owner);
        let offset = origin.y -sat parent_origin.y;
        let observed = entry_motion(context: context, item: item, styles: styles);
        set measured.offset = offset;
        let natural = if observed.natural_floor == 9223372036854775807_i64 {
          give observed.natural_floor;
        } else {
          give observed.natural_floor -sat offset;
        }
        set measured.natural = natural;
        set measured.motion_known = observed.motion_known;
        let lifted_motion = lift_block_output(inside: &inside, measured: measured);
        set own.natural_floor = lifted_motion.natural_floor;
        set own.float_reach = lifted_motion.float_reach;
        set own.motion_known = lifted_motion.motion_known;
        set context^.blocks.inner[at].boundary = own;
        set context^.blocks.inner[at].output = measured;
      } else {
        return own;
      }
    }
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      } else {
        return own;
      }
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      } else {
        return own;
      }
    }
    Float(context: f) => {
      let at = cvt::<u32, u64>(f);
      if at < context^.children.inner.len {
        set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      } else {
        return own;
      }
    }
    Out(context: o) => {
      let at = cvt::<u32, u64>(o);
      if at < context^.children.inner.len {
        set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      } else {
        return own;
      }
    }
    Close(..) => {
      return own;
    }
  }
  if nested {
  } else {
    let empty = empty_output();
    let no_block = empty_block_output();
    let prepared = BoundaryReduction(own: empty, total: empty, block: no_block);
    prepare_boundary_entry(context: context, item: item, styles: styles, destination: &prepared);
    set own = prepared.own;
  }
  return own;
}

fn publish_reference_item(context: &Context, item: Flow, styles: &Styles, basis_height: i32) -> result: unit reads(styles), writes(context) {
  doc "Publishes one settled reference transfer and repairs its owning AVL path. Shared output preparation also serves the batch suffix publisher, which joins each intersected node only once.";
  let own = reference_item_output(context: context, item: item, styles: styles, basis_height: basis_height);
  let owner = no_index;
  let slot = no_index;
  let child = no_index;
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
        set owner = context^.blocks.inner[at].parent;
        set slot = context^.blocks.inner[at].entry_slot;
      }
    }
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
        set owner = context^.paragraphs.inner[at].block;
        set slot = context^.paragraphs.inner[at].entry_slot;
      }
    }
    Child(context: c) => {
      set child = c;
    }
    Float(context: f) => {
      set child = f;
    }
    Out(context: o) => {
      set child = o;
    }
    Close(..) => {
      return unit;
    }
  }
  let child_at = cvt::<u32, u64>(child);
  if child_at < context^.children.inner.len {
    set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
    set owner = context^.children.inner[child_at].block;
    set slot = context^.children.inner[child_at].entry_slot;
  }
  if owner == no_index {
    boundary_set(sequence: &context^.entries, slot: slot, output: own, visits: &context^.boundary_visits);
  } else {
    let owner_at = cvt::<u32, u64>(owner);
    if owner_at < context^.blocks.inner.len {
      set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
      boundary_set(sequence: &context^.blocks.inner[owner_at].entries, slot: slot, output: own, visits: &context^.boundary_visits);
    }
  }
  return unit;
}

fn translated_reference_output(context: &Context, item: Flow, previous: SequenceOutput, delta: i64, styles: &Styles, basis_height: i32) -> made: SequenceOutput reads(styles), writes(context) {
  doc "Reuses an intact suffix entry after certified exact reference translation and origin encoding with local_geometry False. An active owner may also have moved: Open derives its relative displacement from the encoded origin, while plain paragraphs and children refresh observed motion. Floats, positioned children and atomic paragraphs reprepare position-dependent travel; no index ancestor is repaired here.";
  let motion_only = False();
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
        let new_offset = context^.blocks.inner[at].y;
        let old_offset = context^.blocks.inner[at].output.offset;
        let relative_delta = new_offset -sat old_offset;
        let shifted = shift_motion(output: previous, delta: relative_delta);
        set context^.blocks.inner[at].output.offset = new_offset;
        set context^.blocks.inner[at].output.basis_height = basis_height;
        set context^.blocks.inner[at].boundary = shifted;
        return shifted;
      }
    }
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
        if context^.paragraphs.inner[at].atomics.inner.len == 0_u64 {
          set motion_only = True();
        }
      }
    }
    Child(..) => {
      set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      set motion_only = True();
    }
    Float(..) => {
    }
    Out(..) => {
    }
    Close(..) => {
      return previous;
    }
  }
  if motion_only {
    let observed = entry_motion(context: context, item: item, styles: styles);
    let refreshed = previous;
    set refreshed.natural_floor = observed.natural_floor;
    set refreshed.float_reach = observed.float_reach;
    set refreshed.motion_known = observed.motion_known;
    return refreshed;
  }
  let prepared = reference_item_output(context: context, item: item, styles: styles, basis_height: basis_height);
  return prepared;
}

fn publish_reference_ancestors(context: &Context, owner: u32, styles: &Styles, basis_height: i32) -> result: unit reads(styles), writes(context) {
  doc "Republishes settled enclosing block outputs from inner to outer after their affected children, preserving the reference walk's completed geometry and repairing each parent's cached sequence total before the next Open.";
  let cursor = owner;
  let limit = context^.blocks.inner.len;
  for (level in 0_u64..limit) {
    let at = cvt::<u32, u64>(cursor);
    if at < context^.blocks.inner.len {
      set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
      let parent = context^.blocks.inner[at].parent;
      let item = Flow::Open(block: cursor);
      publish_reference_item(context: context, item: item, styles: styles, basis_height: basis_height);
      set cursor = parent;
    } else {
      return unit;
    }
  }
  return unit;
}

fn context_entry_output(child: &Context, styles: &Styles) -> made: SequenceOutput reads(child), reads(styles) {
  doc "Publishes an in-flow independent context's measured transfer through the same constructor used for private arithmetic preflight.";
  let output = context_size_output(child: child, styles: styles, height: child^.height, baseline: child^.baseline);
  return output;
}

fn context_size_output(child: &Context, styles: &Styles, height: i32, baseline: i32) -> made: SequenceOutput reads(child), reads(styles) {
  doc "An in-flow independent context is a solid margin-box transfer. Previewed size and baseline use the same margins and semantic barriers as publication; its internal coordinate space remains independent.";
  let leading = margin_output(margin: child^.margin_top);
  let solid = solid_output(height: height);
  if child^.has_baseline {
    let handle = EntryHandle(owner: child^.block, slot: child^.entry_slot);
    let wide_baseline = cvt::<i32, i64>(baseline);
    set solid.first_line = handle;
    set solid.last_line = handle;
    set solid.first_baseline = wide_baseline;
    set solid.last_baseline = wide_baseline;
  }
  let opened = join_output(left: &leading, right: &solid);
  let trailing = margin_output(margin: child^.margin_bottom);
  let output = join_output(left: &opened, right: &trailing);
  set output.count = 1_u64;
  set output.events = 1_u64;
  if child^.split_head {
    set output.fragment_sources = 1_u64;
    set output.fragment_first = 2_u8;
    set output.fragment_last = 2_u8;
  }
  set output.motion_known = False();
  set output.min_content = child^.min_content;
  set output.max_content = child^.max_content;
  let travel = baseline_travel(output: &output);
  set output.travel = travel;
  let group = box_of(styles: styles, style: child^.style);
  if group.clear != clear_none {
    set output.ordinary = False();
    set output.barriers = 2_u32;
  }
  if group.position != position_static {
    set output.ordinary = False();
    set output.barriers = 5_u32;
  }
  if child^.beside {
    set output.ordinary = False();
    set output.barriers = 1_u32;
  }
  return output;
}

fn same_transfer(first: SequenceOutput, second: SequenceOutput) -> same: Bool pure {
  doc "Compares every propagated semantic output, including baseline positions and intrinsic contributions when height alone is unchanged.";
  if first.fragment_sources != second.fragment_sources {
    return False();
  }
  if first.fragment_first != second.fragment_first {
    return False();
  }
  if first.fragment_last != second.fragment_last {
    return False();
  }
  if first.travel != second.travel {
    return False();
  }
  if first.natural_floor != second.natural_floor {
    return False();
  }
  if first.float_reach != second.float_reach {
    return False();
  }
  let free_same = eeq(first.free_transfer, second.free_transfer);
  if free_same {
  } else {
    return False();
  }
  let motion_same = eeq(first.motion_known, second.motion_known);
  if motion_same {
  } else {
    return False();
  }
  let ordinary_same = eeq(first.ordinary, second.ordinary);
  let ordinary_changed = bnot(ordinary_same);
  if ordinary_changed {
    return False();
  }
  let through_same = eeq(first.through, second.through);
  let through_changed = bnot(through_same);
  if through_changed {
    return False();
  }
  if first.leading_positive != second.leading_positive {
    return False();
  }
  if first.leading_negative != second.leading_negative {
    return False();
  }
  if first.trailing_positive != second.trailing_positive {
    return False();
  }
  if first.trailing_negative != second.trailing_negative {
    return False();
  }
  if first.advance != second.advance {
    return False();
  }
  if first.first_line.owner != second.first_line.owner {
    return False();
  }
  if first.first_line.slot != second.first_line.slot {
    return False();
  }
  if first.last_line.owner != second.last_line.owner {
    return False();
  }
  if first.last_line.slot != second.last_line.slot {
    return False();
  }
  if first.first_baseline != second.first_baseline {
    return False();
  }
  if first.last_baseline != second.last_baseline {
    return False();
  }
  if first.min_content != second.min_content {
    return False();
  }
  if first.max_content != second.max_content {
    return False();
  }
  if first.floats != second.floats {
    return False();
  }
  if first.first_float.owner != second.first_float.owner {
    return False();
  }
  if first.first_float.slot != second.first_float.slot {
    return False();
  }
  if first.last_float.owner != second.last_float.owner {
    return False();
  }
  if first.last_float.slot != second.last_float.slot {
    return False();
  }
  if first.barriers != second.barriers {
    return False();
  }
  return True();
}

struct BoundaryMove {
  doc "A direct sibling payload and its independent translation. The temporary list owns values, never references or descendant payloads.";
  item: Flow;
  delta: i64;
}

fn boundary_node(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> made: SequenceCursor reads(sequence.nodes), reads(sequence.span), writes(visits) {
  doc "Counts each physical metadata lookup, including repeated lookups; an absent link opens no node.";
  if slot != no_index {
    set visits^.indexes = visits^.indexes +sat 1_u64;
  }
  let node = sequence_node(sequence: sequence, slot: slot);
  return node;
}

fn boundary_output(sequence: &EntrySequence, slot: u32, own: Bool, visits: &BoundaryVisits) -> made: SequenceOutput reads(sequence.nodes), reads(sequence.span), writes(visits) {
  doc "Counts one field-narrow metadata opening; separate topology and transfer lookups count separately, while directory steps remain excluded.";
  if slot != no_index {
    set visits^.indexes = visits^.indexes +sat 1_u64;
  }
  let output = slot_output(pages: &sequence^.nodes, slot: slot, span: sequence^.span, own: own);
  return output;
}

fn boundary_set(sequence: &EntrySequence, slot: u32, output: SequenceOutput, visits: &BoundaryVisits) -> result: unit reads(sequence.span), writes(sequence.nodes), writes(visits) {
  doc "Repairs one changed entry and its logarithmic AVL path. Each lookup opens only topology or the transfer consumed by the join.";
  let cursor = slot;
  let own_field = True();
  let total_field = False();
  for (level in 0_u64..64_u64) {
    let current = boundary_node(sequence: sequence, slot: cursor, visits: visits);
    if current.live {
    } else {
      return unit;
    }
    let own_output = if cursor == slot {
      slot_store_output(pages: &sequence^.nodes, slot: cursor, span: sequence^.span, output: &output, own: own_field);
      give output;
    } else {
      let retained = boundary_output(sequence: sequence, slot: cursor, own: own_field, visits: visits);
      give retained;
    }
    let left = boundary_output(sequence: sequence, slot: current.left, own: total_field, visits: visits);
    let right = boundary_output(sequence: sequence, slot: current.right, own: total_field, visits: visits);
    let prefix = join_output(left: &left, right: &own_output);
    let total = join_output(left: &prefix, right: &right);
    slot_store_output(pages: &sequence^.nodes, slot: cursor, span: sequence^.span, output: &total, own: total_field);
    set cursor = current.parent;
  }
  return unit;
}

fn boundary_rank(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> made: u64 reads(sequence.nodes), reads(sequence.root), reads(sequence.span), writes(visits) {
  doc "Finds the changed entry's direct rank through index parents; ranks are transient and earlier payloads are not read.";
  let current = boundary_node(sequence: sequence, slot: slot, visits: visits);
  if current.live {
  } else {
    let root = boundary_node(sequence: sequence, slot: sequence^.root, visits: visits);
    return root.total_count;
  }
  let left = boundary_node(sequence: sequence, slot: current.left, visits: visits);
  let rank = left.total_count;
  let cursor = slot;
  let parent = current.parent;
  for (level in 0_u64..64_u64) {
    let ancestor = boundary_node(sequence: sequence, slot: parent, visits: visits);
    if ancestor.live {
    } else {
      return rank;
    }
    if ancestor.right == cursor {
      let earlier = boundary_node(sequence: sequence, slot: ancestor.left, visits: visits);
      let increment = earlier.total_count +sat 1_u64;
      set rank = rank +sat increment;
    }
    set cursor = parent;
    set parent = ancestor.parent;
  }
  return rank;
}

fn boundary_sequence_update(sequence: &EntrySequence, slot: u32, output: SequenceOutput, delta: i64, visits: &BoundaryVisits) -> made: Box<Slots<BoundaryMove>> writes(sequence), writes(visits) {
  doc "Repairs the balanced reduction, then down-sweeps only the intersecting direct suffix. Since the changed solid entry preserves its struts, every later entering state changes by delta. Earlier entries are skipped using cached counts; the suffix reduction repairs each intersected AVL node once while emitting moves in order, and equal-height baseline edits make no sibling list.";
  let own_field = True();
  let previous = boundary_output(sequence: sequence, slot: slot, own: own_field, visits: visits);
  let replacement = output;
  if output.motion_known {
  } else {
    set replacement.natural_floor = previous.natural_floor;
    set replacement.float_reach = previous.float_reach;
    set replacement.motion_known = previous.motion_known;
  }
  boundary_set(sequence: sequence, slot: slot, output: replacement, visits: visits);
  let moves = box_slots_new::<BoundaryMove>(capacity: 0_u64);
  if delta != 0_i64 {
    let rank = boundary_rank(sequence: sequence, slot: slot, visits: visits);
    let after = rank +sat 1_u64;
    let root = sequence^.root;
    let total = sequence_motion_suffix(sequence: sequence, root: root, skip: after, delta: delta, moves: &moves, visits: visits);
  }
  return move moves;
}

fn apply_boundary_move(context: &Context, translation: BoundaryMove) -> result: unit writes(context.blocks.inner), writes(context.paragraphs.inner), writes(context.children.inner), writes(context.boundary_visits.blocks) {
  doc "Changes exactly one direct origin. A block move never opens descendants, and an unplaced lineless paragraph keeps its reference scratch origin.";
  match translation.item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
        set context^.blocks.inner[at].y = context^.blocks.inner[at].y +sat translation.delta;
        set context^.blocks.inner[at].output.offset = context^.blocks.inner[at].output.offset +sat translation.delta;
        let shifted = shift_motion(output: context^.blocks.inner[at].boundary, delta: translation.delta);
        set context^.blocks.inner[at].boundary = shifted;
      }
    }
    Text(paragraph: p) => {
      let paragraph_at = cvt::<u32, u64>(p);
      if paragraph_at < context^.paragraphs.inner.len {
        if context^.paragraphs.inner[paragraph_at].lines.inner.len > 0_u64 {
          set context^.paragraphs.inner[paragraph_at].top = context^.paragraphs.inner[paragraph_at].top +sat translation.delta;
          splice_move_atomics(context: context, paragraph: paragraph_at, delta: translation.delta);
        }
      }
    }
    Child(context: c) => {
      let child_at = cvt::<u32, u64>(c);
      if child_at < context^.children.inner.len {
        set context^.children.inner[child_at].anchor.y = context^.children.inner[child_at].anchor.y +sat translation.delta;
      }
    }
    Float(context: c) => {
      let float_at = cvt::<u32, u64>(c);
      if float_at < context^.children.inner.len {
        set context^.children.inner[float_at].anchor.y = context^.children.inner[float_at].anchor.y +sat translation.delta;
      }
    }
    Out(context: c) => {
      let out_at = cvt::<u32, u64>(c);
      if out_at < context^.children.inner.len {
        set context^.children.inner[out_at].anchor.y = context^.children.inner[out_at].anchor.y +sat translation.delta;
      }
    }
    Close(..) => {
    }
  }
  return unit;
}

fn boundary_owner_update(context: &Context, owner: u32, slot: u32, output: SequenceOutput, delta: i64) -> result: unit writes(context) {
  doc "Routes one local reduction and direct-sibling translation, without a context-wide coordinate conversion. The current indirect payload scatter still needs the step-3 distinct-slot proof.";
  let moves = if owner == no_index {
    let delivered_102 = boundary_sequence_update(sequence: &context^.entries, slot: slot, output: output, delta: delta, visits: &context^.boundary_visits);
    give move delivered_102;
  } else {
    let at = cvt::<u32, u64>(owner);
    if at < context^.blocks.inner.len {
      set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
      let delivered_103 = boundary_sequence_update(sequence: &context^.blocks.inner[at].entries, slot: slot, output: output, delta: delta, visits: &context^.boundary_visits);
      give move delivered_103;
    } else {
      let delivered_104 = box_slots_new::<BoundaryMove>(capacity: 0_u64);
      give move delivered_104;
    }
  }
  let count = moves.inner.len;
  for (position in 0_u64..count) {
    let translation = moves.inner[position];
    apply_boundary_move(context: context, translation: translation);
  }
  return unit;
}

fn boundary_path_ready(context: &Context, styles: &Styles, owner: u32, delta: i32, basis_height: i32) -> ready: Bool reads(context.blocks.inner), reads(context.restyled_blocks), reads(context.restyled_block), reads(styles), writes(context.boundary_visits.blocks) {
  doc "Preflights only the ancestor chain before publishing a changed size. A changed clamp, unresolved edge, width input or stale output selects reference replay before any ancestor or sibling origin changes.";
  let cursor = owner;
  let limit = context^.blocks.inner.len;
  let marked_seen = context^.restyled_blocks == 0_u32;
  for (level in 0_u64..limit) {
    if cursor == no_index {
      return marked_seen;
    }
    let at = cvt::<u32, u64>(cursor);
    if at < context^.blocks.inner.len {
    } else {
      return False();
    }
    set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
    let measured = context^.blocks.inner[at].output;
    let output = context^.blocks.inner[at].boundary;
    let snapshot = block_snapshot(block: &context^.blocks.inner[at]);
    if cursor == context^.restyled_block {
      set marked_seen = True();
    }
    if measured.valid {
    } else {
      return False();
    }
    if output.ordinary {
    } else {
      return False();
    }
    if output.through {
      return False();
    }
    let yes = True();
    let grows = snapshot_grows(block: snapshot, styles: styles, delta: delta, basis_height: basis_height, lines: yes);
    if grows {
    } else {
      return False();
    }
    let width_kept = snapshot_keeps_width(block: snapshot, styles: styles);
    if width_kept {
    } else {
      return False();
    }
    let style = snapshot.style;
    let border = border_edges(styles: styles, style: style);
    let padding = padding_edges(styles: styles, style: style, basis: measured.available);
    let margins = margin_edges(styles: styles, style: style, basis: measured.available);
    let group = box_of(styles: styles, style: style);
    let top = border.top +sat padding.top;
    let bottom = border.bottom +sat padding.bottom;
    if top != measured.top_frame {
      return False();
    }
    if bottom != measured.bottom_frame {
      return False();
    }
    if margins.top != measured.margin_top {
      return False();
    }
    if margins.bottom != measured.margin_bottom {
      return False();
    }
    if group.clear != clear_none {
      return False();
    }
    if group.position != position_static {
      return False();
    }
    if measured.available != snapshot.avail_width {
      return False();
    }
    if measured.content_width != snapshot.content_width {
      return False();
    }
    set cursor = snapshot.parent;
  }
  let ended = cursor == no_index;
  let ready = band(ended, marked_seen);
  return ready;
}

fn propagate_boundary(context: &Context, owner: u32, slot: u32, output: SequenceOutput, delta: i32) -> result: unit writes(context) {
  doc "Repairs one ancestor at a time, translating only its direct later siblings. Stops only when its resolved size and all semantic outputs agree; a baseline or intrinsic change propagates even with zero height delta.";
  let cursor = owner;
  let changed = slot;
  let outgoing = output;
  let wide_delta = cvt::<i32, i64>(delta);
  let limit = context^.blocks.inner.len +sat 1_u64;
  for (level in 0_u64..limit) {
    boundary_owner_update(context: context, owner: cursor, slot: changed, output: outgoing, delta: wide_delta);
    if cursor == no_index {
      return unit;
    }
    let at = cvt::<u32, u64>(cursor);
    if at < context^.blocks.inner.len {
    } else {
      return unit;
    }
    set context^.boundary_visits.blocks = context^.boundary_visits.blocks +sat 1_u64;
    let before = context^.blocks.inner[at].boundary;
    let measured = context^.blocks.inner[at].output;
    let root = context^.blocks.inner[at].entries.root;
    let total_field = False();
    let inside = boundary_output(sequence: &context^.blocks.inner[at].entries, slot: root, own: total_field, visits: &context^.boundary_visits);
    let after = lift_block_output(inside: &inside, measured: measured);
    let height = measured.height +sat delta;
    if at < context^.blocks.inner.len {
      set context^.blocks.inner[at].height = height;
      set context^.blocks.inner[at].output.height = height;
      set context^.blocks.inner[at].boundary = after;
      let same = same_transfer(first: before, second: after);
      let size_same = measured.height == height;
      let stable = band(same, size_same);
      if stable {
        return unit;
      }
      set changed = context^.blocks.inner[at].entry_slot;
      set cursor = context^.blocks.inner[at].parent;
      set outgoing = after;
    }
  }
  return unit;
}

fn boundary_refusal(context: &Context, reason: u32) -> result: unit writes(context.boundary_visits) {
  doc "Records a departure before the compatibility bridge. A nonzero fallback count forbids treating these counters as whole-update locality evidence.";
  set context^.boundary_visits.fallbacks = context^.boundary_visits.fallbacks +sat 1_u64;
  set context^.boundary_visits.reason = reason;
  return unit;
}

struct BoundaryChange {
  doc "A recomputed direct entry before publication into its owning sequence; validity requires stable external struts and width.";
  owner: u32;
  slot: u32;
  delta: i32;
  output: SequenceOutput;
  valid: Bool;
}

fn recompute_boundary_entry(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> (change: BoundaryChange, counts: UpdateCounts) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Recomputes exactly the marked paragraph or child context. The parent validates its ancestor chain before publishing this result; a refusal forces reference stacking rather than treating a newly broken height as the old height.";
  let output = empty_output();
  let no = False();
  let change = BoundaryChange(owner: no_index, slot: no_index, delta: 0_i32, output: output, valid: no);
  let counts = no_updates();
  if context^.marked_paragraphs == 1_u32 {
    let at = cvt::<u32, u64>(context^.marked_paragraph);
    if at < context^.paragraphs.inner.len {
    } else {
      return change, counts;
    }
    set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
    set change.owner = context^.paragraphs.inner[at].block;
    set change.slot = context^.paragraphs.inner[at].entry_slot;
    let old_height = context^.paragraphs.inner[at].height;
    if context^.paragraphs.inner[at].lines.inner.len == 0_u64 {
      return change, counts;
    }
    let children = context^.children.inner.len;
    let exclusions = box_slots_new::<Exclusion>(capacity: 0_u64);
    set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
    break_paragraph(paragraph: &context^.paragraphs.inner[at], children: &context^.children.inner[0_u64..children], styles: styles, fonts: fonts, picks: picks, exclusions: &exclusions.inner[0_u64..0_u64], origin_y: 0_i32);
    set counts.paragraphs = 1_u64;
    if at < context^.paragraphs.inner.len {
      set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      let fresh = paragraph_output(paragraph: &context^.paragraphs.inner[at]);
      set change.output = fresh;
      set change.delta = context^.paragraphs.inner[at].height -sat old_height;
      let solid = bnot(fresh.through);
      set change.valid = solid;
    }
    return change, counts;
  }
  let child_at = cvt::<u32, u64>(context^.marked_child);
  if child_at < context^.children.inner.len {
  } else {
    return change, counts;
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  let before = before_of(context: &context^.children.inner[child_at]);
  if context^.children.inner[child_at].kind != ctx_flow {
    return change, counts;
  }
  set change.owner = context^.children.inner[child_at].block;
  set change.slot = context^.children.inner[child_at].entry_slot;
  if change.slot == no_index {
    return change, counts;
  }
  let child_counts = update_child(child: &context^.children.inner[child_at], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: before);
  set counts = child_counts;
  if child_at < context^.children.inner.len {
    set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
    let after = before_of(context: &context^.children.inner[child_at]);
    let fresh_child = context_entry_output(child: &context^.children.inner[child_at], styles: styles);
    set change.output = fresh_child;
    set change.delta = after.height -sat before.height;
    let same_width = before.width == after.width;
    let same_top = before.margin_top == after.margin_top;
    let same_bottom = before.margin_bottom == after.margin_bottom;
    let same_left = before.margin_left == after.margin_left;
    let same_right = before.margin_right == after.margin_right;
    let same_baseline_kind = eeq(before.has_baseline, after.has_baseline);
    let vertical = band(same_top, same_bottom);
    let horizontal = band(same_left, same_right);
    let margins = band(vertical, horizontal);
    let shape = band(same_width, same_baseline_kind);
    let stable = band(margins, shape);
    set change.valid = stable;
  }
  return change, counts;
}

fn boundary_update(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, before: Before) -> (handled: Bool, counts: UpdateCounts) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Attempts one marked paragraph or child-context edit before any reference-coordinate conversion. Refusal codes 1-5 name semantic barriers, 6 a wider dirty frontier, 7 intrinsic demand/width changes, 8 columns or spanning fragments, and 9 a failed ancestor check or pre/post-recompute arithmetic certificate. An arithmetic or post-recompute refusal forces full reference stacking so changed lines cannot conceal the old height delta.";
  let counts = no_updates();
  let no = False();
  if context^.local_geometry {
  } else {
    boundary_refusal(context: context, reason: 6_u32);
    return no, counts;
  }
  if context^.restyled {
    boundary_refusal(context: context, reason: 7_u32);
    return no, counts;
  }
  if context^.restyled_blocks > 1_u32 {
    boundary_refusal(context: context, reason: 6_u32);
    return no, counts;
  }
  let marked = context^.marked_paragraphs +sat context^.marked_children;
  if marked != 1_u32 {
    boundary_refusal(context: context, reason: 6_u32);
    return no, counts;
  }
  let known = bor(context^.intrinsic_held, context^.intrinsic_known);
  if known {
    boundary_refusal(context: context, reason: 7_u32);
    return no, counts;
  }
  let space_kept = same_space(first: context^.space, second: before.space);
  if space_kept {
  } else {
    boundary_refusal(context: context, reason: 7_u32);
    return no, counts;
  }
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  let owns = owns_fragment(style: context^.style);
  let fragments = if owns {
    give 1_u64;
  } else {
    give 0_u64;
  }
  if frame.columned {
    boundary_refusal(context: context, reason: 8_u32);
    return no, counts;
  }
  if context^.empty_fragment_sources > 0_u64 {
    boundary_refusal(context: context, reason: 8_u32);
    return no, counts;
  }
  if context^.fragments.inner.len > fragments {
    boundary_refusal(context: context, reason: 8_u32);
    return no, counts;
  }
  if context^.splits.inner.len > 0_u64 {
    boundary_refusal(context: context, reason: 8_u32);
    return no, counts;
  }
  let root = context^.entries.root;
  let total_field = False();
  let old_root = boundary_output(sequence: &context^.entries, slot: root, own: total_field, visits: &context^.boundary_visits);
  let old_origin = cvt::<i32, i64>(frame.content_top);
  let old_bounded = transfer_fits(origin: old_origin, travel: old_root.travel);
  if old_bounded {
  } else {
    set context^.restyled = True();
    boundary_refusal(context: context, reason: 9_u32);
    return no, counts;
  }
  if old_root.ordinary {
  } else {
    let reason = imax(old_root.barriers, 1_u32);
    boundary_refusal(context: context, reason: reason);
    return no, counts;
  }
  let (change, recomputed) = recompute_boundary_entry(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set counts = recomputed;
  let ready = boundary_path_ready(context: context, styles: styles, owner: change.owner, delta: change.delta, basis_height: frame.definite);
  let supported = band(change.valid, change.output.ordinary);
  let safe_path = band(ready, supported);
  let proposed = preview_boundary(context: context, owner: change.owner, slot: change.slot, output: change.output, visits: &context^.boundary_visits);
  let budget = old_root.travel +sat proposed.travel;
  let origin = cvt::<i32, i64>(frame.content_top);
  let bounded = transfer_fits(origin: origin, travel: budget);
  let acceptable = band(safe_path, bounded);
  if acceptable {
  } else {
    set context^.restyled = True();
    boundary_refusal(context: context, reason: 9_u32);
    return no, counts;
  }
  propagate_boundary(context: context, owner: change.owner, slot: change.slot, output: change.output, delta: change.delta);
  let new_root_slot = context^.entries.root;
  let after = boundary_output(sequence: &context^.entries, slot: new_root_slot, own: total_field, visits: &context^.boundary_visits);
  let baseline_delta = after.last_baseline -sat old_root.last_baseline;
  let narrow_delta = geometry_narrow(value: baseline_delta);
  if context^.has_baseline {
    set context^.baseline = context^.baseline +sat narrow_delta;
  }
  let no_events = slots_new::<Flow, 0>();
  let position_children = False();
  let (moved, positioned_counts) = finish_in_place(context: context, events: &no_events[0_u64..0_u64], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, delta: change.delta, position_children: position_children);
  let combined = add_counts(first: counts, second: positioned_counts);
  set combined.contexts = combined.contexts +sat 1_u64;
  if context^.marked_paragraphs == 1_u32 {
    let paragraph_at = cvt::<u32, u64>(context^.marked_paragraph);
    if paragraph_at < context^.paragraphs.inner.len {
      set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
      set context^.paragraphs.inner[paragraph_at].dirty = False();
    }
  }
  set context^.paragraph_frontier = ParagraphFrontier::Vacant();
  set context^.marked_paragraphs = 0_u32;
  set context^.marked_children = 0_u32;
  set context^.dirty = False();
  set context^.restyled_blocks = 0_u32;
  set context^.reference_dense = False();
  let yes = True();
  return yes, combined;
}

struct ParagraphBefore {
  doc "The scalar geometry before a speculative single-paragraph break. A failed same-output cutoff passes it to reference replay, which consumes the already broken lines without losing the old height or baseline.";
  at: u64;
  height: i32;
  lines: u64;
  baseline: i32;
}

fn stationary_paragraph(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks, before: Before) -> (handled: Bool, previous: ParagraphBefore) reads(styles), reads(fonts), reads(picks), writes(context) {
  doc "Cuts off a single paragraph edit whose height and last baseline outputs remain identical. Fresh summary propagation carries any first-baseline change. Unrelated context barriers cannot affect a paragraph outside floats with unchanged width and no atomic children. A nonempty paragraph with unchanged height preserves parent split-fragment inputs; breaking refreshes its own fragments. Only its retained summary and ancestor reductions change; a changed geometric output leaves replay the original scalar geometry.";
  let missing = ParagraphBefore(at: 18446744073709551615_u64, height: 0_i32, lines: 0_u64, baseline: 0_i32);
  let no = False();
  if context^.local_geometry {
  } else {
    return no, missing;
  }
  if context^.restyled {
    return no, missing;
  }
  if context^.restyled_blocks != 0_u32 {
    return no, missing;
  }
  if context^.marked_paragraphs != 1_u32 {
    return no, missing;
  }
  if context^.marked_children != 0_u32 {
    return no, missing;
  }
  let intrinsic = bor(context^.intrinsic_held, context^.intrinsic_known);
  if intrinsic {
    return no, missing;
  }
  if context^.space.shrink {
    return no, missing;
  }
  let steady_space = same_space(first: context^.space, second: before.space);
  if steady_space {
  } else {
    return no, missing;
  }
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  if frame.columned {
    return no, missing;
  }
  let at = cvt::<u32, u64>(context^.marked_paragraph);
  if at < context^.paragraphs.inner.len {
  } else {
    return no, missing;
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  if context^.paragraphs.inner[at].beside {
    return no, missing;
  }
  if context^.paragraphs.inner[at].atomics.inner.len != 0_u64 {
    return no, missing;
  }
  let old_lines = context^.paragraphs.inner[at].lines.inner.len;
  if old_lines == 0_u64 {
    return no, missing;
  }
  let old_height = context^.paragraphs.inner[at].height;
  if old_height <= 0_i32 {
    return no, missing;
  }
  let old_base = last_line_baseline(paragraph: &context^.paragraphs.inner[at]);
  let previous = ParagraphBefore(at: at, height: old_height, lines: old_lines, baseline: old_base);
  let old_output = paragraph_output(paragraph: &context^.paragraphs.inner[at]);
  let children = context^.children.inner.len;
  let empty = box_slots_new::<Exclusion>(capacity: 0_u64);
  break_paragraph(paragraph: &context^.paragraphs.inner[at], children: &context^.children.inner[0_u64..children], styles: styles, fonts: fonts, picks: picks, exclusions: &empty.inner[0_u64..0_u64], origin_y: 0_i32);
  if at < context^.paragraphs.inner.len {
  } else {
    return no, previous;
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  let output = paragraph_output(paragraph: &context^.paragraphs.inner[at]);
  if output.through {
    return no, previous;
  }
  if output.advance != old_output.advance {
    return no, previous;
  }
  if output.last_baseline != old_output.last_baseline {
    return no, previous;
  }
  let owner = context^.paragraphs.inner[at].block;
  let slot = context^.paragraphs.inner[at].entry_slot;
  propagate_boundary(context: context, owner: owner, slot: slot, output: output, delta: 0_i32);
  clear_marks(context: context);
  set context^.dirty = False();
  set context^.boundary_visits.fallbacks = 0_u64;
  set context^.boundary_visits.reason = 0_u32;
  let yes = True();
  return yes, previous;
}

fn moved_paragraph(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, previous: ParagraphBefore) -> (handled: Bool, counts: UpdateCounts) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Settles a paragraph that the same-output probe broke but could not stop. The existing splice certificate admits only unchanged width, clamping and float inputs; publication translates direct siblings and repairs ancestors, never materializing or converting unrelated descendants.";
  let counts = no_updates();
  let no = False();
  let at = previous.at;
  if at < context^.paragraphs.inner.len {
  } else {
    return no, counts;
  }
  if context^.splits.inner.len != 0_u64 {
    return no, counts;
  }
  if context^.definite_free {
  } else {
    return no, counts;
  }
  let width_stable = splice_width_stable(context: context, styles: styles);
  if width_stable {
  } else {
    return no, counts;
  }
  let owns = owns_fragment(style: context^.style);
  let allowed = if owns {
    give 1_u64;
  } else {
    give 0_u64;
  }
  if context^.fragments.inner.len > allowed {
    return no, counts;
  }
  if context^.empty_fragment_sources > 0_u64 {
    return no, counts;
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  let output = paragraph_output(paragraph: &context^.paragraphs.inner[at]);
  if output.through {
    return no, counts;
  }
  let owner = context^.paragraphs.inner[at].block;
  let slot = context^.paragraphs.inner[at].entry_slot;
  let delta = context^.paragraphs.inner[at].height -sat previous.height;
  let fixed_reach = owner_stationary_reach(context: context, owner: owner, slot: slot, visits: &context^.boundary_visits);
  let ready = changed_entry_ready(context: context, owner: owner, slot: slot, output: output, delta: delta, fixed_reach: fixed_reach, styles: styles, visits: &context^.boundary_visits);
  if ready {
  } else {
    set context^.boundary_visits.reason = 9_u32;
    return no, counts;
  }
  let total_field = False();
  let old_root = boundary_output(sequence: &context^.entries, slot: context^.entries.root, own: total_field, visits: &context^.boundary_visits);
  propagate_boundary(context: context, owner: owner, slot: slot, output: output, delta: delta);
  let old_topology_dirty = context^.boundary_dirty;
  let extra = splice_finish(context: context, old_root: old_root, delta: delta, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set context^.boundary_dirty = old_topology_dirty;
  let combined = extra;
  set combined.contexts = combined.contexts +sat 1_u64;
  set combined.paragraphs = combined.paragraphs +sat 1_u64;
  clear_marks(context: context);
  set context^.dirty = False();
  set context^.boundary_visits.fallbacks = 0_u64;
  set context^.boundary_visits.reason = 0_u32;
  let yes = True();
  return yes, combined;
}

struct ChildBefore {
  doc "The original scalar output of a child already updated by an early equality probe. Reference replay reuses its result and compares against these old dimensions.";
  at: u64;
  geometry: Before;
}

fn stationary_child(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, before: Before) -> (handled: Bool, counts: UpdateCounts, previous: ChildBefore) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Observes one independent child's actual outputs before compatibility passes. Equal border size, margins and baseline leave every parent stacking input unchanged, including spanning fragments whose geometry still has identical child inputs. A changed output carries its original scalar geometry to reference settlement.";
  let empty = fresh_before();
  let missing = ChildBefore(at: 18446744073709551615_u64, geometry: empty);
  let counts = no_updates();
  let no = False();
  if context^.local_geometry {
  } else {
    return no, counts, missing;
  }
  if context^.restyled {
    return no, counts, missing;
  }
  if context^.restyled_blocks != 0_u32 {
    return no, counts, missing;
  }
  if context^.marked_paragraphs != 0_u32 {
    return no, counts, missing;
  }
  if context^.marked_children != 1_u32 {
    return no, counts, missing;
  }
  let intrinsic = bor(context^.intrinsic_held, context^.intrinsic_known);
  if intrinsic {
    return no, counts, missing;
  }
  let steady_space = same_space(first: context^.space, second: before.space);
  if steady_space {
  } else {
    return no, counts, missing;
  }
  let width_stable = splice_width_stable(context: context, styles: styles);
  if width_stable {
  } else {
    return no, counts, missing;
  }
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  if frame.columned {
    return no, counts, missing;
  }
  let total_field = False();
  let root = boundary_output(sequence: &context^.entries, slot: context^.entries.root, own: total_field, visits: &context^.boundary_visits);
  let origin = cvt::<i32, i64>(frame.content_top);
  let bounded = transfer_fits(origin: origin, travel: root.travel);
  let ordinary = band(root.ordinary, bounded);
  if ordinary {
    return no, counts, missing;
  }
  let at = cvt::<u32, u64>(context^.marked_child);
  if at < context^.children.inner.len {
  } else {
    return no, counts, missing;
  }
  let independent = splice_child_entry(context: context, child: at, visits: &context^.boundary_visits);
  if independent {
  } else {
    return no, counts, missing;
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  let child_before = before_of(context: &context^.children.inner[at]);
  let previous = ChildBefore(at: at, geometry: child_before);
  let updated = update_child(child: &context^.children.inner[at], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: child_before);
  if at < context^.children.inner.len {
  } else {
    return no, updated, previous;
  }
  let same = same_outputs(before: child_before, context: &context^.children.inner[at]);
  if same {
  } else {
    return no, updated, previous;
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  let output = context_entry_output(child: &context^.children.inner[at], styles: styles);
  let owner = context^.children.inner[at].block;
  let slot = context^.children.inner[at].entry_slot;
  propagate_boundary(context: context, owner: owner, slot: slot, output: output, delta: 0_i32);
  clear_marks(context: context);
  set context^.dirty = False();
  set updated.contexts = updated.contexts +sat 1_u64;
  let yes = True();
  return yes, updated, previous;
}

fn probed_reference_bounded(context: &Context, styles: &Styles, paragraph_before: ParagraphBefore, child_before: ChildBefore) -> bounded: Bool reads(styles), writes(context) {
  doc "Retains the old/new arithmetic admission when an early probe changes geometry. Equal outputs need no translation; changed outputs outside this bound must run full reference stacking, preserving saturation order rather than applying a narrowed delta.";
  let owner = no_index;
  let slot = no_index;
  let output = empty_output();
  let paragraph_at = paragraph_before.at;
  let child_at = child_before.at;
  if paragraph_at < context^.paragraphs.inner.len {
    set owner = context^.paragraphs.inner[paragraph_at].block;
    set slot = context^.paragraphs.inner[paragraph_at].entry_slot;
    set output = paragraph_output(paragraph: &context^.paragraphs.inner[paragraph_at]);
  } else if child_at < context^.children.inner.len {
    set owner = context^.children.inner[child_at].block;
    set slot = context^.children.inner[child_at].entry_slot;
    set output = context_entry_output(child: &context^.children.inner[child_at], styles: styles);
  } else {
    return False();
  }
  set context^.boundary_visits.entries = context^.boundary_visits.entries +sat 1_u64;
  let proposed = preview_boundary(context: context, owner: owner, slot: slot, output: output, visits: &context^.boundary_visits);
  let total_field = False();
  let old = boundary_output(sequence: &context^.entries, slot: context^.entries.root, own: total_field, visits: &context^.boundary_visits);
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  let origin = cvt::<i32, i64>(frame.content_top);
  let travel = old.travel +sat proposed.travel;
  let bounded = transfer_fits(origin: origin, travel: travel);
  return bounded;
}

fn boundary_counts(layout: &Layout) -> (entries: u64, blocks: u64, indexes: u64, fallbacks: u64, reason: u32) reads(layout) {
  doc "Boundary-path visits from contexts actually updated in the last edit; a fallback disqualifies a bounded-work claim and reference work is not included.";
  let visits = layout^.last_update.work;
  return visits.entries, visits.blocks, visits.indexes, visits.fallbacks, visits.reason;
}
