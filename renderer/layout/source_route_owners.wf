struct SourceRouteOwners {
  doc "Owned transient suppliers and removed route targets returned independently by each source producer.";
  suppliers: Box<Array<u32>>;
  targets: Box<Array<RemovedRouteTarget>>;
  invariant supplier_limit(owner): owner.suppliers.inner.len <= 1073741824_u64;
  invariant target_limit(owner): owner.targets.inner.len <= 1073741824_u64;
}

fn empty_source_owners() -> made: SourceRouteOwners pure {
  doc "The identity value of the source ownership union.";
  let suppliers = box_array_filled::<u32>(count: 0_u64, value: no_index);
  let no = False();
  let absent = RemovedRouteTarget(serial: no_index, block: no_index, paragraph: no_index, whole: no);
  let targets = box_array_filled::<RemovedRouteTarget>(count: 0_u64, value: absent);
  return SourceRouteOwners(suppliers: move suppliers, targets: move targets);
}

fn source_supplier_present(element: u32, suppliers: &[u32]) -> present: Bool reads(suppliers) {
  doc "An independent candidate's membership test against a completed immutable supplier set.";
  for (k in 0_u64..suppliers^.len) {
    if suppliers^[k] == element {
      return True();
    }
  }
  return False();
}

fn union_source_owners(first: &SourceRouteOwners, second: &SourceRouteOwners) -> result: Result<SourceRouteOwners, LayoutError> reads(first), reads(second) {
  doc "Reduces completed independent proposals without a mutable set cursor: first candidates keep their slots; each second candidate independently becomes its value or no_index against the immutable first set. Nonvacant candidates remain unique by induction. Target concatenation has disjoint predetermined destinations.";
  let first_suppliers = first^.suppliers.inner.len;
  let second_suppliers = second^.suppliers.inner.len;
  let supplier_count = first_suppliers + second_suppliers;
  let first_targets = first^.targets.inner.len;
  let second_targets = second^.targets.inner.len;
  let target_count = first_targets + second_targets;
  if supplier_count > item_ceiling {
    return too_large::<SourceRouteOwners>();
  }
  if target_count > item_ceiling {
    return too_large::<SourceRouteOwners>();
  }
  let suppliers = box_array_filled::<u32>(count: supplier_count, value: no_index);
  let no = False();
  let absent = RemovedRouteTarget(serial: no_index, block: no_index, paragraph: no_index, whole: no);
  let targets = box_array_filled::<RemovedRouteTarget>(count: target_count, value: absent);
  for (k in 0_u64..first_suppliers) {
    set suppliers.inner[k] = first^.suppliers.inner[k];
  }
  for (k in 0_u64..second_suppliers) {
    let element = second^.suppliers.inner[k];
    let present = source_supplier_present(element: element, suppliers: &first^.suppliers.inner[0_u64..first_suppliers]);
    let value = if present {
      give no_index;
    } else {
      give element;
    }
    let at = first_suppliers + k;
    set suppliers.inner[at] = value;
  }
  for (k in 0_u64..first_targets) {
    set targets.inner[k] = first^.targets.inner[k];
  }
  for (k in 0_u64..second_targets) {
    let at = first_targets + k;
    set targets.inner[at] = second^.targets.inner[k];
  }
  let made = SourceRouteOwners(suppliers: move suppliers, targets: move targets);
  return Ok<SourceRouteOwners, LayoutError>(value: move made);
}

fn source_owner_target(owners: &SourceRouteOwners, target: RemovedRouteTarget) -> result: Result<unit, LayoutError> writes(owners.targets) {
  doc "Extends one producer's owned target array after its completed subproposal reduction. Prior targets copy independently; the added owner has one predetermined final slot.";
  let count = owners^.targets.inner.len;
  let length = count + 1_u64;
  if length > item_ceiling {
    return too_large::<unit>();
  }
  let made = box_array_filled::<RemovedRouteTarget>(count: length, value: target);
  for (k in 0_u64..count) {
    set made.inner[k] = owners^.targets.inner[k];
  }
  set owners^.targets = move made;
  return Ok<unit, LayoutError>(value: unit);
}

fn source_style_owners(style: StyleRef, root: u32) -> result: Result<SourceRouteOwners, LayoutError> pure {
  doc "Produces one supplier proposal without writing another producer's state.";
  let element = use_element(style: style, root: root);
  let suppliers = box_array_filled::<u32>(count: 1_u64, value: element);
  let no = False();
  let absent = RemovedRouteTarget(serial: no_index, block: no_index, paragraph: no_index, whole: no);
  let targets = box_array_filled::<RemovedRouteTarget>(count: 0_u64, value: absent);
  let made = SourceRouteOwners(suppliers: move suppliers, targets: move targets);
  return Ok<SourceRouteOwners, LayoutError>(value: move made);
}

fn source_piece_owners(paragraph: &Paragraph, children: &[Context], from: u64, until: u64, root: u32, removing: Bool) -> result: Result<SourceRouteOwners, LayoutError> reads(paragraph), reads(children) {
  doc "Balanced independent piece proposals. An Object's owned child contributes removed context targets only on paragraph removal.";
  let length = until -sat from;
  if length == 0_u64 {
    let empty = empty_source_owners();
    return Ok<SourceRouteOwners, LayoutError>(value: move empty);
  }
  if length == 1_u64 {
    if from < paragraph^.pieces.inner.len {
      let piece = paragraph^.pieces.inner[from];
      let style = piece_style(piece: piece);
      let direct = propagate source_style_owners(style: style, root: root);
      if removing {
        match piece {
          Object(context: owned_child, ..) => {
            let at = cvt::<u32, u64>(owned_child);
            if at < children^.len {
              let yes = True();
              let nested = propagate source_context_owners(context: &children^[at], own: yes, removing: yes, root: root);
              return union_source_owners(first: &direct, second: &nested);
            }
          }
          Bytes(..) => {
          }
          Generated(..) => {
          }
          Scalar(..) => {
          }
          Begin(..) => {
          }
          End(..) => {
          }
        }
      }
      return Ok<SourceRouteOwners, LayoutError>(value: move direct);
    }
    return inconsistent::<SourceRouteOwners>();
  }
  let half = length / 2_u64;
  let middle = from +sat half;
  let first_result = source_piece_owners(paragraph: paragraph, children: children, from: from, until: middle, root: root, removing: removing);
  let second_result = source_piece_owners(paragraph: paragraph, children: children, from: middle, until: until, root: root, removing: removing);
  let first = propagate move first_result;
  let second = propagate move second_result;
  return union_source_owners(first: &first, second: &second);
}

fn source_paragraph_owners(context: &Context, index: u32, root: u32, removing: Bool) -> result: Result<SourceRouteOwners, LayoutError> reads(context) {
  doc "Combines independent strut and piece suppliers, with one direct target when this paragraph is removed from a retained context.";
  let at = cvt::<u32, u64>(index);
  if at < context^.paragraphs.inner.len {
    let paragraph = &context^.paragraphs.inner[at];
    let strut = propagate source_style_owners(style: paragraph^.style, root: root);
    let children = context^.children.inner.len;
    let count = paragraph^.pieces.inner.len;
    let pieces = propagate source_piece_owners(paragraph: paragraph, children: &context^.children.inner[0_u64..children], from: 0_u64, until: count, root: root, removing: removing);
    let made = propagate union_source_owners(first: &strut, second: &pieces);
    if removing {
      let no = False();
      let target = RemovedRouteTarget(serial: context^.slot, block: no_index, paragraph: index, whole: no);
      let pushed = propagate source_owner_target(owners: &made, target: target);
    }
    return Ok<SourceRouteOwners, LayoutError>(value: move made);
  }
  return inconsistent::<SourceRouteOwners>();
}

fn source_context_range(context: &Context, kind: u32, from: u64, until: u64, removing: Bool, root: u32) -> result: Result<SourceRouteOwners, LayoutError> reads(context) {
  doc "Balanced independent proposals for blocks, paragraphs, rows, columns or child contexts. Pair reductions depend on both child outputs; siblings never write a shared set.";
  let length = until -sat from;
  if length == 0_u64 {
    let empty = empty_source_owners();
    return Ok<SourceRouteOwners, LayoutError>(value: move empty);
  }
  if length == 1_u64 {
    if kind == 0_u32 {
      if from < context^.blocks.inner.len {
        return source_style_owners(style: context^.blocks.inner[from].style, root: root);
      }
    } else if kind == 1_u32 {
      if from < context^.paragraphs.inner.len {
        if context^.paragraphs.inner[from].retired {
          let empty = empty_source_owners();
          return Ok<SourceRouteOwners, LayoutError>(value: move empty);
        }
        let index = cvt.wrap::<u64, u32>(from);
        let no = False();
        return source_paragraph_owners(context: context, index: index, root: root, removing: no);
      }
    } else if kind == 2_u32 {
      if from < context^.rows.inner.len {
        let style = propagate source_style_owners(style: context^.rows.inner[from].style, root: root);
        let group = propagate source_style_owners(style: context^.rows.inner[from].group, root: root);
        return union_source_owners(first: &style, second: &group);
      }
    } else if kind == 3_u32 {
      if from < context^.columns.inner.len {
        let style = if context^.columns.inner[from].styled {
          let found = propagate source_style_owners(style: context^.columns.inner[from].style, root: root);
          give move found;
        } else {
          give empty_source_owners();
        }
        let group = propagate source_style_owners(style: context^.columns.inner[from].group, root: root);
        return union_source_owners(first: &style, second: &group);
      }
    } else if kind == 4_u32 {
      if from < context^.children.inner.len {
        let yes = True();
        return source_context_owners(context: &context^.children.inner[from], own: yes, removing: removing, root: root);
      }
    }
    return inconsistent::<SourceRouteOwners>();
  }
  let half = length / 2_u64;
  let middle = from +sat half;
  let first_result = source_context_range(context: context, kind: kind, from: from, until: middle, removing: removing, root: root);
  let second_result = source_context_range(context: context, kind: kind, from: middle, until: until, removing: removing, root: root);
  let first = propagate move first_result;
  let second = propagate move second_result;
  return union_source_owners(first: &first, second: &second);
}

fn source_context_owners(context: &Context, own: Bool, removing: Bool, root: u32) -> result: Result<SourceRouteOwners, LayoutError> reads(context) {
  doc "Produces a source domain's independent field and child proposals once, then reduces them. Whole context targets include descendants without repeatedly collecting their suppliers.";
  if context^.retired {
    let empty = empty_source_owners();
    return Ok<SourceRouteOwners, LayoutError>(value: move empty);
  }
  let owned = if own {
    let found = propagate source_style_owners(style: context^.style, root: root);
    give move found;
  } else {
    give empty_source_owners();
  }
  let blocks = context^.blocks.inner.len;
  let paragraphs = context^.paragraphs.inner.len;
  let rows = context^.rows.inner.len;
  let columns = context^.columns.inner.len;
  let children = context^.children.inner.len;
  let block_result = source_context_range(context: context, kind: 0_u32, from: 0_u64, until: blocks, removing: removing, root: root);
  let paragraph_result = source_context_range(context: context, kind: 1_u32, from: 0_u64, until: paragraphs, removing: removing, root: root);
  let row_result = source_context_range(context: context, kind: 2_u32, from: 0_u64, until: rows, removing: removing, root: root);
  let column_result = source_context_range(context: context, kind: 3_u32, from: 0_u64, until: columns, removing: removing, root: root);
  let child_result = source_context_range(context: context, kind: 4_u32, from: 0_u64, until: children, removing: removing, root: root);
  let block_set = propagate move block_result;
  let paragraph_set = propagate move paragraph_result;
  let row_set = propagate move row_result;
  let column_set = propagate move column_result;
  let child_set = propagate move child_result;
  let flow_result = union_source_owners(first: &block_set, second: &paragraph_set);
  let table_result = union_source_owners(first: &row_set, second: &column_set);
  let flow = propagate move flow_result;
  let table = propagate move table_result;
  let body_result = union_source_owners(first: &flow, second: &table);
  let shell_result = union_source_owners(first: &owned, second: &child_set);
  let body = propagate move body_result;
  let shell = propagate move shell_result;
  let made = propagate union_source_owners(first: &body, second: &shell);
  if removing {
    let yes = True();
    let target = RemovedRouteTarget(serial: context^.slot, block: no_index, paragraph: no_index, whole: yes);
    let pushed = propagate source_owner_target(owners: &made, target: target);
  }
  return Ok<SourceRouteOwners, LayoutError>(value: move made);
}

fn source_removed_event(context: &Context, item: Flow, root: u32) -> result: Result<SourceRouteOwners, LayoutError> reads(context) {
  doc "Produces only one removed source event's ownership without writing sibling proposals.";
  let yes = True();
  match item {
    Open(block: removed_block) => {
      let at = cvt::<u32, u64>(removed_block);
      if at < context^.blocks.inner.len {
        let made = propagate source_style_owners(style: context^.blocks.inner[at].style, root: root);
        let no = False();
        let target = RemovedRouteTarget(serial: context^.slot, block: removed_block, paragraph: no_index, whole: no);
        let pushed = propagate source_owner_target(owners: &made, target: target);
        return Ok<SourceRouteOwners, LayoutError>(value: move made);
      }
    }
    Text(paragraph: removed_paragraph) => {
      return source_paragraph_owners(context: context, index: removed_paragraph, root: root, removing: yes);
    }
    Child(context: removed_child) => {
      let at = cvt::<u32, u64>(removed_child);
      if at < context^.children.inner.len {
        return source_context_owners(context: &context^.children.inner[at], own: yes, removing: yes, root: root);
      }
    }
    Float(context: removed_child) => {
      let at = cvt::<u32, u64>(removed_child);
      if at < context^.children.inner.len {
        return source_context_owners(context: &context^.children.inner[at], own: yes, removing: yes, root: root);
      }
    }
    Out(context: removed_child) => {
      let at = cvt::<u32, u64>(removed_child);
      if at < context^.children.inner.len {
        return source_context_owners(context: &context^.children.inner[at], own: yes, removing: yes, root: root);
      }
    }
    Close(..) => {
      let empty = empty_source_owners();
      return Ok<SourceRouteOwners, LayoutError>(value: move empty);
    }
  }
  return inconsistent::<SourceRouteOwners>();
}

fn source_removed_range(context: &Context, items: &[Flow], from: u64, until: u64, root: u32) -> result: Result<SourceRouteOwners, LayoutError> reads(context), reads(items) {
  doc "Balanced independent removed entry producers and ownership union reductions.";
  let length = until -sat from;
  if length == 0_u64 {
    let empty = empty_source_owners();
    return Ok<SourceRouteOwners, LayoutError>(value: move empty);
  }
  if length == 1_u64 {
    if from < items^.len {
      let item = items^[from];
      return source_removed_event(context: context, item: item, root: root);
    }
    return inconsistent::<SourceRouteOwners>();
  }
  let half = length / 2_u64;
  let middle = from +sat half;
  let first_result = source_removed_range(context: context, items: items, from: from, until: middle, root: root);
  let second_result = source_removed_range(context: context, items: items, from: middle, until: until, root: root);
  let first = propagate move first_result;
  let second = propagate move second_result;
  return union_source_owners(first: &first, second: &second);
}

fn source_removed_at(context: &Context, steps: &[ContextStep], depth: u64, removed: Flow, root: u32) -> result: Result<SourceRouteOwners, LayoutError> reads(context), reads(steps) {
  doc "Exact path descent and existing owned-entry enumeration precede independent source producers.";
  if depth < steps^.len {
    let step = steps^[depth];
    let child = cvt::<u32, u64>(step.child);
    if child < context^.children.inner.len {
      let next = depth +sat 1_u64;
      return source_removed_at(context: &context^.children.inner[child], steps: steps, depth: next, removed: removed, root: root);
    }
    return inconsistent::<SourceRouteOwners>();
  }
  let items = box_slots_new::<Flow>(capacity: 0_u64);
  let visits = no_boundary_visits();
  removed_entries(context: context, item: removed, items: &items, visits: &visits);
  let count = items.inner.len;
  return source_removed_range(context: context, items: &items.inner[0_u64..count], from: 0_u64, until: count, root: root);
}
