fn paged_push_item<T: drop>(cell: &Box<Paged<T>>, value: T, ceiling: u64) -> pushed: Bool writes(cell) contract {
  requires ceiling <= 1073741824_u64;
} {
  doc "Appends value, doubling a full window (an empty one takes four slots) within ceiling; False, dropping value, when the window already holds ceiling items.";
  let length = cell^.inner.len;
  if length >= ceiling {
    return False();
  }
  let capacity = cell^.inner.cap;
  if length >= capacity {
    invariant below_ceiling: length < ceiling;
    invariant full: capacity <= length;
    let room = ceiling - capacity;
    if capacity < room {
      if capacity == 0_u64 {
        grow_paged(cell: cell, capacity: 4_u64);
      } else {
        let doubled = capacity + capacity;
        grow_paged(cell: cell, capacity: doubled);
      }
    } else {
      grow_paged(cell: cell, capacity: ceiling);
    }
  }
  place_back(window: &cell^.inner, value: move value);
  return True();
}

fn new_pages<T: copy>(count: u64, missing: T) -> made: Box<Paged<T>> pure {
  doc "Initializes a dense paged prefix; subsequent geometric growth copies only directory words.";
  let made = box_paged_new::<T>(capacity: count);
  for (s in 0_u64..count) {
    if made.inner.len < made.inner.cap {
      place_back(window: &made.inner, value: missing);
    }
  }
  return move made;
}

fn slot_read<T: copy>(pages: &Box<Paged<T>>, slot: u32, span: u32, missing: T) -> value: T reads(pages) {
  doc "Reads one stable slot in constant depth or returns its explicit missing value.";
  let at = cvt::<u32, u64>(slot);
  if slot < span {
    if at < pages^.inner.len {
      return pages^.inner[at];
    }
  }
  return missing;
}

fn slot_write<T: copy>(pages: &Box<Paged<T>>, slot: u32, span: u32, value: T, missing: T) -> result: unit writes(pages) {
  doc "Extends a dense initialized prefix through the requested stable slot without moving earlier payloads.";
  if slot < span {
    let at = cvt::<u32, u64>(slot);
    let until = at +sat 1_u64;
    let start = pages^.inner.len;
    for (s in start..until) {
      let kept = paged_push_item::<T>(cell: pages, value: missing, ceiling: 1073741824_u64);
    }
    if at < pages^.inner.len {
      set pages^.inner[at] = value;
    }
  }
  return unit;
}
