fn page_first(count: u64) -> width: u32 pure {
  doc "Rounds a small owner's first page to a power of two, at least four and at most 64; large owners use uniform 64-slot pages.";
  let width = 4_u32;
  for (level in 0_u64..4_u64) {
    let wide = cvt::<u32, u64>(width);
    if count <= wide {
      break;
    }
    set width = width +sat width;
  }
  return width;
}

fn page_address(slot: u32, first: u32) -> (page: u64, offset: u64) pure {
  doc "Finds a slot's logical growth page: a small first block, then 64-slot increments. Native pages use paged_page_len instead.";
  if slot < first {
    let offset = cvt::<u32, u64>(slot);
    return 0_u64, offset;
  }
  let rest = slot - first;
  let quotient = rest / 64_u32;
  let remainder = rest % 64_u32;
  let page = cvt::<u32, u64>(quotient);
  let offset = cvt::<u32, u64>(remainder);
  let following = page +sat 1_u64;
  return following, offset;
}

fn native_pages(required: u64, width: u64) -> count: u64 pure {
  doc "Counts the native pages covering a logical prefix, as built-in Paged allocates them.";
  if width > 0_u64 {
    let below = width -sat 1_u64;
    let rounded = required +sat below;
    let count = rounded / width;
    return count;
  }
  return 0_u64;
}

fn page_extend<T: copy>(values: &Box<Slots<T>>, required: u64, missing: T) -> result: unit writes(values) {
  doc "Initializes one native page's cells up to the requested length, leaving the rest of its capacity untouched, as built-in Paged's place_back does.";
  let start = values^.inner.len;
  for (at in start..required) {
    if values^.inner.len < values^.inner.cap {
      place_back(window: &values^.inner, value: missing);
    }
  }
  return unit;
}

fn page_fill<T: copy>(directory: &Box<Slots<Option<Box<Slots<T>>>>>, required: u64, missing: T) -> result: unit writes(directory) {
  doc "Allocates every native page covering a logical prefix, intervening pages included, and initializes cells only through the prefix, as built-in Paged's growth does. Pages before the last existing one are already full.";
  let width = paged_page_len::<T>();
  let length = native_pages(required: required, width: width);
  let start = directory^.inner.len;
  for (index in start..length) {
    let absent = None<Box<Slots<T>>>();
    let pushed = push_item::<Option<Box<Slots<T>>>>(cell: directory, value: move absent, ceiling: 1073741824_u64);
  }
  let first = start -sat 1_u64;
  for (page in first..length) {
    let base = page *sat width;
    let rest = required -sat base;
    let need = if rest < width {
      give rest;
    } else {
      give width;
    }
    if page < directory^.inner.len {
      let page_cell = &directory^.inner[page];
      match page_cell^ {
        None() => {
          let values = box_slots_new::<T>(capacity: width);
          page_extend::<T>(values: &values, required: need, missing: missing);
          set directory^.inner[page] = Some<Box<Slots<T>>>(value: move values);
        }
        Some(value: values) => {
          page_extend::<T>(values: values, required: need, missing: missing);
        }
      }
    }
  }
  return unit;
}

fn new_pages<T: copy>(count: u64, missing: T) -> made: SlotPages<T> pure {
  doc "Creates the native pages for a sealed dense prefix with built-in Paged's geometry: every page holds paged_page_len slots and the whole logical capacity is allocated.";
  if count == 0_u64 {
    return SlotPages<T>::Vacant();
  }
  let first = page_first(count: count);
  let width = cvt::<u32, u64>(first);
  let rest = count -sat width;
  let rounded = rest +sat 63_u64;
  let later = rounded / 64_u64;
  let tail = later *sat 64_u64;
  let capacity = width +sat tail;
  let native = paged_page_len::<T>();
  let length = native_pages(required: capacity, width: native);
  let directory = box_slots_new::<Option<Box<Slots<T>>>>(capacity: length);
  page_fill::<T>(directory: &directory, required: capacity, missing: missing);
  return SlotPages<T>::Pages(first: first, directory: move directory);
}

fn page_ensure<T: copy>(pages: &SlotPages<T>, slot: u32, missing: T) -> result: unit writes(pages) {
  doc "Extends the native pages through the requested logical page, allocating every page before it, as built-in Paged's growth does.";
  match pages^ {
    Vacant() => {
      let directory = box_slots_new::<Option<Box<Slots<T>>>>(capacity: 4_u64);
      page_fill::<T>(directory: &directory, required: 4_u64, missing: missing);
      set pages^ = SlotPages<T>::Pages(first: 4_u32, directory: move directory);
    }
    Pages(..) => {
    }
  }
  match pages^ {
    Vacant() => {
    }
    Pages(first: first_width, directory: pointers) => {
      let (page, offset) = page_address(slot: slot, first: first_width^);
      let width = cvt::<u32, u64>(first_width^);
      let tail = page *sat 64_u64;
      let required = width +sat tail;
      page_fill::<T>(directory: pointers, required: required, missing: missing);
    }
  }
  return unit;
}

fn page_read<T, E, R: copy, fn observe(value: &T, env: &E) -> result: R reads(value), reads(env)>(pages: &SlotPages<T>, slot: u32, span: u32, env: &E, missing: R) -> made: R reads(pages), reads(env) {
  doc "The shared read access: finds one native page by global slot and invokes the field-specific function without copying its containing cell.";
  if slot < span {
    match pages^ {
      Vacant() => {
      }
      Pages(directory: pointers, ..) => {
        let width = paged_page_len::<T>();
        if width > 0_u64 {
          let at = cvt::<u32, u64>(slot);
          let page = at / width;
          let offset = at % width;
          if page < pointers^.inner.len {
            let page_cell = &pointers^.inner[page];
            match page_cell^ {
              None() => {
              }
              Some(value: values) => {
                if offset < values^.inner.len {
                  let made = observe(value: &values^.inner[offset], env: env);
                  return made;
                }
              }
            }
          }
        }
      }
    }
  }
  return missing;
}

fn page_edit<T, E, fn apply_field(value: &T, env: &E) -> result: unit reads(env), writes(value)>(pages: &SlotPages<T>, slot: u32, span: u32, env: &E) -> result: unit reads(env), writes(pages) {
  doc "The shared existing-cell write access by global slot; the callback selects the field group and leaves other groups in place.";
  if slot < span {
    match pages^ {
      Vacant() => {
      }
      Pages(directory: pointers, ..) => {
        let width = paged_page_len::<T>();
        if width > 0_u64 {
          let at = cvt::<u32, u64>(slot);
          let page = at / width;
          let offset = at % width;
          if page < pointers^.inner.len {
            let page_cell = &pointers^.inner[page];
            match page_cell^ {
              None() => {
              }
              Some(value: values) => {
                if offset < values^.inner.len {
                  apply_field(value: &values^.inner[offset], env: env);
                }
              }
            }
          }
        }
      }
    }
  }
  return unit;
}

fn page_each<T, E, fn apply_field(values: &[T], base: u64, env: &E) -> result: unit reads(env), writes(values)>(pages: &SlotPages<T>, env: &E) -> result: unit reads(env), writes(pages) {
  doc "Visits allocated native pages in a counted directory loop; each callback owns one disjoint fixed array and its global slot base.";
  match pages^ {
    Vacant() => {
    }
    Pages(directory: pointers, ..) => {
      let width = paged_page_len::<T>();
      let count = pointers^.inner.len;
      for (page in 0_u64..count) {
        if page < pointers^.inner.len {
          let page_cell = &pointers^.inner[page];
          match page_cell^ {
            None() => {
            }
            Some(value: values) => {
              let base = page *sat width;
              let length = values^.inner.len;
              apply_field(values: &values^.inner[0_u64..length], base: base, env: env);
            }
          }
        }
      }
    }
  }
  return unit;
}

fn page_copy<T: copy>(value: &T, env: &unit) -> made: T reads(value) {
  doc "Copies a whole payload or route cell when that is the requested field.";
  return value^;
}

fn page_replace<T: copy>(value: &T, env: &T) -> result: unit reads(env), writes(value) {
  doc "Initializes or replaces one complete cell.";
  set value^ = env^;
  return unit;
}

fn slot_read<T: copy>(pages: &SlotPages<T>, slot: u32, span: u32, missing: T) -> value: T reads(pages) {
  doc "Reads one stable payload or route through the shared fixed-depth access.";
  let env = unit;
  let value = page_read::<T, unit, T, fn page_copy::<T>>(pages: pages, slot: slot, span: span, env: &env, missing: missing);
  return value;
}

fn slot_write<T: copy>(pages: &SlotPages<T>, slot: u32, span: u32, value: T, missing: T) -> result: unit writes(pages) {
  doc "Allocates a missing fixed page and writes its cell; earlier published payloads never move.";
  if slot < span {
    page_ensure::<T>(pages: pages, slot: slot, missing: missing);
    page_edit::<T, T, fn page_replace::<T>>(pages: pages, slot: slot, span: span, env: &value);
  }
  return unit;
}
