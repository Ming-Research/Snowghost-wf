fn page_first(count: u64) -> width: u32 pure {
  doc "Rounds a small owner's first page to a power of two, at least four and at most 64; large owners use uniform 64-slot pages.";
  let width = 4_u32;
  for (level in 0_u64..4_u64) {
    let wide = cvt::<u32, u64>(width);
    if count <= wide {
      break;
    }
    set width = width +sat width;
  }
  return width;
}

fn page_address(slot: u32, first: u32) -> (page: u64, offset: u64) pure {
  doc "Finds a stable slot with one small-first-page branch and constant-depth arithmetic.";
  if slot < first {
    let offset = cvt::<u32, u64>(slot);
    return 0_u64, offset;
  }
  let rest = slot - first;
  let quotient = rest / 64_u32;
  let remainder = rest % 64_u32;
  let page = cvt::<u32, u64>(quotient);
  let offset = cvt::<u32, u64>(remainder);
  let following = page +sat 1_u64;
  return following, offset;
}

fn new_pages<T: copy>(count: u64, missing: T) -> made: SlotPages<T> pure {
  doc "Creates one built-in Paged for each nonempty owner, retaining the small-first logical growth boundaries.";
  if count == 0_u64 {
    return SlotPages<T>::Vacant();
  }
  let first = page_first(count: count);
  let width = cvt::<u32, u64>(first);
  let rest = count -sat width;
  let rounded = rest +sat 63_u64;
  let later = rounded / 64_u64;
  let tail = later *sat 64_u64;
  let capacity = width +sat tail;
  let storage = box_paged_new::<T>(capacity: capacity);
  for (at in 0_u64..capacity) {
    if storage.inner.len < storage.inner.cap {
      place_back(window: &storage.inner, value: missing);
    }
  }
  return SlotPages<T>::Pages(first: first, storage: move storage);
}

fn page_ensure<T: copy>(pages: &SlotPages<T>, slot: u32, missing: T) -> result: unit writes(pages) {
  doc "Extends the built-in page store through the requested logical page without relocating published cells.";
  match pages^ {
    Vacant() => {
      let storage = box_paged_new::<T>(capacity: 4_u64);
      set pages^ = SlotPages<T>::Pages(first: 4_u32, storage: move storage);
    }
    Pages(..) => {
    }
  }
  match pages^ {
    Vacant() => {
    }
    Pages(first: first_width, storage: values) => {
      let (page, offset) = page_address(slot: slot, first: first_width^);
      let width = cvt::<u32, u64>(first_width^);
      let tail = page *sat 64_u64;
      let required = width +sat tail;
      if values^.inner.cap < required {
        grow_paged(cell: values, capacity: required);
      }
      let start = values^.inner.len;
      for (at in start..required) {
        if values^.inner.len < values^.inner.cap {
          place_back(window: &values^.inner, value: missing);
        }
      }
    }
  }
  return unit;
}

fn page_read<T, E, R: copy, fn observe(value: &T, env: &E) -> result: R reads(value), reads(env)>(pages: &SlotPages<T>, slot: u32, span: u32, env: &E, missing: R) -> made: R reads(pages), reads(env) {
  doc "Reads one stable logical slot through the built-in page directory without copying its containing cell.";
  if slot < span {
    match pages^ {
      Vacant() => {
      }
      Pages(storage: values, ..) => {
        let at = cvt::<u32, u64>(slot);
        if at < values^.inner.len {
          let made = observe(value: &values^.inner[at], env: env);
          return made;
        }
      }
    }
  }
  return missing;
}

fn page_edit<T, E, fn apply_field(value: &T, env: &E) -> result: unit reads(env), writes(value)>(pages: &SlotPages<T>, slot: u32, span: u32, env: &E) -> result: unit reads(env), writes(pages) {
  doc "Edits one stable logical slot, leaving field selection to the callback.";
  if slot < span {
    match pages^ {
      Vacant() => {
      }
      Pages(storage: values, ..) => {
        let at = cvt::<u32, u64>(slot);
        if at < values^.inner.len {
          apply_field(value: &values^.inner[at], env: env);
        }
      }
    }
  }
  return unit;
}

fn page_each<T, E, fn apply_field(values: &[T], base: u64, env: &E) -> result: unit reads(env), writes(values)>(pages: &SlotPages<T>, env: &E) -> result: unit reads(env), writes(pages) {
  doc "Visits each built-in page independently with its global logical slot base.";
  match pages^ {
    Vacant() => {
    }
    Pages(storage: values, ..) => {
      let width = paged_page_len::<T>();
      let count = values^.inner.pages.len;
      for (page in 0_u64..count) {
        if page < values^.inner.pages.len {
          let base = page *sat width;
          apply_field(values: &values^.inner.pages[page], base: base, env: env);
        }
      }
    }
  }
  return unit;
}

fn page_copy<T: copy>(value: &T, env: &unit) -> made: T reads(value) {
  doc "Copies a whole payload or route cell when that is the requested field.";
  return value^;
}

fn page_replace<T: copy>(value: &T, env: &T) -> result: unit reads(env), writes(value) {
  doc "Initializes or replaces one complete cell.";
  set value^ = env^;
  return unit;
}

fn slot_read<T: copy>(pages: &SlotPages<T>, slot: u32, span: u32, missing: T) -> value: T reads(pages) {
  doc "Reads one stable payload or route through the shared fixed-depth access.";
  let env = unit;
  let value = page_read::<T, unit, T, fn page_copy::<T>>(pages: pages, slot: slot, span: span, env: &env, missing: missing);
  return value;
}

fn slot_write<T: copy>(pages: &SlotPages<T>, slot: u32, span: u32, value: T, missing: T) -> result: unit writes(pages) {
  doc "Extends the built-in store through the logical growth block and writes its cell; earlier published payloads never move.";
  if slot < span {
    page_ensure::<T>(pages: pages, slot: slot, missing: missing);
    page_edit::<T, T, fn page_replace::<T>>(pages: pages, slot: slot, span: span, env: &value);
  }
  return unit;
}
