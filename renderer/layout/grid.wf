alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;
alias Sizing = pkg::css::values::Sizing;
alias GridLine = pkg::css::values::GridLine;
alias sizing_value = pkg::css::values::sizing_value;
alias sizing_auto = pkg::css::values::sizing_auto;
alias ContainerGroup = pkg::css::values::ContainerGroup;
alias Track = pkg::css::values::Track;
alias TrackList = pkg::css::values::TrackList;
alias LineNames = pkg::css::values::LineNames;
alias NamedArea = pkg::css::values::NamedArea;
alias AreaMap = pkg::css::values::AreaMap;
alias flow_column = pkg::css::values::flow_column;
alias flow_dense = pkg::css::values::flow_dense;
alias track_length = pkg::css::values::track_length;
alias track_flex = pkg::css::values::track_flex;
alias track_auto = pkg::css::values::track_auto;
alias track_min_content = pkg::css::values::track_min_content;
alias track_max_content = pkg::css::values::track_max_content;
alias repeat_none = pkg::css::values::repeat_none;
alias repeat_auto_fit = pkg::css::values::repeat_auto_fit;
alias line_number = pkg::css::values::line_number;
alias line_span = pkg::css::values::line_span;
alias align_baseline = pkg::css::values::align_baseline;
alias align_normal = pkg::css::values::align_normal;
alias align_auto = pkg::css::values::align_auto;
alias align_stretch = pkg::css::values::align_stretch;
alias align_start = pkg::css::values::align_start;
alias align_end = pkg::css::values::align_end;
alias align_center = pkg::css::values::align_center;
alias align_flex_start = pkg::css::values::align_flex_start;
alias align_flex_end = pkg::css::values::align_flex_end;
alias align_self_start = pkg::css::values::align_self_start;
alias align_self_end = pkg::css::values::align_self_end;
alias align_left = pkg::css::values::align_left;
alias align_right = pkg::css::values::align_right;
alias align_space_between = pkg::css::values::align_space_between;
alias align_space_around = pkg::css::values::align_space_around;
alias align_space_evenly = pkg::css::values::align_space_evenly;
alias align_legacy = pkg::css::values::align_legacy;

const grid_infinite: i32 = 1073741823_i32;

const grid_max_tracks: u64 = 1000_u64;

const grid_max_cells: u64 = 4000000_u64;

const grid_mode_definite: u8 = 0_u8;

const grid_mode_min: u8 = 1_u8;

const grid_mode_max: u8 = 2_u8;

const grid_select_intrinsic_min: u8 = 1_u8;

const grid_select_content_min: u8 = 2_u8;

const grid_select_max_content_min: u8 = 3_u8;

const grid_select_intrinsic_max: u8 = 4_u8;

const grid_select_max_content_max: u8 = 5_u8;

struct GridItem {
  doc "What the grid keeps of one child of its context, indexed by the child's index: whether it is a grid item, its order, its placement (a row or column start and span, definite or not; starts count from the first implicit track once placed), and while sizing tracks its size contributions in the axis being sized, whether its height was measured at its column width, and its grid area relative to the context's content box.";
  active: Bool;
  order: i32;
  row_definite: Bool;
  row: i32;
  rows: i32;
  column_definite: Bool;
  column: i32;
  columns: i32;
  placed: Bool;
  needs: Bool;
  least: i32;
  most: i32;
  minimum: i32;
  measured: Bool;
  x: i32;
  y: i32;
  width: i32;
  height: i32;
  shared: Bool;
  ascent: i32;
  shim: i32;
}

struct GridTrack {
  doc "One track of one axis: its minimum and maximum sizing functions (the kind, and a length in layout units), a flexible factor, the fit-content limit, the base size and growth limit the sizing algorithm keeps (grid_infinite for an infinite limit), two scratch increases, whether an auto-fit track with no item collapsed it, the gutter before it and its offset from the content box.";
  min_kind: u8;
  min_size: i32;
  max_kind: u8;
  max_size: i32;
  flex: f32;
  fit: Bool;
  fit_limit: i32;
  base: i32;
  limit: i32;
  planned: i32;
  share: i32;
  collapsed: Bool;
  gap: i32;
  position: i32;
  used: Bool;
  touched: Bool;
}

struct GridDef {
  doc "One axis of the explicit grid: the track list's ranges in the style stage's stores, how many times its repeat() repeats (zero when it has none) and whether the repetition is auto-fit, how many tracks the template makes (template_count), how many the explicit grid has (explicit: the template's or the area map's, whichever is more), and the track list that sizes implicit tracks.";
  first: u64;
  end: u64;
  repeat_first: u64;
  repeat_end: u64;
  repeats: u64;
  fit: Bool;
  template_count: i32;
  explicit: i32;
  auto_first: u64;
  auto_end: u64;
  auto_default: Bool;
  names_after_first: u64;
  names_after_end: u64;
  repeat_after_first: u64;
  repeat_after_end: u64;
  repeat_before_first: u64;
  repeat_before_end: u64;
}

struct GridSpot {
  doc "Where an item sits along one axis: whether its start line is definite, the start line (counted from the explicit grid's first line, negative before it) and the number of tracks it spans.";
  definite: Bool;
  start: i32;
  span: i32;
}

struct GridSize {
  doc "The implicit grid's size after placement: its rows and columns, and how many implicit rows and columns precede the explicit grid.";
  rows: i32;
  columns: i32;
  row_origin: i32;
  column_origin: i32;
}

fn grid_new_item() -> made: GridItem pure {
  doc "An item entry for a child that is no grid item.";
  let no = False();
  return GridItem(active: no, order: 0_i32, row_definite: no, row: 0_i32, rows: 1_i32, column_definite: no, column: 0_i32, columns: 1_i32, placed: no, needs: no, least: 0_i32, most: 0_i32, minimum: 0_i32, measured: no, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32, shared: no, ascent: 0_i32, shim: 0_i32);
}

fn grid_mod(value: u64, modulus: u64) -> remainder: u64 pure {
  doc "value modulo modulus, zero for a zero modulus.";
  if modulus > 0_u64 {
    let made = value % modulus;
    return made;
  }
  return 0_u64;
}

fn grid_div(value: i32, divisor: i32) -> quotient: i32 pure {
  doc "value divided by divisor, rounded toward zero, zero for a divisor that is not positive.";
  if divisor > 0_i32 {
    let made = value / divisor;
    return made;
  }
  return 0_i32;
}

fn grid_small(value: u64) -> narrow: i32 pure {
  doc "value as an i32, saturating at the largest track count the grid keeps.";
  let capped = imin(value, 1000000_u64);
  let made = cvt::<u64, i32>(capped);
  return made;
}

fn grid_index(value: i32) -> wide: u64 pure {
  doc "A non-negative i32 as an index; a negative one gives zero.";
  let clamped = imax(value, 0_i32);
  let made = cvt::<i32, u64>(clamped);
  return made;
}

fn grid_float(value: i32) -> made: f32 pure {
  doc "An i32 as a float.";
  let wide = cvt.nearest::<i32, f32>(value);
  return wide;
}

fn grid_floor(value: f32) -> raw: i32 pure {
  doc "A non-negative float rounded down to an i32 in layout units, saturating at 10^9; a negative or NaN value gives zero.";
  let same = feq(value, value);
  let nan = bnot(same);
  if nan {
    return 0_i32;
  }
  let high = fgt(value, 1.0e9_f32);
  if high {
    return 1000000000_i32;
  }
  let low = flt(value, 0.0_f32);
  if low {
    return 0_i32;
  }
  let whole = ffloor(value);
  let fits = cvt.defined::<f32, i32>(whole);
  if fits {
    let made = cvt::<f32, i32>(whole);
    return made;
  }
  return 0_i32;
}

fn grid_gap(value: Sizing, basis: i32) -> gap: i32 pure {
  doc "A computed row-gap or column-gap in layout units: normal is zero, and a percentage of an indefinite basis is zero.";
  if value.kind == sizing_value {
    let blocked_percent = value.value.has_percent;
    let indefinite = basis < 0_i32;
    let blocked = band(blocked_percent, indefinite);
    if blocked {
      return 0_i32;
    }
    let made = resolve_lp(value: value.value, basis: basis);
    let clamped = imax(made, 0_i32);
    return clamped;
  }
  return 0_i32;
}

fn grid_track_from(track: Track, basis: i32) -> made: GridTrack pure {
  doc "A track's sizing functions in layout units against the percentage basis (a percentage of an indefinite basis is auto): a flexible minimum is taken as auto and fit-content() as an auto maximum with the limit kept disjoint_span.";
  let no = False();
  let min_flex = track.min.kind == track_flex;
  let min_percent = track.min.value.has_percent;
  let indefinite = basis < 0_i32;
  let min_blocked = band(min_percent, indefinite);
  let min_length = track.min.kind == track_length;
  let min_open = bnot(min_blocked);
  let min_fixed = band(min_length, min_open);
  let min_kind = if min_flex {
    give track_auto;
  } else if min_length {
    if min_blocked {
      give track_auto;
    } else {
      give track_length;
    }
  } else {
    give track.min.kind;
  }
  let min_size = if min_fixed {
    give resolve_lp(value: track.min.value, basis: basis);
  } else {
    give 0_i32;
  }
  let max_percent = track.max.value.has_percent;
  let max_blocked = band(max_percent, indefinite);
  let max_length = track.max.kind == track_length;
  let max_open = bnot(max_blocked);
  let max_fixed = band(max_length, max_open);
  let fit_fixed = band(track.fit_content, max_fixed);
  let plain_length = if track.fit_content {
    give no;
  } else {
    give max_fixed;
  }
  let max_kind = if track.fit_content {
    give track_auto;
  } else if max_length {
    if max_blocked {
      give track_auto;
    } else {
      give track_length;
    }
  } else {
    give track.max.kind;
  }
  let max_size = if plain_length {
    give resolve_lp(value: track.max.value, basis: basis);
  } else {
    give 0_i32;
  }
  let fit_limit = if fit_fixed {
    give resolve_lp(value: track.max.value, basis: basis);
  } else {
    give grid_infinite;
  }
  let flex = if track.max.kind == track_flex {
    give track.max.flex;
  } else {
    give 0.0_f32;
  }
  let min_clamped = imax(min_size, 0_i32);
  let max_clamped = imax(max_size, 0_i32);
  let fit_clamped = imax(fit_limit, 0_i32);
  return GridTrack(min_kind: min_kind, min_size: min_clamped, max_kind: max_kind, max_size: max_clamped, flex: flex, fit: track.fit_content, fit_limit: fit_clamped, base: 0_i32, limit: 0_i32, planned: 0_i32, share: 0_i32, collapsed: no, gap: 0_i32, position: 0_i32, used: no, touched: no);
}

fn grid_auto_track() -> made: GridTrack pure {
  doc "The track an implicit track takes when grid-auto-rows or grid-auto-columns names none: auto.";
  let no = False();
  return GridTrack(min_kind: track_auto, min_size: 0_i32, max_kind: track_auto, max_size: 0_i32, flex: 0.0_f32, fit: no, fit_limit: grid_infinite, base: 0_i32, limit: 0_i32, planned: 0_i32, share: 0_i32, collapsed: no, gap: 0_i32, position: 0_i32, used: no, touched: no);
}

fn grid_fixed_size(track: Track, basis: i32) -> size: i32 pure {
  doc "The size a repeat() counts a track at: its maximum when that is a length, else its minimum when that is a length, else zero.";
  let blocked_max = track.max.value.has_percent;
  let indefinite = basis < 0_i32;
  let max_blocked = band(blocked_max, indefinite);
  let max_length = track.max.kind == track_length;
  let max_open = bnot(max_blocked);
  let max_usable = band(max_length, max_open);
  if max_usable {
    let made = resolve_lp(value: track.max.value, basis: basis);
    let clamped = imax(made, 0_i32);
    return clamped;
  }
  let blocked_min = track.min.value.has_percent;
  let min_blocked = band(blocked_min, indefinite);
  let min_length = track.min.kind == track_length;
  let min_open = bnot(min_blocked);
  let min_usable = band(min_length, min_open);
  if min_usable {
    let made = resolve_lp(value: track.min.value, basis: basis);
    let clamped = imax(made, 0_i32);
    return clamped;
  }
  return 0_i32;
}

fn grid_repeat_count(styles: &Styles, first: u64, end: u64, repeat_first: u64, repeat_end: u64, avail: i32, gap: i32) -> repeats: u64 reads(styles) {
  doc "How many times an auto-fill or auto-fit repeat() repeats in avail: the most that keeps the tracks, each at its fixed size, and their gutters within avail, and at least one; one when avail is indefinite or the repeated tracks have no size.";
  if avail < 0_i32 {
    return 1_u64;
  }
  let length = styles^.tracks.inner.len;
  let outer_sum = 0_i32;
  let outer_count = 0_i32;
  let repeat_sum = 0_i32;
  let repeat_count = 0_i32;
  for (k in first..end) {
    if k < length {
      let size = grid_fixed_size(track: styles^.tracks.inner[k], basis: avail);
      let after_start = k >= repeat_first;
      let before_end = k < repeat_end;
      let inside = band(after_start, before_end);
      if inside {
        set repeat_sum = repeat_sum +sat size;
        set repeat_count = repeat_count +sat 1_i32;
      } else {
        set outer_sum = outer_sum +sat size;
        set outer_count = outer_count +sat 1_i32;
      }
    }
  }
  let repeat_gaps = repeat_count *sat gap;
  let unit_size = repeat_sum +sat repeat_gaps;
  if unit_size <= 0_i32 {
    return 1_u64;
  }
  let outer_gaps = outer_count *sat gap;
  let used = outer_sum +sat outer_gaps;
  let spare = avail -sat used;
  let room = spare +sat gap;
  let fitting = grid_div(value: room, divisor: unit_size);
  let counted = imax(fitting, 1_i32);
  let wide = grid_index(value: counted);
  let capped = imin(wide, grid_max_tracks);
  return capped;
}

fn grid_def(styles: &Styles, template: u32, auto: u32, area_count: i32, avail: i32, gap: i32) -> def: GridDef reads(styles) {
  doc "The explicit grid along one axis from its track list (template, an index of the style stage's track lists, none for an index outside them), the count of rows or columns its area map has, the size avail the axis lays out in (indefinite when negative) and its gap, with auto naming the track list of implicit tracks.";
  let lists = styles^.track_lists.inner.len;
  let tracks = styles^.tracks.inner.len;
  let names = styles^.line_names.inner.len;
  let at = cvt::<u32, u64>(template);
  let found = at < lists;
  let first = 0_u64;
  let end = 0_u64;
  let repeat_first = 0_u64;
  let repeat_end = 0_u64;
  let repeating = False();
  let fit = False();
  let names_after_first = 0_u64;
  let names_after_end = 0_u64;
  let repeat_after_first = 0_u64;
  let repeat_after_end = 0_u64;
  let repeat_before_first = 0_u64;
  let repeat_before_end = 0_u64;
  if found {
    let list = styles^.track_lists.inner[at];
    let wide_first = cvt::<u32, u64>(list.first);
    let wide_end = cvt::<u32, u64>(list.end);
    set end = imin(wide_end, tracks);
    set first = imin(wide_first, end);
    let wide_repeat_first = cvt::<u32, u64>(list.repeat_first);
    let wide_repeat_end = cvt::<u32, u64>(list.repeat_end);
    let kind_set = list.repeat_kind != repeat_none;
    let ordered = wide_repeat_first < wide_repeat_end;
    let inside_start = wide_repeat_first >= first;
    let inside_end = wide_repeat_end <= end;
    let inside = band(inside_start, inside_end);
    let usable_kind = band(kind_set, ordered);
    let usable = band(usable_kind, inside);
    if usable {
      set repeating = True();
      set repeat_first = wide_repeat_first;
      set repeat_end = wide_repeat_end;
      set fit = list.repeat_kind == repeat_auto_fit;
    }
    let after = cvt::<u32, u64>(list.names_after.first);
    let after_end = cvt::<u32, u64>(list.names_after.end);
    set names_after_first = imin(after, names);
    set names_after_end = imin(after_end, names);
    let inner = cvt::<u32, u64>(list.repeat_names_after.first);
    let inner_end = cvt::<u32, u64>(list.repeat_names_after.end);
    set repeat_after_first = imin(inner, names);
    set repeat_after_end = imin(inner_end, names);
    let outer = cvt::<u32, u64>(list.repeat_names_before.first);
    let outer_end = cvt::<u32, u64>(list.repeat_names_before.end);
    set repeat_before_first = imin(outer, names);
    set repeat_before_end = imin(outer_end, names);
  }
  let repeats = if repeating {
    let counted = grid_repeat_count(styles: styles, first: first, end: end, repeat_first: repeat_first, repeat_end: repeat_end, avail: avail, gap: gap);
    give counted;
  } else {
    give 0_u64;
  }
  let outer = if repeating {
    let before = repeat_first -sat first;
    let after = end -sat repeat_end;
    give before +sat after;
  } else {
    give end -sat first;
  }
  let repeated_each = repeat_end -sat repeat_first;
  let repeated = repeated_each *sat repeats;
  let all = outer +sat repeated;
  let capped = imin(all, grid_max_tracks);
  let template_count = grid_small(value: capped);
  let explicit = imax(template_count, area_count);
  let auto_at = cvt::<u32, u64>(auto);
  let auto_found = auto_at < lists;
  let auto_first = 0_u64;
  let auto_end = 0_u64;
  let auto_default = True();
  if auto_found {
    let list = styles^.track_lists.inner[auto_at];
    let wide_first = cvt::<u32, u64>(list.first);
    let wide_end = cvt::<u32, u64>(list.end);
    let stop = imin(wide_end, tracks);
    let start = imin(wide_first, stop);
    if start < stop {
      set auto_first = start;
      set auto_end = stop;
      set auto_default = False();
    }
  }
  return GridDef(first: first, end: end, repeat_first: repeat_first, repeat_end: repeat_end, repeats: repeats, fit: fit, template_count: template_count, explicit: explicit, auto_first: auto_first, auto_end: auto_end, auto_default: auto_default, names_after_first: names_after_first, names_after_end: names_after_end, repeat_after_first: repeat_after_first, repeat_after_end: repeat_after_end, repeat_before_first: repeat_before_first, repeat_before_end: repeat_before_end);
}

fn grid_before(def: GridDef) -> count: u64 pure {
  doc "How many tracks of the template precede its repeat(), all of them when it has none.";
  if def.repeats > 0_u64 {
    let made = def.repeat_first -sat def.first;
    return made;
  }
  let made = def.end -sat def.first;
  return made;
}

fn grid_pattern_track(styles: &Styles, def: GridDef, pattern: u64, basis: i32) -> track: GridTrack reads(styles) {
  doc "The implicit track the pattern of grid-auto-rows or grid-auto-columns gives at position pattern, which counts from its first track.";
  if def.auto_default {
    let made = grid_auto_track();
    return made;
  }
  let count = def.auto_end -sat def.auto_first;
  let at = grid_mod(value: pattern, modulus: count);
  let index = def.auto_first +sat at;
  if index < styles^.tracks.inner.len {
    let made = grid_track_from(track: styles^.tracks.inner[index], basis: basis);
    return made;
  }
  let made = grid_auto_track();
  return made;
}

fn grid_template_index(def: GridDef, k: u64) -> index: u64 pure {
  doc "The index in the style stage's tracks of the k-th track the template makes, its repeat() expanded.";
  let before = grid_before(def: def);
  if k < before {
    let made = def.first +sat k;
    return made;
  }
  let past = k -sat before;
  let each = def.repeat_end -sat def.repeat_first;
  let span = each *sat def.repeats;
  if past < span {
    let within = grid_mod(value: past, modulus: each);
    let made = def.repeat_first +sat within;
    return made;
  }
  let beyond = past -sat span;
  let start = if def.repeats > 0_u64 {
    give def.repeat_end;
  } else {
    give def.end;
  }
  let made = start +sat beyond;
  return made;
}

fn grid_track_at(styles: &Styles, def: GridDef, at: u64, origin: u64, basis: i32) -> track: GridTrack reads(styles) {
  doc "The sizing functions of the track at position at of the implicit grid, of which origin tracks precede the explicit grid: from the template, or from the pattern of implicit tracks, which ends at the explicit grid on its start side and begins at the template's last track on its end side.";
  if at < origin {
    let count = if def.auto_default {
      give 1_u64;
    } else {
      give def.auto_end -sat def.auto_first;
    }
    let distance = origin -sat at;
    let back = distance -sat 1_u64;
    let step = grid_mod(value: back, modulus: count);
    let pattern = count -sat 1_u64;
    let from_start = pattern -sat step;
    let made = grid_pattern_track(styles: styles, def: def, pattern: from_start, basis: basis);
    return made;
  }
  let k = at -sat origin;
  let template = grid_index(value: def.template_count);
  if k < template {
    let index = grid_template_index(def: def, k: k);
    if index < styles^.tracks.inner.len {
      let made = grid_track_from(track: styles^.tracks.inner[index], basis: basis);
      return made;
    }
  }
  let past = k -sat template;
  let made = grid_pattern_track(styles: styles, def: def, pattern: past, basis: basis);
  return made;
}

fn grid_names_hold(styles: &Styles, first: u64, end: u64, atom: u32) -> hit: Bool reads(styles) {
  doc "Whether one of the style stage's line names from first to end is atom.";
  let count = styles^.line_names.inner.len;
  for (k in first..end) {
    if k < count {
      let name = styles^.line_names.inner[k];
      if name.index == atom {
        return True();
      }
    }
  }
  return False();
}

fn grid_track_names_hold(styles: &Styles, index: u64, atom: u32) -> hit: Bool reads(styles) {
  doc "Whether the line names written before the track at index of the style stage's tracks include atom.";
  if index < styles^.tracks.inner.len {
    let names = styles^.tracks.inner[index].names_before;
    let first = cvt::<u32, u64>(names.first);
    let end = cvt::<u32, u64>(names.end);
    let made = grid_names_hold(styles: styles, first: first, end: end, atom: atom);
    return made;
  }
  return False();
}

fn grid_line_named(styles: &Styles, def: GridDef, line: i32, atom: u32) -> hit: Bool reads(styles) {
  doc "Whether line, counted from the explicit grid's first line, has the name atom: the names written between the template's tracks, the repeat() expanded.";
  if line < 0_i32 {
    return False();
  }
  let at = grid_index(value: line);
  let before = grid_before(def: def);
  if at < before {
    let index = def.first +sat at;
    let made = grid_track_names_hold(styles: styles, index: index, atom: atom);
    return made;
  }
  let past = at -sat before;
  let each = def.repeat_end -sat def.repeat_first;
  let span = each *sat def.repeats;
  let repeated = def.repeats > 0_u64;
  let inside = past < span;
  let in_repeat = band(repeated, inside);
  if in_repeat {
    let within = grid_mod(value: past, modulus: each);
    let index = def.repeat_first +sat within;
    let named = grid_track_names_hold(styles: styles, index: index, atom: atom);
    let seam = within == 0_u64;
    let inner = past > 0_u64;
    let joins = band(seam, inner);
    if joins {
      let after = grid_names_hold(styles: styles, first: def.repeat_after_first, end: def.repeat_after_end, atom: atom);
      let made = bor(named, after);
      return made;
    }
    let first_line = bnot(inner);
    let opening = band(seam, first_line);
    if opening {
      let opening_names = grid_names_hold(styles: styles, first: def.repeat_before_first, end: def.repeat_before_end, atom: atom);
      let made = bor(named, opening_names);
      return made;
    }
    return named;
  }
  let beyond = past -sat span;
  let start = if repeated {
    give def.repeat_end;
  } else {
    give def.end;
  }
  let count = def.end -sat start;
  let at_seam = beyond == 0_u64;
  let seam_after = band(repeated, at_seam);
  let after_repeat = if seam_after {
    give grid_names_hold(styles: styles, first: def.repeat_after_first, end: def.repeat_after_end, atom: atom);
  } else {
    give False();
  }
  if beyond < count {
    let index = start +sat beyond;
    let named = grid_track_names_hold(styles: styles, index: index, atom: atom);
    let made = bor(named, after_repeat);
    return made;
  }
  if beyond == count {
    let named = grid_names_hold(styles: styles, first: def.names_after_first, end: def.names_after_end, atom: atom);
    let made = bor(named, after_repeat);
    return made;
  }
  return False();
}

fn grid_find_named(styles: &Styles, def: GridDef, atom: u32, count: i32) -> index: i32 reads(styles) {
  doc "The line the count-th line named atom is, counting from the explicit grid's first line for a positive count and from its last for a negative one; when fewer lines have the name, the implicit lines beyond the explicit grid on that side are taken to have it too.";
  let lines = grid_index(value: def.template_count);
  let total = lines +sat 1_u64;
  if count > 0_i32 {
    let seen = 0_i32;
    for (k in 0_u64..total) {
      let line = grid_small(value: k);
      let named = grid_line_named(styles: styles, def: def, line: line, atom: atom);
      if named {
        set seen = seen +sat 1_i32;
        if seen == count {
          return line;
        }
      }
    }
    let missing = count -sat seen;
    let made = def.explicit +sat missing;
    return made;
  }
  let wanted = 0_i32 -sat count;
  let seen = 0_i32;
  for (k in 0_u64..total) {
    let from_start = lines -sat k;
    let line = grid_small(value: from_start);
    let named = grid_line_named(styles: styles, def: def, line: line, atom: atom);
    if named {
      set seen = seen +sat 1_i32;
      if seen == wanted {
        return line;
      }
    }
  }
  let missing = wanted -sat seen;
  let made = 0_i32 -sat missing;
  return made;
}

fn grid_area_line(styles: &Styles, areas: u32, atom: u32, rows: Bool, end_edge: Bool) -> (found: Bool, line: i32) reads(styles) {
  doc "The line of the named area atom in the area map areas that a grid-row-start, grid-row-end, grid-column-start or grid-column-end of that name takes: the area's first or last line along the axis.";
  let maps = styles^.area_maps.inner.len;
  let at = cvt::<u32, u64>(areas);
  if at < maps {
    let map = styles^.area_maps.inner[at];
    let first = cvt::<u32, u64>(map.first);
    let end = cvt::<u32, u64>(map.end);
    let count = styles^.named_areas.inner.len;
    for (k in first..end) {
      if k < count {
        let area = styles^.named_areas.inner[k];
        if area.name.index == atom {
          let low = if rows {
            give area.row_start;
          } else {
            give area.column_start;
          }
          let high = if rows {
            give area.row_end;
          } else {
            give area.column_end;
          }
          let edge = if end_edge {
            give high;
          } else {
            give low;
          }
          let wide_edge = cvt::<u32, u64>(edge);
          let made = grid_small(value: wide_edge);
          return True(), made;
        }
      }
    }
  }
  return False(), 0_i32;
}

fn grid_line_index(styles: &Styles, def: GridDef, areas: u32, rows: Bool, line: GridLine, end_edge: Bool) -> index: i32 reads(styles) {
  doc "The line a grid-row-start, grid-row-end, grid-column-start or grid-column-end that is a number, a name or both gives, counted from the explicit grid's first line (CSS Grid 8.3): a number counts from the first line, or from the last when negative; a name alone is first a named area's edge, else the first line with the name; a name with a number counts lines with that name.";
  let number = line.number;
  if line.named {
    let atom = line.name.index;
    let counted = if number == 0_i32 {
      let (found, edge) = grid_area_line(styles: styles, areas: areas, atom: atom, rows: rows, end_edge: end_edge);
      if found {
        return edge;
      }
      give 1_i32;
    } else {
      give number;
    }
    let made = grid_find_named(styles: styles, def: def, atom: atom, count: counted);
    return made;
  }
  if number > 0_i32 {
    let made = number -sat 1_i32;
    return made;
  }
  let from_end = def.explicit +sat 1_i32;
  let made = from_end +sat number;
  return made;
}

fn grid_span_count(line: GridLine) -> count: i32 pure {
  doc "The number of tracks a span line asks for.";
  let made = imax(line.number, 1_i32);
  let capped = imin(made, 1000_i32);
  return capped;
}

fn grid_spot(styles: &Styles, def: GridDef, areas: u32, rows: Bool, first: GridLine, last: GridLine) -> spot: GridSpot reads(styles) {
  doc "Resolves an item's grid-row-start and grid-row-end, or its grid-column-start and grid-column-end, to a position along the axis (CSS Grid 8.3 and 8.3.1): two definite lines give the span between them, the earlier first, and one line of an equal pair is dropped; a line and a span give the span from or to the line; a span alone leaves the position to auto-placement, as two spans do for the end's; a line alone spans one track.";
  let first_line = first.kind == line_number;
  let last_line = last.kind == line_number;
  let first_span = first.kind == line_span;
  let last_span_raw = last.kind == line_span;
  let both_span = band(first_span, last_span_raw);
  let last_span = if both_span {
    give False();
  } else {
    give last_span_raw;
  }
  let no = False();
  let yes = True();
  let one = GridSpot(definite: no, start: 0_i32, span: 1_i32);
  let first_index = if first_line {
    give grid_line_index(styles: styles, def: def, areas: areas, rows: rows, line: first, end_edge: no);
  } else {
    give 0_i32;
  }
  let last_index = if last_line {
    give grid_line_index(styles: styles, def: def, areas: areas, rows: rows, line: last, end_edge: yes);
  } else {
    give 0_i32;
  }
  let limit = 1000_i32;
  let floor_limit = 0_i32 -sat limit;
  let first_clamped_high = imin(first_index, limit);
  let first_clamped = imax(first_clamped_high, floor_limit);
  let last_clamped_high = imin(last_index, limit);
  let last_clamped = imax(last_clamped_high, floor_limit);
  let both_lines = band(first_line, last_line);
  if both_lines {
    let low = imin(first_clamped, last_clamped);
    let high = imax(first_clamped, last_clamped);
    let distance = high -sat low;
    let span = imax(distance, 1_i32);
    return GridSpot(definite: yes, start: low, span: span);
  }
  let line_then_span = band(first_line, last_span);
  if line_then_span {
    let span = grid_span_count(line: last);
    return GridSpot(definite: yes, start: first_clamped, span: span);
  }
  let span_then_line = band(first_span, last_line);
  if span_then_line {
    let span = grid_span_count(line: first);
    let start = last_clamped -sat span;
    return GridSpot(definite: yes, start: start, span: span);
  }
  if first_line {
    return GridSpot(definite: yes, start: first_clamped, span: 1_i32);
  }
  if last_line {
    let start = last_clamped -sat 1_i32;
    return GridSpot(definite: yes, start: start, span: 1_i32);
  }
  if first_span {
    let span = grid_span_count(line: first);
    return GridSpot(definite: no, start: 0_i32, span: span);
  }
  if last_span {
    let span = grid_span_count(line: last);
    return GridSpot(definite: no, start: 0_i32, span: span);
  }
  return one;
}

struct GridModel {
  doc "The grid's working state, built from the context's children each time it lays out or measures: items, indexed by child; the order the items are placed in (their children's indices); and the tracks of each axis.";
  items: Box<Slots<GridItem>>;
  sequence: Box<Slots<u32>>;
  columns: Box<Slots<GridTrack>>;
  rows: Box<Slots<GridTrack>>;
}

fn grid_model_new() -> made: GridModel pure {
  doc "A model that holds nothing.";
  let items = box_slots_new::<GridItem>(capacity: 0_u64);
  let sequence = box_slots_new::<u32>(capacity: 0_u64);
  let columns = box_slots_new::<GridTrack>(capacity: 0_u64);
  let rows = box_slots_new::<GridTrack>(capacity: 0_u64);
  return GridModel(items: move items, sequence: move sequence, columns: move columns, rows: move rows);
}

fn grid_get(items: &Box<Slots<GridItem>>, at: u64) -> item: GridItem reads(items) {
  doc "The item entry of child at, or the entry of a non-item for an index outside the list.";
  if at < items^.inner.len {
    let found = items^.inner[at];
    return found;
  }
  let made = grid_new_item();
  return made;
}

fn grid_put(items: &Box<Slots<GridItem>>, at: u64, item: GridItem) -> result: unit writes(items) {
  doc "Replaces the item entry of child at.";
  if at < items^.inner.len {
    set items^.inner[at] = item;
  }
  return unit;
}

fn grid_collect(context: &Context, events: &[Flow], styles: &Styles, model: &GridModel, column_def: GridDef, row_def: GridDef, areas: u32) -> result: unit reads(context), reads(events), reads(styles), writes(model) {
  doc "Makes an item entry for each child of context and lists the in-flow children in document order, each with its order and its placement along both axes; an absolutely positioned child is no item.";
  let count = context^.children.inner.len;
  for (c in 0_u64..count) {
    let blank = grid_new_item();
    let pushed = push_item::<GridItem>(cell: &model^.items, value: blank, ceiling: item_ceiling);
  }
  let ordered = False();
  let flow_count = events^.len;
  for (k in 0_u64..flow_count) {
    let flow_bound_861 = events^.len;
    if k >= flow_bound_861 {
      break;
    }
    let piece = events^[k];
    match piece {
      Child(context: child) => {
        let at = cvt::<u32, u64>(child);
        if at < context^.children.inner.len {
          let style = context^.children.inner[at].style;
          let group = item_of(styles: styles, style: style);
          let yes = True();
          let no = False();
          let row = grid_spot(styles: styles, def: row_def, areas: areas, rows: yes, first: group.row_start, last: group.row_end);
          let column = grid_spot(styles: styles, def: column_def, areas: areas, rows: no, first: group.column_start, last: group.column_end);
          let made = GridItem(active: yes, order: group.order, row_definite: row.definite, row: row.start, rows: row.span, column_definite: column.definite, column: column.start, columns: column.span, placed: no, needs: no, least: 0_i32, most: 0_i32, minimum: 0_i32, measured: no, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32, shared: no, ascent: 0_i32, shim: 0_i32);
          grid_put(items: &model^.items, at: at, item: made);
          let pushed = push_item::<u32>(cell: &model^.sequence, value: child, ceiling: item_ceiling);
          if group.order != 0_i32 {
            set ordered = True();
          }
        }
      }
      Open(..) => {
      }
      Close(..) => {
      }
      Text(..) => {
      }
      Float(..) => {
      }
      Out(..) => {
      }
    }
  }
  if ordered {
    grid_sort_sequence(model: model);
  }
  return unit;
}

fn grid_order_of(model: &GridModel, child: u32) -> order: i32 reads(model) {
  doc "The order property of the item whose child index is child.";
  let at = cvt::<u32, u64>(child);
  let item = grid_get(items: &model^.items, at: at);
  return item.order;
}

fn grid_sort_sequence(model: &GridModel) -> result: unit writes(model) {
  doc "Sorts the placement sequence by order, keeping document order among equal values (insertion sort, run only when some item has an order other than zero).";
  let count = model^.sequence.inner.len;
  for (i in 1_u64..count) {
    if i >= model^.sequence.inner.len {
      break;
    }
    let key = model^.sequence.inner[i];
    let key_order = grid_order_of(model: model, child: key);
    let at = i;
    loop {
      if at == 0_u64 {
        break;
      }
      let before = at - 1_u64;
      if at >= model^.sequence.inner.len {
        break;
      }
      let previous = model^.sequence.inner[before];
      let previous_order = grid_order_of(model: model, child: previous);
      if previous_order <= key_order {
        break;
      }
      set model^.sequence.inner[at] = previous;
      set at = before;
    }
    if at < model^.sequence.inner.len {
      set model^.sequence.inner[at] = key;
    }
  }
  return unit;
}

fn grid_swap_axes(model: &GridModel) -> result: unit writes(model) {
  doc "Exchanges every item's row and column placement, so that column flow places by the algorithm of row flow.";
  let count = model^.items.inner.len;
  for (c in 0_u64..count) {
    let item = grid_get(items: &model^.items, at: c);
    let swapped = GridItem(active: item.active, order: item.order, row_definite: item.column_definite, row: item.column, rows: item.columns, column_definite: item.row_definite, column: item.row, columns: item.rows, placed: item.placed, needs: item.needs, least: item.least, most: item.most, minimum: item.minimum, measured: item.measured, x: item.x, y: item.y, width: item.width, height: item.height, shared: item.shared, ascent: item.ascent, shim: item.shim);
    grid_put(items: &model^.items, at: c, item: swapped);
  }
  return unit;
}

fn grid_free(cells: &Box<Array<u8>>, stride: u64, rows_cap: u64, row: u64, column: u64, rows: u64, columns: u64) -> free: Bool reads(cells) {
  doc "Whether the grid area of rows by columns tracks from row and column covers no occupied cell; cells past the tracked region count as free.";
  let row_end = row +sat rows;
  let column_end = column +sat columns;
  let length = cells^.inner.len;
  for (r in row..row_end) {
    for (c in column..column_end) {
      let inside_rows = r < rows_cap;
      let inside_columns = c < stride;
      let inside = band(inside_rows, inside_columns);
      if inside {
        let base = r *sat stride;
        let index = base +sat c;
        if index < length {
          if cells^.inner[index] != 0_u8 {
            return False();
          }
        }
      }
    }
  }
  return True();
}

fn grid_mark(cells: &Box<Array<u8>>, stride: u64, rows_cap: u64, row: u64, column: u64, rows: u64, columns: u64) -> result: unit writes(cells) {
  doc "Marks the cells of the grid area of rows by columns tracks from row and column occupied.";
  let row_end = row +sat rows;
  let column_end = column +sat columns;
  let length = cells^.inner.len;
  for (r in row..row_end) {
    for (c in column..column_end) {
      let inside_rows = r < rows_cap;
      let inside_columns = c < stride;
      let inside = band(inside_rows, inside_columns);
      if inside {
        let base = r *sat stride;
        let index = base +sat c;
        if index < length {
          set cells^.inner[index] = 1_u8;
        }
      }
    }
  }
  return unit;
}

fn grid_place(model: &GridModel, dense: Bool, explicit_rows: i32, explicit_columns: i32) -> size: GridSize writes(model) {
  doc "CSS Grid 8.5's item placement algorithm for row flow, in the order of the model's sequence: items with both lines definite are placed; items with a definite row go to the first free columns, past the earlier items of their row unless dense; the implicit grid's columns are counted; then the rest are placed by an auto-placement cursor, which a definite column moves down to the column's next free rows. An item's start counts from the first implicit track on return, and the result is the implicit grid's size.";
  let count = model^.sequence.inner.len;
  let row_low = 0_i32;
  let column_low = 0_i32;
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      if item.row_definite {
        set row_low = imin(row_low, item.row);
      }
      if item.column_definite {
        set column_low = imin(column_low, item.column);
      }
    }
  }
  let row_origin = 0_i32 -sat row_low;
  let column_origin = 0_i32 -sat column_low;
  let row_known = row_origin +sat explicit_rows;
  let column_known = column_origin +sat explicit_columns;
  let row_locked_columns = 0_i32;
  let widest_auto = 1_i32;
  let auto_rows = 0_i32;
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      if item.row_definite {
        set item.row = item.row +sat row_origin;
        let end = item.row +sat item.rows;
        set row_known = imax(row_known, end);
      } else {
        set auto_rows = auto_rows +sat item.rows;
      }
      if item.column_definite {
        set item.column = item.column +sat column_origin;
        let end = item.column +sat item.columns;
        set column_known = imax(column_known, end);
      } else {
        set widest_auto = imax(widest_auto, item.columns);
        if item.row_definite {
          set row_locked_columns = row_locked_columns +sat item.columns;
        }
      }
      grid_put(items: &model^.items, at: at, item: item);
    }
  }
  let column_room = column_known +sat row_locked_columns;
  let column_total = column_room +sat widest_auto;
  let column_wide = grid_index(value: column_total);
  let column_capped = imin(column_wide, grid_max_tracks);
  let column_cap = imax(column_capped, 1_u64);
  let row_room = row_known +sat auto_rows;
  let row_wide = grid_index(value: row_room);
  let row_capped = imin(row_wide, grid_max_tracks);
  let row_raw = imax(row_capped, 1_u64);
  let cells = row_raw *sat column_cap;
  let row_cap = if cells > grid_max_cells {
    let fitting = grid_max_cells / column_cap;
    give imax(fitting, 1_u64);
  } else {
    give row_raw;
  }
  let slots_raw = row_cap *sat column_cap;
  let slots = imin(slots_raw, grid_max_cells);
  let occupied = box_array_filled::<u8>(count: slots, value: 0_u8);
  let cursor_count = imin(row_cap, grid_max_tracks);
  let cursors = box_array_filled::<i32>(count: cursor_count, value: 0_i32);
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      let both = band(item.row_definite, item.column_definite);
      if both {
        let row = grid_index(value: item.row);
        let column = grid_index(value: item.column);
        let rows = grid_index(value: item.rows);
        let columns = grid_index(value: item.columns);
        grid_mark(cells: &occupied, stride: column_cap, rows_cap: row_cap, row: row, column: column, rows: rows, columns: columns);
        set item.placed = True();
        grid_put(items: &model^.items, at: at, item: item);
      }
    }
  }
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      let open_column = bnot(item.column_definite);
      let locked = band(item.row_definite, open_column);
      if locked {
        let row = grid_index(value: item.row);
        let rows = grid_index(value: item.rows);
        let columns = grid_index(value: item.columns);
        let floor = if dense {
          give 0_u64;
        } else if row < cursors.inner.len {
          let remembered = cursors.inner[row];
          give grid_index(value: remembered);
        } else {
          give 0_u64;
        }
        let found = column_cap;
        for (k in floor..column_cap) {
          let clear = grid_free(cells: &occupied, stride: column_cap, rows_cap: row_cap, row: row, column: k, rows: rows, columns: columns);
          if clear {
            set found = k;
            break;
          }
        }
        grid_mark(cells: &occupied, stride: column_cap, rows_cap: row_cap, row: row, column: found, rows: rows, columns: columns);
        let narrow = grid_small(value: found);
        set item.column = narrow;
        set item.placed = True();
        grid_put(items: &model^.items, at: at, item: item);
        if row < cursors.inner.len {
          let past = narrow +sat item.columns;
          set cursors.inner[row] = past;
        }
      }
    }
  }
  let column_count = column_origin +sat explicit_columns;
  let spans = 1_i32;
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      let end = item.column +sat item.columns;
      if item.placed {
        set column_count = imax(column_count, end);
      } else if item.column_definite {
        set column_count = imax(column_count, end);
      } else {
        set spans = imax(spans, item.columns);
      }
    }
  }
  set column_count = imax(column_count, spans);
  let cursor_row = 0_u64;
  let cursor_column = 0_u64;
  let rows_wide = grid_index(value: row_origin);
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      let pending = bnot(item.placed);
      if pending {
        let rows = grid_index(value: item.rows);
        let columns = grid_index(value: item.columns);
        if item.column_definite {
          let column = grid_index(value: item.column);
          if dense {
            set cursor_row = 0_u64;
          } else if column < cursor_column {
            set cursor_row = cursor_row +sat 1_u64;
          }
          set cursor_column = column;
          let limit = row_cap +sat 1_u64;
          for (k in 0_u64..limit) {
            let clear = grid_free(cells: &occupied, stride: column_cap, rows_cap: row_cap, row: cursor_row, column: column, rows: rows, columns: columns);
            if clear {
              break;
            }
            set cursor_row = cursor_row +sat 1_u64;
          }
        } else {
          if dense {
            set cursor_row = 0_u64;
            set cursor_column = 0_u64;
          }
          let wide_columns = grid_index(value: column_count);
          let steps = row_cap *sat column_cap;
          let limit = steps +sat 2_u64;
          for (k in 0_u64..limit) {
            let reach = cursor_column +sat columns;
            if reach > wide_columns {
              set cursor_row = cursor_row +sat 1_u64;
              set cursor_column = 0_u64;
            } else {
              let clear = grid_free(cells: &occupied, stride: column_cap, rows_cap: row_cap, row: cursor_row, column: cursor_column, rows: rows, columns: columns);
              if clear {
                break;
              }
              set cursor_column = cursor_column +sat 1_u64;
            }
          }
          let placed_column = grid_small(value: cursor_column);
          set item.column = placed_column;
        }
        let placed_row = grid_small(value: cursor_row);
        set item.row = placed_row;
        set item.placed = True();
        let mark_column = grid_index(value: item.column);
        grid_mark(cells: &occupied, stride: column_cap, rows_cap: row_cap, row: cursor_row, column: mark_column, rows: rows, columns: columns);
        grid_put(items: &model^.items, at: at, item: item);
      }
    }
  }
  let row_count = row_origin +sat explicit_rows;
  for (s in 0_u64..count) {
    if s < model^.sequence.inner.len {
      let child = model^.sequence.inner[s];
      let at = cvt::<u32, u64>(child);
      let item = grid_get(items: &model^.items, at: at);
      let end = item.row +sat item.rows;
      set row_count = imax(row_count, end);
      let column_end = item.column +sat item.columns;
      set column_count = imax(column_count, column_end);
    }
  }
  let rows_capped = imin(row_count, 1000_i32);
  let columns_capped = imin(column_count, 1000_i32);
  return GridSize(rows: rows_capped, columns: columns_capped, row_origin: row_origin, column_origin: column_origin);
}

fn grid_axis_of(item: GridItem, rows: Bool) -> (start: i32, span: i32) pure {
  doc "The item's start track and span along the rows' axis, or the columns'.";
  if rows {
    return item.row, item.rows;
  }
  return item.column, item.columns;
}

fn grid_build_tracks(styles: &Styles, def: GridDef, tracks: &Box<Slots<GridTrack>>, items: &Box<Slots<GridItem>>, rows: Bool, total: i32, origin: i32, basis: i32, gap: i32) -> result: unit reads(styles), reads(items), writes(tracks) {
  doc "Makes the tracks of one axis of the implicit grid from the template and the pattern of implicit tracks, marks those an item covers, collapses the auto-fit repetitions no item covers, and sets each track's gutter before it.";
  let count = grid_index(value: total);
  let wide_origin = grid_index(value: origin);
  for (k in 0_u64..count) {
    let made = grid_track_at(styles: styles, def: def, at: k, origin: wide_origin, basis: basis);
    let pushed = push_item::<GridTrack>(cell: tracks, value: made, ceiling: item_ceiling);
  }
  let items_count = items^.inner.len;
  for (c in 0_u64..items_count) {
    let item = items^.inner[c];
    if item.active {
      let (start, span) = grid_axis_of(item: item, rows: rows);
      let first = grid_index(value: start);
      let width = grid_index(value: span);
      let end = first +sat width;
      for (k in first..end) {
        if k < tracks^.inner.len {
          set tracks^.inner[k].used = True();
        }
      }
    }
  }
  let before = grid_before(def: def);
  let each = def.repeat_end -sat def.repeat_first;
  let repeated = each *sat def.repeats;
  let has_repeats = def.repeats > 0_u64;
  let collapsing = band(def.fit, has_repeats);
  if collapsing {
    let low = wide_origin +sat before;
    let high = low +sat repeated;
    for (k in low..high) {
      if k < tracks^.inner.len {
        if tracks^.inner[k].used {
        } else {
          set tracks^.inner[k].collapsed = True();
          set tracks^.inner[k].min_kind = track_length;
          set tracks^.inner[k].min_size = 0_i32;
          set tracks^.inner[k].max_kind = track_length;
          set tracks^.inner[k].max_size = 0_i32;
          set tracks^.inner[k].flex = 0.0_f32;
          set tracks^.inner[k].fit = False();
        }
      }
    }
  }
  let length = tracks^.inner.len;
  let seen = False();
  for (k in 0_u64..length) {
    let hidden = tracks^.inner[k].collapsed;
    let visible = bnot(hidden);
    let show = band(visible, seen);
    if show {
      set tracks^.inner[k].gap = gap;
    } else {
      set tracks^.inner[k].gap = 0_i32;
    }
    if visible {
      set seen = True();
    }
  }
  return unit;
}

fn grid_affected(track: GridTrack, select: u8) -> hit: Bool pure {
  doc "Whether a sizing step applies to track: step 0 to every track, 1 to a track whose minimum is auto, min-content or max-content, 2 to min-content, 7 to max-content, 3 to auto or max-content, 4 to a track whose maximum is auto, min-content or max-content, 5 to auto or max-content, 6 to auto.";
  let min_auto = track.min_kind == track_auto;
  let min_min = track.min_kind == track_min_content;
  let min_max = track.min_kind == track_max_content;
  let max_auto = track.max_kind == track_auto;
  let max_min = track.max_kind == track_min_content;
  let max_max = track.max_kind == track_max_content;
  if select == 0_u8 {
    return True();
  }
  if select == grid_select_intrinsic_min {
    let pair = bor(min_auto, min_min);
    let made = bor(pair, min_max);
    return made;
  }
  if select == grid_select_content_min {
    return min_min;
  }
  if select == 7_u8 {
    return min_max;
  }
  if select == grid_select_max_content_min {
    let made = bor(min_auto, min_max);
    return made;
  }
  if select == grid_select_intrinsic_max {
    let pair = bor(max_auto, max_min);
    let made = bor(pair, max_max);
    return made;
  }
  if select == grid_select_max_content_max {
    let made = bor(max_auto, max_max);
    return made;
  }
  if select == 6_u8 {
    let plain = bnot(track.fit);
    let made = band(max_auto, plain);
    return made;
  }
  return False();
}

fn grid_intrinsic_max(track: GridTrack) -> hit: Bool pure {
  doc "Whether track's maximum sizing function is auto, min-content or max-content.";
  let made = grid_affected(track: track, select: grid_select_intrinsic_max);
  return made;
}

fn grid_sum(tracks: &Box<Slots<GridTrack>>, first: u64, end: u64, limits: Bool) -> sum: i32 reads(tracks) {
  doc "The sizes of the tracks from first to end, base sizes or growth limits (an infinite limit counted at its base size), with the gutters between them.";
  let length = tracks^.inner.len;
  let total = 0_i32;
  for (k in first..end) {
    if k < length {
      let track = tracks^.inner[k];
      if k > first {
        set total = total +sat track.gap;
      }
      let infinite = track.limit >= grid_infinite;
      let size = if limits {
        if infinite {
          give track.base;
        } else {
          give track.limit;
        }
      } else {
        give track.base;
      }
      set total = total +sat size;
    }
  }
  return total;
}

fn grid_sum_flexless(tracks: &Box<Slots<GridTrack>>, first: u64, end: u64) -> sum: i32 reads(tracks) {
  doc "The base sizes of the tracks from first to end that are not flexible, with all the gutters between them.";
  let length = tracks^.inner.len;
  let total = 0_i32;
  for (k in first..end) {
    if k < length {
      let track = tracks^.inner[k];
      if k > first {
        set total = total +sat track.gap;
      }
      let flexible = track.max_kind == track_flex;
      if flexible {
      } else {
        set total = total +sat track.base;
      }
    }
  }
  return total;
}

fn grid_spans_flex(tracks: &Box<Slots<GridTrack>>, first: u64, end: u64) -> flexible: Bool reads(tracks) {
  doc "Whether one of the tracks from first to end is flexible.";
  let length = tracks^.inner.len;
  for (k in first..end) {
    if k < length {
      if tracks^.inner[k].max_kind == track_flex {
        return True();
      }
    }
  }
  return False();
}

fn grid_room(track: GridTrack, to_limit: Bool, caps: Bool) -> room: i32 pure {
  doc "How much more a distribution may add to the track: nothing more once its base size reaches its growth limit when distributing base sizes with caps, unlimited otherwise.";
  if to_limit {
    return grid_infinite;
  }
  if caps {
    let finite = track.limit < grid_infinite;
    if finite {
      let used = track.base +sat track.share;
      let left = track.limit -sat used;
      let made = imax(left, 0_i32);
      return made;
    }
  }
  return grid_infinite;
}

fn grid_spread(tracks: &[GridTrack], first: u64, end: u64, space: i32, select: u8, to_limit: Bool, caps: Bool, beyond: Bool) -> result: unit writes(tracks) {
  doc "Distributes space equally among the affected tracks from first to end into their share (CSS Grid 11.5.1): each track takes its part up to its growth limit when caps holds and the distribution is to base sizes; when space is left and beyond holds, it is spread over the affected tracks that have an intrinsic maximum, or all affected tracks, without limits.";
  let length = tracks^.len;
  for (k in first..end) {
    if k < length {
      set tracks^[k].share = 0_i32;
    }
  }
  let remaining = space;
  let span = end -sat first;
  let rounds = span +sat 2_u64;
  for (round in 0_u64..rounds) {
    let open = 0_i32;
    for (k in first..end) {
      if k < length {
        let track = tracks^[k];
        let hit = grid_affected(track: track, select: select);
        let room = grid_room(track: track, to_limit: to_limit, caps: caps);
        let has_room = room > 0_i32;
        let counted = band(hit, has_room);
        if counted {
          set open = open +sat 1_i32;
        }
      }
    }
    if open == 0_i32 {
      break;
    }
    if remaining <= 0_i32 {
      break;
    }
    let each = grid_div(value: remaining, divisor: open);
    let spent = each *sat open;
    let rest = remaining -sat spent;
    let extra = rest;
    for (k in first..end) {
      if k < length {
        let track = tracks^[k];
        let hit = grid_affected(track: track, select: select);
        let room = grid_room(track: track, to_limit: to_limit, caps: caps);
        let has_room = room > 0_i32;
        let counted = band(hit, has_room);
        if counted {
          let bonus = if extra > 0_i32 {
            give 1_i32;
          } else {
            give 0_i32;
          }
          set extra = extra -sat bonus;
          let want = each +sat bonus;
          let given = imin(want, room);
          set tracks^[k].share = tracks^[k].share +sat given;
          set remaining = remaining -sat given;
        }
      }
    }
  }
  if beyond {
    if remaining > 0_i32 {
      let targets = 0_i32;
      let all = 0_i32;
      for (k in first..end) {
        if k < length {
          let track = tracks^[k];
          let hit = grid_affected(track: track, select: select);
          let intrinsic = grid_intrinsic_max(track: track);
          let both = band(hit, intrinsic);
          if both {
            set targets = targets +sat 1_i32;
          }
          if hit {
            set all = all +sat 1_i32;
          }
        }
      }
      let preferred = targets > 0_i32;
      let count = if preferred {
        give targets;
      } else {
        give all;
      }
      if count > 0_i32 {
        let each = grid_div(value: remaining, divisor: count);
        let spent = each *sat count;
        let rest = remaining -sat spent;
        let extra = rest;
        for (k in first..end) {
          if k < length {
            let track = tracks^[k];
            let hit = grid_affected(track: track, select: select);
            let intrinsic = grid_intrinsic_max(track: track);
            let both = band(hit, intrinsic);
            let chosen = if preferred {
              give both;
            } else {
              give hit;
            }
            if chosen {
              let bonus = if extra > 0_i32 {
                give 1_i32;
              } else {
                give 0_i32;
              }
              set extra = extra -sat bonus;
              let want = each +sat bonus;
              set tracks^[k].share = tracks^[k].share +sat want;
            }
          }
        }
      }
    }
  }
  return unit;
}

fn grid_spread_flex(tracks: &[GridTrack], first: u64, end: u64, space: i32, select: u8) -> result: unit writes(tracks) {
  doc "Distributes space over the flexible tracks from first to end that have an intrinsic minimum, in proportion to their flex factors (CSS Grid 11.5, step 4), into their share.";
  let length = tracks^.len;
  let total = 0.0_f32;
  for (k in first..end) {
    if k < length {
      set tracks^[k].share = 0_i32;
      let track = tracks^[k];
      let flexible = track.max_kind == track_flex;
      let intrinsic = grid_affected(track: track, select: select);
      let both = band(flexible, intrinsic);
      if both {
        set total = fadd.strict(total, track.flex);
      }
    }
  }
  let positive = fgt(total, 0.0_f32);
  if positive {
    let wide = grid_float(value: space);
    let given = 0_i32;
    let leader = length;
    for (k in first..end) {
      if k < length {
        let track = tracks^[k];
        let flexible = track.max_kind == track_flex;
        let intrinsic = grid_affected(track: track, select: select);
        let both = band(flexible, intrinsic);
        if both {
          let ratio = fdiv.strict(track.flex, total);
          let part = fmul.strict(wide, ratio);
          let whole = grid_floor(value: part);
          set tracks^[k].share = whole;
          set given = given +sat whole;
          if leader == length {
            set leader = k;
          }
        }
      }
    }
    let left = space -sat given;
    if leader < length {
      if left > 0_i32 {
        set tracks^[leader].share = tracks^[leader].share +sat left;
      }
    }
  }
  return unit;
}

fn grid_apply(tracks: &Box<Slots<GridTrack>>, to_limit: Bool) -> result: unit writes(tracks) {
  doc "Adds the planned increases to the base sizes, or to the growth limits (an infinite limit becoming its base size plus the increase), and clears them.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let planned = tracks^.inner[k].planned;
    let touched = tracks^.inner[k].touched;
    let grown = planned > 0_i32;
    let changed = bor(touched, grown);
    if changed {
      if to_limit {
        let infinite = tracks^.inner[k].limit >= grid_infinite;
        if infinite {
          set tracks^.inner[k].limit = tracks^.inner[k].base +sat planned;
        } else {
          set tracks^.inner[k].limit = tracks^.inner[k].limit +sat planned;
        }
      } else {
        set tracks^.inner[k].base = tracks^.inner[k].base +sat planned;
      }
      set tracks^.inner[k].planned = 0_i32;
      set tracks^.inner[k].touched = False();
    }
  }
  return unit;
}

fn grid_proposal_length(tracks: &Box<Slots<GridTrack>>, item: GridItem, rows: Bool, group: i32) -> length: u64 reads(tracks) {
  let live = band(item.active, item.needs);
  if live {
    let (start, span) = grid_axis_of(item: item, rows: rows);
    let first = grid_index(value: start);
    let width = grid_index(value: span);
    let reach = first +sat width;
    let end = imin(reach, tracks^.inner.len);
    let flexy = grid_spans_flex(tracks: tracks, first: first, end: end);
    let plain = bnot(flexy);
    let same = span == group;
    let grouped = band(same, plain);
    let wanted = if group == 0_i32 {
      give flexy;
    } else {
      give grouped;
    }
    if wanted {
      return end -sat first;
    }
  }
  return 0_u64;
}

fn grid_propose(tracks: &Box<Slots<GridTrack>>, item: GridItem, rows: Bool, group: i32, select: u8, to_limit: Bool, which: u8, proposal: &[GridTrack]) -> result: unit reads(tracks), writes(proposal) {
  doc "One item's distribution owns only its spanned tracks. All items read the same phase bases and limits; water-filling rounds and numeric remainders retain their true dependencies inside this proposal.";
  let count = proposal^.len;
  if count == 0_u64 {
    return unit;
  }
  let (start, span) = grid_axis_of(item: item, rows: rows);
  let first = grid_index(value: start);
  for (k in 0_u64..count) {
    let at = first +sat k;
    if at < tracks^.inner.len {
      set proposal^[k] = tracks^.inner[at];
      set proposal^[k].share = 0_i32;
      let affected = grid_affected(track: proposal^[k], select: select);
      set proposal^[k].touched = band(to_limit, affected);
    }
  }
  let contribution = if which == 0_u8 {
    give item.minimum;
  } else if which == 1_u8 {
    give item.least;
  } else {
    give item.most;
  }
  let end = first +sat count;
  let basis = grid_sum(tracks: tracks, first: first, end: end, limits: to_limit);
  let space = contribution -sat basis;
  if space > 0_i32 {
    if group == 0_i32 {
      grid_spread_flex(tracks: proposal, first: 0_u64, end: count, space: space, select: select);
    } else {
      let to_base = bnot(to_limit);
      grid_spread(tracks: proposal, first: 0_u64, end: count, space: space, select: select, to_limit: to_limit, caps: to_base, beyond: to_base);
    }
  }
  return unit;
}

fn grid_reduce_proposals(proposals: &Box<Segments<GridTrack>>, items: &Box<Slots<GridItem>>, rows: Bool, track: u64, first: u64, end: u64) -> (increase: i32, touched: Bool) reads(proposals), reads(items) {
  doc "Balanced maximum/OR reduction for one track. No item's proposal depends on another item's scratch.";
  let count = end -sat first;
  if count == 0_u64 {
    return 0_i32, False();
  }
  if count == 1_u64 {
    if first < items^.inner.len {
      if first < proposals^.inner.len {
        let (start, span) = grid_axis_of(item: items^.inner[first], rows: rows);
        let origin = grid_index(value: start);
        if track >= origin {
          let at = track - origin;
          if at < proposals^.inner[first].len {
            let proposal = proposals^.inner[first][at];
            return proposal.share, proposal.touched;
          }
        }
      }
    }
    return 0_i32, False();
  }
  let half = count / 2_u64;
  let middle = first +sat half;
  let (left, left_touched) = grid_reduce_proposals(proposals: proposals, items: items, rows: rows, track: track, first: first, end: middle);
  let (right, right_touched) = grid_reduce_proposals(proposals: proposals, items: items, rows: rows, track: track, first: middle, end: end);
  let increase = imax(left, right);
  let touched = bor(left_touched, right_touched);
  return increase, touched;
}

fn grid_pass(tracks: &Box<Slots<GridTrack>>, items: &Box<Slots<GridItem>>, rows: Bool, group: i32, select: u8, to_limit: Bool, which: u8) -> result: unit reads(items), writes(tracks) {
  doc "One intrinsic phase/span group: independent item-owned proposals, balanced per-track maximum/OR reductions, then independent track application. Later phases consume the applied bases and limits.";
  let count = items^.inner.len;
  let lengths = box_array_filled::<u64>(count: count, value: 0_u64);
  for (c in 0_u64..count) {
    set lengths.inner[c] = grid_proposal_length(tracks: tracks, item: items^.inner[c], rows: rows, group: group);
  }
  let empty = grid_auto_track();
  let proposals = box_segments_filled::<GridTrack>(lengths: &lengths.inner[0_u64..count], value: empty);
  for (c in 0_u64..count) {
    let span = proposals.inner[c].len;
    grid_propose(tracks: tracks, item: items^.inner[c], rows: rows, group: group, select: select, to_limit: to_limit, which: which, proposal: &proposals.inner[c][0_u64..span]);
  }
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let (increase, touched) = grid_reduce_proposals(proposals: &proposals, items: items, rows: rows, track: k, first: 0_u64, end: count);
    set tracks^.inner[k].planned = increase;
    set tracks^.inner[k].touched = touched;
  }
  grid_apply(tracks: tracks, to_limit: to_limit);
  return unit;
}

fn grid_expand_definite(tracks: &Box<Slots<GridTrack>>, avail: i32) -> result: unit writes(tracks) {
  doc "Expands the flexible tracks in the definite size avail (CSS Grid 11.7.1): the flex fraction is what is left after the inflexible tracks and gutters, over the flex factors' sum (at least one); a track whose share would be less than its base size becomes inflexible, and the fraction is found again.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    set tracks^.inner[k].share = 0_i32;
  }
  let fraction = 0.0_f32;
  let rounds = length +sat 1_u64;
  for (round in 0_u64..rounds) {
    let gaps = grid_sum_gaps(tracks: tracks);
    let fixed = 0_i32;
    let sum = 0.0_f32;
    let flexible = 0_i32;
    for (k in 0_u64..length) {
      let track = tracks^.inner[k];
      let flexing = track.max_kind == track_flex;
      let unsettled = track.share == 0_i32;
      let active = band(flexing, unsettled);
      if active {
        set sum = fadd.strict(sum, track.flex);
        set flexible = flexible +sat 1_i32;
      } else {
        set fixed = fixed +sat track.base;
      }
    }
    if flexible == 0_i32 {
      break;
    }
    let low = flt(sum, 1.0_f32);
    if low {
      set sum = 1.0_f32;
    }
    let taken = fixed +sat gaps;
    let leftover = avail -sat taken;
    let wide = grid_float(value: leftover);
    set fraction = fdiv.strict(wide, sum);
    let changed = False();
    for (k in 0_u64..length) {
      let track = tracks^.inner[k];
      let flexing = track.max_kind == track_flex;
      let unsettled = track.share == 0_i32;
      let active = band(flexing, unsettled);
      if active {
        let size = fmul.strict(fraction, track.flex);
        let base = grid_float(value: track.base);
        let short = flt(size, base);
        if short {
          set tracks^.inner[k].share = 1_i32;
          set changed = True();
        }
      }
    }
    if changed {
    } else {
      break;
    }
  }
  for (k in 0_u64..length) {
    let track = tracks^.inner[k];
    let flexing = track.max_kind == track_flex;
    let unsettled = track.share == 0_i32;
    let active = band(flexing, unsettled);
    if active {
      let size = fmul.strict(fraction, track.flex);
      let whole = grid_floor(value: size);
      let larger = imax(track.base, whole);
      set tracks^.inner[k].base = larger;
      set tracks^.inner[k].limit = larger;
    }
    set tracks^.inner[k].share = 0_i32;
  }
  return unit;
}

fn grid_sum_gaps(tracks: &Box<Slots<GridTrack>>) -> sum: i32 reads(tracks) {
  doc "The gutters between all the tracks.";
  let length = tracks^.inner.len;
  let total = 0_i32;
  for (k in 1_u64..length) {
    set total = total +sat tracks^.inner[k].gap;
  }
  return total;
}

fn grid_expand_intrinsic(tracks: &Box<Slots<GridTrack>>, items: &Box<Slots<GridItem>>, rows: Bool, minimum: Bool) -> result: unit reads(items), writes(tracks) {
  doc "Expands the flexible tracks when there is no definite size to fill (CSS Grid 11.7.1): the flex fraction is the largest of each flexible track's base size per flex factor and, for each item that spans a flexible track, the fraction its min-content (when sizing under a min-content constraint) or max-content contribution needs after the inflexible tracks and gutters it spans.";
  let length = tracks^.inner.len;
  let fraction = 0.0_f32;
  for (k in 0_u64..length) {
    let track = tracks^.inner[k];
    let flexing = track.max_kind == track_flex;
    if flexing {
      let base = grid_float(value: track.base);
      let more = fgt(track.flex, 1.0_f32);
      let ratio = if more {
        give fdiv.strict(base, track.flex);
      } else {
        give base;
      }
      set fraction = fmax(fraction, ratio);
    }
  }
  let count = items^.inner.len;
  for (c in 0_u64..count) {
    let item = items^.inner[c];
    let live = band(item.active, item.needs);
    if live {
      let (start, span) = grid_axis_of(item: item, rows: rows);
      let first = grid_index(value: start);
      let width = grid_index(value: span);
      let reach = first +sat width;
      let end = imin(reach, length);
      let flexy = grid_spans_flex(tracks: tracks, first: first, end: end);
      if flexy {
        let contribution = if minimum {
          give item.least;
        } else {
          give item.most;
        }
        let fixed = grid_sum_flexless(tracks: tracks, first: first, end: end);
        let leftover = contribution -sat fixed;
        let sum = 0.0_f32;
        for (k in first..end) {
          if k < length {
            let track = tracks^.inner[k];
            let flexing = track.max_kind == track_flex;
            if flexing {
              set sum = fadd.strict(sum, track.flex);
            }
          }
        }
        let low = flt(sum, 1.0_f32);
        if low {
          set sum = 1.0_f32;
        }
        let wide = grid_float(value: leftover);
        let share = fdiv.strict(wide, sum);
        set fraction = fmax(fraction, share);
      }
    }
  }
  for (k in 0_u64..length) {
    let track = tracks^.inner[k];
    let flexing = track.max_kind == track_flex;
    if flexing {
      let size = fmul.strict(fraction, track.flex);
      let whole = grid_floor(value: size);
      let larger = imax(track.base, whole);
      set tracks^.inner[k].base = larger;
      set tracks^.inner[k].limit = larger;
    }
  }
  return unit;
}

fn grid_size(tracks: &Box<Slots<GridTrack>>, items: &Box<Slots<GridItem>>, rows: Bool, avail: i32, mode: u8, stretch: Bool) -> result: unit reads(items), writes(tracks) {
  doc "CSS Grid 11's track sizing algorithm for one axis, given each item's contributions in the axis: initializes the tracks, resolves the intrinsic sizes grouped by span, maximizes the tracks in the definite size avail (negative when indefinite), expands the flexible tracks, and stretches the auto tracks when stretch holds. mode is grid_mode_definite, or grid_mode_min or grid_mode_max for the container's min-content or max-content size, where no free space is divided and the max-content size takes every track to its growth limit.";
  let no = False();
  let yes = True();
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let track = tracks^.inner[k];
    let fixed_min = track.min_kind == track_length;
    let base = if fixed_min {
      give track.min_size;
    } else {
      give 0_i32;
    }
    let fixed_max = track.max_kind == track_length;
    let limit_raw = if fixed_max {
      give track.max_size;
    } else {
      give grid_infinite;
    }
    let limit = imax(limit_raw, base);
    set tracks^.inner[k].base = base;
    set tracks^.inner[k].limit = limit;
    set tracks^.inner[k].planned = 0_i32;
    set tracks^.inner[k].share = 0_i32;
  }
  let count = items^.inner.len;
  let widest = 0_i32;
  for (c in 0_u64..count) {
    let item = items^.inner[c];
    let live = band(item.active, item.needs);
    if live {
      let (start, span) = grid_axis_of(item: item, rows: rows);
      set widest = imax(widest, span);
    }
  }
  let widest_wide = grid_index(value: widest);
  let groups = widest_wide +sat 1_u64;
  let maximal = mode == grid_mode_max;
  for (step in 1_u64..groups) {
    let group = grid_small(value: step);
    grid_pass(tracks: tracks, items: items, rows: rows, group: group, select: grid_select_intrinsic_min, to_limit: no, which: 0_u8);
    grid_pass(tracks: tracks, items: items, rows: rows, group: group, select: grid_select_content_min, to_limit: no, which: 1_u8);
    grid_pass(tracks: tracks, items: items, rows: rows, group: group, select: 7_u8, to_limit: no, which: 2_u8);
    if maximal {
      grid_pass(tracks: tracks, items: items, rows: rows, group: group, select: grid_select_max_content_min, to_limit: no, which: 2_u8);
    }
    grid_raise_limits(tracks: tracks);
    grid_pass(tracks: tracks, items: items, rows: rows, group: group, select: grid_select_intrinsic_max, to_limit: yes, which: 1_u8);
    grid_pass(tracks: tracks, items: items, rows: rows, group: group, select: grid_select_max_content_max, to_limit: yes, which: 2_u8);
  }
  grid_clamp_fit(tracks: tracks);
  grid_pass(tracks: tracks, items: items, rows: rows, group: 0_i32, select: grid_select_intrinsic_min, to_limit: no, which: 0_u8);
  grid_pass(tracks: tracks, items: items, rows: rows, group: 0_i32, select: 7_u8, to_limit: no, which: 2_u8);
  grid_close_limits(tracks: tracks);
  let definite = mode == grid_mode_definite;
  if definite {
    let all = tracks^.inner.len;
    let used = grid_sum(tracks: tracks, first: 0_u64, end: all, limits: no);
    let free = avail -sat used;
    if free > 0_i32 {
      grid_spread(tracks: &tracks^.inner[0_u64..all], first: 0_u64, end: all, space: free, select: 0_u8, to_limit: no, caps: yes, beyond: no);
      grid_add_shares(tracks: tracks);
    }
    grid_expand_definite(tracks: tracks, avail: avail);
    if stretch {
      let rest = tracks^.inner.len;
      let spent = grid_sum(tracks: tracks, first: 0_u64, end: rest, limits: no);
      let room = avail -sat spent;
      if room > 0_i32 {
        grid_spread(tracks: &tracks^.inner[0_u64..rest], first: 0_u64, end: rest, space: room, select: 6_u8, to_limit: yes, caps: no, beyond: no);
        grid_add_shares(tracks: tracks);
      }
    }
  } else {
    if maximal {
      grid_base_to_limit(tracks: tracks);
    }
    let minimum = mode == grid_mode_min;
    grid_expand_intrinsic(tracks: tracks, items: items, rows: rows, minimum: minimum);
  }
  return unit;
}

fn grid_raise_limits(tracks: &Box<Slots<GridTrack>>) -> result: unit writes(tracks) {
  doc "Raises each growth limit that is below its base size to it.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    if tracks^.inner[k].limit < tracks^.inner[k].base {
      set tracks^.inner[k].limit = tracks^.inner[k].base;
    }
  }
  return unit;
}

fn grid_clamp_fit(tracks: &Box<Slots<GridTrack>>) -> result: unit writes(tracks) {
  doc "Limits the growth limit of each fit-content() track to its argument, but not below its base size.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let track = tracks^.inner[k];
    if track.fit {
      let capped = imin(track.limit, track.fit_limit);
      let raised = imax(capped, track.base);
      set tracks^.inner[k].limit = raised;
    }
  }
  return unit;
}

fn grid_close_limits(tracks: &Box<Slots<GridTrack>>) -> result: unit writes(tracks) {
  doc "Gives each track whose growth limit is still infinite its base size as limit.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let infinite = tracks^.inner[k].limit >= grid_infinite;
    if infinite {
      set tracks^.inner[k].limit = tracks^.inner[k].base;
    }
    if tracks^.inner[k].limit < tracks^.inner[k].base {
      set tracks^.inner[k].limit = tracks^.inner[k].base;
    }
  }
  return unit;
}

fn grid_add_shares(tracks: &Box<Slots<GridTrack>>) -> result: unit writes(tracks) {
  doc "Adds each track's share to its base size and clears it.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let more = tracks^.inner[k].share;
    set tracks^.inner[k].base = tracks^.inner[k].base +sat more;
    set tracks^.inner[k].share = 0_i32;
  }
  return unit;
}

fn grid_base_to_limit(tracks: &Box<Slots<GridTrack>>) -> result: unit writes(tracks) {
  doc "Takes every inflexible track to its growth limit, as sizing under a max-content constraint does.";
  let length = tracks^.inner.len;
  for (k in 0_u64..length) {
    let flexing = tracks^.inner[k].max_kind == track_flex;
    if flexing {
    } else {
      set tracks^.inner[k].base = tracks^.inner[k].limit;
    }
  }
  return unit;
}

struct GridContribution {
  doc "An item's contributions to a track along one axis, as margin-box sizes: its min-content, its max-content and its minimum contribution (its minimum size).";
  least: i32;
  most: i32;
  minimum: i32;
}

fn grid_area_dims(styles: &Styles, areas: u32) -> (rows: i32, columns: i32) reads(styles) {
  doc "The rows and columns of the area map areas, zero for none.";
  let at = cvt::<u32, u64>(areas);
  if at < styles^.area_maps.inner.len {
    let map = styles^.area_maps.inner[at];
    let wide_rows = cvt::<u32, u64>(map.rows);
    let wide_columns = cvt::<u32, u64>(map.columns);
    let rows = grid_small(value: wide_rows);
    let columns = grid_small(value: wide_columns);
    return rows, columns;
  }
  return 0_i32, 0_i32;
}

fn grid_choose(own: u8, inherited: u8) -> value: u8 pure {
  doc "A self-alignment value: the item's, or the container's items value when the item's is auto.";
  if own == align_auto {
    return inherited;
  }
  return own;
}

fn grid_kind(value: u8, replaced: Bool) -> kind: u8 pure {
  doc "What an alignment value does to an item along its axis: 0 places it at the start, 1 at the end, 2 in the center, 3 stretches it. normal stretches a box and places a replaced box at the start; start and the values that mean it in a left-to-right horizontal grid, and baseline alignment, place it at the start.";
  if value == align_normal {
    if replaced {
      return 0_u8;
    }
    return 3_u8;
  }
  if value == align_auto {
    if replaced {
      return 0_u8;
    }
    return 3_u8;
  }
  if value == align_legacy {
    if replaced {
      return 0_u8;
    }
    return 3_u8;
  }
  if value == align_stretch {
    return 3_u8;
  }
  if value == align_center {
    return 2_u8;
  }
  let at_end_one = value == align_end;
  let at_end_two = value == align_flex_end;
  let at_end_three = value == align_self_end;
  let at_end_four = value == align_right;
  let end_pair = bor(at_end_one, at_end_two);
  let end_other = bor(at_end_three, at_end_four);
  let at_end = bor(end_pair, end_other);
  if at_end {
    return 1_u8;
  }
  return 0_u8;
}

fn grid_offset(kind: u8, free: i32) -> offset: i32 pure {
  doc "How far an item of a size that leaves free of its area moves from the area's start for an alignment kind from grid_kind.";
  if kind == 1_u8 {
    return free;
  }
  if kind == 2_u8 {
    let made = free / 2_i32;
    return made;
  }
  return 0_i32;
}

fn grid_item_space(styles: &Styles, style: StyleRef, replaced: Bool, justify: u8, align: u8, width: i32, height: i32) -> space: Space reads(styles) {
  doc "The space an item is laid out in inside its grid area of width by height (height negative when not yet known): the area's width as available space and percentage basis, shrinking to fit unless the item stretches across (justify-self stretching, width auto, no auto margin), and a border-box height of the area less the margins, within min-height and max-height, when it stretches down.";
  let sizes = size_of(styles: styles, style: style);
  let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
  let width_auto = sizes.width.kind == sizing_auto;
  let height_auto = sizes.height.kind == sizing_auto;
  let across = grid_kind(value: justify, replaced: replaced);
  let down = grid_kind(value: align, replaced: replaced);
  let across_stretch = across == 3_u8;
  let down_stretch = down == 3_u8;
  let free_left = bnot(auto_left);
  let free_right = bnot(auto_right);
  let free_top = bnot(auto_top);
  let free_bottom = bnot(auto_bottom);
  let free_across = band(free_left, free_right);
  let free_down = band(free_top, free_bottom);
  let known = height >= 0_i32;
  let stretch_width_a = band(across_stretch, width_auto);
  let stretch_width = band(stretch_width_a, free_across);
  let stretch_height_a = band(down_stretch, height_auto);
  let stretch_height_b = band(stretch_height_a, free_down);
  let stretch_height = band(stretch_height_b, known);
  let shrink = bnot(stretch_width);
  let forced = if stretch_height {
    let border = border_edges(styles: styles, style: style);
    let padding = padding_edges(styles: styles, style: style, basis: width);
    let frame_border = vertical(edges: border);
    let frame_padding = vertical(edges: padding);
    let frame = frame_border +sat frame_padding;
    let margins = margin_edges(styles: styles, style: style, basis: width);
    let outer = vertical(edges: margins);
    let (minimum, maximum) = height_limits(styles: styles, style: style, basis: height, frame: frame);
    let room = height -sat outer;
    let target = clamp_size(size: room, minimum: minimum, maximum: maximum);
    let floored = imax(target, frame);
    give floored;
  } else {
    give unknown;
  }
  return Space(available: width, basis_width: width, basis_height: height, forced_width: unknown, forced_height: forced, shrink: shrink);
}

fn grid_place_axis(kind: u8, start: i32, area: i32, size: i32, margin_start: i32, margin_end: i32, auto_start: Bool, auto_end: Bool) -> position: i32 pure {
  doc "Where an item's border box starts along an axis, given the start and size of its area, its own size and margins, and what its alignment does (grid_kind): auto margins take the free space, the item moving to the end for an auto start margin and to the center for two, and do nothing when the item overflows.";
  let outer = margin_start +sat size;
  let used = outer +sat margin_end;
  let free = area -sat used;
  let either = bor(auto_start, auto_end);
  if either {
    let share = if free > 0_i32 {
      if auto_start {
        if auto_end {
          let half = free / 2_i32;
          give half;
        } else {
          give free;
        }
      } else {
        give 0_i32;
      }
    } else {
      give 0_i32;
    }
    let from = start +sat margin_start;
    let made = from +sat share;
    return made;
  }
  let offset = grid_offset(kind: kind, free: free);
  let from = start +sat margin_start;
  let made = from +sat offset;
  return made;
}

fn grid_track_intrinsic(track: GridTrack) -> hit: Bool pure {
  doc "Whether a track's size depends on its items: one of its sizing functions is not a length.";
  let min_length = track.min_kind == track_length;
  let max_length = track.max_kind == track_length;
  let both = band(min_length, max_length);
  let made = bnot(both);
  return made;
}

fn grid_any_intrinsic(tracks: &Box<Slots<GridTrack>>, first: u64, end: u64) -> found: Bool reads(tracks) {
  doc "Whether one of the tracks from first to end is sized by its items.";
  let length = tracks^.inner.len;
  for (k in first..end) {
    if k < length {
      let track = tracks^.inner[k];
      let depends = grid_track_intrinsic(track: track);
      if depends {
        return True();
      }
    }
  }
  return False();
}

fn grid_mark_needs(model: &GridModel, rows: Bool) -> result: unit writes(model) {
  doc "Sets, for each item, whether a track it spans along an axis is sized by its items, and so whether the item's contributions are needed.";
  let count = model^.items.inner.len;
  for (c in 0_u64..count) {
    let item = model^.items.inner[c];
    let found = if item.active {
      let (start, span) = grid_axis_of(item: item, rows: rows);
      let first = grid_index(value: start);
      let width = grid_index(value: span);
      let end = first +sat width;
      if rows {
        give grid_any_intrinsic(tracks: &model^.rows, first: first, end: end);
      } else {
        give grid_any_intrinsic(tracks: &model^.columns, first: first, end: end);
      }
    } else {
      give False();
    }
    set model^.items.inner[c].needs = found;
    set model^.items.inner[c].measured = False();
  }
  return unit;
}

fn grid_measure_column(child: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> made: GridContribution reads(styles), reads(document), reads(fonts), reads(picks), writes(child) {
  doc "An item's contributions to a column: its min-content and max-content widths, which treat a percentage width as auto, and its minimum width, which is min-width when that is a length, zero when the item scrolls and its min-content width otherwise, all with the item's margins, auto margins as zero.";
  let yes = True();
  set child^.space = child_space(available: 0_i32, basis_width: unknown, basis_height: unknown, shrink: yes);
  let (least, most) = intrinsic_sizes(context: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  let style = child^.style;
  let margins = margin_edges(styles: styles, style: style, basis: 0_i32);
  let around = horizontal(edges: margins);
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: 0_i32);
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let (minimum_width, maximum_width) = width_limits(styles: styles, style: style, basis: unknown, frame: frame);
  let group = box_of(styles: styles, style: style);
  let visible = group.overflow_x == overflow_visible;
  let clipped = group.overflow_x == overflow_clip;
  let contained = bor(visible, clipped);
  let scrolls = bnot(contained);
  let inner = if minimum_width >= 0_i32 {
    give minimum_width;
  } else if scrolls {
    give 0_i32;
  } else {
    give least;
  }
  let least_outer = least +sat around;
  let most_outer = most +sat around;
  let minimum_outer = inner +sat around;
  return GridContribution(least: least_outer, most: most_outer, minimum: minimum_outer);
}

fn grid_measure_item(child: &Context, item: &GridItem, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, justify_items: u8, align_items: u8, updating: Bool) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(child), writes(item) {
  doc "Lays an item out at the width of its grid area, its height not yet known, and records its margin-box height as its contributions to the rows it spans.";
  let style = child^.style;
  let group = item_of(styles: styles, style: style);
  let replaced = child^.kind == ctx_replaced;
  let justify = grid_choose(own: group.justify_self, inherited: justify_items);
  let align = grid_choose(own: group.align_self, inherited: align_items);
  set child^.space = grid_item_space(styles: styles, style: style, replaced: replaced, justify: justify, align: align, width: item^.width, height: unknown);
  let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: updating);
  let outer = child^.margin_top +sat child^.margin_bottom;
  let tall = child^.height +sat outer;
  set item^.least = tall;
  set item^.most = tall;
  set item^.minimum = tall;
  let inner = if child^.has_first_baseline {
    give child^.first_baseline;
  } else {
    give child^.height;
  }
  set item^.ascent = child^.margin_top +sat inner;
  set item^.measured = True();
  return unit;
}

fn grid_mark_baselines(context: &Context, styles: &Styles, model: &GridModel, align_items: u8) -> result: unit reads(context), reads(styles), writes(model) {
  doc "Marks items whose first baseline aligns in their starting row, including row-spanning items. They are measured because their baseline ascents contribute to sizing.";
  let count = model^.items.inner.len;
  for (c in 0_u64..count) {
    let item = model^.items.inner[c];
    let shares = if item.active {
      if c < context^.children.inner.len {
        let style = context^.children.inner[c].style;
        let group = item_of(styles: styles, style: style);
        let align = grid_choose(own: group.align_self, inherited: align_items);
        give align == align_baseline;
      } else {
        give False();
      }
    } else {
      give False();
    }
    set model^.items.inner[c].shared = shares;
    set model^.items.inner[c].shim = 0_i32;
    if shares {
      set model^.items.inner[c].needs = True();
    }
  }
  return unit;
}

fn grid_row_ascent(items: &[GridItem], row: i32) -> ascent: i32 reads(items) {
  doc "Balanced maximum of independent item-owned ascent proposals for one row.";
  let count = items^.len;
  if count == 0_u64 {
    return 0_i32;
  }
  if count == 1_u64 {
    let item = items^[0_u64];
    let same = item.row == row;
    let takes = band(item.shared, same);
    if takes {
      return imax(item.ascent, 0_i32);
    }
    return 0_i32;
  }
  let middle = count / 2_u64;
  let left = grid_row_ascent(items: &items^[0_u64..middle], row: row);
  let right = grid_row_ascent(items: &items^[middle..count], row: row);
  return imax(left, right);
}

fn grid_shim_baselines(model: &GridModel) -> result: unit writes(model) {
  doc "Reduces item-owned baseline ascents independently per row, then writes each item's shim and contributions independently. No item updates shared row scratch.";
  let rows = model^.rows.inner.len;
  let slots = imin(rows, grid_max_tracks);
  let tops = box_array_filled::<i32>(count: slots, value: 0_i32);
  let count = model^.items.inner.len;
  for (row in 0_u64..slots) {
    let index = grid_small(value: row);
    set tops.inner[row] = grid_row_ascent(items: &model^.items.inner[0_u64..count], row: index);
  }
  for (c in 0_u64..count) {
    let item = model^.items.inner[c];
    if item.shared {
      let at = grid_index(value: item.row);
      if at < tops.inner.len {
        let shim = tops.inner[at] -sat item.ascent;
        set model^.items.inner[c].shim = shim;
        set model^.items.inner[c].least = item.least +sat shim;
        set model^.items.inner[c].most = item.most +sat shim;
        set model^.items.inner[c].minimum = item.minimum +sat shim;
      }
    }
  }
  return unit;
}

fn grid_distribute(align: u8, free: i32, count: i32) -> (lead: i32, between: i32) pure {
  doc "How the free space around count tracks is shared by justify-content or align-content: the space before the first track, and the extra space between tracks. Start-like values and stretch (whose extra space the sizing algorithm already gave the auto tracks) leave the tracks at the start; the space-* values with no space to share fall back to center.";
  let at_end_one = align == align_end;
  let at_end_two = align == align_flex_end;
  let at_end_three = align == align_self_end;
  let at_end_four = align == align_right;
  let end_pair = bor(at_end_one, at_end_two);
  let end_other = bor(at_end_three, at_end_four);
  let at_end = bor(end_pair, end_other);
  if at_end {
    return free, 0_i32;
  }
  if align == align_center {
    let half = free / 2_i32;
    return half, 0_i32;
  }
  let spare = free > 0_i32;
  if align == align_space_between {
    let several = count > 1_i32;
    let spread = band(spare, several);
    if spread {
      let gaps = count -sat 1_i32;
      let each = grid_div(value: free, divisor: gaps);
      return 0_i32, each;
    }
    return 0_i32, 0_i32;
  }
  if align == align_space_around {
    if spare {
      let each = grid_div(value: free, divisor: count);
      let lead = each / 2_i32;
      return lead, each;
    }
    let half = free / 2_i32;
    return half, 0_i32;
  }
  if align == align_space_evenly {
    if spare {
      let slots = count +sat 1_i32;
      let each = grid_div(value: free, divisor: slots);
      return each, each;
    }
    let half = free / 2_i32;
    return half, 0_i32;
  }
  return 0_i32, 0_i32;
}

fn grid_position(tracks: &Box<Slots<GridTrack>>, avail: i32, align: u8) -> result: unit writes(tracks) {
  doc "Gives each track its offset from the content box's start along the axis: the tracks, gutters and the space align (justify-content or align-content) shares out, within the size avail (no free space when negative).";
  let no = False();
  let length = tracks^.inner.len;
  let total = grid_sum(tracks: tracks, first: 0_u64, end: length, limits: no);
  let free = if avail >= 0_i32 {
    give avail -sat total;
  } else {
    give 0_i32;
  }
  let count = grid_small(value: length);
  let (lead, between) = grid_distribute(align: align, free: free, count: count);
  let cursor = lead;
  for (k in 0_u64..length) {
    let track = tracks^.inner[k];
    if k > 0_u64 {
      let gap = track.gap +sat between;
      set cursor = cursor +sat gap;
    }
    set tracks^.inner[k].position = cursor;
    set cursor = cursor +sat track.base;
  }
  return unit;
}

fn grid_extent(tracks: &Box<Slots<GridTrack>>, first: u64, span: u64) -> (position: i32, extent: i32) reads(tracks) {
  doc "The offset and size of the grid area that spans span tracks from first, from the start of the first to the end of the last.";
  let length = tracks^.inner.len;
  if first < length {
    let reach = first +sat span;
    let end = imin(reach, length);
    let last = end -sat 1_u64;
    let last_at = imax(last, first);
    let start = tracks^.inner[first].position;
    if last_at < length {
      let stop_track = tracks^.inner[last_at];
      let stop = stop_track.position +sat stop_track.base;
      let size = stop -sat start;
      return start, size;
    }
    return start, 0_i32;
  }
  return 0_i32, 0_i32;
}

fn grid_assign(model: &GridModel, rows: Bool) -> result: unit writes(model) {
  doc "Sets each item's grid area along an axis from the offsets and sizes of the tracks it spans.";
  let count = model^.items.inner.len;
  for (c in 0_u64..count) {
    let item = model^.items.inner[c];
    if item.active {
      let (start, span) = grid_axis_of(item: item, rows: rows);
      let first = grid_index(value: start);
      let width = grid_index(value: span);
      if rows {
        let (position, extent) = grid_extent(tracks: &model^.rows, first: first, span: width);
        set model^.items.inner[c].y = position;
        set model^.items.inner[c].height = extent;
      } else {
        let (position, extent) = grid_extent(tracks: &model^.columns, first: first, span: width);
        set model^.items.inner[c].x = position;
        set model^.items.inner[c].width = extent;
      }
    }
  }
  return unit;
}

fn grid_columns_pass(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, model: &GridModel) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context), writes(model) {
  doc "Finds the contributions to the columns of each item that spans a column sized by its items, in one counted loop in which each iteration writes only its own child and item.";
  let count = context^.children.inner.len;
  let listed = model^.items.inner.len;
  if count == listed {
    for (c in 0_u64..count) {
      if model^.items.inner[c].needs {
        let made = grid_measure_column(child: &context^.children.inner[c], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
        set model^.items.inner[c].least = made.least;
        set model^.items.inner[c].most = made.most;
        set model^.items.inner[c].minimum = made.minimum;
      }
    }
  }
  return unit;
}

fn grid_rows_pass(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, model: &GridModel, justify_items: u8, align_items: u8) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context), writes(model) {
  doc "Lays out, at the width of its grid area, each item that spans a row sized by its items, and records its height as its contributions to the rows, in one counted loop in which each iteration writes only its own child and item.";
  let count = context^.children.inner.len;
  let listed = model^.items.inner.len;
  let updating = context^.dirty;
  if count == listed {
    for (c in 0_u64..count) {
      if model^.items.inner[c].needs {
        grid_measure_item(child: &context^.children.inner[c], item: &model^.items.inner[c], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, justify_items: justify_items, align_items: align_items, updating: updating);
      }
    }
  }
  return unit;
}

fn grid_percent_height(styles: &Styles, style: StyleRef) -> percent: Bool reads(styles) {
  doc "Whether an item's height, min-height or max-height is a percentage, which its grid area's height resolves.";
  let sizes = size_of(styles: styles, style: style);
  let tall = sizes.height.kind == sizing_value;
  let tall_percent = band(tall, sizes.height.value.has_percent);
  let low = sizes.min_height.kind == sizing_value;
  let low_percent = band(low, sizes.min_height.value.has_percent);
  let high = sizes.max_height.kind == sizing_value;
  let high_percent = band(high, sizes.max_height.value.has_percent);
  let pair = bor(tall_percent, low_percent);
  let made = bor(pair, high_percent);
  return made;
}

fn grid_finish_child(child: &Context, item: &GridItem, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, justify_items: u8, align_items: u8, content_left: i32, content_top: i32, content_width: i32, content_height: i32, updating: Bool) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), reads(item), writes(child) {
  doc "Lays out an item in its grid area, unless the lay-out that measured it already is the one it needs, and places it in the area by its alignment; an absolutely positioned child is laid out in the content box (unless the update defers it to position_out_with: deferred_out) and put at its origin as its static position.";
  let style = child^.style;
  if item^.active {
    let group = item_of(styles: styles, style: style);
    let replaced = child^.kind == ctx_replaced;
    let justify = grid_choose(own: group.justify_self, inherited: justify_items);
    let align = grid_choose(own: group.align_self, inherited: align_items);
    let space = grid_item_space(styles: styles, style: style, replaced: replaced, justify: justify, align: align, width: item^.width, height: item^.height);
    let forced = space.forced_height >= 0_i32;
    let matches = space.forced_height == child^.height;
    let unforced = bnot(forced);
    let fits = bor(unforced, matches);
    let percent = grid_percent_height(styles: styles, style: style);
    let plain = bnot(percent);
    let depends = band(item^.measured, plain);
    let reuse = band(depends, fits);
    if reuse {
    } else {
      set child^.space = space;
      let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: updating);
    }
    let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
    let across = grid_kind(value: justify, replaced: replaced);
    let down = grid_kind(value: align, replaced: replaced);
    let x = grid_place_axis(kind: across, start: item^.x, area: item^.width, size: child^.width, margin_start: child^.margin_left, margin_end: child^.margin_right, auto_start: auto_left, auto_end: auto_right);
    let aligned = grid_place_axis(kind: down, start: item^.y, area: item^.height, size: child^.height, margin_start: child^.margin_top, margin_end: child^.margin_bottom, auto_start: auto_top, auto_end: auto_bottom);
    let shifted_start = item^.y +sat item^.shim;
    let shifted = shifted_start +sat child^.margin_top;
    let y = if item^.shared {
      give shifted;
    } else {
      give aligned;
    }
    let (shift_x, shift_y) = relative_offset(styles: styles, style: style, basis_width: item^.width, basis_height: item^.height);
    let moved_x = x +sat shift_x;
    let moved_y = y +sat shift_y;
    set child^.normal_x = content_left +sat x;
    set child^.x = content_left +sat moved_x;
    set child^.normal_y = content_top +sat y;
    set child^.y = content_top +sat moved_y;
  } else {
    let yes = True();
    set child^.space = child_space(available: content_width, basis_width: content_width, basis_height: content_height, shrink: yes);
    let deferred = deferred_out(child: child, styles: styles, updating: updating);
    if deferred {
      resolve_margins(child: child, styles: styles);
    } else {
      let counted = lay_out_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: updating);
    }
    set child^.normal_x = content_left;
    set child^.x = content_left;
    set child^.normal_y = content_top;
    set child^.y = content_top;
  }
  return unit;
}

fn grid_final_pass(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, model: &GridModel, justify_items: u8, align_items: u8, content_left: i32, content_top: i32, content_width: i32, content_height: i32) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), reads(model), writes(context) {
  doc "Lays out and places every child of the context in one counted loop in which each iteration writes only its own child.";
  let count = context^.children.inner.len;
  let listed = model^.items.inner.len;
  let updating = context^.dirty;
  if count == listed {
    for (c in 0_u64..count) {
      grid_finish_child(child: &context^.children.inner[c], item: &model^.items.inner[c], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, justify_items: justify_items, align_items: align_items, content_left: content_left, content_top: content_top, content_width: content_width, content_height: content_height, updating: updating);
    }
  }
  return unit;
}

fn grid_arrange(context: &Context, events: &[Flow], styles: &Styles, model: &GridModel, group: ContainerGroup, column_def: GridDef, row_def: GridDef) -> size: GridSize reads(context), reads(events), reads(styles), writes(model) {
  doc "Collects the context's children into the model and places them by the container's grid-auto-flow, returning the implicit grid's size.";
  grid_collect(context: context, events: events, styles: styles, model: model, column_def: column_def, row_def: row_def, areas: group.template_areas);
  let column_bits = iand(group.auto_flow, flow_column);
  let dense_bits = iand(group.auto_flow, flow_dense);
  let by_column = column_bits != 0_u8;
  let dense = dense_bits != 0_u8;
  if by_column {
    grid_swap_axes(model: model);
    let placed = grid_place(model: model, dense: dense, explicit_rows: column_def.explicit, explicit_columns: row_def.explicit);
    grid_swap_axes(model: model);
    return GridSize(rows: placed.columns, columns: placed.rows, row_origin: placed.column_origin, column_origin: placed.row_origin);
  }
  let placed = grid_place(model: model, dense: dense, explicit_rows: row_def.explicit, explicit_columns: column_def.explicit);
  return placed;
}

fn grid_stretches(align: u8) -> stretch: Bool pure {
  doc "Whether justify-content or align-content lets the auto tracks grow into free space: normal and stretch do.";
  let normal = align == align_normal;
  let wide = align == align_stretch;
  let made = bor(normal, wide);
  return made;
}

fn grid_baseline_item(items: &Box<Slots<GridItem>>, sequence: &[u32], prefer_sharing: Bool) -> child: u32 reads(items), reads(sequence) {
  doc "Selects the first-row baseline-sharing item, or that row's first item, in grid order; ties retain placement order. Balanced selection depends only on settled item placement and sharing flags.";
  let count = sequence^.len;
  if count == 0_u64 {
    return no_index;
  }
  if count == 1_u64 {
    return sequence^[0_u64];
  }
  let middle = count / 2_u64;
  let left = grid_baseline_item(items: items, sequence: &sequence^[0_u64..middle], prefer_sharing: prefer_sharing);
  let right = grid_baseline_item(items: items, sequence: &sequence^[middle..count], prefer_sharing: prefer_sharing);
  let a = cvt::<u32, u64>(left);
  let b = cvt::<u32, u64>(right);
  if a < items^.inner.len {
    if b < items^.inner.len {
      let first = items^.inner[a];
      let second = items^.inner[b];
      if second.row < first.row {
        return right;
      }
      if first.row < second.row {
        return left;
      }
      if prefer_sharing {
        if first.shared {
          if second.shared {
          } else {
            return left;
          }
        } else if second.shared {
          return right;
        }
      }
      if second.column < first.column {
        return right;
      }
    }
    return left;
  }
  return right;
}

fn grid_export_baseline(context: &Context, model: &GridModel, first: Bool) -> (baseline: i32, found: Bool) reads(context), reads(model) {
  doc "Exports the first alignment baseline from a sharing-priority selection, or preserves the legacy baseline from the earliest item and its existing baseline field. Missing item baselines synthesize the border-box bottom.";
  let count = model^.sequence.inner.len;
  let selected = grid_baseline_item(items: &model^.items, sequence: &model^.sequence.inner[0_u64..count], prefer_sharing: first);
  let at = cvt::<u32, u64>(selected);
  if at < context^.children.inner.len {
    let position = child_position(context: context, at: at);
    let inner = if first {
      if context^.children.inner[at].has_first_baseline {
        give context^.children.inner[at].first_baseline;
      } else {
        give context^.children.inner[at].height;
      }
    } else if context^.children.inner[at].has_baseline {
      give context^.children.inner[at].baseline;
    } else {
      give context^.children.inner[at].height;
    }
    let baseline = position.y +sat inner;
    return baseline, True();
  }
  return 0_i32, False();
}

fn lay_out_grid(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out a grid container (CSS Grid 1): its width; the explicit grid from its templates and the placement of its items; the columns sized from the items' intrinsic widths, then the items laid out at their column widths in a counted loop to size the rows that depend on their heights; the rows; the items laid out in their grid areas in a counted loop, aligned in them; its height; and its absolutely positioned children.";
  layout_height_inputs(context: context);
  let no = False();
  let width = used_width(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set context^.width = width;
  let style = context^.style;
  let basis = context^.space.basis_width;
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: basis);
  let content_left = border.left +sat padding.left;
  let content_top = border.top +sat padding.top;
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let inner = width -sat frame;
  let content_width = imax(inner, 0_i32);
  let frame_vertical_border = vertical(edges: border);
  let frame_vertical_padding = vertical(edges: padding);
  let frame_vertical = frame_vertical_border +sat frame_vertical_padding;
  let forced = context^.space.forced_height;
  let specified = specified_height(styles: styles, style: style, basis: context^.space.basis_height, frame: frame_vertical);
  let definite = if forced >= 0_i32 {
    let room = forced -sat frame_vertical;
    give imax(room, 0_i32);
  } else if specified >= 0_i32 {
    let room = specified -sat frame_vertical;
    give imax(room, 0_i32);
  } else {
    give unknown;
  }
  let group = container_of(styles: styles, style: style);
  let column_gap = grid_gap(value: group.column_gap, basis: content_width);
  let row_gap = grid_gap(value: group.row_gap, basis: definite);
  let (area_rows, area_columns) = grid_area_dims(styles: styles, areas: group.template_areas);
  let column_def = grid_def(styles: styles, template: group.template_columns, auto: group.auto_columns, area_count: area_columns, avail: content_width, gap: column_gap);
  let row_def = grid_def(styles: styles, template: group.template_rows, auto: group.auto_rows, area_count: area_rows, avail: definite, gap: row_gap);
  let model = grid_model_new();
  let size = grid_arrange(context: context, events: events, styles: styles, model: &model, group: group, column_def: column_def, row_def: row_def);
  let yes = True();
  grid_build_tracks(styles: styles, def: column_def, tracks: &model.columns, items: &model.items, rows: no, total: size.columns, origin: size.column_origin, basis: content_width, gap: column_gap);
  grid_build_tracks(styles: styles, def: row_def, tracks: &model.rows, items: &model.items, rows: yes, total: size.rows, origin: size.row_origin, basis: definite, gap: row_gap);
  grid_mark_needs(model: &model, rows: no);
  grid_columns_pass(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, model: &model);
  let stretch_columns = grid_stretches(align: group.justify_content);
  grid_size(tracks: &model.columns, items: &model.items, rows: no, avail: content_width, mode: grid_mode_definite, stretch: stretch_columns);
  grid_position(tracks: &model.columns, avail: content_width, align: group.justify_content);
  grid_assign(model: &model, rows: no);
  grid_mark_needs(model: &model, rows: yes);
  grid_mark_baselines(context: context, styles: styles, model: &model, align_items: group.align_items);
  grid_rows_pass(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, model: &model, justify_items: group.justify_items, align_items: group.align_items);
  grid_shim_baselines(model: &model);
  let stretch_rows = grid_stretches(align: group.align_content);
  let known = definite >= 0_i32;
  if known {
    grid_size(tracks: &model.rows, items: &model.items, rows: yes, avail: definite, mode: grid_mode_definite, stretch: stretch_rows);
  } else {
    grid_size(tracks: &model.rows, items: &model.items, rows: yes, avail: unknown, mode: grid_mode_max, stretch: no);
  }
  let row_count = model.rows.inner.len;
  let rows_total = grid_sum(tracks: &model.rows, first: 0_u64, end: row_count, limits: no);
  let content_total = if known {
    give definite;
  } else {
    give rows_total;
  }
  let used = used_height(context: context, styles: styles, content: content_total);
  let target_raw = used -sat frame_vertical;
  let target = imax(target_raw, 0_i32);
  let moved = if known {
    give target != definite;
  } else {
    give target != rows_total;
  }
  if moved {
    grid_size(tracks: &model.rows, items: &model.items, rows: yes, avail: target, mode: grid_mode_definite, stretch: stretch_rows);
  }
  grid_position(tracks: &model.rows, avail: target, align: group.align_content);
  grid_assign(model: &model, rows: yes);
  grid_final_pass(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, model: &model, justify_items: group.justify_items, align_items: group.align_items, content_left: content_left, content_top: content_top, content_width: content_width, content_height: target);
  set context^.height = used;
  let (first_baseline, has_first) = grid_export_baseline(context: context, model: &model, first: yes);
  let (baseline, has_baseline) = grid_export_baseline(context: context, model: &model, first: no);
  set context^.baseline = baseline;
  set context^.has_baseline = has_baseline;
  set context^.first_baseline = first_baseline;
  set context^.has_first_baseline = has_first;
  let positioned_counts = position_out(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  add_own_fragment(context: context);
  return unit;
}

fn intrinsic_grid(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> (minimum: i32, maximum: i32) reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "The min-content and max-content widths of a grid container's content: the columns sized under each constraint from the items' intrinsic widths (CSS Grid 11.1 and 11.7.1), plus the gutters, with percentages of the indefinite width taken as auto and an auto-fill or auto-fit repeat() repeated once.";
  let no = False();
  let style = context^.style;
  let group = container_of(styles: styles, style: style);
  let column_gap = grid_gap(value: group.column_gap, basis: unknown);
  let row_gap = grid_gap(value: group.row_gap, basis: unknown);
  let (area_rows, area_columns) = grid_area_dims(styles: styles, areas: group.template_areas);
  let column_def = grid_def(styles: styles, template: group.template_columns, auto: group.auto_columns, area_count: area_columns, avail: unknown, gap: column_gap);
  let row_def = grid_def(styles: styles, template: group.template_rows, auto: group.auto_rows, area_count: area_rows, avail: unknown, gap: row_gap);
  let model = grid_model_new();
  let size = grid_arrange(context: context, events: events, styles: styles, model: &model, group: group, column_def: column_def, row_def: row_def);
  grid_build_tracks(styles: styles, def: column_def, tracks: &model.columns, items: &model.items, rows: no, total: size.columns, origin: size.column_origin, basis: unknown, gap: column_gap);
  grid_mark_needs(model: &model, rows: no);
  grid_columns_pass(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, model: &model);
  grid_size(tracks: &model.columns, items: &model.items, rows: no, avail: unknown, mode: grid_mode_min, stretch: no);
  let count = model.columns.inner.len;
  let least = grid_sum(tracks: &model.columns, first: 0_u64, end: count, limits: no);
  grid_size(tracks: &model.columns, items: &model.items, rows: no, avail: unknown, mode: grid_mode_max, stretch: no);
  let rest = model.columns.inner.len;
  let most = grid_sum(tracks: &model.columns, first: 0_u64, end: rest, limits: no);
  return least, most;
}
