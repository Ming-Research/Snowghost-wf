alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Styles = pkg::style::Styles;
alias AtomTable = pkg::base::atom::AtomTable;

fn same_build_state(first: &BuildState, second: &BuildState) -> same: Bool reads(first), reads(second) {
  doc "Compares the complete semantic walk state. Counter entries compare independently, while their order distinguishes simultaneously scoped instances of the same name.";
  if first^.depth != second^.depth {
    return False();
  }
  if first^.quote_depth != second^.quote_depth {
    return False();
  }
  let count = first^.counters.inner.len;
  if count != second^.counters.inner.len {
    return False();
  }
  let equal = True();
  for (i in 0_u64..count) {
    let a = first^.counters.inner[i];
    let b = second^.counters.inner[i];
    let name = a.name == b.name;
    let value = a.value == b.value;
    let level = a.level == b.level;
    let fields = band(name, value);
    let entry_equal = band(fields, level);
    set equal = band(equal, entry_equal);
  }
  return equal;
}

fn restore_build_state(walk: &Walk, state: &BuildState) -> result: Result<unit, LayoutError> reads(state), writes(walk) {
  doc "Restores a body's complete entry or exit checkpoint. Each counter copy is independent; consuming the full array into a Slots window preserves the stack order without an append dependency.";
  let count = state^.counters.inner.len;
  if count > item_ceiling {
    return too_large::<unit>();
  }
  let empty = Counter(name: 0_u32, value: 0_i32, level: 0_u64);
  let copied = box_array_filled::<Counter>(count: count, value: empty);
  for (i in 0_u64..count) {
    let saved = state^.counters.inner[i];
    let counter = Counter(name: saved.name, value: saved.value, level: saved.level);
    set copied.inner[i] = counter;
  }
  let slots = slots_from_array(values: move copied.inner);
  let counters = box_new(value: move slots);
  set walk^.counters = move counters;
  set walk^.depth = state^.depth;
  set walk^.quote_depth = state^.quote_depth;
  return Ok<unit, LayoutError>(value: unit);
}

fn source_exit_same(first: &Context, second: &Context) -> same: Bool reads(first), reads(second) {
  doc "Tests whether replacing this complete body preserves the state its caller observes before leaving the body's scope.";
  let old_source = &first^.source;
  let new_source = &second^.source;
  match old_source^ {
    ElementBody(node: old_node, recipe: old_recipe, end: old_end, ..) => {
      match new_source^ {
        ElementBody(node: new_node, recipe: new_recipe, end: new_end, ..) => {
          let node_equal = old_node^.index == new_node^.index;
          let recipe_equal = old_recipe^ == new_recipe^;
          let identity = band(node_equal, recipe_equal);
          let state = same_build_state(first: old_end, second: new_end);
          return band(identity, state);
        }
        _ => {
          return False();
        }
      }
    }
    DocumentBody(node: old_node, end: old_end, ..) => {
      match new_source^ {
        DocumentBody(node: new_node, end: new_end, ..) => {
          let identity = old_node^.index == new_node^.index;
          let state = same_build_state(first: old_end, second: new_end);
          return band(identity, state);
        }
        _ => {
          return False();
        }
      }
    }
    Derived() => {
      return False();
    }
  }
}

fn take_source_child_at(context: &Context, upward: &[u32], left: u64, child: u32, node: NodeId) -> result: Result<Context, LayoutError> reads(upward), writes(context) {
  doc "Follows the old source-local path, then moves one complete child source into its caller's private pool. Swapping with an empty derived context preserves valid owned places and keeps every old local-path index stable.";
  if left > 0_u64 {
    let next = left - 1_u64;
    if next < upward^.len {
    } else {
      return inconsistent::<Context>();
    }
    let at = cvt::<u32, u64>(upward^[next]);
    if at < context^.children.inner.len {
    } else {
      return inconsistent::<Context>();
    }
    return take_source_child_at(context: &context^.children.inner[at], upward: upward, left: next, child: child, node: node);
  }
  let at = cvt::<u32, u64>(child);
  if at < context^.children.inner.len {
  } else {
    return inconsistent::<Context>();
  }
  let held = context_source_node(context: &context^.children.inner[at]);
  if held.index != node.index {
    return inconsistent::<Context>();
  }
  let style = context^.children.inner[at].style;
  let moved = new_context(kind: ctx_flow, style: style);
  swap(first: &context^.children.inner[at], second: &moved);
  return Ok<Context, LayoutError>(value: move moved);
}

fn take_source_child(context: &Context, route: SourcePath, node: NodeId) -> result: Result<Option<Context>, LayoutError> writes(context) {
  doc "Takes a child from its source-private pool using a route captured before any ownership moves. A second claim cannot match the source identity in the consumed slot.";
  let owner = context_source_node(context: context);
  let owned = route.parent_source.index == owner.index;
  let present = band(route.present, owned);
  if present {
  } else {
    let none = None<Context>();
    return Ok<Option<Context>, LayoutError>(value: move none);
  }
  let upward = propagate local_steps(context: context, local: route.parent_local);
  let count = upward.inner.len;
  let child = propagate take_source_child_at(context: context, upward: &upward.inner[0_u64..count], left: count, child: route.child, node: node);
  let found = Some<Context>(value: move child);
  return Ok<Option<Context>, LayoutError>(value: move found);
}

fn finish_generated_source(context: &Context, styles: &Styles) -> status: u8 reads(styles), writes(context) {
  doc "Finalizes raw generated spans in one rebuilt source and its derived contexts. Retained complete child sources already own their bytes and are not read through the current Styles arena again.";
  let own = match finish_generated(context: context, styles: styles) {
    Ok(..) => {
      give 0_u8;
    }
    Err(error: failure) => {
      let code = match failure {
        Inconsistent() => {
          give 1_u8;
        }
        TooLarge() => {
          give 2_u8;
        }
        Text() => {
          give 3_u8;
        }
      }
      give code;
    }
  }
  let count = context^.children.inner.len;
  let copied = own;
  for (i in 0_u64..count) {
    let source = context_source_node(context: &context^.children.inner[i]);
    let code = if source.index == no_index {
      give finish_generated_source(context: &context^.children.inner[i], styles: styles);
    } else {
      give 0_u8;
    }
    set copied = imax(copied, code);
  }
  return copied;
}

struct SourcePool {
  doc "One builder's privately owned previous body and its immutable local routes, captured before moving children. Independent source builders never share this pool or a mutable lookup table.";
  previous: Option<Context>;
  routes: RoutePatch;
  width: u64;
}

fn empty_source_pool(width: u64) -> made: SourcePool pure {
  doc "A builder with no previous source body, used for initial construction and newly attached sources.";
  let previous = None<Context>();
  let routes = RoutePatch::Empty();
  return SourcePool(previous: move previous, routes: move routes, width: width);
}

fn make_source_pool(context: Context, width: u64) -> result: Result<SourcePool, LayoutError> pure {
  doc "Captures this body's lookup routes before any child is claimed. Only this source and its derived contexts are collected; complete child bodies remain separate owners.";
  let routes = propagate context_route_patch(context: &context, width: width);
  let previous = Some<Context>(value: move context);
  let made = SourcePool(previous: move previous, routes: move routes, width: width);
  return Ok<SourcePool, LayoutError>(value: move made);
}

fn route_source_at(patch: &RoutePatch, width: u64, key: u64) -> result: Option<SourcePath> reads(patch) {
  doc "Reads one source entry from an immutable source-local interval patch; generated text and omitted nodes have no source entry.";
  if key >= width {
    return None<SourcePath>();
  }
  match patch^ {
    Empty() => {
      return None<SourcePath>();
    }
    Leaf(value: stored) => {
      if width != 1_u64 {
        return None<SourcePath>();
      }
      match stored^ {
        Source(value: route) => {
          return Some<SourcePath>(value: route^);
        }
        Text(..) => {
          return None<SourcePath>();
        }
      }
    }
    Fork(left: lower, right: upper) => {
      let half = width / 2_u64;
      if half == 0_u64 {
        return None<SourcePath>();
      }
      if key < half {
        return route_source_at(patch: &lower^.inner, width: half, key: key);
      }
      let rest = width - half;
      let offset = key - half;
      return route_source_at(patch: &upper^.inner, width: rest, key: offset);
    }
  }
}

fn pool_take_source(pool: &SourcePool, node: NodeId) -> result: Result<Option<Context>, LayoutError> writes(pool) {
  doc "Looks up one requested child before borrowing its owned previous body. The route is Copy; only the source-private body is mutated by the transfer.";
  let at = cvt::<u32, u64>(node.index);
  let found = route_source_at(patch: &pool^.routes, width: pool^.width, key: at);
  match found {
    None() => {
      let absent = None<Context>();
      return Ok<Option<Context>, LayoutError>(value: move absent);
    }
    Some(value: route) => {
      let previous = &pool^.previous;
      match previous^ {
        Some(value: context) => {
          return take_source_child(context: context, route: route, node: node);
        }
        None() => {
          return inconsistent::<Option<Context>>();
        }
      }
    }
  }
}

fn source_entry_matches(context: &Context, state: &BuildState, node: NodeId, recipe: u8, kind: u8, style: StyleRef) -> same: Bool reads(context), reads(state) {
  doc "Validates the current caller's recipe, identity and entry checkpoint before retaining an owned child. A table cell becoming ordinary flow must be reconstructed by its current caller even if both contexts have the same kind.";
  if context^.kind != kind {
    return False();
  }
  if context^.style.element.index != style.element.index {
    return False();
  }
  if context^.style.pseudo != style.pseudo {
    return False();
  }
  let anonymous = eeq(context^.style.anonymous, style.anonymous);
  if anonymous {
  } else {
    return False();
  }
  let source = &context^.source;
  match source^ {
    ElementBody(node: origin, recipe: construction, begin: before, ..) => {
      if origin^.index != node.index {
        return False();
      }
      if construction^ != recipe {
        return False();
      }
      return same_build_state(first: before, second: state);
    }
    _ => {
      return False();
    }
  }
}

fn restore_source_exit(walk: &Walk, context: &Context) -> result: Result<unit, LayoutError> reads(context), writes(walk) {
  doc "A reused body's caller receives its complete saved exit before applying the caller's existing scope-exit operations.";
  let source = &context^.source;
  match source^ {
    ElementBody(end: after, ..) => {
      return restore_build_state(walk: walk, state: after);
    }
    DocumentBody(end: after, ..) => {
      return restore_build_state(walk: walk, state: after);
    }
    Derived() => {
      return inconsistent::<unit>();
    }
  }
}

fn refresh_structure_marks(context: &Context) -> result: unit writes(context) {
  doc "Recounts independent paragraph and child marks after ownership transfers; no shared counter orders those consumers.";
  let paragraphs = context^.paragraphs.inner.len;
  let children = context^.children.inner.len;
  let paragraph_count = paragraph_mark_count(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs]);
  let paragraph_index = paragraph_mark_index(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs]);
  let child_count = child_mark_count(children: &context^.children.inner[0_u64..children]);
  let child_index = child_mark_index(children: &context^.children.inner[0_u64..children]);
  set context^.marked_paragraphs = paragraph_count;
  set context^.marked_paragraph = paragraph_index;
  set context^.marked_children = child_count;
  set context^.marked_child = child_index;
}

fn mark_new_source(context: &Context) -> result: unit writes(context) {
  doc "Marks the fresh source's local paragraphs for preparation and all local geometry for layout. Complete child sources keep their existing preparation marks, including reused clean bodies.";
  let count = context^.paragraphs.inner.len;
  for (i in 0_u64..count) {
    set context^.paragraphs.inner[i].dirty = True();
  }
  let children = context^.children.inner.len;
  for (i in 0_u64..children) {
    let source = context_source_node(context: &context^.children.inner[i]);
    if source.index == no_index {
      mark_new_source(context: &context^.children.inner[i]);
    }
  }
  refresh_structure_marks(context: context);
  set context^.dirty = True();
  set context^.restyled = True();
}

fn finish_incremental_body(context: &Context, pool: &SourcePool, document: &Document, old: &Styles, new: &Styles) -> result: Result<unit, LayoutError> reads(document), reads(old), reads(new), writes(context), writes(pool) {
  doc "Finalizes a replacement's own generated storage before exact preparation-key matching. A previous speculative replacement has never been laid out and already uses new Styles; an original donor came from the caller's last laid-out layout and uses old Styles.";
  let routed = propagate finish_source_paths(context: context);
  let generated = finish_generated_source(context: context, styles: new);
  if generated == 2_u8 {
    return too_large::<unit>();
  }
  if generated != 0_u8 {
    return inconsistent::<unit>();
  }
  mark_new_source(context: context);
  let previous = &pool^.previous;
  match previous^ {
    Some(value: donor) => {
      let fresh = donor^.laid.available == laid_never;
      if fresh {
        let reused = propagate reuse_source_paragraphs(previous: donor, replacement: context, document: document, old: new, new: new);
      } else {
        let reused = propagate reuse_source_paragraphs(previous: donor, replacement: context, document: document, old: old, new: new);
      }
    }
    None() => {
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn build_incremental_child(document: &Document, old: &Styles, new: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, style: StyleRef, kind: u8, recipe: u8) -> result: Result<Context, LayoutError> reads(document), reads(old), reads(new), reads(atoms), writes(walk) {
  doc "Uses the current caller's construction recipe and actual counter/quote entry. Matching retained bodies restore their exit without walking their DOM; other bodies rebuild with a private child pool, then transfer only exact prepared paragraphs.";
  let begin = propagate capture_build_state(walk: walk);
  let previous = propagate pool_take_source(pool: &walk^.pool, node: node);
  let width = walk^.pool.width;
  let child_pool = match move previous {
    Some(value: prior) => {
      let entry_matches = source_entry_matches(context: &prior, state: &begin, node: node, recipe: recipe, kind: kind, style: style);
      let fresh = prior.laid.available == laid_never;
      let construction = if fresh {
        give True();
      } else {
        give retained_style(old: old, new: new, style: style);
      }
      let retained = band(entry_matches, construction);
      if retained {
        let restored = propagate restore_source_exit(walk: walk, context: &prior);
        return Ok<Context, LayoutError>(value: move prior);
      }
      let pool = propagate make_source_pool(context: move prior, width: width);
      give move pool;
    }
    None() => {
      let pool = empty_source_pool(width: width);
      give move pool;
    }
  }
  swap(first: &walk^.pool, second: &child_pool);
  let context = propagate build_box_body(document: document, old: old, styles: new, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
  let end = propagate capture_build_state(walk: walk);
  let source = ContextSource::ElementBody(node: node, recipe: recipe, begin: move begin, end: move end);
  set context.source = move source;
  let finished = propagate finish_incremental_body(context: &context, pool: &walk^.pool, document: document, old: old, new: new);
  swap(first: &walk^.pool, second: &child_pool);
  return Ok<Context, LayoutError>(value: move context);
}

enum SourceMarks {
  doc "An immutable sparse NodeId set. A leaf distinguishes a body whose own inputs changed from an ancestor visited only to integrate independently rebuilt children.";
  Empty();
  Leaf(direct: Bool);
  Fork(left: Box<SourceMarks>, right: Box<SourceMarks>);
}

fn source_mark_single(width: u64, key: u64, direct: Bool) -> result: Result<SourceMarks, LayoutError> pure {
  doc "Produces the destination interval path of one source mark without a shared scatter or allocation counter.";
  if key >= width {
    return inconsistent::<SourceMarks>();
  }
  if width == 1_u64 {
    let made = SourceMarks::Leaf(direct: direct);
    return Ok<SourceMarks, LayoutError>(value: move made);
  }
  let half = width / 2_u64;
  if key < half {
    let below = propagate source_mark_single(width: half, key: key, direct: direct);
    let lower = box_new(value: move below);
    let empty = SourceMarks::Empty();
    let upper = box_new(value: move empty);
    let made = SourceMarks::Fork(left: move lower, right: move upper);
    return Ok<SourceMarks, LayoutError>(value: move made);
  }
  let rest = width - half;
  let offset = key - half;
  let above = propagate source_mark_single(width: rest, key: offset, direct: direct);
  let upper = box_new(value: move above);
  let empty = SourceMarks::Empty();
  let lower = box_new(value: move empty);
  let made = SourceMarks::Fork(left: move lower, right: move upper);
  return Ok<SourceMarks, LayoutError>(value: move made);
}

fn merge_source_marks(first: SourceMarks, second: SourceMarks) -> result: Result<SourceMarks, LayoutError> pure {
  doc "Unions independent invalidation results. Overlapping destinations combine their direct-input flags; their discovery order has no meaning.";
  match move first {
    Empty() => {
      return Ok<SourceMarks, LayoutError>(value: move second);
    }
    Leaf(direct: a) => {
      match move second {
        Empty() => {
          let made = SourceMarks::Leaf(direct: a);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
        Leaf(direct: b) => {
          let direct = bor(a, b);
          let made = SourceMarks::Leaf(direct: direct);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
        Fork(..) => {
          return inconsistent::<SourceMarks>();
        }
      }
    }
    Fork(left: a_left, right: a_right) => {
      match move second {
        Empty() => {
          let made = SourceMarks::Fork(left: move a_left, right: move a_right);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
        Leaf(..) => {
          return inconsistent::<SourceMarks>();
        }
        Fork(left: b_left, right: b_right) => {
          let low = merge_source_marks(first: move a_left.inner, second: move b_left.inner);
          let high = merge_source_marks(first: move a_right.inner, second: move b_right.inner);
          let lower = propagate low;
          let upper = propagate high;
          let lower_box = box_new(value: move lower);
          let upper_box = box_new(value: move upper);
          let made = SourceMarks::Fork(left: move lower_box, right: move upper_box);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
      }
    }
  }
}

fn source_mark_at(marks: &SourceMarks, width: u64, key: u64) -> marked: Option<Bool> reads(marks) {
  doc "Returns None for an untouched source, Some(False) for an integration ancestor and Some(True) for a directly changed body.";
  if key >= width {
    return None<Bool>();
  }
  match marks^ {
    Empty() => {
      return None<Bool>();
    }
    Leaf(direct: own) => {
      if width == 1_u64 {
        return Some<Bool>(value: own^);
      }
      return None<Bool>();
    }
    Fork(left: lower, right: upper) => {
      let half = width / 2_u64;
      if key < half {
        return source_mark_at(marks: &lower^.inner, width: half, key: key);
      }
      let rest = width - half;
      let offset = key - half;
      return source_mark_at(marks: &upper^.inner, width: rest, key: offset);
    }
  }
}

fn mark_source_ancestors(paths: &[SourcePath], node: NodeId, width: u64, remaining: u64, direct: Bool) -> result: Result<SourceMarks, LayoutError> reads(paths) {
  doc "Includes the source and its old ownership ancestors so integration can reach it. This chain follows real ownership dependencies and never assumes that a parent's NodeId is smaller.";
  if remaining == 0_u64 {
    return inconsistent::<SourceMarks>();
  }
  let at = cvt::<u32, u64>(node.index);
  if at < paths^.len {
  } else {
    return inconsistent::<SourceMarks>();
  }
  let route = paths^[at];
  if route.present {
  } else {
    return inconsistent::<SourceMarks>();
  }
  let own = propagate source_mark_single(width: width, key: at, direct: direct);
  if route.parent_source.index == no_index {
    return Ok<SourceMarks, LayoutError>(value: move own);
  }
  let next = remaining - 1_u64;
  let indirect = False();
  let above = propagate mark_source_ancestors(paths: paths, node: route.parent_source, width: width, remaining: next, direct: indirect);
  return merge_source_marks(first: move own, second: move above);
}

fn enclosing_old_source(document: &Document, paths: &[SourcePath], node: NodeId) -> result: Result<NodeId, LayoutError> reads(document), reads(paths) {
  doc "Finds the nearest old complete source containing a currently attached DOM node, including the node itself. The DOM ancestry is a true containment dependency; node allocation order is irrelevant.";
  let cursor = node;
  let nodes = document^.nodes.inner.len;
  for (step in 0_u64..nodes) {
    let at = cvt::<u32, u64>(cursor.index);
    if at < paths^.len {
      if paths^[at].present {
        return Ok<NodeId, LayoutError>(value: cursor);
      }
    }
    if at < document^.nodes.inner.len {
    } else {
      return inconsistent::<NodeId>();
    }
    match document^.nodes.inner[at].links.parent {
      Some(value: parent) => {
        set cursor = parent;
      }
      None() => {
        return inconsistent::<NodeId>();
      }
    }
  }
  return inconsistent::<NodeId>();
}

fn changed_source_marks(document: &Document, styles: &Styles, paths: &[SourcePath], changed: &[Bool], base: u64, width: u64) -> result: Result<SourceMarks, LayoutError> reads(document), reads(styles), reads(paths), reads(changed) {
  doc "Maps independent style deltas to their consuming source bodies. An existing source root also marks its caller, which owns root counters, box classification and the choice of table-cell or ordinary recipe.";
  let count = changed^.len;
  if count == 0_u64 {
    let empty = SourceMarks::Empty();
    return Ok<SourceMarks, LayoutError>(value: move empty);
  }
  if count == 1_u64 {
    let active = changed^[0_u64];
    if active {
    } else {
      let empty = SourceMarks::Empty();
      return Ok<SourceMarks, LayoutError>(value: move empty);
    }
    if base < styles^.order.inner.len {
    } else {
      return inconsistent::<SourceMarks>();
    }
    if styles^.order.inner[base] == no_index {
      let empty = SourceMarks::Empty();
      return Ok<SourceMarks, LayoutError>(value: move empty);
    }
    if base < 4294967295_u64 {
    } else {
      return too_large::<SourceMarks>();
    }
    let index = cvt::<u64, u32>(base);
    let node = NodeId(index: index);
    let source = propagate enclosing_old_source(document: document, paths: paths, node: node);
    let direct = True();
    let limit = paths^.len;
    let own = propagate mark_source_ancestors(paths: paths, node: source, width: width, remaining: limit, direct: direct);
    if source.index == node.index {
      let at = cvt::<u32, u64>(source.index);
      if at < paths^.len {
      } else {
        return inconsistent::<SourceMarks>();
      }
      let parent = paths^[at].parent_source;
      if parent.index != no_index {
        let caller = propagate mark_source_ancestors(paths: paths, node: parent, width: width, remaining: limit, direct: direct);
        return merge_source_marks(first: move own, second: move caller);
      }
    }
    return Ok<SourceMarks, LayoutError>(value: move own);
  }
  let half = count / 2_u64;
  let next_base = base +sat half;
  let lower_result = changed_source_marks(document: document, styles: styles, paths: paths, changed: &changed^[0_u64..half], base: base, width: width);
  let upper_result = changed_source_marks(document: document, styles: styles, paths: paths, changed: &changed^[half..count], base: next_base, width: width);
  let lower = propagate lower_result;
  let upper = propagate upper_result;
  return merge_source_marks(first: move lower, second: move upper);
}

fn source_can_rebuild_at_checkpoint(context: &Context, old: &Styles, new: &Styles) -> valid: Bool reads(context), reads(old), reads(new) {
  doc "A saved body recipe is usable only while its root construction inputs are unchanged. Otherwise its marked caller must apply current root counter effects and choose the current recipe; speculative reconstruction never guesses from the old box kind.";
  let source = &context^.source;
  match source^ {
    DocumentBody(..) => {
      return True();
    }
    ElementBody(node: origin, ..) => {
      let at = element_at(styles: new, node: origin^);
      if at == unlisted {
        return False();
      }
      return retained_style(old: old, new: new, style: context^.style);
    }
    Derived() => {
      return False();
    }
  }
}

fn walk_from_source(context: &Context, atoms: &AtomTable, width: u64) -> result: Result<Walk, LayoutError> reads(context), reads(atoms) {
  doc "Constructs an independent builder from this body's saved input. Each speculative source receives its own counter stack and child pool; no mutable global walk serializes independent sources.";
  let word_n = list_item_word.len;
  let list_atom = atom_find(table: atoms, name: &list_item_word[0_u64..word_n]);
  let list_item = match list_atom {
    Some(value: atom) => {
      give atom.index;
    }
    None() => {
      give unlisted;
    }
  }
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  let pool = empty_source_pool(width: width);
  let incremental = True();
  let walk = Walk(counters: move counters, quote_depth: 0_i32, depth: 0_u64, list_item: list_item, incremental: incremental, pool: move pool);
  let source = &context^.source;
  match source^ {
    ElementBody(begin: before, ..) => {
      let restored = propagate restore_build_state(walk: &walk, state: before);
    }
    DocumentBody(begin: before, ..) => {
      let restored = propagate restore_build_state(walk: &walk, state: before);
    }
    Derived() => {
      return inconsistent::<Walk>();
    }
  }
  return Ok<Walk, LayoutError>(value: move walk);
}
