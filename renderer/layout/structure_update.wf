alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Styles = pkg::style::Styles;
alias AtomTable = pkg::base::atom::AtomTable;

fn same_build_state(first: &BuildState, second: &BuildState) -> same: Bool reads(first), reads(second) {
  doc "Compares the complete semantic walk state. Counter entries compare independently, while their order distinguishes simultaneously scoped instances of the same name.";
  if first^.depth != second^.depth {
    return False();
  }
  if first^.quote_depth != second^.quote_depth {
    return False();
  }
  let count = first^.counters.inner.len;
  if count != second^.counters.inner.len {
    return False();
  }
  let equal = True();
  for (i in 0_u64..count) {
    let a = first^.counters.inner[i];
    let b = second^.counters.inner[i];
    let name = a.name == b.name;
    let value = a.value == b.value;
    let level = a.level == b.level;
    let fields = band(name, value);
    let entry_equal = band(fields, level);
    set equal = band(equal, entry_equal);
  }
  return equal;
}

fn restore_build_state(walk: &Walk, state: &BuildState) -> result: Result<unit, LayoutError> reads(state), writes(walk) {
  doc "Restores a body's complete entry or exit checkpoint. Each counter copy is independent; consuming the full array into a Slots window preserves the stack order without an append dependency.";
  let count = state^.counters.inner.len;
  if count > item_ceiling {
    return too_large::<unit>();
  }
  let empty = Counter(name: 0_u32, value: 0_i32, level: 0_u64);
  let copied = box_array_filled::<Counter>(count: count, value: empty);
  for (i in 0_u64..count) {
    let saved = state^.counters.inner[i];
    let counter = Counter(name: saved.name, value: saved.value, level: saved.level);
    set copied.inner[i] = counter;
  }
  let slots = slots_from_array(values: move copied.inner);
  let counters = box_new(value: move slots);
  set walk^.counters = move counters;
  set walk^.depth = state^.depth;
  set walk^.quote_depth = state^.quote_depth;
  return Ok<unit, LayoutError>(value: unit);
}

fn source_exit_same(first: &Context, second: &Context) -> same: Bool reads(first), reads(second) {
  doc "Tests whether replacing this complete body preserves the state its caller observes before leaving the body's scope.";
  let old_source = &first^.source;
  let new_source = &second^.source;
  match old_source^ {
    ElementBody(node: old_node, recipe: old_recipe, end: old_end, ..) => {
      match new_source^ {
        ElementBody(node: new_node, recipe: new_recipe, end: new_end, ..) => {
          let node_equal = old_node^.index == new_node^.index;
          let recipe_equal = old_recipe^ == new_recipe^;
          let identity = band(node_equal, recipe_equal);
          let state = same_build_state(first: old_end, second: new_end);
          return band(identity, state);
        }
        DocumentBody(..) => {
          return False();
        }
        Derived() => {
          return False();
        }
      }
    }
    DocumentBody(node: old_node, end: old_end, ..) => {
      match new_source^ {
        DocumentBody(node: new_node, end: new_end, ..) => {
          let identity = old_node^.index == new_node^.index;
          let state = same_build_state(first: old_end, second: new_end);
          return band(identity, state);
        }
        ElementBody(..) => {
          return False();
        }
        Derived() => {
          return False();
        }
      }
    }
    Derived() => {
      return False();
    }
  }
}

fn finish_generated_source(context: &Context, styles: &Styles) -> status: u8 reads(styles), writes(context) {
  doc "Finalizes raw generated spans in one rebuilt source and its derived contexts. Retained complete child sources already own their bytes and are not read through the current Styles arena again.";
  let own = match finish_generated(context: context, styles: styles) {
    Ok(..) => {
      give 0_u8;
    }
    Err(error: failure) => {
      let code = match failure {
        Inconsistent() => {
          give 1_u8;
        }
        TooLarge() => {
          give 2_u8;
        }
        Text() => {
          give 3_u8;
        }
      }
      give code;
    }
  }
  let count = context^.children.inner.len;
  let copied = own;
  for (i in 0_u64..count) {
    let source = context_source_node(context: &context^.children.inner[i]);
    let code = if source.index == no_index {
      give finish_generated_source(context: &context^.children.inner[i], styles: styles);
    } else {
      give 0_u8;
    }
    set copied = imax(copied, code);
  }
  return copied;
}

struct SourcePool {
  doc "One builder's previous source donor and owned child candidates. A new source receives ownership partitioned by its DOM range; independent builders never borrow a caller's mutable pool.";
  previous: Option<Candidate>;
  candidates: CandidatePatch;
  width: u64;
}

fn empty_source_pool(width: u64) -> made: SourcePool pure {
  doc "A builder with no previous source body or candidates.";
  let previous = None<Candidate>();
  let candidates = CandidatePatch::Empty();
  return SourcePool(previous: move previous, candidates: move candidates, width: width);
}

fn make_source_pool(prior: Candidate, incoming: CandidatePatch, new_sources: &[NodeId], width: u64) -> result: Result<SourcePool, LayoutError> reads(new_sources) {
  doc "Extracts the donor's remaining real children and combines them with ownership transferred across a changed source boundary. The donor's saved facts and counts predate all holes.";
  let children = propagate collect_source_candidates(previous: &prior.context, new_sources: new_sources, width: width);
  let candidates = propagate merge_candidate_patches(first: move children, second: move incoming);
  let previous = Some<Candidate>(value: move prior);
  let made = SourcePool(previous: move previous, candidates: move candidates, width: width);
  return Ok<SourcePool, LayoutError>(value: move made);
}

fn source_entry_matches(context: &Context, state: &BuildState, node: NodeId, recipe: u8, kind: u8, style: StyleRef) -> same: Bool reads(context), reads(state) {
  doc "Validates the current caller's recipe, identity and entry checkpoint before retaining an owned child. A table cell becoming ordinary flow must be reconstructed by its current caller even if both contexts have the same kind.";
  if context^.kind != kind {
    return False();
  }
  if context^.style.element.index != style.element.index {
    return False();
  }
  if context^.style.pseudo != style.pseudo {
    return False();
  }
  let anonymous = eeq(context^.style.anonymous, style.anonymous);
  if anonymous {
  } else {
    return False();
  }
  let source = &context^.source;
  match source^ {
    ElementBody(node: origin, recipe: construction, begin: before, ..) => {
      if origin^.index != node.index {
        return False();
      }
      if construction^ != recipe {
        return False();
      }
      return same_build_state(first: before, second: state);
    }
    DocumentBody(..) => {
      return False();
    }
    Derived() => {
      return False();
    }
  }
}

fn restore_source_exit(walk: &Walk, context: &Context) -> result: Result<unit, LayoutError> reads(context), writes(walk) {
  doc "A reused body's caller receives its complete saved exit before applying the caller's existing scope-exit operations.";
  let source = &context^.source;
  match source^ {
    ElementBody(end: after, ..) => {
      return restore_build_state(walk: walk, state: after);
    }
    DocumentBody(end: after, ..) => {
      return restore_build_state(walk: walk, state: after);
    }
    Derived() => {
      return inconsistent::<unit>();
    }
  }
}

fn refresh_structure_marks(context: &Context) -> result: unit writes(context) {
  doc "Recounts independent paragraph and child marks after ownership transfers; no shared counter orders those consumers.";
  let paragraphs = context^.paragraphs.inner.len;
  let children = context^.children.inner.len;
  let paragraph_count = paragraph_mark_count(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs]);
  let paragraph_index = paragraph_mark_index(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs]);
  let child_count = child_mark_count(children: &context^.children.inner[0_u64..children]);
  let child_index = child_mark_index(children: &context^.children.inner[0_u64..children]);
  set context^.marked_paragraphs = paragraph_count;
  set context^.marked_paragraph = paragraph_index;
  set context^.marked_children = child_count;
  set context^.marked_child = child_index;
}

fn mark_new_source(context: &Context) -> result: unit writes(context) {
  doc "Marks the fresh source's local paragraphs for preparation and all local geometry for layout. Complete child sources keep their existing preparation marks, including reused clean bodies.";
  let count = context^.paragraphs.inner.len;
  for (i in 0_u64..count) {
    set context^.paragraphs.inner[i].dirty = True();
  }
  let children = context^.children.inner.len;
  for (i in 0_u64..children) {
    let source = context_source_node(context: &context^.children.inner[i]);
    if source.index == no_index {
      mark_new_source(context: &context^.children.inner[i]);
    }
  }
  refresh_structure_marks(context: context);
  set context^.dirty = True();
  set context^.restyled = True();
}

fn finish_incremental_body(context: &Context, pool: &SourcePool, document: &Document, old: &Styles, new: &Styles) -> result: Result<u64, LayoutError> reads(document), reads(old), reads(new), writes(context), writes(pool) {
  doc "Finalizes a replacement's own generated storage before exact preparation-key matching. Each donor carries its explicit old or new Styles basis; geometry is not used to infer preparation inputs. Returns the number of prepared payloads actually transferred, including a transfer into a speculative replacement.";
  let routed = propagate finish_source_paths(context: context);
  let generated = finish_generated_source(context: context, styles: new);
  if generated == 2_u8 {
    return too_large::<u64>();
  }
  if generated != 0_u8 {
    return inconsistent::<u64>();
  }
  mark_new_source(context: context);
  let previous = &pool^.previous;
  match previous^ {
    Some(value: donor) => {
      retain_output_summary(previous: &donor^.context, replacement: context);
      if donor^.styles_new {
        return reuse_source_paragraphs(previous: &donor^.context, replacement: context, document: document, old: new, new: new);
      } else {
        return reuse_source_paragraphs(previous: &donor^.context, replacement: context, document: document, old: old, new: new);
      }
    }
    None() => {
    }
  }
  return Ok<u64, LayoutError>(value: 0_u64);
}

fn build_incremental_child(document: &Document, old: &Styles, new: &Styles, new_sources: &[NodeId], atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, style: StyleRef, kind: u8, recipe: u8) -> result: Result<Context, LayoutError> reads(document), reads(old), reads(new), reads(new_sources), reads(atoms), writes(walk) {
  doc "Validates the current caller's actual entry and recipe. Ownership for a new source is partitioned into a private candidate patch before construction, including reusable children crossing an old wrapper boundary.";
  let begin = propagate capture_build_state(walk: walk);
  let width = walk^.pool.width;
  let previous = propagate take_candidate(candidates: &walk^.pool.candidates, width: width, node: node);
  let empty = CandidatePatch::Empty();
  swap(first: &walk^.pool.candidates, second: &empty);
  let partitioned = propagate partition_candidates(candidates: move empty, document: document, new_sources: new_sources, root: node, width: width);
  let CandidateSplit(inside: incoming_candidates, outside: remaining_candidates) = move partitioned;
  set walk^.pool.candidates = move remaining_candidates;
  let child_pool = match move previous {
    Some(value: prior) => {
      let entry_matches = source_entry_matches(context: &prior.context, state: &begin, node: node, recipe: recipe, kind: kind, style: style);
      let construction = if prior.styles_new {
        give True();
      } else {
        give retained_style(old: old, new: new, style: style);
      }
      let transferred = candidate_patch_empty(candidates: &incoming_candidates);
      let whole = band(prior.complete, transferred);
      let compatible = band(entry_matches, construction);
      let retained = band(whole, compatible);
      if retained {
        let restored = propagate restore_source_exit(walk: walk, context: &prior.context);
        let retained_work = SourceWork(sources_built: 0_u64, sources_retained: 1_u64, paragraphs_reused: 0_u64);
        let counted = propagate add_source_work(first: walk^.work, second: retained_work);
        set walk^.work = counted;
        return Ok<Context, LayoutError>(value: move prior.context);
      }
      let pool = propagate make_source_pool(prior: move prior, incoming: move incoming_candidates, new_sources: new_sources, width: width);
      give move pool;
    }
    None() => {
      let absent = None<Candidate>();
      let pool = SourcePool(previous: move absent, candidates: move incoming_candidates, width: width);
      give move pool;
    }
  }
  swap(first: &walk^.pool, second: &child_pool);
  let context = propagate build_box_body(document: document, old: old, styles: new, new_sources: new_sources, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
  let end = propagate capture_build_state(walk: walk);
  let source = ContextSource::ElementBody(node: node, recipe: recipe, begin: move begin, end: move end);
  set context.source = move source;
  let reused = propagate finish_incremental_body(context: &context, pool: &walk^.pool, document: document, old: old, new: new);
  let built_work = SourceWork(sources_built: 1_u64, sources_retained: 0_u64, paragraphs_reused: reused);
  let counted = propagate add_source_work(first: walk^.work, second: built_work);
  set walk^.work = counted;
  swap(first: &walk^.pool, second: &child_pool);
  let retired = propagate retire_source_pool(pool: move child_pool, new_sources: new_sources, width: width);
  let previous_retired = empty_retired_bodies();
  swap(first: &walk^.retired, second: &previous_retired);
  let combined = propagate join_retired_bodies(first: move previous_retired, second: move retired);
  set walk^.retired = move combined;
  let recorded = propagate record_completed_source(walk: walk, node: node, width: width);
  return Ok<Context, LayoutError>(value: move context);
}

enum SourceMarks {
  doc "An immutable sparse NodeId set. A leaf distinguishes a body whose own inputs changed from an ancestor visited only to integrate independently rebuilt children.";
  Empty();
  Leaf(direct: Bool);
  Fork(left: Box<SourceMarks>, right: Box<SourceMarks>, size: u64);
}

fn source_mark_single(width: u64, key: u64, direct: Bool) -> result: Result<SourceMarks, LayoutError> pure {
  doc "Produces the destination interval path of one source mark without a shared scatter or allocation counter.";
  if key >= width {
    return inconsistent::<SourceMarks>();
  }
  if width == 1_u64 {
    let made = SourceMarks::Leaf(direct: direct);
    return Ok<SourceMarks, LayoutError>(value: move made);
  }
  let half = width / 2_u64;
  if key < half {
    let below = propagate source_mark_single(width: half, key: key, direct: direct);
    let lower = box_new::<SourceMarks>(value: move below);
    let empty = SourceMarks::Empty();
    let upper = box_new::<SourceMarks>(value: move empty);
    let made = SourceMarks::Fork(left: move lower, right: move upper, size: 1_u64);
    return Ok<SourceMarks, LayoutError>(value: move made);
  }
  let rest = width - half;
  let offset = key - half;
  let above = propagate source_mark_single(width: rest, key: offset, direct: direct);
  let upper = box_new::<SourceMarks>(value: move above);
  let empty = SourceMarks::Empty();
  let lower = box_new::<SourceMarks>(value: move empty);
  let made = SourceMarks::Fork(left: move lower, right: move upper, size: 1_u64);
  return Ok<SourceMarks, LayoutError>(value: move made);
}

fn merge_source_marks(first: SourceMarks, second: SourceMarks) -> result: Result<SourceMarks, LayoutError> pure {
  doc "Unions independent invalidation results. Overlapping destinations combine their direct-input flags; their discovery order has no meaning.";
  match move first {
    Empty() => {
      return Ok<SourceMarks, LayoutError>(value: move second);
    }
    Leaf(direct: a) => {
      match move second {
        Empty() => {
          let made = SourceMarks::Leaf(direct: a);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
        Leaf(direct: b) => {
          let direct = bor(a, b);
          let made = SourceMarks::Leaf(direct: direct);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
        Fork(..) => {
          return inconsistent::<SourceMarks>();
        }
      }
    }
    Fork(left: a_left, right: a_right, size: first_size) => {
      match move second {
        Empty() => {
          let made = SourceMarks::Fork(left: move a_left, right: move a_right, size: first_size);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
        Leaf(..) => {
          return inconsistent::<SourceMarks>();
        }
        Fork(left: b_left, right: b_right, ..) => {
          let low = merge_source_marks(first: move a_left.inner, second: move b_left.inner);
          let high = merge_source_marks(first: move a_right.inner, second: move b_right.inner);
          let lower = propagate move low;
          let upper = propagate move high;
          let low_size = source_mark_size(marks: &lower);
          let high_size = source_mark_size(marks: &upper);
          let size = low_size +sat high_size;
          let lower_box = box_new::<SourceMarks>(value: move lower);
          let upper_box = box_new::<SourceMarks>(value: move upper);
          let made = SourceMarks::Fork(left: move lower_box, right: move upper_box, size: size);
          return Ok<SourceMarks, LayoutError>(value: move made);
        }
      }
    }
  }
}

fn source_mark_at(marks: &SourceMarks, width: u64, key: u64) -> marked: Option<Bool> reads(marks) {
  doc "Returns None for an untouched source, Some(False) for an integration ancestor and Some(True) for a directly changed body.";
  if key >= width {
    return None<Bool>();
  }
  match marks^ {
    Empty() => {
      return None<Bool>();
    }
    Leaf(direct: own) => {
      if width == 1_u64 {
        return Some<Bool>(value: own^);
      }
      return None<Bool>();
    }
    Fork(left: lower, right: upper, ..) => {
      let half = width / 2_u64;
      if key < half {
        return source_mark_at(marks: &lower^.inner, width: half, key: key);
      }
      let rest = width - half;
      let offset = key - half;
      return source_mark_at(marks: &upper^.inner, width: rest, key: offset);
    }
  }
}

fn mark_source_ancestors(paths: &[SourcePath], node: NodeId, width: u64, remaining: u64, direct: Bool) -> result: Result<SourceMarks, LayoutError> reads(paths) {
  doc "Includes the source and its old ownership ancestors so integration can reach it. This chain follows real ownership dependencies and never assumes that a parent's NodeId is smaller.";
  if remaining == 0_u64 {
    return inconsistent::<SourceMarks>();
  }
  let at = cvt::<u32, u64>(node.index);
  if at < paths^.len {
  } else {
    return inconsistent::<SourceMarks>();
  }
  let route = paths^[at];
  if route.present {
  } else {
    return inconsistent::<SourceMarks>();
  }
  let own = propagate source_mark_single(width: width, key: at, direct: direct);
  if route.parent_source.index == no_index {
    return Ok<SourceMarks, LayoutError>(value: move own);
  }
  let next = remaining - 1_u64;
  let indirect = False();
  let above = propagate mark_source_ancestors(paths: paths, node: route.parent_source, width: width, remaining: next, direct: indirect);
  return merge_source_marks(first: move own, second: move above);
}

fn enclosing_old_source(document: &Document, paths: &[SourcePath], node: NodeId) -> result: Result<NodeId, LayoutError> reads(document), reads(paths) {
  doc "Finds the nearest old complete source containing a currently attached DOM node, including the node itself. The DOM ancestry is a true containment dependency; node allocation order is irrelevant.";
  let cursor = node;
  let nodes = document^.nodes.inner.len;
  for (step in 0_u64..nodes) {
    let at = cvt::<u32, u64>(cursor.index);
    if at < paths^.len {
      if paths^[at].present {
        return Ok<NodeId, LayoutError>(value: cursor);
      }
    }
    if at < document^.nodes.inner.len {
    } else {
      return inconsistent::<NodeId>();
    }
    match document^.nodes.inner[at].links.parent {
      Some(value: parent) => {
        set cursor = parent;
      }
      None() => {
        return inconsistent::<NodeId>();
      }
    }
  }
  return inconsistent::<NodeId>();
}

fn changed_source_marks(document: &Document, styles: &Styles, paths: &[SourcePath], changed: &[Bool], base: u64, width: u64) -> result: Result<SourceMarks, LayoutError> reads(document), reads(styles), reads(paths), reads(changed) {
  doc "Maps independent style deltas to their consuming source bodies. An existing source root also marks its caller, which owns root counters, box classification and the choice of table-cell or ordinary recipe.";
  let count = changed^.len;
  if count == 0_u64 {
    let empty = SourceMarks::Empty();
    return Ok<SourceMarks, LayoutError>(value: move empty);
  }
  if count == 1_u64 {
    let active = changed^[0_u64];
    if active {
    } else {
      let empty = SourceMarks::Empty();
      return Ok<SourceMarks, LayoutError>(value: move empty);
    }
    if base < styles^.order.inner.len {
    } else {
      return inconsistent::<SourceMarks>();
    }
    if styles^.order.inner[base] == no_index {
      let empty = SourceMarks::Empty();
      return Ok<SourceMarks, LayoutError>(value: move empty);
    }
    if base < 4294967295_u64 {
    } else {
      return too_large::<SourceMarks>();
    }
    let index = cvt::<u64, u32>(base);
    let node = NodeId(index: index);
    let source = propagate enclosing_old_source(document: document, paths: paths, node: node);
    let direct = True();
    let limit = paths^.len;
    let own = propagate mark_source_ancestors(paths: paths, node: source, width: width, remaining: limit, direct: direct);
    if source.index == node.index {
      let at = cvt::<u32, u64>(source.index);
      if at < paths^.len {
      } else {
        return inconsistent::<SourceMarks>();
      }
      let parent = paths^[at].parent_source;
      if parent.index != no_index {
        let caller = propagate mark_source_ancestors(paths: paths, node: parent, width: width, remaining: limit, direct: direct);
        return merge_source_marks(first: move own, second: move caller);
      }
    }
    return Ok<SourceMarks, LayoutError>(value: move own);
  }
  let half = count / 2_u64;
  let next_base = base +sat half;
  let lower_result = changed_source_marks(document: document, styles: styles, paths: paths, changed: &changed^[0_u64..half], base: base, width: width);
  let upper_result = changed_source_marks(document: document, styles: styles, paths: paths, changed: &changed^[half..count], base: next_base, width: width);
  let lower = propagate move lower_result;
  let upper = propagate move upper_result;
  return merge_source_marks(first: move lower, second: move upper);
}

fn source_can_rebuild_at_checkpoint(context: &Context, old: &Styles, new: &Styles) -> valid: Bool reads(context), reads(old), reads(new) {
  doc "A saved body recipe is usable only while its root construction inputs are unchanged. Otherwise its marked caller must apply current root counter effects and choose the current recipe; speculative reconstruction never guesses from the old box kind.";
  let source = &context^.source;
  match source^ {
    DocumentBody(..) => {
      return True();
    }
    ElementBody(node: origin, ..) => {
      let at = element_at(styles: new, node: origin^);
      if at == unlisted {
        return False();
      }
      return retained_style(old: old, new: new, style: context^.style);
    }
    Derived() => {
      return False();
    }
  }
}

fn walk_from_source(context: &Context, atoms: &AtomTable, width: u64) -> result: Result<Walk, LayoutError> reads(context), reads(atoms) {
  doc "Constructs an independent builder from this body's saved input. Each speculative source receives its own counter stack and child pool; no mutable global walk serializes independent sources.";
  let word_n = list_item_word.len;
  let list_atom = atom_find(table: atoms, name: &list_item_word[0_u64..word_n]);
  let list_item = match list_atom {
    Some(value: atom) => {
      give atom.index;
    }
    None() => {
      give unlisted;
    }
  }
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  let pool = empty_source_pool(width: width);
  let incremental = True();
  let completed = SourceMarks::Empty();
  let retired = empty_retired_bodies();
  let work = no_source_work();
  let walk = Walk(counters: move counters, quote_depth: 0_i32, depth: 0_u64, list_item: list_item, incremental: incremental, pool: move pool, completed: move completed, retired: move retired, work: work);
  let source = &context^.source;
  match source^ {
    ElementBody(begin: before, ..) => {
      let restored = propagate restore_build_state(walk: &walk, state: before);
    }
    DocumentBody(begin: before, ..) => {
      let restored = propagate restore_build_state(walk: &walk, state: before);
    }
    Derived() => {
      return inconsistent::<Walk>();
    }
  }
  return Ok<Walk, LayoutError>(value: move walk);
}

fn child_change_valid(layout: &Layout, document: &Document, old: &Styles, new: &Styles, changed: &[Bool], change: ChildChange) -> valid: Bool reads(layout), reads(document), reads(old), reads(new), reads(changed) {
  doc "Checks detectable single-edit preconditions without recomputing the caller's complete style delta or pretending to reconstruct the old DOM. The old parent of a detach is the supplied fact; fresh attachment must name a node allocated after the old styles' NodeId domain.";
  if layout^.dirty {
    return False();
  }
  let nodes = document^.nodes.inner.len;
  if changed^.len != nodes {
    return False();
  }
  if new^.order.inner.len != nodes {
    return False();
  }
  if layout^.text_units.inner.len != layout^.source_paths.inner.len {
    return False();
  }
  let parent = cvt::<u32, u64>(change.parent.index);
  let child = cvt::<u32, u64>(change.child.index);
  let parent_exists = parent < nodes;
  let child_exists = child < nodes;
  let both = band(parent_exists, child_exists);
  if both {
  } else {
    return False();
  }
  if parent == child {
    return False();
  }
  let root = parent == 0_u64;
  let listed = new^.order.inner[parent] != no_index;
  let parent_attached = bor(root, listed);
  if parent_attached {
  } else {
    return False();
  }
  let actual_parent = document^.nodes.inner[child].links.parent;
  if change.attached {
    if child < old^.order.inner.len {
      return False();
    }
    match actual_parent {
      Some(value: origin) => {
        return origin.index == change.parent.index;
      }
      None() => {
        return False();
      }
    }
  }
  if child >= old^.order.inner.len {
    return False();
  }
  match actual_parent {
    None() => {
      return True();
    }
    Some(..) => {
      return False();
    }
  }
}

fn structural_source_marks(layout: &Layout, document: &Document, styles: &Styles, changed: &[Bool], change: ChildChange) -> result: Result<SourceMarks, LayoutError> reads(layout), reads(document), reads(styles), reads(changed) {
  doc "Combines the child-list consumer with independent structural-selector consumers. An edit below an unchanged complete child source does not directly mark the document or every ancestor for reconstruction.";
  let old_width = layout^.source_paths.inner.len;
  let width = document^.nodes.inner.len;
  let source = propagate enclosing_old_source(document: document, paths: &layout^.source_paths.inner[0_u64..old_width], node: change.parent);
  let direct = True();
  let structural_result = mark_source_ancestors(paths: &layout^.source_paths.inner[0_u64..old_width], node: source, width: width, remaining: old_width, direct: direct);
  let style_result = changed_source_marks(document: document, styles: styles, paths: &layout^.source_paths.inner[0_u64..old_width], changed: changed, base: 0_u64, width: width);
  let structural = propagate move structural_result;
  let style = propagate move style_result;
  return merge_source_marks(first: move structural, second: move style);
}

fn source_mark_size(marks: &SourceMarks) -> size: u64 reads(marks) {
  doc "The number of unique destinations cached by an owned sparse union, used to assign output intervals without a shared append counter.";
  match marks^ {
    Empty() => {
      return 0_u64;
    }
    Leaf(..) => {
      return 1_u64;
    }
    Fork(size: count, ..) => {
      return count^;
    }
  }
}

fn copy_source_ids(marks: &SourceMarks, width: u64, base: u64, output: &[NodeId]) -> valid: Bool reads(marks), writes(output) {
  doc "Materializes sorted completed-source identities into disjoint output intervals. Each child's output length is known from its immutable subtree, so neither copy depends on the other's result.";
  match marks^ {
    Empty() => {
      return output^.len == 0_u64;
    }
    Leaf(..) => {
      let singleton = width == 1_u64;
      let one = output^.len == 1_u64;
      let shaped = band(singleton, one);
      if shaped {
      } else {
        return False();
      }
      if base < 4294967295_u64 {
        let index = cvt::<u64, u32>(base);
        let node = NodeId(index: index);
        set output^[0_u64] = node;
        return True();
      }
      return False();
    }
    Fork(left: lower, right: upper, ..) => {
      let total = output^.len;
      let count = source_mark_size(marks: &lower^.inner);
      if count <= total {
      } else {
        return False();
      }
      let half = width / 2_u64;
      let rest = width - half;
      let upper_base = base +sat half;
      let low = copy_source_ids(marks: &lower^.inner, width: half, base: base, output: &output^[0_u64..count]);
      let high = copy_source_ids(marks: &upper^.inner, width: rest, base: upper_base, output: &output^[count..total]);
      return band(low, high);
    }
  }
}

fn completed_source_ids(marks: &SourceMarks, width: u64) -> result: Result<Box<Array<NodeId>>, LayoutError> reads(marks) {
  doc "Creates a read-only style-basis snapshot for one builder from completed child candidates. It contains only sparse completed identities, not every layout source.";
  let count = source_mark_size(marks: marks);
  if count > item_ceiling {
    return too_large::<Box<Array<NodeId>>>();
  }
  let absent = NodeId(index: no_index);
  let output = box_array_filled::<NodeId>(count: count, value: absent);
  let copied = copy_source_ids(marks: marks, width: width, base: 0_u64, output: &output.inner[0_u64..count]);
  if copied {
    return Ok<Box<Array<NodeId>>, LayoutError>(value: move output);
  }
  return inconsistent::<Box<Array<NodeId>>>();
}

enum FactTree {
  doc "Owned source-local fact leaves awaiting one final publication flatten. Cached subtree sizes assign disjoint output ranges without appending into a shared list.";
  Empty();
  Leaf(facts: SourceFacts);
  Fork(left: Box<FactTree>, right: Box<FactTree>, texts: u64, sources: u64);
}

struct FlatFacts {
  texts: Box<Array<TextFact>>;
  sources: Box<Array<SourceFact>>;
}

struct RetiredBodies {
  doc "Original source-local outputs revoked by one independent reconstruction. Counts exclude retained real child sources and derived placeholders left by ownership transfers.";
  facts: FactTree;
  contexts: u64;
  paragraphs: u64;
}

fn empty_retired_bodies() -> made: RetiredBodies pure {
  doc "An unchanged source produces neither retirements nor count adjustments, with no fact storage allocation.";
  let facts = FactTree::Empty();
  return RetiredBodies(facts: move facts, contexts: 0_u64, paragraphs: 0_u64);
}

fn source_fact_tree(facts: SourceFacts) -> made: FactTree pure {
  doc "Retains a completed source's fact storage without copying it into an aggregate list.";
  let no_texts = facts.texts.inner.len == 0_u64;
  let no_sources = facts.sources.inner.len == 0_u64;
  let empty = band(no_texts, no_sources);
  if empty {
    return FactTree::Empty();
  }
  return FactTree::Leaf(facts: move facts);
}

fn fact_tree_counts(tree: &FactTree) -> (texts: u64, sources: u64) reads(tree) {
  doc "Reads a leaf's fixed lengths or a join's cached lengths in constant time.";
  match tree^ {
    Empty() => {
      return 0_u64, 0_u64;
    }
    Leaf(facts: held) => {
      return held^.texts.inner.len, held^.sources.inner.len;
    }
    Fork(texts: text_count, sources: source_count, ..) => {
      return text_count^, source_count^;
    }
  }
}

fn copy_text_facts(input: &[TextFact], output: &[TextFact]) -> result: unit reads(input), writes(output) contract {
  requires input^.len == output^.len;
} {
  doc "Copies already collected route facts independently by slot.";
  let count = input^.len;
  for (i in 0_u64..count) {
    set output^[i] = input^[i];
  }
}

fn copy_source_facts(input: &[SourceFact], output: &[SourceFact]) -> result: unit reads(input), writes(output) contract {
  requires input^.len == output^.len;
} {
  doc "Copies already collected source ownership facts independently by slot.";
  let count = input^.len;
  for (i in 0_u64..count) {
    set output^[i] = input^[i];
  }
}

fn join_source_facts(first: FactTree, second: FactTree) -> result: Result<FactTree, LayoutError> pure {
  doc "Joins independent owned outputs in constant work, caching lengths for a single final parallel flatten. No fact is copied at intermediate source or caller joins.";
  let (text_a, source_a) = fact_tree_counts(tree: &first);
  let (text_b, source_b) = fact_tree_counts(tree: &second);
  let empty_a_text = text_a == 0_u64;
  let empty_a_source = source_a == 0_u64;
  let empty_a = band(empty_a_text, empty_a_source);
  if empty_a {
    return Ok<FactTree, LayoutError>(value: move second);
  }
  let empty_b_text = text_b == 0_u64;
  let empty_b_source = source_b == 0_u64;
  let empty_b = band(empty_b_text, empty_b_source);
  if empty_b {
    return Ok<FactTree, LayoutError>(value: move first);
  }
  let texts = text_a +sat text_b;
  let sources = source_a +sat source_b;
  let text_limit = texts <= item_ceiling;
  let source_limit = sources <= item_ceiling;
  let bounded = band(text_limit, source_limit);
  if bounded {
  } else {
    return too_large::<FactTree>();
  }
  let lower = box_new::<FactTree>(value: move first);
  let upper = box_new::<FactTree>(value: move second);
  let made = FactTree::Fork(left: move lower, right: move upper, texts: texts, sources: sources);
  return Ok<FactTree, LayoutError>(value: move made);
}

fn copy_fact_tree(tree: &FactTree, texts: &[TextFact], sources: &[SourceFact]) -> valid: Bool reads(tree), writes(texts), writes(sources) {
  doc "Copies completed source outputs once, through independent destination intervals given by cached subtree counts. Source discovery order does not order the leaf copies.";
  let text_total = texts^.len;
  let source_total = sources^.len;
  match tree^ {
    Empty() => {
      let no_texts = text_total == 0_u64;
      let no_sources = source_total == 0_u64;
      return band(no_texts, no_sources);
    }
    Leaf(facts: held) => {
      let text_count = held^.texts.inner.len;
      let source_count = held^.sources.inner.len;
      let text_equal = text_count == text_total;
      let source_equal = source_count == source_total;
      let matched = band(text_equal, source_equal);
      if matched {
      } else {
        return False();
      }
      copy_text_facts(input: &held^.texts.inner[0_u64..text_count], output: texts);
      copy_source_facts(input: &held^.sources.inner[0_u64..source_count], output: sources);
      return True();
    }
    Fork(left: lower, right: upper, ..) => {
      let (text_count, source_count) = fact_tree_counts(tree: &lower^.inner);
      let text_fits = text_count <= text_total;
      let source_fits = source_count <= source_total;
      let fits = band(text_fits, source_fits);
      if fits {
      } else {
        return False();
      }
      let first = copy_fact_tree(tree: &lower^.inner, texts: &texts^[0_u64..text_count], sources: &sources^[0_u64..source_count]);
      let second = copy_fact_tree(tree: &upper^.inner, texts: &texts^[text_count..text_total], sources: &sources^[source_count..source_total]);
      return band(first, second);
    }
  }
}

fn flatten_source_facts(tree: &FactTree) -> result: Result<FlatFacts, LayoutError> reads(tree) {
  doc "Allocates exact immutable publication arrays and flattens the owned result tree once. There is no runtime Array-to-Slots conversion or shared append dependency.";
  let (texts, sources) = fact_tree_counts(tree: tree);
  let text_limit = texts <= item_ceiling;
  let source_limit = sources <= item_ceiling;
  let bounded = band(text_limit, source_limit);
  if bounded {
  } else {
    return too_large::<FlatFacts>();
  }
  let absent = NodeId(index: no_index);
  let no = False();
  let text_unit = TextUnit(source: absent, local_context: no_index, piece: 0_u32, count: 0_u32, paragraph: no_index);
  let source_path = SourcePath(present: no, parent_source: absent, parent_local: no_index, child: no_index);
  let text_fact = TextFact(node: absent, value: text_unit);
  let source_fact = SourceFact(node: absent, value: source_path);
  let text_array = box_array_filled::<TextFact>(count: texts, value: text_fact);
  let source_array = box_array_filled::<SourceFact>(count: sources, value: source_fact);
  let copied = copy_fact_tree(tree: tree, texts: &text_array.inner[0_u64..texts], sources: &source_array.inner[0_u64..sources]);
  if copied {
  } else {
    return inconsistent::<FlatFacts>();
  }
  let made = FlatFacts(texts: move text_array, sources: move source_array);
  return Ok<FlatFacts, LayoutError>(value: move made);
}

fn join_retired_bodies(first: RetiredBodies, second: RetiredBodies) -> result: Result<RetiredBodies, LayoutError> pure {
  doc "Combines retirement results from disjoint old source owners; no retained subtree is counted again.";
  let contexts = first.contexts +sat second.contexts;
  let paragraphs = first.paragraphs +sat second.paragraphs;
  let facts = propagate join_source_facts(first: move first.facts, second: move second.facts);
  let made = RetiredBodies(facts: move facts, contexts: contexts, paragraphs: paragraphs);
  return Ok<RetiredBodies, LayoutError>(value: move made);
}

fn candidate_patch_empty(candidates: &CandidatePatch) -> empty: Bool reads(candidates) {
  doc "Tests whether a transferred ownership patch contains a candidate, including empty branches left by earlier claims.";
  match candidates^ {
    Empty() => {
      return True();
    }
    Leaf(..) => {
      return False();
    }
    Fork(left: lower, right: upper) => {
      let first = candidate_patch_empty(candidates: &lower^.inner);
      let second = candidate_patch_empty(candidates: &upper^.inner);
      return band(first, second);
    }
  }
}

fn retire_unused_candidates(candidates: CandidatePatch, new_sources: &[NodeId], width: u64) -> result: Result<RetiredBodies, LayoutError> reads(new_sources) {
  doc "Revokes only original bodies left unclaimed after reconstruction. A discarded speculative body has no published facts to revoke, but original children still owned by it must be visited; expanded wrappers retain their pre-extraction snapshots.";
  match move candidates {
    Empty() => {
      let made = empty_retired_bodies();
      return Ok<RetiredBodies, LayoutError>(value: move made);
    }
    Leaf(candidate: prior) => {
      let Candidate(context: body, complete: was_complete, styles_new: current_basis, facts: saved_facts, contexts: saved_contexts, paragraphs: saved_paragraphs) = move prior;
      let children = propagate collect_source_candidates(previous: &body, new_sources: new_sources, width: width);
      let below = propagate retire_unused_candidates(candidates: move children, new_sources: new_sources, width: width);
      if current_basis {
        return Ok<RetiredBodies, LayoutError>(value: move below);
      }
      let tree = source_fact_tree(facts: move saved_facts);
      let own = RetiredBodies(facts: move tree, contexts: saved_contexts, paragraphs: saved_paragraphs);
      return join_retired_bodies(first: move own, second: move below);
    }
    Fork(left: lower, right: upper) => {
      let first_result = retire_unused_candidates(candidates: move lower.inner, new_sources: new_sources, width: width);
      let second_result = retire_unused_candidates(candidates: move upper.inner, new_sources: new_sources, width: width);
      let first = propagate move first_result;
      let second = propagate move second_result;
      return join_retired_bodies(first: move first, second: move second);
    }
  }
}

fn retire_source_pool(pool: SourcePool, new_sources: &[NodeId], width: u64) -> result: Result<RetiredBodies, LayoutError> reads(new_sources) {
  doc "The replaced original body and unused original candidate sources are exactly this builder's retirements. Retained children were consumed out of the pool and cannot be rescanned or counted here.";
  let SourcePool(previous: donor, candidates: unused, width: saved_width) = move pool;
  let children = propagate retire_unused_candidates(candidates: move unused, new_sources: new_sources, width: width);
  match move donor {
    None() => {
      return Ok<RetiredBodies, LayoutError>(value: move children);
    }
    Some(value: prior) => {
      let Candidate(context: body, complete: was_complete, styles_new: current_basis, facts: saved_facts, contexts: saved_contexts, paragraphs: saved_paragraphs) = move prior;
      if current_basis {
        return Ok<RetiredBodies, LayoutError>(value: move children);
      }
      let tree = source_fact_tree(facts: move saved_facts);
      let own = RetiredBodies(facts: move tree, contexts: saved_contexts, paragraphs: saved_paragraphs);
      return join_retired_bodies(first: move own, second: move children);
    }
  }
}

fn record_completed_source(walk: &Walk, node: NodeId, width: u64) -> result: Result<unit, LayoutError> writes(walk.completed) {
  doc "Records one source actually built from current Styles in this private walk. The walk already carries the causal counter/quote chain; independently checkpointed walks return separate sets for balanced union.";
  let key = cvt::<u32, u64>(node.index);
  let direct = True();
  let own = propagate source_mark_single(width: width, key: key, direct: direct);
  let previous = SourceMarks::Empty();
  swap(first: &walk^.completed, second: &previous);
  let combined = propagate merge_source_marks(first: move previous, second: move own);
  set walk^.completed = move combined;
  return Ok<unit, LayoutError>(value: unit);
}

fn retain_output_summary(previous: &Context, replacement: &Context) -> result: unit reads(previous), writes(replacement) {
  doc "Preserves only the previous source's outward layout summary for its unchanged caller's delta comparison. New internal boxes and paragraph geometry remain fresh; restyled prevents this source from taking its old-content shortcut before recomputation.";
  set replacement^.space = previous^.space;
  set replacement^.laid = previous^.laid;
  set replacement^.x = previous^.x;
  set replacement^.y = previous^.y;
  set replacement^.width = previous^.width;
  set replacement^.height = previous^.height;
  set replacement^.baseline = previous^.baseline;
  set replacement^.has_baseline = previous^.has_baseline;
  set replacement^.margin_top = previous^.margin_top;
  set replacement^.margin_right = previous^.margin_right;
  set replacement^.margin_bottom = previous^.margin_bottom;
  set replacement^.margin_left = previous^.margin_left;
  set replacement^.flow_at = previous^.flow_at;
  set replacement^.block = previous^.block;
  set replacement^.beside = previous^.beside;
  set replacement^.viewport_origin = previous^.viewport_origin;
  set replacement^.min_content = previous^.min_content;
  set replacement^.max_content = previous^.max_content;
  set replacement^.intrinsic_known = previous^.intrinsic_known;
  set replacement^.intrinsic_basis = previous^.intrinsic_basis;
  set replacement^.content_raw = previous^.content_raw;
}

struct SourceUpdate {
  context: Context;
  retired: RetiredBodies;
  completed: SourceMarks;
  exit_changed: Bool;
  work: SourceWork;
}

struct ChildUpdates {
  retired: RetiredBodies;
  completed: SourceMarks;
  exit_changed: Bool;
  work: SourceWork;
}

struct BodyRecipe {
  node: NodeId;
  recipe: u8;
  kind: u8;
  style: StyleRef;
  document: Bool;
}

fn saved_body_recipe(context: &Context) -> result: Result<BodyRecipe, LayoutError> reads(context) {
  doc "Reads the validated old body's identity without retaining a reference across its ownership move. The caller has already checked that root construction inputs permit this saved recipe.";
  let source = &context^.source;
  match source^ {
    ElementBody(node: origin, recipe: construction, ..) => {
      let no = False();
      let made = BodyRecipe(node: origin^, recipe: construction^, kind: context^.kind, style: context^.style, document: no);
      return Ok<BodyRecipe, LayoutError>(value: made);
    }
    DocumentBody(node: origin, ..) => {
      let yes = True();
      let made = BodyRecipe(node: origin^, recipe: recipe_element, kind: ctx_flow, style: context^.style, document: yes);
      return Ok<BodyRecipe, LayoutError>(value: made);
    }
    Derived() => {
      return inconsistent::<BodyRecipe>();
    }
  }
}

fn structural_source_facts(context: &Context) -> result: Result<SourceFacts, LayoutError> reads(context) {
  doc "Includes the document source's own root record as well as its ordinary local outputs; element source entries are owned by their callers.";
  let facts = propagate collect_source_facts(context: context);
  let source = &context^.source;
  match source^ {
    DocumentBody(node: origin, ..) => {
      let yes = True();
      let absent = NodeId(index: no_index);
      let route = SourcePath(present: yes, parent_source: absent, parent_local: no_index, child: 0_u32);
      let fact = SourceFact(node: origin^, value: route);
      let added = propagate push_or_fail::<SourceFact>(cell: &facts.sources, value: fact);
    }
    ElementBody(..) => {
    }
    Derived() => {
    }
  }
  return Ok<SourceFacts, LayoutError>(value: move facts);
}

fn rebuild_selected_source(previous: Context, document: &Document, traversal: &Traversal, old: &Styles, new: &Styles, atoms: &AtomTable, new_sources: &[NodeId], width: u64) -> result: Result<SourceUpdate, LayoutError> reads(document), reads(traversal), reads(old), reads(new), reads(atoms), reads(new_sources) {
  doc "Reconstructs one selected complete source from its valid entry checkpoint. Retained children are claimed from this body's private ownership pool; an exit difference is returned to the actual caller for expansion.";
  let recipe = propagate saved_body_recipe(context: &previous);
  let walk = propagate walk_from_source(context: &previous, atoms: atoms, width: width);
  let facts = propagate structural_source_facts(context: &previous);
  let counts = propagate candidate_source_counts(context: &previous);
  let yes = True();
  let no = False();
  let prior = Candidate(context: move previous, complete: yes, styles_new: no, facts: move facts, contexts: counts.contexts, paragraphs: counts.paragraphs);
  let incoming = CandidatePatch::Empty();
  let pool = propagate make_source_pool(prior: move prior, incoming: move incoming, new_sources: new_sources, width: width);
  set walk.pool = move pool;
  let begin = propagate capture_build_state(walk: &walk);
  let context = if recipe.document {
    let root_node = if 0_u64 < traversal^.elements.inner.len {
      give traversal^.elements.inner[0_u64];
    } else {
      let absent = NodeId(index: no_index);
      give absent;
    }
    let root_style = element_ref(element: root_node);
    let style = anonymous_of(style: root_style);
    let initial = new_context(kind: ctx_flow, style: style);
    let open = new_open(style: style, first: 0_u64);
    let walked = propagate walk_children(document: document, old: old, styles: new, new_sources: new_sources, atoms: atoms, walk: &walk, parent: recipe.node, context: &initial, open: &open);
    let ended = propagate end_paragraph(context: &initial, open: &open);
    give move initial;
  } else {
    let element = element_at(styles: new, node: recipe.node);
    if element == unlisted {
      return inconsistent::<SourceUpdate>();
    }
    let body = propagate build_box_body(document: document, old: old, styles: new, new_sources: new_sources, atoms: atoms, walk: &walk, node: recipe.node, element: element, style: recipe.style, kind: recipe.kind);
    give move body;
  }
  let end = propagate capture_build_state(walk: &walk);
  let source = if recipe.document {
    let made = ContextSource::DocumentBody(node: recipe.node, begin: move begin, end: move end);
    give move made;
  } else {
    let made = ContextSource::ElementBody(node: recipe.node, recipe: recipe.recipe, begin: move begin, end: move end);
    give move made;
  }
  set context.source = move source;
  let reused = propagate finish_incremental_body(context: &context, pool: &walk.pool, document: document, old: old, new: new);
  let built_work = SourceWork(sources_built: 1_u64, sources_retained: 0_u64, paragraphs_reused: reused);
  let counted = propagate add_source_work(first: walk.work, second: built_work);
  set walk.work = counted;
  let donor = &walk.pool.previous;
  let equal = match donor^ {
    Some(value: held) => {
      give source_exit_same(first: &held^.context, second: &context);
    }
    None() => {
      return inconsistent::<SourceUpdate>();
    }
  }
  let exit_changed = bnot(equal);
  let recorded = propagate record_completed_source(walk: &walk, node: recipe.node, width: width);
  let Walk(counters: saved_counters, quote_depth: saved_quotes, depth: saved_depth, list_item: saved_list_item, incremental: was_incremental, pool: finished_pool, completed: built_sources, retired: child_retirements, work: actual_work) = move walk;
  let own = propagate retire_source_pool(pool: move finished_pool, new_sources: new_sources, width: width);
  let retired = propagate join_retired_bodies(first: move child_retirements, second: move own);
  let made = SourceUpdate(context: move context, retired: move retired, completed: move built_sources, exit_changed: exit_changed, work: actual_work);
  return Ok<SourceUpdate, LayoutError>(value: move made);
}

fn join_child_updates(first: ChildUpdates, second: ChildUpdates) -> result: Result<ChildUpdates, LayoutError> pure {
  doc "Combines independent children only after their separate reconstruction results exist. Geometry does not serialize their checkpointed construction.";
  let ChildUpdates(retired: first_retired, completed: first_completed, exit_changed: first_exit, work: first_work) = move first;
  let ChildUpdates(retired: second_retired, completed: second_completed, exit_changed: second_exit, work: second_work) = move second;
  let exit_changed = bor(first_exit, second_exit);
  let work = propagate add_source_work(first: first_work, second: second_work);
  let retired_result = join_retired_bodies(first: move first_retired, second: move second_retired);
  let completed_result = merge_source_marks(first: move first_completed, second: move second_completed);
  let retired = propagate move retired_result;
  let completed = propagate move completed_result;
  let made = ChildUpdates(retired: move retired, completed: move completed, exit_changed: exit_changed, work: work);
  return Ok<ChildUpdates, LayoutError>(value: move made);
}

fn update_selected_children(children: &[Context], marks: &SourceMarks, document: &Document, traversal: &Traversal, old: &Styles, new: &Styles, atoms: &AtomTable, width: u64) -> result: Result<ChildUpdates, LayoutError> reads(marks), reads(document), reads(traversal), reads(old), reads(new), reads(atoms), writes(children) {
  doc "Reconstructs separate selected source subtrees through disjoint owned child slots. Source-local derived nodes only connect those ownership paths; unchanged real source subtrees terminate traversal.";
  let count = children^.len;
  if count == 0_u64 {
    let retired = empty_retired_bodies();
    let completed = SourceMarks::Empty();
    let no = False();
    let work = no_source_work();
    let made = ChildUpdates(retired: move retired, completed: move completed, exit_changed: no, work: work);
    return Ok<ChildUpdates, LayoutError>(value: move made);
  }
  if count == 1_u64 {
    let source = context_source_node(context: &children^[0_u64]);
    if source.index != no_index {
      let key = cvt::<u32, u64>(source.index);
      let selected = source_mark_at(marks: marks, width: width, key: key);
      match selected {
        None() => {
          let retired = empty_retired_bodies();
          let completed = SourceMarks::Empty();
          let no = False();
          let work = no_source_work();
          let made = ChildUpdates(retired: move retired, completed: move completed, exit_changed: no, work: work);
          return Ok<ChildUpdates, LayoutError>(value: move made);
        }
        Some(..) => {
        }
      }
    }
    let style = children^[0_u64].style;
    let held = new_context(kind: ctx_flow, style: style);
    swap(first: &children^[0_u64], second: &held);
    let updated = propagate update_selected_source(context: move held, marks: marks, document: document, traversal: traversal, old: old, new: new, atoms: atoms, width: width);
    let SourceUpdate(context: replacement, retired: retired_bodies, completed: completed_ids, exit_changed: changed_exit, work: actual_work) = move updated;
    set children^[0_u64] = move replacement;
    let made = ChildUpdates(retired: move retired_bodies, completed: move completed_ids, exit_changed: changed_exit, work: actual_work);
    return Ok<ChildUpdates, LayoutError>(value: move made);
  }
  let half = count / 2_u64;
  let first_result = update_selected_children(children: &children^[0_u64..half], marks: marks, document: document, traversal: traversal, old: old, new: new, atoms: atoms, width: width);
  let second_result = update_selected_children(children: &children^[half..count], marks: marks, document: document, traversal: traversal, old: old, new: new, atoms: atoms, width: width);
  let first = propagate move first_result;
  let second = propagate move second_result;
  return join_child_updates(first: move first, second: move second);
}

fn update_selected_source(context: Context, marks: &SourceMarks, document: &Document, traversal: &Traversal, old: &Styles, new: &Styles, atoms: &AtomTable, width: u64) -> result: Result<SourceUpdate, LayoutError> reads(marks), reads(document), reads(traversal), reads(old), reads(new), reads(atoms) {
  doc "Builds the selected frontier bottom-up from saved inputs. A caller reconstructs its own body only for a direct input change or changed child exit state; unchanged exits stop semantic expansion even while geometry remains marked.";
  let source = context_source_node(context: &context);
  let real = source.index != no_index;
  let direct = if real {
    let key = cvt::<u32, u64>(source.index);
    let selected = source_mark_at(marks: marks, width: width, key: key);
    match selected {
      None() => {
        let retired = empty_retired_bodies();
        let completed = SourceMarks::Empty();
        let no = False();
        let work = no_source_work();
        let made = SourceUpdate(context: move context, retired: move retired, completed: move completed, exit_changed: no, work: work);
        return Ok<SourceUpdate, LayoutError>(value: move made);
      }
      Some(value: local) => {
        give local;
      }
    }
  } else {
    give False();
  }
  let children = context.children.inner.len;
  let below = propagate update_selected_children(children: &context.children.inner[0_u64..children], marks: marks, document: document, traversal: traversal, old: old, new: new, atoms: atoms, width: width);
  let ChildUpdates(retired: below_retired, completed: below_completed, exit_changed: below_exit, work: below_work) = move below;
  refresh_structure_marks(context: &context);
  if context.marked_children > 0_u32 {
    set context.dirty = True();
  }
  let own_input = bor(direct, below_exit);
  let needs_body = band(real, own_input);
  if needs_body {
    let valid_recipe = source_can_rebuild_at_checkpoint(context: &context, old: old, new: new);
    if valid_recipe {
      let ids = propagate completed_source_ids(marks: &below_completed, width: width);
      let length = ids.inner.len;
      let rebuilt = propagate rebuild_selected_source(previous: move context, document: document, traversal: traversal, old: old, new: new, atoms: atoms, new_sources: &ids.inner[0_u64..length], width: width);
      let SourceUpdate(context: replacement, retired: own_retired, completed: own_completed, exit_changed: own_exit, work: own_work) = move rebuilt;
      let work = propagate add_source_work(first: below_work, second: own_work);
      let retired_result = join_retired_bodies(first: move below_retired, second: move own_retired);
      let completed_result = merge_source_marks(first: move below_completed, second: move own_completed);
      let retired = propagate move retired_result;
      let completed = propagate move completed_result;
      let made = SourceUpdate(context: move replacement, retired: move retired, completed: move completed, exit_changed: own_exit, work: work);
      return Ok<SourceUpdate, LayoutError>(value: move made);
    }
  }
  let exit_changed = if real {
    give needs_body;
  } else {
    give below_exit;
  }
  let made = SourceUpdate(context: move context, retired: move below_retired, completed: move below_completed, exit_changed: exit_changed, work: below_work);
  return Ok<SourceUpdate, LayoutError>(value: move made);
}

fn collect_updated_children(children: &[Context], completed: &SourceMarks, width: u64) -> result: Result<RetiredBodies, LayoutError> reads(children), reads(completed) {
  doc "Collects final current source outputs through independent marked child ranges, stopping at every clean retained subtree.";
  let count = children^.len;
  if count == 0_u64 {
    let empty = empty_retired_bodies();
    return Ok<RetiredBodies, LayoutError>(value: move empty);
  }
  if count == 1_u64 {
    return collect_updated_bodies(context: &children^[0_u64], completed: completed, width: width);
  }
  let half = count / 2_u64;
  let first_result = collect_updated_children(children: &children^[0_u64..half], completed: completed, width: width);
  let second_result = collect_updated_children(children: &children^[half..count], completed: completed, width: width);
  let first = propagate move first_result;
  let second = propagate move second_result;
  return join_retired_bodies(first: move first, second: move second);
}

fn collect_updated_bodies(context: &Context, completed: &SourceMarks, width: u64) -> result: Result<RetiredBodies, LayoutError> reads(context), reads(completed) {
  doc "Collects only final rebuilt sources, excluding speculative bodies superseded or removed during caller expansion. RetiredBodies is the owned facts-and-counts carrier for both sides of the route transaction.";
  if context^.dirty {
  } else {
    let empty = empty_retired_bodies();
    return Ok<RetiredBodies, LayoutError>(value: move empty);
  }
  let node = context_source_node(context: context);
  let own = if node.index != no_index {
    let key = cvt::<u32, u64>(node.index);
    let found = source_mark_at(marks: completed, width: width, key: key);
    match found {
      Some(..) => {
        let facts = propagate structural_source_facts(context: context);
        let counts = propagate candidate_source_counts(context: context);
        let tree = source_fact_tree(facts: move facts);
        let made = RetiredBodies(facts: move tree, contexts: counts.contexts, paragraphs: counts.paragraphs);
        give move made;
      }
      None() => {
        give empty_retired_bodies();
      }
    }
  } else {
    give empty_retired_bodies();
  }
  let count = context^.children.inner.len;
  let below = propagate collect_updated_children(children: &context^.children.inner[0_u64..count], completed: completed, width: width);
  return join_retired_bodies(first: move own, second: move below);
}

fn children_changed(layout: Layout, document: &Document, traversal: &Traversal, old: &Styles, new: &Styles, atoms: &AtomTable, changed: &[Bool], change: ChildChange) -> result: Result<Layout, LayoutError> reads(document), reads(traversal), reads(old), reads(new), reads(atoms), reads(changed) {
  doc "Consumes a single child edit into independently checkpointed source reconstructions. Semantic exit changes expand callers; final source facts replace only their named old owners, and geometry remains marked for update.";
  let valid = child_change_valid(layout: &layout, document: document, old: old, new: new, changed: changed, change: change);
  if valid {
  } else {
    return inconsistent::<Layout>();
  }
  let nodes = document^.nodes.inner.len;
  if nodes > item_ceiling {
    return too_large::<Layout>();
  }
  if traversal^.order.inner.len != nodes {
    return inconsistent::<Layout>();
  }
  let marks = propagate structural_source_marks(layout: &layout, document: document, styles: new, changed: changed, change: change);
  let Layout(root: previous, viewport: kept_viewport, paragraphs: old_paragraphs, contexts: old_contexts, text_units: texts, source_paths: sources, dirty: was_dirty, last_update: last, last_child_update: prior_child_update) = move layout;
  let updated = propagate update_selected_source(context: move previous, marks: &marks, document: document, traversal: traversal, old: old, new: new, atoms: atoms, width: nodes);
  let SourceUpdate(context: replacement, retired: retired_bodies, completed: completed_ids, exit_changed: final_exit, work: actual_work) = move updated;
  let current = propagate collect_updated_bodies(context: &replacement, completed: &completed_ids, width: nodes);
  if retired_bodies.contexts > old_contexts {
    return inconsistent::<Layout>();
  }
  if retired_bodies.paragraphs > old_paragraphs {
    return inconsistent::<Layout>();
  }
  let kept_contexts = old_contexts - retired_bodies.contexts;
  let kept_paragraphs = old_paragraphs - retired_bodies.paragraphs;
  let contexts = kept_contexts +sat current.contexts;
  let paragraphs = kept_paragraphs +sat current.paragraphs;
  let context_limit = contexts <= item_ceiling;
  let paragraph_limit = paragraphs <= item_ceiling;
  let bounded = band(context_limit, paragraph_limit);
  if bounded {
  } else {
    return too_large::<Layout>();
  }
  let retired_facts = propagate flatten_source_facts(tree: &retired_bodies.facts);
  let current_facts = propagate flatten_source_facts(tree: &current.facts);
  let retired_text_count = retired_facts.texts.inner.len;
  let retired_source_count = retired_facts.sources.inner.len;
  let current_text_count = current_facts.texts.inner.len;
  let current_source_count = current_facts.sources.inner.len;
  let published = propagate replace_source_routes(texts: &texts, sources: &sources, nodes: nodes, retired_texts: &retired_facts.texts.inner[0_u64..retired_text_count], retired_sources: &retired_facts.sources.inner[0_u64..retired_source_count], next_texts: &current_facts.texts.inner[0_u64..current_text_count], next_sources: &current_facts.sources.inner[0_u64..current_source_count]);
  let dirty = replacement.dirty;
  let child_counts = ChildUpdateCounts(sources_built: actual_work.sources_built, sources_retained: actual_work.sources_retained, paragraphs_reused: actual_work.paragraphs_reused, text_routes_written: published.text_routes_written, source_routes_written: published.source_routes_written, text_routes_changed: published.text_routes_changed, source_routes_changed: published.source_routes_changed, old_route_capacity: published.old_capacity, route_capacity: published.capacity, route_slots_copied: published.copied_slots);
  let none = no_updates();
  let made = Layout(root: move replacement, viewport: kept_viewport, paragraphs: paragraphs, contexts: contexts, text_units: move texts, source_paths: move sources, dirty: dirty, last_update: none, last_child_update: child_counts);
  return Ok<Layout, LayoutError>(value: move made);
}

struct SourceWork {
  doc "Actual source construction and ownership operations performed by one private builder or independent candidate result. This record counts occurrences, not unique final source identities.";
  sources_built: u64;
  sources_retained: u64;
  paragraphs_reused: u64;
}

fn no_source_work() -> made: SourceWork pure {
  doc "A source not visited by construction or candidate claiming contributes no work.";
  return SourceWork(sources_built: 0_u64, sources_retained: 0_u64, paragraphs_reused: 0_u64);
}

fn add_source_work(first: SourceWork, second: SourceWork) -> result: Result<SourceWork, LayoutError> pure {
  doc "Adds already completed independent work, including speculative work later superseded. Refuses count overflow rather than wrapping or saturating an observation.";
  let built_room = 18446744073709551615_u64 - first.sources_built;
  let retained_room = 18446744073709551615_u64 - first.sources_retained;
  let reused_room = 18446744073709551615_u64 - first.paragraphs_reused;
  if second.sources_built > built_room {
    return too_large::<SourceWork>();
  }
  if second.sources_retained > retained_room {
    return too_large::<SourceWork>();
  }
  if second.paragraphs_reused > reused_room {
    return too_large::<SourceWork>();
  }
  let built = first.sources_built + second.sources_built;
  let retained = first.sources_retained + second.sources_retained;
  let reused = first.paragraphs_reused + second.paragraphs_reused;
  let made = SourceWork(sources_built: built, sources_retained: retained, paragraphs_reused: reused);
  return Ok<SourceWork, LayoutError>(value: made);
}

fn no_child_updates() -> made: ChildUpdateCounts pure {
  doc "The initial child-list work report. Initial full construction is not a child-list update, so even its route capacities are reported as zero here.";
  return ChildUpdateCounts(sources_built: 0_u64, sources_retained: 0_u64, paragraphs_reused: 0_u64, text_routes_written: 0_u64, source_routes_written: 0_u64, text_routes_changed: 0_u64, source_routes_changed: 0_u64, old_route_capacity: 0_u64, route_capacity: 0_u64, route_slots_copied: 0_u64);
}

fn child_update_counts(layout: &Layout) -> counts: ChildUpdateCounts reads(layout) {
  doc "Returns the latest successful child-list operation's report. Geometry updates and text or style marking leave this separate observation unchanged.";
  return layout^.last_child_update;
}
