alias Atom = pkg::base::atom::Atom;
alias Styles = pkg::style::Styles;
alias Traversal = pkg::style::Traversal;
alias changed_boxes_only = pkg::style::changed_boxes_only;
alias atom_class = pkg::base::static_atoms::atom_class;
alias item_attr = pkg::css::values::item_attr;

fn same_content_items(old: &Styles, new: &Styles, first: u32, second: u32) -> same: Bool reads(old), reads(new) {
  doc "Compares content lists by their items and retained generated-text offsets, never by a run's interned identifier.";
  let predefined_old = first < 2_u32;
  let predefined_new = second < 2_u32;
  let predefined = bor(predefined_old, predefined_new);
  if predefined {
    return first == second;
  }
  let a = cvt::<u32, u64>(first);
  let b = cvt::<u32, u64>(second);
  let listed_old = a < old^.content_lists.inner.len;
  let listed_new = b < new^.content_lists.inner.len;
  let listed = band(listed_old, listed_new);
  if listed {
  } else {
    return False();
  }
  let x = old^.content_lists.inner[a];
  let y = new^.content_lists.inner[b];
  let x_count = x.end -sat x.first;
  let y_count = y.end -sat y.first;
  if x_count != y_count {
    return False();
  }
  let count = cvt::<u32, u64>(x_count);
  let x_start = cvt::<u32, u64>(x.first);
  let y_start = cvt::<u32, u64>(y.first);
  let equal = True();
  for (i in 0_u64..count) {
    let p = x_start +sat i;
    let q = y_start +sat i;
    let old_inside = p < old^.content_items.inner.len;
    let new_inside = q < new^.content_items.inner.len;
    let inside = band(old_inside, new_inside);
    let item_equal = if inside {
      let x_item = old^.content_items.inner[p];
      let y_item = new^.content_items.inner[q];
      let kind = x_item.kind == y_item.kind;
      let start = x_item.text_start == y_item.text_start;
      let end = x_item.text_end == y_item.text_end;
      let name = x_item.name.index == y_item.name.index;
      let list_style = x_item.list_style.index == y_item.list_style.index;
      let span = band(start, end);
      let named = band(name, list_style);
      let value = band(span, named);
      let item_same = band(kind, value);
      give item_same;
    } else {
      give False();
    }
    set equal = band(equal, item_equal);
  }
  return equal;
}

fn same_counter_items(old: &Styles, new: &Styles, first: u32, second: u32) -> same: Bool reads(old), reads(new) {
  doc "Compares the counter operations whose effects the box builder has already written as scalar pieces.";
  let a = cvt::<u32, u64>(first);
  let b = cvt::<u32, u64>(second);
  let listed_old = a < old^.counter_lists.inner.len;
  let listed_new = b < new^.counter_lists.inner.len;
  let listed = band(listed_old, listed_new);
  if listed {
  } else {
    return False();
  }
  let x = old^.counter_lists.inner[a];
  let y = new^.counter_lists.inner[b];
  let x_count = x.end -sat x.first;
  let y_count = y.end -sat y.first;
  if x_count != y_count {
    return False();
  }
  let count = cvt::<u32, u64>(x_count);
  let x_start = cvt::<u32, u64>(x.first);
  let y_start = cvt::<u32, u64>(y.first);
  let equal = True();
  for (i in 0_u64..count) {
    let p = x_start +sat i;
    let q = y_start +sat i;
    let old_inside = p < old^.counter_changes.inner.len;
    let new_inside = q < new^.counter_changes.inner.len;
    let inside = band(old_inside, new_inside);
    let item_equal = if inside {
      let x_item = old^.counter_changes.inner[p];
      let y_item = new^.counter_changes.inner[q];
      let name = x_item.name.index == y_item.name.index;
      let value = x_item.value == y_item.value;
      let item_same = band(name, value);
      give item_same;
    } else {
      give False();
    }
    set equal = band(equal, item_equal);
  }
  return equal;
}

fn same_quote_items(old: &Styles, new: &Styles, first: u32, second: u32) -> same: Bool reads(old), reads(new) {
  doc "Compares quote lists by their retained generated-text offsets, distinguishing auto and none.";
  let predefined_old = first < 2_u32;
  let predefined_new = second < 2_u32;
  let predefined = bor(predefined_old, predefined_new);
  if predefined {
    return first == second;
  }
  let a = cvt::<u32, u64>(first);
  let b = cvt::<u32, u64>(second);
  let listed_old = a < old^.quote_lists.inner.len;
  let listed_new = b < new^.quote_lists.inner.len;
  let listed = band(listed_old, listed_new);
  if listed {
  } else {
    return False();
  }
  let x = old^.quote_lists.inner[a];
  let y = new^.quote_lists.inner[b];
  let x_count = x.end -sat x.first;
  let y_count = y.end -sat y.first;
  if x_count != y_count {
    return False();
  }
  let count = cvt::<u32, u64>(x_count);
  let x_start = cvt::<u32, u64>(x.first);
  let y_start = cvt::<u32, u64>(y.first);
  let equal = True();
  for (i in 0_u64..count) {
    let p = x_start +sat i;
    let q = y_start +sat i;
    let old_inside = p < old^.quote_pairs.inner.len;
    let new_inside = q < new^.quote_pairs.inner.len;
    let inside = band(old_inside, new_inside);
    let item_equal = if inside {
      let x_item = old^.quote_pairs.inner[p];
      let y_item = new^.quote_pairs.inner[q];
      let open_start = x_item.open_start == y_item.open_start;
      let open_end = x_item.open_end == y_item.open_end;
      let close_start = x_item.close_start == y_item.close_start;
      let close_end = x_item.close_end == y_item.close_end;
      let opening = band(open_start, open_end);
      let closing = band(close_start, close_end);
      let item_same = band(opening, closing);
      give item_same;
    } else {
      give False();
    }
    set equal = band(equal, item_equal);
  }
  return equal;
}

fn retained_style(old: &Styles, new: &Styles, style: StyleRef) -> same: Bool reads(old), reads(new) {
  doc "Checks the style inputs consumed by box construction rather than layout: box classification, multi-column context establishment, marker kinds and positions, counters, quotes and generated contents. Computed lengths may change, including em column widths that keep a multi-column context.";
  let a = box_of(styles: old, style: style);
  let b = box_of(styles: new, style: style);
  let display = a.display == b.display;
  let position = a.position == b.position;
  let floated = a.float == b.float;
  let overflow_x = a.overflow_x == b.overflow_x;
  let overflow_y = a.overflow_y == b.overflow_y;
  let display_position = band(display, position);
  let flow = band(display_position, floated);
  let overflow = band(overflow_x, overflow_y);
  let same_box = band(flow, overflow);
  if same_box {
  } else {
    return False();
  }
  let old_columns = multicol(styles: old, style: style);
  let new_columns = multicol(styles: new, style: style);
  let columns = old_columns == new_columns;
  if columns {
  } else {
    return False();
  }
  let old_text = text_of(styles: old, style: style);
  let new_text = text_of(styles: new, style: style);
  if old_text.list_style_type.index != new_text.list_style_type.index {
    return False();
  }
  let x = content_of(styles: old, style: style);
  let y = content_of(styles: new, style: style);
  if x.list_style_position != y.list_style_position {
    return False();
  }
  let content = same_content_items(old: old, new: new, first: x.content, second: y.content);
  let reset = same_counter_items(old: old, new: new, first: x.counter_reset, second: y.counter_reset);
  let increment = same_counter_items(old: old, new: new, first: x.counter_increment, second: y.counter_increment);
  let counter_set = same_counter_items(old: old, new: new, first: x.counter_set, second: y.counter_set);
  let quotes = same_quote_items(old: old, new: new, first: x.quotes, second: y.quotes);
  let counters_a = band(reset, increment);
  let counters = band(counters_a, counter_set);
  let generated = band(content, quotes);
  let same = band(counters, generated);
  return same;
}

fn retained_styles(old: &Styles, new: &Styles, traversal: &Traversal) -> same: Bool reads(old), reads(new), reads(traversal) {
  doc "Checks every construction input and the identity of every pseudo slot before a retained tree is changed: the two results must list the same elements at the same preorder positions (equal order maps, traversal's elements), so a structural edit is refused here. Conservatively requires generated bytes at their old positions even when no current paragraph reads a changed byte; a later text edit may prepare such a paragraph.";
  let elements = old^.elements.inner.len;
  let pseudos = old^.pseudos.inner.len;
  let bytes = old^.generated_text.inner.len;
  let nodes = old^.order.inner.len;
  let same_elements = elements == new^.elements.inner.len;
  let same_pseudos = pseudos == new^.pseudos.inner.len;
  let same_bytes = bytes == new^.generated_text.inner.len;
  let same_nodes = nodes == new^.order.inner.len;
  let same_traversal = elements == traversal^.elements.inner.len;
  let same_lists = band(same_elements, same_pseudos);
  let same_texts = band(same_bytes, same_nodes);
  let same_counts = band(same_lists, same_texts);
  let same_sizes = band(same_counts, same_traversal);
  if same_sizes {
  } else {
    return False();
  }
  let equal = True();
  for (k in 0_u64..nodes) {
    let same = old^.order.inner[k] == new^.order.inner[k];
    set equal = band(equal, same);
  }
  for (i in 0_u64..bytes) {
    let same = old^.generated_text.inner[i] == new^.generated_text.inner[i];
    set equal = band(equal, same);
  }
  for (i in 0_u64..elements) {
    let node = traversal^.elements.inner[i];
    let style = element_ref(element: node.index);
    let same = retained_style(old: old, new: new, style: style);
    set equal = band(equal, same);
  }
  for (i in 0_u64..pseudos) {
    let a = old^.pseudos.inner[i];
    let b = new^.pseudos.inner[i];
    let owner = a.element == b.element;
    let kind = a.kind == b.kind;
    let identity = band(owner, kind);
    let position = cvt::<u32, u64>(a.element);
    let element = if position < traversal^.elements.inner.len {
      give traversal^.elements.inner[position].index;
    } else {
      give no_index;
    }
    let index = cvt.wrap::<u64, u32>(i);
    let style = pseudo_ref(element: element, pseudo: index);
    let same_construction = retained_style(old: old, new: new, style: style);
    let same = band(identity, same_construction);
    set equal = band(equal, same);
  }
  return equal;
}

fn style_is_changed(changed: &[Bool], root: u32, style: StyleRef) -> marked: Bool reads(changed) {
  doc "The delta of the element supplying style, by its NodeId index, including an anonymous box or pseudo-element that inherits it; root is the root element's NodeId index, which root_element names.";
  let element = if style.element == root_element {
    give root;
  } else {
    give style.element;
  }
  let at = cvt::<u32, u64>(element);
  if at < changed^.len {
    return changed^[at];
  }
  return False();
}

fn piece_is_changed(changed: &[Bool], root: u32, piece: Piece) -> marked: Bool reads(changed) {
  doc "Checks every piece's style, including empty inline boxes whose Begin and End are the only consumers.";
  let style = piece_style(piece: piece);
  let marked = style_is_changed(changed: changed, root: root, style: style);
  return marked;
}

fn mark_style_paragraph(paragraph: &Paragraph, changed: &[Bool], runs: &[Bool], root: u32) -> result: unit reads(changed), reads(runs), writes(paragraph) {
  doc "Marks one paragraph from its own strut style, which reads its block's font and text values (runs), and its pieces, whose inline boxes read every value (changed), independently of every other paragraph.";
  let own = style_is_changed(changed: runs, root: root, style: paragraph^.style);
  let marked = bor(own, paragraph^.dirty);
  let count = paragraph^.pieces.inner.len;
  for (i in 0_u64..count) {
    if i < paragraph^.pieces.inner.len {
      let reads_change = piece_is_changed(changed: changed, root: root, piece: paragraph^.pieces.inner[i]);
      set marked = bor(marked, reads_change);
    }
  }
  set paragraph^.dirty = marked;
  return unit;
}

fn paragraph_mark_count(paragraphs: &[Paragraph]) -> count: u32 reads(paragraphs) {
  doc "Counts independently marked paragraphs; this reads the completed paragraph marks and does not depend on their largest index.";
  let length = paragraphs^.len;
  let count = 0_u32;
  for (i in 0_u64..length) {
    if paragraphs^[i].dirty {
      set count = count +wrap 1_u32;
    }
  }
  return count;
}

fn paragraph_mark_index(paragraphs: &[Paragraph]) -> index: u32 reads(paragraphs) {
  doc "The largest marked paragraph index, or zero when none is marked; only the caller's single-mark case uses it, and finding it is independent of counting marks.";
  let length = paragraphs^.len;
  let index = 0_u32;
  for (i in 0_u64..length) {
    if paragraphs^[i].dirty {
      let at = cvt.wrap::<u64, u32>(i);
      set index = imax(index, at);
    }
  }
  return index;
}

fn child_mark_count(children: &[Context]) -> count: u32 reads(children) {
  doc "Counts marked child contexts after their independent marking calls have finished.";
  let length = children^.len;
  let count = 0_u32;
  for (i in 0_u64..length) {
    if children^[i].dirty {
      set count = count +wrap 1_u32;
    }
  }
  return count;
}

fn child_mark_index(children: &[Context]) -> index: u32 reads(children) {
  doc "The largest marked child index, or zero when none is marked; it depends on the completed child marks, not on the count or the child-style reduction.";
  let length = children^.len;
  let index = 0_u32;
  for (i in 0_u64..length) {
    if children^[i].dirty {
      let at = cvt.wrap::<u64, u32>(i);
      set index = imax(index, at);
    }
  }
  return index;
}

fn child_style_change(children: &[Context], changed: &[Bool], root: u32) -> found: Bool reads(children), reads(changed) {
  doc "Whether a child's own style changed; this reads only the style inputs and delta, independently of the child-mark count and index.";
  let length = children^.len;
  let found = False();
  for (i in 0_u64..length) {
    let style = children^[i].style;
    let own = style_is_changed(changed: changed, root: root, style: style);
    set found = bor(found, own);
  }
  return found;
}

fn mark_style_context(context: &Context, changed: &[Bool], runs: &[Bool], root: u32) -> result: unit reads(changed), reads(runs), writes(context) {
  doc "Marks independent local consumers and child contexts, then gathers their marks. The parent reads each child's own style for its placement as well as its outputs, so a changed child style also invalidates the parent's text-only geometry cutoff.";
  let local = style_is_changed(changed: changed, root: root, style: context^.style);
  let blocks = context^.blocks.inner.len;
  let interior_changed = False();
  for (i in 0_u64..blocks) {
    let marked = style_is_changed(changed: changed, root: root, style: context^.blocks.inner[i].style);
    set local = bor(local, marked);
    set interior_changed = bor(interior_changed, marked);
  }
  if interior_changed {
    set context^.restyled_blocks = 2_u32;
    set context^.restyled_block = no_index;
  }
  let rows = context^.rows.inner.len;
  for (i in 0_u64..rows) {
    let row = context^.rows.inner[i];
    let own = style_is_changed(changed: changed, root: root, style: row.style);
    let group = style_is_changed(changed: changed, root: root, style: row.group);
    let marked = bor(own, group);
    set local = bor(local, marked);
  }
  let columns = context^.columns.inner.len;
  for (i in 0_u64..columns) {
    let column = context^.columns.inner[i];
    let own = if column.styled {
      give style_is_changed(changed: changed, root: root, style: column.style);
    } else {
      give False();
    }
    let group = style_is_changed(changed: changed, root: root, style: column.group);
    let marked = bor(own, group);
    set local = bor(local, marked);
  }
  let paragraphs = context^.paragraphs.inner.len;
  for (i in 0_u64..paragraphs) {
    mark_style_paragraph(paragraph: &context^.paragraphs.inner[i], changed: changed, runs: runs, root: root);
  }
  let children = context^.children.inner.len;
  for (i in 0_u64..children) {
    mark_style_context(context: &context^.children.inner[i], changed: changed, runs: runs, root: root);
  }
  let paragraphs_now = context^.paragraphs.inner.len;
  let children_now = context^.children.inner.len;
  let frontier_span = frontier_span_for(count: paragraphs_now);
  let frontier = frontier_from_paragraphs(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs_now], span: frontier_span);
  set context^.paragraph_frontier = move frontier;
  set context^.frontier_span = frontier_span;
  let marked_paragraphs = paragraph_mark_count(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs_now]);
  let marked_paragraph = paragraph_mark_index(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs_now]);
  let marked_children = child_mark_count(children: &context^.children.inner[0_u64..children_now]);
  let marked_child = child_mark_index(children: &context^.children.inner[0_u64..children_now]);
  let child_styles = child_style_change(children: &context^.children.inner[0_u64..children_now], changed: changed, root: root);
  set local = bor(local, child_styles);
  let prepared = marked_paragraphs > 0_u32;
  let descendants = marked_children > 0_u32;
  let content = bor(prepared, descendants);
  let dirty = bor(local, content);
  set context^.restyled = bor(context^.restyled, local);
  set context^.dirty = bor(context^.dirty, dirty);
  set context^.marked_paragraphs = marked_paragraphs;
  set context^.marked_paragraph = marked_paragraph;
  set context^.marked_children = marked_children;
  set context^.marked_child = marked_child;
  return unit;
}

fn supported_attribute(traversal: &Traversal, attribute: AttributeChange) -> valid: Bool reads(traversal) {
  doc "Accepts a class change on a listed element. The search is a reduction over independent node identities; an unknown node or another attribute requires box-tree handling.";
  if attribute.name.index != atom_class {
    return False();
  }
  let count = traversal^.elements.inner.len;
  let found = False();
  for (i in 0_u64..count) {
    let listed_node = traversal^.elements.inner[i];
    let same = listed_node.index == attribute.node.index;
    set found = bor(found, same);
  }
  return found;
}

fn content_reads_attribute(styles: &Styles, style: StyleRef, name: Atom) -> reads_name: Bool reads(styles) {
  doc "Whether a generated pseudo-element's content reads the named originating-element attribute. An absent content list or display none produces no attribute piece.";
  let box_group = box_of(styles: styles, style: style);
  if box_group.display == display_none {
    return False();
  }
  let content = content_of(styles: styles, style: style);
  if content.content <= 1_u32 {
    return False();
  }
  let at = cvt::<u32, u64>(content.content);
  if at < styles^.content_lists.inner.len {
  } else {
    return True();
  }
  let list = styles^.content_lists.inner[at];
  let first = cvt::<u32, u64>(list.first);
  let end = cvt::<u32, u64>(list.end);
  let reads_name = False();
  for (i in first..end) {
    let item_reads = if i < styles^.content_items.inner.len {
      let item = styles^.content_items.inner[i];
      let attribute = item.kind == item_attr;
      let named = item.name.index == name.index;
      let matches = band(attribute, named);
      give matches;
    } else {
      give True();
    }
    set reads_name = bor(reads_name, item_reads);
  }
  return reads_name;
}

fn retained_pseudo_attributes(styles: &Styles, traversal: &Traversal, attributes: &[AttributeChange], at: u64) -> retained: Bool reads(styles), reads(traversal), reads(attributes) {
  doc "Maps a pseudo-element's preorder owner to its stable originating node, then checks only facts for that node and the attribute its content reads.";
  if at < styles^.pseudos.inner.len {
  } else {
    return False();
  }
  let pseudo = styles^.pseudos.inner[at];
  let element = cvt::<u32, u64>(pseudo.element);
  if element < traversal^.elements.inner.len {
  } else {
    return False();
  }
  let node = traversal^.elements.inner[element];
  let index = cvt.wrap::<u64, u32>(at);
  let style = pseudo_ref(element: node.index, pseudo: index);
  let total = attributes^.len;
  let kept = True();
  for (i in 0_u64..total) {
    let attribute = attributes^[i];
    if attribute.node.index == node.index {
      let reads_name = content_reads_attribute(styles: styles, style: style, name: attribute.name);
      let unchanged = bnot(reads_name);
      set kept = band(kept, unchanged);
    }
  }
  return kept;
}

fn retained_attributes(old: &Styles, new: &Styles, traversal: &Traversal, attributes: &[AttributeChange]) -> retained: Bool reads(old), reads(new), reads(traversal), reads(attributes) {
  doc "Validates changed-attribute facts and refuses any generated-content consumer of the changed attribute before marks are written. Other elements' attr(class) and the target's attr(title) remain independent of a class edit.";
  let count = attributes^.len;
  let kept = True();
  for (i in 0_u64..count) {
    let valid = supported_attribute(traversal: traversal, attribute: attributes^[i]);
    set kept = band(kept, valid);
  }
  if count == 0_u64 {
    return kept;
  }
  let old_count = old^.pseudos.inner.len;
  for (i in 0_u64..old_count) {
    let valid = retained_pseudo_attributes(styles: old, traversal: traversal, attributes: attributes, at: i);
    set kept = band(kept, valid);
  }
  let new_count = new^.pseudos.inner.len;
  for (i in 0_u64..new_count) {
    let valid = retained_pseudo_attributes(styles: new, traversal: traversal, attributes: attributes, at: i);
    set kept = band(kept, valid);
  }
  return kept;
}

fn styles_changed(layout: &Layout, old: &Styles, new: &Styles, traversal: &Traversal, changed: &[Bool], attributes: &[AttributeChange]) -> result: Result<unit, LayoutError> reads(old), reads(new), reads(traversal), reads(changed), reads(attributes), writes(layout) {
  doc "Validates retained construction inputs before writing any mark, then marks the actual layout consumers of a nonempty style delta, which is indexed by NodeId like old's and new's order maps.";
  let length = changed^.len;
  if length != old^.order.inner.len {
    return inconsistent::<unit>();
  }
  if length != new^.order.inner.len {
    return inconsistent::<unit>();
  }
  let same_attributes = retained_attributes(old: old, new: new, traversal: traversal, attributes: attributes);
  if same_attributes {
  } else {
    return inconsistent::<unit>();
  }
  let retained = retained_styles(old: old, new: new, traversal: traversal);
  if retained {
  } else {
    return inconsistent::<unit>();
  }
  let any = False();
  for (i in 0_u64..length) {
    set any = bor(any, changed^[i]);
  }
  if any {
    let root = if 0_u64 < traversal^.elements.inner.len {
      give traversal^.elements.inner[0_u64].index;
    } else {
      give no_index;
    }
    mark_style_context(context: &layout^.root, changed: changed, runs: changed, root: root);
    set layout^.dirty = bor(layout^.dirty, layout^.root.dirty);
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn block_depth(context: &Context, block: u32) -> depth: u64 reads(context) {
  doc "The number of blocks on the parent chain, including block; payload slot numbers carry no ancestry information.";
  let parent = block;
  let depth = 0_u64;
  let count = context^.blocks.inner.len;
  for (step in 0_u64..count) {
    let at = cvt::<u32, u64>(parent);
    if at < context^.blocks.inner.len {
      set depth = depth +sat 1_u64;
      set parent = context^.blocks.inner[at].parent;
    } else {
      break;
    }
  }
  return depth;
}

fn common_restyled_block(context: &Context, first: u32, second: u32) -> block: u32 reads(context) {
  doc "The nearest block containing both changed blocks, or no_index when only the context contains both. Aligns parent-chain depths, then ascends both chains together, independently of payload slot order.";
  let left = first;
  let right = second;
  let left_depth = block_depth(context: context, block: first);
  let right_depth = block_depth(context: context, block: second);
  let count = context^.blocks.inner.len;
  for (step in 0_u64..count) {
    if left == right {
      return left;
    }
    if left == no_index {
      return no_index;
    }
    if right == no_index {
      return no_index;
    }
    let ascend_left = left_depth >= right_depth;
    let ascend_right = right_depth >= left_depth;
    if ascend_left {
      let at = cvt::<u32, u64>(left);
      if at < context^.blocks.inner.len {
        set left = context^.blocks.inner[at].parent;
        set left_depth = left_depth -sat 1_u64;
      } else {
        return no_index;
      }
    }
    if ascend_right {
      let at = cvt::<u32, u64>(right);
      if at < context^.blocks.inner.len {
        set right = context^.blocks.inner[at].parent;
        set right_depth = right_depth -sat 1_u64;
      } else {
        return no_index;
      }
    }
  }
  return no_index;
}

const changed_position: u32 = 2147483647_u32;

fn reads_element(style: StyleRef, element: u32, root: u32) -> supplies: Bool pure {
  doc "Whether style is the style of the element whose NodeId index is element, or of an anonymous box or pseudo-element that inherits it; root is the root element's NodeId index, which root_element names.";
  let supplier = if style.element == root_element {
    give root;
  } else {
    give style.element;
  }
  let supplies = supplier == element;
  return supplies;
}

fn paragraph_reads(paragraph: &Paragraph, element: u32, root: u32, strut: Bool) -> holds: Bool reads(paragraph) {
  doc "Whether the paragraph reads the element's style: through its strut, when strut holds, or through one of its pieces.";
  if strut {
    let own = reads_element(style: paragraph^.style, element: element, root: root);
    if own {
      return True();
    }
  }
  let count = paragraph^.pieces.inner.len;
  for (i in 0_u64..count) {
    if i < paragraph^.pieces.inner.len {
      let style = piece_style(piece: paragraph^.pieces.inner[i]);
      let held = reads_element(style: style, element: element, root: root);
      if held {
        return True();
      }
    }
  }
  return False();
}

fn mark_use(context: &Context, steps: &[ContextStep], depth: u64, restyle_target: Bool, block: u32, restyle_parent: Bool, paragraph: u32, element: u32, root: u32, strut: Bool) -> result: Result<unit, LayoutError> reads(steps), writes(context) {
  doc "Descends from context by the child indices in steps from depth on, as mark_path does, and marks the context they lead to: restyled when restyle_target holds, the nearest block containing its changed blocks unless block is no_index (restyled_block, with restyled_blocks saturated at two), and its explicit paragraph as dirty, counting it only when newly marked. An exact paragraph route already proves a strut or piece read; only a boxes-only change, for which strut is False, checks paragraph_reads to exclude a strut-only consumer. An already dirty paragraph needs neither membership check nor another count; the context above it is marked restyled when restyle_parent holds and it is not a flow context, since a flex, grid or table container places its child by the child's style in its own algorithm, while a flow context's update settles a marked child at its flow entry, reading the style there (restack_block, restack_entry, update_in_place). Every context on the way is marked dirty.";
  let count = steps^.len;
  if depth >= count {
    if restyle_target {
      set context^.restyled = True();
    }
    if block != no_index {
      if context^.restyled_blocks == 0_u32 {
        set context^.restyled_block = block;
        set context^.restyled_blocks = 1_u32;
      } else if context^.restyled_block != block {
        if context^.restyled {
          set context^.restyled_block = no_index;
        } else {
          set context^.restyled_block = common_restyled_block(context: context, first: context^.restyled_block, second: block);
        }
        set context^.restyled_blocks = 2_u32;
      }
    }
    let p = cvt::<u32, u64>(paragraph);
    if paragraph != no_index {
      if p < context^.paragraphs.inner.len {
      } else {
        return inconsistent::<unit>();
      }
      let was = context^.paragraphs.inner[p].dirty;
      if was {
      } else {
        let reading = if strut {
          give True();
        } else {
          let piece_read = paragraph_reads(paragraph: &context^.paragraphs.inner[p], element: element, root: root, strut: strut);
          give piece_read;
        }
        if reading {
          set context^.marked_paragraphs = context^.marked_paragraphs +sat 1_u32;
          set context^.marked_paragraph = paragraph;
          set context^.paragraphs.inner[p].dirty = True();
          frontier_insert(context: context, at: p);
        }
      }
    }
    set context^.dirty = True();
    return Ok<unit, LayoutError>(value: unit);
  }
  let child = cvt::<u32, u64>(steps^[depth].child);
  if child < context^.children.inner.len {
  } else {
    return inconsistent::<unit>();
  }
  let route = steps^[depth];
  if context^.slot != route.parent {
    return inconsistent::<unit>();
  }
  if context^.children.inner[child].slot != route.slot {
    return inconsistent::<unit>();
  }
  let next = depth +sat 1_u64;
  let was = context^.children.inner[child].dirty;
  let marked = propagate mark_use(context: &context^.children.inner[child], steps: steps, depth: next, restyle_target: restyle_target, block: block, restyle_parent: restyle_parent, paragraph: paragraph, element: element, root: root, strut: strut);
  if was {
  } else {
    set context^.marked_children = context^.marked_children +sat 1_u32;
    set context^.marked_child = steps^[depth].child;
  }
  let at_parent = next >= count;
  let restyles_here = band(at_parent, restyle_parent);
  let places_by_style = context^.kind != ctx_flow;
  let restyles_container = band(restyles_here, places_by_style);
  if restyles_container {
    set context^.restyled = True();
  }
  set context^.dirty = True();
  return Ok<unit, LayoutError>(value: unit);
}

fn styles_restyled(layout: &Layout, traversal: &Traversal, changed: &[u32]) -> result: Result<unit, LayoutError> reads(traversal), reads(changed), writes(layout) {
  doc "Follows each changed element's explicit style routes across all its contexts. Paragraph routes mark only actual consumers, excluding strut-only reads for changed_boxes_only. Uses may share ancestors and paragraphs, so marking counts each newly dirty unit once.";
  let count = changed^.len;
  let elements = traversal^.elements.inner.len;
  let root = if 0_u64 < elements {
    give traversal^.elements.inner[0_u64].index;
  } else {
    give no_index;
  }
  let total = layout^.routes.len;
  for (k in 0_u64..count) {
    let held = changed^[k];
    let bare = iand(held, changed_position);
    let at = cvt::<u32, u64>(bare);
    if at < elements {
    } else {
      return inconsistent::<unit>();
    }
    let node = traversal^.elements.inner[at];
    let index = cvt::<u32, u64>(node.index);
    if index < layout^.uses.len {
      let route_value_1 = route_read::<StyleUse>(table: &layout^.uses, at: index);
      let cursor = route_value_1.head;
      for (step in 0_u64..total) {
        if cursor == no_index {
          break;
        }
        let route_at = cvt::<u32, u64>(cursor);
        if route_at < layout^.routes.len {
        } else {
          return inconsistent::<unit>();
        }
        let route_value_2 = route_read::<StyleRoute>(table: &layout^.routes, at: route_at);
        let found = route_value_2;
        let steps = propagate path_steps(layout: layout, serial: found.serial);
        let depth = steps.inner.len;
        let flag = iand(held, changed_boxes_only);
        let strut = flag == 0_u32;
        let marked = propagate mark_use(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, restyle_target: found.structural, block: found.block, restyle_parent: found.owner, paragraph: found.paragraph, element: node.index, root: root, strut: strut);
        set layout^.dirty = True();
        set cursor = found.next;
      }
      if cursor != no_index {
        return inconsistent::<unit>();
      }
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}
