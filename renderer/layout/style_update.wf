              set style_block_lookup_block_offset = style_block_lookup_block_offset -sat style_block_lookup_half;
            }
            set style_block_lookup_block_span = style_block_lookup_half;
          }
          Page(values: style_block_lookup_block_values) => {
            let style_block_lookup_block_at = cvt::<u32, u64>(style_block_lookup_block_offset);
            if style_block_lookup_block_at < style_block_lookup_block_values^.inner.len {
