    let bare = iand(held, changed_position);
    let at = cvt::<u32, u64>(bare);
    if at < elements {
    } else {
      return inconsistent::<unit>();
    }
    let node = traversal^.elements.inner[at];
    let index = cvt::<u32, u64>(node.index);
    if index < layout^.uses.inner.len {
      let cursor = layout^.uses.inner[index].head;
      for (step in 0_u64..total) {
        if cursor == no_index {
          break;
        }
        let route_at = cvt::<u32, u64>(cursor);
        if route_at < layout^.routes.inner.len {
        } else {
          return inconsistent::<unit>();
        }
        let found = layout^.routes.inner[route_at];
        let steps = propagate path_steps(layout: layout, serial: found.serial);
        let depth = steps.inner.len;
        let flag = iand(held, changed_boxes_only);
        let strut = flag == 0_u32;
        let marked = propagate mark_use(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, restyle_target: found.structural, block: found.block, restyle_parent: found.owner, paragraph: found.paragraph, element: node.index, root: root, strut: strut);
        set layout^.dirty = True();
        set cursor = found.next;
      }
      if cursor != no_index {
        return inconsistent::<unit>();
      }
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}
