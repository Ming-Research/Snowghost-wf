    let style_block_lookup_span = style_block_lookup_sequence^.span;
    let style_block_lookup_offset = style_block_lookup_handle.slot;
    loop {
      match style_block_lookup_pages^ {
        Fork(left: style_block_lookup_target_left, right: style_block_lookup_target_right) => {
          let style_block_lookup_target_half = style_block_lookup_span / 2_u32;
