fn reads_element(style: StyleRef, element: u32, root: u32) -> supplies: Bool pure {
  doc "Whether style is the style of the element whose NodeId index is element, or of an anonymous box or pseudo-element that inherits it; root is the root element's NodeId index, which root_element names.";
  let supplier = if style.element == root_element {
    give root;
  } else {
    give style.element;
  }
  let supplies = supplier == element;
  return supplies;
}

fn paragraph_reads(paragraph: &Paragraph, element: u32, root: u32, strut: Bool) -> holds: Bool reads(paragraph) {
  doc "Whether the paragraph reads the element's style: through its strut, when strut holds, or through one of its pieces.";
  if strut {
    let own = reads_element(style: paragraph^.style, element: element, root: root);
    if own {
      return True();
    }
  }
  let count = paragraph^.pieces.inner.len;
  for (i in 0_u64..count) {
    if i < paragraph^.pieces.inner.len {
      let style = piece_style(piece: paragraph^.pieces.inner[i]);
      let held = reads_element(style: style, element: element, root: root);
      if held {
        return True();
      }
    }
  }
  return False();
}

