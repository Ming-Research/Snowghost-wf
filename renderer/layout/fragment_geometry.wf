fn fragment_endpoint(context: &Context, origins: &[Origin], item: Flow) -> (normal: i32, top: i32, bottom: i32) reads(context.blocks.inner), reads(context.paragraphs.inner), reads(context.children.inner), reads(context.local_geometry), reads(context.reference_phase), reads(context.range_actions), reads(context.entries.nodes), reads(context.entries.span), reads(context.content_dy), reads(origins), reads(context.entries.range_actions) {
  doc "Resolves a stable split head from a placement snapshot, preserving the reference visual-top then height saturation order. Reference scratch already contains the resolved i32 coordinates, so that branch reads them directly without an owned-origin round trip. The context content adjustment is applied once before the extent.";
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        if context^.local_geometry {
        } else {
          let resolved = block_origin(context: context, block: b);
          let raw_normal = origin_normal(value: resolved);
          let raw_visual = origin_visual(value: resolved);
          let normal_reference = raw_normal.y +sat context^.content_dy;
          let top_reference = raw_visual.y +sat context^.content_dy;
          let bottom_reference = top_reference +sat context^.blocks.inner[at].height;
          return normal_reference, top_reference, bottom_reference;
        }
        let origin = owner_origin(origins: origins, owner: b);
        let normal_place = origin_normal(value: origin);
        let visual_place = origin_visual(value: origin);
        let normal_y = normal_place.y +sat context^.content_dy;
        let top_y = visual_place.y +sat context^.content_dy;
        let bottom_y = top_y +sat context^.blocks.inner[at].height;
        return normal_y, top_y, bottom_y;
      }
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        let child = &context^.children.inner[at];
        if context^.local_geometry {
        } else {
          let resolved = child_origin(context: context, at: at);
          let raw_normal = origin_normal(value: resolved);
          let raw_visual = origin_visual(value: resolved);
          let normal_reference = raw_normal.y +sat context^.content_dy;
          let top_reference = raw_visual.y +sat context^.content_dy;
          let bottom_reference = top_reference +sat child^.height;
          return normal_reference, top_reference, bottom_reference;
        }
        let parent = owner_origin(origins: origins, owner: child^.block);
        let anchor = child_local(context: context, at: at);
        let origin = origin_accumulate(owner: parent, local: anchor);
        let normal_place = origin_normal(value: origin);
        let visual_place = origin_visual(value: origin);
        let normal_y = normal_place.y +sat context^.content_dy;
        let top_y = visual_place.y +sat context^.content_dy;
        let bottom_y = top_y +sat child^.height;
        return normal_y, top_y, bottom_y;
      }
    }
    Close(..) => {
    }
    Text(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  return 0_i32, 0_i32, 0_i32;
}

fn anchored_fragment_value(context: &Context, origins: &[Origin], raw: Fragment, anchor: FragmentAnchor) -> made: Fragment reads(context.local_geometry), reads(context.reference_phase), reads(context.range_actions), reads(context.content_dx), reads(context.content_dy), reads(context.entries.nodes), reads(context.entries.span), reads(context.blocks.inner), reads(context.paragraphs.inner), reads(context.children.inner), reads(context.splits.inner), reads(origins), reads(context.entries.range_actions) {
  doc "Evaluates one retained role from value arguments and immutable endpoint inputs, so its caller need not read another repair's rectangle or anchor slot.";
  let fragment = raw;
  set fragment.x = fragment.x +sat context^.content_dx;
  set fragment.y = fragment.y +sat context^.content_dy;
  if anchor.mode == 0_u8 {
    return fragment;
  }
  let (normal, top, first_bottom) = fragment_endpoint(context: context, origins: origins, item: anchor.first);
  if anchor.mode == 1_u8 {
    set fragment.y = top;
  } else if anchor.mode == 2_u8 {
    let split = cvt::<u32, u64>(anchor.split);
    if split < context^.splits.inner.len {
      let wide = cvt::<i32, i64>(normal);
      let line = wide +sat context^.splits.inner[split].line_offset;
      let y = geometry_narrow(value: line);
      set fragment.y = y;
    }
  } else if anchor.mode == 3_u8 {
    let (last_normal, last_top, bottom) = fragment_endpoint(context: context, origins: origins, item: anchor.last);
    set fragment.y = top;
    set fragment.height = bottom -sat top;
  } else if anchor.mode == 4_u8 {
    let (last_normal, last_top, bottom) = fragment_endpoint(context: context, origins: origins, item: anchor.last);
    set fragment.y = bottom +sat anchor.margin;
  }
  return fragment;
}

fn anchored_context_fragment(context: &Context, origins: &[Origin], at: u64) -> made: Fragment reads(context), reads(origins) {
  doc "Loads one fragment and anchor for the shared value evaluator, preserving raw lineless scratch and the reference arithmetic order.";
  let empty = Fragment(kind: placed_element, owner: no_index, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32);
  if at < context^.fragments.inner.len {
  } else {
    return empty;
  }
  let raw = context^.fragments.inner[at];
  if at < context^.fragment_anchors.inner.len {
    let anchor = context^.fragment_anchors.inner[at];
    let resolved = anchored_fragment_value(context: context, origins: origins, raw: raw, anchor: anchor);
    return resolved;
  }
  let fragment = raw;
  set fragment.x = fragment.x +sat context^.content_dx;
  set fragment.y = fragment.y +sat context^.content_dy;
  return fragment;
}

fn fragment_representation_same(raw: Fragment, resolved: Fragment, dx: i32, dy: i32) -> same: Bool pure {
  doc "Compares all four representation fields after the same context translation as the full publisher. Both full publication and each targeted repair use this exact check.";
  let raw_x = raw.x +sat dx;
  let raw_y = raw.y +sat dy;
  let x_same = raw_x == resolved.x;
  let y_same = raw_y == resolved.y;
  let width_same = raw.width == resolved.width;
  let height_same = raw.height == resolved.height;
  let place_same = band(x_same, y_same);
  let size_same = band(width_same, height_same);
  return band(place_same, size_same);
}

fn placed_fragment_value(context: &Context, origins: &[Origin], raw: Fragment, anchor: FragmentAnchor) -> made: Fragment reads(context.blocks.inner), reads(context.children.inner), reads(context.splits.inner), reads(context.local_geometry), reads(context.reference_phase), reads(context.content_dx), reads(context.content_dy), reads(context.fragments_valid), reads(context.fragments_anchored), reads(origins), reads(context.range_actions), reads(context.entries.nodes), reads(context.entries.span), reads(context.paragraphs.inner), reads(context.entries.range_actions) {
  doc "Uses the shared anchor authority contract for both sparse split roles and legacy own/table rectangles.";
  let use_anchor = band(context^.local_geometry, context^.fragments_valid);
  if context^.fragments_anchored {
    set use_anchor = context^.fragments_valid;
  }
  if use_anchor {
    let resolved = anchored_fragment_value(context: context, origins: origins, raw: raw, anchor: anchor);
    return resolved;
  }
  let fragment = raw;
  set fragment.x = fragment.x +sat context^.content_dx;
  set fragment.y = fragment.y +sat context^.content_dy;
  return fragment;
}

fn placed_context_fragment(context: &Context, origins: &[Origin], at: u64) -> made: Fragment reads(context), reads(origins) {
  doc "Loads a legacy own/table cell through the same authority evaluator as split roles.";
  let empty = Fragment(kind: placed_element, owner: no_index, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32);
  if at < context^.fragments.inner.len {
    let raw = context^.fragments.inner[at];
    if at < context^.fragment_anchors.inner.len {
      let anchor = context^.fragment_anchors.inner[at];
      let resolved = placed_fragment_value(context: context, origins: origins, raw: raw, anchor: anchor);
      return resolved;
    }
    let fragment = raw;
    set fragment.x = fragment.x +sat context^.content_dx;
    set fragment.y = fragment.y +sat context^.content_dy;
    return fragment;
  }
  return empty;
}

fn fragment_role_certificate(context: &Context, origins: &[Origin], raw: Fragment, anchor: FragmentAnchor) -> valid: Bool reads(context.blocks.inner), reads(context.children.inner), reads(context.splits.inner), reads(context.local_geometry), reads(context.reference_phase), reads(context.content_dx), reads(context.content_dy), reads(origins), reads(context.range_actions), reads(context.entries.nodes), reads(context.entries.span), reads(context.paragraphs.inner), reads(context.entries.range_actions) {
  doc "Checks an active role's exact reference fields; reserved inactive cells impose no geometric claim.";
  if anchor.active {
    let resolved = anchored_fragment_value(context: context, origins: origins, raw: raw, anchor: anchor);
    let same = fragment_representation_same(raw: raw, resolved: resolved, dx: context^.content_dx, dy: context^.content_dy);
    return same;
  }
  return True();
}

fn fragment_roles_certificates(context: &Context, origins: &[Origin], roles: &[FragmentRoles]) -> valid: Bool reads(context.blocks.inner), reads(context.children.inner), reads(context.splits.inner), reads(context.local_geometry), reads(context.reference_phase), reads(context.content_dx), reads(context.content_dy), reads(origins), reads(roles), reads(context.range_actions), reads(context.entries.nodes), reads(context.entries.span), reads(context.paragraphs.inner), reads(context.entries.range_actions) {
  doc "Certifies prepared role records through independent leaf comparisons and a balanced validity join.";
  let count = roles^.len;
  if count == 0_u64 {
    return True();
  }
  if count == 1_u64 {
    let record = roles^[0_u64];
    let leading = fragment_role_certificate(context: context, origins: origins, raw: record.leading, anchor: record.leading_anchor);
    let spanning = fragment_role_certificate(context: context, origins: origins, raw: record.spanning, anchor: record.spanning_anchor);
    let trailing = fragment_role_certificate(context: context, origins: origins, raw: record.trailing, anchor: record.trailing_anchor);
    let ends = band(leading, trailing);
    return band(ends, spanning);
  }
  let half = count / 2_u64;
  if half <= count {
    let left = fragment_roles_certificates(context: context, origins: origins, roles: &roles^[0_u64..half]);
    let right = fragment_roles_certificates(context: context, origins: origins, roles: &roles^[half..count]);
    return band(left, right);
  }
  return False();
}

fn reference_split_roles(context: &Context, origins: &[Origin], roles: FragmentRoles) -> made: FragmentRoles reads(context.blocks.inner), reads(context.children.inner), reads(context.splits.inner), reads(context.local_geometry), reads(context.reference_phase), reads(context.content_dx), reads(context.content_dy), reads(context.fragments_valid), reads(context.fragments_anchored), reads(origins), reads(context.range_actions), reads(context.entries.nodes), reads(context.entries.span), reads(context.paragraphs.inner), reads(context.entries.range_actions) {
  doc "Materializes one sparse record only at a full legacy-reader boundary, leaving inactive capacity unobserved.";
  let made = roles;
  if roles.leading_anchor.active {
    let leading = placed_fragment_value(context: context, origins: origins, raw: roles.leading, anchor: roles.leading_anchor);
    set made.leading = leading;
  }
  if roles.spanning_anchor.active {
    let spanning = placed_fragment_value(context: context, origins: origins, raw: roles.spanning, anchor: roles.spanning_anchor);
    set made.spanning = spanning;
  }
  if roles.trailing_anchor.active {
    let trailing = placed_fragment_value(context: context, origins: origins, raw: roles.trailing, anchor: roles.trailing_anchor);
    set made.trailing = trailing;
  }
  return made;
}

fn translate_raw_split_roles(roles: &FragmentRoles, dx: i32, dy: i32) -> result: unit writes(roles) {
  doc "Materializes a context content adjustment in raw sparse cells at a full reconstruction boundary; local owner movement never calls this loop.";
  if roles^.leading_anchor.active {
    set roles^.leading.x = roles^.leading.x +sat dx;
    set roles^.leading.y = roles^.leading.y +sat dy;
  }
  if roles^.spanning_anchor.active {
    set roles^.spanning.x = roles^.spanning.x +sat dx;
    set roles^.spanning.y = roles^.spanning.y +sat dy;
  }
  if roles^.trailing_anchor.active {
    set roles^.trailing.x = roles^.trailing.x +sat dx;
    set roles^.trailing.y = roles^.trailing.y +sat dy;
  }
  return unit;
}

fn translate_empty_fragment_sources(paragraphs: &[Paragraph], dx: i32, dy: i32) -> result: unit writes(paragraphs) {
  doc "Materializes a full context's content adjustment for active lineless scratch records; inactive or absent source storage remains untouched.";
  let count = paragraphs^.len;
  for (at in 0_u64..count) {
    if paragraphs^[at].empty_fragment {
      let cells = paragraphs^[at].empty_fragments.inner.len;
      for (slot in 0_u64..cells) {
        if slot < paragraphs^[at].empty_fragments.inner.len {
          if paragraphs^[at].empty_fragments.inner[slot].active {
            set paragraphs^[at].empty_fragments.inner[slot].value.x = paragraphs^[at].empty_fragments.inner[slot].value.x +sat dx;
            set paragraphs^[at].empty_fragments.inner[slot].value.y = paragraphs^[at].empty_fragments.inner[slot].value.y +sat dy;
          }
        }
      }
    }
  }
  return unit;
}

fn own_split_line(context: &Context, origins: &[Origin], split: &Split) -> result: unit reads(context.blocks.inner), reads(context.children.inner), reads(context.local_geometry), reads(context.reference_phase), reads(context.content_dy), reads(origins), reads(context.range_actions), reads(context.entries.nodes), reads(context.entries.span), reads(context.paragraphs.inner), reads(context.entries.range_actions), writes(split) {
  doc "Publishes one split's exact line offset from its settled endpoint. Endpoint reads exclude every split, so independent split writes need no temporary offset array.";
  if split^.line_dirty {
  } else {
    return unit;
  }
  let opening = split^.opening;
  let (normal, top, bottom) = fragment_endpoint(context: context, origins: origins, item: opening);
  let wide_line = cvt::<i32, i64>(split^.line);
  let wide_normal = cvt::<i32, i64>(normal);
  set split^.line_offset = wide_line -sat wide_normal;
  set split^.line_dirty = False();
  return unit;
}

fn fragment_certificates(context: &Context, origins: &[Origin], first: u64, end: u64) -> valid: Bool reads(context), reads(origins) {
  doc "Evaluates every raw-versus-anchor representation check through a balanced read-only reduction after split offsets settle, without allocating a check array. The comparison and its failure result are identical to full reference publication.";
  let count = end -sat first;
  if count == 0_u64 {
    return True();
  }
  if count == 1_u64 {
    if first < context^.fragments.inner.len {
      let raw = context^.fragments.inner[first];
      let resolved = anchored_context_fragment(context: context, origins: origins, at: first);
      let same = fragment_representation_same(raw: raw, resolved: resolved, dx: context^.content_dx, dy: context^.content_dy);
      return same;
    }
    return False();
  }
  let half = count / 2_u64;
  let middle = first +sat half;
  let left = fragment_certificates(context: context, origins: origins, first: first, end: middle);
  let right = fragment_certificates(context: context, origins: origins, first: middle, end: end);
  return band(left, right);
}

fn own_fragment_geometry(context: &Context, origins: &[Origin]) -> result: unit reads(origins), writes(context) {
  doc "Republishes Split.line offsets after every legacy reference path, then certifies each cached anchor against the actual raw rectangle. A failed representation check leaves raw output authoritative and blocks local structural reuse.";
  if context^.fragment_repaired {
    return unit;
  }
  let count = context^.splits.inner.len;
  for (at in 0_u64..count) {
    own_split_line(context: context, origins: origins, split: &context^.splits.inner[at]);
  }
  let fragments = context^.fragments.inner.len;
  let matches = fragment_certificates(context: context, origins: origins, first: 0_u64, end: fragments);
  let aligned = context^.fragment_anchors.inner.len == fragments;
  let role_count = context^.split_roles.inner.len;
  let roles_match = fragment_roles_certificates(context: context, origins: origins, roles: &context^.split_roles.inner[0_u64..role_count]);
  let legacy_valid = band(matches, aligned);
  let valid = band(legacy_valid, roles_match);
  set context^.fragments_valid = valid;
  build_fragment_ranges(context: context);
  return unit;
}

fn reference_fragment_geometry(context: &Context, origins: &[Origin]) -> result: unit reads(origins), writes(context) {
  doc "Materializes split anchors and restores current weighted ranks before the compatibility walker reads them. Reads and publication use separate arrays; this whole-context bridge is outside accepted local splice work.";
  let count = context^.fragments.inner.len;
  let empty = Fragment(kind: placed_element, owner: no_index, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32);
  let values = box_array_filled::<Fragment>(count: count, value: empty);
  let owned = owns_fragment(style: context^.style);
  let first = if owned {
    give imin(count, 1_u64);
  } else {
    give 0_u64;
  }
  for (at in first..count) {
    let value = placed_context_fragment(context: context, origins: origins, at: at);
    set values.inner[at] = value;
  }
  let role_count = context^.split_roles.inner.len;
  let empty_roles = empty_fragment_roles();
  let role_values = box_array_filled::<FragmentRoles>(count: role_count, value: empty_roles);
  for (at in 0_u64..role_count) {
    let value = reference_split_roles(context: context, origins: origins, roles: context^.split_roles.inner[at]);
    set role_values.inner[at] = value;
  }
  let splits = context^.splits.inner.len;
  let absent = Flow::Close(block: no_index);
  let clean_line = False();
  let empty_split = Split(owner: no_index, opening: absent, line_offset: 0_i64, line_dirty: clean_line, open: no_index, close: no_index, left: 0_i32, width: 0_i32, line: no_line);
  let restored = box_array_filled::<Split>(count: splits, value: empty_split);
  for (at in 0_u64..splits) {
    if at < context^.splits.inner.len {
      let split = context^.splits.inner[at];
      let (opening, closing) = fragment_event_rank(context: context, item: split.opening);
      set split.open = opening;
      set split.close = closing;
      if split.line != no_line {
        let (normal, top, bottom) = fragment_endpoint(context: context, origins: origins, item: split.opening);
        let wide = cvt::<i32, i64>(normal);
        let line = wide +sat split.line_offset;
        let resolved_line = geometry_narrow(value: line);
        set split.line = resolved_line;
      }
      set restored.inner[at] = split;
    }
  }
  for (at in first..count) {
    if at < context^.fragments.inner.len {
      set context^.fragments.inner[at] = values.inner[at];
    }
  }
  for (at in 0_u64..splits) {
    if at < context^.splits.inner.len {
      set context^.splits.inner[at] = restored.inner[at];
    }
  }
  for (at in 0_u64..role_count) {
    if at < context^.split_roles.inner.len {
      set context^.split_roles.inner[at] = role_values.inner[at];
    }
  }
  let paragraphs = context^.paragraphs.inner.len;
  translate_empty_fragment_sources(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs], dx: context^.content_dx, dy: context^.content_dy);
  set context^.fragments_anchored = False();
  return unit;
}

fn translate_extra_fragments(context: &Context, top: i32, bottom: i32, delta: i32) -> result: unit writes(context.split_roles), writes(context.paragraphs) {
  doc "Preserves the legacy raw-fragment translation operation for explicit compatibility fallback, across sparse roles and paragraph-local empty sources.";
  let count = context^.split_roles.inner.len;
  for (at in 0_u64..count) {
    if context^.split_roles.inner[at].leading_anchor.active {
      translate_fragment(fragment: &context^.split_roles.inner[at].leading, top: top, bottom: bottom, delta: delta);
    }
    if context^.split_roles.inner[at].spanning_anchor.active {
      translate_fragment(fragment: &context^.split_roles.inner[at].spanning, top: top, bottom: bottom, delta: delta);
    }
    if context^.split_roles.inner[at].trailing_anchor.active {
      translate_fragment(fragment: &context^.split_roles.inner[at].trailing, top: top, bottom: bottom, delta: delta);
    }
  }
  let paragraphs = context^.paragraphs.inner.len;
  for (p in 0_u64..paragraphs) {
    if context^.paragraphs.inner[p].empty_fragment {
      let cells = context^.paragraphs.inner[p].empty_fragments.inner.len;
      for (slot in 0_u64..cells) {
        if slot < context^.paragraphs.inner[p].empty_fragments.inner.len {
          if context^.paragraphs.inner[p].empty_fragments.inner[slot].active {
            translate_fragment(fragment: &context^.paragraphs.inner[p].empty_fragments.inner[slot].value, top: top, bottom: bottom, delta: delta);
          }
        }
      }
    }
  }
  return unit;
}
