fn update_flow(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, before: Before) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Publishes the settled first baseline after every full, scoped, boundary and stationary flow update, before its parent compares outputs.";
  let counts = update_flow_inner(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: before);
  let first_visits = publish_flow_first_baseline(context: context);
  set counts.work = add_boundary_visits(first: counts.work, second: first_visits);
  return counts;
}

fn update_flow_inner(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, before: Before) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Attempts bounded boundary propagation before touching the reference coordinate bridge. A prior ordinary edit invalidates legacy natural-position scratch, so a later refusal forces full stacking before republishing boundary outputs.";
  let extra_rank = 18446744073709551615_u64;
