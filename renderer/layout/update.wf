}

fn restack_entry(context: &Context) -> (from: u64, paragraph: u64, inline_child: u64) reads(context) {
  doc "The flow entry a re-stack starts from for the context's one mark (restack_flow), the paragraph it breaks again and the atomic inline it waits for (the largest u64 for none): a marked paragraph's own entry; for one marked child and no marked paragraph, an in-flow child's or a float's entry (stack_flow settles it there), or, for an atomic inline, the entry of the paragraph holding it, which update_in_place must have updated first; the largest u64 for anything else (several marks, an out-of-flow child). It reads the marks text_changed recorded, not the children's own, which update_in_place may already have cleared.";
  let none = 18446744073709551615_u64;
  let no_child = context^.marked_children == 0_u32;
  let (one_paragraph, p) = single_marked_paragraph(context: context);
  let paragraph_only = band(no_child, one_paragraph);
  if paragraph_only {
    if p < context^.paragraphs.inner.len {
      let at = cvt::<u32, u64>(context^.paragraphs.inner[p].flow_at);
      return at, p, none;
    }
    return none, none, none;
  }
  let no_paragraph = context^.marked_paragraphs == 0_u32;
  let one_child = context^.marked_children == 1_u32;
  let child_only = band(no_paragraph, one_child);
  if child_only {
  } else {
    return none, none, none;
  }
  let c = cvt::<u32, u64>(context^.marked_child);
  if c < context^.children.inner.len {
  } else {
    return none, none, none;
  }
  let flow_at = context^.children.inner[c].flow_at;
  let event_rank = cvt::<u32, u64>(flow_at);
  let event_count = flow_length(context: context);
  let event_value = Flow::Close(block: no_index);
  if event_rank < event_count {
    let selected_event = flow_event(context: context, at: event_rank);
    set event_value = selected_event;
  }
  let (kind, index) = entry_kind(item: event_value);
  let at = cvt::<u32, u64>(flow_at);
  if kind == 1_u8 {
    return at, none, none;
  }
  if kind == 2_u8 {
    return at, none, none;
  }
  if kind == 0_u8 {
    return at, index, c;
  }
  return none, none, none;
}
