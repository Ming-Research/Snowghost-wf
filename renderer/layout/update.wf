    }
  }
  let visits = no_boundary_visits();
  set context^.boundary_visits = visits;
  let (child_stationary, child_counts, child_before) = stationary_child(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: before);
  if child_stationary {
    let child_work = add_boundary_visits(first: child_counts.work, second: context^.boundary_visits);
    set child_counts.work = child_work;
    return child_counts;
  }
  let (stationary, paragraph_before) = stationary_paragraph(context: context, styles: styles, fonts: fonts, picks: picks, before: before);
  if stationary {
    let stationary_counts = no_updates();
