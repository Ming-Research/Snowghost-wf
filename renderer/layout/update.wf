  let attempted_counts = add_counts(first: local, second: child_counts);
  let combined = add_counts(first: attempted_counts, second: updated);
  let work = add_boundary_visits(first: combined.work, second: context^.boundary_visits);
  set combined.work = work;
  return combined;
}

fn update_flow_reference(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, before: Before, paragraph_before: ParagraphBefore, child_before: ChildBefore, scope: &ReferenceScope) -> counts: UpdateCounts reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context), writes(scope) {
  doc "Brings the marked flow context up to date, before holding its space and outputs from its previous layout, with lay_out_flow's passes: its width; then, when its geometry and space are those of its previous layout and no marked child is positioned, update_in_place updates it without the pre-pass or the stacking pass where it can. Otherwise the pre-pass runs again, each marked child is updated, each unmarked child whose space came out unchanged is kept (its margins resolved again) and every other one laid out again, each paragraph is broken again when it is marked, its flow width changed, it follows a float and holds lines the stacking pass narrowed or moved beside one (full_width_lines), or it holds an atomic inline whose outputs changed, and finish_flow stacks the flow and writes the fragments again. Each loop over the children or the paragraphs is a counted loop whose iteration writes only its own element and its own entry of a local array.";
  let probed_child = pending_child_probe(context: context, previous: child_before);
  if probed_child {
  } else {
    reset_marked_children(context: context);
  }
  let was_known = context^.intrinsic_known;
  let width = used_width(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set context^.width = width;
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: width);
  let previous = flow_frame(styles: styles, style: context^.style, space: before.space, width: before.width);
  let same_flow = frame.flow_width == previous.flow_width;
  let same_definite = frame.definite == previous.definite;
  let same_height = bor(same_definite, context^.definite_free);
  let same_frame = band(same_flow, same_height);
  let now_space = context^.space;
  let then_space = before.space;
  let same_room = now_space.available == then_space.available;
  let same_basis = now_space.basis_width == then_space.basis_width;
  let same_forced = now_space.forced_width == then_space.forced_width;
  let same_shrink = eeq(now_space.shrink, then_space.shrink);
  let same_across = band(same_room, same_basis);
  let same_kind = band(same_forced, same_shrink);
  let same_place = band(same_across, same_kind);
  let same_width = width == before.width;
  let was_unknown = bnot(was_known);
  let newly_known = band(was_unknown, context^.intrinsic_known);
  let own_marked_known = band(context^.dirty, context^.intrinsic_known);
  let own_asked = bor(newly_known, own_marked_known);
  let children_asked = False();
  let out_marked = False();
  if probed_child {
  } else {
    let (child_intrinsic, child_positioned) = marked_children_state(context: context, styles: styles);
    set children_asked = child_intrinsic;
    set out_marked = child_positioned;
  }
  let marked_paragraphs = context^.marked_paragraphs > 0_u32;
  let asked = bor(own_asked, children_asked);
  let kept_frame = band(same_frame, same_place);
  let kept_geometry = band(kept_frame, same_width);
  let unasked = bnot(asked);
  let in_flow = bnot(out_marked);
  let unchanged_style = bnot(context^.restyled);
  let steady_geometry = band(kept_geometry, in_flow);
  let steady_style = band(steady_geometry, unchanged_style);
  let no_blocks = context^.restyled_blocks == 0_u32;
  let one_block = context^.restyled_blocks > 0_u32;
  let steady = band(steady_style, no_blocks);
  let nothing = no_updates();
  let early = nothing;
  let block_steady = band(steady_style, one_block);
  if block_steady {
    let (handled, counts) = restack_block(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, frame: frame, unasked: unasked, scope: scope);
    if handled {
      clear_marks(context: context);
      set context^.dirty = False();
      set context^.restyled = False();
      set context^.restyled_blocks = 0_u32;
      return counts;
    }
  }
  if steady {
    let (from, p, inline_child) = restack_entry(context: context);
    let unscaled = bnot(frame.columned);
    let found = from != 18446744073709551615_u64;
    let restackable = band(found, unscaled);
    let old_top = if p < context^.paragraphs.inner.len {
      let geometry_read_3 = paragraph_position(context: context, at: p);
      give geometry_read_3.y;
    } else {
      give 0_i32;
    }
    let old_height = paragraph_height(context: context, at: p);
    let old_lines = if p < context^.paragraphs.inner.len {
      give context^.paragraphs.inner[p].lines.inner.len > 0_u64;
    } else {
      give False();
    }
    if p == paragraph_before.at {
      set old_height = paragraph_before.height;
      set old_lines = paragraph_before.lines > 0_u64;
    }
    let (handled, local) = update_in_place(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, frame: frame, measured: own_asked, previous: paragraph_before, child_before: child_before, scope: scope);
    if handled {
      clear_marks(context: context);
      set context^.dirty = False();
      set context^.restyled = False();
      set context^.restyled_blocks = 0_u32;
      return local;
    }
    set early = local;
    let waiting = if inline_child < context^.children.inner.len {
      give context^.children.inner[inline_child].dirty;
    } else {
      give False();
    }
    let ready = bnot(waiting);
    let restacking = band(restackable, ready);
    if restacking {
      let restacked = restack_flow(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, frame: frame, from: from, until: from, empty_stable: ready, at: p, old_top: old_top, old_height: old_height, old_lines: old_lines, unasked: unasked, scope: scope);
      clear_marks(context: context);
      set context^.dirty = False();
      set context^.restyled = False();
      set context^.restyled_blocks = 0_u32;
      let total = add_counts(first: restacked, second: early);
      return total;
    }
  }
  if events^.len == 0_u64 {
    let full_buffer = materialize_flow(context: context);
    let full_count = full_buffer.inner.len;
    let full_events = &full_buffer.inner[0_u64..full_count];
    let full_counts = update_flow_reference_full(context: context, events: full_events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, child_before: child_before, unasked: unasked, frame: frame, same_flow: same_flow, marked_paragraphs: marked_paragraphs, early: early);
    full_reference_publication(context: context, events: full_events, styles: styles, basis_height: frame.definite);
    set scope^.published = True();
    return full_counts;
  }
  return update_flow_reference_full(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, child_before: child_before, unasked: unasked, frame: frame, same_flow: same_flow, marked_paragraphs: marked_paragraphs, early: early);
}

fn update_flow_reference_full(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, child_before: ChildBefore, unasked: Bool, frame: FlowFrame, same_flow: Bool, marked_paragraphs: Bool, early: UpdateCounts) -> counts: UpdateCounts reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Runs the unchanged full reference preparation and layout after a bounded attempt refused, with one shared materialized event slice. Scope stays incomplete so full transfer publication and exact geometry encoding follow.";
  let nothing = no_updates();
  let children = context^.children.inner.len;
  let bounded = imin(children, item_ceiling);
  let unknown_before = fresh_before();
  let befores = box_array_filled::<Before>(count: bounded, value: unknown_before);
  for (k in 0_u64..bounded) {
    if k < context^.children.inner.len {
      if k == child_before.at {
        set befores.inner[k] = child_before.geometry;
      } else {
        set befores.inner[k] = before_of(context: &context^.children.inner[k]);
      }
    }
  }
  let results = box_array_filled::<UpdateCounts>(count: bounded, value: nothing);
  let unchanged = False();
  let changed = box_array_filled::<Bool>(count: bounded, value: unchanged);
  let (float_from, floats) = first_float_entry(context: context, events: events);
  let cleared = context^.fragments.inner.len;
  for (step in 0_u64..cleared) {
    let length = context^.fragments.inner.len;
    if length == 0_u64 {
      break;
    }
    let dropped = take_back(window: &context^.fragments.inner);
  }
  clear_fragment_anchors(context: context);
  clear_column_map(context: context);
  prepare_spaces(context: context, events: events, styles: styles, content_width: frame.flow_width, content_height: frame.definite);
  let present = context^.children.inner.len;
  let marked_parent = context^.dirty;
  let fits_results = present <= results.inner.len;
  let fits_befores = present <= befores.inner.len;
  let fits_pair = band(fits_results, fits_befores);
  if fits_pair {
    for (i in 0_u64..present) {
      settle_child(child: &context^.children.inner[i], result: &results.inner[i], before: befores.inner[i], unasked: unasked, marked_parent: marked_parent, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
    }
  }
  let compared = context^.children.inner.len;
  let compare_fits = compared <= changed.inner.len;
  let compare_befores = compared <= befores.inner.len;
  let comparable = band(compare_fits, compare_befores);
  if comparable {
    for (i in 0_u64..compared) {
      compare_child(child: &context^.children.inner[i], changed: &changed.inner[i], before: befores.inner[i]);
    }
  }
  let changed_any = any_set(flags: &changed);
  let none = box_slots_new::<Exclusion>(capacity: 0_u64);
  let moved = bnot(same_flow);
  let held_count = context^.children.inner.len;
  let breaking = context^.paragraphs.inner.len;
  let changed_len = changed.inner.len;
  let broken = 0_u64;
  for (i in 0_u64..breaking) {
    let marked = context^.paragraphs.inner[i].dirty;
    let beside = paragraph_after_entry(paragraph: &context^.paragraphs.inner[i], at_entry: float_from);
    let holds_changed = if changed_any {
      give reads_changed(paragraph: &context^.paragraphs.inner[i], changed: &changed.inner[0_u64..changed_len]);
    } else {
      give False();
    }
    let narrowed = if beside {
      let full = full_width_lines(paragraph: &context^.paragraphs.inner[i], styles: styles, fonts: fonts, picks: picks);
      give bnot(full);
    } else {
      give False();
    }
    let same_paragraph_width = context^.paragraphs.inner[i].width == context^.paragraphs.inner[i].broken_width;
    let same_left = context^.paragraphs.inner[i].left == context^.paragraphs.inner[i].broken_left;
    let same_input = band(same_paragraph_width, same_left);
    let input_changed = bnot(same_input);
    let geometry_changed = bor(moved, input_changed);
    let first = bor(marked, geometry_changed);
    let second = bor(narrowed, holds_changed);
    let again = bor(first, second);
    if again {
      break_paragraph(paragraph: &context^.paragraphs.inner[i], children: &context^.children.inner[0_u64..held_count], styles: styles, fonts: fonts, picks: picks, exclusions: &none.inner[0_u64..0_u64], origin_y: 0_i32);
      set broken = broken +wrap 1_u64;
    }
  }
  clear_marks(context: context);
  let finished = finish_flow(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, frame: frame);
  set context^.dirty = False();
  set context^.restyled = False();
  set context^.restyled_blocks = 0_u32;
  let summed = sum_counts(results: &results);
  let with_finished = add_counts(first: summed, second: finished);
  let below = add_counts(first: with_finished, second: early);
  let walked = flow_length(context: context);
  let held_here = if marked_paragraphs {
    give walked;
  } else {
    give 0_u64;
  }
  let total_contexts = below.contexts +sat 1_u64;
  let total_paragraphs = below.paragraphs +sat broken;
  let total_held = below.held_entries +sat held_here;
  let total_entries = below.entries +sat walked;
  return UpdateCounts(prepared: 0_u64, work: below.work, contexts: total_contexts, paragraphs: total_paragraphs, held_entries: total_held, entries: total_entries);
}

fn update(layout: &Layout, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(fonts), reads(picks), writes(layout) {
  doc "Returns at once when nothing is marked; otherwise prepares the marked paragraphs again (prepare_marked), lays the initial containing block out again in the viewport as lay_out does, through update_flow, records the counts and clears the layout's mark.";
  let pending = layout^.pending_structure;
  let cleared_pending = no_updates();
  set layout^.pending_structure = cleared_pending;
  if layout^.dirty {
  } else {
    set layout^.last_update = pending;
    let visits = no_boundary_visits();
    set layout^.root.boundary_visits = visits;
    return Ok<unit, LayoutError>(value: unit);
  }
  let prepared = count_marked(context: &layout^.root);
  let prepared_ok = prepare_marked(context: &layout^.root, document: document, styles: styles, fonts: fonts, picks: picks);
  let before = before_of(context: &layout^.root);
  let viewport = layout^.viewport;
  let width = units(px: viewport.width);
  let height = units(px: viewport.height);
  let no = False();
  set layout^.root.space = Space(available: width, basis_width: width, basis_height: height, forced_width: width, forced_height: height, shrink: no);
  let root_proof = viewport_height_proof(styles: styles, style: layout^.root.style, width: width, height: height);
  let ordinary_mode = ordinary_height_mode(document: document);
  if ordinary_mode {
  } else {
    set root_proof.source_kind = 3_u8;
    set root_proof.basis_state = 3_u8;
  }
  set_height_input(child: &layout^.root, proof: root_proof);
  let counts = update_flow(context: &layout^.root, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: before);
  set layout^.root.x = 0_i32;
  set layout^.root.y = 0_i32;
  let updated_counts = UpdateCounts(prepared: prepared, work: counts.work, contexts: counts.contexts, paragraphs: counts.paragraphs, held_entries: counts.held_entries, entries: counts.entries);
  let combined_counts = add_counts(first: pending, second: updated_counts);
  set layout^.last_update = combined_counts;
  set layout^.dirty = False();
  if prepared_ok {
    return Ok<unit, LayoutError>(value: unit);
  }
  let failure = LayoutError::Text();
  return Err<unit, LayoutError>(error: failure);
}

fn restack_flow(context: &Context, events: &[Flow], styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, frame: FlowFrame, from: u64, until: u64, empty_stable: Bool, at: u64, old_top: i32, old_height: i32, old_lines: Bool, unasked: Bool, scope: &ReferenceScope) -> counts: UpdateCounts reads(events), reads(styles), reads(document), reads(fonts), reads(picks), writes(context), writes(scope) {
  doc "Stacks an affected flow range after restoring its unchanged prefix state. from is the first changed entry and until the last entry that must be processed before convergence; at names a paragraph already prepared by the caller, or no paragraph. A converged suffix moves by one delta, including natural positions and split lines; later baselines follow that delta. Split rectangles are regenerated from their block extents, while unchanged empty-inline fragments are kept when empty_stable and the line-presence checks permit it. The context's height, own fragment and positioned children are then current.";
  let boundary_work = no_boundary_visits();
  let held = context^.children.inner.len;
  let none = box_slots_new::<Exclusion>(capacity: 0_u64);
  if at < context^.paragraphs.inner.len {
    break_paragraph(paragraph: &context^.paragraphs.inner[at], children: &context^.children.inner[0_u64..held], styles: styles, fonts: fonts, picks: picks, exclusions: &none.inner[0_u64..0_u64], origin_y: 0_i32);
  }
  let old_entry = context^.baseline_entry;
  let old_baseline = context^.baseline;
  let old_based = context^.has_baseline;
  let old_raw = context^.content_raw;
  let old_end = context^.flow_end;
  let yes = True();
  let plan = Restack(partial: yes, from: from, until: until, empty_stable: empty_stable, unasked: unasked, old_top: old_top, old_height: old_height, old_lines: old_lines, old_flow_end: old_end);
  let stacked = stack_flow(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, content_left: frame.content_left, content_top: frame.content_top, content_width: frame.flow_width, basis_height: frame.definite, plan: plan);
  let baseline = stacked.baseline;
  let has_baseline = stacked.has_baseline;
  let content = if stacked.stopped {
    let delta = stacked.delta;
    let stop = flow_index(at: stacked.stop_at);
    if delta != 0_i32 {
      translate_reference_after(context: context, flow_at: stop, delta: delta);
      shift_split_lines(context: context, flow_at: stop, delta: delta);
      shift_naturals(context: context, after: stacked.stop_at, delta: delta);
    }
    let raw = old_raw +sat delta;
    set context^.content_raw = raw;
    set context^.flow_end = old_end +sat delta;
    let later = if old_entry == no_index {
      give False();
    } else {
      give old_entry > stop;
    }
    if later {
      set baseline = old_baseline +sat delta;
      set has_baseline = old_based;
      set context^.baseline_entry = old_entry;
    }
    give imax(raw, 0_i32);
  } else {
    give stacked.height;
  }
  let used = used_height(context: context, styles: styles, content: content);
  set context^.height = used;
  let group = box_of(styles: styles, style: context^.style);
  let shown_x = group.overflow_x == overflow_visible;
  let clipped_x = group.overflow_x == overflow_clip;
  let shown_y = group.overflow_y == overflow_visible;
  let clipped_y = group.overflow_y == overflow_clip;
  let visible_x = bor(shown_x, clipped_x);
  let visible_y = bor(shown_y, clipped_y);
  let visible = band(visible_x, visible_y);
  set context^.baseline = baseline;
  set context^.has_baseline = band(has_baseline, visible);
  let positioned_counts = if context^.has_out {
    let got = position_out_children(context: context, events: events, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
    give got;
  } else {
    let nothing = no_updates();
    give nothing;
  }
  let no_splits = context^.splits.inner.len == 0_u64;
  let unchanged_fragments = band(no_splits, stacked.fragments_same);
  let converged = band(stacked.stopped, stacked.fragments_same);
  let (translatable, range_top, range_bottom) = translatable_fragments(context: context, events: events, converged: converged, from: from, stop: stacked.stop_at);
  let keep_fragments = bor(unchanged_fragments, translatable);
  if keep_fragments {
    let owned = owns_fragment(style: context^.style);
    if owned {
      if 0_u64 < context^.fragments.inner.len {
        set context^.fragments.inner[0_u64].height = used;
        set context^.fragments.inner[0_u64].width = context^.width;
      }
    }
    let moved_by = stacked.delta != 0_i32;
    let shifting = band(translatable, moved_by);
    if shifting {
      let old_bottom = range_bottom -sat stacked.delta;
      translate_fragments(context: context, top: range_top, bottom: old_bottom, delta: stacked.delta);
    }
  } else {
    let previous_fragments = box_slots_new::<Fragment>(capacity: 0_u64);
    swap(first: &context^.fragments, second: &previous_fragments);
    clear_fragment_anchors(context: context);
    add_own_fragment(context: context);
    let owned = owns_fragment(style: context^.style);
    let old_count = previous_fragments.inner.len;
    let first_kept = if owned {
      give imin(old_count, 1_u64);
    } else {
      give 0_u64;
    }
    if first_kept <= old_count {
      split_fragments_with_empty(context: context, events: events, styles: styles, content_left: frame.content_left, kept: &previous_fragments.inner[first_kept..old_count], preserve_empty: stacked.fragments_same);
    }
  }
  let total = flow_length(context: context);
  let walked = if stacked.stopped {
    let after = stacked.stop_at +sat 1_u64;
    give total -sat after;
  } else {
    give 0_u64;
  }
  let entries = stacked.restacked +sat walked;
  let own = UpdateCounts(prepared: 0_u64, work: boundary_work, contexts: 1_u64, paragraphs: 1_u64, held_entries: stacked.restacked, entries: entries);
  let with_stacked = add_counts(first: own, second: stacked.below);
  let summed = add_counts(first: with_stacked, second: positioned_counts);
  set scope^.partial = unasked;
  set scope^.from = stacked.start_at;
  let scope_end = if stacked.stopped {
    give stacked.stop_at;
  } else {
    give total -sat 1_u64;
  }
  set scope^.until = scope_end;
  let scope_delta = if stacked.stopped {
    give stacked.delta;
  } else {
    give 0_i32;
  }
  set scope^.delta = scope_delta;
  return summed;
}

fn range_start(context: &Context, events: &[Flow], from: u64) -> (found: Bool, top: i32, chain: u32) reads(context), reads(events) {
  doc "The top of the entry a re-stack started from, when it is a paragraph, a child context, a float or a block whose top did not move (held_y), and the block around it; found is False for a Close or an out-of-flow entry.";
  let no = False();
  let flow_bound_1731 = reference_length(context: context, events: events);
  if from < flow_bound_1731 {
  } else {
    return no, 0_i32, no_index;
  }
  let first = reference_event(context: context, events: events, at: from);
  match first {
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        let geometry_read_4 = paragraph_position(context: context, at: at);
        return True(), geometry_read_4.y, context^.paragraphs.inner[at].block;
      }
      return no, 0_i32, no_index;
    }
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        let geometry_read_5 = block_position(context: context, at: at);
        let same = context^.blocks.inner[at].held_y == geometry_read_5.y;
        let geometry_read_6 = block_position(context: context, at: at);
        return same, geometry_read_6.y, context^.blocks.inner[at].parent;
      }
      return no, 0_i32, no_index;
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        let geometry_read_7 = child_position(context: context, at: at);
        return True(), geometry_read_7.y, context^.children.inner[at].block;
      }
      return no, 0_i32, no_index;
    }
    Float(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        let geometry_read_8 = child_position(context: context, at: at);
        return True(), geometry_read_8.y, context^.children.inner[at].block;
      }
      return no, 0_i32, no_index;
    }
    Close(..) => {
      return no, 0_i32, no_index;
    }
    Out(..) => {
      return no, 0_i32, no_index;
    }
  }
}

fn translatable_fragments(context: &Context, events: &[Flow], converged: Bool, from: u64, stop: u64) -> (ok: Bool, top: i32, bottom: i32) reads(context), reads(events) {
  doc "Whether, after a re-stack of the flow entries from..stop that converged with every later entry moved by one delta, the context's own fragment list (split_fragments') can be kept and translated instead of being made again: no block-in-inline opens or closes in the range, so every split run lies above it, around it or below it; no paragraph without lines in the range opens an inline box, so no empty fragment lies inside it; the entry at from and every block open around it kept their tops (held_y), so a run around the range grows by delta only at its bottom; and the entry at stop is a paragraph with lines. Returns the range's top, which did not move, and the new bottom of the entry at stop (its old bottom is that less delta).";
  let no = False();
  if converged {
  } else {
