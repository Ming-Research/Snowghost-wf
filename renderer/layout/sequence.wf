fn record_event_lines(context: &Context, item: Flow) -> result: unit reads(context.block_routes.inner), writes(context.entries) {
  doc "Updates normal-flow line summaries; lexical block boundaries never clear the enclosing context's float state.";
  match item {
    Text(paragraph: paragraph) => {
      record_paragraph_lines(context: context, at: paragraph);
    }
    Child(context: child) => {
      let unused = unit;
      let state = False();
      read_child::<unit, unit, unit, unit, unit, Bool, fn child_has_lines>(context: context, handle: child, a: &unused, b: &unused, c: &unused, d: &unused, e: &unused, state: &state);
      record_line_output(context: context, handle: child, has_lines: state);
    }
    Close(block: closed) => {
      let held = block_value(context: context, handle: closed);
      refresh_owner_output(context: context, owner: held.directory);
    }
    Open(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  return unit;
}
fn owned_clear<T: drop>(pages: &OwnedPages<T>, slot: u32, span: u32) -> result: unit writes(pages) {
  doc "Drops only the removed local payload, leaving a hole and retaining every other slot and directory page.";
  if slot >= span {
    return unit;
  }
  match pages^ {
    Vacant() => {
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        let vacant = None<T>();
        set page^.inner[at] = move vacant;
      }
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        owned_clear::<T>(pages: &left_page^.inner, slot: slot, span: half);
      } else {
        let later = slot -sat half;
        owned_clear::<T>(pages: &right_page^.inner, slot: later, span: half);
      }
    }
  }
  return unit;
}