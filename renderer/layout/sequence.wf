}
fn record_line_output(context: &Context, handle: EntryHandle, has_lines: Bool) -> result: unit reads(context.block_routes.inner), writes(context.entries) {
  doc "Publishes a stable line-bearing entry and repairs only its owner's index and ancestor summaries.";
  if handle.slot == no_index {
    return unit;
  }
  let output = pending_output(events: 1_u64);
  if has_lines {
    set output.first_line = handle;
    set output.last_line = handle;
  }
  owner_set_output(context: context, owner: handle.owner, slot: handle.slot, output: output);
  refresh_owner_output(context: context, owner: handle.owner);
  return unit;
}
