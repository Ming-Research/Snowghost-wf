fn block_snapshot(block: &Block) -> made: BlockSnapshot reads(block) {
  doc "Copies scalar geometry and style only, leaving nested sequence and payload ownership in place.";
  let snapshot = BlockSnapshot(directory: block^.directory, style: block^.style, x: block^.x, y: block^.y, dx: block^.dx, dy: block^.dy, normal_x: block^.normal_x, normal_y: block^.normal_y, resolved_x: block^.resolved_x, resolved_y: block^.resolved_y, width: block^.width, height: block^.height, marker: block^.marker, parent: block^.parent, flow_at: block^.flow_at, inner_x: block^.inner_x, held_y: block^.held_y, avail_left: block^.avail_left, avail_width: block^.avail_width, content_left: block^.content_left, content_width: block^.content_width);
  return snapshot;
}
fn copy_block_value(value: &Block, a: &unit, b: &unit, c: &unit, d: &unit, e: &unit, state: &BlockSnapshot) -> result: unit reads(value), writes(state) {
  doc "Copies the selected block's scalar state into the caller's snapshot.";
  let snapshot = block_snapshot(block: value);
  set state^ = snapshot;
  return unit;
}
fn block_value(context: &Context, handle: EntryHandle) -> value: BlockSnapshot reads(context.block_routes.inner), reads(context.entries) {
