struct AppendPayload<T> {
  doc "Private ownership transfer into one sequence; result is published only after the payload and index slot exist.";
  value: Option<T>;
  owner: u32;
  directory: u32;
  kind: u8;
  result: Result<EntryHandle, LayoutError>;
}

fn detached_slot(sequence: &EntrySequence) -> result: Result<u32, LayoutError> writes(sequence) {
  doc "Allocates a live owner-local payload slot for an atomic inline or table cell without adding a virtual flow event.";
  if sequence^.allocated >= 1073741824_u32 {
    let failure = too_large::<u32>();
    return failure;
  }
  sequence_reserve(sequence: sequence);
  let fresh = sequence^.allocated;
  let node = vacant_node();
  let owned_result_1 = True();
  set node.live = owned_result_1;
  sequence_write(sequence: sequence, slot: fresh, node: node);
  set sequence^.allocated = fresh +sat 1_u32;
  let result = Ok<u32, LayoutError>(value: fresh);
  return result;
}
fn append_block_slot(sequence: &EntrySequence, slot: u32, a: &unit, b: &unit, c: &unit, d: &unit, e: &unit, state: &AppendPayload<Block>) -> result: unit writes(sequence), writes(state) {
  doc "Moves one block into its owner's stable local slot; route publication follows this private construction.";
  let handle = EntryHandle(owner: state^.owner, slot: sequence^.allocated);
  let item = Flow::Open(block: handle);
  let output = pending_output(events: 1_u64);
  let inserted = insert_before(sequence: sequence, before: no_index, item: item, output: output);
  match inserted {
    Err(error: failure) => {
      let refused = Err<EntryHandle, LayoutError>(error: failure);
      set state^.result = refused;
    }
    Ok(value: local_slot) => {
      let staged = None<Block>();
      swap(first: &staged, second: &state^.value);
      match move staged {
        Some(value: payload) => {
          set payload.entry_slot = local_slot;
          set payload.parent = handle.owner;
          set payload.directory = state^.directory;
          owned_write::<Block>(pages: &sequence^.blocks, slot: local_slot, span: sequence^.span, value: move payload);
          let accepted = Ok<EntryHandle, LayoutError>(value: handle);
          set state^.result = accepted;
        }
        None() => {
        }
      }
    }
  }
  return unit;
}
