    give owned_result_1;
  } else {
    let item = if state^.kind == 1_u8 {
      let owned_result_2 = Flow::Float(context: handle);
      give owned_result_2;
    } else if state^.kind == 2_u8 {
      let owned_result_3 = Flow::Out(context: handle);
      give owned_result_3;
    } else {
      let owned_result_4 = Flow::Child(context: handle);
      give owned_result_4;
