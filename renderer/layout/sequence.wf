fn refresh_owner_output(context: &Context, owner: u32) -> result: unit reads(context.block_routes.inner), writes(context.entries) {
  doc "Repairs semantic output only along the owner route, without visiting siblings or rebuilding a flat order.";
  let cursor = owner;
  let limit = context^.block_routes.inner.len;
  for (level in 0_u64..limit) {
    let at = cvt::<u32, u64>(cursor);
    if at < context^.block_routes.inner.len {
      let handle = context^.block_routes.inner[at];
      let unused = unit;
      let state = unit;
      let output = empty_output();
      read_block::<unit, unit, unit, unit, unit, SequenceOutput, fn copy_block_output>(context: context, handle: handle, a: &unused, b: &unused, c: &unused, d: &unused, e: &unused, state: &output);
      edit_block::<SequenceOutput, unit, unit, unit, unit, unit, fn write_block_output>(context: context, handle: handle, a: &output, b: &unused, c: &unused, d: &unused, e: &unused, state: &state);
      owner_set_output(context: context, owner: handle.owner, slot: handle.slot, output: output);
