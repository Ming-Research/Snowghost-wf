fn nested_block_event(pages: &OwnedPages<Block>, slot: u32, span: u32, offset: u64, handle: EntryHandle) -> made: Flow reads(pages) {
  doc "Descends the block payload selected by a local event slot, preserving the surrounding formatting context's float domain.";
  let absent = absent_handle();
  let missing = Flow::Close(block: absent);
  if slot >= span {
    return missing;
  }
  match pages^ {
    Vacant() => {
      return missing;
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        match page^.inner[at] {
          Some(value: block) => {
            let inside = sequence_output(sequence: &block^.entries);
            let closing_offset = inside.events +sat 1_u64;
            if offset == closing_offset {
              let close = Flow::Close(block: handle);
              return close;
            }
            if offset > 0_u64 {
              let local = offset -sat 1_u64;
              let nested = nested_event(sequence: &block^.entries, at: local);
              return nested;
            }
          }
          None() => {
          }
        }
      }
      return missing;
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        let left = nested_block_event(pages: &left_page^.inner, slot: slot, span: half, offset: offset, handle: handle);
        return left;
      }
      let later = slot -sat half;
      let right = nested_block_event(pages: &right_page^.inner, slot: later, span: half, offset: offset, handle: handle);
      return right;
    }
  }
}
fn nested_event(sequence: &EntrySequence, at: u64) -> made: Flow reads(sequence) {
  doc "Adapts owner-local indexed entries to temporary flat events; a block occurs once in storage and synthesizes its Close.";
  let (slot, offset) = sequence_select(sequence: sequence, event: at);
  let item = sequence_payload(sequence: sequence, slot: slot);
  match item {
    Open(block: handle) => {
      if offset == 0_u64 {
