      let nested = nested_block_event(pages: &sequence^.blocks, slot: slot, span: sequence^.span, offset: offset, handle: handle);
      return nested;
    }
    Close(..) => {
      return item;
    }
    Text(..) => {
      return item;
    }
    Child(..) => {
      return item;
    }
    Float(..) => {
      return item;
    }
    Out(..) => {
      return item;
    }
  }
}
