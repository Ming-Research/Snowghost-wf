  match inserted {
    Err(error: failure) => {
      let refused = Err<EntryHandle, LayoutError>(error: failure);
      set state^.result = refused;
    }
    Ok(value: local_slot) => {
      let staged = None<Context>();
      swap(first: &staged, second: &state^.value);
      match move staged {
        Some(value: payload) => {
          set payload.entry_slot = local_slot;
          set payload.block = handle.owner;
          owned_write::<Context>(pages: &sequence^.children, slot: local_slot, span: sequence^.span, value: move payload);
          let accepted = Ok<EntryHandle, LayoutError>(value: handle);
