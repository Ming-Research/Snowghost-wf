fn copy_block_output(value: &Block, a: &unit, b: &unit, c: &unit, d: &unit, e: &unit, state: &SequenceOutput) -> result: unit reads(value.entries), writes(state) {
  doc "Converts a block's inner event and line summary into its enclosing entry's output.";
