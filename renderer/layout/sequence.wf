fn absent_handle() -> made: EntryHandle pure {
  doc "The absent line or entry handle.";
  let absent = EntryHandle(owner: no_index, slot: no_index);
  return absent;
}

fn empty_output() -> made: SequenceOutput pure {
  doc "The identity Through transfer, with no line or float handles.";
  let absent = absent_handle();
  let yes = True();
  let empty = SequenceOutput(count: 0_u64, events: 0_u64, first_line: absent, last_line: absent, ordinary: yes, through: yes, leading_positive: 0_i32, leading_negative: 0_i32, advance: 0_i64, trailing_positive: 0_i32, trailing_negative: 0_i32, first_baseline: 0_i64, last_baseline: 0_i64, travel: 0_i64, min_content: 0_i32, max_content: 0_i32, floats: 0_u64, first_float: absent, last_float: absent, barriers: 0_u32);
  return empty;
}

fn pending_output(events: u64) -> made: SequenceOutput pure {
  doc "One entry whose event span is known and whose semantic margin/line output still needs layout.";
  let pending = empty_output();
  set pending.count = 1_u64;
  set pending.events = events;
  let no = False();
  set pending.ordinary = no;
  return pending;
}

fn join_output(left: &SequenceOutput, right: &SequenceOutput) -> made: SequenceOutput reads(left), reads(right) {
  doc "Composes Through/Through, Through/Solid, Solid/Through and Solid/Solid in document order. Only unsaturated ordinary transfers may drive placement; structural, baseline and float metadata remain available for unsupported runs.";
  if left^.count == 0_u64 {
    return right^;
  }
  if right^.count == 0_u64 {
    return left^;
  }
  let joined = empty_output();
  set joined.count = left^.count +sat right^.count;
  set joined.events = left^.events +sat right^.events;
  let first_line = if left^.first_line.slot != no_index {
    give left^.first_line;
  } else {
    give right^.first_line;
  }
  set joined.first_line = first_line;
  let last_line = if right^.last_line.slot != no_index {
    give right^.last_line;
  } else {
    give left^.last_line;
  }
  set joined.last_line = last_line;
  let composed_1 = band(left^.ordinary, right^.ordinary);
  set joined.ordinary = composed_1;
  let composed_2 = band(left^.through, right^.through);
  set joined.through = composed_2;
  set joined.leading_positive = left^.leading_positive;
  set joined.leading_negative = left^.leading_negative;
  set joined.trailing_positive = right^.trailing_positive;
  set joined.trailing_negative = right^.trailing_negative;
  let displacement = 0_i64;
  if left^.through {
    let composed_3 = imax(left^.leading_positive, right^.leading_positive);
    set joined.leading_positive = composed_3;
    let composed_4 = imin(left^.leading_negative, right^.leading_negative);
    set joined.leading_negative = composed_4;
    set joined.advance = right^.advance;
  } else if right^.through {
    set joined.advance = left^.advance;
    let composed_5 = imax(left^.trailing_positive, right^.leading_positive);
    set joined.trailing_positive = composed_5;
    let composed_6 = imin(left^.trailing_negative, right^.leading_negative);
    set joined.trailing_negative = composed_6;
  } else {
    let positive = imax(left^.trailing_positive, right^.leading_positive);
    let negative = imin(left^.trailing_negative, right^.leading_negative);
    let wide_positive = cvt::<i32, i64>(positive);
    let wide_negative = cvt::<i32, i64>(negative);
    let gap = wide_positive +sat wide_negative;
    set displacement = left^.advance +sat gap;
    set joined.advance = displacement +sat right^.advance;
  }
  let first_offset = if left^.first_line.slot != no_index {
    give left^.first_baseline;
  } else if right^.first_line.slot != no_index {
    give displacement +sat right^.first_baseline;
  } else {
    give 0_i64;
  }
  let last_offset = if right^.last_line.slot != no_index {
    give displacement +sat right^.last_baseline;
  } else if left^.last_line.slot != no_index {
    give left^.last_baseline;
  } else {
    give 0_i64;
  }
  set joined.first_baseline = first_offset;
  set joined.last_baseline = last_offset;
  set joined.travel = left^.travel +sat right^.travel;
  if joined.travel > 268435456_i64 {
    set joined.ordinary = False();
  }
  let composed_7 = imax(left^.min_content, right^.min_content);
  set joined.min_content = composed_7;
  let composed_8 = imax(left^.max_content, right^.max_content);
  set joined.max_content = composed_8;
  set joined.floats = left^.floats +sat right^.floats;
  let first_export = if left^.first_float.slot != no_index {
    give left^.first_float;
  } else {
    give right^.first_float;
  }
  let last_export = if right^.last_float.slot != no_index {
    give right^.last_float;
  } else {
    give left^.last_float;
  }
  set joined.first_float = first_export;
  set joined.last_float = last_export;
  let composed_9 = imax(left^.barriers, right^.barriers);
  set joined.barriers = composed_9;
  return joined;
}

fn vacant_cursor() -> made: SequenceCursor pure {
  doc "The absent topology and weights, without constructing a semantic transfer.";
  let no = False();
  let vacant = SequenceCursor(left: no_index, right: no_index, parent: no_index, height: 0_u32, live: no, own_events: 0_u64, total_events: 0_u64, total_count: 0_u64);
  return vacant;
}

fn new_entry_storage(count: u64) -> made: EntryStorage pure {
  doc "Allocates each field group once per context, with no allocation per small owner.";
  let missing = Flow::Close(block: no_index);
  let cursor = vacant_cursor();
  let output = empty_output();
  let payloads = new_pages::<Flow>(count: count, missing: missing);
  let links = new_pages::<SequenceCursor>(count: count, missing: cursor);
  let own = new_pages::<SequenceOutput>(count: count, missing: output);
  let total = new_pages::<SequenceOutput>(count: count, missing: output);
  return EntryStorage(payloads: move payloads, links: move links, own: move own, total: move total);
}

fn new_sequence() -> made: EntrySequence pure {
  doc "An empty owner retains only its AVL root and a lazy construction list; final entry storage belongs to the context.";
  let pending = None<Box<Slots<PendingEntry>>>();
  return EntrySequence(base: 0_u32, root: no_index, allocated: 0_u32, span: 1073741824_u32, pending: move pending, pending_events: 0_u64);
}

fn sequence_node(storage: &EntryStorage, sequence: &EntrySequence, slot: u32) -> made: SequenceCursor reads(storage.links), reads(sequence.span) {
  doc "Reads topology and weights without reading either semantic transfer.";
  let missing = vacant_cursor();
  let made = slot_read::<SequenceCursor>(pages: &storage^.links, slot: slot, span: sequence^.span, missing: missing);
  return made;
}

fn fill_flow(storage: &EntryStorage, context: &Context, sequence: &EntrySequence, root: u32, destination: &[Flow]) -> result: unit reads(storage), reads(context), reads(sequence), writes(destination) {
  doc "Fills disjoint left, own and right event ranges from cached weights. An Open fills its nested range and synthesizes its Close; siblings share no destination writes.";
  let held = sequence_node(storage: storage, sequence: sequence, slot: root);
  if held.live {
  } else {
    return unit;
  }
  let left = sequence_node(storage: storage, sequence: sequence, slot: held.left);
  let before = left.total_events;
  let after = before +sat held.own_events;
  let count = destination^.len;
  if before >= after {
    return unit;
  }
  if after > count {
    return unit;
  }
  fill_flow(storage: storage, context: context, sequence: sequence, root: held.left, destination: &destination^[0_u64..before]);
  let missing = Flow::Close(block: no_index);
  let item = slot_read::<Flow>(pages: &storage^.payloads, slot: root, span: sequence^.span, missing: missing);
  set destination^[before] = item;
  match item {
    Open(block: child) => {
      let child_at = cvt::<u32, u64>(child);
      let inside_start = before + 1_u64;
      let inside_end = after - 1_u64;
      if inside_start <= inside_end {
        if child_at < context^.blocks.inner.len {
          let nested = &context^.blocks.inner[child_at].entries;
          fill_flow(storage: storage, context: context, sequence: nested, root: nested^.root, destination: &destination^[inside_start..inside_end]);
          let close = Flow::Close(block: child);
          set destination^[inside_end] = close;
        }
      }
    }
    Close(..) => {
    }
    Text(..) => {
    }
    Child(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  fill_flow(storage: storage, context: context, sequence: sequence, root: held.right, destination: &destination^[after..count]);
  return unit;
}

fn materialize_flow(context: &Context) -> made: Box<Array<Flow>> reads(context) {
  doc "Makes one immutable event array for a context pass. Filled Array construction avoids a Slots length-update chain; walkers borrow its slice until the pass ends.";
  let count = flow_length(context: context);
  let missing = Flow::Close(block: no_index);
  let events = box_array_filled::<Flow>(count: count, value: missing);
  fill_flow(storage: &context^.storage, context: context, sequence: &context^.entries, root: context^.entries.root, destination: &events.inner[0_u64..count]);
  return move events;
}

fn bulk_nodes(pending: &[PendingEntry], nodes: &Run<SequenceCursor>, base: u64, parent: u32) -> (root: u32, height: u32, events: u64) reads(pending), writes(nodes) {
  doc "Builds topology and event weights in transient cursor storage before independent page publication. Median halves write disjoint slices; the parent waits only for their heights and event spans.";
  let count = pending^.len;
  if count == 0_u64 {
    return no_index, 0_u32, 0_u64;
  }
  if count != nodes^.len {
    return no_index, 0_u32, 0_u64;
  }
  let middle = count / 2_u64;
  if middle >= count {
    return no_index, 0_u32, 0_u64;
  }
  let slot_at = base +sat middle;
  let slot = flow_index(at: slot_at);
  let following = middle + 1_u64;
  let right_base = slot_at +sat 1_u64;
  let (left, left_height, left_events) = bulk_nodes(pending: &pending^[0_u64..middle], nodes: &nodes^[0_u64..middle], base: base, parent: slot);
  let (right, right_height, right_events) = bulk_nodes(pending: &pending^[following..count], nodes: &nodes^[following..count], base: right_base, parent: slot);
  let own_events = pending^[middle].events;
  let prefix = left_events +sat own_events;
  let total_events = prefix +sat right_events;
  let taller = imax(left_height, right_height);
  let height = taller +sat 1_u32;
  let yes = True();
  let node = SequenceCursor(left: left, right: right, parent: parent, height: height, live: yes, own_events: own_events, total_events: total_events, total_count: count);
  if middle < nodes^.len {
    set nodes^[middle] = node;
  }
  return slot, height, total_events;
}

fn finish_sequence(sequence: &EntrySequence, nodes: &Run<SequenceCursor>, payloads: &Run<Flow>) -> result: unit writes(sequence), writes(nodes), writes(payloads) {
  doc "Seals one owner's disjoint pool range with median topology construction and flat payload publication.";
  match sequence^.pending {
    None() => {
      return unit;
    }
    Some(value: pending) => {
      let count = pending^.inner.len;
      let base = cvt::<u32, u64>(sequence^.base);
      let (root, height, events) = bulk_nodes(pending: &pending^.inner[0_u64..count], nodes: nodes, base: base, parent: no_index);
      for (s in 0_u64..payloads^.len) {
        if s < pending^.inner.len {
          set payloads^[s] = pending^.inner[s].item;
        }
      }
      set sequence^.root = root;
    }
  }
  let empty_pending = None<Box<Slots<PendingEntry>>>();
  set sequence^.pending = move empty_pending;
  set sequence^.pending_events = 0_u64;
  return unit;
}

fn pending_append(sequence: &EntrySequence, item: Flow) -> result: Result<u32, LayoutError> writes(sequence.pending), writes(sequence.pending_events) {
  doc "Lazily allocates a builder list on its first direct entry, then grows geometrically; its pending index becomes its stable slot.";
  match sequence^.pending {
    None() => {
      let values = box_slots_new::<PendingEntry>(capacity: 4_u64);
      let started = Some<Box<Slots<PendingEntry>>>(value: move values);
      set sequence^.pending = move started;
    }
    Some(..) => {
    }
  }
  match sequence^.pending {
    Some(value: pending) => {
      let count = pending^.inner.len;
      let slot = flow_index(at: count);
      let added = PendingEntry(item: item, events: 1_u64);
      let kept = propagate push_or_fail::<PendingEntry>(cell: pending, value: added);
      set sequence^.pending_events = sequence^.pending_events +sat 1_u64;
      let success = Ok<u32, LayoutError>(value: slot);
      return success;
    }
    None() => {
      let inconsistent = LayoutError::Inconsistent();
      let failure = Err<u32, LayoutError>(error: inconsistent);
      return failure;
    }
  }
}

fn pending_close(sequence: &EntrySequence, slot: u32, events: u64) -> result: unit writes(sequence.pending), writes(sequence.pending_events) {
  doc "Replaces an Open's provisional single event with its completed nested span in the unfinished parent, without index repair.";
  let at = cvt::<u32, u64>(slot);
  match sequence^.pending {
    Some(value: pending) => {
      if at < pending^.inner.len {
        let previous = pending^.inner[at].events;
        set pending^.inner[at].events = events;
        let rest = sequence^.pending_events -sat previous;
        set sequence^.pending_events = rest +sat events;
      }
    }
    None() => {
    }
  }
  return unit;
}

fn sequence_reserve(sequence: &EntrySequence) -> result: unit writes(sequence.span) {
  doc "Admits the stable slot address space; page allocation occurs only for the inserted slot.";
  set sequence^.span = 1073741824_u32;
  return unit;
}

fn later_handles(storage: &EntryStorage, sequence: &EntrySequence, root: u32, skip: u64, owner: u32, handles: &Box<Slots<EntryHandle>>, visits: &BoundaryVisits) -> result: unit reads(storage), reads(sequence.span), writes(handles), writes(visits) {
  doc "Visits only index subtrees intersecting a direct suffix and emits stable handles in order. The result is an immutable work list, not a retained alternate order index.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: root, visits: visits);
  if held.live {
  } else {
    return unit;
  }
  if skip >= held.total_count {
    return unit;
  }
  let left_node = boundary_node(storage: storage, sequence: sequence, slot: held.left, visits: visits);
  if skip < left_node.total_count {
    later_handles(storage: storage, sequence: sequence, root: held.left, skip: skip, owner: owner, handles: handles, visits: visits);
  }
  if skip <= left_node.total_count {
    let handle = EntryHandle(owner: owner, slot: root);
    let kept = push_item::<EntryHandle>(cell: handles, value: handle, ceiling: item_ceiling);
    later_handles(storage: storage, sequence: sequence, root: held.right, skip: 0_u64, owner: owner, handles: handles, visits: visits);
  } else {
    let past_left = skip -sat left_node.total_count;
    let past_self = past_left -sat 1_u64;
    later_handles(storage: storage, sequence: sequence, root: held.right, skip: past_self, owner: owner, handles: handles, visits: visits);
  }
  return unit;
}

fn visit_later(storage: &EntryStorage, sequence: &EntrySequence, after: u32, owner: u32) -> made: Box<Slots<EntryHandle>> reads(storage), reads(sequence.root), reads(sequence.span) {
  doc "Returns the direct entries after a stable slot, never descending their block contents or reading the unchanged prefix payloads. Step 4 consumes these handles for independent sibling origins; this function performs no payload scatter.";
  let handles = box_slots_new::<EntryHandle>(capacity: 0_u64);
  let current = sequence_node(storage: storage, sequence: sequence, slot: after);
  if current.live {
    let rank = sequence_rank(storage: storage, sequence: sequence, slot: after);
    let start = rank +sat 1_u64;
    let visits = no_boundary_visits();
    later_handles(storage: storage, sequence: sequence, root: sequence^.root, skip: start, owner: owner, handles: &handles, visits: &visits);
  }
  return move handles;
}

fn sequence_write(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, node: SequenceCursor) -> result: unit reads(sequence.span), writes(storage.links) {
  doc "Writes one existing topology slot without touching payloads or transfers.";
  let at = cvt::<u32, u64>(slot);
  if slot < sequence^.span {
    if at < storage^.links.inner.len {
      set storage^.links.inner[at] = node;
    }
  }
  return unit;
}

fn slot_output(storage: &EntryStorage, slot: u32, span: u32, own: Bool) -> made: SequenceOutput reads(storage) {
  doc "Reads only a selected live transfer and its topology weights.";
  let at = cvt::<u32, u64>(slot);
  if slot < span {
    if at < storage^.links.inner.len {
      let links = storage^.links.inner[at];
      if links.live {
        if own {
          if at < storage^.own.inner.len {
            let value = storage^.own.inner[at];
            set value.count = 1_u64;
            set value.events = links.own_events;
            return value;
          }
        } else {
          if at < storage^.total.inner.len {
            let value = storage^.total.inner[at];
            set value.count = links.total_count;
            set value.events = links.total_events;
            return value;
          }
        }
      }
    }
  }
  let empty = empty_output();
  return empty;
}

fn slot_store_output(storage: &EntryStorage, slot: u32, span: u32, output: &SequenceOutput, own: Bool) -> result: unit reads(output), writes(storage) {
  doc "Updates a selected live transfer and its corresponding cached weights.";
  let at = cvt::<u32, u64>(slot);
  if slot < span {
    if at < storage^.links.inner.len {
      if storage^.links.inner[at].live {
        if own {
          if at < storage^.own.inner.len {
            set storage^.own.inner[at] = output^;
            set storage^.links.inner[at].own_events = output^.events;
          }
        } else {
          if at < storage^.total.inner.len {
            set storage^.total.inner[at] = output^;
            set storage^.links.inner[at].total_events = output^.events;
            set storage^.links.inner[at].total_count = output^.count;
          }
        }
      }
    }
  }
  return unit;
}

fn sequence_output(storage: &EntryStorage, sequence: &EntrySequence) -> made: SequenceOutput reads(storage), reads(sequence.root), reads(sequence.span) {
  doc "Reads only the cached transfer at this owner's root.";
  let total = False();
  let output = slot_output(storage: storage, slot: sequence^.root, span: sequence^.span, own: total);
  return output;
}

fn sequence_payload(storage: &EntryStorage, sequence: &EntrySequence, slot: u32) -> made: Flow reads(storage), reads(sequence.span) {
  doc "Reads a live direct-entry payload; a removed or invalid handle yields an invalid Close event, never a reused payload.";
  let missing = Flow::Close(block: no_index);
  let held = sequence_node(storage: storage, sequence: sequence, slot: slot);
  if held.live {
    let payload = slot_read::<Flow>(pages: &storage^.payloads, slot: slot, span: sequence^.span, missing: missing);
    return payload;
  }
  return missing;
}

fn sequence_parent(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, parent: u32, visits: &BoundaryVisits) -> result: unit reads(sequence.span), writes(storage), writes(visits) {
  doc "Repairs the parent link of a live index node; empty links require no storage.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  if held.live {
    set held.parent = parent;
    sequence_write(storage: storage, sequence: sequence, slot: slot, node: held);
  }
  return unit;
}

fn sequence_repair(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> result: unit reads(sequence.span), writes(storage), writes(visits) {
  doc "Repairs topology and reads only the three transfers needed to compose one AVL node.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  if held.live {
    let left_node = boundary_node(storage: storage, sequence: sequence, slot: held.left, visits: visits);
    let right_node = boundary_node(storage: storage, sequence: sequence, slot: held.right, visits: visits);
    let own_field = True();
    let total_field = False();
    let left_output = boundary_output(storage: storage, sequence: sequence, slot: held.left, own: total_field, visits: visits);
    let right_output = boundary_output(storage: storage, sequence: sequence, slot: held.right, own: total_field, visits: visits);
    let own_output = boundary_output(storage: storage, sequence: sequence, slot: slot, own: own_field, visits: visits);
    let prefix = join_output(left: &left_output, right: &own_output);
    let total = join_output(left: &prefix, right: &right_output);
    let taller = imax(left_node.height, right_node.height);
    set held.height = taller +sat 1_u32;
    sequence_write(storage: storage, sequence: sequence, slot: slot, node: held);
    slot_store_output(storage: storage, slot: slot, span: sequence^.span, output: &total, own: total_field);
  }
  return unit;
}

fn sequence_rotate_left(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> root: u32 reads(sequence.span), writes(storage), writes(visits) {
  doc "Rotates metadata links left while preserving every stable payload slot and the order of entries.";
  let base = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  let pivot_slot = base.right;
  let pivot = boundary_node(storage: storage, sequence: sequence, slot: pivot_slot, visits: visits);
  if pivot.live {
    set base.right = pivot.left;
    sequence_parent(storage: storage, sequence: sequence, slot: pivot.left, parent: slot, visits: visits);
    set pivot.left = slot;
    set pivot.parent = base.parent;
    set base.parent = pivot_slot;
    sequence_write(storage: storage, sequence: sequence, slot: slot, node: base);
    sequence_write(storage: storage, sequence: sequence, slot: pivot_slot, node: pivot);
    sequence_repair(storage: storage, sequence: sequence, slot: slot, visits: visits);
    sequence_repair(storage: storage, sequence: sequence, slot: pivot_slot, visits: visits);
    return pivot_slot;
  }
  return slot;
}

fn sequence_rotate_right(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> root: u32 reads(sequence.span), writes(storage), writes(visits) {
  doc "Rotates metadata links right without reading or moving payloads.";
  let base = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  let pivot_slot = base.left;
  let pivot = boundary_node(storage: storage, sequence: sequence, slot: pivot_slot, visits: visits);
  if pivot.live {
    set base.left = pivot.right;
    sequence_parent(storage: storage, sequence: sequence, slot: pivot.right, parent: slot, visits: visits);
    set pivot.right = slot;
    set pivot.parent = base.parent;
    set base.parent = pivot_slot;
    sequence_write(storage: storage, sequence: sequence, slot: slot, node: base);
    sequence_write(storage: storage, sequence: sequence, slot: pivot_slot, node: pivot);
    sequence_repair(storage: storage, sequence: sequence, slot: slot, visits: visits);
    sequence_repair(storage: storage, sequence: sequence, slot: pivot_slot, visits: visits);
    return pivot_slot;
  }
  return slot;
}

fn sequence_balance(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> root: u32 reads(sequence.span), writes(storage), writes(visits) {
  doc "Repairs an AVL insertion/removal ancestor with at most two rotations.";
  sequence_repair(storage: storage, sequence: sequence, slot: slot, visits: visits);
  let held = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  let left_node = boundary_node(storage: storage, sequence: sequence, slot: held.left, visits: visits);
  let right_node = boundary_node(storage: storage, sequence: sequence, slot: held.right, visits: visits);
  let right_limit = right_node.height +sat 1_u32;
  if left_node.height > right_limit {
    let ll = boundary_node(storage: storage, sequence: sequence, slot: left_node.left, visits: visits);
    let lr = boundary_node(storage: storage, sequence: sequence, slot: left_node.right, visits: visits);
    if lr.height > ll.height {
      let rotated = sequence_rotate_left(storage: storage, sequence: sequence, slot: held.left, visits: visits);
      set held.left = rotated;
      sequence_write(storage: storage, sequence: sequence, slot: slot, node: held);
    }
    let rotated = sequence_rotate_right(storage: storage, sequence: sequence, slot: slot, visits: visits);
    return rotated;
  }
  let left_limit = left_node.height +sat 1_u32;
  if right_node.height > left_limit {
    let rl = boundary_node(storage: storage, sequence: sequence, slot: right_node.left, visits: visits);
    let rr = boundary_node(storage: storage, sequence: sequence, slot: right_node.right, visits: visits);
    if rl.height > rr.height {
      let rotated = sequence_rotate_right(storage: storage, sequence: sequence, slot: held.right, visits: visits);
      set held.right = rotated;
      sequence_write(storage: storage, sequence: sequence, slot: slot, node: held);
    }
    let rotated = sequence_rotate_left(storage: storage, sequence: sequence, slot: slot, visits: visits);
    return rotated;
  }
  return slot;
}

fn sequence_rank(storage: &EntryStorage, sequence: &EntrySequence, slot: u32) -> rank: u64 reads(storage), reads(sequence.root), reads(sequence.span) {
  doc "Returns a transient direct rank through the shared counted index descent.";
  let visits = no_boundary_visits();
  let rank = boundary_rank(storage: storage, sequence: sequence, slot: slot, visits: &visits);
  return rank;
}

fn sequence_insert_at(storage: &EntryStorage, sequence: &EntrySequence, root: u32, rank: u64, added: u32, parent: u32, visits: &BoundaryVisits) -> made: u32 reads(sequence.span), writes(storage), writes(visits) {
  doc "Inserts a previously allocated stable leaf into an AVL rank path; only index ancestors are visited.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: root, visits: visits);
  if held.live {
  } else {
    sequence_parent(storage: storage, sequence: sequence, slot: added, parent: parent, visits: visits);
    return added;
  }
  let left_node = boundary_node(storage: storage, sequence: sequence, slot: held.left, visits: visits);
  if rank <= left_node.total_count {
    let inserted = sequence_insert_at(storage: storage, sequence: sequence, root: held.left, rank: rank, added: added, parent: root, visits: visits);
    set held.left = inserted;
  } else {
    let after_left = rank -sat left_node.total_count;
    let after_self = after_left -sat 1_u64;
    let inserted = sequence_insert_at(storage: storage, sequence: sequence, root: held.right, rank: after_self, added: added, parent: root, visits: visits);
    set held.right = inserted;
  }
  sequence_write(storage: storage, sequence: sequence, slot: root, node: held);
  let balanced = sequence_balance(storage: storage, sequence: sequence, slot: root, visits: visits);
  return balanced;
}

fn insert_before(storage: &EntryStorage, sequence: &EntrySequence, before: u32, item: Flow, output: SequenceOutput, visits: &BoundaryVisits) -> result: Result<u32, LayoutError> writes(sequence), writes(visits), writes(storage) {
  doc "Inserts one new direct entry before a live stable slot, or at end for no_index. A range is a batch of these operations in source order. Earlier payload slots are neither read nor copied.";
  if storage^.payloads.inner.len >= 1073741824_u64 {
    let failure = too_large::<u32>();
    return failure;
  }
  if before != no_index {
    let target = boundary_node(storage: storage, sequence: sequence, slot: before, visits: visits);
    if target.live {
    } else {
      let inconsistent = LayoutError::Inconsistent();
      let failure = Err<u32, LayoutError>(error: inconsistent);
      return failure;
    }
  }
  let rank = boundary_rank(storage: storage, sequence: sequence, slot: before, visits: visits);
  sequence_reserve(sequence: sequence);
  let fresh = flow_index(at: storage^.payloads.inner.len);
  let missing = Flow::Close(block: no_index);
  slot_write::<Flow>(pages: &storage^.payloads, slot: fresh, span: sequence^.span, value: item, missing: missing);
  let yes = True();
  let links = SequenceCursor(left: no_index, right: no_index, parent: no_index, height: 1_u32, live: yes, own_events: output.events, total_events: output.events, total_count: output.count);
  let held_links = paged_push_item::<SequenceCursor>(cell: &storage^.links, value: links, ceiling: item_ceiling);
  let held_own = paged_push_item::<SequenceOutput>(cell: &storage^.own, value: output, ceiling: item_ceiling);
  let held_total = paged_push_item::<SequenceOutput>(cell: &storage^.total, value: output, ceiling: item_ceiling);
  let old_root = sequence^.root;
  let inserted = sequence_insert_at(storage: storage, sequence: sequence, root: old_root, rank: rank, added: fresh, parent: no_index, visits: visits);
  set sequence^.root = inserted;
  let success = Ok<u32, LayoutError>(value: fresh);
  return success;
}

fn sequence_extract_first(storage: &EntryStorage, sequence: &EntrySequence, root: u32, visits: &BoundaryVisits) -> (rest: u32, first: u32) reads(sequence.span), writes(storage), writes(visits) {
  doc "Detaches the first index node for AVL deletion without reading its payload or changing its stable slot.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: root, visits: visits);
  if held.left == no_index {
    sequence_parent(storage: storage, sequence: sequence, slot: held.right, parent: held.parent, visits: visits);
    return held.right, root;
  }
  let (remainder, first) = sequence_extract_first(storage: storage, sequence: sequence, root: held.left, visits: visits);
  set held.left = remainder;
  sequence_write(storage: storage, sequence: sequence, slot: root, node: held);
  let balanced = sequence_balance(storage: storage, sequence: sequence, slot: root, visits: visits);
  return balanced, first;
}

fn sequence_remove_at(storage: &EntryStorage, sequence: &EntrySequence, root: u32, rank: u64, visits: &BoundaryVisits) -> made: u32 reads(sequence.span), writes(storage), writes(visits) {
  doc "Removes one AVL leaf by rank, transplanting metadata links at a two-child node while leaving every other payload untouched.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: root, visits: visits);
  if held.live {
  } else {
    return no_index;
  }
  let left_node = boundary_node(storage: storage, sequence: sequence, slot: held.left, visits: visits);
  if rank < left_node.total_count {
    let remainder = sequence_remove_at(storage: storage, sequence: sequence, root: held.left, rank: rank, visits: visits);
    set held.left = remainder;
  } else if rank > left_node.total_count {
    let past_left = rank -sat left_node.total_count;
    let past_self = past_left -sat 1_u64;
    let remainder = sequence_remove_at(storage: storage, sequence: sequence, root: held.right, rank: past_self, visits: visits);
    set held.right = remainder;
  } else {
    let vacant = vacant_cursor();
    sequence_write(storage: storage, sequence: sequence, slot: root, node: vacant);
    if held.right == no_index {
      sequence_parent(storage: storage, sequence: sequence, slot: held.left, parent: held.parent, visits: visits);
      return held.left;
    }
    let (rest, successor) = sequence_extract_first(storage: storage, sequence: sequence, root: held.right, visits: visits);
    let replacement = boundary_node(storage: storage, sequence: sequence, slot: successor, visits: visits);
    set replacement.left = held.left;
    set replacement.right = rest;
    set replacement.parent = held.parent;
    sequence_parent(storage: storage, sequence: sequence, slot: held.left, parent: successor, visits: visits);
    sequence_parent(storage: storage, sequence: sequence, slot: rest, parent: successor, visits: visits);
    sequence_write(storage: storage, sequence: sequence, slot: successor, node: replacement);
    let balanced = sequence_balance(storage: storage, sequence: sequence, slot: successor, visits: visits);
    return balanced;
  }
  sequence_write(storage: storage, sequence: sequence, slot: root, node: held);
  let balanced = sequence_balance(storage: storage, sequence: sequence, slot: root, visits: visits);
  return balanced;
}

fn remove(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> result: unit reads(sequence.span), writes(storage), writes(sequence.root), writes(visits) {
  doc "Removes one stable slot, leaving its payload page as a hole. Removing a range repeats this operation over the removed handles; unrelated payloads are untouched.";
  let held = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  if held.live {
    let rank = boundary_rank(storage: storage, sequence: sequence, slot: slot, visits: visits);
    let old_root = sequence^.root;
    let remainder = sequence_remove_at(storage: storage, sequence: sequence, root: old_root, rank: rank, visits: visits);
    set sequence^.root = remainder;
  }
  return unit;
}

fn prefix_output(storage: &EntryStorage, sequence: &EntrySequence, before: u32) -> made: SequenceOutput reads(storage), reads(sequence.root), reads(sequence.span) {
  doc "Composes only cached index outputs before a stable entry. No preceding payload leaf is opened.";
  if before == no_index {
    let output = sequence_output(storage: storage, sequence: sequence);
    return output;
  }
  let current = sequence_node(storage: storage, sequence: sequence, slot: before);
  if current.live {
  } else {
    let empty = empty_output();
    return empty;
  }
  let total_field = False();
  let own_field = True();
  let prefix = slot_output(storage: storage, slot: current.left, span: sequence^.span, own: total_field);
  let cursor = before;
  let ancestor = current.parent;
  for (level in 0_u64..64_u64) {
    let parent_node = sequence_node(storage: storage, sequence: sequence, slot: ancestor);
    if parent_node.live {
    } else {
      return prefix;
    }
    if parent_node.right == cursor {
      let preceding = slot_output(storage: storage, slot: parent_node.left, span: sequence^.span, own: total_field);
      let parent_output = slot_output(storage: storage, slot: ancestor, span: sequence^.span, own: own_field);
      let parent_prefix = join_output(left: &preceding, right: &parent_output);
      let joined = join_output(left: &parent_prefix, right: &prefix);
      set prefix = joined;
    }
    set cursor = ancestor;
    set ancestor = parent_node.parent;
  }
  return prefix;
}

fn sequence_select(storage: &EntryStorage, sequence: &EntrySequence, event: u64) -> (slot: u32, offset: u64) reads(storage), reads(sequence.root), reads(sequence.span) {
  doc "Selects a direct entry by its virtual event weight in logarithmic index work, skipping cached subtree spans.";
  let cursor = sequence^.root;
  let remaining = event;
  for (level in 0_u64..64_u64) {
    let held = sequence_node(storage: storage, sequence: sequence, slot: cursor);
    if held.live {
    } else {
      return no_index, 0_u64;
    }
    let left_node = sequence_node(storage: storage, sequence: sequence, slot: held.left);
    if remaining < left_node.total_events {
      set cursor = held.left;
    } else {
      set remaining = remaining -sat left_node.total_events;
      if remaining < held.own_events {
        return cursor, remaining;
      }
      set remaining = remaining -sat held.own_events;
      set cursor = held.right;
    }
  }
  return no_index, 0_u64;
}

fn block_snapshot(block: &Block) -> made: BlockSnapshot reads(block) {
  doc "Copies only the reference walker geometry/style fields, leaving nested entry ownership in place.";
  let snapshot = BlockSnapshot(style: block^.style, x: block^.x, y: block^.y, dx: block^.dx, dy: block^.dy, normal_x: block^.normal_x, normal_y: block^.normal_y, resolved_x: block^.resolved_x, resolved_y: block^.resolved_y, width: block^.width, height: block^.height, marker: block^.marker, parent: block^.parent, flow_at: block^.flow_at, inner_x: block^.inner_x, held_y: block^.held_y, avail_left: block^.avail_left, avail_width: block^.avail_width, content_left: block^.content_left, content_width: block^.content_width);
  return snapshot;
}

fn flow_length(context: &Context) -> count: u64 reads(context.storage), reads(context.entries.root), reads(context.entries.span) {
  doc "The number of virtual Open/Close/Text/Child/Float/Out events, read from the synthetic root's cached summary without constructing a stream.";
  let output = sequence_node(storage: &context^.storage, sequence: &context^.entries, slot: context^.entries.root);
  return output.total_events;
}

fn nested_event(context: &Context, sequence: &EntrySequence, at: u64) -> made: Flow reads(context), reads(sequence) {
  doc "Random access through local weighted indexes. Descending a lexical block preserves the caller's BFC exclusion state; a Close is synthesized after its nested entries.";
  let (slot, offset) = sequence_select(storage: &context^.storage, sequence: sequence, event: at);
  let item = sequence_payload(storage: &context^.storage, sequence: sequence, slot: slot);
  match item {
    Open(block: child) => {
      if offset == 0_u64 {
        return item;
      }
      let child_at = cvt::<u32, u64>(child);
      if child_at < context^.blocks.inner.len {
        let inside = sequence_node(storage: &context^.storage, sequence: &context^.blocks.inner[child_at].entries, slot: context^.blocks.inner[child_at].entries.root);
        let close_at = inside.total_events +sat 1_u64;
        if offset == close_at {
          let close = Flow::Close(block: child);
          return close;
        }
        let local_at = offset - 1_u64;
        let nested = nested_event(context: context, sequence: &context^.blocks.inner[child_at].entries, at: local_at);
        return nested;
      }
      let missing = Flow::Close(block: no_index);
      return missing;
    }
    Close(..) => {
      return item;
    }
    Text(..) => {
      return item;
    }
    Child(..) => {
      return item;
    }
    Float(..) => {
      return item;
    }
    Out(..) => {
      return item;
    }
  }
}

fn flow_event(context: &Context, at: u64) -> made: Flow reads(context) {
  doc "The compatibility iterator's event at a temporary rank. Used only for isolated lookups; rank walks borrow the event slice owned by their pass.";
  let item = nested_event(context: context, sequence: &context^.entries, at: at);
  return item;
}

fn building_flow_length(context: &Context) -> count: u64 reads(context.entries.pending_events), reads(context.blocks.inner), reads(context.build_owner) {
  doc "Sums completed event spans in the pending lists on the open owner chain; no AVL or context-wide counter participates in construction.";
  let total = context^.entries.pending_events;
  let owner = context^.build_owner;
  let limit = context^.blocks.inner.len;
  for (level in 0_u64..limit) {
    let at = cvt::<u32, u64>(owner);
    if at < context^.blocks.inner.len {
      set total = total +sat context^.blocks.inner[at].entries.pending_events;
      set owner = context^.blocks.inner[at].parent;
    } else {
      return total;
    }
  }
  return total;
}

fn owner_insert(context: &Context, owner: u32, item: Flow) -> result: Result<u32, LayoutError> writes(context.entries.pending), writes(context.entries.pending_events), writes(context.blocks.inner) {
  doc "Appends to one owner's plain construction list. Source order assigns stable local slots; incremental insertion uses insert_before instead.";
  if owner == no_index {
    let inserted = pending_append(sequence: &context^.entries, item: item);
    return inserted;
  }
  let at = cvt::<u32, u64>(owner);
  if at < context^.blocks.inner.len {
    let inserted = pending_append(sequence: &context^.blocks.inner[at].entries, item: item);
    return inserted;
  }
  let inconsistent = LayoutError::Inconsistent();
  let failure = Err<u32, LayoutError>(error: inconsistent);
  return failure;
}

fn append_flow(context: &Context, item: Flow) -> result: Result<unit, LayoutError> writes(context.entries), writes(context.blocks.inner), writes(context.paragraphs.inner), writes(context.children.inner), writes(context.build_owner) {
  doc "Builds pending direct-entry lists. Close publishes only its completed event weight into the pending parent; sealing waits until the ordered builder finishes. Float remains a context-owned child in the enclosing BFC.";
  match item {
    Close(block: closed) => {
      let closed_at = cvt::<u32, u64>(closed);
      if closed_at < context^.blocks.inner.len {
        let inside = context^.blocks.inner[closed_at].entries.pending_events;
        let events = inside +sat 2_u64;
        let parent = context^.blocks.inner[closed_at].parent;
        let slot = context^.blocks.inner[closed_at].entry_slot;
        set context^.blocks.inner[closed_at].boundary.count = 1_u64;
        set context^.blocks.inner[closed_at].boundary.events = events;
        set context^.blocks.inner[closed_at].boundary.ordinary = False();
        set context^.build_owner = parent;
        if parent == no_index {
          pending_close(sequence: &context^.entries, slot: slot, events: events);
        } else {
          let parent_at = cvt::<u32, u64>(parent);
          if parent_at < context^.blocks.inner.len {
            pending_close(sequence: &context^.blocks.inner[parent_at].entries, slot: slot, events: events);
          }
        }
      }
      let success = Ok<unit, LayoutError>(value: unit);
      return success;
    }
    Open(..) => {
    }
    Text(..) => {
    }
    Child(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  let owner = context^.build_owner;
  let slot = propagate owner_insert(context: context, owner: owner, item: item);
  match item {
    Open(block: opened) => {
      let opened_at = cvt::<u32, u64>(opened);
      if opened_at < context^.blocks.inner.len {
        set context^.blocks.inner[opened_at].parent = owner;
        set context^.blocks.inner[opened_at].entry_slot = slot;
        set context^.build_owner = opened;
      }
    }
    Text(paragraph: paragraph_slot) => {
      let paragraph_at = cvt::<u32, u64>(paragraph_slot);
      if paragraph_at < context^.paragraphs.inner.len {
        set context^.paragraphs.inner[paragraph_at].block = owner;
        set context^.paragraphs.inner[paragraph_at].entry_slot = slot;
      }
    }
    Child(context: child) => {
      record_child_entry(context: context, child: child, owner: owner, slot: slot);
    }
    Float(context: floated) => {
      record_child_entry(context: context, child: floated, owner: owner, slot: slot);
    }
    Out(context: positioned) => {
      record_child_entry(context: context, child: positioned, owner: owner, slot: slot);
    }
    Close(..) => {
    }
  }
  let success = Ok<unit, LayoutError>(value: unit);
  return success;
}

fn record_child_entry(context: &Context, child: u32, owner: u32, slot: u32) -> result: unit writes(context.children.inner) {
  doc "Records the stable geometric-owner entry of a non-atomic child without changing its independent formatting-context ownership.";
  let at = cvt::<u32, u64>(child);
  if at < context^.children.inner.len {
    set context^.children.inner[at].block = owner;
    set context^.children.inner[at].entry_slot = slot;
  }
  return unit;
}

fn pending_count(sequence: &EntrySequence) -> count: u64 reads(sequence.pending) {
  doc "Reads an unfinished owner's direct entry count without visiting payloads.";
  match sequence^.pending {
    None() => {
      return 0_u64;
    }
    Some(value: pending) => {
      return pending^.inner.len;
    }
  }
}

fn seal_owner(storage: &EntryStorage, sequence: &EntrySequence) -> result: unit writes(storage.links), writes(storage.payloads), writes(sequence) {
  doc "Borrows an owner's assigned contiguous initial range for median sealing.";
  let base = cvt::<u32, u64>(sequence^.base);
  let count = cvt::<u32, u64>(sequence^.allocated);
  let end = base +sat count;
  if base <= end {
    if end <= storage^.links.inner.len {
      if end <= storage^.payloads.inner.len {
        finish_sequence(sequence: sequence, nodes: &storage^.links.inner[base..end], payloads: &storage^.payloads.inner[base..end]);
      }
    }
  }
  return unit;
}

fn initial_slot(bases: &[u32], owner: u32, slot: u32) -> made: u32 reads(bases) {
  doc "Converts a construction-local entry slot to its owner's final context pool range.";
  if slot == no_index {
    return no_index;
  }
  if owner == no_index {
    return slot;
  }
  let at = cvt::<u32, u64>(owner);
  if at < bases^.len {
    return bases^[at] +sat slot;
  }
  return no_index;
}

fn seal_context_entries(context: &Context) -> result: unit writes(context) {
  doc "Assigns prefix ranges once, seals the owner AVL trees, and publishes global stable entry handles by flat payload slot.";
  let total = pending_count(sequence: &context^.entries);
  let root_count = flow_index(at: total);
  set context^.entries.allocated = root_count;
  let blocks = context^.blocks.inner.len;
  let bases = box_array_filled::<u32>(count: blocks, value: 0_u32);
  for (s in 0_u64..blocks) {
    let base = flow_index(at: total);
    let count = pending_count(sequence: &context^.blocks.inner[s].entries);
    let allocated = flow_index(at: count);
    set bases.inner[s] = base;
    set context^.blocks.inner[s].entries.base = base;
    set context^.blocks.inner[s].entries.allocated = allocated;
    set total = total +sat count;
  }
  let storage = new_entry_storage(count: total);
  set context^.storage = move storage;
  seal_owner(storage: &context^.storage, sequence: &context^.entries);
  for (s in 0_u64..blocks) {
    if s < context^.blocks.inner.len {
      seal_owner(storage: &context^.storage, sequence: &context^.blocks.inner[s].entries);
    }
  }
  for (s in 0_u64..blocks) {
    if s < context^.blocks.inner.len {
      let slot = initial_slot(bases: &bases.inner[0_u64..blocks], owner: context^.blocks.inner[s].parent, slot: context^.blocks.inner[s].entry_slot);
      set context^.blocks.inner[s].entry_slot = slot;
    }
  }
  for (s in 0_u64..context^.paragraphs.inner.len) {
    let slot = initial_slot(bases: &bases.inner[0_u64..blocks], owner: context^.paragraphs.inner[s].block, slot: context^.paragraphs.inner[s].entry_slot);
    set context^.paragraphs.inner[s].entry_slot = slot;
  }
  for (s in 0_u64..context^.children.inner.len) {
    let slot = initial_slot(bases: &bases.inner[0_u64..blocks], owner: context^.children.inner[s].block, slot: context^.children.inner[s].entry_slot);
    set context^.children.inner[s].entry_slot = slot;
  }
  return unit;
}

fn publish_entry_pool<T: copy>(target: &Box<Paged<T>>, source: &Box<Paged<T>>, missing: T) -> result: unit reads(source), writes(target) {
  doc "Reserves append-only destination slots then publishes private values in one flat run.";
  let base = target^.inner.len;
  let count = source^.inner.len;
  for (s in 0_u64..count) {
    let kept = paged_push_item::<T>(cell: target, value: missing, ceiling: item_ceiling);
  }
  let end = base +sat count;
  if base <= end {
    if end <= target^.inner.len {
      publish_entry_run::<T>(target: &target^.inner[base..end], source: &source^.inner[0_u64..count]);
    }
  }
  return unit;
}

fn publish_entry_run<T: copy>(target: &Run<T>, source: &Run<T>) -> result: unit reads(source), writes(target) {
  doc "Publishes one private field group through disjoint flat slots.";
  for (s in 0_u64..target^.len) {
    if s < source^.len {
      set target^[s] = source^[s];
    }
  }
  return unit;
}

fn publish_entry_storage(target: &EntryStorage, source: &EntryStorage) -> result: unit reads(source), writes(target) {
  doc "Appends private entry field groups without moving any retained entry.";
  let missing = Flow::Close(block: no_index);
  let cursor = vacant_cursor();
  let output = empty_output();
  publish_entry_pool::<Flow>(target: &target^.payloads, source: &source^.payloads, missing: missing);
  publish_entry_pool::<SequenceCursor>(target: &target^.links, source: &source^.links, missing: cursor);
  publish_entry_pool::<SequenceOutput>(target: &target^.own, source: &source^.own, missing: output);
  publish_entry_pool::<SequenceOutput>(target: &target^.total, source: &source^.total, missing: output);
  return unit;
}
