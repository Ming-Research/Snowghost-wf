fn absent_handle() -> made: EntryHandle pure {
  doc "The absent line or entry handle.";
  let absent = EntryHandle(owner: no_index, slot: no_index);
  return absent;
}

fn empty_output() -> made: SequenceOutput pure {
  doc "The identity Through transfer, with no line or float handles.";
  let absent = absent_handle();
  let yes = True();
  let empty = SequenceOutput(count: 0_u64, events: 0_u64, fragment_sources: 0_u64, fragment_first: 0_u8, fragment_last: 0_u8, first_line: absent, last_line: absent, ordinary: yes, free_transfer: yes, through: yes, leading_positive: 0_i32, leading_negative: 0_i32, advance: 0_i64, trailing_positive: 0_i32, trailing_negative: 0_i32, first_baseline: 0_i64, last_baseline: 0_i64, travel: 0_i64, min_content: 0_i32, max_content: 0_i32, floats: 0_u64, first_float: absent, last_float: absent, barriers: 0_u32, natural_floor: 9223372036854775807_i64, float_reach: -9223372036854775807_i64, motion_known: yes, placed: 0_u64, opens: 0_u64, positioned: 0_u64);
  return empty;
}

fn pending_output(events: u64) -> made: SequenceOutput pure {
  doc "One entry whose event span is known and whose semantic margin/line output still needs layout.";
  let pending = empty_output();
  set pending.count = 1_u64;
  set pending.events = events;
  let no = False();
  set pending.ordinary = no;
  set pending.free_transfer = no;
  return pending;
}

fn join_output(left: &SequenceOutput, right: &SequenceOutput) -> made: SequenceOutput reads(left), reads(right) {
  doc "Composes Through/Through, Through/Solid, Solid/Through and Solid/Solid in document order. Only unsaturated ordinary transfers may drive placement; structural, baseline and float metadata remain available for unsupported runs.";
  if left^.count == 0_u64 {
    return right^;
  }
  if right^.count == 0_u64 {
    return left^;
  }
  let joined = empty_output();
  set joined.count = left^.count +sat right^.count;
  set joined.events = left^.events +sat right^.events;
  set joined.fragment_sources = left^.fragment_sources +sat right^.fragment_sources;
  let fragment_first = if left^.fragment_first != 0_u8 {
    give left^.fragment_first;
  } else {
    give right^.fragment_first;
  }
  let fragment_last = if right^.fragment_last != 0_u8 {
    give right^.fragment_last;
  } else {
    give left^.fragment_last;
  }
  set joined.fragment_first = fragment_first;
  set joined.fragment_last = fragment_last;
  let first_line = if left^.first_line.slot != no_index {
    give left^.first_line;
  } else {
    give right^.first_line;
  }
  set joined.first_line = first_line;
  let last_line = if right^.last_line.slot != no_index {
    give right^.last_line;
  } else {
    give left^.last_line;
  }
  set joined.last_line = last_line;
  let composed_1 = band(left^.ordinary, right^.ordinary);
  set joined.ordinary = composed_1;
  let free_transfer = band(left^.free_transfer, right^.free_transfer);
  set joined.free_transfer = free_transfer;
  let composed_2 = band(left^.through, right^.through);
  set joined.through = composed_2;
  set joined.leading_positive = left^.leading_positive;
  set joined.leading_negative = left^.leading_negative;
  set joined.trailing_positive = right^.trailing_positive;
  set joined.trailing_negative = right^.trailing_negative;
  let displacement = 0_i64;
  if left^.through {
    let composed_3 = imax(left^.leading_positive, right^.leading_positive);
    set joined.leading_positive = composed_3;
    let composed_4 = imin(left^.leading_negative, right^.leading_negative);
    set joined.leading_negative = composed_4;
    set joined.advance = right^.advance;
  } else if right^.through {
    set joined.advance = left^.advance;
    let composed_5 = imax(left^.trailing_positive, right^.leading_positive);
    set joined.trailing_positive = composed_5;
    let composed_6 = imin(left^.trailing_negative, right^.leading_negative);
    set joined.trailing_negative = composed_6;
  } else {
    let positive = imax(left^.trailing_positive, right^.leading_positive);
    let negative = imin(left^.trailing_negative, right^.leading_negative);
    let wide_positive = cvt::<i32, i64>(positive);
    let wide_negative = cvt::<i32, i64>(negative);
    let gap = wide_positive +sat wide_negative;
    set displacement = left^.advance +sat gap;
    set joined.advance = displacement +sat right^.advance;
  }
  let first_offset = if left^.first_line.slot != no_index {
    give left^.first_baseline;
  } else if right^.first_line.slot != no_index {
    give displacement +sat right^.first_baseline;
  } else {
    give 0_i64;
  }
  let last_offset = if right^.last_line.slot != no_index {
    give displacement +sat right^.last_baseline;
  } else if left^.last_line.slot != no_index {
    give left^.last_baseline;
  } else {
    give 0_i64;
  }
  set joined.first_baseline = first_offset;
  set joined.last_baseline = last_offset;
  set joined.travel = left^.travel +sat right^.travel;
  let lowest = imin(left^.natural_floor, right^.natural_floor);
  set joined.natural_floor = lowest;
  let reach = imax(left^.float_reach, right^.float_reach);
  set joined.float_reach = reach;
  let motion_known = band(left^.motion_known, right^.motion_known);
  set joined.motion_known = motion_known;
  let bounded = transfer_fits(origin: 0_i64, travel: joined.travel);
  if bounded {
  } else {
    set joined.ordinary = False();
  }
  let composed_7 = imax(left^.min_content, right^.min_content);
  set joined.min_content = composed_7;
  let composed_8 = imax(left^.max_content, right^.max_content);
  set joined.max_content = composed_8;
  set joined.floats = left^.floats +sat right^.floats;
  set joined.placed = left^.placed +sat right^.placed;
  set joined.opens = left^.opens +sat right^.opens;
  set joined.positioned = left^.positioned +sat right^.positioned;
  let first_export = if left^.first_float.slot != no_index {
    give left^.first_float;
  } else {
    give right^.first_float;
  }
  let last_export = if right^.last_float.slot != no_index {
    give right^.last_float;
  } else {
    give left^.last_float;
  }
  set joined.first_float = first_export;
  set joined.last_float = last_export;
  let composed_9 = imax(left^.barriers, right^.barriers);
  set joined.barriers = composed_9;
  return joined;
}

fn vacant_cursor() -> made: SequenceCursor pure {
  doc "The absent topology and weights, without constructing a semantic transfer.";
  let no = False();
  let vacant = SequenceCursor(left: no_index, right: no_index, parent: no_index, height: 0_u32, live: no, own_events: 0_u64, total_events: 0_u64, total_count: 0_u64);
  return vacant;
}

fn vacant_node() -> made: SequenceNode pure {
  doc "The initial page value; live construction cells keep pending transfers until reference publication.";
  let links = vacant_cursor();
  let pending = pending_output(events: 0_u64);
  let actions = identity_actions();
  let vacant = SequenceNode(links: links, own: pending, total: pending, actions: actions);
  return vacant;
}

fn new_sequence() -> made: EntrySequence pure {
  doc "An empty owner-local sequence allocates no payload or index pages.";
  let payloads = SlotPages<Flow>::Vacant();
  let nodes = SlotPages<SequenceNode>::Vacant();
  let pending = None<Box<Slots<PendingEntry>>>();
  let no = False();
  let sequence = EntrySequence(range_actions: no, payloads: move payloads, nodes: move nodes, root: no_index, allocated: 0_u32, span: 4_u32, pending: move pending, pending_events: 0_u64);
  return move sequence;
}

fn slot_cursor(pages: &SlotPages<SequenceNode>, slot: u32, span: u32) -> made: SequenceCursor reads(pages) {
  doc "Reads only links, liveness and event weights at a metadata leaf; recursive directory returns never copy a SequenceNode.";
  let missing = vacant_cursor();
  if slot >= span {
    return missing;
  }
  match pages^ {
    Vacant() => {
      return missing;
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        let made = page^.inner[at].links;
        return made;
      }
      return missing;
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        let earlier = slot_cursor(pages: &left_page^.inner, slot: slot, span: half);
        return earlier;
      }
      let later = slot - half;
      let following = slot_cursor(pages: &right_page^.inner, slot: later, span: half);
      return following;
    }
  }
}

fn sequence_node(sequence: &EntrySequence, slot: u32) -> made: SequenceCursor reads(sequence.nodes), reads(sequence.span) {
  doc "The event walk's small metadata read, independent of payload and semantic boundary fields.";
  let made = slot_cursor(pages: &sequence^.nodes, slot: slot, span: sequence^.span);
  return made;
}

fn fill_flow(context: &Context, sequence: &EntrySequence, root: u32, destination: &[Flow]) -> result: unit reads(context), reads(sequence), writes(destination) {
  doc "Fills disjoint left, own and right event ranges from cached weights. An Open fills its nested range and synthesizes its Close; siblings share no destination writes.";
  let held = sequence_node(sequence: sequence, slot: root);
  if held.live {
  } else {
    return unit;
  }
  let left = sequence_node(sequence: sequence, slot: held.left);
  let before = left.total_events;
  let after = before +sat held.own_events;
  let count = destination^.len;
  if before >= after {
    return unit;
  }
  if after > count {
    return unit;
  }
  fill_flow(context: context, sequence: sequence, root: held.left, destination: &destination^[0_u64..before]);
  let missing = Flow::Close(block: no_index);
  let item = slot_read::<Flow>(pages: &sequence^.payloads, slot: root, span: sequence^.span, missing: missing);
  set destination^[before] = item;
  match item {
    Open(block: child) => {
      let child_at = cvt::<u32, u64>(child);
      let inside_start = before + 1_u64;
      let inside_end = after - 1_u64;
      if inside_start <= inside_end {
        if child_at < context^.blocks.inner.len {
          let nested = &context^.blocks.inner[child_at].entries;
          fill_flow(context: context, sequence: nested, root: nested^.root, destination: &destination^[inside_start..inside_end]);
          let close = Flow::Close(block: child);
          set destination^[inside_end] = close;
        }
      }
    }
    Close(..) => {
    }
    Text(..) => {
    }
    Child(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  fill_flow(context: context, sequence: sequence, root: held.right, destination: &destination^[after..count]);
  return unit;
}

fn materialize_flow(context: &Context) -> made: Box<Array<Flow>> reads(context) {
  doc "Makes one immutable event array for a context pass. Filled Array construction avoids a Slots length-update chain; walkers borrow its slice until the pass ends.";
  let count = flow_length(context: context);
  let missing = Flow::Close(block: no_index);
  let events = box_array_filled::<Flow>(count: count, value: missing);
  fill_flow(context: context, sequence: &context^.entries, root: context^.entries.root, destination: &events.inner[0_u64..count]);
  return move events;
}

fn bulk_nodes(pending: &[PendingEntry], nodes: &[SequenceNode], base: u64, parent: u32) -> (root: u32, height: u32, events: u64) reads(pending), writes(nodes) {
  doc "Builds topology and event weights directly in final node storage. Median halves write disjoint slices; the parent waits only for their heights and event spans.";
  let count = pending^.len;
  if count == 0_u64 {
    return no_index, 0_u32, 0_u64;
  }
  if count != nodes^.len {
    return no_index, 0_u32, 0_u64;
  }
  let middle = count / 2_u64;
  if middle >= count {
    return no_index, 0_u32, 0_u64;
  }
  let slot_at = base +sat middle;
  let slot = flow_index(at: slot_at);
  let following = middle + 1_u64;
  let right_base = slot_at +sat 1_u64;
  let (left, left_height, left_events) = bulk_nodes(pending: &pending^[0_u64..middle], nodes: &nodes^[0_u64..middle], base: base, parent: slot);
  let (right, right_height, right_events) = bulk_nodes(pending: &pending^[following..count], nodes: &nodes^[following..count], base: right_base, parent: slot);
  let own_events = pending^[middle].events;
  let prefix = left_events +sat own_events;
  let total_events = prefix +sat right_events;
  let taller = imax(left_height, right_height);
  let height = taller +sat 1_u32;
  let yes = True();
  let node = SequenceCursor(left: left, right: right, parent: parent, height: height, live: yes, own_events: own_events, total_events: total_events, total_count: count);
  if middle < nodes^.len {
    set nodes^[middle].links = node;
  }
  return slot, height, total_events;
}

fn finish_sequence(sequence: &EntrySequence) -> result: unit writes(sequence) {
  doc "Publishes a pending list into two owner-sized pages and builds topology directly in the final index page, then releases pending scratch. Initial capacity is a power of two; later directory growth wraps this immutable-capacity leaf without copying it.";
  match sequence^.pending {
    None() => {
      return unit;
    }
    Some(value: pending) => {
      let count = pending^.inner.len;
      if count == 0_u64 {
        return unit;
      }
      let span = 4_u32;
      for (level in 0_u64..28_u64) {
        let width = cvt::<u32, u64>(span);
        if count <= width {
          break;
        }
        set span = span +sat span;
      }
      let page_width = cvt::<u32, u64>(span);
      let missing_node = vacant_node();
      let nodes = box_array_filled::<SequenceNode>(count: page_width, value: missing_node);
      let missing_payload = Flow::Close(block: no_index);
      let payloads = box_array_filled::<Flow>(count: page_width, value: missing_payload);
      if count > nodes.inner.len {
        return unit;
      }
      let (root, height, events) = bulk_nodes(pending: &pending^.inner[0_u64..count], nodes: &nodes.inner[0_u64..count], base: 0_u64, parent: no_index);
      for (at in 0_u64..count) {
        if at < pending^.inner.len {
          if at < payloads.inner.len {
            set payloads.inner[at] = pending^.inner[at].item;
          }
        }
      }
      let payload_pages = SlotPages<Flow>::Page(values: move payloads);
      let node_pages = SlotPages<SequenceNode>::Page(values: move nodes);
      set sequence^.nodes = move node_pages;
      set sequence^.payloads = move payload_pages;
      set sequence^.root = root;
      let allocated = flow_index(at: count);
      set sequence^.allocated = allocated;
      set sequence^.span = span;
    }
  }
  let empty_pending = None<Box<Slots<PendingEntry>>>();
  set sequence^.pending = move empty_pending;
  set sequence^.pending_events = 0_u64;
  return unit;
}

fn pending_append(sequence: &EntrySequence, item: Flow) -> result: Result<u32, LayoutError> writes(sequence.pending), writes(sequence.pending_events) {
  doc "Lazily allocates a builder list on its first direct entry, then grows geometrically; its pending index becomes its stable slot.";
  match sequence^.pending {
    None() => {
      let values = box_slots_new::<PendingEntry>(capacity: 4_u64);
      let started = Some<Box<Slots<PendingEntry>>>(value: move values);
      set sequence^.pending = move started;
    }
    Some(..) => {
    }
  }
  match sequence^.pending {
    Some(value: pending) => {
      let count = pending^.inner.len;
      let slot = flow_index(at: count);
      let added = PendingEntry(item: item, events: 1_u64);
      let kept = propagate push_or_fail::<PendingEntry>(cell: pending, value: added);
      set sequence^.pending_events = sequence^.pending_events +sat 1_u64;
      let success = Ok<u32, LayoutError>(value: slot);
      return success;
    }
    None() => {
      let inconsistent = LayoutError::Inconsistent();
      let failure = Err<u32, LayoutError>(error: inconsistent);
      return failure;
    }
  }
}

fn pending_close(sequence: &EntrySequence, slot: u32, events: u64) -> result: unit writes(sequence.pending), writes(sequence.pending_events) {
  doc "Replaces an Open's provisional single event with its completed nested span in the unfinished parent, without index repair.";
  let at = cvt::<u32, u64>(slot);
  match sequence^.pending {
    Some(value: pending) => {
      if at < pending^.inner.len {
        let previous = pending^.inner[at].events;
        set pending^.inner[at].events = events;
        let rest = sequence^.pending_events -sat previous;
        set sequence^.pending_events = rest +sat events;
      }
    }
    None() => {
    }
  }
  return unit;
}

fn sequence_reserve(sequence: &EntrySequence) -> result: unit reads(sequence.allocated), writes(sequence.nodes), writes(sequence.payloads), writes(sequence.span) {
  doc "Doubles the directory address space by wrapping its existing roots, without copying any payload or index page. The first small sequence allocates only one four-slot page per store.";
  if sequence^.allocated < sequence^.span {
    return unit;
  }
  if sequence^.span >= 1073741824_u32 {
    return unit;
  }
  let old_nodes = SlotPages<SequenceNode>::Vacant();
  let old_payloads = SlotPages<Flow>::Vacant();
  swap(first: &old_nodes, second: &sequence^.nodes);
  swap(first: &old_payloads, second: &sequence^.payloads);
  let right_nodes = SlotPages<SequenceNode>::Vacant();
  let right_payloads = SlotPages<Flow>::Vacant();
  let node_left = box_new::<SlotPages<SequenceNode>>(value: move old_nodes);
  let node_right = box_new::<SlotPages<SequenceNode>>(value: move right_nodes);
  let payload_left = box_new::<SlotPages<Flow>>(value: move old_payloads);
  let payload_right = box_new::<SlotPages<Flow>>(value: move right_payloads);
  let nodes = SlotPages<SequenceNode>::Fork(left: move node_left, right: move node_right);
  set sequence^.nodes = move nodes;
  let payloads = SlotPages<Flow>::Fork(left: move payload_left, right: move payload_right);
  set sequence^.payloads = move payloads;
  set sequence^.span = sequence^.span +sat sequence^.span;
  return unit;
}

fn later_handles(sequence: &EntrySequence, root: u32, skip: u64, owner: u32, handles: &Box<Slots<EntryHandle>>, visits: &BoundaryVisits) -> result: unit reads(sequence.nodes), reads(sequence.span), writes(handles), writes(visits) {
  doc "Visits only index subtrees intersecting a direct suffix and emits stable handles in order. The result is an immutable work list, not a retained alternate order index.";
  let held = boundary_node(sequence: sequence, slot: root, visits: visits);
  if held.live {
  } else {
    return unit;
  }
  if skip >= held.total_count {
    return unit;
  }
  let left_node = boundary_node(sequence: sequence, slot: held.left, visits: visits);
  if skip < left_node.total_count {
    later_handles(sequence: sequence, root: held.left, skip: skip, owner: owner, handles: handles, visits: visits);
  }
  if skip <= left_node.total_count {
    let handle = EntryHandle(owner: owner, slot: root);
    let kept = push_item::<EntryHandle>(cell: handles, value: handle, ceiling: item_ceiling);
    later_handles(sequence: sequence, root: held.right, skip: 0_u64, owner: owner, handles: handles, visits: visits);
  } else {
    let past_left = skip -sat left_node.total_count;
    let past_self = past_left -sat 1_u64;
    later_handles(sequence: sequence, root: held.right, skip: past_self, owner: owner, handles: handles, visits: visits);
  }
  return unit;
}

fn visit_later(sequence: &EntrySequence, after: u32, owner: u32) -> made: Box<Slots<EntryHandle>> reads(sequence.nodes), reads(sequence.root), reads(sequence.span) {
  doc "Returns the direct entries after a stable slot, never descending their block contents or reading the unchanged prefix payloads. Step 4 consumes these handles for independent sibling origins; this function performs no payload scatter.";
  let handles = box_slots_new::<EntryHandle>(capacity: 0_u64);
  let current = sequence_node(sequence: sequence, slot: after);
  if current.live {
    let rank = sequence_rank(sequence: sequence, slot: after);
    let start = rank +sat 1_u64;
    let visits = no_boundary_visits();
    later_handles(sequence: sequence, root: sequence^.root, skip: start, owner: owner, handles: &handles, visits: &visits);
  }
  return move handles;
}

fn slot_read<T: copy>(pages: &SlotPages<T>, slot: u32, span: u32, missing: T) -> value: T reads(pages) {
  doc "Reads one stable slot through a bounded directory path; absent pages return the supplied vacant value.";
  if slot >= span {
    return missing;
  }
  match pages^ {
    Vacant() => {
      return missing;
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        return page^.inner[at];
      }
      return missing;
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        let value = slot_read::<T>(pages: &left_page^.inner, slot: slot, span: half, missing: missing);
        return value;
      }
      let later = slot - half;
      let value = slot_read::<T>(pages: &right_page^.inner, slot: later, span: half, missing: missing);
      return value;
    }
  }
}

fn slot_write<T: copy>(pages: &SlotPages<T>, slot: u32, span: u32, value: T, missing: T) -> result: unit writes(pages) {
  doc "Allocates only a missing directory path and its four-slot page, then writes one slot. Existing payload pages never move.";
  if slot >= span {
    return unit;
  }
  match pages^ {
    Vacant() => {
      if span <= 4_u32 {
        let count = cvt::<u32, u64>(span);
        let values = box_array_filled::<T>(count: count, value: missing);
        let page = SlotPages<T>::Page(values: move values);
        set pages^ = move page;
      } else {
        let empty_left = SlotPages<T>::Vacant();
        let empty_right = SlotPages<T>::Vacant();
        let new_left = box_new::<SlotPages<T>>(value: move empty_left);
        let new_right = box_new::<SlotPages<T>>(value: move empty_right);
        let fork = SlotPages<T>::Fork(left: move new_left, right: move new_right);
        set pages^ = move fork;
      }
    }
    Fork(..) => {
    }
    Page(..) => {
    }
  }
  match pages^ {
    Vacant() => {
    }
    Page(values: stored_page) => {
      let at = cvt::<u32, u64>(slot);
      if at < stored_page^.inner.len {
        set stored_page^.inner[at] = value;
      }
    }
    Fork(left: stored_left, right: stored_right) => {
      let half = span / 2_u32;
      if slot < half {
        slot_write::<T>(pages: &stored_left^.inner, slot: slot, span: half, value: value, missing: missing);
      } else {
        let later = slot - half;
        slot_write::<T>(pages: &stored_right^.inner, slot: later, span: half, value: value, missing: missing);
      }
    }
  }
  return unit;
}

fn slot_links(pages: &SlotPages<SequenceNode>, slot: u32, span: u32, node: SequenceCursor) -> result: unit writes(pages) {
  doc "Writes an existing cell's topology only, including tombstoning; transfers never pass through this directory path.";
  if slot >= span {
    return unit;
  }
  match pages^ {
    Vacant() => {
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        set page^.inner[at].links = node;
      }
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        slot_links(pages: &left_page^.inner, slot: slot, span: half, node: node);
      } else {
        let later = slot - half;
        slot_links(pages: &right_page^.inner, slot: later, span: half, node: node);
      }
    }
  }
  return unit;
}

fn sequence_write(sequence: &EntrySequence, slot: u32, node: SequenceCursor) -> result: unit reads(sequence.span), writes(sequence.nodes) {
  doc "Writes one existing topology slot without copying outputs or accessing payload storage.";
  slot_links(pages: &sequence^.nodes, slot: slot, span: sequence^.span, node: node);
  return unit;
}

fn slot_output(pages: &SlotPages<SequenceNode>, slot: u32, span: u32, own: Bool) -> made: SequenceOutput reads(pages) {
  doc "Reads exactly one transfer at a live page leaf, taking its structural weights from topology during construction.";
  if slot < span {
    match pages^ {
      Vacant() => {
      }
      Page(values: page) => {
        let at = cvt::<u32, u64>(slot);
        if at < page^.inner.len {
          if page^.inner[at].links.live {
            let output = if own {
              give page^.inner[at].own;
            } else {
              give page^.inner[at].total;
            }
            if own {
              set output.count = 1_u64;
              set output.events = page^.inner[at].links.own_events;
            } else {
              set output.count = page^.inner[at].links.total_count;
              set output.events = page^.inner[at].links.total_events;
            }
            return output;
          }
        }
      }
      Fork(left: left_page, right: right_page) => {
        let half = span / 2_u32;
        if slot < half {
          let earlier = slot_output(pages: &left_page^.inner, slot: slot, span: half, own: own);
          return earlier;
        }
        let later = slot - half;
        let following = slot_output(pages: &right_page^.inner, slot: later, span: half, own: own);
        return following;
      }
    }
  }
  let empty = empty_output();
  return empty;
}

fn slot_store_output(pages: &SlotPages<SequenceNode>, slot: u32, span: u32, output: &SequenceOutput, own: Bool) -> result: unit reads(output), writes(pages) {
  doc "Writes one transfer and its weights in an existing live cell, without copying topology or the other transfer.";
  if slot >= span {
    return unit;
  }
  match pages^ {
    Vacant() => {
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        if page^.inner[at].links.live {
          if own {
            set page^.inner[at].own = output^;
            set page^.inner[at].links.own_events = output^.events;
          } else {
            set page^.inner[at].total = output^;
            set page^.inner[at].links.total_events = output^.events;
            set page^.inner[at].links.total_count = output^.count;
          }
        }
      }
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        slot_store_output(pages: &left_page^.inner, slot: slot, span: half, output: output, own: own);
      } else {
        let later = slot - half;
        slot_store_output(pages: &right_page^.inner, slot: later, span: half, output: output, own: own);
      }
    }
  }
  return unit;
}

fn sequence_output(sequence: &EntrySequence) -> made: SequenceOutput reads(sequence.nodes), reads(sequence.root), reads(sequence.span) {
  doc "Reads only the cached transfer at this owner's root.";
  let total = False();
  let output = slot_output(pages: &sequence^.nodes, slot: sequence^.root, span: sequence^.span, own: total);
  return output;
}

fn sequence_payload(sequence: &EntrySequence, slot: u32) -> made: Flow reads(sequence.nodes), reads(sequence.payloads), reads(sequence.span) {
  doc "Reads a live direct-entry payload; a removed or invalid handle yields an invalid Close event, never a reused payload.";
  let missing = Flow::Close(block: no_index);
  let held = sequence_node(sequence: sequence, slot: slot);
  if held.live {
    let payload = slot_read::<Flow>(pages: &sequence^.payloads, slot: slot, span: sequence^.span, missing: missing);
    return payload;
  }
  return missing;
}

fn sequence_parent(sequence: &EntrySequence, slot: u32, parent: u32, visits: &BoundaryVisits) -> result: unit reads(sequence.span), writes(sequence.nodes), writes(visits) {
  doc "Repairs the parent link of a live index node; empty links require no storage.";
  let held = boundary_node(sequence: sequence, slot: slot, visits: visits);
  if held.live {
    set held.parent = parent;
    sequence_write(sequence: sequence, slot: slot, node: held);
  }
  return unit;
}

fn sequence_repair(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> result: unit reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Repairs topology and reads only the three transfers needed to compose one AVL node, after distributing its pending range actions so its children's stored transfers are relative to it.";
  range_distribute(sequence: sequence, slot: slot, visits: visits);
  let held = boundary_node(sequence: sequence, slot: slot, visits: visits);
  if held.live {
    let left_node = boundary_node(sequence: sequence, slot: held.left, visits: visits);
    let right_node = boundary_node(sequence: sequence, slot: held.right, visits: visits);
    let own_field = True();
    let total_field = False();
    let left_output = boundary_output(sequence: sequence, slot: held.left, own: total_field, visits: visits);
    let right_output = boundary_output(sequence: sequence, slot: held.right, own: total_field, visits: visits);
    let own_output = boundary_output(sequence: sequence, slot: slot, own: own_field, visits: visits);
    let prefix = join_output(left: &left_output, right: &own_output);
    let total = join_output(left: &prefix, right: &right_output);
    let taller = imax(left_node.height, right_node.height);
    set held.height = taller +sat 1_u32;
    sequence_write(sequence: sequence, slot: slot, node: held);
    slot_store_output(pages: &sequence^.nodes, slot: slot, span: sequence^.span, output: &total, own: total_field);
  }
  return unit;
}

fn sequence_rotate_left(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> root: u32 reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Rotates metadata links left while preserving every stable payload slot and the order of entries.";
  range_distribute(sequence: sequence, slot: slot, visits: visits);
  let base = boundary_node(sequence: sequence, slot: slot, visits: visits);
  let pivot_slot = base.right;
  range_distribute(sequence: sequence, slot: pivot_slot, visits: visits);
  let pivot = boundary_node(sequence: sequence, slot: pivot_slot, visits: visits);
  if pivot.live {
    set base.right = pivot.left;
    sequence_parent(sequence: sequence, slot: pivot.left, parent: slot, visits: visits);
    set pivot.left = slot;
    set pivot.parent = base.parent;
    set base.parent = pivot_slot;
    sequence_write(sequence: sequence, slot: slot, node: base);
    sequence_write(sequence: sequence, slot: pivot_slot, node: pivot);
    sequence_repair(sequence: sequence, slot: slot, visits: visits);
    sequence_repair(sequence: sequence, slot: pivot_slot, visits: visits);
    return pivot_slot;
  }
  return slot;
}

fn sequence_rotate_right(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> root: u32 reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Rotates metadata links right without reading or moving payloads.";
  range_distribute(sequence: sequence, slot: slot, visits: visits);
  let base = boundary_node(sequence: sequence, slot: slot, visits: visits);
  let pivot_slot = base.left;
  range_distribute(sequence: sequence, slot: pivot_slot, visits: visits);
  let pivot = boundary_node(sequence: sequence, slot: pivot_slot, visits: visits);
  if pivot.live {
    set base.left = pivot.right;
    sequence_parent(sequence: sequence, slot: pivot.right, parent: slot, visits: visits);
    set pivot.right = slot;
    set pivot.parent = base.parent;
    set base.parent = pivot_slot;
    sequence_write(sequence: sequence, slot: slot, node: base);
    sequence_write(sequence: sequence, slot: pivot_slot, node: pivot);
    sequence_repair(sequence: sequence, slot: slot, visits: visits);
    sequence_repair(sequence: sequence, slot: pivot_slot, visits: visits);
    return pivot_slot;
  }
  return slot;
}

fn sequence_balance(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> root: u32 reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Repairs an AVL insertion/removal ancestor with at most two rotations.";
  sequence_repair(sequence: sequence, slot: slot, visits: visits);
  let held = boundary_node(sequence: sequence, slot: slot, visits: visits);
  let left_node = boundary_node(sequence: sequence, slot: held.left, visits: visits);
  let right_node = boundary_node(sequence: sequence, slot: held.right, visits: visits);
  let right_limit = right_node.height +sat 1_u32;
  if left_node.height > right_limit {
    let ll = boundary_node(sequence: sequence, slot: left_node.left, visits: visits);
    let lr = boundary_node(sequence: sequence, slot: left_node.right, visits: visits);
    if lr.height > ll.height {
      let rotated = sequence_rotate_left(sequence: sequence, slot: held.left, visits: visits);
      set held.left = rotated;
      sequence_write(sequence: sequence, slot: slot, node: held);
    }
    let rotated = sequence_rotate_right(sequence: sequence, slot: slot, visits: visits);
    return rotated;
  }
  let left_limit = left_node.height +sat 1_u32;
  if right_node.height > left_limit {
    let rl = boundary_node(sequence: sequence, slot: right_node.left, visits: visits);
    let rr = boundary_node(sequence: sequence, slot: right_node.right, visits: visits);
    if rl.height > rr.height {
      let rotated = sequence_rotate_right(sequence: sequence, slot: held.right, visits: visits);
      set held.right = rotated;
      sequence_write(sequence: sequence, slot: slot, node: held);
    }
    let rotated = sequence_rotate_left(sequence: sequence, slot: slot, visits: visits);
    return rotated;
  }
  return slot;
}

fn sequence_rank(sequence: &EntrySequence, slot: u32) -> rank: u64 reads(sequence.nodes), reads(sequence.root), reads(sequence.span) {
  doc "Returns a transient direct rank through the shared counted index descent.";
  let visits = no_boundary_visits();
  let rank = boundary_rank(sequence: sequence, slot: slot, visits: &visits);
  return rank;
}

fn sequence_insert_at(sequence: &EntrySequence, root: u32, rank: u64, added: u32, parent: u32, visits: &BoundaryVisits) -> made: u32 reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Inserts a previously allocated stable leaf into an AVL rank path; only index ancestors are visited. Each path node distributes its pending range actions first, so the new private payload inherits no movement that happened before its insertion.";
  range_distribute(sequence: sequence, slot: root, visits: visits);
  let held = boundary_node(sequence: sequence, slot: root, visits: visits);
  if held.live {
  } else {
    sequence_parent(sequence: sequence, slot: added, parent: parent, visits: visits);
    return added;
  }
  let left_node = boundary_node(sequence: sequence, slot: held.left, visits: visits);
  if rank <= left_node.total_count {
    let inserted = sequence_insert_at(sequence: sequence, root: held.left, rank: rank, added: added, parent: root, visits: visits);
    set held.left = inserted;
  } else {
    let after_left = rank -sat left_node.total_count;
    let after_self = after_left -sat 1_u64;
    let inserted = sequence_insert_at(sequence: sequence, root: held.right, rank: after_self, added: added, parent: root, visits: visits);
    set held.right = inserted;
  }
  sequence_write(sequence: sequence, slot: root, node: held);
  let balanced = sequence_balance(sequence: sequence, slot: root, visits: visits);
  return balanced;
}

fn insert_before(sequence: &EntrySequence, before: u32, item: Flow, output: SequenceOutput, visits: &BoundaryVisits) -> result: Result<u32, LayoutError> writes(sequence), writes(visits) {
  doc "Inserts one new direct entry before a live stable slot, or at end for no_index. A range is a batch of these operations in source order. Earlier payload slots are neither read nor copied.";
  if sequence^.allocated >= 1073741824_u32 {
    let failure = too_large::<u32>();
    return failure;
  }
  if before != no_index {
    let target = boundary_node(sequence: sequence, slot: before, visits: visits);
    if target.live {
    } else {
      let inconsistent = LayoutError::Inconsistent();
      let failure = Err<u32, LayoutError>(error: inconsistent);
      return failure;
    }
  }
  let rank = boundary_rank(sequence: sequence, slot: before, visits: visits);
  sequence_reserve(sequence: sequence);
  let fresh = sequence^.allocated;
  let missing = Flow::Close(block: no_index);
  slot_write::<Flow>(pages: &sequence^.payloads, slot: fresh, span: sequence^.span, value: item, missing: missing);
  let yes = True();
  let links = SequenceCursor(left: no_index, right: no_index, parent: no_index, height: 1_u32, live: yes, own_events: output.events, total_events: output.events, total_count: output.count);
  let actions = identity_actions();
  let node = SequenceNode(links: links, own: output, total: output, actions: actions);
  let missing_node = vacant_node();
  slot_write::<SequenceNode>(pages: &sequence^.nodes, slot: fresh, span: sequence^.span, value: node, missing: missing_node);
  let old_root = sequence^.root;
  let inserted = sequence_insert_at(sequence: sequence, root: old_root, rank: rank, added: fresh, parent: no_index, visits: visits);
  set sequence^.root = inserted;
  set sequence^.allocated = fresh + 1_u32;
  let success = Ok<u32, LayoutError>(value: fresh);
  return success;
}

fn sequence_extract_first(sequence: &EntrySequence, root: u32, visits: &BoundaryVisits) -> (rest: u32, first: u32) reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Detaches the first index node for AVL deletion without reading its payload or changing its stable slot. Path nodes distribute their pending actions first, so a transplanted successor carries its own effective action.";
  range_distribute(sequence: sequence, slot: root, visits: visits);
  let held = boundary_node(sequence: sequence, slot: root, visits: visits);
  if held.left == no_index {
    sequence_parent(sequence: sequence, slot: held.right, parent: held.parent, visits: visits);
    return held.right, root;
  }
  let (remainder, first) = sequence_extract_first(sequence: sequence, root: held.left, visits: visits);
  set held.left = remainder;
  sequence_write(sequence: sequence, slot: root, node: held);
  let balanced = sequence_balance(sequence: sequence, slot: root, visits: visits);
  return balanced, first;
}

fn sequence_remove_at(sequence: &EntrySequence, root: u32, rank: u64, visits: &BoundaryVisits) -> made: u32 reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(visits) {
  doc "Removes one AVL leaf by rank, transplanting metadata links at a two-child node while leaving every other payload untouched. Pending range actions are distributed along the path before membership changes; the removed slot's own action is retired with it.";
  range_distribute(sequence: sequence, slot: root, visits: visits);
  let held = boundary_node(sequence: sequence, slot: root, visits: visits);
  if held.live {
  } else {
    return no_index;
  }
  let left_node = boundary_node(sequence: sequence, slot: held.left, visits: visits);
  if rank < left_node.total_count {
    let remainder = sequence_remove_at(sequence: sequence, root: held.left, rank: rank, visits: visits);
    set held.left = remainder;
  } else if rank > left_node.total_count {
    let past_left = rank -sat left_node.total_count;
    let past_self = past_left -sat 1_u64;
    let remainder = sequence_remove_at(sequence: sequence, root: held.right, rank: past_self, visits: visits);
    set held.right = remainder;
  } else {
    let vacant = vacant_cursor();
    sequence_write(sequence: sequence, slot: root, node: vacant);
    if held.right == no_index {
      sequence_parent(sequence: sequence, slot: held.left, parent: held.parent, visits: visits);
      return held.left;
    }
    let (rest, successor) = sequence_extract_first(sequence: sequence, root: held.right, visits: visits);
    let replacement = boundary_node(sequence: sequence, slot: successor, visits: visits);
    set replacement.left = held.left;
    set replacement.right = rest;
    set replacement.parent = held.parent;
    sequence_parent(sequence: sequence, slot: held.left, parent: successor, visits: visits);
    sequence_parent(sequence: sequence, slot: rest, parent: successor, visits: visits);
    sequence_write(sequence: sequence, slot: successor, node: replacement);
    let balanced = sequence_balance(sequence: sequence, slot: successor, visits: visits);
    return balanced;
  }
  sequence_write(sequence: sequence, slot: root, node: held);
  let balanced = sequence_balance(sequence: sequence, slot: root, visits: visits);
  return balanced;
}

fn remove(sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> result: unit reads(sequence.span), reads(sequence.range_actions), writes(sequence.nodes), writes(sequence.root), writes(visits) {
  doc "Removes one stable slot, leaving its payload page as a hole. Removing a range repeats this operation over the removed handles; unrelated payloads are untouched.";
  let held = boundary_node(sequence: sequence, slot: slot, visits: visits);
  if held.live {
    let rank = boundary_rank(sequence: sequence, slot: slot, visits: visits);
    let old_root = sequence^.root;
    let remainder = sequence_remove_at(sequence: sequence, root: old_root, rank: rank, visits: visits);
    set sequence^.root = remainder;
  }
  return unit;
}

fn sequence_select(sequence: &EntrySequence, event: u64) -> (slot: u32, offset: u64) reads(sequence.nodes), reads(sequence.root), reads(sequence.span) {
  doc "Selects a direct entry by its virtual event weight in logarithmic index work, skipping cached subtree spans.";
  let cursor = sequence^.root;
  let remaining = event;
  for (level in 0_u64..64_u64) {
    let held = sequence_node(sequence: sequence, slot: cursor);
    if held.live {
    } else {
      return no_index, 0_u64;
    }
    let left_node = sequence_node(sequence: sequence, slot: held.left);
    if remaining < left_node.total_events {
      set cursor = held.left;
    } else {
      set remaining = remaining -sat left_node.total_events;
      if remaining < held.own_events {
        return cursor, remaining;
      }
      set remaining = remaining -sat held.own_events;
      set cursor = held.right;
    }
  }
  return no_index, 0_u64;
}

fn block_snapshot(block: &Block) -> made: BlockSnapshot reads(block) {
  doc "Copies only the reference walker geometry/style fields, leaving nested entry ownership in place.";
  let snapshot = BlockSnapshot(style: block^.style, x: block^.x, y: block^.y, dx: block^.dx, dy: block^.dy, normal_x: block^.normal_x, normal_y: block^.normal_y, resolved_x: block^.resolved_x, resolved_y: block^.resolved_y, width: block^.width, height: block^.height, marker: block^.marker, parent: block^.parent, flow_at: block^.flow_at, inner_x: block^.inner_x, held_y: block^.held_y, avail_left: block^.avail_left, avail_width: block^.avail_width, content_left: block^.content_left, content_width: block^.content_width);
  return snapshot;
}

fn flow_length(context: &Context) -> count: u64 reads(context.entries.nodes), reads(context.entries.root), reads(context.entries.span) {
  doc "The number of virtual Open/Close/Text/Child/Float/Out events, read from the synthetic root's cached summary without constructing a stream.";
  let output = sequence_node(sequence: &context^.entries, slot: context^.entries.root);
  return output.total_events;
}

fn nested_event(context: &Context, sequence: &EntrySequence, at: u64) -> made: Flow reads(context), reads(sequence) {
  doc "Random access through local weighted indexes. Descending a lexical block preserves the caller's BFC exclusion state; a Close is synthesized after its nested entries.";
  let (slot, offset) = sequence_select(sequence: sequence, event: at);
  let item = sequence_payload(sequence: sequence, slot: slot);
  match item {
    Open(block: child) => {
      if offset == 0_u64 {
        return item;
      }
      let child_at = cvt::<u32, u64>(child);
      if child_at < context^.blocks.inner.len {
        let inside = sequence_node(sequence: &context^.blocks.inner[child_at].entries, slot: context^.blocks.inner[child_at].entries.root);
        let close_at = inside.total_events +sat 1_u64;
        if offset == close_at {
          let close = Flow::Close(block: child);
          return close;
        }
        let local_at = offset - 1_u64;
        let nested = nested_event(context: context, sequence: &context^.blocks.inner[child_at].entries, at: local_at);
        return nested;
      }
      let missing = Flow::Close(block: no_index);
      return missing;
    }
    Close(..) => {
      return item;
    }
    Text(..) => {
      return item;
    }
    Child(..) => {
      return item;
    }
    Float(..) => {
      return item;
    }
    Out(..) => {
      return item;
    }
  }
}

fn flow_event(context: &Context, at: u64) -> made: Flow reads(context) {
  doc "The compatibility iterator's event at a temporary rank. Full rank walks borrow their pass-owned slice; bounded incremental walks may select retained events directly.";
  let item = nested_event(context: context, sequence: &context^.entries, at: at);
  return item;
}

fn building_flow_length(context: &Context) -> count: u64 reads(context.entries.pending_events), reads(context.blocks.inner), reads(context.build_owner) {
  doc "Sums completed event spans in the pending lists on the open owner chain; no AVL or context-wide counter participates in construction.";
  let total = context^.entries.pending_events;
  let owner = context^.build_owner;
  let limit = context^.blocks.inner.len;
  for (level in 0_u64..limit) {
    let at = cvt::<u32, u64>(owner);
    if at < context^.blocks.inner.len {
      set total = total +sat context^.blocks.inner[at].entries.pending_events;
      set owner = context^.blocks.inner[at].parent;
    } else {
      return total;
    }
  }
  return total;
}

fn owner_insert(context: &Context, owner: u32, item: Flow) -> result: Result<u32, LayoutError> writes(context.entries.pending), writes(context.entries.pending_events), writes(context.blocks.inner) {
  doc "Appends to one owner's plain construction list. Source order assigns stable local slots; incremental insertion uses insert_before instead.";
  if owner == no_index {
    let inserted = pending_append(sequence: &context^.entries, item: item);
    return inserted;
  }
  let at = cvt::<u32, u64>(owner);
  if at < context^.blocks.inner.len {
    let inserted = pending_append(sequence: &context^.blocks.inner[at].entries, item: item);
    return inserted;
  }
  let inconsistent = LayoutError::Inconsistent();
  let failure = Err<u32, LayoutError>(error: inconsistent);
  return failure;
}

fn append_flow(context: &Context, item: Flow) -> result: Result<unit, LayoutError> writes(context.entries), writes(context.blocks.inner), writes(context.paragraphs.inner), writes(context.children.inner), writes(context.build_owner), writes(context.split_topology_known) {
  doc "Builds pending direct-entry lists. Close publishes only its completed event weight into the pending parent; sealing waits until the ordered builder finishes. Float remains a context-owned child in the enclosing BFC.";
  set context^.split_topology_known = False();
  match item {
    Close(block: closed) => {
      let closed_at = cvt::<u32, u64>(closed);
      if closed_at < context^.blocks.inner.len {
        let inside = context^.blocks.inner[closed_at].entries.pending_events;
        let events = inside +sat 2_u64;
        let parent = context^.blocks.inner[closed_at].parent;
        let slot = context^.blocks.inner[closed_at].entry_slot;
        set context^.blocks.inner[closed_at].boundary.count = 1_u64;
        set context^.blocks.inner[closed_at].boundary.events = events;
        set context^.blocks.inner[closed_at].boundary.ordinary = False();
        set context^.build_owner = parent;
        if parent == no_index {
          pending_close(sequence: &context^.entries, slot: slot, events: events);
        } else {
          let parent_at = cvt::<u32, u64>(parent);
          if parent_at < context^.blocks.inner.len {
            pending_close(sequence: &context^.blocks.inner[parent_at].entries, slot: slot, events: events);
          }
        }
      }
      let success = Ok<unit, LayoutError>(value: unit);
      return success;
    }
    Open(..) => {
    }
    Text(..) => {
    }
    Child(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  let owner = context^.build_owner;
  let slot = propagate owner_insert(context: context, owner: owner, item: item);
  match item {
    Open(block: opened) => {
      let opened_at = cvt::<u32, u64>(opened);
      if opened_at < context^.blocks.inner.len {
        set context^.blocks.inner[opened_at].parent = owner;
        set context^.blocks.inner[opened_at].entry_slot = slot;
        set context^.build_owner = opened;
      }
    }
    Text(paragraph: paragraph_slot) => {
      let paragraph_at = cvt::<u32, u64>(paragraph_slot);
      if paragraph_at < context^.paragraphs.inner.len {
        set context^.paragraphs.inner[paragraph_at].block = owner;
        set context^.paragraphs.inner[paragraph_at].entry_slot = slot;
      }
    }
    Child(context: child) => {
      record_child_entry(context: context, child: child, owner: owner, slot: slot);
    }
    Float(context: floated) => {
      record_child_entry(context: context, child: floated, owner: owner, slot: slot);
    }
    Out(context: positioned) => {
      record_child_entry(context: context, child: positioned, owner: owner, slot: slot);
    }
    Close(..) => {
    }
  }
  let success = Ok<unit, LayoutError>(value: unit);
  return success;
}

fn record_child_entry(context: &Context, child: u32, owner: u32, slot: u32) -> result: unit writes(context.children.inner) {
  doc "Records the stable geometric-owner entry of a non-atomic child without changing its independent formatting-context ownership.";
  let at = cvt::<u32, u64>(child);
  if at < context^.children.inner.len {
    set context^.children.inner[at].block = owner;
    set context^.children.inner[at].entry_slot = slot;
  }
  return unit;
}

fn reference_length(context: &Context, events: &[Flow]) -> count: u64 reads(context.entries.nodes), reads(context.entries.root), reads(context.entries.span), reads(events) {
  doc "Reads a full pass's shared event slice length, or the retained virtual length for an incremental walk represented by an empty slice.";
  if events^.len > 0_u64 {
    return events^.len;
  }
  return flow_length(context: context);
}

fn reference_event(context: &Context, events: &[Flow], at: u64) -> made: Flow reads(context), reads(events) {
  doc "Reads a full pass's shared event slice or selects one bounded incremental event from retained owner indexes. An empty slice denotes the virtual view, not an absent flow.";
  if at < events^.len {
    return events^[at];
  }
  if events^.len == 0_u64 {
    return flow_event(context: context, at: at);
  }
  return Flow::Close(block: no_index);
}

fn reference_child_event(context: &Context, events: &[Flow], at: u64) -> made: Flow reads(context), reads(events) {
  doc "Classifies a recorded non-atomic child through its stable owner entry on virtual reference walks, avoiding a fresh root-to-rank descent for every candidate. Full passes retain their shared event slice; atomic or retired slots produce no matching child payload.";
  if at < context^.children.inner.len {
    if events^.len > 0_u64 {
      let rank = cvt::<u32, u64>(context^.children.inner[at].flow_at);
      let full_item = reference_event(context: context, events: events, at: rank);
      return full_item;
    }
    let owner = context^.children.inner[at].block;
    let slot = context^.children.inner[at].entry_slot;
    if owner == no_index {
      let root_item = sequence_payload(sequence: &context^.entries, slot: slot);
      return root_item;
    }
    let owner_at = cvt::<u32, u64>(owner);
    if owner_at < context^.blocks.inner.len {
      let nested_item = sequence_payload(sequence: &context^.blocks.inner[owner_at].entries, slot: slot);
      return nested_item;
    }
  }
  return Flow::Close(block: no_index);
}
