  let handle = propagate state.result;
  let published = propagate push_or_fail::<EntryHandle>(cell: &context^.block_routes, value: handle);
  set context^.build_owner = directory;
  let accepted = Ok<EntryHandle, LayoutError>(value: handle);
  return accepted;
}
