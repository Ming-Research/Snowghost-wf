fn route_table<T: copy>(count: u64, missing: T) -> made: RouteTable<T> pure contract {
  requires count <= 1073741824_u64;
} {
  doc "Allocates fixed pages for the initial records; subsequent growth moves only optional page pointers.";
  let span = 1073741824_u32;
  let pages = new_pages::<T>(count: count, missing: missing);
  let made = RouteTable<T>(pages: move pages, len: count, span: span, missing: missing);
  return move made;
}

fn route_read<T: copy>(table: &RouteTable<T>, at: u64) -> value: T reads(table) {
  doc "Reads a stable directory slot or its explicit missing value; no slot is reused.";
  if at >= table^.len {
    return table^.missing;
  }
  if at >= 1073741824_u64 {
    return table^.missing;
  }
  let slot = cvt::<u64, u32>(at);
  let value = slot_read::<T>(pages: &table^.pages, slot: slot, span: table^.span, missing: table^.missing);
  return value;
}

fn route_write<T: copy>(table: &RouteTable<T>, at: u64, value: T) -> result: unit writes(table) {
  doc "Publishes one preflighted record, allocating only its fixed page and directory pointers. The ceiling is checked before any splice publication.";
  if at >= 1073741824_u64 {
    return unit;
  }
  let slot = cvt::<u64, u32>(at);
  slot_write::<T>(pages: &table^.pages, slot: slot, span: table^.span, value: value, missing: table^.missing);
  let length = at +sat 1_u64;
  let high = imax(table^.len, length);
  set table^.len = high;
  return unit;
}

fn route_push<T: copy>(table: &RouteTable<T>, value: T) -> result: Result<unit, LayoutError> writes(table) {
  doc "Appends one directory record, refusing the storage ceiling before writing.";
  let at = table^.len;
  if at >= item_ceiling {
    return too_large::<unit>();
  }
  route_write::<T>(table: table, at: at, value: value);
  return Ok<unit, LayoutError>(value: unit);
}

fn absent_text_unit() -> made: TextUnit pure {
  doc "A tombstoned or unrecorded text source.";
  return TextUnit(serial: no_index, piece: 0_u32, count: 0_u32, paragraph: no_index);
}

fn absent_context_path() -> made: ContextPath pure {
  doc "A tombstoned context directory record.";
  let no = False();
  return ContextPath(live: no, parent: no_index, child: no_index);
}

fn absent_style_route() -> made: StyleRoute pure {
  doc "An unrecorded style use.";
  let no = False();
  return StyleRoute(serial: no_index, structural: no, block: no_index, paragraph: no_index, owner: no, next: no_index);
}
