alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;

fn splice_container_ready(context: &Context) -> ready: Bool reads(context) {
  doc "Admits a clean retained flex context whose input space has not changed before local publication. This does not predict its outputs or admit enclosing flow propagation; those consume the actual recomputed outputs and their own certificate.";
  if context^.kind != ctx_flex {
    return False();
  }
  if context^.retired {
    return False();
  }
  if context^.local_geometry {
  } else {
    return False();
  }
  let marked = bor(context^.dirty, context^.restyled);
  if marked {
    return False();
  }
  if context^.marked_paragraphs != 0_u32 {
    return False();
  }
  if context^.marked_children != 0_u32 {
    return False();
  }
  let same = same_space(first: context^.laid, second: context^.space);
  return same;
}

fn splice_recompute_flex(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Recomputes a preflighted flex ancestor after its locally spliced child has settled. Only this context crosses the coordinate bridge; item preparation, natural measurements and final interiors use flex's guarded reuse. Child slots and style/text routes remain stable. Returns actual child layout work plus this container's pass, without treating enclosing flow replay as local propagation.";
  flex_forget(context: context);
  set context^.intrinsic_known = False();
  set context^.intrinsic_held = False();
  set context^.dirty = True();
  lay_out_context(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set context^.dirty = False();
  set context^.restyled = False();
  set context^.restyled_blocks = 0_u32;
  set context^.marked_paragraphs = 0_u32;
  set context^.marked_children = 0_u32;
  resolve_margins(child: context, styles: styles);
  let counts = context^.flex_counts;
  return counts;
}
