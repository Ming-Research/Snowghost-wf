    Fork(left: left_page, right: right_page) => {
      geometry_block_pages(pages: &left_page^.inner, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
      geometry_block_pages(pages: &right_page^.inner, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
    }
    Page(values: values) => {
      let count = values^.inner.len;
      for (slot in 0_u64..count) {
        match values^.inner[slot] {
          Some(value: payload) => {
              if mode == 0_u8 {
                store_block_origin(block: payload, origins: &origins^.inner[0_u64..origin_count]);
              } else if mode == 1_u8 {
                let absolute = owner_origin(origins: &origins^.inner[0_u64..origin_count], owner: payload^.directory);
                restore_block_origin(block: payload, absolute: absolute, dx: dx, dy: dy);
              } else {
                let inherited = owner_translated(blocks: &ranks^.inner[0_u64..rank_count], owner: payload^.parent, flow_at: flow_at);
                let direct = bnot(inherited);
                let later = payload^.flow_at > flow_at;
                let present = payload^.flow_at != no_index;
                let eligible = band(later, present);
                let shifted = band(eligible, direct);
                if shifted {
                  shift_block(block: payload, delta: delta);
                }
              }
              geometry_entries(sequence: &payload^.entries, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn geometry_paragraph_pages(pages: &OwnedPages<Paragraph>, origins: &Box<Array<Origin>>, ranks: &Box<Array<u32>>, mode: u8, dx: i32, dy: i32, flow_at: u32, delta: i32) -> result: unit reads(origins), reads(ranks), writes(pages) {
  doc "Visits independent paragraph payload slots directly; directory branches and counted page slots carry no routing scatter.";
  let origin_count = origins^.inner.len;
  let rank_count = ranks^.inner.len;
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      geometry_paragraph_pages(pages: &left_page^.inner, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
      geometry_paragraph_pages(pages: &right_page^.inner, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
    }
    Page(values: values) => {
      let count = values^.inner.len;
      for (slot in 0_u64..count) {
        match values^.inner[slot] {
          Some(value: payload) => {
              if mode == 0_u8 {
                store_paragraph_origin(paragraph: payload, origins: &origins^.inner[0_u64..origin_count]);
              } else if mode == 1_u8 {
                restore_paragraph_origin(paragraph: payload, origins: &origins^.inner[0_u64..origin_count], dx: dx, dy: dy);
              } else {
                shift_owned_paragraph(paragraph: payload, blocks: &ranks^.inner[0_u64..rank_count], flow_at: flow_at, delta: delta);
              }
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn geometry_child_pages(pages: &OwnedPages<Context>, origins: &Box<Array<Origin>>, ranks: &Box<Array<u32>>, mode: u8, dx: i32, dy: i32, flow_at: u32, delta: i32) -> result: unit reads(origins), reads(ranks), writes(pages) {
  doc "Visits independent child payload slots directly; directory branches and counted page slots carry no routing scatter.";
  let origin_count = origins^.inner.len;
  let rank_count = ranks^.inner.len;
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      geometry_child_pages(pages: &left_page^.inner, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
      geometry_child_pages(pages: &right_page^.inner, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
    }
    Page(values: values) => {
      let count = values^.inner.len;
      for (slot in 0_u64..count) {
        match values^.inner[slot] {
          Some(value: payload) => {
              if mode == 0_u8 {
                store_child_origin(child: payload, origins: &origins^.inner[0_u64..origin_count]);
              } else if mode == 1_u8 {
                restore_child_origin(child: payload, origins: &origins^.inner[0_u64..origin_count], dx: dx, dy: dy);
              } else {
                shift_owned_child(child: payload, blocks: &ranks^.inner[0_u64..rank_count], flow_at: flow_at, delta: delta);
              }
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn geometry_entries(sequence: &EntrySequence, origins: &Box<Array<Origin>>, ranks: &Box<Array<u32>>, mode: u8, dx: i32, dy: i32, flow_at: u32, delta: i32) -> result: unit reads(origins), reads(ranks), writes(sequence.blocks), writes(sequence.paragraphs), writes(sequence.children) {
  doc "Converts payload geometry through independently owned physical pages and nested block ownership.";
  geometry_block_pages(pages: &sequence^.blocks, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
  geometry_paragraph_pages(pages: &sequence^.paragraphs, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
  geometry_child_pages(pages: &sequence^.children, origins: origins, ranks: ranks, mode: mode, dx: dx, dy: dy, flow_at: flow_at, delta: delta);
  return unit;
}