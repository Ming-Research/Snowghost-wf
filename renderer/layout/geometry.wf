  let cursor = block;
  let accumulated = zero_origin();
  let count = context^.block_routes.inner.len;
  for (step in 0_u64..count) {
    let at = cvt::<u32, u64>(cursor);
    if at < context^.block_routes.inner.len {
      let handle = context^.block_routes.inner[at];
