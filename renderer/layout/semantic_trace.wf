alias Styles = pkg::style::Styles;
alias NodeId = pkg::dom::NodeId;

fn trace_record(records: &Box<Slots<u64>>, kind: u64, context: u32, slot: u64, element: u32, detail: u64) -> result: unit writes(records) {
  doc "Appends one temporary diagnostic record with five fixed fields.";
  let context_number = cvt::<u32, u64>(context);
  let node = cvt::<u32, u64>(element);
  let first = push_item::<u64>(cell: records, value: kind, ceiling: item_ceiling);
  let second = push_item::<u64>(cell: records, value: context_number, ceiling: item_ceiling);
  let third = push_item::<u64>(cell: records, value: slot, ceiling: item_ceiling);
  let fourth = push_item::<u64>(cell: records, value: node, ceiling: item_ceiling);
  let fifth = push_item::<u64>(cell: records, value: detail, ceiling: item_ceiling);
  return unit;
}

fn trace_context(context: &Context, styles: &Styles, serial: u32, records: &Box<Slots<u64>>) -> result: unit reads(context), reads(styles), writes(records) {
  doc "Inventories only the routed splice context; no renderer behavior changes.";
  if context^.slot == serial {
    let kind = cvt::<u8, u64>(context^.kind);
    trace_record(records: records, kind: 1_u64, context: serial, slot: 0_u64, element: context^.style.element, detail: kind);
    for (b in 0_u64..context^.blocks.inner.len) {
      let held = block_snapshot(block: &context^.blocks.inner[b]);
      let group = box_of(styles: styles, style: held.style);
      let output = context^.blocks.inner[b].boundary;
      if output.ordinary {
      } else {
        let reason = cvt::<u32, u64>(output.barriers);
        trace_record(records: records, kind: 2_u64, context: serial, slot: b, element: held.style.element, detail: reason);
        let position = cvt::<u8, u64>(group.position);
        trace_record(records: records, kind: 5_u64, context: serial, slot: b, element: held.style.element, detail: position);
      }
    }
    for (p in 0_u64..context^.paragraphs.inner.len) {
      let atomics = context^.paragraphs.inner[p].atomics.inner.len;
      if atomics > 0_u64 {
        trace_record(records: records, kind: 3_u64, context: serial, slot: p, element: context^.paragraphs.inner[p].style.element, detail: atomics);
      }
    }
    for (c in 0_u64..context^.children.inner.len) {
      let group = box_of(styles: styles, style: context^.children.inner[c].style);
      if group.position >= position_absolute {
        let position = cvt::<u8, u64>(group.position);
        trace_record(records: records, kind: 4_u64, context: serial, slot: c, element: context^.children.inner[c].style.element, detail: position);
      }
    }
    return unit;
  }
  for (c in 0_u64..context^.children.inner.len) {
    trace_context(context: &context^.children.inner[c], styles: styles, serial: serial, records: records);
  }
  return unit;
}

fn splice_semantic_trace(layout: &Layout, styles: &Styles, parent: NodeId) -> made: Box<Slots<u64>> reads(layout), reads(styles) {
  doc "Returns the selected owner context's nonordinary contributors before the first edit.";
  let owner = splice_owner(layout: layout, node: parent);
  let records = box_slots_new::<u64>(capacity: 0_u64);
  trace_context(context: &layout^.root, styles: styles, serial: owner.serial, records: &records);
  return move records;
}
