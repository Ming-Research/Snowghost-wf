alias Styles = pkg::style::Styles;

fn boundary_check_value(kind: u64) -> made: SequenceOutput pure {
  doc "Small independently specified transfers include mixed-sign struts and a zero-height separator; construction does not call the composition under test.";
  let output = empty_output();
  set output.count = 1_u64;
  set output.events = 1_u64;
  set output.travel = 64_i64;
  if kind == 0_u64 {
    set output.leading_positive = 10_i32;
    set output.leading_negative = -4_i32;
  } else if kind == 1_u64 {
    set output.through = False();
    set output.leading_positive = 5_i32;
    set output.leading_negative = -7_i32;
    set output.advance = 17_i64;
    set output.trailing_positive = 12_i32;
    set output.trailing_negative = -3_i32;
    let line = EntryHandle(owner: 0_u32, slot: 1_u32);
    set output.first_line = line;
    set output.last_line = line;
    set output.first_baseline = 8_i64;
    set output.last_baseline = 8_i64;
  } else if kind == 2_u64 {
    set output.through = False();
    set output.leading_negative = -12_i32;
  } else {
    set output.leading_negative = -8_i32;
  }
  return output;
}

fn boundary_check_stack(positive: i32, negative: i32) -> made: Stack pure {
  doc "A reference stacking state with a nonzero cursor and a varied entering strut.";
  let floats = box_slots_new::<Exclusion>(capacity: 0_u64);
  let stack = Stack(cursor: 23_i32, positive: positive, negative: negative, floats: move floats, float_floor: -2147483647_i32, reach: -2147483647_i32);
  return move stack;
}

fn boundary_check_apply(stack: &Stack, output: SequenceOutput) -> result: unit writes(stack) {
  doc "Executes individual edges through the reference walker's margin operations, without join_output. The checked test values are far inside the exact arithmetic domain.";
  add_margin(stack: stack, margin: output.leading_positive);
  add_margin(stack: stack, margin: output.leading_negative);
  if output.through {
    return unit;
  }
  let waiting = pending_margin(stack: stack);
  let edge = stack^.cursor +sat waiting;
  let height = geometry_narrow(value: output.advance);
  set stack^.cursor = edge +sat height;
  clear_margins(stack: stack);
  add_margin(stack: stack, margin: output.trailing_positive);
  add_margin(stack: stack, margin: output.trailing_negative);
  return unit;
}

fn reference_frame_check() -> passed: Bool pure {
  doc "A valid hybrid owner has captured old absolute placement and fresh current scratch while its untouched child retains a local anchor. The two replay phases must resolve that child to independently specified old and current coordinates. Publishing the owner and retiring replay state must preserve the current coordinates through the ordinary local-only reader.";
  let style = element_ref(element: no_index);
  let marker = False();
  let context = new_context(kind: ctx_flow, style: style);
  let owner = new_block(style: style, marker: marker);
  set owner.x = 10_i64;
  set owner.y = 20_i64;
  set owner.dx = 3_i64;
  set owner.dy = 7_i64;
  set owner.reference_old = Origin(x: 10_i64, y: 20_i64, dx: 3_i64, dy: 7_i64);
  set owner.reference_captured = True();
  set owner.reference_fresh = True();
  set owner.normal_x = 100_i32;
  set owner.normal_y = 200_i32;
  set owner.resolved_x = 105_i32;
  set owner.resolved_y = 211_i32;
  let child = new_block(style: style, marker: marker);
  set child.parent = 0_u32;
  set child.x = 2_i64;
  set child.y = 4_i64;
  set child.dx = 1_i64;
  set child.dy = 2_i64;
  let added_owner = push_item::<Block>(cell: &context.blocks, value: move owner, ceiling: item_ceiling);
  let added_child = push_item::<Block>(cell: &context.blocks, value: move child, ceiling: item_ceiling);
  let added_capture = push_item::<u32>(cell: &context.reference_blocks, value: 0_u32, ceiling: item_ceiling);
  let both = band(added_owner, added_child);
  let complete = band(both, added_capture);
  if complete {
  } else {
    return False();
  }
  set context.reference_phase = 1_u8;
  let previous = block_origin(context: &context, block: 1_u32);
  if previous.x != 12_i64 {
    return False();
  }
  if previous.y != 24_i64 {
    return False();
  }
  if previous.dx != 4_i64 {
    return False();
  }
  if previous.dy != 9_i64 {
    return False();
  }
  set context.reference_phase = 2_u8;
  let current = block_origin(context: &context, block: 1_u32);
  if current.x != 102_i64 {
    return False();
  }
  if current.y != 204_i64 {
    return False();
  }
  if current.dx != 6_i64 {
    return False();
  }
  if current.dy != 13_i64 {
    return False();
  }
  encode_reference_block(context: &context, at: 0_u64);
  finish_reference_geometry(context: &context);
  set context.local_geometry = True();
  let owned = block_origin(context: &context, block: 1_u32);
  if owned.x != 102_i64 {
    return False();
  }
  if owned.y != 204_i64 {
    return False();
  }
  if owned.dx != 6_i64 {
    return False();
  }
  if owned.dy != 13_i64 {
    return False();
  }
  return True();
}

fn boundary_transfer_check() -> passed: Bool pure {
  doc "The incremental oracle calls this before edits: both association orders must agree with sequential reference margin operations for every triple of four transfers and nine entering struts. An equal-height changed baseline and isolated changes to travel, natural_floor, float_reach, free_transfer motion_known and fragment source/edge metadata must each fail the boundary equality test. Suffix motion admits the last finite natural coordinate but rejects the MAX sentinel, including a nonzero origin. Raw natural translation that reaches MAX remains absent under a subsequent negative translation, independently of scratch movement. This checks the algebra, not the unsupported nested height/marker classifications.";
  let frontier = frontier_check();
  if frontier {
  } else {
    return False();
  }
  let frames = reference_frame_check();
  if frames {
  } else {
    return False();
  }
  let ranges = range_check();
  if ranges {
  } else {
    return False();
  }
  let opens = range_open_check();
  if opens {
  } else {
    return False();
  }
  let atomic_frames = atomic_frame_check();
  if atomic_frames {
  } else {
    return False();
  }
  let sentinel_style = element_ref(element: no_index);
  let sentinel_marker = False();
  let sentinel_block = new_block(style: sentinel_style, marker: sentinel_marker);
  set sentinel_block.natural = 2147483646_i32;
  set sentinel_block.natural_known = True();
  shift_reference_block(block: &sentinel_block, delta: 1_i32);
  shift_reference_block(block: &sentinel_block, delta: -1_i32);
  if sentinel_block.natural != 2147483647_i32 {
    return False();
  }
  if sentinel_block.natural_known {
    return False();
  }
  if sentinel_block.normal_y != 0_i32 {
    return False();
  }
  if sentinel_block.resolved_y != 0_i32 {
    return False();
  }
  for (a in 0_u64..4_u64) {
    for (b in 0_u64..4_u64) {
      for (c in 0_u64..4_u64) {
        let first = boundary_check_value(kind: a);
        let second = boundary_check_value(kind: b);
        let third = boundary_check_value(kind: c);
        let prefix = join_output(left: &first, right: &second);
        let left = join_output(left: &prefix, right: &third);
        let suffix = join_output(left: &second, right: &third);
        let right = join_output(left: &first, right: &suffix);
        let equal = same_transfer(first: left, second: right);
        if equal {
        } else {
          return False();
        }
        for (p in 0_u64..3_u64) {
          for (n in 0_u64..3_u64) {
            let positive_index = cvt::<u64, i32>(p);
            let negative_index = cvt::<u64, i32>(n);
            let positive = positive_index *sat 9_i32;
            let negative = negative_index *sat -6_i32;
            let reference = boundary_check_stack(positive: positive, negative: negative);
            boundary_check_apply(stack: &reference, output: first);
            boundary_check_apply(stack: &reference, output: second);
            boundary_check_apply(stack: &reference, output: third);
            let composed = boundary_check_stack(positive: positive, negative: negative);
            boundary_check_apply(stack: &composed, output: left);
            if reference.cursor != composed.cursor {
              return False();
            }
            if reference.positive != composed.positive {
              return False();
            }
            if reference.negative != composed.negative {
              return False();
            }
          }
        }
      }
    }
  }
  let interior_suffix = reference_suffix_fits(origin: 0_i64, travel: 2147483646_i64);
  if interior_suffix {
  } else {
    return False();
  }
  let sentinel_suffix = reference_suffix_fits(origin: 0_i64, travel: 2147483647_i64);
  if sentinel_suffix {
    return False();
  }
  let origin_suffix = reference_suffix_fits(origin: 1_i64, travel: 2147483646_i64);
  if origin_suffix {
    return False();
  }
  let baseline_before = boundary_check_value(kind: 1_u64);
  let baseline_after = baseline_before;
  set baseline_after.last_baseline = 1_i64;
  let ignored_baseline = same_transfer(first: baseline_before, second: baseline_after);
  let distinguished = bnot(ignored_baseline);
  if distinguished {
  } else {
    return False();
  }
  for (field in 0_u64..10_u64) {
    let certificate_before = boundary_check_value(kind: 1_u64);
    let certificate_after = certificate_before;
    if field == 0_u64 {
      set certificate_after.travel = certificate_before.travel +sat 1_i64;
    } else if field == 1_u64 {
      set certificate_after.natural_floor = -1_i64;
    } else if field == 2_u64 {
      set certificate_after.float_reach = 1_i64;
    } else if field == 3_u64 {
      set certificate_after.free_transfer = False();
    } else if field == 4_u64 {
      set certificate_after.motion_known = False();
    } else if field == 5_u64 {
      set certificate_after.fragment_sources = certificate_before.fragment_sources +sat 1_u64;
    } else if field == 6_u64 {
      set certificate_after.fragment_first = 2_u8;
    } else if field == 7_u64 {
      set certificate_after.fragment_last = 2_u8;
    } else if field == 8_u64 {
      set certificate_after.heights.consumers = 1_u32;
    } else {
      set certificate_after.heights.unproved = 1_u32;
    }
    let ignored_certificate = same_transfer(first: certificate_before, second: certificate_after);
    if ignored_certificate {
      return False();
    }
  }
  let height_checks = height_certificate_check();
  if height_checks {
  } else {
    return False();
  }
  return True();
}

fn height_certificate_check() -> passed: Bool pure {
  doc "Isolates provenance premises so a different conservative preflight cannot mask a mutation. Each source identity/state component is varied with every other input held equal. Counts include all three height properties and missing records; constrained bottom struts have independent expected extrema.";
  let definite = height_dependency_state(content: 12800_i32, mask: 1_u8, basis_state: 2_u8, forced: -1_i32, source_kind: 2_u8);
  if definite != 2_u8 {
    return False();
  }
  let growing = height_dependency_state(content: -1_i32, mask: 0_u8, basis_state: 2_u8, forced: -1_i32, source_kind: 2_u8);
  if growing != 1_u8 {
    return False();
  }
  for (number in 0_u64..4_u64) {
    let state = cvt::<u64, u8>(number);
    if state != 2_u8 {
      let dependent = height_dependency_state(content: 12800_i32, mask: 1_u8, basis_state: state, forced: -1_i32, source_kind: 2_u8);
      if dependent != 3_u8 {
        return False();
      }
    }
  }
  let layout_sized = height_dependency_state(content: 12800_i32, mask: 0_u8, basis_state: 2_u8, forced: 12800_i32, source_kind: 3_u8);
  if layout_sized != 3_u8 {
    return False();
  }
  let viewport_sized = height_dependency_state(content: 12800_i32, mask: 0_u8, basis_state: 2_u8, forced: 12800_i32, source_kind: 1_u8);
  if viewport_sized != 2_u8 {
    return False();
  }
  let proof = absent_height_proof();
  set proof.valid = True();
  set proof.source_context = 1_u32;
  set proof.source_owner = 2_u32;
  set proof.source_element = 3_u32;
  set proof.source_kind = 2_u8;
  set proof.basis_state = 2_u8;
  set proof.basis_height = 12800_i32;
  set proof.read_mask = 7_u8;
  let current_input = height_resolution_current(proof: proof, style: proof.consumer, width: proof.basis_width, height: proof.basis_height, forced: proof.forced_height);
  if current_input {
  } else {
    return False();
  }
  for (field in 0_u64..7_u64) {
    let changed = proof;
    if field == 0_u64 {
      set changed.consumer.element = 4_u32;
    } else if field == 1_u64 {
      set changed.consumer.pseudo = 5_u32;
    } else if field == 2_u64 {
      set changed.consumer.anonymous = True();
    } else if field == 3_u64 {
      set changed.basis_width = 19200_i32;
    } else if field == 4_u64 {
      set changed.basis_height = 19200_i32;
    } else if field == 5_u64 {
      set changed.forced_height = 12800_i32;
    } else {
      set changed.valid = False();
    }
    let stale = height_resolution_current(proof: changed, style: proof.consumer, width: proof.basis_width, height: proof.basis_height, forced: proof.forced_height);
    if stale {
      return False();
    }
  }
  let input = height_input_of(proof: proof);
  let equal = same_height_input(first: input, second: input);
  if equal {
  } else {
    return False();
  }
  for (field in 0_u64..5_u64) {
    let changed = input;
    if field == 0_u64 {
      set changed.context = no_index;
    } else if field == 1_u64 {
      set changed.owner = no_index;
    } else if field == 2_u64 {
      set changed.element = 4_u32;
    } else if field == 3_u64 {
      set changed.kind = 3_u8;
    } else {
      set changed.state = 1_u8;
    }
    let same = same_height_input(first: input, second: changed);
    if same {
      return False();
    }
  }
  let summary = height_proof_summary(proof: proof);
  if summary.consumers != 3_u32 {
    return False();
  }
  if summary.unproved != 0_u32 {
    return False();
  }
  for (number in 0_u64..4_u64) {
    let state = cvt::<u64, u8>(number);
    if state != 2_u8 {
      let unsupported = proof;
      set unsupported.basis_state = state;
      let denied = height_proof_summary(proof: unsupported);
      if denied.unproved != 3_u32 {
        return False();
      }
    }
  }
  let missing = proof;
  set missing.valid = False();
  let denied = height_proof_summary(proof: missing);
  if denied.unproved == 0_u32 {
    return False();
  }
  let inside = solid_output(height: 20_i32);
  set inside.trailing_positive = 30_i32;
  let measured = empty_block_output();
  set measured.height = 20_i32;
  set measured.constrained_height = True();
  set measured.margin_bottom = 10_i32;
  let collapsed = lift_block_output(inside: &inside, measured: measured);
  if collapsed.trailing_positive != 30_i32 {
    return False();
  }
  set measured.bottom_separates = True();
  let separated = lift_block_output(inside: &inside, measured: measured);
  if separated.trailing_positive != 10_i32 {
    return False();
  }
  return True();
}

fn reference_publication_check(styles: &Styles) -> passed: Bool reads(styles) {
  doc "Checks cached publication after geometry already moved. Two root Open entries each span Open and Close; the prefix is already published after the affected range and the common suffix displacement is 7. The untouched suffix moved from offset 5 to 12 with its finite natural offset 5 unchanged, so its natural floor must become 17, its published offset 12, and the root minimum 17 against the prefix floor 100. These numeric expectations do not call the translation under test: the transient range descriptor states the already installed exact action, and the reads use the effective offset and boundary views. Anonymous style fixes the content origin at zero and travel 200 per transfer keeps numeric admission strict. Empty nested sequences, repaired fragments and no positioned children keep unrelated work absent.";
  let element_style = element_ref(element: no_index);
  let style = anonymous_of(style: element_style);
  let marker = False();
  let context = new_context(kind: ctx_flow, style: style);
  let prefix_output = empty_output();
  set prefix_output.count = 1_u64;
  set prefix_output.events = 2_u64;
  set prefix_output.travel = 200_i64;
  set prefix_output.natural_floor = 100_i64;
  set prefix_output.placed = 1_u64;
  set prefix_output.opens = 1_u64;
  let suffix_output = empty_output();
  set suffix_output.count = 1_u64;
  set suffix_output.events = 2_u64;
  set suffix_output.travel = 200_i64;
  set suffix_output.natural_floor = 10_i64;
  set suffix_output.placed = 1_u64;
  set suffix_output.opens = 1_u64;
  let prefix_item = Flow::Open(block: 0_u32);
  let prefix_slot = match insert_before(sequence: &context.entries, before: no_index, item: prefix_item, output: prefix_output, visits: &context.boundary_visits) {
    Ok(value: prefix_added) => {
      give prefix_added;
    }
    Err(..) => {
      return False();
    }
  }
  let suffix_item = Flow::Open(block: 1_u32);
  let suffix_slot = match insert_before(sequence: &context.entries, before: no_index, item: suffix_item, output: suffix_output, visits: &context.boundary_visits) {
    Ok(value: suffix_added) => {
      give suffix_added;
    }
    Err(..) => {
      return False();
    }
  }
  let prefix = new_block(style: style, marker: marker);
  set prefix.entry_slot = prefix_slot;
  set prefix.y = 21_i64;
  set prefix.normal_y = 21_i32;
  set prefix.resolved_y = 21_i32;
  set prefix.natural = 100_i32;
  set prefix.natural_offset = 79_i64;
  set prefix.natural_known = True();
  set prefix.reference_old = Origin(x: 0_i64, y: 20_i64, dx: 0_i64, dy: 0_i64);
  set prefix.reference_captured = True();
  set prefix.reference_fresh = True();
  set prefix.output.offset = 21_i64;
  set prefix.boundary = prefix_output;
  let suffix = new_block(style: style, marker: marker);
  set suffix.entry_slot = suffix_slot;
  set suffix.flow_at = 2_u32;
  set suffix.y = 12_i64;
  set suffix.normal_y = 5_i32;
  set suffix.resolved_y = 5_i32;
  set suffix.natural = 10_i32;
  set suffix.natural_offset = 5_i64;
  set suffix.natural_known = True();
  set suffix.reference_old = Origin(x: 0_i64, y: 5_i64, dx: 0_i64, dy: 0_i64);
  set suffix.reference_captured = True();
  set suffix.output.offset = 5_i64;
  set suffix.boundary = suffix_output;
  let pushed_prefix = push_item::<Block>(cell: &context.blocks, value: move prefix, ceiling: item_ceiling);
  let pushed_suffix = push_item::<Block>(cell: &context.blocks, value: move suffix, ceiling: item_ceiling);
  let noted_prefix = push_item::<u32>(cell: &context.reference_blocks, value: 0_u32, ceiling: item_ceiling);
  let noted_suffix = push_item::<u32>(cell: &context.reference_blocks, value: 1_u32, ceiling: item_ceiling);
  let pushed = band(pushed_prefix, pushed_suffix);
  let noted = band(noted_prefix, noted_suffix);
  let ready = band(pushed, noted);
  if ready {
  } else {
    return False();
  }
  set context.reference_phase = 2_u8;
  set context.fragment_repaired = True();
  let moved = Origin(x: 0_i64, y: 7_i64, dx: 0_i64, dy: 0_i64);
  let range = RangeDescriptor(owner: no_index, first: 1_u64, action: moved);
  let described = push_item::<RangeDescriptor>(cell: &context.range_descriptors, value: range, ceiling: item_ceiling);
  if described {
  } else {
    return False();
  }
  let partial = True();
  let unpublished = False();
  let scope = ReferenceScope(partial: partial, published: unpublished, from: 2_u64, until: 1_u64, delta: 7_i32, extra: 18446744073709551615_u64);
  let events = slots_new::<Flow, 0>();
  finish_reference_scope(context: &context, events: &events[0_u64..0_u64], styles: styles, basis_height: unknown, scope: scope);
  let own = True();
  let total = False();
  let first = reference_owner_output(context: &context, owner: no_index, slot: prefix_slot, own: own);
  let last = reference_owner_output(context: &context, owner: no_index, slot: suffix_slot, own: own);
  let root = reference_owner_output(context: &context, owner: no_index, slot: context.entries.root, own: total);
  if first.natural_floor != 100_i64 {
    return False();
  }
  if last.natural_floor != 17_i64 {
    return False();
  }
  if root.natural_floor != 17_i64 {
    return False();
  }
  if root.events != 4_u64 {
    return False();
  }
  if context.blocks.inner.len > 1_u64 {
    let measured = block_measured(context: &context, at: 1_u64);
    if measured.offset != 12_i64 {
      return False();
    }
    let boundary = block_boundary(context: &context, at: 1_u64);
    if boundary.natural_floor != 17_i64 {
      return False();
    }
  } else {
    return False();
  }
  let zero_motion = reference_zero_publication_check(styles: styles);
  return zero_motion;
}

fn reference_zero_publication_check(styles: &Styles) -> passed: Bool reads(styles) {
  doc "Checks suffix publication when flow displacement is zero but a replayed parent moved. A root Open changes absolute y from 20 to 21; its untouched nested Open remains at absolute 25, so real hybrid movement must rebase local y from 5 to 4. The nested natural stays at absolute 30, requiring its cached owner-relative floor to change from 10 to 9 and its published offset from 5 to 4. The nested Open retains its immediate containing-block basis 40 while the context basis is unknown; semantic translation must preserve that 40. The four virtual events retain the same topology. Independent numeric expectations distinguish cached publication from geometry, which the preceding movement already repaired.";
  let element_style = element_ref(element: no_index);
  let style = anonymous_of(style: element_style);
  let marker = False();
  let context = new_context(kind: ctx_flow, style: style);
  let owner_output = empty_output();
  set owner_output.count = 1_u64;
  set owner_output.events = 4_u64;
  set owner_output.travel = 400_i64;
  set owner_output.natural_floor = 20_i64;
  set owner_output.placed = 1_u64;
  set owner_output.opens = 1_u64;
  let owner_item = Flow::Open(block: 0_u32);
  let owner_slot = match insert_before(sequence: &context.entries, before: no_index, item: owner_item, output: owner_output, visits: &context.boundary_visits) {
    Ok(value: owner_added) => {
      give owner_added;
    }
    Err(..) => {
      return False();
    }
  }
  let owner = new_block(style: style, marker: marker);
  let nested_output = empty_output();
  set nested_output.count = 1_u64;
  set nested_output.events = 2_u64;
  set nested_output.travel = 200_i64;
  set nested_output.natural_floor = 10_i64;
  set nested_output.placed = 1_u64;
  set nested_output.opens = 1_u64;
  let nested_item = Flow::Open(block: 1_u32);
  let nested_slot = match insert_before(sequence: &owner.entries, before: no_index, item: nested_item, output: nested_output, visits: &context.boundary_visits) {
    Ok(value: nested_added) => {
      give nested_added;
    }
    Err(..) => {
      return False();
    }
  }
  set owner.entry_slot = owner_slot;
  set owner.flow_at = 0_u32;
  set owner.y = 20_i64;
  set owner.normal_y = 21_i32;
  set owner.resolved_y = 21_i32;
  set owner.natural = 20_i32;
  set owner.natural_known = True();
  set owner.reference_old = Origin(x: 0_i64, y: 20_i64, dx: 0_i64, dy: 0_i64);
  set owner.reference_captured = True();
  set owner.reference_fresh = True();
  set owner.output.offset = 20_i64;
  set owner.boundary = owner_output;
  let nested = new_block(style: style, marker: marker);
  set nested.parent = 0_u32;
  set nested.entry_slot = nested_slot;
  set nested.flow_at = 1_u32;
  set nested.y = 5_i64;
  set nested.normal_y = 25_i32;
  set nested.resolved_y = 25_i32;
  set nested.natural = 30_i32;
  set nested.natural_offset = 5_i64;
  set nested.natural_known = True();
  set nested.output.offset = 5_i64;
  set nested.output.natural = 5_i64;
  set nested.output.basis_height = 40_i32;
  set nested.boundary = nested_output;
  let pushed_owner = push_item::<Block>(cell: &context.blocks, value: move owner, ceiling: item_ceiling);
  let pushed_nested = push_item::<Block>(cell: &context.blocks, value: move nested, ceiling: item_ceiling);
  let noted_owner = push_item::<u32>(cell: &context.reference_blocks, value: 0_u32, ceiling: item_ceiling);
  let pushed = band(pushed_owner, pushed_nested);
  let ready = band(pushed, noted_owner);
  if ready {
  } else {
    return False();
  }
  set context.reference_phase = 2_u8;
  set context.fragment_repaired = True();
  translate_reference_after(context: &context, flow_at: 0_u32, delta: 0_i32);
  let partial = True();
  let unpublished = False();
  let scope = ReferenceScope(partial: partial, published: unpublished, from: 0_u64, until: 0_u64, delta: 0_i32, extra: 18446744073709551615_u64);
  let events = slots_new::<Flow, 0>();
  finish_reference_scope(context: &context, events: &events[0_u64..0_u64], styles: styles, basis_height: unknown, scope: scope);
  let absolute = block_origin(context: &context, block: 1_u32);
  if absolute.y != 25_i64 {
    return False();
  }
  let own = True();
  let cached = reference_owner_output(context: &context, owner: 0_u32, slot: nested_slot, own: own);
  if cached.natural_floor != 9_i64 {
    return False();
  }
  if context.blocks.inner.len > 1_u64 {
    let local = block_local(context: &context, at: 1_u64);
    if local.y != 4_i64 {
      return False();
    }
    let measured = block_measured(context: &context, at: 1_u64);
    if measured.basis_height != 40_i32 {
      return False();
    }
    if measured.offset != 4_i64 {
      return False();
    }
    let boundary = block_boundary(context: &context, at: 1_u64);
    if boundary.natural_floor != 9_i64 {
      return False();
    }
  } else {
    return False();
  }
  return True();
}

fn range_open_check() -> passed: Bool pure {
  doc "Independent constants check an Open's duplicated fields under range actions. A root Open with offset 5, basis height 40 and boundary natural floor 10 receives semantic displacement 7 and basis 90 through a range; its effective views must read offset 12, basis 90 and floor 17 while its raw fields still hold 5, 40 and 10. Settling it before a point publication must fold exactly those values into the raw fields, after which the effective views still read 12, 90 and 17 rather than counting the displacement twice.";
  let style = element_ref(element: no_index);
  let marker = False();
  let context = new_context(kind: ctx_flow, style: style);
  let output = empty_output();
  set output.count = 1_u64;
  set output.events = 2_u64;
  set output.travel = 200_i64;
  set output.natural_floor = 10_i64;
  set output.placed = 1_u64;
  set output.opens = 1_u64;
  let item = Flow::Open(block: 0_u32);
  let slot = match insert_before(sequence: &context.entries, before: no_index, item: item, output: output, visits: &context.boundary_visits) {
    Ok(value: added) => {
      give added;
    }
    Err(..) => {
      return False();
    }
  }
  let block = new_block(style: style, marker: marker);
  set block.entry_slot = slot;
  set block.output.offset = 5_i64;
  set block.output.basis_height = 40_i32;
  set block.boundary = output;
  let pushed = push_item::<Block>(cell: &context.blocks, value: move block, ceiling: item_ceiling);
  if pushed {
  } else {
    return False();
  }
  let zero = zero_origin();
  let yes = True();
  let action = RangeAction(geometry: zero, semantic: 7_i64, basis: 90_i32, basis_set: yes);
  let root = context.entries.root;
  let total = install_range(sequence: &context.entries, root: root, skip: 0_u64, action: action, visits: &context.boundary_visits);
  set context.range_actions = True();
  let measured = block_measured(context: &context, at: 0_u64);
  let boundary = block_boundary(context: &context, at: 0_u64);
  if measured.offset != 12_i64 {
    return False();
  }
  if measured.basis_height != 90_i32 {
    return False();
  }
  if boundary.natural_floor != 17_i64 {
    return False();
  }
  if total.natural_floor != 17_i64 {
    return False();
  }
  if 0_u64 < context.blocks.inner.len {
    if context.blocks.inner[0_u64].output.offset != 5_i64 {
      return False();
    }
  } else {
    return False();
  }
  settle_open_semantics(context: &context, at: 0_u64);
  if 0_u64 < context.blocks.inner.len {
    if context.blocks.inner[0_u64].output.offset != 12_i64 {
      return False();
    }
    if context.blocks.inner[0_u64].output.basis_height != 90_i32 {
      return False();
    }
    if context.blocks.inner[0_u64].boundary.natural_floor != 17_i64 {
      return False();
    }
  } else {
    return False();
  }
  let settled = block_measured(context: &context, at: 0_u64);
  let settled_boundary = block_boundary(context: &context, at: 0_u64);
  let offset_once = settled.offset == 12_i64;
  let floor_once = settled_boundary.natural_floor == 17_i64;
  return band(offset_once, floor_once);
}

fn atomic_frame_check() -> passed: Bool pure {
  doc "Independent constants check the full raw bridge's atomic placement source. A root block at local y 20 holds a lined paragraph at local (5, 10); its atomic inline is anchored at (3, 4) relative to that paragraph, and the context carries content adjustment (0, 7). Materializing raw reference coordinates must place the block at 27, the paragraph at (5, 37) and the atomic inline at (8, 41): the paragraph frame comes from the immutable effective snapshot and the adjustment applies once. A block-relative or already-adjusted paragraph source would place it at y 31 or 48.";
  let style = element_ref(element: no_index);
  let marker = False();
  let context = new_context(kind: ctx_flow, style: style);
  let block = new_block(style: style, marker: marker);
  set block.y = 20_i64;
  let pushed_block = push_item::<Block>(cell: &context.blocks, value: move block, ceiling: item_ceiling);
  let pieces = box_slots_new::<Piece>(capacity: 0_u64);
  let paragraph = new_paragraph(style: style, pieces: move pieces, reserve: 0_u64);
  set paragraph.block = 0_u32;
  set paragraph.x = 5_i64;
  set paragraph.top = 10_i64;
  let line = Line(start: 0_u32, end: 0_u32, x: 0_i32, width: 0_i32, room: 0_i32, top: 0_i32, height: 10_i32, baseline: 8_i32, least_top: 0_i32);
  let lined = push_item::<Line>(cell: &paragraph.lines, value: line, ceiling: item_ceiling);
  let pushed_paragraph = push_item::<Paragraph>(cell: &context.paragraphs, value: move paragraph, ceiling: item_ceiling);
  let child = new_context(kind: ctx_flow, style: style);
  set child.block = 0_u32;
  set child.placement_paragraph = 0_u32;
  set child.anchor = Origin(x: 3_i64, y: 4_i64, dx: 0_i64, dy: 0_i64);
  let pushed_child = push_item::<Context>(cell: &context.children, value: move child, ceiling: item_ceiling);
  let first_pair = band(pushed_block, pushed_paragraph);
  let second_pair = band(lined, pushed_child);
  let ready = band(first_pair, second_pair);
  if ready {
  } else {
    return False();
  }
  set context.content_dy = 7_i32;
  set context.local_geometry = True();
  let synchronize = False();
  reference_geometry(context: &context, synchronize: synchronize);
  if 0_u64 < context.blocks.inner.len {
    if context.blocks.inner[0_u64].normal_y != 27_i32 {
      return False();
    }
  } else {
    return False();
  }
  if 0_u64 < context.paragraphs.inner.len {
    if context.paragraphs.inner[0_u64].normal_top != 37_i32 {
      return False();
    }
    if context.paragraphs.inner[0_u64].normal_x != 5_i32 {
      return False();
    }
  } else {
    return False();
  }
  if 0_u64 < context.children.inner.len {
    let normal_y = context.children.inner[0_u64].normal_y == 41_i32;
    let normal_x = context.children.inner[0_u64].normal_x == 8_i32;
    let visual_y = context.children.inner[0_u64].y == 41_i32;
    let normal = band(normal_y, normal_x);
    return band(normal, visual_y);
  }
  return False();
}
