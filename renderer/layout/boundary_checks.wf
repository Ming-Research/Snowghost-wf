fn boundary_check_value(kind: u64) -> made: SequenceOutput pure {
  doc "Small independently specified transfers include mixed-sign struts and a zero-height separator; construction does not call the composition under test.";
  let output = empty_output();
  set output.count = 1_u64;
  set output.events = 1_u64;
  set output.travel = 64_i64;
  if kind == 0_u64 {
    set output.leading_positive = 10_i32;
    set output.leading_negative = -4_i32;
  } else if kind == 1_u64 {
    set output.through = False();
    set output.leading_positive = 5_i32;
    set output.leading_negative = -7_i32;
    set output.advance = 17_i64;
    set output.trailing_positive = 12_i32;
    set output.trailing_negative = -3_i32;
    let line = EntryHandle(owner: 0_u32, slot: 1_u32);
    set output.first_line = line;
    set output.last_line = line;
    set output.first_baseline = 8_i64;
    set output.last_baseline = 8_i64;
  } else if kind == 2_u64 {
    set output.through = False();
    set output.leading_negative = -12_i32;
  } else {
    set output.leading_negative = -8_i32;
  }
  return output;
}

fn boundary_check_stack(positive: i32, negative: i32) -> made: Stack pure {
  doc "A reference stacking state with a nonzero cursor and a varied entering strut.";
  let floats = box_slots_new::<Exclusion>(capacity: 0_u64);
  let stack = Stack(cursor: 23_i32, positive: positive, negative: negative, floats: move floats, float_floor: -2147483647_i32, reach: -2147483647_i32);
  return move stack;
}

fn boundary_check_apply(stack: &Stack, output: SequenceOutput) -> result: unit writes(stack) {
  doc "Executes individual edges through the reference walker's margin operations, without join_output. The checked test values are far inside the exact arithmetic domain.";
  add_margin(stack: stack, margin: output.leading_positive);
  add_margin(stack: stack, margin: output.leading_negative);
  if output.through {
    return unit;
  }
  let waiting = pending_margin(stack: stack);
  let edge = stack^.cursor +sat waiting;
  let height = geometry_narrow(value: output.advance);
  set stack^.cursor = edge +sat height;
  clear_margins(stack: stack);
  add_margin(stack: stack, margin: output.trailing_positive);
  add_margin(stack: stack, margin: output.trailing_negative);
  return unit;
}

fn boundary_transfer_check() -> passed: Bool pure {
  doc "The incremental oracle calls this before edits: both association orders must agree with sequential reference margin operations for every triple of four transfers and nine entering struts. An equal-height changed baseline must fail the boundary equality test; suffix motion admits the last finite natural coordinate but rejects the MAX sentinel, including a nonzero origin. This checks the algebra, not the unsupported nested height/marker classifications.";
  for (a in 0_u64..4_u64) {
    for (b in 0_u64..4_u64) {
      for (c in 0_u64..4_u64) {
        let first = boundary_check_value(kind: a);
        let second = boundary_check_value(kind: b);
        let third = boundary_check_value(kind: c);
        let prefix = join_output(left: &first, right: &second);
        let left = join_output(left: &prefix, right: &third);
        let suffix = join_output(left: &second, right: &third);
        let right = join_output(left: &first, right: &suffix);
        let equal = same_transfer(first: left, second: right);
        if equal {
        } else {
          return False();
        }
        for (p in 0_u64..3_u64) {
          for (n in 0_u64..3_u64) {
            let positive_index = cvt::<u64, i32>(p);
            let negative_index = cvt::<u64, i32>(n);
            let positive = positive_index *sat 9_i32;
            let negative = negative_index *sat -6_i32;
            let reference = boundary_check_stack(positive: positive, negative: negative);
            boundary_check_apply(stack: &reference, output: first);
            boundary_check_apply(stack: &reference, output: second);
            boundary_check_apply(stack: &reference, output: third);
            let composed = boundary_check_stack(positive: positive, negative: negative);
            boundary_check_apply(stack: &composed, output: left);
            if reference.cursor != composed.cursor {
              return False();
            }
            if reference.positive != composed.positive {
              return False();
            }
            if reference.negative != composed.negative {
              return False();
            }
          }
        }
      }
    }
  }
  let interior_suffix = reference_suffix_fits(origin: 0_i64, travel: 2147483646_i64);
  if interior_suffix {
  } else {
    return False();
  }
  let sentinel_suffix = reference_suffix_fits(origin: 0_i64, travel: 2147483647_i64);
  if sentinel_suffix {
    return False();
  }
  let origin_suffix = reference_suffix_fits(origin: 1_i64, travel: 2147483646_i64);
  if origin_suffix {
    return False();
  }
  let baseline_before = boundary_check_value(kind: 1_u64);
  let baseline_after = baseline_before;
  set baseline_after.last_baseline = 1_i64;
  let ignored_baseline = same_transfer(first: baseline_before, second: baseline_after);
  let distinguished = bnot(ignored_baseline);
  if distinguished {
  } else {
    return False();
  }
  for (field in 0_u64..5_u64) {
    let certificate_before = boundary_check_value(kind: 1_u64);
    let certificate_after = certificate_before;
    if field == 0_u64 {
      set certificate_after.travel = certificate_before.travel +sat 1_i64;
    } else if field == 1_u64 {
      set certificate_after.natural_floor = -1_i64;
    } else if field == 2_u64 {
      set certificate_after.float_reach = 1_i64;
    } else if field == 3_u64 {
      set certificate_after.free_transfer = False();
    } else {
      set certificate_after.motion_known = False();
    }
    let ignored_certificate = same_transfer(first: certificate_before, second: certificate_after);
    if ignored_certificate {
      return False();
    }
  }
  return True();
}
