alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;

struct SplicePosition {
  doc "A positioned child's independent settlement inputs, captured after flow anchors and containing-block dimensions have settled; no reference to mutable sibling state is retained.";
  active: Bool;
  owner: Origin;
  normal: Position;
  visual: Position;
  anchor_found: Bool;
  anchor_left: i32;
  anchor_top: i32;
  anchor_width: i32;
  anchor_height: i32;
}

fn empty_splice_position() -> made: SplicePosition pure {
  doc "A plan for an absent or in-flow child.";
  let no = False();
  let origin = zero_origin();
  let point = Position(x: 0_i32, y: 0_i32);
  return SplicePosition(active: no, owner: origin, normal: point, visual: point, anchor_found: no, anchor_left: 0_i32, anchor_top: 0_i32, anchor_width: 0_i32, anchor_height: 0_i32);
}

fn splice_position_frame(context: &Context, styles: &Styles, block: u32) -> (owner: Origin, found: Bool, left: i32, top: i32, width: i32, height: i32) reads(context), reads(styles) {
  doc "Resolves published owner and nearest positioned containing-block origins in one immutable parent walk. Separate accumulators preserve the original local-to-root association; each effective local origin is read once. Raw and hybrid phases retain their phase-specific readers.";
  if context^.local_geometry {
  } else {
    let owner = block_origin(context: context, block: block);
    let (found, left, top, width, height) = chain_anchor(context: context, styles: styles, block: block);
    return owner, found, left, top, width, height;
  }
  let owner = zero_origin();
  let anchor = zero_origin();
  let anchor_at = no_index;
  let cursor = block;
  let count = context^.blocks.inner.len;
  for (step in 0_u64..count) {
    let at = cvt::<u32, u64>(cursor);
    if at < context^.blocks.inner.len {
      if anchor_at == no_index {
        let group = box_of(styles: styles, style: context^.blocks.inner[at].style);
        if group.position != position_static {
          set anchor_at = cursor;
        }
      }
      let local = block_local(context: context, at: at);
      set owner = origin_accumulate(owner: local, local: owner);
      if anchor_at != no_index {
        set anchor = origin_accumulate(owner: local, local: anchor);
      }
      set cursor = context^.blocks.inner[at].parent;
    } else {
      break;
    }
  }
  let at = cvt::<u32, u64>(anchor_at);
  if at < context^.blocks.inner.len {
    let edges = border_edges(styles: styles, style: context^.blocks.inner[at].style);
    let visual = origin_visual(value: anchor);
    let position = content_position(value: visual, dx: context^.content_dx, dy: context^.content_dy);
    let left = position.x +sat edges.left;
    let top = position.y +sat edges.top;
    let across = horizontal(edges: edges);
    let down = vertical(edges: edges);
    let width = context^.blocks.inner[at].width -sat across;
    let height = context^.blocks.inner[at].height -sat down;
    return owner, True(), left, top, width, height;
  }
  return owner, False(), 0_i32, 0_i32, 0_i32, 0_i32;
}

fn splice_position_plan(context: &Context, styles: &Styles, at: u64) -> made: SplicePosition reads(context), reads(styles) {
  doc "Reads only one child and its block ancestry. Its accumulated anchor preserves static-position axes after a direct or enclosing-block move; the final containing block supplies explicit-inset axes.";
  if at < context^.children.inner.len {
  } else {
    return empty_splice_position();
  }
  if context^.children.inner[at].retired {
    return empty_splice_position();
  }
  let out = positioned(styles: styles, context: &context^.children.inner[at]);
  if out {
  } else {
    return empty_splice_position();
  }
  let block = context^.children.inner[at].block;
  let (owner, found, left, top, width, height) = splice_position_frame(context: context, styles: styles, block: block);
  let basis = if context^.children.inner[at].viewport_origin {
    give zero_origin();
  } else {
    give owner;
  }
  let accumulated = origin_accumulate(owner: basis, local: context^.children.inner[at].anchor);
  let normal = origin_normal(value: accumulated);
  let visual = origin_visual(value: accumulated);
  let moved_normal = content_position(value: normal, dx: context^.content_dx, dy: context^.content_dy);
  let moved_visual = content_position(value: visual, dx: context^.content_dx, dy: context^.content_dy);
  let yes = True();
  return SplicePosition(active: yes, owner: owner, normal: moved_normal, visual: moved_visual, anchor_found: found, anchor_left: left, anchor_top: top, anchor_width: width, anchor_height: height);
}

fn splice_position_child(child: &Context, plan: SplicePosition, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, border: Edges, parent_width: i32, parent_height: i32, content_dx: i32, content_dy: i32) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(child) {
  doc "Settles one positioned anchor with the shared full-layout arithmetic. A changed containing-block space uses the existing incremental child layout; retained descendants are never individually translated. Final coordinates return to the child's block-relative anchor, or viewport-relative anchor for a fully explicit fixed box.";
  if plan.active {
  } else {
    return no_updates();
  }
  set child^.normal_x = plan.normal.x;
  set child^.normal_y = plan.normal.y;
  set child^.x = plan.visual.x;
  set child^.y = plan.visual.y;
  let yes = True();
  let counts = position_one(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, border: border, parent_width: parent_width, parent_height: parent_height, updating: yes, anchor_found: plan.anchor_found, anchor_left: plan.anchor_left, anchor_top: plan.anchor_top, anchor_width: plan.anchor_width, anchor_height: plan.anchor_height);
  let owner = if child^.viewport_origin {
    give zero_origin();
  } else {
    give plan.owner;
  }
  let normal_x = child^.normal_x -sat content_dx;
  let normal_y = child^.normal_y -sat content_dy;
  let visual_x = child^.x -sat content_dx;
  let visual_y = child^.y -sat content_dy;
  let absolute = origin_from_resolved(nx: normal_x, ny: normal_y, vx: visual_x, vy: visual_y);
  set child^.anchor = origin_relative(value: absolute, owner: owner);
  return counts;
}

fn splice_position(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Settles direct positioned children after a local flow splice without materializing flow events or converting the context's geometry. Independent read-only plans precede independent per-child writes; a containing-block size must settle before either phase. The final reduction combines only work counts.";
  let count = context^.children.inner.len;
  let blank = empty_splice_position();
  let plans = box_array_filled::<SplicePosition>(count: count, value: blank);
  for (at in 0_u64..count) {
    let plan = splice_position_plan(context: context, styles: styles, at: at);
    set plans.inner[at] = plan;
  }
  let border = border_edges(styles: styles, style: context^.style);
  let parent_width = context^.width;
  let parent_height = context^.height;
  let content_dx = context^.content_dx;
  let content_dy = context^.content_dy;
  let empty = no_updates();
  let results = box_array_filled::<UpdateCounts>(count: count, value: empty);
  if count <= context^.children.inner.len {
    for (at in 0_u64..count) {
      let counted = splice_position_child(child: &context^.children.inner[at], plan: plans.inner[at], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, border: border, parent_width: parent_width, parent_height: parent_height, content_dx: content_dx, content_dy: content_dy);
      set results.inner[at] = counted;
    }
  }
  for (at in 0_u64..count) {
    if at < context^.children.inner.len {
      if plans.inner[at].active {
        splice_position_certificate(context: context, at: at, captured_owner: plans.inner[at].owner);
      }
    }
  }
  let total = sum_counts(results: &results);
  return total;
}

fn splice_position_certificate(context: &Context, at: u64, captured_owner: Origin) -> result: unit writes(context) {
  doc "Recomputes the settled positioned anchor's exact arithmetic charge using its plan's parent origin, which remains unchanged by child-only settlement and zero-delta certificate publication. A changed charge joins through owner ancestry with zero geometric delta. Exact equality leaves every output field unchanged, so its existing ancestor reduction remains valid. Leaf writes follow independent anchor settlement and precede dependent ancestor reductions; the current sequential AVL repairs retain the existing scatter limitation.";
  if at < context^.children.inner.len {
  } else {
    return unit;
  }
  let owner = context^.children.inner[at].block;
  let slot = context^.children.inner[at].entry_slot;
  let own_field = True();
  let output = if owner == no_index {
    give effective_output(sequence: &context^.entries, slot: slot, own: own_field, visits: &context^.boundary_visits);
  } else {
    let owner_at = cvt::<u32, u64>(owner);
    if owner_at < context^.blocks.inner.len {
      give effective_output(sequence: &context^.blocks.inner[owner_at].entries, slot: slot, own: own_field, visits: &context^.boundary_visits);
    } else {
      give empty_output();
    }
  }
  let travel = child_motion_travel_with_owner(context: context, at: at, owner: captured_owner);
  if output.travel == travel {
    return unit;
  }
  set output.travel = travel;
  propagate_boundary(context: context, owner: owner, slot: slot, output: output, delta: 0_i32);
  return unit;
}
