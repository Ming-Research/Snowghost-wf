alias changed_boxes_only = pkg::style::changed_boxes_only;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Styles = pkg::style::Styles;
alias Traversal = pkg::style::Traversal;
alias AtomTable = pkg::base::atom::AtomTable;
alias FontSet = pkg::layout::text::FontSet;
alias FontPicks = pkg::layout::text::FontPicks;

fn retain_source_boundary(context: &Context, item: Flow, removing: Bool, visits: &BoundaryVisits) -> reason: u32 reads(context), writes(visits) {
  doc "Certifies complete neutral owned source; geometry transfer properties do not enter this proof.";
  let complete = retain_seam_item(context: context, item: item);
  if complete {
  } else {
    return 3_u32;
  }
  let reason = splice_boundary(context: context, item: item, removing: removing, visits: visits);
  return reason;
}

fn retain_source_inputs(context: &Context, steps: &[ContextStep], depth: u64, owner: u32, before: Flow, removed: Flow, ending: Bool, removing: Bool, styles: &Styles, visits: &BoundaryVisits) -> result: Result<SpliceInput, u32> reads(context), reads(steps), reads(styles), writes(visits) {
  doc "Resolves exact current owner and seam identities for source repair, without any float-motion, width or transfer admission. Each context descent depends on the preceding exact route step.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
    } else {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
    if context^.slot != route.parent {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
    if context^.children.inner[child].slot != route.slot {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
  }
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      if context^.slot == route.parent {
        if context^.children.inner[child].slot == route.slot {
          let next = depth +sat 1_u64;
          let found = retain_source_inputs(context: &context^.children.inner[child], steps: steps, depth: next, owner: owner, before: before, removed: removed, ending: ending, removing: removing, styles: styles, visits: visits);
          return found;
        }
      }
    }
    return Err<SpliceInput, u32>(error: 1_u32);
  }
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  if context^.kind != ctx_flow {
    return Err<SpliceInput, u32>(error: 2_u32);
  }
  let root_style = context^.style;
  let wide_left = cvt::<i32, i64>(frame.content_left);
  let wide_top = cvt::<i32, i64>(frame.content_top);
  let blocks = cvt.wrap::<u64, u32>(context^.blocks.inner.len);
  let paragraphs = cvt.wrap::<u64, u32>(context^.paragraphs.inner.len);
  let children = cvt.wrap::<u64, u32>(context^.children.inner.len);
  let frontier = empty_splice_frontier();
  let basis_input = containing_height_proof(context: context, styles: styles, owner: no_index, height: frame.definite);
  let input = SpliceInput(serial: context^.slot, owner: owner, height_proof: basis_input, frontier: frontier, before: no_index, removed: no_index, allocated: context^.entries.allocated, style: root_style, width: frame.flow_width, left: 0_i32, local_left: wide_left, first_edge: wide_top, basis_height: frame.definite, blocks: blocks, paragraphs: paragraphs, children: children);
  let total_field = False();
  let total = boundary_output(sequence: &context^.entries, slot: context^.entries.root, own: total_field, visits: visits);
  if owner != no_index {
    let at = cvt::<u32, u64>(owner);
    if at < context^.blocks.inner.len {
      set visits^.blocks = visits^.blocks +sat 1_u64;
      let snapshot = block_snapshot(block: &context^.blocks.inner[at]);
      let output = context^.blocks.inner[at].output;
      set input.style = snapshot.style;
      let owner_height = definite_block_height(styles: styles, style: snapshot.style, basis_width: snapshot.avail_width, basis_height: output.basis_height);
      set input.basis_height = owner_height;
      set input.height_proof = containing_height_proof(context: context, styles: styles, owner: owner, height: owner_height);
      set input.width = snapshot.content_width;
      set input.left = snapshot.content_left;
      let local = snapshot.content_left -sat snapshot.inner_x;
      let wide_local = cvt::<i32, i64>(local);
      set input.local_left = wide_local;
      let top = cvt::<i32, i64>(output.top_frame);
      set input.first_edge = top;
      set input.allocated = context^.blocks.inner[at].entries.allocated;
      let owned_total = boundary_output(sequence: &context^.blocks.inner[at].entries, slot: context^.blocks.inner[at].entries.root, own: total_field, visits: visits);
      set total = owned_total;
      if output.top_frame == 0_i32 {
        set input.first_edge = 0_i64;
      } else {
        let margin = total.leading_positive +sat total.leading_negative;
        let wide_margin = cvt::<i32, i64>(margin);
        set input.first_edge = input.first_edge +sat wide_margin;
      }
    } else {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
  } else {
    let margin = total.leading_positive +sat total.leading_negative;
    let wide_margin = cvt::<i32, i64>(margin);
    set input.first_edge = input.first_edge +sat wide_margin;
  }
  if ending {
  } else {
    let target = splice_handle(context: context, item: before, visits: visits);
    if target.owner != owner {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    if target.slot == no_index {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    set input.before = target.slot;
  }
  if removing {
    let target = splice_handle(context: context, item: removed, visits: visits);
    if target.owner != owner {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    if target.slot == no_index {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    let reason = retain_source_boundary(context: context, item: removed, removing: removing, visits: visits);
    if reason != 0_u32 {
      return Err<SpliceInput, u32>(error: reason);
    }
    set input.removed = target.slot;
  }
  return Ok<SpliceInput, u32>(value: input);
}

fn retain_seam_item(context: &Context, item: Flow) -> ready: Bool reads(context) {
  doc "A source seam admits complete ordinary or floated child/block ownership and transparent whitespace only. It uses no width, margin, height or float-motion certificate.";
  match item {
    Open(block: source_block) => {
      let at = cvt::<u32, u64>(source_block);
      if at < context^.blocks.inner.len {
        return bnot(context^.blocks.inner[at].split_head);
      }
    }
    Child(context: child) => {
      let at = cvt::<u32, u64>(child);
      if at < context^.children.inner.len {
        return bnot(context^.children.inner[at].split_head);
      }
    }
    Float(context: child) => {
      let at = cvt::<u32, u64>(child);
      if at < context^.children.inner.len {
        return bnot(context^.children.inner[at].split_head);
      }
    }
    Text(paragraph: source_paragraph) => {
      let at = cvt::<u32, u64>(source_paragraph);
      if at < context^.paragraphs.inner.len {
        let p = &context^.paragraphs.inner[at];
        let marks = p^.marks.inner.len;
        if p^.lines.inner.len != 0_u64 {
          return False();
        }
        if p^.fragments.inner.len != 0_u64 {
          return False();
        }
        for (k in 0_u64..marks) {
          match p^.marks.inner[k] {
            Node(..) => {
            }
            Open(..) => {
              return False();
            }
            Close(..) => {
              return False();
            }
            Atomic(..) => {
              return False();
            }
          }
        }
        return True();
      }
    }
    Close(..) => {
    }
    Out(..) => {
    }
  }
  return False();
}

fn retain_sequence_seam(context: &Context, sequence: &EntrySequence, selected: u32, removing: Bool) -> ready: Bool reads(context), reads(sequence) {
  doc "Checks the complete source roles on both sides of the old direct seam, including the empty boundary.";
  let visits = no_boundary_visits();
  let rank = boundary_rank(sequence: sequence, slot: selected, visits: &visits);
  let root = sequence_node(sequence: sequence, slot: sequence^.root);
  if selected != no_index {
    let chosen = sequence_node(sequence: sequence, slot: selected);
    if chosen.live {
    } else {
      return False();
    }
  }
  if rank > 0_u64 {
    let before = rank - 1_u64;
    let slot = direct_slot(sequence: sequence, rank: before, visits: &visits);
    let item = sequence_payload(sequence: sequence, slot: slot);
    let complete = retain_seam_item(context: context, item: item);
    if complete {
    } else {
      return False();
    }
  }
  let after = if removing {
    give rank +sat 1_u64;
  } else {
    give rank;
  }
  if after < root.total_count {
    let slot = direct_slot(sequence: sequence, rank: after, visits: &visits);
    let item = sequence_payload(sequence: sequence, slot: slot);
    return retain_seam_item(context: context, item: item);
  }
  return True();
}

fn retain_source_seam_at(context: &Context, steps: &[ContextStep], depth: u64, owner: u32, before: Flow, removed: Flow, removing: Bool, ending: Bool) -> ready: Bool reads(context), reads(steps) {
  doc "Resolves the retained source owner and rejects incomplete adjacent inline or split source before repair.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      if context^.slot == route.parent {
        if context^.children.inner[child].slot == route.slot {
          let next = depth +sat 1_u64;
          return retain_source_seam_at(context: &context^.children.inner[child], steps: steps, depth: next, owner: owner, before: before, removed: removed, removing: removing, ending: ending);
        }
      }
    }
    return False();
  }
  let visits = no_boundary_visits();
  let selected = no_index;
  if removing {
    let handle = splice_handle(context: context, item: removed, visits: &visits);
    if handle.owner != owner {
      return False();
    }
    if handle.slot == no_index {
      return False();
    }
    set selected = handle.slot;
  } else if ending {
  } else {
    let handle = splice_handle(context: context, item: before, visits: &visits);
    if handle.owner != owner {
      return False();
    }
    if handle.slot == no_index {
      return False();
    }
    set selected = handle.slot;
  }
  if owner == no_index {
    return retain_sequence_seam(context: context, sequence: &context^.entries, selected: selected, removing: removing);
  }
  let at = cvt::<u32, u64>(owner);
  if at < context^.blocks.inner.len {
    if context^.blocks.inner[at].split_head {
      return False();
    }
    return retain_sequence_seam(context: context, sequence: &context^.blocks.inner[at].entries, selected: selected, removing: removing);
  }
  return False();
}

fn retain_frontier_payload_at(context: &Context, steps: &[ContextStep], depth: u64, block: u32, node: u32, styles: &Styles) -> supported: Bool reads(context), reads(steps), reads(styles) {
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      if context^.slot == route.parent {
        if context^.children.inner[child].slot == route.slot {
          let next = depth +sat 1_u64;
          return retain_frontier_payload_at(context: &context^.children.inner[child], steps: steps, depth: next, block: block, node: node, styles: styles);
        }
      }
    }
    return False();
  }
  if block == no_index {
    let own = context^.style.element == node;
    let flow = context^.kind == ctx_flow;
    let named = band(own, flow);
    let group = box_of(styles: styles, style: context^.style);
    let no = False();
    let current_kind = inner_kind(display: group.display, replaced: no);
    if current_kind != ctx_flow {
      return False();
    }
    let independent = establishes(group: group);
    let columns = multicol(styles: styles, style: context^.style);
    let plain = group.position != position_absolute;
    let unfixed = group.position != position_fixed;
    let not_floated = group.float == float_none;
    let positioned = band(plain, unfixed);
    let ordinary = band(positioned, not_floated);
    let complete = bnot(context^.split_head);
    let uncolumned = bnot(columns);
    let stable_kind = band(independent, uncolumned);
    let source = band(complete, context^.neutral);
    let same = band(named, ordinary);
    let safe = band(stable_kind, source);
    return band(same, safe);
  }
  let at = cvt::<u32, u64>(block);
  if at < context^.blocks.inner.len {
    let held = &context^.blocks.inner[at];
    if held^.style.element != node {
      return False();
    }
    if held^.split_head {
      return False();
    }
    if held^.neutral {
    } else {
      return False();
    }
    let group = box_of(styles: styles, style: held^.style);
    if group.display != display_block {
      return False();
    }
    if group.position == position_absolute {
      return False();
    }
    if group.position == position_fixed {
      return False();
    }
    if group.float != float_none {
      return False();
    }
    let independent = establishes(group: group);
    if independent {
      return False();
    }
    let columns = multicol(styles: styles, style: held^.style);
    if columns {
      return False();
    }
    return True();
  }
  return False();
}

fn retain_source_frontier(layout: &Layout, document: &Document, styles: &Styles, traversal: &Traversal, changed: &[u32], edit: u32) -> supported: Bool reads(layout), reads(document), reads(styles), reads(traversal), reads(changed) {
  doc "Proves construction correspondence for the existing sparse outside style frontier without borrowing retained geometry. A boxes-only ordinary complete block can change geometry while retaining its source ownership. Other outside consumers require wider checkpoint work and refuse source retention.";
  let count = changed^.len;
  let supported = True();
  for (k in 0_u64..count) {
    let bare = iand(changed^[k], 2147483647_u32);
    let index = cvt::<u32, u64>(bare);
    if index < traversal^.elements.inner.len {
      let node = traversal^.elements.inner[index];
      let at = cvt::<u32, u64>(node.index);
      let ancestor = cvt::<u32, u64>(edit);
      let within = inside_element(document: document, node: at, element: ancestor);
      if within {
      } else {
        let boxes_only = iand(changed^[k], changed_boxes_only);
        if boxes_only == 0_u32 {
          set supported = False();
        } else {
          let owner = splice_owner(layout: layout, node: node);
          let frontier_supported = match path_steps(layout: layout, serial: owner.serial) {
            Ok(value: steps) => {
              let depth = steps.inner.len;
              give retain_frontier_payload_at(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, block: owner.block, node: node.index, styles: styles);
            }
            Err(..) => {
              give False();
            }
          }
          set supported = band(supported, frontier_supported);
        }
      }
    } else {
      set supported = False();
    }
  }
  return supported;
}

fn structure_retain_source(layout: &Layout, document: &Document, styles: &Styles, traversal: &Traversal, atoms: &AtomTable, changed: &[u32], parent: NodeId, before: Option<NodeId>, inserted: Option<NodeId>, removed: Option<NodeId>, references_stable: Bool, fonts: &FontSet, picks: &FontPicks) -> result: Result<Bool, LayoutError> reads(document), reads(styles), reads(traversal), reads(atoms), reads(changed), reads(fonts), reads(picks), writes(layout) {
  doc "After an unpublished splice refusal, repairs a neutral complete source seam and runs ordinary geometry over the retained tree. Exact source identities and the complete sparse outside frontier precede private construction, route preparation and marking. No geometry guard from structure_splice is relaxed. Every recoverable source or route refusal precedes source publication.";
  let not_retained = False();
  if references_stable {
  } else {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  if document^.nodes.inner.len > item_ceiling {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  let parent_style = element_ref(element: parent.index);
  let parent_group = box_of(styles: styles, style: parent_style);
  if parent_group.display == display_contents {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  let owner = splice_owner(layout: layout, node: parent);
  if owner.serial == no_index {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  let removing = match removed {
    Some(..) => {
      give True();
    }
    None() => {
      give False();
    }
  }
  let inserting = match inserted {
    Some(..) => {
      give True();
    }
    None() => {
      give False();
    }
  }
  let same_kind = removing == inserting;
  if same_kind {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  let steps = propagate path_steps(layout: layout, serial: owner.serial);
  let depth = steps.inner.len;
  let visits = no_boundary_visits();
  let edit = match inserted {
    Some(value: node) => {
      give node.index;
    }
    None() => {
      match removed {
        Some(value: node) => {
          give node.index;
        }
        None() => {
          return Ok<Bool, LayoutError>(value: not_retained);
        }
      }
    }
  }
  let frontier_ready = retain_source_frontier(layout: layout, document: document, styles: styles, traversal: traversal, changed: changed, edit: edit);
  if frontier_ready {
  } else {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  let ending = match before {
    Some(..) => {
      give False();
    }
    None() => {
      give True();
    }
  }
  let before_item = splice_source(layout: layout, node: before, serial: owner.serial);
  let removed_item = splice_source(layout: layout, node: removed, serial: owner.serial);
  let input = match retain_source_inputs(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, owner: owner.block, before: before_item, removed: removed_item, ending: ending, removing: removing, styles: styles, visits: &visits) {
    Ok(value: found) => {
      give found;
    }
    Err(error: reason) => {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
  }
  let seam_ready = retain_source_seam_at(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, owner: owner.block, before: before_item, removed: removed_item, removing: removing, ending: ending);
  if seam_ready {
  } else {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  if input.allocated >= 1073741824_u32 {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  if removing {
    let named = retained_named_at(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, item: removed_item, node: edit, styles: styles);
    if named {
    } else {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
  }
  let skipped_nodes = box_slots_new::<u32>(capacity: 0_u64);
  let fresh = propagate prepare_splice_source(document: document, styles: styles, atoms: atoms, inserted: inserted, input: input, fonts: fonts, picks: picks, viewport: layout^.viewport, skipped_nodes: &skipped_nodes);
  let added = empty_output();
  let item = Flow::Close(block: no_index);
  if inserting {
    if fresh.neutral {
    } else {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
    if fresh.splits.inner.len > 0_u64 {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
    let total_field = False();
    let output = boundary_output(sequence: &fresh.entries, slot: fresh.entries.root, own: total_field, visits: &visits);
    if output.count != 1_u64 {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
    let first = splice_payload(sequence: &fresh.entries, slot: fresh.entries.root, visits: &visits);
    let named = retained_named_item(context: &fresh, item: first, node: edit, styles: styles);
    if named {
    } else {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
    let reason = retain_source_boundary(context: &fresh, item: first, removing: removing, visits: &visits);
    if reason != 0_u32 {
      return Ok<Bool, LayoutError>(value: not_retained);
    }
    let remapped_output = relocate_output(output: output, block_base: input.blocks, owner: input.owner, slot: input.allocated);
    let old_y = splice_payload_y(context: &fresh, item: first);
    let reverse_y = 0_i64 -sat old_y;
    let normalized = shift_motion(output: remapped_output, delta: reverse_y);
    set added = normalized;
    let remapped_item = relocate_flow(item: first, blocks: input.blocks, paragraphs: input.paragraphs, children: input.children);
    set item = remapped_item;
  }
  let new_blocks = layout_pool_fits(base: input.blocks, added: fresh.blocks.inner.len);
  let new_paragraphs = layout_pool_fits(base: input.paragraphs, added: fresh.paragraphs.inner.len);
  let new_children = layout_pool_fits(base: input.children, added: fresh.children.inner.len);
  let first_pools = band(new_blocks, new_paragraphs);
  let fits = band(first_pools, new_children);
  if fits {
  } else {
    return Ok<Bool, LayoutError>(value: not_retained);
  }
  let root = if 0_u64 < traversal^.elements.inner.len {
    give traversal^.elements.inner[0_u64].index;
  } else {
    give no_index;
  }
  let skipped_count = skipped_nodes.inner.len;
  let patch = propagate prepare_source_routes(layout: layout, fresh: &fresh, input: input, removed: removed_item, removing: removing, document: document, node: inserted, root: root, skipped: &skipped_nodes.inner[0_u64..skipped_count]);
  let removed_nodes = box_slots_new::<u32>(capacity: 0_u64);
  match removed {
    Some(value: node) => {
      let listed = propagate splice_dom_nodes(document: document, node: node, nodes: &removed_nodes);
    }
    None() => {
    }
  }
  let (private_contexts, added_paragraphs) = count_tree(context: &fresh);
  let added_contexts = private_contexts -sat 1_u64;
  let retired = retain_source_retired_at(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, item: removed_item, removing: removing, visits: &visits);
  let closure_marked = propagate styles_restyled(layout: layout, traversal: traversal, changed: changed);
  let yes = True();
  let no = False();
  let source_marked = propagate mark_use(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, restyle_target: yes, block: no_index, restyle_parent: yes, paragraph: no_index, element: edit, root: root, strut: no);
  let prepared = count_marked(context: &layout^.root);
  let prepared_ok = prepare_marked(context: &layout^.root, document: document, styles: styles, fonts: fonts, picks: picks);
  if prepared_ok {
  } else {
    let failure = LayoutError::Text();
    return Err<Bool, LayoutError>(error: failure);
  }
  relocate_splice(fresh: &fresh, input: input, y: 0_i64);
  let retired_count = retired.inner.len;
  let (lost_contexts, lost_paragraphs) = publish_retained_source(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, input: input, fresh: &fresh, item: item, added: added, retired: &retired.inner[0_u64..retired_count], removing: removing, paths: &layout^.paths, visits: &visits);
  let removed_count = removed_nodes.inner.len;
  publish_splice_routes(layout: layout, patch: &patch, removed_nodes: &removed_nodes.inner[0_u64..removed_count]);
  let kept_contexts = layout^.contexts -sat lost_contexts;
  let kept_paragraphs = layout^.paragraphs -sat lost_paragraphs;
  set layout^.contexts = kept_contexts +sat added_contexts;
  set layout^.paragraphs = kept_paragraphs +sat added_paragraphs;
  lay_out(layout: layout, document: document, styles: styles, fonts: fonts, picks: picks);
  let entries = retained_geometry_entries(context: &layout^.root);
  clear_retained_marks(context: &layout^.root);
  set layout^.dirty = False();
  let total_prepared = prepared +sat added_paragraphs;
  let counts = UpdateCounts(prepared: total_prepared, work: visits, contexts: layout^.contexts, paragraphs: layout^.paragraphs, held_entries: 0_u64, entries: entries);
  set layout^.pending_structure = counts;
  set layout^.last_structure = StructureCounts(contexts: added_contexts, paragraphs: added_paragraphs, reused: 0_u64);
  let source_retained = True();
  return Ok<Bool, LayoutError>(value: source_retained);
}

fn retain_source_retired_at(context: &Context, steps: &[ContextStep], depth: u64, item: Flow, removing: Bool, visits: &BoundaryVisits) -> made: Box<Slots<Flow>> reads(context), reads(steps), writes(visits) {
  doc "Collects the edited owner's removed payload identities while their old source is live. Recursive descent depends only on the checked exact context path.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      let next = depth +sat 1_u64;
      return retain_source_retired_at(context: &context^.children.inner[child], steps: steps, depth: next, item: item, removing: removing, visits: visits);
    }
  }
  let made = box_slots_new::<Flow>(capacity: 0_u64);
  if removing {
    removed_entries(context: context, item: item, items: &made, visits: visits);
  }
  return move made;
}

fn retain_source_membership(context: &Context, owner: u32, visits: &BoundaryVisits) -> result: unit writes(context), writes(visits) {
  doc "Repairs virtual event weights along the source owner's parent chain before ordinary geometry enumerates the retained stream. Each parent's event weight depends on the completed child sequence; geometry fields are temporary and receive no reuse permission.";
  let cursor = owner;
  let limit = context^.blocks.inner.len;
  for (level in 0_u64..limit) {
    if cursor == no_index {
      return unit;
    }
    let at = cvt::<u32, u64>(cursor);
    if at < context^.blocks.inner.len {
    } else {
      return unit;
    }
    let root = context^.blocks.inner[at].entries.root;
    let no = False();
    let inside = boundary_output(sequence: &context^.blocks.inner[at].entries, slot: root, own: no, visits: visits);
    let measured = context^.blocks.inner[at].output;
    let outgoing = lift_block_output(inside: &inside, measured: measured);
    set context^.blocks.inner[at].boundary = outgoing;
    let parent = context^.blocks.inner[at].parent;
    let slot = context^.blocks.inner[at].entry_slot;
    if parent == no_index {
      boundary_set(sequence: &context^.entries, slot: slot, output: outgoing, visits: visits);
    } else {
      let up = cvt::<u32, u64>(parent);
      if up < context^.blocks.inner.len {
        boundary_set(sequence: &context^.blocks.inner[up].entries, slot: slot, output: outgoing, visits: visits);
      }
    }
    set cursor = parent;
  }
  return unit;
}

fn publish_retained_source(context: &Context, steps: &[ContextStep], depth: u64, input: SpliceInput, fresh: &Context, item: Flow, added: SequenceOutput, retired: &[Flow], removing: Bool, paths: &RouteTable<ContextPath>, visits: &BoundaryVisits) -> (lost_contexts: u64, lost_paragraphs: u64) reads(steps), reads(retired), writes(context), writes(fresh), writes(paths), writes(visits) {
  doc "Publishes source topology exactly once after private preflight. The checked owner sequence receives the seam mutation; payload publication and retirement depend on its final membership. sg-inverse-proof-gap withholds parallel permission for the reused independent per-destination payload and retirement loops; no extra serial order or uniqueness check is introduced.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      let next = depth +sat 1_u64;
      let (lost_contexts, lost_paragraphs) = publish_retained_source(context: &context^.children.inner[child], steps: steps, depth: next, input: input, fresh: fresh, item: item, added: added, retired: retired, removing: removing, paths: paths, visits: visits);
      return lost_contexts, lost_paragraphs;
    }
    return 0_u64, 0_u64;
  }
  if input.owner == no_index {
    commit_splice_sequence(sequence: &context^.entries, input: input, item: item, added: added, removing: removing, visits: visits);
  } else {
    let at = cvt::<u32, u64>(input.owner);
    if at < context^.blocks.inner.len {
      commit_splice_sequence(sequence: &context^.blocks.inner[at].entries, input: input, item: item, added: added, removing: removing, visits: visits);
    }
  }
  publish_splice_payloads(context: context, fresh: fresh);
  let (lost_contexts, lost_paragraphs) = retire_splice_payloads(context: context, items: retired, paths: paths);
  retain_source_membership(context: context, owner: input.owner, visits: visits);
  return lost_contexts, lost_paragraphs;
}

fn retained_geometry_entries(context: &Context) -> count: u64 reads(context) {
  doc "An ordinary-pass work bound including each live context's logical events. Independent child counts reduce after the current source graph is settled.";
  if context^.retired {
    return 0_u64;
  }
  let count = flow_length(context: context);
  let children = context^.children.inner.len;
  for (at in 0_u64..children) {
    let below = retained_geometry_entries(context: &context^.children.inner[at]);
    set count = count +sat below;
  }
  return count;
}

fn clear_retained_marks(context: &Context) -> result: unit writes(context) {
  doc "Clears consumed marks after complete ordinary geometry. Child iterations have disjoint payload destinations; sg-inverse-proof-gap withholds parallel permission for the existing storage's routed publication, not an added sequential dependency.";
  clear_marks(context: context);
  set context^.dirty = False();
  set context^.restyled = False();
  set context^.restyled_blocks = 0_u32;
  set context^.restyled_block = no_index;
  let children = context^.children.inner.len;
  for (at in 0_u64..children) {
    clear_retained_marks(context: &context^.children.inner[at]);
  }
  return unit;
}

fn retained_named_style(style: StyleRef, node: u32, styles: &Styles) -> named: Bool reads(styles) {
  doc "A source-retention root is a named complete block, never an anonymous, inline, hidden or contents-only source.";
  if style.element != node {
    return False();
  }
  if style.pseudo != no_pseudo {
    return False();
  }
  if style.anonymous {
    return False();
  }
  let group = box_of(styles: styles, style: style);
  let inline = is_inline_level(display: group.display);
  if inline {
    return False();
  }
  if group.display == display_contents {
    return False();
  }
  if group.display == display_none {
    return False();
  }
  return True();
}

fn retained_named_item(context: &Context, item: Flow, node: u32, styles: &Styles) -> named: Bool reads(context), reads(styles) {
  doc "Certifies the actual routed source root's identity before any source seam publication.";
  match item {
    Open(block: source_block) => {
      let at = cvt::<u32, u64>(source_block);
      if at < context^.blocks.inner.len {
        return retained_named_style(style: context^.blocks.inner[at].style, node: node, styles: styles);
      }
    }
    Child(context: source_child) => {
      let at = cvt::<u32, u64>(source_child);
      if at < context^.children.inner.len {
        return retained_named_style(style: context^.children.inner[at].style, node: node, styles: styles);
      }
    }
    Float(context: source_child) => {
      let at = cvt::<u32, u64>(source_child);
      if at < context^.children.inner.len {
        return retained_named_style(style: context^.children.inner[at].style, node: node, styles: styles);
      }
    }
    Text(..) => {
    }
    Close(..) => {
    }
    Out(..) => {
    }
  }
  return False();
}

fn retained_named_at(context: &Context, steps: &[ContextStep], depth: u64, item: Flow, node: u32, styles: &Styles) -> named: Bool reads(context), reads(steps), reads(styles) {
  doc "Copies only the exact old source-root identity along the preflighted context path.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      let next = depth +sat 1_u64;
      return retained_named_at(context: &context^.children.inner[child], steps: steps, depth: next, item: item, node: node, styles: styles);
    }
    return False();
  }
  return retained_named_item(context: context, item: item, node: node, styles: styles);
}
