alias Styles = pkg::style::Styles;

fn fragment_range_join(splits: &[Split], left: FragmentRange, right: FragmentRange) -> made: FragmentRange reads(splits) {
  doc "Combines dependency extrema by current source order; certified structural edits preserve that order and the endpoint lifetimes.";
  if left.first == no_index {
    return right;
  }
  if right.first == no_index {
    return left;
  }
  let first = left.first;
  let last = left.last;
  let left_first = cvt::<u32, u64>(left.first);
  let right_first = cvt::<u32, u64>(right.first);
  let left_last = cvt::<u32, u64>(left.last);
  let right_last = cvt::<u32, u64>(right.last);
  if left_first < splits^.len {
    if right_first < splits^.len {
      if splits^[right_first].open < splits^[left_first].open {
        set first = right.first;
      }
    }
  }
  if left_last < splits^.len {
    if right_last < splits^.len {
      if splits^[right_last].close > splits^[left_last].close {
        set last = right.last;
      }
    }
  }
  return FragmentRange(first: first, last: last);
}

fn fill_fragment_ranges(anchors: &[FragmentAnchor], splits: &[Split], ranges: &[FragmentRange]) -> made: FragmentRange reads(anchors), reads(splits), writes(ranges) {
  doc "Builds a balanced postorder interval tree. Independent halves write disjoint slices; only their parent extrema wait for both results.";
  let count = anchors^.len;
  let empty = FragmentRange(first: no_index, last: no_index);
  if count == 0_u64 {
    return empty;
  }
  if count == 1_u64 {
    if 0_u64 < anchors^.len {
      let anchor = anchors^[0_u64];
      let made = if anchor.mode == 0_u8 {
        give empty;
      } else {
        give FragmentRange(first: anchor.split, last: anchor.last_split);
      }
      if 0_u64 < ranges^.len {
        set ranges^[0_u64] = made;
      }
      return made;
    }
    return empty;
  }
  let half = count / 2_u64;
  let twice = half +sat half;
  let left_nodes = twice -sat 1_u64;
  let nodes = ranges^.len;
  let root = nodes -sat 1_u64;
  if half <= count {
    if left_nodes <= root {
      if root < nodes {
        let left = fill_fragment_ranges(anchors: &anchors^[0_u64..half], splits: splits, ranges: &ranges^[0_u64..left_nodes]);
        let right = fill_fragment_ranges(anchors: &anchors^[half..count], splits: splits, ranges: &ranges^[left_nodes..root]);
        let joined = fragment_range_join(splits: splits, left: left, right: right);
        set ranges^[root] = joined;
        return joined;
      }
    }
  }
  return empty;
}

fn build_fragment_ranges(context: &Context) -> result: unit writes(context) {
  doc "Publishes the dependency tree once per fragment topology. Split slot extrema survive admitted structural rank changes, so unrelated edits do not rebuild the tree.";
  if context^.fragment_ranges.inner.len > 0_u64 {
    return unit;
  }
  let count = context^.fragment_anchors.inner.len;
  let twice = count +sat count;
  let nodes = twice -sat 1_u64;
  let empty = FragmentRange(first: no_index, last: no_index);
  let ranges = box_array_filled::<FragmentRange>(count: nodes, value: empty);
  let splits = context^.splits.inner.len;
  let filled = fill_fragment_ranges(anchors: &context^.fragment_anchors.inner[0_u64..count], splits: &context^.splits.inner[0_u64..splits], ranges: &ranges.inner[0_u64..nodes]);
  set context^.fragment_ranges = move ranges;
  return unit;
}

fn repair_fragment_margin(context: &Context, styles: &Styles, item: Flow, basis: i32) -> made: i32 reads(context.blocks.inner), reads(context.children.inner), reads(styles) {
  doc "Reads the exact trailing-margin dependency: a block style resolved with the first split width, or an independent child's already resolved bottom margin.";
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        let style = context^.blocks.inner[at].style;
        let margins = margin_edges(styles: styles, style: style, basis: basis);
        return margins.bottom;
      }
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        return context^.children.inner[at].margin_bottom;
      }
    }
    Close(..) => {
    }
    Text(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  return 0_i32;
}

fn repair_fragment_cell(context: &Context, styles: &Styles, content_left: i32, fragment: &Fragment, anchor: &FragmentAnchor) -> result: unit reads(context.blocks.inner), reads(context.children.inner), reads(context.splits.inner), reads(context.local_geometry), reads(context.content_dy), reads(styles), writes(fragment), writes(anchor) {
  doc "Repairs one stable run role from its actual endpoint, width, pending line and margin inputs after placement. No owner/rectangle matching or unrelated run reconstruction occurs.";
  let split_at = cvt::<u32, u64>(anchor^.split);
  if split_at < context^.splits.inner.len {
  } else {
    return unit;
  }
  let split = context^.splits.inner[split_at];
  let none = slots_new::<Origin, 0>();
  let (normal, top, first_bottom) = fragment_endpoint(context: context, origins: &none[0_u64..0_u64], item: anchor^.first);
  let (last_normal, last_top, bottom) = fragment_endpoint(context: context, origins: &none[0_u64..0_u64], item: anchor^.last);
  set fragment^.x = content_left +sat split.left;
  if anchor^.mode == 3_u8 {
    set fragment^.y = top;
    set fragment^.width = split.width;
    set fragment^.height = bottom -sat top;
  } else if anchor^.mode == 4_u8 {
    let margin = repair_fragment_margin(context: context, styles: styles, item: anchor^.last, basis: split.width);
    set anchor^.margin = margin;
    set fragment^.y = bottom +sat margin;
  } else {
    let resolved_line = split_reference_line(context: context, split: split);
    let has_line = resolved_line != no_line;
    let use_line = band(anchor^.leading_line, has_line);
    if use_line {
      set fragment^.y = resolved_line;
      set anchor^.mode = 2_u8;
    } else {
      set fragment^.y = top;
      set anchor^.mode = 1_u8;
    }
  }
  return unit;
}

fn repair_fragment_range(context: &Context, styles: &Styles, content_left: i32, from: u64, until: u64, ranges: &[FragmentRange], fragments: &[Fragment], anchors: &[FragmentAnchor]) -> valid: Bool reads(context.blocks.inner), reads(context.children.inner), reads(context.splits.inner), reads(context.local_geometry), reads(context.content_dx), reads(context.content_dy), reads(styles), reads(ranges), writes(fragments), writes(anchors) {
  doc "Looks up affected dependency intervals and repairs disjoint rectangle/anchor slices independently, certifying each leaf immediately and joining only the resulting booleans. A keeps translated suffix roles anchored; only intervals intersecting the replayed range need rectangle or metadata repair.";
  let nodes = ranges^.len;
  if nodes == 0_u64 {
    return True();
  }
  let root = nodes - 1_u64;
  let range = ranges^[root];
  let low_at = cvt::<u32, u64>(range.first);
  let high_at = cvt::<u32, u64>(range.last);
  if low_at < context^.splits.inner.len {
    if high_at < context^.splits.inner.len {
      let low = cvt::<u32, u64>(context^.splits.inner[low_at].open);
      let high = cvt::<u32, u64>(context^.splits.inner[high_at].close);
      if low > until {
        return True();
      }
      if high < from {
        return True();
      }
    } else {
      return False();
    }
  } else {
    return True();
  }
  let count = fragments^.len;
  if count == 1_u64 {
    if 0_u64 < fragments^.len {
      if 0_u64 < anchors^.len {
        repair_fragment_cell(context: context, styles: styles, content_left: content_left, fragment: &fragments^[0_u64], anchor: &anchors^[0_u64]);
        let raw = fragments^[0_u64];
        let anchor = anchors^[0_u64];
        let no_origins = slots_new::<Origin, 0>();
        let resolved = anchored_fragment_value(context: context, origins: &no_origins[0_u64..0_u64], raw: raw, anchor: anchor);
        let same = fragment_representation_same(raw: raw, resolved: resolved, dx: context^.content_dx, dy: context^.content_dy);
        return same;
      }
    }
    return False();
  }
  let half = count / 2_u64;
  let twice = half +sat half;
  let left_nodes = twice -sat 1_u64;
  if half <= count {
    if count <= anchors^.len {
      if left_nodes <= root {
        let left = repair_fragment_range(context: context, styles: styles, content_left: content_left, from: from, until: until, ranges: &ranges^[0_u64..left_nodes], fragments: &fragments^[0_u64..half], anchors: &anchors^[0_u64..half]);
        let right = repair_fragment_range(context: context, styles: styles, content_left: content_left, from: from, until: until, ranges: &ranges^[left_nodes..root], fragments: &fragments^[half..count], anchors: &anchors^[half..count]);
        return band(left, right);
      }
    }
  }
  return False();
}

fn repair_anchored_fragments(context: &Context, styles: &Styles, content_left: i32, from: u64, until: u64, delta: i32) -> repaired: Bool reads(styles), writes(context) {
  doc "Reuses certified run topology after a replay that preserved line presence and marks. The source interval index selects changed or translated runs. Unchanged prefix certificates survive identical inputs; selected rectangles receive the same raw-versus-anchor equality check as the full publisher. Split offsets are published only for openings in the replayed source range; exact suffix motion retains their owner-relative values.";
  if context^.fragments_valid {
  } else {
    return False();
  }
  let count = context^.fragments.inner.len;
  if count == context^.fragment_anchors.inner.len {
  } else {
    return False();
  }
  let split_count = context^.splits.inner.len;
  let split_from = split_lower_bound(splits: &context^.splits.inner[0_u64..split_count], rank: from);
  let split_until = until +sat 1_u64;
  let split_end = split_lower_bound(splits: &context^.splits.inner[0_u64..split_count], rank: split_until);
  let no_origins = slots_new::<Origin, 0>();
  if split_end <= split_count {
    for (split_at in split_from..split_end) {
      own_split_line(context: context, origins: &no_origins[0_u64..0_u64], split: &context^.splits.inner[split_at]);
    }
  }
  let nodes = context^.fragment_ranges.inner.len;
  if nodes == 0_u64 {
    return False();
  }
  let end = until;
  let valid = repair_fragment_range(context: context, styles: styles, content_left: content_left, from: from, until: end, ranges: &context^.fragment_ranges.inner[0_u64..nodes], fragments: &context^.fragments.inner[0_u64..count], anchors: &context^.fragment_anchors.inner[0_u64..count]);
  set context^.fragments_valid = valid;
  set context^.fragment_repaired = True();
  set context^.fragments_anchored = valid;
  return True();
}

fn split_lower_bound(splits: &[Split], rank: u64) -> found: u64 reads(splits) {
  doc "Finds the first split opening at or after a reference rank. Admitted structural edits preserve split order and the bridge restores ranks before any reference reader.";
  let low = 0_u64;
  let high = splits^.len;
  for (step in 0_u64..64_u64) {
    if low >= high {
      break;
    }
    let distance = high - low;
    let half = distance / 2_u64;
    let middle = low + half;
    if middle < splits^.len {
      let opening = cvt::<u32, u64>(splits^[middle].open);
      if opening < rank {
        set low = middle +sat 1_u64;
      } else {
        set high = middle;
      }
    }
  }
  return low;
}

fn split_reference_line(context: &Context, split: Split) -> line: i32 reads(context.blocks.inner), reads(context.children.inner), reads(context.local_geometry), reads(context.content_dy) {
  doc "Resolves a split's pending line in reference coordinates. A freshly stacked line remains raw until its head settles; an unchanged line reads its exact normal-origin offset. Sentinel identity is preserved.";
  if split.line == no_line {
    return no_line;
  }
  if split.line_dirty {
    return split.line;
  }
  let none = slots_new::<Origin, 0>();
  let (normal, top, bottom) = fragment_endpoint(context: context, origins: &none[0_u64..0_u64], item: split.opening);
  let wide_normal = cvt::<i32, i64>(normal);
  let wide_line = wide_normal +sat split.line_offset;
  return geometry_narrow(value: wide_line);
}
