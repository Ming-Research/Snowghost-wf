alias Styles = pkg::style::Styles;
alias sizing_value = pkg::css::values::sizing_value;
alias break_inside_avoid = pkg::css::values::break_inside_avoid;
alias break_inside_avoid_column = pkg::css::values::break_inside_avoid_column;

struct Unit {
  doc "A part of a multi-column context's content that no column break may split, from top to bottom in the context's border box as laid out in one column.";
  top: i32;
  bottom: i32;
}

fn multicol(styles: &Styles, style: StyleRef) -> columned: Bool reads(styles) {
  doc "Tells whether a box styled style is a multi-column container: its column-count or column-width is not auto (CSS Multi-column 1, 2).";
  if style.anonymous {
    return False();
  }
  let group = container_of(styles: styles, style: style);
  let counted = group.column_count > 0_u32;
  let sized = group.column_width.kind == sizing_value;
  let made = bor(counted, sized);
  return made;
}

fn column_gap_of(styles: &Styles, style: StyleRef, basis: i32) -> gap: i32 reads(styles) {
  doc "The used column gap of a multi-column container: column-gap, or 1em for normal.";
  let group = container_of(styles: styles, style: style);
  if group.column_gap.kind == sizing_value {
    let resolved = resolve_lp(value: group.column_gap.value, basis: basis);
    let made = imax(resolved, 0_i32);
    return made;
  }
  let font = font_of(styles: styles, style: style);
  let made = units(px: font.size);
  return made;
}

fn column_shape(styles: &Styles, style: StyleRef, available: i32) -> (count: i32, width: i32, gap: i32) reads(styles) {
  doc "The used column count and column width of a multi-column container whose content box is available wide (CSS Multi-column 1, 3.4): with only column-count, that many columns share the width; with column-width, as many columns of at least that width as fit, at most column-count when it is set, and at least one; the columns then share the width less the gaps.";
  let group = container_of(styles: styles, style: style);
  let gap = column_gap_of(styles: styles, style: style, basis: available);
  let counted = group.column_count > 0_u32;
  let requested = if counted {
    let bounded = imin(group.column_count, 1000_u32);
    give cvt::<u32, i32>(bounded);
  } else {
    give 1000_i32;
  }
  let sized = group.column_width.kind == sizing_value;
  let fitting = if sized {
    let wanted = resolve_lp(value: group.column_width.value, basis: available);
    let least = imax(wanted, 1_i32);
    let summed = least +sat gap;
    let with_gap = imax(summed, 1_i32);
    let room = available +sat gap;
    let fit = if with_gap > 0_i32 {
      give room / with_gap;
    } else {
      give 1_i32;
    }
    give imax(fit, 1_i32);
  } else {
    give requested;
  }
  let count = imin(requested, fitting);
  let positive = imax(count, 1_i32);
  let gaps_count = positive -sat 1_i32;
  let gaps = gaps_count *sat gap;
  let shared = available -sat gaps;
  let share = if positive > 0_i32 {
    give shared / positive;
  } else {
    give shared;
  }
  let width = imax(share, 0_i32);
  return positive, width, gap;
}

fn avoids_columns(styles: &Styles, style: StyleRef) -> avoided: Bool reads(styles) {
  doc "Tells whether break-inside forbids a column break inside a box styled style: avoid or avoid-column.";
  let group = item_of(styles: styles, style: style);
  let avoid = group.break_inside == break_inside_avoid;
  let avoid_column = group.break_inside == break_inside_avoid_column;
  let made = bor(avoid, avoid_column);
  return made;
}

fn push_unit(pieces_list: &Box<Slots<Unit>>, top: i32, bottom: i32) -> result: unit writes(pieces_list) {
  doc "Appends a unit from top to bottom.";
  let made = Unit(top: top, bottom: bottom);
  let pushed = push_item::<Unit>(cell: pieces_list, value: made, ceiling: item_ceiling);
  return unit;
}

fn collect_units(context: &Context, events: &[Flow], styles: &Styles, pieces_list: &Box<Slots<Unit>>) -> result: unit reads(context), reads(events), reads(styles), writes(pieces_list) {
  doc "Collects column break units in flow order: each paragraph line, each block that avoids column breaks, each row of a table child that permits breaks, and each other child context. An avoiding block contributes one unit instead of its enclosed units; column breaks fall only between units.";
  let skip_depth = 0_u64;
  let depth = 0_u64;
  let flow_count = events^.len;
  for (k in 0_u64..flow_count) {
    if k >= events^.len {
      break;
    }
    let item = events^[k];
    match item {
      Open(block: b) => {
        set depth = depth +sat 1_u64;
        let at = cvt::<u32, u64>(b);
        if skip_depth == 0_u64 {
          if at < context^.blocks.inner.len {
            let block = block_snapshot(block: &context^.blocks.inner[at]);
            let avoided = avoids_columns(styles: styles, style: block.style);
            if avoided {
              let unit_origin = block_position(context: context, at: at);
              let bottom = unit_origin.y +sat block.height;
              push_unit(pieces_list: pieces_list, top: unit_origin.y, bottom: bottom);
              set skip_depth = depth;
            }
          }
        }
      }
      Close(..) => {
        if depth == skip_depth {
          set skip_depth = 0_u64;
        }
        set depth = depth -sat 1_u64;
      }
      Text(paragraph: p) => {
        if skip_depth == 0_u64 {
          let at = cvt::<u32, u64>(p);
          if at < context^.paragraphs.inner.len {
            let lines = context^.paragraphs.inner[at].lines.inner.len;
            let geometry_read_1 = paragraph_position(context: context, at: at);
            let origin = geometry_read_1.y;
            for (l in 0_u64..lines) {
              if at < context^.paragraphs.inner.len {
                if l < context^.paragraphs.inner[at].lines.inner.len {
                  let line = context^.paragraphs.inner[at].lines.inner[l];
                  let top = origin +sat line.top;
                  let bottom = top +sat line.height;
                  push_unit(pieces_list: pieces_list, top: top, bottom: bottom);
                }
              }
            }
          }
        }
      }
      Child(context: c) => {
        if skip_depth == 0_u64 {
          let at = cvt::<u32, u64>(c);
          if at < context^.children.inner.len {
            let child = &context^.children.inner[at];
            let child_origin = child_position(context: context, at: at);
            let avoided = avoids_columns(styles: styles, style: child^.style);
            let table = child^.kind == ctx_table;
            let rows = child^.rows.inner.len;
            let has_rows = rows > 0_u64;
            let open_table = band(table, has_rows);
            let not_avoided = bnot(avoided);
            let by_rows = band(open_table, not_avoided);
            if by_rows {
              for (r in 0_u64..rows) {
                let row = child^.rows.inner[r];
                let top = child_origin.y +sat row.y;
                let bottom = top +sat row.height;
                push_unit(pieces_list: pieces_list, top: top, bottom: bottom);
              }
            } else {
              let bottom = child_origin.y +sat child^.height;
              push_unit(pieces_list: pieces_list, top: child_origin.y, bottom: bottom);
            }
          }
        }
      }
      Float(..) => {
      }
      Out(..) => {
      }
    }
  }
  return unit;
}

fn column_shortage(pieces_list: &[Unit], height: i32, first: i32) -> (count: i32, shortage: i32) reads(pieces_list) {
  doc "The number of columns height tall that the pieces_list fill when each column takes the pieces_list in order while they fit, the first column starting at first, the content box's top, and each later one at the top of its first unit, where the margins before it are truncated; and the least amount by which a unit that moved to a later column overflowed its column, or 2147483647 when none moved.";
  let total = pieces_list^.len;
  if total == 0_u64 {
    return 0_i32, 2147483647_i32;
  }
  let count = 1_i32;
  let start = first;
  let shortage = 2147483647_i32;
  for (k in 0_u64..total) {
    let piece = pieces_list^[k];
    let reach = piece.bottom -sat start;
    let over = reach > height;
    let later = piece.top > start;
    let breaks = band(over, later);
    if breaks {
      let missing = reach -sat height;
      set shortage = imin(shortage, missing);
      set count = count +sat 1_i32;
      set start = piece.top;
    }
  }
  return count, shortage;
}

fn balanced_height(pieces_list: &[Unit], count: i32, first: i32, laid_height: i32) -> height: i32 reads(pieces_list) {
  doc "The column height of balanced columns (CSS Multi-column 1, 7.1: column-fill balance) as the reference finds it: first the content's height laid out in one column, its trailing margins included, divided by count and rounded up to a layout unit; then, while the pieces_list need more than count columns at that height, the height grows by the least amount by which a unit overflowed its column. A unit that overflows only by the trailing margins after it fits, since margins at a column's end are truncated.";
  let total = pieces_list^.len;
  if total == 0_u64 {
    return 0_i32;
  }
  let columns = imax(count, 1_i32);
  let spare = columns -sat 1_i32;
  let rounded = laid_height +sat spare;
  let share = rounded / columns;
  let height = imax(share, 0_i32);
  let attempts = total +sat 1_u64;
  for (step in 0_u64..attempts) {
    let (needed, shortage) = column_shortage(pieces_list: pieces_list, height: height, first: first);
    if needed <= columns {
      break;
    }
    let stretch = imax(shortage, 1_i32);
    set height = height +sat stretch;
  }
  return height;
}

fn fragment_columns(context: &Context, events: &[Flow], styles: &Styles, count: i32, width: i32, gap: i32, content_top: i32, laid_height: i32) -> height: i32 reads(events), reads(styles), writes(context) {
  doc "Splits a multi-column context's content, laid out in one column width wide and laid_height tall, into at most count balanced columns: records the column map that moves each column's pieces_list beside the first, and returns the content height, the columns' height.";
  let pieces_list = box_slots_new::<Unit>(capacity: 64_u64);
  collect_units(context: context, events: events, styles: styles, pieces_list: &pieces_list);
  let total = pieces_list.inner.len;
  if total == 0_u64 {
    return laid_height;
  }
  let height = balanced_height(pieces_list: &pieces_list.inner[0_u64..total], count: count, first: content_top, laid_height: laid_height);
  let step = width +sat gap;
  let column_bottom = content_top +sat height;
  let column = 0_i32;
  let start = content_top;
  let from = -2147483647_i32;
  let shift_x = 0_i32;
  let shift_y = 0_i32;
  for (k in 0_u64..total) {
    let piece = pieces_list.inner[k];
    let reach = piece.bottom -sat start;
    let over = reach > height;
    let later = piece.top > start;
    let breaks = band(over, later);
    if breaks {
      let ended = ColumnPiece(from: from, to: piece.top, dx: shift_x, dy: shift_y, bottom: column_bottom);
      let pushed = push_item::<ColumnPiece>(cell: &context^.column_map, value: ended, ceiling: item_ceiling);
      set column = column +sat 1_i32;
      set start = piece.top;
      set from = piece.top;
      set shift_x = column *sat step;
      set shift_y = content_top -sat piece.top;
    }
  }
  let final_piece = ColumnPiece(from: from, to: 2147483647_i32, dx: shift_x, dy: shift_y, bottom: column_bottom);
  let pushed_last = push_item::<ColumnPiece>(cell: &context^.column_map, value: final_piece, ceiling: item_ceiling);
  return height;
}

fn column_replay_ready(context: &Context, styles: &Styles, frame: FlowFrame, unasked: Bool) -> ready: Bool reads(context), reads(styles) {
  doc "Admits one dirty paragraph with no changed blocks or child outputs after checking the completed outer preparation inputs. Column balancing still consumes every updated unit.";
  if context^.restyled_blocks != 0_u32 {
    return False();
  }
  if context^.marked_children != 0_u32 {
    return False();
  }
  if context^.marked_paragraphs != 1_u32 {
    return False();
  }
  return column_inputs_unchanged(context: context, styles: styles, frame: frame, unasked: unasked);
}

fn column_inputs_unchanged(context: &Context, styles: &Styles, frame: FlowFrame, unasked: Bool) -> ready: Bool reads(context), reads(styles) {
  doc "Checks the completed outer preparation key, independently of which consumers are dirty. Paragraph replay separately excludes changed blocks and children; block replay separately certifies their closed scope, widths and old/new percentage reads. Neither caller reuses a column map.";
  if frame.columned {
  } else {
    return False();
  }
  if unasked {
  } else {
    return False();
  }
  if context^.flow_inputs.valid {
  } else {
    return False();
  }
  if context^.boundary_dirty {
    return False();
  }
  if context^.restyled {
    return False();
  }
  if context^.has_out {
    return False();
  }
  if context^.space.shrink {
    return False();
  }
  if context^.intrinsic_known {
    return False();
  }
  if context^.intrinsic_held {
    return False();
  }
  if context^.definite_free {
  } else {
    return False();
  }
  let own_relative = height_relative(styles: styles, style: context^.style);
  if own_relative {
    return False();
  }
  let saved = context^.flow_inputs;
  if same_space(first: context^.space, second: saved.space) {
  } else {
    return False();
  }
  if context^.width != saved.width {
    return False();
  }
  if saved.frame.columned {
  } else {
    return False();
  }
  if frame.content_left != saved.frame.content_left {
    return False();
  }
  if frame.content_top != saved.frame.content_top {
    return False();
  }
  if frame.flow_width != saved.frame.flow_width {
    return False();
  }
  if frame.definite != saved.frame.definite {
    return False();
  }
  if frame.column_count != saved.frame.column_count {
    return False();
  }
  if frame.column_width != saved.frame.column_width {
    return False();
  }
  if frame.column_gap != saved.frame.column_gap {
    return False();
  }
  return True();
}

fn reflow_column_height(context: &Context, events: &[Flow], styles: &Styles, frame: FlowFrame, laid_height: i32) -> height: i32 reads(events), reads(styles), writes(context) {
  doc "Rebalances all column units after scoped normal-flow replay. The complete column map is rebuilt even when the used column count is one; unchanged outer size never licenses retaining the old map.";
  clear_column_map(context: context);
  if events^.len == 0_u64 {
    let materialized = materialize_flow(context: context);
    let count = materialized.inner.len;
    return fragment_columns(context: context, events: &materialized.inner[0_u64..count], styles: styles, count: frame.column_count, width: frame.column_width, gap: frame.column_gap, content_top: frame.content_top, laid_height: laid_height);
  }
  return fragment_columns(context: context, events: events, styles: styles, count: frame.column_count, width: frame.column_width, gap: frame.column_gap, content_top: frame.content_top, laid_height: laid_height);
}
