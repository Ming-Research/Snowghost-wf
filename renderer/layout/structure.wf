  let kept = retained_outside(old: old, new: new, traversal: traversal);
  if kept {
  } else {
    let owned_result_2 = inconsistent::<unit>();
    return owned_result_2;
  }
  let at = cvt::<u32, u64>(parent.index);
  let element = nodes;
  let serial = no_index;
  for (step in 0_u64..nodes) {
    if at >= nodes {
      break;
    }
    let held = if at < layout^.context_of.inner.len {
      give layout^.context_of.inner[at];
    } else {
      give no_index;
    }
    if held != no_index {
      set element = at;
      set serial = held;
      break;
    }
    let owned_result_3 = parent_of(document: document, node: at);
    set at = owned_result_3;
  }
  if serial == no_index {
    let owned_result_4 = inconsistent::<unit>();
    return owned_result_4;
  }
  let outside = changed_outside(document: document, old: old, new: new, changed: changed, element: element);
  if outside {
    let owned_result_5 = inconsistent::<unit>();
    return owned_result_5;
  }
  let base = propagate path_steps(layout: layout, serial: serial);
  let base_count = base.inner.len;
  let rebuild = propagate rebuild_of(context: &layout^.root, steps: &base.inner[0_u64..base_count], depth: 0_u64);
