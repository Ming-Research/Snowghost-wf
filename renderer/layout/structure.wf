alias AtomTable = pkg::base::atom::AtomTable;
alias atom_find = pkg::base::atom::atom_find;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Styles = pkg::style::Styles;
alias Traversal = pkg::style::Traversal;

struct Rebuild {
  doc "What structure_changed reads of the context it builds again: its kind, its style and the walk's state as build_box entered and left it.";
  kind: u8;
  style: StyleRef;
  entered: WalkPoint;
  left: WalkPoint;
}

fn empty_point() -> made: WalkPoint pure {
  doc "A walk point with no counter in scope, quote depth 0 and depth 0, which the contexts build_box does not make keep.";
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  return WalkPoint(counters: move counters, quote_depth: 0_i32, depth: 0_u64);
}

fn copy_point(point: &WalkPoint) -> made: WalkPoint reads(point) {
  doc "A copy of point.";
  let count = point^.counters.inner.len;
  let reserve = imin(count, item_ceiling);
  let counters = box_slots_new::<Counter>(capacity: reserve);
  for (k in 0_u64..count) {
    let counter = point^.counters.inner[k];
    let pushed = push_item::<Counter>(cell: &counters, value: counter, ceiling: item_ceiling);
  }
  return WalkPoint(counters: move counters, quote_depth: point^.quote_depth, depth: point^.depth);
}

fn walk_point(walk: &Walk) -> made: WalkPoint reads(walk) {
  doc "The walk's counters in scope, quote depth and depth, copied.";
  let count = walk^.counters.inner.len;
  let reserve = imin(count, item_ceiling);
  let counters = box_slots_new::<Counter>(capacity: reserve);
  for (k in 0_u64..count) {
    let counter = walk^.counters.inner[k];
    let pushed = push_item::<Counter>(cell: &counters, value: counter, ceiling: item_ceiling);
  }
  return WalkPoint(counters: move counters, quote_depth: walk^.quote_depth, depth: walk^.depth);
}

fn restore_point(walk: &Walk, point: &WalkPoint) -> result: unit reads(point), writes(walk) {
  doc "Gives the walk point's counters in scope, quote depth and depth.";
  let restored = copy_point(point: point);
  let WalkPoint(counters: counters, quote_depth: quote_depth, depth: depth) = move restored;
  set walk^.counters = move counters;
  set walk^.quote_depth = quote_depth;
  set walk^.depth = depth;
  return unit;
}

fn same_point(first: &WalkPoint, second: &WalkPoint) -> same: Bool reads(first), reads(second) {
  doc "True when the two points hold the same counters, each with the same name, value and scope depth, the same quote depth and the same depth.";
  let count = first^.counters.inner.len;
  if count != second^.counters.inner.len {
    return False();
  }
  if first^.quote_depth != second^.quote_depth {
    return False();
  }
  if first^.depth != second^.depth {
    return False();
  }
  let equal = True();
  for (k in 0_u64..count) {
    if k < second^.counters.inner.len {
      let a = first^.counters.inner[k];
      let b = second^.counters.inner[k];
      let name = a.name == b.name;
      let value = a.value == b.value;
      let level = a.level == b.level;
      let named = band(name, value);
      let same = band(named, level);
      set equal = band(equal, same);
    }
  }
  return equal;
}

fn same_ref(first: StyleRef, second: StyleRef) -> same: Bool pure {
  doc "True when the two style references name the same element, pseudo-element and anonymity.";
  let element = first.element == second.element;
  let pseudo = first.pseudo == second.pseudo;
  let anonymous = eeq(first.anonymous, second.anonymous);
  let named = band(element, pseudo);
  let same = band(named, anonymous);
  return same;
}

fn same_piece(first: Piece, second: Piece) -> same: Bool pure {
  doc "True when the two pieces are the same variant with equal fields, so that preparation reads the same input from both.";
  match first {
    Bytes(start: a_start, end: a_end, style: a_style, node: a_node) => {
      match second {
        Bytes(start: b_start, end: b_end, style: b_style, node: b_node) => {
          let start = a_start == b_start;
          let end = a_end == b_end;
          let node = a_node == b_node;
          let style = same_ref(first: a_style, second: b_style);
          let span = band(start, end);
          let source = band(node, style);
          let same = band(span, source);
          return same;
        }
        Generated(..) => {
          return False();
        }
        Scalar(..) => {
          return False();
        }
        Begin(..) => {
          return False();
        }
        End(..) => {
          return False();
        }
        Object(..) => {
          return False();
        }
      }
    }
    Generated(start: a_start, end: a_end, style: a_style) => {
      match second {
        Bytes(..) => {
          return False();
        }
        Generated(start: b_start, end: b_end, style: b_style) => {
          let start = a_start == b_start;
          let end = a_end == b_end;
          let style = same_ref(first: a_style, second: b_style);
          let span = band(start, end);
          let same = band(span, style);
          return same;
        }
        Scalar(..) => {
          return False();
        }
        Begin(..) => {
          return False();
        }
        End(..) => {
          return False();
        }
        Object(..) => {
          return False();
        }
      }
    }
    Scalar(value: a_value, style: a_style) => {
      match second {
        Bytes(..) => {
          return False();
        }
        Generated(..) => {
          return False();
        }
        Scalar(value: b_value, style: b_style) => {
          let value = a_value == b_value;
          let style = same_ref(first: a_style, second: b_style);
          let same = band(value, style);
          return same;
        }
        Begin(..) => {
          return False();
        }
        End(..) => {
          return False();
        }
        Object(..) => {
          return False();
        }
      }
    }
    Begin(style: a_style) => {
      match second {
        Bytes(..) => {
          return False();
        }
        Generated(..) => {
          return False();
        }
        Scalar(..) => {
          return False();
        }
        Begin(style: b_style) => {
          let same = same_ref(first: a_style, second: b_style);
          return same;
        }
        End(..) => {
          return False();
        }
        Object(..) => {
          return False();
        }
      }
    }
    End(style: a_style) => {
      match second {
        Bytes(..) => {
          return False();
        }
        Generated(..) => {
          return False();
        }
        Scalar(..) => {
          return False();
        }
        Begin(..) => {
          return False();
        }
        End(style: b_style) => {
          let same = same_ref(first: a_style, second: b_style);
          return same;
        }
        Object(..) => {
          return False();
        }
      }
    }
    Object(context: a_context, style: a_style) => {
      match second {
        Bytes(..) => {
          return False();
        }
        Generated(..) => {
          return False();
        }
        Scalar(..) => {
          return False();
        }
        Begin(..) => {
          return False();
        }
        End(..) => {
          return False();
        }
        Object(context: b_context, style: b_style) => {
          let context = a_context == b_context;
          let style = same_ref(first: a_style, second: b_style);
          let same = band(context, style);
          return same;
        }
      }
    }
  }
}

fn retained_outside(old: &Styles, new: &Styles, traversal: &Traversal) -> same: Bool reads(old), reads(new), reads(traversal) {
  doc "Checks what the contexts outside the one built again keep from old: the style stage's generated text, which Generated pieces index, byte for byte, and every pseudo-element at the same index in the list, of the same element by NodeId and the same kind, which StyleRef.pseudo indexes.";
  let bytes = old^.generated_text.inner.len;
  let pseudos = old^.pseudos.inner.len;
  let same_bytes = bytes == new^.generated_text.inner.len;
  let same_pseudos = pseudos == new^.pseudos.inner.len;
  let same_sizes = band(same_bytes, same_pseudos);
  if same_sizes {
  } else {
    return False();
  }
  let equal = True();
  for (i in 0_u64..bytes) {
    let same = old^.generated_text.inner[i] == new^.generated_text.inner[i];
    set equal = band(equal, same);
  }
  for (i in 0_u64..pseudos) {
    let a = old^.pseudos.inner[i];
    let b = new^.pseudos.inner[i];
    let kind = a.kind == b.kind;
    let position = cvt::<u32, u64>(b.element);
    let owner = if position < traversal^.elements.inner.len {
      let node = cvt::<u32, u64>(traversal^.elements.inner[position].index);
      let empty_slot = node == 4294967295_u64;
      let hole = band(traversal^.stale, empty_slot);
      let listed = if hole {
        give a.element == b.element;
      } else if node < old^.order.inner.len {
        give old^.order.inner[node] == a.element;
      } else {
        give False();
      }
      give listed;
    } else {
      give False();
    }
    let same = band(kind, owner);
    set equal = band(equal, same);
  }
  return equal;
}

fn parent_of(document: &Document, node: u64) -> parent: u64 reads(document) {
  doc "The NodeId index of node's parent, or the number of nodes when node has none or is no node.";
  let count = document^.nodes.inner.len;
  if node < count {
    match document^.nodes.inner[node].links.parent {
      Some(value: found) => {
        let made = cvt::<u32, u64>(found^.index);
        return made;
      }
      None() => {
      }
    }
  }
  return count;
}

fn inside_element(document: &Document, node: u64, element: u64) -> inside: Bool reads(document) {
  doc "True when element is node or one of its ancestors, climbing at most one step per node of the document.";
  let count = document^.nodes.inner.len;
  let at = node;
  for (step in 0_u64..count) {
    if at == element {
      return True();
    }
    if at >= count {
      return False();
    }
    set at = parent_of(document: document, node: at);
  }
  return False();
}

fn changed_outside(document: &Document, old: &Styles, new: &Styles, changed: &[Bool], element: u64) -> outside: Bool reads(document), reads(old), reads(new), reads(changed) {
  doc "True when the delta flags an element of both results that is not element or inside it, or flags element itself; an element of one result only was inserted or removed by the edit and is not counted. Each node's test reads only its own slot and its ancestors.";
  let count = changed^.len;
  let found = False();
  for (n in 0_u64..count) {
    let flagged = changed^[n];
    let in_old = if n < old^.order.inner.len {
      let at = cvt::<u32, u64>(old^.order.inner[n]);
      give at < old^.elements.inner.len;
    } else {
      give False();
    }
    let in_new = if n < new^.order.inner.len {
      let at = cvt::<u32, u64>(new^.order.inner[n]);
      give at < new^.elements.inner.len;
    } else {
      give False();
    }
    let both = band(in_old, in_new);
    let counted = band(flagged, both);
    let out = if counted {
      let itself = n == element;
      let within = inside_element(document: document, node: n, element: element);
      let away = bnot(within);
      give bor(itself, away);
    } else {
      give False();
    }
    set found = bor(found, out);
  }
  return found;
}

fn contexts_at(context: &Context, steps: &[ContextStep], depth: u64) -> (contexts: u64, paragraphs: u64) reads(context), reads(steps) {
  doc "The context and paragraph counts below the checked route from depth on, or zero counts when it leads nowhere.";
  let length = steps^.len;
  if depth >= length {
    let (contexts, paragraphs) = count_tree(context: context);
    return contexts, paragraphs;
  }
  let child = cvt::<u32, u64>(steps^[depth].child);
  if child < context^.children.inner.len {
    let route = steps^[depth];
    if context^.slot != route.parent {
      return 0_u64, 0_u64;
    }
    if context^.children.inner[child].slot != route.slot {
      return 0_u64, 0_u64;
    }
    let next = depth +sat 1_u64;
    let (contexts, paragraphs) = contexts_at(context: &context^.children.inner[child], steps: steps, depth: next);
    return contexts, paragraphs;
  }
  return 0_u64, 0_u64;
}

fn rebuild_of(context: &Context, steps: &[ContextStep], depth: u64) -> result: Result<Rebuild, LayoutError> reads(context), reads(steps) {
  doc "Descends from context by the checked parent, child and context slots in steps from depth on and returns the kind, style, entry and exit of the context they lead to.";
  let count = steps^.len;
  if depth >= count {
    let entered = copy_point(point: &context^.entered);
    let left = copy_point(point: &context^.left);
    let made = Rebuild(kind: context^.kind, style: context^.style, entered: move entered, left: move left);
    return Ok<Rebuild, LayoutError>(value: move made);
  }
  let child = cvt::<u32, u64>(steps^[depth].child);
  if child < context^.children.inner.len {
  } else {
    return inconsistent::<Rebuild>();
  }
  let route = steps^[depth];
  if context^.slot != route.parent {
    return inconsistent::<Rebuild>();
  }
  if context^.children.inner[child].slot != route.slot {
    return inconsistent::<Rebuild>();
  }
  let next = depth +sat 1_u64;
  let found = propagate rebuild_of(context: &context^.children.inner[child], steps: steps, depth: next);
  return Ok<Rebuild, LayoutError>(value: move found);
}

fn relative_steps(paths: &RouteTable<ContextPath>, from: u32, to: u32) -> found: Option<Box<Slots<ContextStep>>> reads(paths) {
  doc "The checked child steps from stable context slot from down to stable slot to, read from paths by following parents up from to; None when from is not to or one of its ancestors.";
  let count = paths^.len;
  let upward = box_slots_new::<ContextStep>(capacity: 16_u64);
  let at = cvt::<u32, u64>(to);
  let goal = cvt::<u32, u64>(from);
  for (step in 0_u64..count) {
    if at < count {
    } else {
      return None<Box<Slots<ContextStep>>>();
    }
    let place = route_read::<ContextPath>(table: paths, at: at);
    if place.live {
    } else {
      return None<Box<Slots<ContextStep>>>();
    }
    if at == goal {
      let length = upward.inner.len;
      let reserve = imin(length, 4096_u64);
      let steps = box_slots_new::<ContextStep>(capacity: reserve);
      for (back in 0_u64..length) {
        let top = length - 1_u64;
        let k = top - back;
        let index = upward.inner[k];
        let pushed = push_item::<ContextStep>(cell: &steps, value: index, ceiling: item_ceiling);
      }
      return Some<Box<Slots<ContextStep>>>(value: move steps);
    }
    if at < count {
    } else {
      return None<Box<Slots<ContextStep>>>();
    }
    if place.parent == no_index {
      return None<Box<Slots<ContextStep>>>();
    }
    let slot = cvt.wrap::<u64, u32>(at);
    let route = ContextStep(parent: place.parent, child: place.child, slot: slot);
    let pushed = push_item::<ContextStep>(cell: &upward, value: route, ceiling: item_ceiling);
    set at = cvt::<u32, u64>(place.parent);
  }
  return None<Box<Slots<ContextStep>>>();
}

fn take_prepared(fresh: &Paragraph, old: &Context, steps: &[ContextStep], depth: u64, paragraph: u64, changed: &[Bool], root: u32) -> taken: Bool reads(steps), reads(changed), writes(fresh), writes(old) {
  doc "Descends from old by steps from depth on to the context holding the old paragraph at index paragraph; when its pieces equal fresh's piece by piece, its own style is fresh's and no style either reads changed, swaps its prepared text, runs, run styles, marks and shaped text into fresh, which then needs no preparation. The runs keep the font group identifiers of the style run that prepared them, which only shaping reads; the shaped faces they chose stay right because the groups are equal in value.";
  let count = steps^.len;
  if depth < count {
    let child = cvt::<u32, u64>(steps^[depth].child);
    if child < old^.children.inner.len {
      let route = steps^[depth];
      if old^.slot != route.parent {
        return False();
      }
      if old^.children.inner[child].slot != route.slot {
        return False();
      }
      let next = depth +sat 1_u64;
      let taken = take_prepared(fresh: fresh, old: &old^.children.inner[child], steps: steps, depth: next, paragraph: paragraph, changed: changed, root: root);
      return taken;
    }
    return False();
  }
  if paragraph < old^.paragraphs.inner.len {
  } else {
    return False();
  }
  let held = old^.paragraphs.inner[paragraph].dirty;
  if held {
    return False();
  }
  let style = same_ref(first: fresh^.style, second: old^.paragraphs.inner[paragraph].style);
  let restyled = style_is_changed(changed: changed, root: root, style: fresh^.style);
  let kept_style = bnot(restyled);
  let usable = band(style, kept_style);
  if usable {
  } else {
    return False();
  }
  let length = fresh^.pieces.inner.len;
  if length != old^.paragraphs.inner[paragraph].pieces.inner.len {
    return False();
  }
  let total = old^.paragraphs.inner[paragraph].pieces.inner.len;
  let equal = True();
  for (k in 0_u64..length) {
    let fresh_inside = k < fresh^.pieces.inner.len;
    let old_inside = k < total;
    let inside = band(fresh_inside, old_inside);
    let same = if inside {
      let piece = fresh^.pieces.inner[k];
      let equal_piece = same_piece(first: piece, second: old^.paragraphs.inner[paragraph].pieces.inner[k]);
      let reads_change = piece_is_changed(changed: changed, root: root, piece: piece);
      let kept = bnot(reads_change);
      give band(equal_piece, kept);
    } else {
      give False();
    }
    set equal = band(equal, same);
  }
  if equal {
  } else {
    return False();
  }
  swap(first: &fresh^.text, second: &old^.paragraphs.inner[paragraph].text);
  swap(first: &fresh^.runs, second: &old^.paragraphs.inner[paragraph].runs);
  swap(first: &fresh^.run_styles, second: &old^.paragraphs.inner[paragraph].run_styles);
  swap(first: &fresh^.marks, second: &old^.paragraphs.inner[paragraph].marks);
  swap(first: &fresh^.shaped, second: &old^.paragraphs.inner[paragraph].shaped);
  set old^.paragraphs.inner[paragraph].dirty = True();
  return True();
}

fn first_text_node(paragraph: &Paragraph) -> node: u32 reads(paragraph) {
  doc "The NodeId index of the text node of the paragraph's first Bytes piece that has one, or no_index.";
  let total = paragraph^.pieces.inner.len;
  for (k in 0_u64..total) {
    let piece = paragraph^.pieces.inner[k];
    match piece {
      Bytes(node: source, ..) => {
        if source != no_index {
          return source;
        }
      }
      Generated(..) => {
      }
      Scalar(..) => {
      }
      Begin(..) => {
      }
      End(..) => {
      }
      Object(..) => {
      }
    }
  }
  return no_index;
}

fn reuse_prepared(fresh: &Context, old_root: &Context, base: &[ContextStep], from: u32, old_units: &RouteTable<TextUnit>, paths: &RouteTable<ContextPath>, changed: &[Bool], root: u32) -> reused: u64 reads(base), reads(old_units), reads(paths), reads(changed), writes(fresh), writes(old_root) {
  doc "For each paragraph of fresh and of the contexts below it, finds the old paragraph its first text node's unit names, inside the old context with serial from that base leads to from old_root, and takes its preparation when it is the same input (take_prepared); a paragraph that takes none is marked for preparation. Returns the paragraphs that took one. The loop is sequential: each iteration swaps into an old paragraph the compiler cannot prove apart from another iteration's.";
  let reused = 0_u64;
  let count = fresh^.paragraphs.inner.len;
  for (i in 0_u64..count) {
    let node = first_text_node(paragraph: &fresh^.paragraphs.inner[i]);
    let at = cvt::<u32, u64>(node);
    let named = node != no_index;
    let taken = if at < old_units^.len {
      let route_value_3 = route_read::<TextUnit>(table: old_units, at: at);
      let held = route_value_3;
      let listed = held.serial != no_index;
      let unskipped = held.serial != skipped_text;
      let recorded = band(listed, unskipped);
      let usable = band(named, recorded);
      let found = if usable {
        let relative = relative_steps(paths: paths, from: from, to: held.serial);
        let done = match move relative {
          Some(value: tail) => {
            let base_length = base^.len;
            let tail_length = tail.inner.len;
            let total = base_length +sat tail_length;
            let reserve = imin(total, 4096_u64);
            let steps = box_slots_new::<ContextStep>(capacity: reserve);
            for (k in 0_u64..base_length) {
              let pushed = push_item::<ContextStep>(cell: &steps, value: base^[k], ceiling: item_ceiling);
            }
            for (k in 0_u64..tail_length) {
              let pushed = push_item::<ContextStep>(cell: &steps, value: tail.inner[k], ceiling: item_ceiling);
            }
            let paragraph = cvt::<u32, u64>(held.paragraph);
            let made = steps.inner.len;
            let swapped = take_prepared(fresh: &fresh^.paragraphs.inner[i], old: old_root, steps: &steps.inner[0_u64..made], depth: 0_u64, paragraph: paragraph, changed: changed, root: root);
            give swapped;
          }
          None() => {
            give False();
          }
        }
        give done;
      } else {
        give False();
      }
      give found;
    } else {
      give False();
    }
    if taken {
      set reused = reused +sat 1_u64;
    } else {
      set fresh^.paragraphs.inner[i].dirty = True();
    }
  }
  let children = fresh^.children.inner.len;
  for (k in 0_u64..children) {
    let below = reuse_prepared(fresh: &fresh^.children.inner[k], old_root: old_root, base: base, from: from, old_units: old_units, paths: paths, changed: changed, root: root);
    set reused = reused +sat below;
  }
  return reused;
}

fn mark_fresh(context: &Context) -> result: unit writes(context) {
  doc "Marks a context structure_changed built again, and every context below it, for update: each is marked, its marked paragraphs and children counted and the last of each recorded, as text_changed records them.";
  let paragraphs = context^.paragraphs.inner.len;
  let marked_paragraphs = 0_u32;
  let marked_paragraph = no_index;
  for (i in 0_u64..paragraphs) {
    if context^.paragraphs.inner[i].dirty {
      set marked_paragraphs = marked_paragraphs +sat 1_u32;
      set marked_paragraph = cvt.wrap::<u64, u32>(i);
    }
  }
  let frontier_span = frontier_span_for(count: paragraphs);
  let frontier = frontier_from_paragraphs(paragraphs: &context^.paragraphs.inner[0_u64..paragraphs], span: frontier_span);
  set context^.paragraph_frontier = move frontier;
  set context^.frontier_span = frontier_span;
  set context^.flow_inputs.valid = False();
  let children = context^.children.inner.len;
  for (k in 0_u64..children) {
    mark_fresh(context: &context^.children.inner[k]);
  }
  let child_count = imin(children, 4294967295_u64);
  set context^.marked_paragraphs = marked_paragraphs;
  set context^.marked_paragraph = marked_paragraph;
  set context^.marked_children = cvt::<u64, u32>(child_count);
  let marked_child = if children > 0_u64 {
    let last = children - 1_u64;
    give cvt.wrap::<u64, u32>(last);
  } else {
    give no_index;
  }
  set context^.marked_child = marked_child;
  set context^.dirty = True();
  return unit;
}

fn keep_outputs(from: &Context, to: &Context) -> result: unit reads(from), writes(to) {
  doc "Gives the context built again what its parent gave the old one and what the old one's last layout produced: the space it was last laid out in (laid, which a parent's update writes back as its space before updating it) and its space, flow entry, block and beside, its position, size, margins and baseline. split_head belongs to the unchanged parent Split endpoint and survives rebuilding the child's interior. Its update then compares its new outputs with those, as for any marked child; restyled forbids the cutoffs that assume its last layout still holds, and its intrinsic sizes stay unknown.";
  set to^.flow_inputs.valid = False();
  set to^.height_input = from^.height_input;
  set to^.split_head = from^.split_head;
  set to^.laid = from^.laid;
  set to^.restyled = True();
  set to^.space = from^.space;
  set to^.entry_slot = from^.entry_slot;
  set to^.flow_at = from^.flow_at;
  set to^.block = from^.block;
  set to^.beside = from^.beside;
  set to^.anchor = from^.anchor;
  set to^.placement_paragraph = from^.placement_paragraph;
  set to^.placement_fresh = from^.placement_fresh;
  set to^.placement_natural = from^.placement_natural;
  set to^.placement_natural_offset = from^.placement_natural_offset;
  set to^.placement_natural_known = from^.placement_natural_known;
  set to^.normal_x = from^.normal_x;
  set to^.normal_y = from^.normal_y;
  set to^.x = from^.x;
  set to^.y = from^.y;
  set to^.width = from^.width;
  set to^.height = from^.height;
  set to^.margin_top = from^.margin_top;
  set to^.margin_right = from^.margin_right;
  set to^.margin_bottom = from^.margin_bottom;
  set to^.margin_left = from^.margin_left;
  set to^.baseline = from^.baseline;
  set to^.has_baseline = from^.has_baseline;
  set to^.first_baseline = from^.first_baseline;
  set to^.has_first_baseline = from^.has_first_baseline;
  set to^.viewport_origin = from^.viewport_origin;
  return unit;
}

fn place_rebuilt(context: &Context, steps: &[ContextStep], depth: u64, built: &Context) -> result: Result<unit, LayoutError> reads(steps), writes(context), writes(built) {
  doc "Descends from context by the checked parent, child and context slots in steps from depth on, swaps built with the context they lead to, and marks every context on the way back up, as mark_path does.";
  let count = steps^.len;
  if depth >= count {
    keep_outputs(from: context, to: built);
    swap(first: context, second: built);
    return Ok<unit, LayoutError>(value: unit);
  }
  let child = cvt::<u32, u64>(steps^[depth].child);
  if child < context^.children.inner.len {
  } else {
    return inconsistent::<unit>();
  }
  let route = steps^[depth];
  if context^.slot != route.parent {
    return inconsistent::<unit>();
  }
  if context^.children.inner[child].slot != route.slot {
    return inconsistent::<unit>();
  }
  let next = depth +sat 1_u64;
  let was = context^.children.inner[child].dirty;
  let placed = propagate place_rebuilt(context: &context^.children.inner[child], steps: steps, depth: next, built: built);
  if was {
  } else {
    set context^.marked_children = context^.marked_children +sat 1_u32;
    set context^.marked_child = steps^[depth].child;
  }
  set context^.dirty = True();
  return Ok<unit, LayoutError>(value: unit);
}

fn live_context(paths: &RouteTable<ContextPath>, serial: u32) -> live: Bool reads(paths) {
  let at = cvt::<u32, u64>(serial);
  if at < paths^.len {
    let route_value_4 = route_read::<ContextPath>(table: paths, at: at);
    return route_value_4.live;
  }
  return False();
}

fn retire_tree(context: &Context, paths: &RouteTable<ContextPath>) -> result: unit reads(context), writes(paths) {
  doc "Clears only the directory slots owned by the removed subtree.";
  let at = cvt::<u32, u64>(context^.slot);
  if at < paths^.len {
    let no = False();
    let route_value = ContextPath(live: no, parent: no_index, child: no_index);
    route_write::<ContextPath>(table: paths, at: at, value: route_value);
  }
  let count = context^.children.inner.len;
  for (k in 0_u64..count) {
    retire_tree(context: &context^.children.inner[k], paths: paths);
  }
  return unit;
}

fn retire_at(context: &Context, steps: &[ContextStep], depth: u64, paths: &RouteTable<ContextPath>) -> result: Result<unit, LayoutError> reads(context), reads(steps), writes(paths) {
  let count = steps^.len;
  if depth >= count {
    retire_tree(context: context, paths: paths);
    return Ok<unit, LayoutError>(value: unit);
  }
  let route = steps^[depth];
  let child = cvt::<u32, u64>(route.child);
  if child < context^.children.inner.len {
  } else {
    return inconsistent::<unit>();
  }
  if context^.slot != route.parent {
    return inconsistent::<unit>();
  }
  if context^.children.inner[child].slot != route.slot {
    return inconsistent::<unit>();
  }
  let next = depth +sat 1_u64;
  let retired = propagate retire_at(context: &context^.children.inner[child], steps: steps, depth: next, paths: paths);
  return Ok<unit, LayoutError>(value: unit);
}

fn retain_routes(layout: &Layout, paths: &RouteTable<ContextPath>, uses: &RouteTable<StyleUse>, routes: &RouteTable<StyleRoute>, reserve: u64) -> result: Result<unit, LayoutError> reads(layout), reads(paths), writes(uses), writes(routes) {
  doc "Copies surviving explicit uses into the caller's empty use table without reading retained context payloads. One local head accumulates each supplier's surviving chain; no consumer reads intermediate heads. Dense directory copying is migration support, not a local splice.";
  if reserve > item_ceiling {
    return too_large::<unit>();
  }
  let missing = absent_style_route();
  let allocated = route_table::<StyleRoute>(count: reserve, missing: missing);
  set routes^ = move allocated;
  set routes^.len = 0_u64;
  let nodes = uses^.len;
  let total = layout^.routes.len;
  for (n in 0_u64..nodes) {
    if n < layout^.uses.len {
      let route_value_5 = route_read::<StyleUse>(table: &layout^.uses, at: n);
      let cursor = route_value_5.head;
      let head = no_index;
      for (step in 0_u64..total) {
        if cursor == no_index {
          break;
        }
        let at = cvt::<u32, u64>(cursor);
        if at < layout^.routes.len {
        } else {
          return inconsistent::<unit>();
        }
        let route_value_6 = route_read::<StyleRoute>(table: &layout^.routes, at: at);
        let held = route_value_6;
        let live = live_context(paths: paths, serial: held.serial);
        if live {
          let next = routes^.len;
          if next < 4294967295_u64 {
          } else {
            return too_large::<unit>();
          }
          let route = StyleRoute(serial: held.serial, structural: held.structural, block: held.block, paragraph: held.paragraph, owner: held.owner, next: head);
          let pushed = propagate route_push::<StyleRoute>(table: routes, value: route);
          let route_head = cvt::<u64, u32>(next);
          set head = route_head;
        }
        set cursor = held.next;
      }
      if cursor != no_index {
        return inconsistent::<unit>();
      }
      if head != no_index {
        let updated_use = StyleUse(head: head);
        route_write::<StyleUse>(table: uses, at: n, value: updated_use);
      }
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn reconstruction_route_bound(context: &Context) -> count: u64 reads(context) {
  doc "Bounds record_tree's route emissions by its producers: one context owner, one per block, two per row/column, and each paragraph's strut and pieces. Duplicates may emit fewer routes. Independent subtree counts precede allocation; no route or admission depends on this reserve.";
  let rows = context^.rows.inner.len *sat 2_u64;
  let columns = context^.columns.inner.len *sat 2_u64;
  let blocks = context^.blocks.inner.len;
  let paragraphs = context^.paragraphs.inner.len;
  let pieces = 0_u64;
  for (p in 0_u64..paragraphs) {
    set pieces = pieces +sat context^.paragraphs.inner[p].pieces.inner.len;
  }
  let children = context^.children.inner.len;
  let descendants = 0_u64;
  for (c in 0_u64..children) {
    let below = reconstruction_route_bound(context: &context^.children.inner[c]);
    set descendants = descendants +sat below;
  }
  let owner_blocks = 1_u64 +sat blocks;
  let table_uses = rows +sat columns;
  let paragraph_uses = paragraphs +sat pieces;
  let local_boxes = owner_blocks +sat table_uses;
  let local_uses = local_boxes +sat paragraph_uses;
  return local_uses +sat descendants;
}

fn copy_retained_paths(source: &RouteTable<ContextPath>, count: u64) -> result: Result<RouteTable<ContextPath>, LayoutError> reads(source) contract {
  requires count <= 1073741824_u64;
} {
  doc "Copies historical path identities and tombstones without per-record publication; the existing storage ceiling is checked before publishing the high-water mark.";
  let missing = absent_context_path();
  let made = route_table::<ContextPath>(count: count, missing: missing);
  let destination = &made;
  if source^.len > item_ceiling {
    return too_large::<RouteTable<ContextPath>>();
  }
  copy_route_table::<ContextPath>(source: source, destination: destination);
  set destination^.len = source^.len;
  return Ok<RouteTable<ContextPath>, LayoutError>(value: move made);
}

fn copy_retained_units(source: &RouteTable<TextUnit>, paths: &RouteTable<ContextPath>, count: u64) -> made: RouteTable<TextUnit> reads(source), reads(paths) contract {
  requires count <= 1073741824_u64;
} {
  doc "Bulk-copies the old text directory, then filters independent final cells by context lifetime, preserving the skipped-text sentinel.";
  let vacant = absent_text_unit();
  let made = route_table::<TextUnit>(count: count, missing: vacant);
  let destination = &made;
  copy_route_table::<TextUnit>(source: source, destination: destination);
  match destination^.pages {
    Page(values: page) => {
      let existing = imin(source^.len, page^.inner.len);
      for (at in 0_u64..existing) {
        let held = page^.inner[at];
        let live = live_context(paths: paths, serial: held.serial);
        let skipped = held.serial == skipped_text;
        let keep = bor(live, skipped);
        if keep {
        } else {
          let missing = absent_text_unit();
          set page^.inner[at] = missing;
        }
      }
    }
    Vacant() => {
    }
    Fork(..) => {
    }
  }
  return move made;
}

fn copy_retained_contexts(source: &RouteTable<u32>, paths: &RouteTable<ContextPath>, count: u64) -> made: RouteTable<u32> reads(source), reads(paths) contract {
  requires count <= 1073741824_u64;
} {
  doc "Bulk-copies establishing-element identities and filters final cells independently by retirement; no live identity is renumbered.";
  let vacant = no_index;
  let made = route_table::<u32>(count: count, missing: vacant);
  let destination = &made;
  copy_route_table::<u32>(source: source, destination: destination);
  match destination^.pages {
    Page(values: page) => {
      let existing = imin(source^.len, page^.inner.len);
      for (at in 0_u64..existing) {
        let held = page^.inner[at];
        let live = live_context(paths: paths, serial: held);
        if live {
        } else {
          set page^.inner[at] = no_index;
        }
      }
    }
    Vacant() => {
    }
    Fork(..) => {
    }
  }
  return move made;
}

fn structure_changed(layout: &Layout, document: &Document, old: &Styles, new: &Styles, traversal: &Traversal, atoms: &AtomTable, changed: &[Bool], parent: NodeId) -> result: Result<unit, LayoutError> reads(document), reads(old), reads(new), reads(traversal), reads(atoms), reads(changed), writes(layout) {
  doc "Builds again the context of the nearest element at or above parent that establishes one, from the walk's state as it entered that context, keeps every other context, takes the preparation of each unchanged paragraph from the old context, publishes fresh context slots and exact text/style routes for the replacement while retaining outside identities, and marks its ancestors for update. Refusal checks and replacement route construction precede preparation transfer and publication.";
  let none = StructureCounts(contexts: 0_u64, paragraphs: 0_u64, reused: 0_u64);
  set layout^.last_structure = none;
  let nodes = document^.nodes.inner.len;
  let small = nodes <= item_ceiling;
  let sized = changed^.len == new^.order.inner.len;
  let usable = band(small, sized);
  if usable {
  } else {
    return inconsistent::<unit>();
  }
  let kept = retained_outside(old: old, new: new, traversal: traversal);
  if kept {
  } else {
    return inconsistent::<unit>();
  }
  let at = cvt::<u32, u64>(parent.index);
  let element = nodes;
  let serial = no_index;
  for (step in 0_u64..nodes) {
    if at >= nodes {
      break;
    }
    let held = if at < layout^.context_of.len {
      let route_value_8 = route_read::<u32>(table: &layout^.context_of, at: at);
      give route_value_8;
    } else {
      give no_index;
    }
    if held != no_index {
      let candidate_steps = propagate path_steps(layout: layout, serial: held);
      let candidate_depth = candidate_steps.inner.len;
      let exact = exact_walk_at(context: &layout^.root, steps: &candidate_steps.inner[0_u64..candidate_depth], depth: 0_u64);
      if exact {
        set element = at;
        set serial = held;
        break;
      }
    }
    set at = parent_of(document: document, node: at);
  }
  if serial == no_index {
    return inconsistent::<unit>();
  }
  let outside = changed_outside(document: document, old: old, new: new, changed: changed, element: element);
  if outside {
    return inconsistent::<unit>();
  }
  let base = propagate path_steps(layout: layout, serial: serial);
  let base_count = base.inner.len;
  let rebuild = propagate rebuild_of(context: &layout^.root, steps: &base.inner[0_u64..base_count], depth: 0_u64);
  let word_n = list_item_word.len;
  let list_item = match atom_find(table: atoms, name: &list_item_word[0_u64..word_n]) {
    Some(value: atom) => {
      give atom.index;
    }
    None() => {
      give unlisted;
    }
  }
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  let skipped = box_slots_new::<u32>(capacity: 0_u64);
  let walk = Walk(effects: 0_u64, counters: move counters, quote_depth: 0_i32, depth: 0_u64, list_item: list_item, skipped: move skipped);
  restore_point(walk: &walk, point: &rebuild.entered);
  let index = cvt.wrap::<u64, u32>(element);
  let node = NodeId(index: index);
  let built = propagate build_box(document: document, styles: new, atoms: atoms, walk: &walk, node: node, element: node.index, style: rebuild.style, kind: rebuild.kind);
  finish_tree_sequences(context: &built);
  let same_exit = same_point(first: &built.left, second: &rebuild.left);
  if same_exit {
  } else {
    return inconsistent::<unit>();
  }
  let root = if 0_u64 < traversal^.elements.inner.len {
    give traversal^.elements.inner[0_u64].index;
  } else {
    give no_index;
  }
  let (replaced, replaced_paragraphs) = contexts_at(context: &layout^.root, steps: &base.inner[0_u64..base_count], depth: 0_u64);
  let (fresh_contexts, fresh_paragraphs) = count_tree(context: &built);
  let kept_contexts = layout^.contexts -sat replaced;
  let total_contexts = kept_contexts +sat fresh_contexts;
  let directory_size = layout^.paths.len +sat fresh_contexts;
  let fits = directory_size < 4294967294_u64;
  let within = directory_size <= item_ceiling;
  let recordable = band(fits, within);
  if recordable {
  } else {
    return too_large::<unit>();
  }
  let paths = propagate copy_retained_paths(source: &layout^.paths, count: directory_size);
  let retired = propagate retire_at(context: &layout^.root, steps: &base.inner[0_u64..base_count], depth: 0_u64, paths: &paths);
  let unreached = TextUnit(serial: no_index, piece: 0_u32, count: 0_u32, paragraph: no_index);
  let listing = copy_retained_units(source: &layout^.text_units, paths: &paths, count: nodes);
  let context_of = copy_retained_contexts(source: &layout^.context_of, paths: &paths, count: nodes);
  let unused = unused_style();
  let uses = route_table::<StyleUse>(count: nodes, missing: unused);
  let missing_routes = absent_style_route();
  let fresh_routes = reconstruction_route_bound(context: &built);
  let route_bound = layout^.routes.len +sat fresh_routes;
  let reserve = if route_bound <= item_ceiling {
    give route_bound;
  } else {
    give 0_u64;
  }
  let routes = route_table::<StyleRoute>(count: 0_u64, missing: missing_routes);
  set routes.len = 0_u64;
  let retained = propagate retain_routes(layout: layout, paths: &paths, uses: &uses, routes: &routes, reserve: reserve);
  let old_slot = cvt::<u32, u64>(serial);
  if old_slot < layout^.paths.len {
  } else {
    return inconsistent::<unit>();
  }
  let route_value_12 = route_read::<ContextPath>(table: &layout^.paths, at: old_slot);
  let old_path = route_value_12;
  let recorded = propagate record_tree(context: &built, parent: old_path.parent, child: old_path.child, paths: &paths, listing: &listing, uses: &uses, routes: &routes, context_of: &context_of, root: root);
  record_skipped(walk: &walk, listing: &listing);
  let reused = reuse_prepared(fresh: &built, old_root: &layout^.root, base: &base.inner[0_u64..base_count], from: serial, old_units: &layout^.text_units, paths: &layout^.paths, changed: changed, root: root);
  mark_fresh(context: &built);
  let placed = propagate place_rebuilt(context: &layout^.root, steps: &base.inner[0_u64..base_count], depth: 0_u64, built: &built);
  set layout^.text_units = move listing;
  set layout^.uses = move uses;
  set layout^.routes = move routes;
  set layout^.context_of = move context_of;
  set layout^.paths = move paths;
  set layout^.contexts = total_contexts;
  let kept_paragraphs = layout^.paragraphs -sat replaced_paragraphs;
  set layout^.paragraphs = kept_paragraphs +sat fresh_paragraphs;
  set layout^.dirty = True();
  let counts = StructureCounts(contexts: fresh_contexts, paragraphs: fresh_paragraphs, reused: reused);
  set layout^.last_structure = counts;
  return Ok<unit, LayoutError>(value: unit);
}

fn structure_counts(layout: &Layout) -> (contexts: u64, paragraphs: u64, reused: u64) reads(layout) {
  doc "What the last structure_changed did, as StructureCounts records it.";
  let counts = layout^.last_structure;
  return counts.contexts, counts.paragraphs, counts.reused;
}

fn exact_walk_at(context: &Context, steps: &[ContextStep], depth: u64) -> exact: Bool reads(context), reads(steps) {
  doc "Checks whether a context has a genuine recorded construction checkpoint. Neutral splices omit those inputs and a later Q86 rebuild must start at an exact enclosing context.";
  if depth >= steps^.len {
    return context^.walk_exact;
  }
  let route = steps^[depth];
  let child = cvt::<u32, u64>(route.child);
  if child < context^.children.inner.len {
    if context^.slot == route.parent {
      if context^.children.inner[child].slot == route.slot {
        let next = depth +sat 1_u64;
        let exact = exact_walk_at(context: &context^.children.inner[child], steps: steps, depth: next);
        return exact;
      }
    }
  }
  return False();
}
