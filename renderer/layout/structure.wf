fn keep_outputs(from: &Context, to: &Context) -> result: unit reads(from), writes(to) {
  doc "Gives the context built again what its parent gave the old one and what the old one's last layout produced: the space it was last laid out in (laid, which a parent's update writes back as its space before updating it) and its space, flow entry, block and beside, its position, size, margins and baseline. Its update then compares its new outputs with those, as for any marked child; restyled forbids the cutoffs that assume its last layout still holds, and its intrinsic sizes stay unknown.";
  set to^.laid = from^.laid;
  set to^.restyled = True();
  set to^.space = from^.space;
  set to^.entry_slot = from^.entry_slot;
  set to^.flow_at = from^.flow_at;
  set to^.block = from^.block;
  set to^.beside = from^.beside;
  set to^.anchor = from^.anchor;
  set to^.normal_x = from^.normal_x;
  set to^.normal_y = from^.normal_y;
  set to^.x = from^.x;
  set to^.y = from^.y;
  set to^.width = from^.width;
  set to^.height = from^.height;
  set to^.margin_top = from^.margin_top;
  set to^.margin_right = from^.margin_right;
  set to^.margin_bottom = from^.margin_bottom;
  set to^.margin_left = from^.margin_left;
  set to^.baseline = from^.baseline;
  set to^.has_baseline = from^.has_baseline;
  set to^.viewport_origin = from^.viewport_origin;
  return unit;
}

