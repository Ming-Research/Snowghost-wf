alias AtomTable = pkg::base::atom::AtomTable;
alias atom_find = pkg::base::atom::atom_find;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias Styles = pkg::style::Styles;
alias Traversal = pkg::style::Traversal;

struct Rebuild {
  doc "What structure_changed reads of the context it builds again: its kind, its style and the walk's state as build_box entered and left it.";
  kind: u8;
  style: StyleRef;
  entered: WalkPoint;
  left: WalkPoint;
}

fn empty_point() -> made: WalkPoint pure {
  doc "A walk point with no counter in scope, quote depth 0 and depth 0, which the contexts build_box does not make keep.";
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  return WalkPoint(counters: move counters, quote_depth: 0_i32, depth: 0_u64);
}

fn copy_point(point: &WalkPoint) -> made: WalkPoint reads(point) {
  doc "A copy of point.";
  let count = point^.counters.inner.len;
  let reserve = imin(count, item_ceiling);
  let counters = box_slots_new::<Counter>(capacity: reserve);
  for (k in 0_u64..count) {
    let counter = point^.counters.inner[k];
    let pushed = push_item::<Counter>(cell: &counters, value: counter, ceiling: item_ceiling);
  }
  return WalkPoint(counters: move counters, quote_depth: point^.quote_depth, depth: point^.depth);
}

fn walk_point(walk: &Walk) -> made: WalkPoint reads(walk) {
  doc "The walk's counters in scope, quote depth and depth, copied.";
  let count = walk^.counters.inner.len;
  let reserve = imin(count, item_ceiling);
  let counters = box_slots_new::<Counter>(capacity: reserve);
  for (k in 0_u64..count) {
    let counter = walk^.counters.inner[k];
    let pushed = push_item::<Counter>(cell: &counters, value: counter, ceiling: item_ceiling);
  }
  return WalkPoint(counters: move counters, quote_depth: walk^.quote_depth, depth: walk^.depth);
}

fn restore_point(walk: &Walk, point: &WalkPoint) -> result: unit reads(point), writes(walk) {
  doc "Gives the walk point's counters in scope, quote depth and depth.";
  let restored = copy_point(point: point);
  let WalkPoint(counters: counters, quote_depth: quote_depth, depth: depth) = move restored;
  set walk^.counters = move counters;
  set walk^.quote_depth = quote_depth;
  set walk^.depth = depth;
  return unit;
}

fn same_point(first: &WalkPoint, second: &WalkPoint) -> same: Bool reads(first), reads(second) {
  doc "True when the two points hold the same counters, each with the same name, value and scope depth, the same quote depth and the same depth.";
  let count = first^.counters.inner.len;
  if count != second^.counters.inner.len {
    return False();
  }
  if first^.quote_depth != second^.quote_depth {
    return False();
  }
  if first^.depth != second^.depth {
    return False();
  }
  let equal = True();
  for (k in 0_u64..count) {
    if k < second^.counters.inner.len {
      let a = first^.counters.inner[k];
      let b = second^.counters.inner[k];
      let name = a.name == b.name;
      let value = a.value == b.value;
      let level = a.level == b.level;
      let named = band(name, value);
      let same = band(named, level);
      set equal = band(equal, same);
    }
  }
  return equal;
}

fn same_ref(first: StyleRef, second: StyleRef) -> same: Bool pure {
  doc "True when the two style references name the same element, pseudo-element and anonymity.";
  let element = first.element == second.element;
  let pseudo = first.pseudo == second.pseudo;
  let anonymous = eeq(first.anonymous, second.anonymous);
  let named = band(element, pseudo);
  let same = band(named, anonymous);
  return same;
}

fn same_piece(first: Piece, second: Piece) -> same: Bool pure {
  doc "True when the two pieces are the same variant with equal fields, so that preparation reads the same input from both.";
  match first {
    Bytes(start: a_start, end: a_end, style: a_style, node: a_node) => {
      match second {
        Bytes(start: b_start, end: b_end, style: b_style, node: b_node) => {
          let start = a_start == b_start;
          let end = a_end == b_end;
          let node = a_node == b_node;
          let style = same_ref(first: a_style, second: b_style);
          let span = band(start, end);
          let source = band(node, style);
          let same = band(span, source);
          return same;
        }
        Generated(..) => {
          let owned_result_1 = False();
          return owned_result_1;
        }
        Scalar(..) => {
          let owned_result_2 = False();
          return owned_result_2;
        }
        Begin(..) => {
          let owned_result_3 = False();
          return owned_result_3;
        }
        End(..) => {
          let owned_result_4 = False();
          return owned_result_4;
        }
        Object(..) => {
          let owned_result_5 = False();
          return owned_result_5;
        }
      }
    }
    Generated(start: a_start, end: a_end, style: a_style) => {
      match second {
        Bytes(..) => {
          let owned_result_6 = False();
          return owned_result_6;
        }
        Generated(start: b_start, end: b_end, style: b_style) => {
          let start = a_start == b_start;
          let end = a_end == b_end;
          let style = same_ref(first: a_style, second: b_style);
          let span = band(start, end);
          let same = band(span, style);
          return same;
        }
        Scalar(..) => {
          let owned_result_7 = False();
          return owned_result_7;
        }
        Begin(..) => {
          let owned_result_8 = False();
          return owned_result_8;
        }
        End(..) => {
          let owned_result_9 = False();
          return owned_result_9;
        }
        Object(..) => {
          let owned_result_10 = False();
          return owned_result_10;
        }
      }
    }
    Scalar(value: a_value, style: a_style) => {
      match second {
        Bytes(..) => {
          let owned_result_11 = False();
          return owned_result_11;
        }
        Generated(..) => {
          let owned_result_12 = False();
          return owned_result_12;
        }
        Scalar(value: b_value, style: b_style) => {
          let value = a_value == b_value;
          let style = same_ref(first: a_style, second: b_style);
          let same = band(value, style);
          return same;
        }
        Begin(..) => {
          let owned_result_13 = False();
          return owned_result_13;
        }
        End(..) => {
          let owned_result_14 = False();
          return owned_result_14;
        }
        Object(..) => {
          let owned_result_15 = False();
          return owned_result_15;
        }
      }
    }
    Begin(style: a_style) => {
      match second {
        Bytes(..) => {
          let owned_result_16 = False();
          return owned_result_16;
        }
        Generated(..) => {
          let owned_result_17 = False();
          return owned_result_17;
        }
        Scalar(..) => {
          let owned_result_18 = False();
          return owned_result_18;
        }
        Begin(style: b_style) => {
          let same = same_ref(first: a_style, second: b_style);
          return same;
        }
        End(..) => {
          let owned_result_19 = False();
          return owned_result_19;
        }
        Object(..) => {
          let owned_result_20 = False();
          return owned_result_20;
        }
      }
    }
    End(style: a_style) => {
      match second {
        Bytes(..) => {
          let owned_result_21 = False();
          return owned_result_21;
        }
        Generated(..) => {
          let owned_result_22 = False();
          return owned_result_22;
        }
        Scalar(..) => {
          let owned_result_23 = False();
          return owned_result_23;
        }
        Begin(..) => {
          let owned_result_24 = False();
          return owned_result_24;
        }
        End(style: b_style) => {
          let same = same_ref(first: a_style, second: b_style);
          return same;
        }
        Object(..) => {
          let owned_result_25 = False();
          return owned_result_25;
        }
      }
    }
    Object(context: a_context, style: a_style) => {
      match second {
        Bytes(..) => {
          let owned_result_26 = False();
          return owned_result_26;
        }
        Generated(..) => {
          let owned_result_27 = False();
          return owned_result_27;
        }
        Scalar(..) => {
          let owned_result_28 = False();
          return owned_result_28;
        }
        Begin(..) => {
          let owned_result_29 = False();
          return owned_result_29;
        }
        End(..) => {
          let owned_result_30 = False();
          return owned_result_30;
        }
        Object(context: b_context, style: b_style) => {
          let context = handle_equal(a: a_context, b: b_context);
          let style = same_ref(first: a_style, second: b_style);
          let same = band(context, style);
          return same;
        }
      }
    }
  }
}
fn retained_outside(old: &Styles, new: &Styles, traversal: &Traversal) -> same: Bool reads(old), reads(new), reads(traversal) {
  doc "Checks what the contexts outside the one built again keep from old: the style stage's generated text, which Generated pieces index, byte for byte, and every pseudo-element at the same index in the list, of the same element by NodeId and the same kind, which StyleRef.pseudo indexes.";
  let bytes = old^.generated_text.inner.len;
  let pseudos = old^.pseudos.inner.len;
  let same_bytes = bytes == new^.generated_text.inner.len;
  let same_pseudos = pseudos == new^.pseudos.inner.len;
  let same_sizes = band(same_bytes, same_pseudos);
  if same_sizes {
  } else {
    return False();
  }
  let equal = True();
  for (i in 0_u64..bytes) {
    let same = old^.generated_text.inner[i] == new^.generated_text.inner[i];
    set equal = band(equal, same);
  }
  for (i in 0_u64..pseudos) {
    let a = old^.pseudos.inner[i];
    let b = new^.pseudos.inner[i];
    let kind = a.kind == b.kind;
    let position = cvt::<u32, u64>(b.element);
    let owner = if position < traversal^.elements.inner.len {
      let node = cvt::<u32, u64>(traversal^.elements.inner[position].index);
      let empty_slot = node == 4294967295_u64;
      let hole = band(traversal^.stale, empty_slot);
      let listed = if hole {
        give a.element == b.element;
      } else if node < old^.order.inner.len {
        give old^.order.inner[node] == a.element;
      } else {
        give False();
      }
      give listed;
    } else {
      give False();
    }
    let same = band(kind, owner);
    set equal = band(equal, same);
  }
  return equal;
}

fn parent_of(document: &Document, node: u64) -> parent: u64 reads(document) {
  doc "The NodeId index of node's parent, or the number of nodes when node has none or is no node.";
  let count = document^.nodes.inner.len;
  if node < count {
    match document^.nodes.inner[node].links.parent {
      Some(value: found) => {
        let made = cvt::<u32, u64>(found^.index);
        return made;
      }
      None() => {
      }
    }
  }
  return count;
}

fn inside_element(document: &Document, node: u64, element: u64) -> inside: Bool reads(document) {
  doc "True when element is node or one of its ancestors, climbing at most one step per node of the document.";
  let count = document^.nodes.inner.len;
  let at = node;
  for (step in 0_u64..count) {
    if at == element {
      return True();
    }
    if at >= count {
      return False();
    }
    set at = parent_of(document: document, node: at);
  }
  return False();
}

fn changed_outside(document: &Document, old: &Styles, new: &Styles, changed: &[Bool], element: u64) -> outside: Bool reads(document), reads(old), reads(new), reads(changed) {
  doc "True when the delta flags an element of both results that is not element or inside it, or flags element itself; an element of one result only was inserted or removed by the edit and is not counted. Each node's test reads only its own slot and its ancestors.";
  let count = changed^.len;
  let found = False();
  for (n in 0_u64..count) {
    let flagged = changed^[n];
    let in_old = if n < old^.order.inner.len {
      let at = cvt::<u32, u64>(old^.order.inner[n]);
      give at < old^.elements.inner.len;
    } else {
      give False();
    }
    let in_new = if n < new^.order.inner.len {
      let at = cvt::<u32, u64>(new^.order.inner[n]);
      give at < new^.elements.inner.len;
    } else {
      give False();
    }
    let both = band(in_old, in_new);
    let counted = band(flagged, both);
    let out = if counted {
      let itself = n == element;
      let within = inside_element(document: document, node: n, element: element);
      let away = bnot(within);
      give bor(itself, away);
    } else {
      give False();
    }
    set found = bor(found, out);
  }
  return found;
}

fn contexts_at(context: &Context, steps: &[ContextStep], depth: u64) -> (contexts: u64, paragraphs: u64) reads(context), reads(steps) {
  doc "The context and paragraph counts below the checked route from depth on, or zero counts when it leads nowhere.";
  let length = steps^.len;
  if depth >= length {
    let (contexts, paragraphs) = count_tree(context: context);
    return contexts, paragraphs;
  }
  let held_child_lookup_handle = steps^[depth].child;
  let held_child_lookup_path = owner_path(context: context, owner: held_child_lookup_handle.owner);
  let held_child_lookup_length = held_child_lookup_path.inner.len;
  let held_child_lookup_sequence = &context^.entries;
  for (held_child_lookup_step in 0_u64..held_child_lookup_length) {
    let held_child_lookup_reverse = held_child_lookup_length -sat 1_u64;
    let held_child_lookup_index = held_child_lookup_reverse -sat held_child_lookup_step;
    if held_child_lookup_index < held_child_lookup_path.inner.len {
    } else {
      return 0_u64, 0_u64;
    }
    let held_child_lookup_block_slot = held_child_lookup_path.inner[held_child_lookup_index];
    let held_child_lookup_node = sequence_node(sequence: held_child_lookup_sequence, slot: held_child_lookup_block_slot);
    if held_child_lookup_node.live {
    } else {
      return 0_u64, 0_u64;
    }
    let held_child_lookup_blocks = &held_child_lookup_sequence^.blocks;
    let held_child_lookup_block_span = held_child_lookup_sequence^.span;
    let held_child_lookup_block_offset = held_child_lookup_block_slot;
    loop {
      match held_child_lookup_blocks^ {
        Vacant() => {
          return 0_u64, 0_u64;
        }
        Fork(left: held_child_lookup_left, right: held_child_lookup_right) => {
          let held_child_lookup_half = held_child_lookup_block_span / 2_u32;
          if held_child_lookup_block_offset < held_child_lookup_half {
            set held_child_lookup_blocks = &held_child_lookup_left^.inner;
          } else {
            set held_child_lookup_blocks = &held_child_lookup_right^.inner;
            set held_child_lookup_block_offset = held_child_lookup_block_offset -sat held_child_lookup_half;
          }
          set held_child_lookup_block_span = held_child_lookup_half;
        }
        Page(values: held_child_lookup_block_values) => {
          let held_child_lookup_block_at = cvt::<u32, u64>(held_child_lookup_block_offset);
          if held_child_lookup_block_at < held_child_lookup_block_values^.inner.len {
            match held_child_lookup_block_values^.inner[held_child_lookup_block_at] {
              Some(value: held_child_lookup_block) => {
                set held_child_lookup_sequence = &held_child_lookup_block^.entries;
              }
              None() => {
                return 0_u64, 0_u64;
              }
            }
          } else {
            return 0_u64, 0_u64;
          }
          break;
        }
      }
    }
  }
  let held_child_lookup_target = sequence_node(sequence: held_child_lookup_sequence, slot: held_child_lookup_handle.slot);
  if held_child_lookup_target.live {
  } else {
    return 0_u64, 0_u64;
  }
  let held_child_lookup_pages = &held_child_lookup_sequence^.children;
  let held_child_lookup_span = held_child_lookup_sequence^.span;
  let held_child_lookup_offset = held_child_lookup_handle.slot;
  loop {
    match held_child_lookup_pages^ {
      Fork(left: held_child_lookup_target_left, right: held_child_lookup_target_right) => {
        let held_child_lookup_target_half = held_child_lookup_span / 2_u32;
        if held_child_lookup_offset < held_child_lookup_target_half {
          set held_child_lookup_pages = &held_child_lookup_target_left^.inner;
        } else {
          set held_child_lookup_pages = &held_child_lookup_target_right^.inner;
          set held_child_lookup_offset = held_child_lookup_offset -sat held_child_lookup_target_half;
        }
        set held_child_lookup_span = held_child_lookup_target_half;
      }
      Vacant() => {
        return 0_u64, 0_u64;
      }
      Page(..) => {
        break;
      }
    }
  }
  let held_child = match held_child_lookup_pages^ {
    Page(values: held_child_lookup_values) => {
      let held_child_lookup_at = cvt::<u32, u64>(held_child_lookup_offset);
      if held_child_lookup_at < held_child_lookup_values^.inner.len {
        match held_child_lookup_values^.inner[held_child_lookup_at] {
          Some(value: held_child_lookup_value) => {
            give held_child_lookup_value;
          }
          None() => {
            return 0_u64, 0_u64;
          }
        }
      } else {
        return 0_u64, 0_u64;
      }
    }
    Vacant() => {
      return 0_u64, 0_u64;
    }
    Fork(..) => {
      return 0_u64, 0_u64;
    }
  }
  if held_child_lookup_target.live {
    let route = steps^[depth];
    if context^.slot != route.parent {
      return 0_u64, 0_u64;
    }
    if held_child^.slot != route.slot {
      return 0_u64, 0_u64;
    }
    let next = depth +sat 1_u64;
    let (contexts, paragraphs) = contexts_at(context: held_child, steps: steps, depth: next);
    return contexts, paragraphs;
  }
  return 0_u64, 0_u64;
}
fn rebuild_of(context: &Context, steps: &[ContextStep], depth: u64) -> result: Result<Rebuild, LayoutError> reads(context), reads(steps) {
  doc "Descends from context by the checked parent, child and context slots in steps from depth on and returns the kind, style, entry and exit of the context they lead to.";
  let count = steps^.len;
  if depth >= count {
    let entered = copy_point(point: &context^.entered);
    let left = copy_point(point: &context^.left);
    let made = Rebuild(kind: context^.kind, style: context^.style, entered: move entered, left: move left);
    return Ok<Rebuild, LayoutError>(value: move made);
  }
  let held_child_lookup_handle = steps^[depth].child;
  let held_child_lookup_path = owner_path(context: context, owner: held_child_lookup_handle.owner);
  let held_child_lookup_length = held_child_lookup_path.inner.len;
  let held_child_lookup_sequence = &context^.entries;
  for (held_child_lookup_step in 0_u64..held_child_lookup_length) {
    let held_child_lookup_reverse = held_child_lookup_length -sat 1_u64;
    let held_child_lookup_index = held_child_lookup_reverse -sat held_child_lookup_step;
    if held_child_lookup_index < held_child_lookup_path.inner.len {
    } else {
      let owned_result_1 = inconsistent::<Rebuild>();
      return owned_result_1;
    }
    let held_child_lookup_block_slot = held_child_lookup_path.inner[held_child_lookup_index];
    let held_child_lookup_node = sequence_node(sequence: held_child_lookup_sequence, slot: held_child_lookup_block_slot);
    if held_child_lookup_node.live {
    } else {
      let owned_result_2 = inconsistent::<Rebuild>();
      return owned_result_2;
    }
    let held_child_lookup_blocks = &held_child_lookup_sequence^.blocks;
    let held_child_lookup_block_span = held_child_lookup_sequence^.span;
    let held_child_lookup_block_offset = held_child_lookup_block_slot;
    loop {
      match held_child_lookup_blocks^ {
        Vacant() => {
          let owned_result_3 = inconsistent::<Rebuild>();
          return owned_result_3;
        }
        Fork(left: held_child_lookup_left, right: held_child_lookup_right) => {
          let held_child_lookup_half = held_child_lookup_block_span / 2_u32;
          if held_child_lookup_block_offset < held_child_lookup_half {
            set held_child_lookup_blocks = &held_child_lookup_left^.inner;
          } else {
            set held_child_lookup_blocks = &held_child_lookup_right^.inner;
            set held_child_lookup_block_offset = held_child_lookup_block_offset -sat held_child_lookup_half;
          }
          set held_child_lookup_block_span = held_child_lookup_half;
        }
        Page(values: held_child_lookup_block_values) => {
          let held_child_lookup_block_at = cvt::<u32, u64>(held_child_lookup_block_offset);
          if held_child_lookup_block_at < held_child_lookup_block_values^.inner.len {
            match held_child_lookup_block_values^.inner[held_child_lookup_block_at] {
              Some(value: held_child_lookup_block) => {
                set held_child_lookup_sequence = &held_child_lookup_block^.entries;
              }
              None() => {
                let owned_result_4 = inconsistent::<Rebuild>();
                return owned_result_4;
              }
            }
          } else {
            let owned_result_5 = inconsistent::<Rebuild>();
            return owned_result_5;
          }
          break;
        }
      }
    }
  }
  let held_child_lookup_target = sequence_node(sequence: held_child_lookup_sequence, slot: held_child_lookup_handle.slot);
  if held_child_lookup_target.live {
  } else {
    let owned_result_6 = inconsistent::<Rebuild>();
    return owned_result_6;
  }
  let held_child_lookup_pages = &held_child_lookup_sequence^.children;
  let held_child_lookup_span = held_child_lookup_sequence^.span;
  let held_child_lookup_offset = held_child_lookup_handle.slot;
  loop {
    match held_child_lookup_pages^ {
      Fork(left: held_child_lookup_target_left, right: held_child_lookup_target_right) => {
        let held_child_lookup_target_half = held_child_lookup_span / 2_u32;
        if held_child_lookup_offset < held_child_lookup_target_half {
          set held_child_lookup_pages = &held_child_lookup_target_left^.inner;
        } else {
          set held_child_lookup_pages = &held_child_lookup_target_right^.inner;
          set held_child_lookup_offset = held_child_lookup_offset -sat held_child_lookup_target_half;
        }
        set held_child_lookup_span = held_child_lookup_target_half;
      }
      Vacant() => {
        let owned_result_7 = inconsistent::<Rebuild>();
        return owned_result_7;
      }
      Page(..) => {
        break;
      }
    }
  }
  let held_child = match held_child_lookup_pages^ {
    Page(values: held_child_lookup_values) => {
      let held_child_lookup_at = cvt::<u32, u64>(held_child_lookup_offset);
      if held_child_lookup_at < held_child_lookup_values^.inner.len {
        match held_child_lookup_values^.inner[held_child_lookup_at] {
          Some(value: held_child_lookup_value) => {
            give held_child_lookup_value;
          }
          None() => {
            let owned_result_8 = inconsistent::<Rebuild>();
            return owned_result_8;
          }
        }
      } else {
        let owned_result_9 = inconsistent::<Rebuild>();
        return owned_result_9;
      }
    }
    Vacant() => {
      let owned_result_10 = inconsistent::<Rebuild>();
      return owned_result_10;
    }
    Fork(..) => {
      let owned_result_11 = inconsistent::<Rebuild>();
      return owned_result_11;
    }
  }
  if held_child_lookup_target.live {
  } else {
    let owned_result_12 = inconsistent::<Rebuild>();
    return owned_result_12;
  }
  let route = steps^[depth];
  if context^.slot != route.parent {
    let owned_result_13 = inconsistent::<Rebuild>();
    return owned_result_13;
  }
  if held_child^.slot != route.slot {
    let owned_result_14 = inconsistent::<Rebuild>();
    return owned_result_14;
  }
  let next = depth +sat 1_u64;
  let found = propagate rebuild_of(context: held_child, steps: steps, depth: next);
  return Ok<Rebuild, LayoutError>(value: move found);
}
fn relative_steps(paths: &Box<Slots<ContextPath>>, from: u32, to: u32) -> found: Option<Box<Slots<ContextStep>>> reads(paths) {
  doc "The checked child steps from stable context slot from down to stable slot to, read from paths by following parents up from to; None when from is not to or one of its ancestors.";
  let count = paths^.inner.len;
  let upward = box_slots_new::<ContextStep>(capacity: 16_u64);
  let at = cvt::<u32, u64>(to);
  let goal = cvt::<u32, u64>(from);
  for (step in 0_u64..count) {
    if at < count {
      if paths^.inner[at].live {
      } else {
        return None<Box<Slots<ContextStep>>>();
      }
    } else {
      return None<Box<Slots<ContextStep>>>();
    }
    if at == goal {
      let length = upward.inner.len;
      let reserve = imin(length, 4096_u64);
      let steps = box_slots_new::<ContextStep>(capacity: reserve);
      for (back in 0_u64..length) {
        let top = length - 1_u64;
        let k = top - back;
        let index = upward.inner[k];
        let pushed = push_item::<ContextStep>(cell: &steps, value: index, ceiling: item_ceiling);
      }
      return Some<Box<Slots<ContextStep>>>(value: move steps);
    }
    if at < count {
    } else {
      return None<Box<Slots<ContextStep>>>();
    }
    let place = paths^.inner[at];
    if place.parent == no_index {
      return None<Box<Slots<ContextStep>>>();
    }
    let slot = cvt.wrap::<u64, u32>(at);
    let route = ContextStep(parent: place.parent, child: place.child, slot: slot);
    let pushed = push_item::<ContextStep>(cell: &upward, value: route, ceiling: item_ceiling);
    set at = cvt::<u32, u64>(place.parent);
  }
  return None<Box<Slots<ContextStep>>>();
}

fn take_prepared(fresh: &Paragraph, old: &Context, steps: &[ContextStep], depth: u64, paragraph: EntryHandle, changed: &[Bool], root: u32) -> taken: Bool reads(steps), reads(changed), writes(fresh), writes(old) {
