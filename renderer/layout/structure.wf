    } else {
      return reused;
    }
    let fresh_paragraph_lookup_pages = &fresh_paragraph_lookup_sequence^.paragraphs;
    let fresh_paragraph_lookup_span = fresh_paragraph_lookup_sequence^.span;
    let fresh_paragraph_lookup_offset = fresh_paragraph_lookup_handle.slot;
    loop {
      match fresh_paragraph_lookup_pages^ {
        Fork(left: fresh_paragraph_lookup_target_left, right: fresh_paragraph_lookup_target_right) => {
