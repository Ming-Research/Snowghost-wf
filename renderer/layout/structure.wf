      let fresh_child_lookup_blocks = &fresh_child_lookup_sequence^.blocks;
      let fresh_child_lookup_block_span = fresh_child_lookup_sequence^.span;
      let fresh_child_lookup_block_offset = fresh_child_lookup_block_slot;
