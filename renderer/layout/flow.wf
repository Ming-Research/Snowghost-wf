      return same;
    }
  }
  let old_limit = imin(floor, plan.old_flow_end);
  let new_limit = old_limit +sat delta;
  let old_bottom = if uniform {
    give floats.before_reach;
  } else {
    give floats.old_reach;
  }
  let new_bottom = if uniform {
    give floats.before_reach;
  } else {
    give floats.reach;
  }
  if old_bottom > old_limit {
    return False();
  }
  if new_bottom > new_limit {
    return False();
  }
  let made = frames_grow(context: context, styles: styles, frames: frames, plan: plan, content_top: content_top, delta: delta, basis_height: basis_height);
  return made;
}

