struct Restack {
  doc "A full stacking pass when partial is False; otherwise a re-stack from from that may converge only at or after until. It resumes after an unchanged paragraph with lines when that state is recoverable, then replays the gap to from. old_top, old_height and old_lines describe an edited paragraph before it was broken again; old_flow_end is the previous flow end. unasked controls child intrinsic-size reuse. empty_stable permits keeping empty-inline fragments when the affected paragraphs keep whether they have lines.";
  partial: Bool;
  from: u64;
  until: u64;
  empty_stable: Bool;
  unasked: Bool;
  old_top: i32;
  old_height: i32;
  old_lines: Bool;
  old_flow_end: i32;
}

struct StackResult {
  doc "What a stacking pass returns: the content height (which contains the floats) and the last line's baseline, and for a re-stack its actual restart start_at and whether it stopped after flow entry stop_at with every later entry to move by delta (the open blocks already given their final position and grown by delta), how many entries it stacked again, and whether empty-inline fragments may be kept (every affected paragraph kept whether it has lines, and its empty fragment inputs stayed unchanged).";
  height: i32;
  baseline: i32;
  has_baseline: Bool;
  stopped: Bool;
  start_at: u64;
  stop_at: u64;
  delta: i32;
  restacked: u64;
  fragments_same: Bool;
  below: UpdateCounts;
}

fn full_stack() -> plan: Restack pure {
