alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;
alias NodeId = pkg::dom::NodeId;
alias atom_img = pkg::base::static_atoms::atom_img;
alias sizing_value = pkg::css::values::sizing_value;
alias break_mandatory = pkg::layout::text::break_mandatory;
alias break_allowed = pkg::layout::text::break_allowed;

struct Frame {
  doc "A block box open during a flow pass: its index, the left offset and width of its content box in the context's content box, its top border and padding, and, in the stacking pass, whether its border-box top is known yet, its relative offset and whether a line box lies inside it.";
  block: u32;
  left: i32;
  width: i32;
  top_frame: i32;
  known: Bool;
  dx: i32;
  dy: i32;
  lines: Bool;
}

struct Stack {
  doc "The stacking pass's vertical state: the bottom of the last placed content (cursor), the margins waiting to collapse (the largest positive and the most negative), the floats placed so far, the lowest top any later float may take, and the lowest bottom of the floats placed so far (reach).";
  cursor: i32;
  positive: i32;
  negative: i32;
  floats: Box<Slots<Exclusion>>;
  float_floor: i32;
  reach: i32;
}

fn pending_margin(stack: &Stack) -> margin: i32 reads(stack) {
  doc "The collapsed value of the waiting margins.";
  let made = stack^.positive +sat stack^.negative;
  return made;
}

fn add_margin(stack: &Stack, margin: i32) -> result: unit writes(stack) {
  doc "Adds a margin to the waiting margins, which collapse to the largest positive plus the most negative.";
  if margin >= 0_i32 {
    set stack^.positive = imax(stack^.positive, margin);
  } else {
    set stack^.negative = imin(stack^.negative, margin);
  }
  return unit;
}

fn clear_margins(stack: &Stack) -> result: unit writes(stack) {
  doc "Forgets the waiting margins once something separates them from later content.";
  set stack^.positive = 0_i32;
  set stack^.negative = 0_i32;
  return unit;
}

fn float_bottom(stack: &Stack, side: u8) -> bottom: i32 reads(stack) {
  doc "The lowest bottom of the floats on side (clear_left, clear_right or clear_both), or minus infinity.";
  let lowest = -2147483647_i32;
  let count = stack^.floats.inner.len;
  for (k in 0_u64..count) {
    let float_box = stack^.floats.inner[k];
    let wanted_left = side == clear_left;
    let wanted_right = side == clear_right;
    let wanted_both = side == clear_both;
    let left_hit = band(wanted_left, float_box.left);
    let right_side = bnot(float_box.left);
    let right_hit = band(wanted_right, right_side);
    let hit_pair = bor(left_hit, right_hit);
    let hit = bor(hit_pair, wanted_both);
    if hit {
      set lowest = imax(lowest, float_box.bottom);
    }
  }
  return lowest;
}

fn block_width(styles: &Styles, style: StyleRef, available: i32) -> (width: i32, left: i32, margin_left: i32, margin_right: i32) reads(styles) {
  doc "The border-box width and the left offset of an in-flow block-level box in a containing block available wide (CSS 2.2 10.3.3): an auto width fills the space its margins leave; a given width keeps it, with auto margins sharing the rest equally, one auto margin taking it all (a box that leaves no rest takes its auto margins as zero), and with none auto the right margin taking the rest.";
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: available);
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let margins = margin_edges(styles: styles, style: style, basis: available);
  let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
  let (minimum, maximum) = width_limits(styles: styles, style: style, basis: available, frame: frame);
  let specified = specified_width(styles: styles, style: style, basis: available, frame: frame);
  let around = horizontal(edges: margins);
  let natural = if specified >= 0_i32 {
    give specified;
  } else {
    give available -sat around;
  }
  let clamped = clamp_size(size: natural, minimum: minimum, maximum: maximum);
  let width = imax(clamped, frame);
  let free = available -sat width;
  let either = bor(auto_left, auto_right);
  let fixed_test = specified >= 0_i32;
  let fixed = band(fixed_test, either);
  let limited = clamped != natural;
  let centring_pair = band(limited, either);
  let wanted = bor(fixed, centring_pair);
  let spare = free -sat around;
  let fits = spare >= 0_i32;
  let centring = band(wanted, fits);
  if centring {
    let room = free -sat around;
    if auto_left {
      if auto_right {
        let half = room / 2_i32;
        let left = margins.left +sat half;
        let right = free -sat left;
        return width, left, left, right;
      }
      let left = free -sat margins.right;
      return width, left, left, margins.right;
    }
    let right = free -sat margins.left;
    return width, margins.left, margins.left, right;
  }
  return width, margins.left, margins.left, margins.right;
}

fn auto_margin_offset(styles: &Styles, style: StyleRef, room: i32, child_width: i32, margin_left: i32, margin_right: i32) -> offset: i32 reads(styles) {
  doc "The offset of an in-flow child context's margin box from the left of the room it sits in (CSS 2.2 10.3.3): the child's left margin, plus, when it has an auto margin, what the width and the other margins leave: all of it for one auto margin, half for each of two. A child wider than the room keeps its left margin.";
  let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
  let used = child_width +sat margin_left;
  let all = used +sat margin_right;
  let free_raw = room -sat all;
  let free = imax(free_raw, 0_i32);
  if auto_left {
    if auto_right {
      let half = free / 2_i32;
      let made = margin_left +sat half;
      return made;
    }
    let made = margin_left +sat free;
    return made;
  }
  return margin_left;
}

fn relative_offset(styles: &Styles, style: StyleRef, basis_width: i32, basis_height: i32) -> (dx: i32, dy: i32) reads(styles) {
  doc "The offset position: relative gives a box (CSS 2.2 9.4.3): left, or minus right when left is auto; top, or minus bottom when top is auto; zero for every other position.";
  let group = box_of(styles: styles, style: style);
  if group.position == position_relative {
  } else {
    return 0_i32, 0_i32;
  }
  let sizes = size_of(styles: styles, style: style);
  let left = inset_value(value: sizes.left, basis: basis_width);
  let right = inset_value(value: sizes.right, basis: basis_width);
  let top = inset_value(value: sizes.top, basis: basis_height);
  let bottom = inset_value(value: sizes.bottom, basis: basis_height);
  let left_known = sizes.left.kind == sizing_value;
  let right_known = sizes.right.kind == sizing_value;
  let top_known = sizes.top.kind == sizing_value;
  let bottom_known = sizes.bottom.kind == sizing_value;
  let dx = if left_known {
    give left;
  } else if right_known {
    give 0_i32 -sat right;
  } else {
    give 0_i32;
  }
  let dy = if top_known {
    give top;
  } else if bottom_known {
    give 0_i32 -sat bottom;
  } else {
    give 0_i32;
  }
  return dx, dy;
}

fn flow_index(at: u64) -> index: u32 pure {
  doc "A flow position as the u32 the records keep, no_index past its range.";
  if at < 4294967295_u64 {
    let made = cvt::<u64, u32>(at);
    return made;
  }
  return no_index;
}

fn height_relative(styles: &Styles, style: StyleRef) -> relative: Bool reads(styles) {
  doc "Tells whether style's height, min-height or max-height is a percentage, which its containing block's height resolves.";
  let sizes = size_of(styles: styles, style: style);
  let height_value = sizes.height.kind == sizing_value;
  let min_value = sizes.min_height.kind == sizing_value;
  let max_value = sizes.max_height.kind == sizing_value;
  let height_percent = band(height_value, sizes.height.value.has_percent);
  let min_percent = band(min_value, sizes.min_height.value.has_percent);
  let max_percent = band(max_value, sizes.max_height.value.has_percent);
  let limits = bor(min_percent, max_percent);
  let made = bor(height_percent, limits);
  return made;
}

fn equivalent_space(styles: &Styles, style: StyleRef, first: Space, second: Space) -> same: Bool reads(styles) {
  doc "Tells whether a context styled style lays out the same in the two spaces: they are equal field by field, but for the height percentage basis when its height, min-height and max-height are not percentages, which is the only thing that reads it.";
  let relative = height_relative(styles: styles, style: style);
  if relative {
    let made = same_space(first: first, second: second);
    return made;
  }
  let rebased = Space(available: second.available, basis_width: second.basis_width, basis_height: first.basis_height, forced_width: second.forced_width, forced_height: second.forced_height, shrink: second.shrink);
  let made = same_space(first: first, second: rebased);
  return made;
}

fn innermost_block(frames: &Box<Slots<Frame>>) -> block: u32 reads(frames) {
  doc "The block of the innermost open frame, or no_index when none is open.";
  let count = frames^.inner.len;
  if count == 0_u64 {
    return no_index;
  }
  let last = count - 1_u64;
  let found = frames^.inner[last].block;
  return found;
}

fn prepare_spaces(context: &Context, styles: &Styles, content_width: i32, content_height: i32) -> result: unit reads(styles), writes(context) {
  doc "The pre-pass of a flow context: walks its flow with the containing widths of the open block boxes, sets each block's width and left offset, each paragraph's width and left offset, and each child context's space: in-flow children fill their containing block, floats, out-of-flow boxes and atomic inlines shrink to fit.";
  let frames = box_slots_new::<Frame>(capacity: 8_u64);
  let flow_count = context^.flow.inner.len;
  let left = 0_i32;
  let width = content_width;
  let next_split = 0_u64;
  set context^.has_out = False();
  let free = True();
  for (k in 0_u64..flow_count) {
    if k >= context^.flow.inner.len {
      break;
    }
    let item = context^.flow.inner[k];
    set next_split = place_splits(context: context, from: next_split, flow: k, left: left, width: width);
    let around = innermost_block(frames: &frames);
    let here = flow_index(at: k);
    match item {
      Open(block: b) => {
        let at = cvt::<u32, u64>(b);
        if at < context^.blocks.inner.len {
          set context^.blocks.inner[at].parent = around;
          set context^.blocks.inner[at].flow_at = here;
          let style = context^.blocks.inner[at].style;
          let relative = height_relative(styles: styles, style: style);
          let absolute_height = bnot(relative);
          set free = band(free, absolute_height);
          let (box_width, offset, margin_left, margin_right) = block_width(styles: styles, style: style, available: width);
          let x = left +sat offset;
          set context^.blocks.inner[at].x = x;
          set context^.blocks.inner[at].width = box_width;
          let border = border_edges(styles: styles, style: style);
          let padding = padding_edges(styles: styles, style: style, basis: width);
          let unknown_top = False();
          let saved = Frame(block: b, left: left, width: width, top_frame: 0_i32, known: unknown_top, dx: 0_i32, dy: 0_i32, lines: unknown_top);
          let pushed = push_item::<Frame>(cell: &frames, value: saved, ceiling: item_ceiling);
          let inner_left = x +sat border.left;
          set left = inner_left +sat padding.left;
          let frame_border = horizontal(edges: border);
          let frame_padding = horizontal(edges: padding);
          let frame = frame_border +sat frame_padding;
          let inner = box_width -sat frame;
          set width = imax(inner, 0_i32);
        }
      }
      Close(..) => {
        let depth = frames.inner.len;
        if depth > 0_u64 {
          let last = depth - 1_u64;
          set left = frames.inner[last].left;
          set width = frames.inner[last].width;
          let removed = take_back(window: &frames.inner);
        }
      }
      Text(paragraph: p) => {
        let at = cvt::<u32, u64>(p);
        if at < context^.paragraphs.inner.len {
          set context^.paragraphs.inner[at].width = width;
          set context^.paragraphs.inner[at].left = left;
          set context^.paragraphs.inner[at].flow_at = here;
          set context^.paragraphs.inner[at].block = around;
          let marks = context^.paragraphs.inner[at].marks.inner.len;
          for (m in 0_u64..marks) {
            let mark = context^.paragraphs.inner[at].marks.inner[m];
            match mark {
              Atomic(context: child, ..) => {
                let child_at = cvt::<u32, u64>(child);
                if child_at < context^.children.inner.len {
                  let yes = True();
                  set context^.children.inner[child_at].space = child_space(available: width, basis_width: width, basis_height: unknown, shrink: yes);
                  set context^.children.inner[child_at].flow_at = here;
                  set context^.children.inner[child_at].block = around;
                }
              }
              Open(..) => {
              }
              Close(..) => {
              }
              Node(..) => {
              }
            }
          }
        }
      }
      Child(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let no = False();
          let kind = context^.children.inner[at].kind;
          let table = kind == ctx_table;
          let replaced = kind == ctx_replaced;
          let fits = bor(table, replaced);
          set context^.children.inner[at].space = child_space(available: width, basis_width: width, basis_height: content_height, shrink: fits);
          set context^.children.inner[at].x = left;
          set context^.children.inner[at].flow_at = here;
          set context^.children.inner[at].block = around;
          let child_relative = height_relative(styles: styles, style: context^.children.inner[at].style);
          let child_absolute = bnot(child_relative);
          set free = band(free, child_absolute);
        }
      }
      Float(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let yes = True();
          set context^.children.inner[at].space = child_space(available: width, basis_width: width, basis_height: content_height, shrink: yes);
          set context^.children.inner[at].x = left;
          set context^.children.inner[at].flow_at = here;
          set context^.children.inner[at].block = around;
          let child_relative = height_relative(styles: styles, style: context^.children.inner[at].style);
          let child_absolute = bnot(child_relative);
          set free = band(free, child_absolute);
        }
      }
      Out(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let yes = True();
          set context^.children.inner[at].space = child_space(available: content_width, basis_width: content_width, basis_height: content_height, shrink: yes);
          set context^.children.inner[at].x = left;
          set context^.children.inner[at].flow_at = here;
          set context^.children.inner[at].block = around;
          let child_relative = height_relative(styles: styles, style: context^.children.inner[at].style);
          let child_absolute = bnot(child_relative);
          set free = band(free, child_absolute);
          set context^.has_out = True();
        }
      }
    }
  }
  set context^.definite_free = free;
  return unit;
}

fn lay_out_child(child: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, updating: Bool) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(child) {
  doc "Lays out one child context in the space its parent wrote, then resolves its margins against its containing block's width. When its parent is being updated (updating, pkg::layout's update), a child marked for update is updated (update_child), an unmarked one whose space is the one it was last laid out in keeps that layout, and an unmarked flow context in another space is updated in it from its last layout; any other child is laid out in full.";
  if updating {
    let marked = child^.dirty;
    let same = equivalent_space(styles: styles, style: child^.style, first: child^.laid, second: child^.space);
    let flowing = child^.kind == ctx_flow;
    let unmarked = bnot(marked);
    let kept = band(same, unmarked);
    if kept {
      resolve_margins(child: child, styles: styles);
      return unit;
    }
    let incremental = bor(marked, flowing);
    if incremental {
      let held = before_of(context: child);
      let counted = update_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: held);
      return unit;
    }
  }
  lay_out_context(context: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  resolve_margins(child: child, styles: styles);
  return unit;
}

fn resolve_margins(child: &Context, styles: &Styles) -> result: unit reads(styles), writes(child) {
  doc "Resolves a child context's margins against its containing block's width, the basis of the space its parent wrote.";
  let basis = child^.space.basis_width;
  let margins = margin_edges(styles: styles, style: child^.style, basis: basis);
  set child^.margin_top = margins.top;
  set child^.margin_right = margins.right;
  set child^.margin_bottom = margins.bottom;
  set child^.margin_left = margins.left;
  return unit;
}

fn lay_out_children(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out every child context, one per iteration of a counted loop, each iteration writing only its own child.";
  let count = context^.children.inner.len;
  let whole = False();
  for (i in 0_u64..count) {
    lay_out_child(child: &context^.children.inner[i], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: whole);
  }
  return unit;
}

fn break_paragraph(paragraph: &Paragraph, children: &[Context], styles: &Styles, fonts: &FontSet, picks: &FontPicks, exclusions: &[Exclusion], origin_y: i32) -> result: unit reads(children), reads(styles), reads(fonts), reads(picks), reads(exclusions), writes(paragraph) {
  doc "Breaks a paragraph into lines at its width beside exclusions (none for the speculative pass) and computes its lines' metrics and fragments.";
  let width = paragraph^.width;
  let sizes = measure(paragraph: paragraph, children: children, styles: styles, basis: width);
  let origin_x = paragraph^.left;
  break_lines(paragraph: paragraph, sizes: &sizes, styles: styles, fonts: fonts, picks: picks, exclusions: exclusions, origin_x: origin_x, origin_y: origin_y, width: width);
  finish_lines(paragraph: paragraph, sizes: &sizes, children: children, styles: styles, fonts: fonts, picks: picks, basis: width);
  return unit;
}

fn break_all(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(styles), reads(fonts), reads(picks), writes(context) {
  doc "The speculative pass (design/pipeline/layout.md): breaks every paragraph at its full width in one counted loop, each iteration writing only its own paragraph.";
  let count = context^.paragraphs.inner.len;
  let children = context^.children.inner.len;
  let none = box_slots_new::<Exclusion>(capacity: 0_u64);
  for (i in 0_u64..count) {
    break_paragraph(paragraph: &context^.paragraphs.inner[i], children: &context^.children.inner[0_u64..children], styles: styles, fonts: fonts, picks: picks, exclusions: &none.inner[0_u64..0_u64], origin_y: 0_i32);
  }
  return unit;
}

fn place_float(context: &Context, stack: &Stack, child: u64, side_left: Bool, containing_left: i32, containing_width: i32, content_left: i32, content_top: i32) -> result: unit writes(context), writes(stack) {
  doc "Places a laid-out float (CSS 2.2 9.5.1): at the flow's current position or the previous float's top, whichever is lower, moved down past floats until its margin box fits beside them, against the left or right edge of the space they leave, and records it as an exclusion.";
  if child < context^.children.inner.len {
  } else {
    return unit;
  }
  let style = context^.children.inner[child].style;
  let width = context^.children.inner[child].width;
  let height = context^.children.inner[child].height;
  let margin_left = context^.children.inner[child].margin_left;
  let margin_right = context^.children.inner[child].margin_right;
  let margin_top = context^.children.inner[child].margin_top;
  let margin_bottom = context^.children.inner[child].margin_bottom;
  let box_width = width +sat margin_left;
  let outer_width = box_width +sat margin_right;
  let box_height = height +sat margin_top;
  let outer_height = box_height +sat margin_bottom;
  let start_term = pending_margin(stack: stack);
  let start = stack^.cursor +sat start_term;
  let y = imax(start, stack^.float_floor);
  let count = stack^.floats.inner.len;
  let containing_right = containing_left +sat containing_width;
  let x = containing_left;
  for (attempt in 0_u64..count) {
    let bottom = y +sat outer_height;
    let (left_edge, right_edge) = exclusion_room(exclusions: &stack^.floats.inner[0_u64..count], top: y, bottom: bottom, width: containing_right);
    let left_limit = imax(left_edge, containing_left);
    let right_limit = imin(right_edge, containing_right);
    let room = right_limit -sat left_limit;
    if room >= outer_width {
      if side_left {
        set x = left_limit;
      } else {
        set x = right_limit -sat outer_width;
      }
      break;
    }
    let next = lowest_bottom_above(exclusions: &stack^.floats.inner[0_u64..count], top: y);
    if next <= y {
      if side_left {
        set x = left_limit;
      } else {
        set x = right_limit -sat outer_width;
      }
      break;
    }
    set y = next;
  }
  if count == 0_u64 {
    if side_left {
      set x = containing_left;
    } else {
      set x = containing_right -sat outer_width;
    }
  }
  let x_box = x +sat margin_left;
  let y_box = y +sat margin_top;
  set context^.children.inner[child].x = content_left +sat x_box;
  set context^.children.inner[child].y = content_top +sat y_box;
  let edge = if side_left {
    give x +sat outer_width;
  } else {
    give x;
  }
  let bottom = y +sat outer_height;
  let made = Exclusion(left: side_left, top: y, bottom: bottom, edge: edge);
  let pushed = push_item::<Exclusion>(cell: &stack^.floats, value: made, ceiling: item_ceiling);
  set stack^.float_floor = imax(stack^.float_floor, y);
  set stack^.reach = imax(stack^.reach, bottom);
  return unit;
}

fn lowest_bottom_above(exclusions: &[Exclusion], top: i32) -> bottom: i32 reads(exclusions) {
  doc "The smallest float bottom below top, where the space beside the floats next changes, or top when none is.";
  let best = 2147483647_i32;
  let count = exclusions^.len;
  for (k in 0_u64..count) {
    let bottom = exclusions^[k].bottom;
    if bottom > top {
      set best = imin(best, bottom);
    }
  }
  if best == 2147483647_i32 {
    return top;
  }
  return best;
}

fn overlaps_floats(stack: &Stack, top: i32, bottom: i32) -> overlapping: Bool reads(stack) {
  doc "Tells whether a float's extent meets top to bottom.";
  let count = stack^.floats.inner.len;
  for (k in 0_u64..count) {
    let float_box = stack^.floats.inner[k];
    let below = float_box.bottom <= top;
    let above = float_box.top >= bottom;
    let disjoint_span = bor(below, above);
    if disjoint_span {
    } else {
      return True();
    }
  }
  return False();
}

fn resolve_open(context: &Context, frames: &Box<Slots<Frame>>, y: i32) -> result: unit writes(context), writes(frames) {
  doc "Gives every open block whose top was waiting on its margins collapsing the border-box top y.";
  let count = frames^.inner.len;
  for (k in 0_u64..count) {
    if frames^.inner[k].known {
    } else {
      let block = cvt::<u32, u64>(frames^.inner[k].block);
      if block < context^.blocks.inner.len {
        set context^.blocks.inner[block].y = y;
      }
      set frames^.inner[k].known = True();
    }
  }
  return unit;
}

fn narrow_beside(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, child: u64, room: i32, needed: i32) -> narrowed: Bool reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out again, room wide, an in-flow child context of auto width that does not fit, needed wide, in the room floats leave beside it, as the reference narrows a box that establishes a formatting context beside floats (CSS 2.2 9.5); a table or replaced box keeps its width. Tells whether it did.";
  if room >= needed {
    return False();
  }
  if child < context^.children.inner.len {
  } else {
    return False();
  }
  let kind = context^.children.inner[child].kind;
  let table = kind == ctx_table;
  let replaced = kind == ctx_replaced;
  let fixed_kind = bor(table, replaced);
  if fixed_kind {
    return False();
  }
  let style = context^.children.inner[child].style;
  let basis = context^.children.inner[child].space.basis_width;
  let specified = specified_width(styles: styles, style: style, basis: basis, frame: 0_i32);
  if specified >= 0_i32 {
    return False();
  }
  let room_left = imax(room, 0_i32);
  let updating = context^.dirty;
  set context^.children.inner[child].space.available = room_left;
  let laid = context^.children.inner[child].laid;
  let now = context^.children.inner[child].space;
  let same = equivalent_space(styles: styles, style: style, first: laid, second: now);
  let unmarked = bnot(context^.children.inner[child].dirty);
  let unchanged = band(same, unmarked);
  let keeps = band(updating, unchanged);
  if keeps {
  } else {
    set context^.children.inner[child].intrinsic_known = False();
  }
  if child < context^.children.inner.len {
    lay_out_child(child: &context^.children.inner[child], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: updating);
  }
  return True();
}

const no_line: i32 = -2147483647_i32;

fn open_unresolved(frames: &Box<Slots<Frame>>) -> unresolved: Bool reads(frames) {
  doc "Tells whether an open block's top still waits on the margins that follow, so a block starting now has its top margin collapse through that block's.";
  let count = frames^.inner.len;
  for (k in 0_u64..count) {
    if frames^.inner[k].known {
    } else {
      return True();
    }
  }
  return False();
}

fn line_splits(context: &Context, from: u64, flow: u64, line: i32) -> next: u64 writes(context) {
  doc "Gives the block-in-inline records from from on whose block opens at flow entry flow the top line of the line before it, and returns the first record past them.";
  let at = from;
  let count = context^.splits.inner.len;
  for (step in from..count) {
    if at < context^.splits.inner.len {
      let opens = cvt::<u32, u64>(context^.splits.inner[at].open);
      if opens == flow {
        set context^.splits.inner[at].line = line;
        set at = at +sat 1_u64;
      } else {
        break;
      }
    }
  }
  return at;
}

fn place_splits(context: &Context, from: u64, flow: u64, left: i32, width: i32) -> next: u64 writes(context) {
  doc "Gives the block-in-inline records from from on whose block opens at flow entry flow the content box left and width it sits in, and returns the first record past them.";
  let at = from;
  let count = context^.splits.inner.len;
  for (step in from..count) {
    if at < context^.splits.inner.len {
      let opens = cvt::<u32, u64>(context^.splits.inner[at].open);
      if opens == flow {
        set context^.splits.inner[at].left = left;
        set context^.splits.inner[at].width = width;
        set at = at +sat 1_u64;
      } else {
        break;
      }
    }
  }
  return at;
}

fn entry_extent(context: &Context, flow: u32) -> (top: i32, bottom: i32) reads(context) {
  doc "The top and bottom, in the context's border box, of the block or child context whose flow entry is flow: a block's at its Open or Close entry, a child context's at its Child entry.";
  let at = cvt::<u32, u64>(flow);
  if at < context^.flow.inner.len {
  } else {
    return 0_i32, 0_i32;
  }
  let item = context^.flow.inner[at];
  match item {
    Open(block: b) => {
      let index = cvt::<u32, u64>(b);
      if index < context^.blocks.inner.len {
        let top = context^.blocks.inner[index].y;
        let bottom = top +sat context^.blocks.inner[index].height;
        return top, bottom;
      }
    }
    Close(block: b) => {
      let index = cvt::<u32, u64>(b);
      if index < context^.blocks.inner.len {
        let top = context^.blocks.inner[index].y;
        let bottom = top +sat context^.blocks.inner[index].height;
        return top, bottom;
      }
    }
    Child(context: c) => {
      let index = cvt::<u32, u64>(c);
      if index < context^.children.inner.len {
        let top = context^.children.inner[index].y;
        let bottom = top +sat context^.children.inner[index].height;
        return top, bottom;
      }
    }
    Text(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  return 0_i32, 0_i32;
}

fn lineless(context: &Context, flow: u64) -> empty: Bool reads(context) {
  doc "Tells whether flow entry flow is a paragraph without lines.";
  if flow < context^.flow.inner.len {
  } else {
    return False();
  }
  let item = context^.flow.inner[flow];
  match item {
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        let lines = context^.paragraphs.inner[at].lines.inner.len;
        let none = lines == 0_u64;
        return none;
      }
    }
    Open(..) => {
    }
    Close(..) => {
    }
    Child(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  return False();
}

fn closes_split(context: &Context, flow: u64) -> found: Bool reads(context) {
  doc "Tells whether flow entry flow closes a block that interrupts an inline box, so that the line after it holds that box's end.";
  let count = context^.splits.inner.len;
  for (k in 0_u64..count) {
    let closing = cvt::<u32, u64>(context^.splits.inner[k].close);
    if closing == flow {
      return True();
    }
  }
  return False();
}

fn sibling_above(context: &Context, flow: u64) -> found: Bool reads(context) {
  doc "Tells whether a closed block that interrupts no inline box, or a child context, precedes flow in its container with only paragraphs without lines between, so that the margins above flow collapse with that sibling's; a paragraph with lines, a block that interrupts an inline box (whose end opens a line) or the container's own opening entry first tells no.";
  for (back in 0_u64..flow) {
    let before = flow - back;
    let at = before - 1_u64;
    if at < context^.flow.inner.len {
      let item = context^.flow.inner[at];
      match item {
        Text(..) => {
          let empty = lineless(context: context, flow: at);
          if empty {
          } else {
            return False();
          }
        }
        Open(..) => {
          return False();
        }
        Close(..) => {
          let interrupting = closes_split(context: context, flow: at);
          return bnot(interrupting);
        }
        Child(..) => {
          return True();
        }
        Float(..) => {
        }
        Out(..) => {
        }
      }
    }
  }
  return False();
}

fn gap_lineless(context: &Context, after: u32, before: u32) -> empty: Bool reads(context) {
  doc "Tells whether every flow entry strictly between after and before is a paragraph without lines.";
  let low = cvt::<u32, u64>(after);
  let high = cvt::<u32, u64>(before);
  let from = low +sat 1_u64;
  if from > high {
    return False();
  }
  for (k in from..high) {
    let empty = lineless(context: context, flow: k);
    if empty {
    } else {
      return False();
    }
  }
  return True();
}

fn shows_owner(context: &Context, flow: u64, owner: u32, opening: Bool) -> shown: Bool reads(context) {
  doc "Tells whether flow entry flow is a paragraph with lines in which owner's inline box opens (opening) or closes, so that it reports owner's rectangle there itself.";
  if flow < context^.flow.inner.len {
  } else {
    return False();
  }
  let item = context^.flow.inner[flow];
  let paragraph = match item {
    Text(paragraph: p) => {
      give cvt::<u32, u64>(p);
    }
    Open(..) => {
      give 18446744073709551615_u64;
    }
    Close(..) => {
      give 18446744073709551615_u64;
    }
    Child(..) => {
      give 18446744073709551615_u64;
    }
    Float(..) => {
      give 18446744073709551615_u64;
    }
    Out(..) => {
      give 18446744073709551615_u64;
    }
  }
  if paragraph < context^.paragraphs.inner.len {
  } else {
    return False();
  }
  let lines = context^.paragraphs.inner[paragraph].lines.inner.len;
  if lines == 0_u64 {
    return False();
  }
  let marks = context^.paragraphs.inner[paragraph].marks.inner.len;
  for (m in 0_u64..marks) {
    if paragraph < context^.paragraphs.inner.len {
      if m < context^.paragraphs.inner[paragraph].marks.inner.len {
        let mark = context^.paragraphs.inner[paragraph].marks.inner[m];
        let found = match mark {
          Open(style: s, ..) => {
            let same = s.element == owner;
            let plain = bnot(s.anonymous);
            let own = s.pseudo == no_pseudo;
            let shown_style = band(plain, own);
            let named = band(same, shown_style);
            give band(named, opening);
          }
          Close(style: s, ..) => {
            let same = s.element == owner;
            let plain = bnot(s.anonymous);
            let own = s.pseudo == no_pseudo;
            let shown_style = band(plain, own);
            let named = band(same, shown_style);
            let closing = bnot(opening);
            give band(named, closing);
          }
          Atomic(..) => {
            give False();
          }
          Node(..) => {
            give False();
          }
        }
        if found {
          return True();
        }
      }
    }
  }
  return False();
}

fn entry_margin(context: &Context, styles: &Styles, flow: u32, basis: i32, below: Bool) -> margin: i32 reads(context), reads(styles) {
  doc "The top margin (or the bottom one, when below) of the block or child context whose flow entry is flow.";
  let at = cvt::<u32, u64>(flow);
  if at < context^.flow.inner.len {
  } else {
    return 0_i32;
  }
  let item = context^.flow.inner[at];
  let style = match item {
    Open(block: b) => {
      let index = cvt::<u32, u64>(b);
      if index < context^.blocks.inner.len {
        give context^.blocks.inner[index].style;
      } else {
        give context^.style;
      }
    }
    Close(block: b) => {
      let index = cvt::<u32, u64>(b);
      if index < context^.blocks.inner.len {
        give context^.blocks.inner[index].style;
      } else {
        give context^.style;
      }
    }
    Child(context: c) => {
      let index = cvt::<u32, u64>(c);
      if index < context^.children.inner.len {
        if below {
          return context^.children.inner[index].margin_bottom;
        }
        return context^.children.inner[index].margin_top;
      }
      give context^.style;
    }
    Text(..) => {
      return 0_i32;
    }
    Float(..) => {
      return 0_i32;
    }
    Out(..) => {
      return 0_i32;
    }
  }
  let margins = margin_edges(styles: styles, style: style, basis: basis);
  if below {
    return margins.bottom;
  }
  return margins.top;
}

fn split_fragments(context: &Context, styles: &Styles, content_left: i32) -> result: unit reads(styles), writes(context) {
  doc "Adds the rectangles the reference reports for inline boxes that blocks interrupt (CSS 2.2 9.2.1.1): one per run of their blocks, as wide as the content box the blocks sit in, from the first block's top to the last one's bottom (blocks separated only by paragraphs without lines form one run), and an empty one where the line before the run would start (after the margins before it collapse) or at its bottom margin edge where the inline box has no line before or after it; and an empty one for each inline box of a paragraph without lines whose element no block interrupts.";
  let count = context^.splits.inner.len;
  let bounded = imin(count, item_ceiling);
  let used = box_array_filled::<u8>(count: bounded, value: 0_u8);
  for (k in 0_u64..bounded) {
    if k < used.inner.len {
      if used.inner[k] == 0_u8 {
        if k < context^.splits.inner.len {
          let first = context^.splits.inner[k];
          let last_close = first.close;
          let run_end = k;
          for (j in k..bounded) {
            if j > k {
              if j < context^.splits.inner.len {
                let next = context^.splits.inner[j];
                if next.owner == first.owner {
                  let joined = gap_lineless(context: context, after: last_close, before: next.open);
                  if joined {
                    set last_close = next.close;
                    set run_end = j;
                    if j < used.inner.len {
                      set used.inner[j] = 1_u8;
                    }
                  } else {
                    break;
                  }
                }
              }
            }
          }
          let (top, first_bottom) = entry_extent(context: context, flow: first.open);
          let (last_top, bottom) = entry_extent(context: context, flow: last_close);
          let x = content_left +sat first.left;
          let height = bottom -sat top;
          let run_open = cvt::<u32, u64>(first.open);
          let run_close = cvt::<u32, u64>(last_close);
          let yes = True();
          let no = False();
          let has_before = if run_open > 0_u64 {
            let before = run_open - 1_u64;
            give shows_owner(context: context, flow: before, owner: first.owner, opening: no);
          } else {
            give False();
          }
          if bnot(has_before) {
            let sibling = sibling_above(context: context, flow: run_open);
            let line_y = if first.line == no_line {
              give top;
            } else if sibling {
              give top;
            } else {
              give first.line;
            }
            add_fragment(context: context, kind: placed_element, owner: first.owner, x: x, y: line_y, width: 0_i32, height: 0_i32);
          }
          add_fragment(context: context, kind: placed_element, owner: first.owner, x: x, y: top, width: first.width, height: height);
          let after = run_close +sat 1_u64;
          let has_after = shows_owner(context: context, flow: after, owner: first.owner, opening: yes);
          if bnot(has_after) {
            let beneath = entry_margin(context: context, styles: styles, flow: last_close, basis: first.width, below: yes);
            let line_bottom = bottom +sat beneath;
            add_fragment(context: context, kind: placed_element, owner: first.owner, x: x, y: line_bottom, width: 0_i32, height: 0_i32);
          }
        }
      }
    }
  }
  let entries = context^.flow.inner.len;
  for (k in 0_u64..entries) {
    let empty = lineless(context: context, flow: k);
    if empty {
      empty_inline_fragments(context: context, flow: k);
    }
  }
  return unit;
}

fn split_owner(context: &Context, owner: u32) -> found: Bool reads(context) {
  doc "Tells whether a block interrupts owner's inline box in this context.";
  let count = context^.splits.inner.len;
  for (k in 0_u64..count) {
    if context^.splits.inner[k].owner == owner {
      return True();
    }
  }
  return False();
}

fn empty_inline_fragments(context: &Context, flow: u64) -> result: unit writes(context) {
  doc "Adds an empty rectangle, at the paragraph's origin, for each inline box that opens in the paragraph at flow entry flow, which has no lines, when no block interrupts its element here.";
  if flow < context^.flow.inner.len {
  } else {
    return unit;
  }
  let item = context^.flow.inner[flow];
  let paragraph = match item {
    Text(paragraph: p) => {
      give cvt::<u32, u64>(p);
    }
    Open(..) => {
      give 18446744073709551615_u64;
    }
    Close(..) => {
      give 18446744073709551615_u64;
    }
    Child(..) => {
      give 18446744073709551615_u64;
    }
    Float(..) => {
      give 18446744073709551615_u64;
    }
    Out(..) => {
      give 18446744073709551615_u64;
    }
  }
  if paragraph < context^.paragraphs.inner.len {
  } else {
    return unit;
  }
  let left = context^.paragraphs.inner[paragraph].left;
  let top = context^.paragraphs.inner[paragraph].top;
  let marks = context^.paragraphs.inner[paragraph].marks.inner.len;
  for (m in 0_u64..marks) {
    if paragraph < context^.paragraphs.inner.len {
      if m < context^.paragraphs.inner[paragraph].marks.inner.len {
        let mark = context^.paragraphs.inner[paragraph].marks.inner[m];
        match mark {
          Open(style: s, ..) => {
            let plain = bnot(s.anonymous);
            let own = s.pseudo == no_pseudo;
            let shown = band(plain, own);
            if shown {
              let interrupted = split_owner(context: context, owner: s.element);
              if bnot(interrupted) {
                add_fragment(context: context, kind: placed_element, owner: s.element, x: left, y: top, width: 0_i32, height: 0_i32);
              }
            }
          }
          Close(..) => {
          }
          Atomic(..) => {
          }
          Node(..) => {
          }
        }
      }
    }
  }
  return unit;
}

fn mark_lines(frames: &Box<Slots<Frame>>) -> result: unit writes(frames) {
  doc "Records that a line box lies inside every open block.";
  let count = frames^.inner.len;
  for (k in 0_u64..count) {
    set frames^.inner[k].lines = True();
  }
  return unit;
}

fn marker_line(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks, at: u64, lines: Bool) -> height: i32 reads(context), reads(styles), reads(fonts), reads(picks) {
  doc "The height of the line an outside marker makes in the block at, a list item no line box lies inside of (its line-height box), or 0 when it makes none.";
  if lines {
    return 0_i32;
  }
  if at < context^.blocks.inner.len {
  } else {
    return 0_i32;
  }
  if context^.blocks.inner[at].marker {
  } else {
    return 0_i32;
  }
  let style = context^.blocks.inner[at].style;
  let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: style);
  let made = metrics.ascent +sat metrics.descent;
  return made;
}

fn offset_of(frames: &Box<Slots<Frame>>) -> (dx: i32, dy: i32) reads(frames) {
  doc "The relative offset the open blocks add to what they contain.";
  let count = frames^.inner.len;
  if count == 0_u64 {
    return 0_i32, 0_i32;
  }
  let last = count - 1_u64;
  return frames^.inner[last].dx, frames^.inner[last].dy;
}

fn paragraph_height(context: &Context, at: u64) -> height: i32 reads(context) {
  doc "The height of paragraph at, 0 when there is none.";
  if at < context^.paragraphs.inner.len {
    let found = context^.paragraphs.inner[at].height;
    return found;
  }
  return 0_i32;
}

fn last_baseline(context: &Context, at: u64) -> (baseline: i32, found: Bool) reads(context) {
  doc "The baseline of paragraph at's last line from the paragraph's top, and whether it has a line.";
  if at < context^.paragraphs.inner.len {
    let count = context^.paragraphs.inner[at].lines.inner.len;
    if count > 0_u64 {
      let last = count - 1_u64;
      let line = context^.paragraphs.inner[at].lines.inner[last];
      let made = line.top +sat line.baseline;
      return made, True();
    }
  }
  return 0_i32, False();
}

fn place_paragraph(context: &Context, at: u64, content_left: i32, dx: i32, top: i32) -> result: unit writes(context) {
  doc "Sets paragraph at's origin in the context's border box, x its left moved by the content box's left and the relative offset dx, and places its atomic inlines' child contexts (place_atomics).";
  if at < context^.paragraphs.inner.len {
  } else {
    return unit;
  }
  let shifted_left = context^.paragraphs.inner[at].left +sat dx;
  let left = content_left +sat shifted_left;
  set context^.paragraphs.inner[at].x = left;
  set context^.paragraphs.inner[at].top = top;
  place_atomics(context: context, at: at);
  return unit;
}

fn place_atomics(context: &Context, at: u64) -> result: unit writes(context) {
  doc "Places the child contexts of paragraph at's atomic inlines at its origin plus their offsets.";
  if at < context^.paragraphs.inner.len {
  } else {
    return unit;
  }
  let left = context^.paragraphs.inner[at].x;
  let top = context^.paragraphs.inner[at].top;
  let atomics = context^.paragraphs.inner[at].atomics.inner.len;
  for (a in 0_u64..atomics) {
    if at < context^.paragraphs.inner.len {
      if a < context^.paragraphs.inner[at].atomics.inner.len {
        let placed = context^.paragraphs.inner[at].atomics.inner[a];
        let child = cvt::<u32, u64>(placed.context);
        if child < context^.children.inner.len {
          set context^.children.inner[child].x = left +sat placed.x;
          set context^.children.inner[child].y = top +sat placed.y;
        }
      }
    }
  }
  return unit;
}

fn stack_flow(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, content_left: i32, content_top: i32, content_width: i32, basis_height: i32) -> (height: i32, baseline: i32, has_baseline: Bool) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "The stacking pass of a flow context, the one walk that keeps the true order of its content: places block boxes, paragraphs and in-flow child contexts down the content box with CSS 2.2's margin collapsing (8.3.1) and clearance, places floats as they come and breaks again the paragraphs that floats narrow, records out-of-flow children's static positions, and returns the content height, which contains the floats, and the last line's baseline.";
  let empty_floats = box_slots_new::<Exclusion>(capacity: 0_u64);
  let stack = Stack(cursor: 0_i32, positive: 0_i32, negative: 0_i32, floats: move empty_floats, float_floor: -2147483647_i32, reach: -2147483647_i32);
  set context^.baseline_entry = no_index;
  let frames = box_slots_new::<Frame>(capacity: 8_u64);
  let left = 0_i32;
  let width = content_width;
  let baseline = 0_i32;
  let has_baseline = False();
  let next_split = 0_u64;
  let flow_count = context^.flow.inner.len;
  for (k in 0_u64..flow_count) {
    if k >= context^.flow.inner.len {
      break;
    }
    let item = context^.flow.inner[k];
    let waiting_line = pending_margin(stack: &stack);
    let line_offset = stack.cursor +sat waiting_line;
    let line_at = content_top +sat line_offset;
    let through = open_unresolved(frames: &frames);
    let line_top = if through {
      give no_line;
    } else {
      give line_at;
    }
    set next_split = line_splits(context: context, from: next_split, flow: k, line: line_top);
    match item {
      Open(block: b) => {
        let at = cvt::<u32, u64>(b);
        if at < context^.blocks.inner.len {
          let style = context^.blocks.inner[at].style;
          let block_x = context^.blocks.inner[at].x;
          let block_width_here = context^.blocks.inner[at].width;
          let border = border_edges(styles: styles, style: style);
          let padding = padding_edges(styles: styles, style: style, basis: width);
          let margins = margin_edges(styles: styles, style: style, basis: width);
          let group = box_of(styles: styles, style: style);
          let top_frame = border.top +sat padding.top;
          add_margin(stack: &stack, margin: margins.top);
          let (outer_dx, outer_dy) = offset_of(frames: &frames);
          let (dx, dy) = relative_offset(styles: styles, style: style, basis_width: width, basis_height: unknown);
          let total_dx = outer_dx +sat dx;
          let total_dy = outer_dy +sat dy;
          let clears = group.clear != clear_none;
          let clear_floor = if clears {
            give float_bottom(stack: &stack, side: group.clear);
          } else {
            give -2147483647_i32;
          }
          let natural_term = pending_margin(stack: &stack);
          let natural = stack.cursor +sat natural_term;
          let cleared = clear_floor > natural;
          let unknown_top = False();
          let saved = Frame(block: b, left: left, width: width, top_frame: top_frame, known: unknown_top, dx: total_dx, dy: total_dy, lines: unknown_top);
          let pushed = push_item::<Frame>(cell: &frames, value: saved, ceiling: item_ceiling);
          let framed = top_frame > 0_i32;
          let resolve = bor(framed, cleared);
          if resolve {
            let y = imax(natural, clear_floor);
            resolve_open(context: context, frames: &frames, y: y);
            set stack.cursor = y +sat top_frame;
            clear_margins(stack: &stack);
          }
          let inner_left = block_x +sat border.left;
          set left = inner_left +sat padding.left;
          let frame_border = horizontal(edges: border);
          let frame_padding = horizontal(edges: padding);
          let frame = frame_border +sat frame_padding;
          let inner = block_width_here -sat frame;
          set width = imax(inner, 0_i32);
        }
      }
      Close(block: b) => {
        let depth = frames.inner.len;
        let at = cvt::<u32, u64>(b);
        let present = at < context^.blocks.inner.len;
        let open = depth > 0_u64;
        let usable = band(present, open);
        if usable {
          let last = depth - 1_u64;
          let frame = frames.inner[last];
          let style = context^.blocks.inner[at].style;
          let outer_width = frame.width;
          let border = border_edges(styles: styles, style: style);
          let padding = padding_edges(styles: styles, style: style, basis: outer_width);
          let margins = margin_edges(styles: styles, style: style, basis: outer_width);
          let bottom_frame = border.bottom +sat padding.bottom;
          let vertical_frame = frame.top_frame +sat bottom_frame;
          let specified = specified_height(styles: styles, style: style, basis: basis_height, frame: vertical_frame);
          let (minimum, maximum) = height_limits(styles: styles, style: style, basis: basis_height, frame: vertical_frame);
          let marker = marker_line(context: context, styles: styles, fonts: fonts, picks: picks, at: at, lines: frame.lines);
          let has_marker = marker > 0_i32;
          if frame.known {
            let top = context^.blocks.inner[at].y;
            let closes_inside = bottom_frame > 0_i32;
            let fixed = specified >= 0_i32;
            let contained = bor(closes_inside, fixed);
            let collapsed_end = pending_margin(stack: &stack);
            let flow_end = if contained {
              give stack.cursor +sat collapsed_end;
            } else {
              give stack.cursor;
            }
            let marker_top = top +sat frame.top_frame;
            let marker_end = marker_top +sat marker;
            let content_end = imax(flow_end, marker_end);
            let natural = content_end -sat top;
            let automatic = natural +sat bottom_frame;
            let chosen = if fixed {
              give specified;
            } else {
              give automatic;
            }
            let clamped = clamp_size(size: chosen, minimum: minimum, maximum: maximum);
            let height = imax(clamped, vertical_frame);
            set context^.blocks.inner[at].height = height;
            let grew = height != automatic;
            let held_apart = bor(contained, grew);
            let separate = bor(held_apart, has_marker);
            if separate {
              set stack.cursor = top +sat height;
              clear_margins(stack: &stack);
            }
            add_margin(stack: &stack, margin: margins.bottom);
          } else {
            let y_term = pending_margin(stack: &stack);
            let y = stack.cursor +sat y_term;
            set context^.blocks.inner[at].y = y;
            set frames.inner[last].known = True();
            let chosen = if specified >= 0_i32 {
              give specified;
            } else {
              give marker +sat vertical_frame;
            }
            let clamped = clamp_size(size: chosen, minimum: minimum, maximum: maximum);
            let height = imax(clamped, vertical_frame);
            set context^.blocks.inner[at].height = height;
            if height > 0_i32 {
              resolve_open(context: context, frames: &frames, y: y);
              set stack.cursor = y +sat height;
              clear_margins(stack: &stack);
            }
            add_margin(stack: &stack, margin: margins.bottom);
          }
          let still_open = frames.inner.len;
          if still_open > 0_u64 {
            let removed = take_back(window: &frames.inner);
          }
          let lines_inside = bor(frame.lines, has_marker);
          if lines_inside {
            mark_lines(frames: &frames);
          }
          set left = frame.left;
          set width = frame.width;
          let dx = frame.dx;
          let dy = frame.dy;
          if at < context^.blocks.inner.len {
            let x_shifted = context^.blocks.inner[at].x +sat dx;
            let y_shifted = context^.blocks.inner[at].y +sat dy;
            set context^.blocks.inner[at].x = content_left +sat x_shifted;
            set context^.blocks.inner[at].y = content_top +sat y_shifted;
          }
        }
      }
      Text(paragraph: p) => {
        let at = cvt::<u32, u64>(p);
        let lines = if at < context^.paragraphs.inner.len {
          give context^.paragraphs.inner[at].lines.inner.len;
        } else {
          give 0_u64;
        }
        if lines > 0_u64 {
          let waiting = pending_margin(stack: &stack);
          let y = stack.cursor +sat waiting;
          resolve_open(context: context, frames: &frames, y: y);
          mark_lines(frames: &frames);
          clear_margins(stack: &stack);
          let height = paragraph_height(context: context, at: at);
          let bottom = y +sat height;
          let narrowed = overlaps_floats(stack: &stack, top: y, bottom: bottom);
          let children = context^.children.inner.len;
          let floats = stack.floats.inner.len;
          let present = at < context^.paragraphs.inner.len;
          let rebreak = band(narrowed, present);
          if rebreak {
            break_paragraph(paragraph: &context^.paragraphs.inner[at], children: &context^.children.inner[0_u64..children], styles: styles, fonts: fonts, picks: picks, exclusions: &stack.floats.inner[0_u64..floats], origin_y: y);
          }
          let placed_height = paragraph_height(context: context, at: at);
          let (dx, dy) = offset_of(frames: &frames);
          let (line_base, has_line) = last_baseline(context: context, at: at);
          if has_line {
            let from_top = y +sat line_base;
            set baseline = content_top +sat from_top;
            set has_baseline = True();
            set context^.baseline_entry = flow_index(at: k);
          }
          if at < context^.paragraphs.inner.len {
            set context^.paragraphs.inner[at].beside = stack.reach > y;
          }
          set stack.cursor = y +sat placed_height;
          let shifted_top = y +sat dy;
          let top = content_top +sat shifted_top;
          place_paragraph(context: context, at: at, content_left: content_left, dx: dx, top: top);
        }
      }
      Child(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let style = context^.children.inner[at].style;
          let group = box_of(styles: styles, style: style);
          add_margin(stack: &stack, margin: context^.children.inner[at].margin_top);
          let natural_term = pending_margin(stack: &stack);
          let natural = stack.cursor +sat natural_term;
          let clear_floor = if group.clear != clear_none {
            give float_bottom(stack: &stack, side: group.clear);
          } else {
            give -2147483647_i32;
          }
          let y_start = imax(natural, clear_floor);
          let child_height = context^.children.inner[at].height;
          let child_width = context^.children.inner[at].width;
          let margin_left = context^.children.inner[at].margin_left;
          let y = y_start;
          let margin_right_here = context^.children.inner[at].margin_right;
          let x_offset = auto_margin_offset(styles: styles, style: style, room: width, child_width: child_width, margin_left: margin_left, margin_right: margin_right_here);
          let floats = stack.floats.inner.len;
          if floats > 0_u64 {
            for (attempt in 0_u64..floats) {
              let bottom = y +sat child_height;
              let containing_right = left +sat width;
              let (left_edge, right_edge) = exclusion_room(exclusions: &stack.floats.inner[0_u64..floats], top: y, bottom: bottom, width: containing_right);
              let left_limit = imax(left_edge, left);
              let right_limit = imin(right_edge, containing_right);
              let room = right_limit -sat left_limit;
              let needed = child_width +sat margin_left;
              let narrowed = narrow_beside(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, child: at, room: room, needed: needed);
              if narrowed {
                if at < context^.children.inner.len {
                  set child_height = context^.children.inner[at].height;
                  set child_width = context^.children.inner[at].width;
                }
              }
              let fitted = child_width +sat margin_left;
              if room >= fitted {
                let clear_left_side = left_edge <= left;
                let clear_right_side = right_edge >= containing_right;
                let clear_of_floats = band(clear_left_side, clear_right_side);
                if clear_of_floats {
                } else {
                  set x_offset = left_limit -sat left;
                  set x_offset = x_offset +sat margin_left;
                }
                break;
              }
              let next = lowest_bottom_above(exclusions: &stack.floats.inner[0_u64..floats], top: y);
              if next <= y {
                break;
              }
              set y = next;
            }
          }
          resolve_open(context: context, frames: &frames, y: y);
          clear_margins(stack: &stack);
          let (dx, dy) = offset_of(frames: &frames);
          let (own_dx, own_dy) = relative_offset(styles: styles, style: style, basis_width: width, basis_height: unknown);
          let x_inner = left +sat x_offset;
          let x_moved = x_inner +sat dx;
          let x_total = x_moved +sat own_dx;
          let y_moved = y +sat dy;
          let y_total = y_moved +sat own_dy;
          if at < context^.children.inner.len {
            set context^.children.inner[at].x = content_left +sat x_total;
            set context^.children.inner[at].y = content_top +sat y_total;
            set context^.children.inner[at].beside = stack.reach > y;
            if context^.children.inner[at].has_baseline {
              let child_base = y +sat context^.children.inner[at].baseline;
              set baseline = content_top +sat child_base;
              set has_baseline = True();
              set context^.baseline_entry = flow_index(at: k);
              mark_lines(frames: &frames);
            }
            let margin_bottom = context^.children.inner[at].margin_bottom;
            add_margin(stack: &stack, margin: margin_bottom);
          }
          set stack.cursor = y +sat child_height;
        }
      }
      Float(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let style = context^.children.inner[at].style;
          let group = box_of(styles: styles, style: style);
          let side_left = group.float == float_left;
          if group.clear != clear_none {
            let clear_floor = float_bottom(stack: &stack, side: group.clear);
            set stack.float_floor = imax(stack.float_floor, clear_floor);
          }
          place_float(context: context, stack: &stack, child: at, side_left: side_left, containing_left: left, containing_width: width, content_left: content_left, content_top: content_top);
          let (dx, dy) = offset_of(frames: &frames);
          if at < context^.children.inner.len {
            set context^.children.inner[at].x = context^.children.inner[at].x +sat dx;
            set context^.children.inner[at].y = context^.children.inner[at].y +sat dy;
          }
        }
      }
      Out(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let y_term = pending_margin(stack: &stack);
          let y = stack.cursor +sat y_term;
          let margin_left = context^.children.inner[at].margin_left;
          let margin_top = context^.children.inner[at].margin_top;
          let x_static = left +sat margin_left;
          let y_static = y +sat margin_top;
          set context^.children.inner[at].x = content_left +sat x_static;
          set context^.children.inner[at].y = content_top +sat y_static;
        }
      }
    }
  }
  let end_term = pending_margin(stack: &stack);
  let end = stack.cursor +sat end_term;
  let float_end = float_bottom(stack: &stack, side: clear_both);
  let height = imax(end, float_end);
  set context^.content_raw = height;
  let positive = imax(height, 0_i32);
  return positive, baseline, has_baseline;
}

fn positioned_block(context: &Context, styles: &Styles, open_blocks: &[u32]) -> (found: Bool, left: i32, top: i32, width: i32, height: i32) reads(context), reads(styles), reads(open_blocks) {
  doc "The padding box, relative to the context's border box, of the innermost of the open blocks whose position is not static, the containing block of an absolutely positioned box inside it (CSS 2.2 10.1), or none.";
  let depth = open_blocks^.len;
  for (step in 0_u64..depth) {
    let k_top = depth - 1_u64;
    let k = k_top - step;
    let b = cvt::<u32, u64>(open_blocks^[k]);
    if b < context^.blocks.inner.len {
      let block = context^.blocks.inner[b];
      let group = box_of(styles: styles, style: block.style);
      if group.position != position_static {
        let border = border_edges(styles: styles, style: block.style);
        let left = block.x +sat border.left;
        let top = block.y +sat border.top;
        let across = horizontal(edges: border);
        let down = vertical(edges: border);
        let width = block.width -sat across;
        let height = block.height -sat down;
        let yes = True();
        return yes, left, top, width, height;
      }
    }
  }
  let no = False();
  return no, 0_i32, 0_i32, 0_i32, 0_i32;
}

fn laid_out_by_position(styles: &Styles, style: StyleRef) -> again: Bool reads(styles) {
  doc "Tells whether position_out_with lays an absolutely or fixed positioned box of style out again in the space its insets leave: when both insets of an axis are set and its size on that axis is auto, or when its width or height is a percentage.";
  let sizes = size_of(styles: styles, style: style);
  let left_set = sizes.left.kind == sizing_value;
  let right_set = sizes.right.kind == sizing_value;
  let top_set = sizes.top.kind == sizing_value;
  let bottom_set = sizes.bottom.kind == sizing_value;
  let width_auto = sizes.width.kind != sizing_value;
  let height_auto = sizes.height.kind != sizing_value;
  let stretch_width_pair = band(left_set, right_set);
  let stretch_width = band(stretch_width_pair, width_auto);
  let stretch_height_pair = band(top_set, bottom_set);
  let stretch_height = band(stretch_height_pair, height_auto);
  let width_is_value = sizes.width.kind == sizing_value;
  let height_is_value = sizes.height.kind == sizing_value;
  let width_percent = band(width_is_value, sizes.width.value.has_percent);
  let height_percent = band(height_is_value, sizes.height.value.has_percent);
  let percent_axis = bor(width_percent, height_percent);
  let stretch_axis = bor(stretch_width, stretch_height);
  let made = bor(stretch_axis, percent_axis);
  return made;
}

fn position_out(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Positions the context's absolutely and fixed positioned children against its border box and the borders of its style.";
  let border = border_edges(styles: styles, style: context^.style);
  position_out_with(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, border: border);
  return unit;
}

fn position_out_with(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, border: Edges) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Positions the context's absolutely and fixed positioned children (CSS 2.2 10.3.7 and 10.6.4): against the padding box of the innermost positioned block of the context around it, else the context's padding box inside the borders border, or the viewport for a fixed box, by left or right and top or bottom, keeping the static position on an axis where both are auto; a box whose opposite insets are both set and whose size is auto is laid out again at the size they leave, and one with a percentage width or height against the padding box. While the context is being updated, its children's layouts follow lay_out_child's rules for that.";
  let open_blocks = box_slots_new::<u32>(capacity: 8_u64);
  let flow_count = context^.flow.inner.len;
  for (k in 0_u64..flow_count) {
    if k >= context^.flow.inner.len {
      break;
    }
    let item = context^.flow.inner[k];
    match item {
      Out(context: c) => {
        let at = cvt::<u32, u64>(c);
        let depth = open_blocks.inner.len;
        let (anchor_found, anchor_left, anchor_top, anchor_width, anchor_height) = positioned_block(context: context, styles: styles, open_blocks: &open_blocks.inner[0_u64..depth]);
        position_child(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, border: border, at: at, anchor_found: anchor_found, anchor_left: anchor_left, anchor_top: anchor_top, anchor_width: anchor_width, anchor_height: anchor_height);
      }
      Open(block: b) => {
        let pushed = push_item::<u32>(cell: &open_blocks, value: b, ceiling: item_ceiling);
      }
      Close(..) => {
        let depth = open_blocks.inner.len;
        if depth > 0_u64 {
          let removed = take_back(window: &open_blocks.inner);
        }
      }
      Text(..) => {
      }
      Child(..) => {
      }
      Float(..) => {
      }
    }
  }
  return unit;
}

struct FlowFrame {
  doc "The geometry a flow context's passes take from its border-box width and its space: the content box's left and top in the border box, the width its flow is laid out in (a column's for a multi-column context, else the content box's), the definite content height children resolve percentages against (unknown when indefinite), and the column shape of a multi-column context.";
  content_left: i32;
  content_top: i32;
  flow_width: i32;
  definite: i32;
  columned: Bool;
  column_count: i32;
  column_width: i32;
  column_gap: i32;
}

fn flow_frame(styles: &Styles, style: StyleRef, space: Space, width: i32) -> frame: FlowFrame reads(styles) {
  doc "The geometry of a flow context styled style, width wide in space: a pure function of them, so that an update can compare it with the geometry of the context's previous layout.";
  let basis = space.basis_width;
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: basis);
  let content_left = border.left +sat padding.left;
  let content_top = border.top +sat padding.top;
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let inner = width -sat frame;
  let content_width = imax(inner, 0_i32);
  let frame_vertical_border = vertical(edges: border);
  let frame_vertical_padding = vertical(edges: padding);
  let frame_vertical = frame_vertical_border +sat frame_vertical_padding;
  let forced = space.forced_height;
  let specified = specified_height(styles: styles, style: style, basis: space.basis_height, frame: frame_vertical);
  let definite = if forced >= 0_i32 {
    give forced -sat frame_vertical;
  } else if specified >= 0_i32 {
    give specified -sat frame_vertical;
  } else {
    give unknown;
  }
  let columned = multicol(styles: styles, style: style);
  let (column_count, column_width, column_gap) = column_shape(styles: styles, style: style, available: content_width);
  let flow_width = if columned {
    give column_width;
  } else {
    give content_width;
  }
  return FlowFrame(content_left: content_left, content_top: content_top, flow_width: flow_width, definite: definite, columned: columned, column_count: column_count, column_width: column_width, column_gap: column_gap);
}

fn clear_column_map(context: &Context) -> result: unit writes(context) {
  doc "Empties the column map of the context's previous layout.";
  let cleared_map = context^.column_map.inner.len;
  for (step in 0_u64..cleared_map) {
    let length = context^.column_map.inner.len;
    if length == 0_u64 {
      break;
    }
    let dropped = take_back(window: &context^.column_map.inner);
  }
  return unit;
}

fn finish_flow(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, frame: FlowFrame) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "The passes of a flow context after its children are laid out and its paragraphs broken: the stacking pass, its columns, its height and baseline, its positioned children, then its own fragments, those of the inline boxes blocks interrupt and of the paragraphs without lines; its blocks' and paragraphs' fragments stay with them, and place_boxes reads them there.";
  let style = context^.style;
  let (laid_height, baseline, has_baseline) = stack_flow(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, content_left: frame.content_left, content_top: frame.content_top, content_width: frame.flow_width, basis_height: frame.definite);
  let height = if frame.columned {
    give fragment_columns(context: context, styles: styles, count: frame.column_count, width: frame.column_width, gap: frame.column_gap, content_top: frame.content_top, laid_height: laid_height);
  } else {
    give laid_height;
  }
  let used = used_height(context: context, styles: styles, content: height);
  set context^.height = used;
  let group = box_of(styles: styles, style: style);
  let shown_x = group.overflow_x == overflow_visible;
  let clipped_x = group.overflow_x == overflow_clip;
  let shown_y = group.overflow_y == overflow_visible;
  let clipped_y = group.overflow_y == overflow_clip;
  let visible_x = bor(shown_x, clipped_x);
  let visible_y = bor(shown_y, clipped_y);
  let visible = band(visible_x, visible_y);
  set context^.baseline = baseline;
  set context^.has_baseline = band(has_baseline, visible);
  position_out(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  add_own_fragment(context: context);
  split_fragments(context: context, styles: styles, content_left: frame.content_left);
  return unit;
}

fn position_child(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, border: Edges, at: u64, anchor_found: Bool, anchor_left: i32, anchor_top: i32, anchor_width: i32, anchor_height: i32) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Positions the absolutely or fixed positioned child at of the context, as position_out_with describes, its containing block the padding box the anchor gives when anchor_found (the innermost positioned block around it), else the context's padding box inside border, or the viewport for a fixed box.";
  if at < context^.children.inner.len {
  } else {
    return unit;
  }
  let box_width_term = horizontal(edges: border);
  let box_width = context^.width -sat box_width_term;
  let box_height_term = vertical(edges: border);
  let box_height = context^.height -sat box_height_term;
  let viewport_width = units(px: viewport.width);
  let viewport_height = units(px: viewport.height);
  let style = context^.children.inner[at].style;
  let group = box_of(styles: styles, style: style);
  let fixed = group.position == position_fixed;
  let not_fixed = bnot(fixed);
  let in_block = band(anchor_found, not_fixed);
  let own_left = if in_block {
    give anchor_left;
  } else {
    give border.left;
  }
  let own_top = if in_block {
    give anchor_top;
  } else {
    give border.top;
  }
  let own_width = if in_block {
    give anchor_width;
  } else {
    give box_width;
  }
  let own_height = if in_block {
    give anchor_height;
  } else {
    give box_height;
  }
  let cb_left = if fixed {
    give 0_i32;
  } else {
    give own_left;
  }
  let cb_top = if fixed {
    give 0_i32;
  } else {
    give own_top;
  }
  let cb_width = if fixed {
    give viewport_width;
  } else {
    give own_width;
  }
  let cb_height = if fixed {
    give viewport_height;
  } else {
    give own_height;
  }
  let sizes = size_of(styles: styles, style: style);
  let left = inset_value(value: sizes.left, basis: cb_width);
  let right = inset_value(value: sizes.right, basis: cb_width);
  let top = inset_value(value: sizes.top, basis: cb_height);
  let bottom = inset_value(value: sizes.bottom, basis: cb_height);
  let left_set = sizes.left.kind == sizing_value;
  let right_set = sizes.right.kind == sizing_value;
  let top_set = sizes.top.kind == sizing_value;
  let bottom_set = sizes.bottom.kind == sizing_value;
  let width_auto = sizes.width.kind != sizing_value;
  let height_auto = sizes.height.kind != sizing_value;
  let stretch_width_pair = band(left_set, right_set);
  let stretch_width = band(stretch_width_pair, width_auto);
  let stretch_height_pair = band(top_set, bottom_set);
  let stretch_height = band(stretch_height_pair, height_auto);
  let again = laid_out_by_position(styles: styles, style: style);
  if again {
    let margin_lr = context^.children.inner[at].margin_left +sat context^.children.inner[at].margin_right;
    let margin_tb = context^.children.inner[at].margin_top +sat context^.children.inner[at].margin_bottom;
    let inset_lr = left +sat right;
    let inset_tb = top +sat bottom;
    let width_left = cb_width -sat inset_lr;
    let height_left = cb_height -sat inset_tb;
    let forced_width = if stretch_width {
      let width_room = width_left -sat margin_lr;
      give imax(width_room, 0_i32);
    } else {
      give unknown;
    }
    let forced_height = if stretch_height {
      let height_room = height_left -sat margin_tb;
      give imax(height_room, 0_i32);
    } else {
      give unknown;
    }
    let no = False();
    let forced_space = Space(available: cb_width, basis_width: cb_width, basis_height: cb_height, forced_width: forced_width, forced_height: forced_height, shrink: no);
    let updating = context^.dirty;
    let laid = context^.children.inner[at].laid;
    let same = equivalent_space(styles: styles, style: style, first: laid, second: forced_space);
    let unmarked = bnot(context^.children.inner[at].dirty);
    let unchanged = band(same, unmarked);
    let keeps = band(updating, unchanged);
    set context^.children.inner[at].space = forced_space;
    if keeps {
    } else {
      set context^.children.inner[at].intrinsic_known = False();
    }
    lay_out_child(child: &context^.children.inner[at], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: updating);
  }
  let width = context^.children.inner[at].width;
  let height = context^.children.inner[at].height;
  let margin_left = context^.children.inner[at].margin_left;
  let margin_right = context^.children.inner[at].margin_right;
  let margin_top = context^.children.inner[at].margin_top;
  let margin_bottom = context^.children.inner[at].margin_bottom;
  if left_set {
    let from = cb_left +sat left;
    set context^.children.inner[at].x = from +sat margin_left;
  } else if right_set {
    let edge = cb_left +sat cb_width;
    let inner = edge -sat right;
    let outer = inner -sat margin_right;
    set context^.children.inner[at].x = outer -sat width;
  }
  if top_set {
    let from = cb_top +sat top;
    set context^.children.inner[at].y = from +sat margin_top;
  } else if bottom_set {
    let edge = cb_top +sat cb_height;
    let inner = edge -sat bottom;
    let outer = inner -sat margin_bottom;
    set context^.children.inner[at].y = outer -sat height;
  }
  let placed = bor(left_set, right_set);
  let placed_vertically = bor(top_set, bottom_set);
  let anchored = band(placed, placed_vertically);
  set context^.children.inner[at].viewport_origin = band(fixed, anchored);
  return unit;
}

fn chain_anchor(context: &Context, styles: &Styles, block: u32) -> (found: Bool, left: i32, top: i32, width: i32, height: i32) reads(context), reads(styles) {
  doc "positioned_block's answer for a box sitting in block, read from the blocks' parents the pre-pass records rather than from a walk of the flow.";
  let count = context^.blocks.inner.len;
  let at = block;
  for (step in 0_u64..count) {
    if at == no_index {
      break;
    }
    let b = cvt::<u32, u64>(at);
    if b < context^.blocks.inner.len {
    } else {
      break;
    }
    let found_block = context^.blocks.inner[b];
    let group = box_of(styles: styles, style: found_block.style);
    if group.position != position_static {
      let edges = border_edges(styles: styles, style: found_block.style);
      let left = found_block.x +sat edges.left;
      let top = found_block.y +sat edges.top;
      let across = horizontal(edges: edges);
      let down = vertical(edges: edges);
      let width = found_block.width -sat across;
      let height = found_block.height -sat down;
      let yes = True();
      return yes, left, top, width, height;
    }
    set at = found_block.parent;
  }
  let no = False();
  return no, 0_i32, 0_i32, 0_i32, 0_i32;
}

fn position_out_children(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "position_out for a flow context whose pre-pass recorded each child's flow entry and block: positions each out-of-flow child found among the children, its anchor from chain_anchor, with no walk of the flow.";
  let border = border_edges(styles: styles, style: context^.style);
  let count = context^.children.inner.len;
  for (at in 0_u64..count) {
    if at < context^.children.inner.len {
      let block = context^.children.inner[at].block;
      let (kind, index) = entry_kind(context: context, flow_at: context^.children.inner[at].flow_at);
      let out_kind = kind == 3_u8;
      let this_child = index == at;
      let out = band(out_kind, this_child);
      if out {
        let (found, left, top, width, height) = chain_anchor(context: context, styles: styles, block: block);
        position_child(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, border: border, at: at, anchor_found: found, anchor_left: left, anchor_top: top, anchor_width: width, anchor_height: height);
      }
    }
  }
  return unit;
}

fn lay_out_flow(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out a flow context: its width, a pre-pass giving every box its containing width, its child contexts in parallel, its paragraphs broken in parallel at their full widths, then finish_flow: the stacking pass, its height and positioned children, then its fragments.";
  let width = used_width(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set context^.width = width;
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: width);
  clear_column_map(context: context);
  prepare_spaces(context: context, styles: styles, content_width: frame.flow_width, content_height: frame.definite);
  lay_out_children(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  break_all(context: context, styles: styles, fonts: fonts, picks: picks);
  finish_flow(context: context, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, frame: frame);
  return unit;
}

fn paragraph_intrinsic(paragraph: &Paragraph, children: &[Context], styles: &Styles, minimum: Bool) -> width: i32 reads(paragraph), reads(children), reads(styles) {
  doc "A paragraph's min-content width (its widest unbreakable run between allowed or mandatory break opportunities) or max-content width (its widest run between mandatory breaks), with the first line's indent, its inline boxes' margins, borders and paddings, and its atomic inlines at the margin-box widths their own intrinsic sizes give, except that the icon before an img's alt text floats in the reference, so it adds nothing to the min-content width of its line and only sets a least for it (research/investigations/layout/runs/alt-icon-min-content.txt).";
  let count = paragraph^.text.inner.len;
  let sizes = measure(paragraph: paragraph, children: children, styles: styles, basis: 0_i32);
  let marks = paragraph^.marks.inner.len;
  let icon_floor = 0_i32;
  for (m in 0_u64..marks) {
    let mark = paragraph^.marks.inner[m];
    match mark {
      Atomic(at: here, context: child) => {
        let at = cvt::<u32, u64>(here);
        let child_at = cvt::<u32, u64>(child);
        let inside = at < count;
        let known = child_at < children^.len;
        let usable = band(inside, known);
        if usable {
          let base = if minimum {
            give children^[child_at].min_content;
          } else {
            give children^[child_at].max_content;
          }
          let with_left = base +sat children^[child_at].margin_left;
          let outer = with_left +sat children^[child_at].margin_right;
          let icon = children^[child_at].natural == natural_alt_icon;
          let floated_icon = band(minimum, icon);
          if floated_icon {
            set icon_floor = imax(icon_floor, outer);
          }
          if at < sizes.advances.inner.len {
            if floated_icon {
              set sizes.advances.inner[at] = 0.0_f32;
            } else {
              set sizes.advances.inner[at] = pixels(raw: outer);
            }
          }
        }
      }
      Open(..) => {
      }
      Close(..) => {
      }
      Node(..) => {
      }
    }
  }
  let text = text_of(styles: styles, style: paragraph^.style);
  let indent = resolve_lp(value: text.text_indent, basis: 0_i32);
  let best = 0.0_f32;
  let current = pixels(raw: indent);
  let trailing = 0.0_f32;
  for (j in 0_u64..count) {
    let kind = break_at(paragraph: paragraph, sizes: &sizes, at: j);
    let mandatory = kind == break_mandatory;
    let allowed = kind == break_allowed;
    let ends = if minimum {
      give bor(mandatory, allowed);
    } else {
      give mandatory;
    }
    let started = j > 0_u64;
    let cut = band(ends, started);
    if cut {
      let visible = fsub.strict(current, trailing);
      set best = fmax(best, visible);
      set current = 0.0_f32;
      set trailing = 0.0_f32;
    }
    let opening = open_at(sizes: &sizes, at: j);
    let advance = advance_at(sizes: &sizes, at: j);
    let next = j +sat 1_u64;
    let closing = close_at(sizes: &sizes, at: next);
    let with_open = fadd.strict(current, opening);
    let with_advance = fadd.strict(with_open, advance);
    set current = fadd.strict(with_advance, closing);
    let hangs = collapsible_at(sizes: &sizes, at: j);
    if hangs {
      let grown = fadd.strict(trailing, advance);
      set trailing = fadd.strict(grown, closing);
    } else {
      set trailing = 0.0_f32;
    }
  }
  let visible = fsub.strict(current, trailing);
  set best = fmax(best, visible);
  let icon_px = pixels(raw: icon_floor);
  set best = fmax(best, icon_px);
  let made = units_up(px: best);
  return made;
}

fn chunk_most(most: i32, text: i32, floats: i32, around: i32) -> made: i32 pure {
  doc "most raised by the max-content width of a run of floats and lines between two block boundaries: the reference adds the widths of the floats to the widest line they sit beside (research/investigations/layout/runs/float-intrinsic.txt).";
  let together = text +sat floats;
  let total = together +sat around;
  let made = imax(most, total);
  return made;
}

fn intrinsic_flow(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> (minimum: i32, maximum: i32) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "The content's min-content and max-content widths of a flow context: the largest over its paragraphs and its in-flow and floated child contexts' contributions (their intrinsic sizes plus margins), each inside the margins, borders and paddings of the block boxes around it, a block box with a given width contributing that width instead of its content.";
  let children = context^.children.inner.len;
  for (c in 0_u64..children) {
    let (least, most) = intrinsic_sizes(context: &context^.children.inner[c], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
    let style = context^.children.inner[c].style;
    let margins = margin_edges(styles: styles, style: style, basis: 0_i32);
    set context^.children.inner[c].margin_left = margins.left;
    set context^.children.inner[c].margin_right = margins.right;
  }
  let least = 0_i32;
  let most = 0_i32;
  let frames = box_slots_new::<i32>(capacity: 8_u64);
  let fixed = box_slots_new::<i32>(capacity: 8_u64);
  let around = 0_i32;
  let fixed_depth = 0_u64;
  let chunk_text = 0_i32;
  let chunk_floats = 0_i32;
  let flow_count = context^.flow.inner.len;
  for (k in 0_u64..flow_count) {
    if k >= context^.flow.inner.len {
      break;
    }
    let item = context^.flow.inner[k];
    match item {
      Open(block: b) => {
        set most = chunk_most(most: most, text: chunk_text, floats: chunk_floats, around: around);
        set chunk_text = 0_i32;
        set chunk_floats = 0_i32;
        let at = cvt::<u32, u64>(b);
        if at < context^.blocks.inner.len {
          let style = context^.blocks.inner[at].style;
          let border = border_edges(styles: styles, style: style);
          let padding = padding_edges(styles: styles, style: style, basis: 0_i32);
          let margins = margin_edges(styles: styles, style: style, basis: 0_i32);
          let frame_border = horizontal(edges: border);
          let frame_padding = horizontal(edges: padding);
          let frame_margin = horizontal(edges: margins);
          let inner_frame = frame_border +sat frame_padding;
          let outer_frame = inner_frame +sat frame_margin;
          let pushed = push_item::<i32>(cell: &frames, value: around, ceiling: item_ceiling);
          let specified = specified_width(styles: styles, style: style, basis: unknown, frame: inner_frame);
          let pushed_fixed = push_item::<i32>(cell: &fixed, value: specified, ceiling: item_ceiling);
          if specified >= 0_i32 {
            let whole = specified +sat frame_margin;
            let contribution = whole +sat around;
            set least = imax(least, contribution);
            set most = imax(most, contribution);
            set fixed_depth = fixed_depth +sat 1_u64;
          }
          set around = around +sat outer_frame;
        }
      }
      Close(..) => {
        set most = chunk_most(most: most, text: chunk_text, floats: chunk_floats, around: around);
        set chunk_text = 0_i32;
        set chunk_floats = 0_i32;
        let depth = frames.inner.len;
        if depth > 0_u64 {
          let last = depth - 1_u64;
          set around = frames.inner[last];
          let was_fixed = if last < fixed.inner.len {
            give fixed.inner[last] >= 0_i32;
          } else {
            give False();
          }
          if was_fixed {
            set fixed_depth = fixed_depth -sat 1_u64;
          }
          let removed = take_back(window: &frames.inner);
          if fixed.inner.len > 0_u64 {
            let removed_fixed = take_back(window: &fixed.inner);
          }
        }
      }
      Text(paragraph: p) => {
        let at = cvt::<u32, u64>(p);
        let open = fixed_depth == 0_u64;
        let present = at < context^.paragraphs.inner.len;
        let usable = band(open, present);
        if usable {
          let yes = True();
          let no = False();
          let low = paragraph_intrinsic(paragraph: &context^.paragraphs.inner[at], children: &context^.children.inner[0_u64..children], styles: styles, minimum: yes);
          let high = paragraph_intrinsic(paragraph: &context^.paragraphs.inner[at], children: &context^.children.inner[0_u64..children], styles: styles, minimum: no);
          let low_total = low +sat around;
          let high_total = high +sat around;
          set least = imax(least, low_total);
          set chunk_text = imax(chunk_text, high);
        }
      }
      Child(context: c) => {
        set most = chunk_most(most: most, text: chunk_text, floats: chunk_floats, around: around);
        set chunk_text = 0_i32;
        set chunk_floats = 0_i32;
        let at = cvt::<u32, u64>(c);
        let open = fixed_depth == 0_u64;
        let present = at < children;
        let usable = band(open, present);
        if usable {
          let child = &context^.children.inner[at];
          let margins = child^.margin_left +sat child^.margin_right;
          let low = child^.min_content +sat margins;
          let high = child^.max_content +sat margins;
          let low_total = low +sat around;
          let high_total = high +sat around;
          set least = imax(least, low_total);
          set most = imax(most, high_total);
        }
      }
      Float(context: c) => {
        let at = cvt::<u32, u64>(c);
        let open = fixed_depth == 0_u64;
        let present = at < children;
        let usable = band(open, present);
        if usable {
          let child = &context^.children.inner[at];
          let margins = child^.margin_left +sat child^.margin_right;
          let low = child^.min_content +sat margins;
          let high = child^.max_content +sat margins;
          let low_total = low +sat around;
          set least = imax(least, low_total);
          set chunk_floats = chunk_floats +sat high;
        }
      }
      Out(..) => {
      }
    }
  }
  set most = chunk_most(most: most, text: chunk_text, floats: chunk_floats, around: around);
  return least, most;
}

fn natural_size(natural: u8) -> (width: i32, height: i32) pure {
  doc "The natural size of a replaced box the stage does not load: 16 by 16 px for the broken-image icon, nothing for an empty img, and otherwise 300 by 150 px, as CSS 2.2 10.3.2 falls back to.";
  let icon = natural == natural_icon;
  let alt_icon = natural == natural_alt_icon;
  let either = bor(icon, alt_icon);
  if either {
    return 1024_i32, 1024_i32;
  }
  if natural == natural_empty {
    return 0_i32, 0_i32;
  }
  if natural == natural_toggle {
    return 832_i32, 832_i32;
  }
  return 19200_i32, 9600_i32;
}

fn replaced_size(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> (width: i32, height: i32) reads(context), reads(styles), reads(fonts), reads(picks) {
  doc "The natural content size of a replaced box: natural_size's, or for a text input, as the reference sizes one of the default twenty characters, about 13.27 times its font size wide and its line tall.";
  if context^.natural == natural_text_input {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: context^.style);
    let size = cvt::<i32, i64>(metrics.font_size);
    let scaled = size *sat 1327_i64;
    let wide = scaled / 100_i64;
    let bounded_low = imax(wide, 0_i64);
    let bounded = imin(bounded_low, 2147483647_i64);
    let width = cvt::<i64, i32>(bounded);
    let height = metrics.ascent +sat metrics.descent;
    return width, height;
  }
  let (width, height) = natural_size(natural: context^.natural);
  return width, height;
}

fn marker_width(metrics: Metrics) -> width: i32 pure {
  doc "The advance of an inside bullet marker of a font with metrics, as the reference sizes it: a symbol (a third of the rounded ascent, plus one, halved, plus 2 px), a -1 px start margin and an end margin of the font size.";
  let ascent_px = metrics.content_ascent / 64_i32;
  let doubled = ascent_px *sat 2_i32;
  let two_thirds = doubled / 3_i32;
  let raised = two_thirds +sat 1_i32;
  let half = raised / 2_i32;
  let bullet_px = half +sat 2_i32;
  let bullet = bullet_px *sat 64_i32;
  let outer = bullet +sat metrics.font_size;
  let made = outer -sat 64_i32;
  return made;
}

fn intrinsic_replaced(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> (minimum: i32, maximum: i32) reads(context), reads(styles), reads(fonts), reads(picks) {
  doc "A replaced box's content width is its natural width; an inside bullet marker's is its advance.";
  if context^.natural == natural_marker {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: context^.style);
    let wide = marker_width(metrics: metrics);
    return wide, wide;
  }
  let (width, height) = replaced_size(context: context, styles: styles, fonts: fonts, picks: picks);
  return width, width;
}

fn lay_out_replaced(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(styles), reads(fonts), reads(picks), writes(context) {
  doc "Lays out a replaced box at its given size, or its natural size, keeping the natural ratio when only one dimension is given; the ratio of an img, video or svg element is that of its width and height attributes when it has both, and a replaced box without one takes the natural size on an axis that is auto (research/investigations/layout/runs/replaced-ratio.txt). The icon before an img's alt text sits on the text's bottom, as the reference draws it: its baseline lies the font's descent above its bottom. An inside bullet marker takes its advance and its font's content area. A block-level img showing the broken-image icon or nothing fills its line, as the reference draws it. A text input's baseline is its line's, centred in its content box.";
  let (natural_width_base, natural_height_base) = replaced_size(context: context, styles: styles, fonts: fonts, picks: picks);
  let field = context^.natural == natural_text_input;
  let has_ratio = context^.ratio_width > 0_i32;
  let natural_width = if has_ratio {
    give context^.ratio_width;
  } else {
    give natural_width_base;
  }
  let natural_height = if has_ratio {
    give context^.ratio_height;
  } else {
    give natural_height_base;
  }
  if context^.natural == natural_marker {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: context^.style);
    let wide = marker_width(metrics: metrics);
    let tall = metrics.content_ascent +sat metrics.content_descent;
    set context^.width = wide;
    set context^.height = tall;
    set context^.baseline = metrics.content_ascent;
    set context^.has_baseline = True();
    return unit;
  }
  if context^.natural == natural_alt_icon {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: context^.style);
    set context^.width = natural_width;
    set context^.height = natural_height;
    set context^.baseline = natural_height -sat metrics.content_descent;
    set context^.has_baseline = True();
    return unit;
  }
  let ignored = sizes_ignored(context: context, styles: styles);
  let icon = context^.natural == natural_icon;
  let empty = context^.natural == natural_empty;
  let unloaded = bor(icon, empty);
  let block_level = bnot(context^.space.shrink);
  let fills = band(unloaded, block_level);
  let style = context^.style;
  let basis = context^.space.basis_width;
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: basis);
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let frame_vertical_border = vertical(edges: border);
  let frame_vertical_padding = vertical(edges: padding);
  let frame_vertical = frame_vertical_border +sat frame_vertical_padding;
  let specified = applied_width(styles: styles, style: style, basis: basis, frame: frame, ignored: ignored);
  let specified_tall = applied_height(styles: styles, style: style, basis: context^.space.basis_height, frame: frame_vertical, ignored: ignored);
  let width = if context^.space.forced_width >= 0_i32 {
    give context^.space.forced_width;
  } else if specified >= 0_i32 {
    give specified;
  } else if specified_tall >= 0_i32 {
    let content_height = specified_tall -sat frame_vertical;
    let scaled = if natural_height > 0_i32 {
      let wide = cvt::<i32, i64>(content_height);
      let ratio_top = cvt::<i32, i64>(natural_width);
      let ratio_bottom = cvt::<i32, i64>(natural_height);
      let product = wide *sat ratio_top;
      let quotient = product / ratio_bottom;
      let bounded_floor = imax(quotient, 0_i64);
      let bounded = imin(bounded_floor, 2147483647_i64);
      give cvt::<i64, i32>(bounded);
    } else {
      give 0_i32;
    }
    let content_wide = if has_ratio {
      give scaled;
    } else {
      give natural_width;
    }
    give content_wide +sat frame;
  } else if fills {
    let margins = margin_edges(styles: styles, style: style, basis: basis);
    let around = horizontal(edges: margins);
    let room = context^.space.available -sat around;
    give imax(room, frame);
  } else {
    give natural_width +sat frame;
  }
  set context^.width = width;
  let content_width = width -sat frame;
  let has_width = specified >= 0_i32;
  let sized_by_ratio = band(has_ratio, has_width);
  let natural_tall = if sized_by_ratio {
    if natural_width > 0_i32 {
      let wide = cvt::<i32, i64>(content_width);
      let ratio_top = cvt::<i32, i64>(natural_height);
      let ratio_bottom = cvt::<i32, i64>(natural_width);
      let product = wide *sat ratio_top;
      let quotient = product / ratio_bottom;
      let bounded_floor = imax(quotient, 0_i64);
      let bounded = imin(bounded_floor, 2147483647_i64);
      give cvt::<i64, i32>(bounded);
    } else {
      give 0_i32;
    }
  } else {
    give natural_height;
  }
  let height = used_height(context: context, styles: styles, content: natural_tall);
  set context^.height = height;
  set context^.has_baseline = False();
  if field {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: style);
    let above_content = border.top +sat padding.top;
    let content_box = height -sat frame_vertical;
    let spare = content_box -sat natural_height;
    let centred = spare / 2_i32;
    let line_top = above_content +sat centred;
    set context^.baseline = line_top +sat metrics.ascent;
    set context^.has_baseline = True();
  }
  add_own_fragment(context: context);
  return unit;
}

fn lay_out(layout: &Layout, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(document), reads(styles), reads(fonts), reads(picks), writes(layout) {
  doc "Lays out the initial containing block at the viewport's size, its origin at the viewport's, so that a percentage height of the root element resolves against the viewport's height (research/investigations/layout/runs/root-percent-height.txt).";
  let viewport = layout^.viewport;
  let width = units(px: viewport.width);
  let height = units(px: viewport.height);
  let no = False();
  set layout^.root.space = Space(available: width, basis_width: width, basis_height: height, forced_width: width, forced_height: height, shrink: no);
  lay_out_context(context: &layout^.root, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set layout^.root.x = 0_i32;
  set layout^.root.y = 0_i32;
  return unit;
}

fn place_rect(fragment: Fragment, x: i32, y: i32, map: &[ColumnPiece], map_y: i32, out: &Box<Slots<PlacedRect>>) -> result: unit reads(map), writes(out) {
  doc "Appends fragment at the absolute origin x, y, moved by the column map whose context's border box lies at map_y: the parts of a rectangle that fall in several columns become one rectangle per column, as the reference reports a box split across columns.";
  let left = x +sat fragment.x;
  let top = y +sat fragment.y;
  let bottom = top +sat fragment.height;
  let pieces = map^.len;
  let px_width = pixels(raw: fragment.width);
  if pieces == 0_u64 {
    let px_x = pixels(raw: left);
    let px_y = pixels(raw: top);
    let px_height = pixels(raw: fragment.height);
    let made = PlacedRect(kind: fragment.kind, owner: fragment.owner, x: px_x, y: px_y, width: px_width, height: px_height);
    let pushed = push_item::<PlacedRect>(cell: out, value: made, ceiling: item_ceiling);
    return unit;
  }
  let local_top = top -sat map_y;
  let local_bottom = bottom -sat map_y;
  let flat = fragment.height == 0_i32;
  for (k in 0_u64..pieces) {
    let piece = map^[k];
    let starts_before_end = local_top < piece.to;
    let ends_after_start = local_bottom > piece.from;
    let overlaps = band(starts_before_end, ends_after_start);
    let at_or_after = local_top >= piece.from;
    let inside_point = band(at_or_after, starts_before_end);
    let point = band(flat, inside_point);
    let takes = bor(overlaps, point);
    if takes {
      let clipped_top = imax(local_top, piece.from);
      let moved_top = clipped_top +sat piece.dy;
      let continues = local_bottom > piece.to;
      let moved_bottom = if continues {
        give piece.bottom;
      } else {
        give local_bottom +sat piece.dy;
      }
      let part = moved_bottom -sat moved_top;
      let part_height = imax(part, 0_i32);
      let absolute_top = moved_top +sat map_y;
      let moved_left = left +sat piece.dx;
      let px_x = pixels(raw: moved_left);
      let px_y = pixels(raw: absolute_top);
      let px_height = pixels(raw: part_height);
      let made = PlacedRect(kind: fragment.kind, owner: fragment.owner, x: px_x, y: px_y, width: px_width, height: px_height);
      let pushed = push_item::<PlacedRect>(cell: out, value: made, ceiling: item_ceiling);
      if flat {
        return unit;
      }
    }
  }
  return unit;
}

fn place_context(context: &Context, x: i32, y: i32, map: &[ColumnPiece], map_y: i32, out: &Box<Slots<PlacedRect>>) -> result: unit reads(context), reads(map), writes(out) {
  doc "Appends context's fragments at its absolute origin x, y, then its children's, each at its own origin, moving them by the innermost multi-column context's column map: a multi-column context's own box by its parent's map, its content by its own. Its own box's fragment comes first, then each shown block box's border box and each paragraph's fragments at the paragraph's origin, then the rest of its fragments, the order lay_out_flow made them in when it copied the blocks' and paragraphs' into its list.";
  let own_pieces = context^.column_map.inner.len;
  let own_map = own_pieces > 0_u64;
  let style = context^.style;
  let count = context^.fragments.inner.len;
  let owned = owns_fragment(style: style);
  let own_count = if owned {
    give imin(count, 1_u64);
  } else {
    give 0_u64;
  }
  for (f in 0_u64..own_count) {
    if f < context^.fragments.inner.len {
      let fragment = context^.fragments.inner[f];
      place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
    }
  }
  let blocks = context^.blocks.inner.len;
  for (b in 0_u64..blocks) {
    let block = context^.blocks.inner[b];
    let shown = shown_owner(style: block.style);
    if shown {
      let fragment = Fragment(kind: placed_element, owner: block.style.element, x: block.x, y: block.y, width: block.width, height: block.height);
      place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
    }
  }
  let paragraphs = context^.paragraphs.inner.len;
  for (p in 0_u64..paragraphs) {
    let left = context^.paragraphs.inner[p].x;
    let top = context^.paragraphs.inner[p].top;
    let pieces = context^.paragraphs.inner[p].fragments.inner.len;
    for (f in 0_u64..pieces) {
      if p < context^.paragraphs.inner.len {
        if f < context^.paragraphs.inner[p].fragments.inner.len {
          let piece = context^.paragraphs.inner[p].fragments.inner[f];
          let moved_x = left +sat piece.x;
          let moved_y = top +sat piece.y;
          let fragment = Fragment(kind: piece.kind, owner: piece.owner, x: moved_x, y: moved_y, width: piece.width, height: piece.height);
          place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
        }
      }
    }
  }
  for (f in own_count..count) {
    if f < context^.fragments.inner.len {
      let fragment = context^.fragments.inner[f];
      place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
    }
  }
  let children = context^.children.inner.len;
  for (c in 0_u64..children) {
    let child = &context^.children.inner[c];
    let moved_x = x +sat child^.x;
    let moved_y = y +sat child^.y;
    let child_x = if child^.viewport_origin {
      give child^.x;
    } else {
      give moved_x;
    }
    let child_y = if child^.viewport_origin {
      give child^.y;
    } else {
      give moved_y;
    }
    if own_map {
      place_context(context: child, x: child_x, y: child_y, map: &context^.column_map.inner[0_u64..own_pieces], map_y: y, out: out);
    } else {
      place_context(context: child, x: child_x, y: child_y, map: map, map_y: map_y, out: out);
    }
  }
  return unit;
}

fn place_fragment(context: &Context, fragment: Fragment, x: i32, y: i32, map: &[ColumnPiece], map_y: i32, out: &Box<Slots<PlacedRect>>) -> result: unit reads(context), reads(map), writes(out) {
  doc "Appends one of context's fragments at its absolute origin x, y: the context's own box by the column map around it, anything else by the context's own column map when it has one.";
  let own_pieces = context^.column_map.inner.len;
  let own_map = own_pieces > 0_u64;
  let style = context^.style;
  let element_kind = fragment.kind == placed_element;
  let same_owner = fragment.owner == style.element;
  let named = bnot(style.anonymous);
  let owned_pair = band(element_kind, same_owner);
  let own_box = band(owned_pair, named);
  let no_map = bnot(own_map);
  let outer = bor(own_box, no_map);
  if outer {
    place_rect(fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
  } else {
    place_rect(fragment: fragment, x: x, y: y, map: &context^.column_map.inner[0_u64..own_pieces], map_y: y, out: out);
  }
  return unit;
}

fn place_boxes(layout: &Layout) -> placed: Box<Slots<PlacedRect>> reads(layout) {
  doc "The walk that turns every context's relative fragments into viewport coordinates.";
  let out = box_slots_new::<PlacedRect>(capacity: 1024_u64);
  let none = box_slots_new::<ColumnPiece>(capacity: 0_u64);
  place_context(context: &layout^.root, x: layout^.root.x, y: layout^.root.y, map: &none.inner[0_u64..0_u64], map_y: 0_i32, out: &out);
  return move out;
}
