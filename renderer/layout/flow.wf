fn positioned_block(context: &Context, styles: &Styles, open_blocks: &[u32]) -> (found: Bool, left: i32, top: i32, width: i32, height: i32) reads(context), reads(styles), reads(open_blocks) {
  doc "The padding box, relative to the context's border box, of the innermost of the open blocks whose position is not static, the containing block of an absolutely positioned box inside it (CSS 2.2 10.1), or none.";
  let depth = open_blocks^.len;
  for (step in 0_u64..depth) {
    let k_top = depth - 1_u64;
    let k = k_top - step;
    let b = cvt::<u32, u64>(open_blocks^[k]);
    if b < context^.blocks.inner.len {
      let block = block_snapshot(block: &context^.blocks.inner[b]);
      let group = box_of(styles: styles, style: block.style);
      if group.position != position_static {
        let border = border_edges(styles: styles, style: block.style);
        let positioned_origin = block_position(context: context, at: b);
        let left = positioned_origin.x +sat border.left;
        let top = positioned_origin.y +sat border.top;
        let across = horizontal(edges: border);
        let down = vertical(edges: border);
        let width = block.width -sat across;
        let height = block.height -sat down;
        let yes = True();
        return yes, left, top, width, height;
      }
    }
  }
  let no = False();
  return no, 0_i32, 0_i32, 0_i32, 0_i32;
}

fn deferred_out(child: &Context, styles: &Styles, updating: Bool) -> deferred: Bool reads(child), reads(styles) {
  doc "Tells whether a flex or grid container being updated defers the layout of an unmarked absolutely or fixed positioned child to position_out_with: one that position_out_with lays out again in the space its insets leave (laid_out_by_position), which keeps it when that space is the one it was last laid out in, and whose position takes no static position from the first layout's size (an inset set on each axis). The container's first layout of it would only be replaced; its margins are resolved in the first space instead, as that layout would leave them for position_out_with.";
  if updating {
  } else {
    return False();
  }
  if child^.dirty {
    return False();
  }
  let out = positioned(styles: styles, context: child);
  if out {
  } else {
    return False();
  }
  let again = laid_out_by_position(styles: styles, style: child^.style);
  if again {
  } else {
    return False();
  }
  let sizes = size_of(styles: styles, style: child^.style);
  let left_set = sizes.left.kind == sizing_value;
  let right_set = sizes.right.kind == sizing_value;
  let top_set = sizes.top.kind == sizing_value;
  let bottom_set = sizes.bottom.kind == sizing_value;
  let across = bor(left_set, right_set);
  let down = bor(top_set, bottom_set);
  let made = band(across, down);
  return made;
}

fn laid_out_by_position(styles: &Styles, style: StyleRef) -> again: Bool reads(styles) {
  doc "Tells whether position_out_with lays an absolutely or fixed positioned box of style out again in the space its insets leave: when both insets of an axis are set and its size on that axis is auto, or when its width or height is a percentage.";
  let sizes = size_of(styles: styles, style: style);
  let left_set = sizes.left.kind == sizing_value;
  let right_set = sizes.right.kind == sizing_value;
  let top_set = sizes.top.kind == sizing_value;
  let bottom_set = sizes.bottom.kind == sizing_value;
  let width_auto = sizes.width.kind != sizing_value;
  let height_auto = sizes.height.kind != sizing_value;
  let stretch_width_pair = band(left_set, right_set);
  let stretch_width = band(stretch_width_pair, width_auto);
  let stretch_height_pair = band(top_set, bottom_set);
  let stretch_height = band(stretch_height_pair, height_auto);
  let width_is_value = sizes.width.kind == sizing_value;
  let height_is_value = sizes.height.kind == sizing_value;
  let width_percent = band(width_is_value, sizes.width.value.has_percent);
  let height_percent = band(height_is_value, sizes.height.value.has_percent);
  let percent_axis = bor(width_percent, height_percent);
  let stretch_axis = bor(stretch_width, stretch_height);
  let made = bor(stretch_axis, percent_axis);
