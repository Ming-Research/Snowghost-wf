fn resume_open_frames(context: &Context, styles: &Styles, frames: &Box<Slots<Frame>>, block: u32, content_top: i32) -> usable: Bool reads(context), reads(styles), writes(context.reference_blocks), writes(context.blocks.inner), writes(frames) {
