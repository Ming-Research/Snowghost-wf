}
fn lay_out(layout: &Layout, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(document), reads(styles), reads(fonts), reads(picks), writes(layout) {
  doc "Lays out the initial containing block at the viewport's size, its origin at the viewport's, so that a percentage height of the root element resolves against the viewport's height (research/investigations/layout/runs/root-percent-height.txt).";
  let viewport = layout^.viewport;
  let width = units(px: viewport.width);
  let height = units(px: viewport.height);
  let no = False();
  let canonical_call_145 = Space(available: width, basis_width: width, basis_height: height, forced_width: width, forced_height: height, shrink: no);
  set layout^.root.space = canonical_call_145;
  lay_out_context(context: &layout^.root, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  set layout^.root.x = 0_i32;
  set layout^.root.y = 0_i32;
  return unit;
}
fn place_rect(fragment: Fragment, x: i32, y: i32, map: &[ColumnPiece], map_y: i32, out: &Box<Slots<PlacedRect>>) -> result: unit reads(map), writes(out) {
  doc "Appends fragment at the absolute origin x, y, moved by the column map whose context's border box lies at map_y: the parts of a rectangle that fall in several columns become one rectangle per column, as the reference reports a box split across columns.";
  let left = x +sat fragment.x;
  let top = y +sat fragment.y;
  let bottom = top +sat fragment.height;
  let pieces = map^.len;
  let px_width = pixels(raw: fragment.width);
  if pieces == 0_u64 {
    let px_x = pixels(raw: left);
    let px_y = pixels(raw: top);
    let px_height = pixels(raw: fragment.height);
    let made = PlacedRect(kind: fragment.kind, owner: fragment.owner, x: px_x, y: px_y, width: px_width, height: px_height);
    let pushed = push_item::<PlacedRect>(cell: out, value: made, ceiling: item_ceiling);
    return unit;
  }
  let local_top = top -sat map_y;
  let local_bottom = bottom -sat map_y;
  let flat = fragment.height == 0_i32;
  for (k in 0_u64..pieces) {
    let piece = map^[k];
    let starts_before_end = local_top < piece.to;
    let ends_after_start = local_bottom > piece.from;
    let overlaps = band(starts_before_end, ends_after_start);
    let at_or_after = local_top >= piece.from;
    let inside_point = band(at_or_after, starts_before_end);
    let point = band(flat, inside_point);
    let takes = bor(overlaps, point);
    if takes {
      let clipped_top = imax(local_top, piece.from);
      let moved_top = clipped_top +sat piece.dy;
      let continues = local_bottom > piece.to;
      let moved_bottom = if continues {
        give piece.bottom;
      } else {
        give local_bottom +sat piece.dy;
      }
      let part = moved_bottom -sat moved_top;
      let part_height = imax(part, 0_i32);
      let absolute_top = moved_top +sat map_y;
      let moved_left = left +sat piece.dx;
      let px_x = pixels(raw: moved_left);
      let px_y = pixels(raw: absolute_top);
      let px_height = pixels(raw: part_height);
      let made = PlacedRect(kind: fragment.kind, owner: fragment.owner, x: px_x, y: px_y, width: px_width, height: px_height);
      let pushed = push_item::<PlacedRect>(cell: out, value: made, ceiling: item_ceiling);
      if flat {
        return unit;
      }
    }
  }
  return unit;
}

fn place_context(context: &Context, x: i32, y: i32, map: &[ColumnPiece], map_y: i32, out: &Box<Slots<PlacedRect>>) -> result: unit reads(context), reads(map), writes(out) {
  doc "Appends context's fragments at its absolute origin x, y, then its children's, each at its own origin, moving them by the innermost multi-column context's column map: a multi-column context's own box by its parent's map, its content by its own. Its own box's fragment comes first, then each shown block box's border box in Open-entry order and each paragraph's fragments in Text-entry order at the paragraph's origin, then the rest of its fragments. These publication phases keep the reference dump order independently of block and paragraph payload slots.";
  let own_pieces = context^.column_map.inner.len;
  let own_map = own_pieces > 0_u64;
  let style = context^.style;
  let count = context^.fragments.inner.len;
  let owned = owns_fragment(style: style);
  let own_count = if owned {
    let canonical_call_146 = imin(count, 1_u64);
    give canonical_call_146;
  } else {
    give 0_u64;
  }
  for (f in 0_u64..own_count) {
    if f < context^.fragments.inner.len {
      let fragment = context^.fragments.inner[f];
      place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
    }
  }
  let origins = placement_origins(context: context);
  let origin_count = origins.inner.len;
  let entries = flow_length(context: context);
  for (at_entry in 0_u64..entries) {
    let b = block_at_entry(context: context, at_entry: at_entry);
    if b.slot != no_index {
      let block = block_value(context: context, handle: b);
      let shown = shown_owner(style: block.style);
      if shown {
        let block_slot = block.directory;
        let accumulated_origin = owner_origin(origins: &origins.inner[0_u64..origin_count], owner: block_slot);
        let visual_origin = origin_visual(value: accumulated_origin);
        let placed_origin = content_position(value: visual_origin, dx: context^.content_dx, dy: context^.content_dy);
        let fragment = Fragment(kind: placed_element, owner: block.style.element, x: placed_origin.x, y: placed_origin.y, width: block.width, height: block.height);
        place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
      }
    }
  }
  for (at_entry in 0_u64..entries) {
    let p = paragraph_at_entry(context: context, at_entry: at_entry);
    if p.slot != no_index {
      let geometry_read_24 = placed_paragraph_position(context: context, origins: &origins.inner[0_u64..origin_count], at: p);
      let left = geometry_read_24.x;
      let geometry_read_25 = placed_paragraph_position(context: context, origins: &origins.inner[0_u64..origin_count], at: p);
      let top = geometry_read_25.y;
      let payload_read_1 = paragraph_value(context: context, handle: p);
      let pieces = payload_read_1.fragments_count;
      for (f in 0_u64..pieces) {
        let payload_read_2 = paragraph_value(context: context, handle: p);
        if f < payload_read_2.fragments_count {
          let payload_read_3 = paragraph_fragment(context: context, handle: p, index: f);
          let piece = payload_read_3;
          let moved_x = left +sat piece.x;
          let moved_y = top +sat piece.y;
          let fragment = Fragment(kind: piece.kind, owner: piece.owner, x: moved_x, y: moved_y, width: piece.width, height: piece.height);
          place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
        }
      }
    }
  }
  for (f in own_count..count) {
    if f < context^.fragments.inner.len {
      let held_fragment = context^.fragments.inner[f];
      let content_x = held_fragment.x +sat context^.content_dx;
      let content_y = held_fragment.y +sat context^.content_dy;
      let fragment = Fragment(kind: held_fragment.kind, owner: held_fragment.owner, x: content_x, y: content_y, width: held_fragment.width, height: held_fragment.height);
      place_fragment(context: context, fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
    }
  }
  let map_count = if own_map {
    give own_pieces;
  } else {
    give map^.len;
  }
  let empty_column = ColumnPiece(from: 0_i32, to: 0_i32, dx: 0_i32, dy: 0_i32, bottom: 0_i32);
  let child_map = box_array_filled::<ColumnPiece>(count: map_count, value: empty_column);
  for (map_at in 0_u64..map_count) {
    if own_map {
      if map_at < context^.column_map.inner.len {
        set child_map.inner[map_at] = context^.column_map.inner[map_at];
      }
    } else {
      if map_at < map^.len {
        set child_map.inner[map_at] = map^[map_at];
      }
    }
  }
  let child_map_y = if own_map {
    give y;
  } else {
    give map_y;
  }
  let unused = unit;
  let children = context^.child_routes.inner.len;
  for (child_route_at in 0_u64..children) {
    let c = context^.child_routes.inner[child_route_at];
    let child = child_value(context: context, handle: c);
    let placed_child_origin = placed_child_position(context: context, origins: &origins.inner[0_u64..origin_count], at: c);
    let moved_x = x +sat placed_child_origin.x;
    let moved_y = y +sat placed_child_origin.y;
    let child_x = if child.viewport_origin {
      give placed_child_origin.x;
    } else {
      give moved_x;
    }
    let child_y = if child.viewport_origin {
      give placed_child_origin.y;
    } else {
      give moved_y;
    }
    let placement = PlaceChildArgs(x: child_x, y: child_y, map_y: child_map_y);
    place_child_handle(context: context, handle: c, map: &child_map, placement: placement, out: out);
  }
  return unit;
}
fn place_fragment(context: &Context, fragment: Fragment, x: i32, y: i32, map: &[ColumnPiece], map_y: i32, out: &Box<Slots<PlacedRect>>) -> result: unit reads(context), reads(map), writes(out) {
  doc "Appends one of context's fragments at its absolute origin x, y: the context's own box by the column map around it, anything else by the context's own column map when it has one.";
  let own_pieces = context^.column_map.inner.len;
  let own_map = own_pieces > 0_u64;
  let style = context^.style;
  let element_kind = fragment.kind == placed_element;
  let same_owner = fragment.owner == style.element;
  let named = bnot(style.anonymous);
  let owned_pair = band(element_kind, same_owner);
  let own_box = band(owned_pair, named);
  let no_map = bnot(own_map);
  let outer = bor(own_box, no_map);
  if outer {
    place_rect(fragment: fragment, x: x, y: y, map: map, map_y: map_y, out: out);
  } else {
    place_rect(fragment: fragment, x: x, y: y, map: &context^.column_map.inner[0_u64..own_pieces], map_y: y, out: out);
  }
  return unit;
}

fn place_boxes(layout: &Layout) -> placed: Box<Slots<PlacedRect>> reads(layout) {
  doc "Publishes owner-relative normal origins and separate visual displacements through place_context, accumulating blocks before the column map and preserving the reference fragment order and viewport-fixed exception.";
  let out = box_slots_new::<PlacedRect>(capacity: 1024_u64);
  let none = box_slots_new::<ColumnPiece>(capacity: 0_u64);
  place_context(context: &layout^.root, x: layout^.root.x, y: layout^.root.y, map: &none.inner[0_u64..0_u64], map_y: 0_i32, out: &out);
  return move out;
}

fn intrinsic_owned_child(value: &Context, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(value) {
  doc "Computes independent child intrinsic inputs in its physical owner-local slot.";
  let (least, most) = intrinsic_sizes(context: value, styles: a, document: b, fonts: c, picks: d, viewport: e^);
  let style = value^.style;
  let margins = margin_edges(styles: a, style: style, basis: 0_i32);
  set value^.margin_left = margins.left;
  set value^.margin_right = margins.right;
  return unit;
}
fn block_handle(context: &Context, owner: u32) -> made: EntryHandle reads(context.block_routes.inner) {
  doc "Resolves an ancestor owner-directory key to its stable payload address.";
  let at = cvt::<u32, u64>(owner);
  if at < context^.block_routes.inner.len {
    return context^.block_routes.inner[at];
  }
  let missing = absent_handle();
  return missing;
}



fn layout_child_handle(context: &Context, handle: EntryHandle, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, updating: Bool) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out a child through a checked local borrow, without a generic callback on the recursive layout cycle.";
  let absent_counts = no_updates();
  let layout_payload_lookup_handle = handle;
  let layout_payload_lookup_path = owner_path(context: context, owner: layout_payload_lookup_handle.owner);
  let layout_payload_lookup_length = layout_payload_lookup_path.inner.len;
  let layout_payload_lookup_sequence = &context^.entries;
  for (layout_payload_lookup_step in 0_u64..layout_payload_lookup_length) {
    let layout_payload_lookup_reverse = layout_payload_lookup_length -sat 1_u64;
    let layout_payload_lookup_index = layout_payload_lookup_reverse -sat layout_payload_lookup_step;
    if layout_payload_lookup_index < layout_payload_lookup_path.inner.len {
    } else {
      return absent_counts;
    }
    let layout_payload_lookup_block_slot = layout_payload_lookup_path.inner[layout_payload_lookup_index];
    let layout_payload_lookup_node = sequence_node(sequence: layout_payload_lookup_sequence, slot: layout_payload_lookup_block_slot);
    if layout_payload_lookup_node.live {
    } else {
      return absent_counts;
    }
    let layout_payload_lookup_blocks = &layout_payload_lookup_sequence^.blocks;
    let layout_payload_lookup_block_span = layout_payload_lookup_sequence^.span;
    let layout_payload_lookup_block_offset = layout_payload_lookup_block_slot;
    loop {
      match layout_payload_lookup_blocks^ {
        Vacant() => {
          return absent_counts;
        }
        Fork(left: layout_payload_lookup_left, right: layout_payload_lookup_right) => {
          let layout_payload_lookup_half = layout_payload_lookup_block_span / 2_u32;
          if layout_payload_lookup_block_offset < layout_payload_lookup_half {
            set layout_payload_lookup_blocks = &layout_payload_lookup_left^.inner;
          } else {
            set layout_payload_lookup_blocks = &layout_payload_lookup_right^.inner;
            set layout_payload_lookup_block_offset = layout_payload_lookup_block_offset -sat layout_payload_lookup_half;
          }
          set layout_payload_lookup_block_span = layout_payload_lookup_half;
        }
        Page(values: layout_payload_lookup_block_values) => {
          let layout_payload_lookup_block_at = cvt::<u32, u64>(layout_payload_lookup_block_offset);
          if layout_payload_lookup_block_at < layout_payload_lookup_block_values^.inner.len {
            match layout_payload_lookup_block_values^.inner[layout_payload_lookup_block_at] {
              Some(value: layout_payload_lookup_block) => {
                set layout_payload_lookup_sequence = &layout_payload_lookup_block^.entries;
              }
              None() => {
                return absent_counts;
              }
            }
          } else {
            return absent_counts;
          }
          break;
        }
      }
    }
  }
  let layout_payload_lookup_target = sequence_node(sequence: layout_payload_lookup_sequence, slot: layout_payload_lookup_handle.slot);
  if layout_payload_lookup_target.live {
  } else {
    return absent_counts;
  }
  let layout_payload_lookup_pages = &layout_payload_lookup_sequence^.children;
  let layout_payload_lookup_span = layout_payload_lookup_sequence^.span;
  let layout_payload_lookup_offset = layout_payload_lookup_handle.slot;
  loop {
    match layout_payload_lookup_pages^ {
      Fork(left: layout_payload_lookup_target_left, right: layout_payload_lookup_target_right) => {
        let layout_payload_lookup_target_half = layout_payload_lookup_span / 2_u32;
        if layout_payload_lookup_offset < layout_payload_lookup_target_half {
          set layout_payload_lookup_pages = &layout_payload_lookup_target_left^.inner;
        } else {
          set layout_payload_lookup_pages = &layout_payload_lookup_target_right^.inner;
          set layout_payload_lookup_offset = layout_payload_lookup_offset -sat layout_payload_lookup_target_half;
        }
        set layout_payload_lookup_span = layout_payload_lookup_target_half;
      }
      Vacant() => {
        return absent_counts;
      }
      Page(..) => {
        break;
      }
    }
  }
  let layout_payload = match layout_payload_lookup_pages^ {
    Page(values: layout_payload_lookup_values) => {
      let layout_payload_lookup_at = cvt::<u32, u64>(layout_payload_lookup_offset);
      if layout_payload_lookup_at < layout_payload_lookup_values^.inner.len {
        match layout_payload_lookup_values^.inner[layout_payload_lookup_at] {
          Some(value: layout_payload_lookup_value) => {
            give layout_payload_lookup_value;
          }
          None() => {
            return absent_counts;
          }
        }
      } else {
        return absent_counts;
      }
    }
    Vacant() => {
      return absent_counts;
    }
    Fork(..) => {
      return absent_counts;
    }
  }
  let counted = lay_out_child(child: layout_payload, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: updating);
  return counted;
}


fn settle_child_handle(context: &Context, handle: EntryHandle, result: &UpdateCounts, before: Before, unasked: Bool, marked_parent: Bool, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result_unit: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context), writes(result) {
  doc "Settles a child through a checked local borrow, preserving the nongeneric recursive layout call graph.";
  let settled_payload_lookup_handle = handle;
  let settled_payload_lookup_path = owner_path(context: context, owner: settled_payload_lookup_handle.owner);
  let settled_payload_lookup_length = settled_payload_lookup_path.inner.len;
  let settled_payload_lookup_sequence = &context^.entries;
  for (settled_payload_lookup_step in 0_u64..settled_payload_lookup_length) {
    let settled_payload_lookup_reverse = settled_payload_lookup_length -sat 1_u64;
    let settled_payload_lookup_index = settled_payload_lookup_reverse -sat settled_payload_lookup_step;
    if settled_payload_lookup_index < settled_payload_lookup_path.inner.len {
    } else {
      return unit;
    }
    let settled_payload_lookup_block_slot = settled_payload_lookup_path.inner[settled_payload_lookup_index];
    let settled_payload_lookup_node = sequence_node(sequence: settled_payload_lookup_sequence, slot: settled_payload_lookup_block_slot);
    if settled_payload_lookup_node.live {
    } else {
      return unit;
    }
    let settled_payload_lookup_blocks = &settled_payload_lookup_sequence^.blocks;
    let settled_payload_lookup_block_span = settled_payload_lookup_sequence^.span;
    let settled_payload_lookup_block_offset = settled_payload_lookup_block_slot;
    loop {
      match settled_payload_lookup_blocks^ {
        Vacant() => {
          return unit;
        }
        Fork(left: settled_payload_lookup_left, right: settled_payload_lookup_right) => {
          let settled_payload_lookup_half = settled_payload_lookup_block_span / 2_u32;
          if settled_payload_lookup_block_offset < settled_payload_lookup_half {
            set settled_payload_lookup_blocks = &settled_payload_lookup_left^.inner;
          } else {
            set settled_payload_lookup_blocks = &settled_payload_lookup_right^.inner;
            set settled_payload_lookup_block_offset = settled_payload_lookup_block_offset -sat settled_payload_lookup_half;
          }
          set settled_payload_lookup_block_span = settled_payload_lookup_half;
        }
        Page(values: settled_payload_lookup_block_values) => {
          let settled_payload_lookup_block_at = cvt::<u32, u64>(settled_payload_lookup_block_offset);
          if settled_payload_lookup_block_at < settled_payload_lookup_block_values^.inner.len {
            match settled_payload_lookup_block_values^.inner[settled_payload_lookup_block_at] {
              Some(value: settled_payload_lookup_block) => {
                set settled_payload_lookup_sequence = &settled_payload_lookup_block^.entries;
              }
              None() => {
                return unit;
              }
            }
          } else {
            return unit;
          }
          break;
        }
      }
    }
  }
  let settled_payload_lookup_target = sequence_node(sequence: settled_payload_lookup_sequence, slot: settled_payload_lookup_handle.slot);
  if settled_payload_lookup_target.live {
  } else {
    return unit;
  }
  let settled_payload_lookup_pages = &settled_payload_lookup_sequence^.children;
  let settled_payload_lookup_span = settled_payload_lookup_sequence^.span;
  let settled_payload_lookup_offset = settled_payload_lookup_handle.slot;
  loop {
    match settled_payload_lookup_pages^ {
      Fork(left: settled_payload_lookup_target_left, right: settled_payload_lookup_target_right) => {
        let settled_payload_lookup_target_half = settled_payload_lookup_span / 2_u32;
        if settled_payload_lookup_offset < settled_payload_lookup_target_half {
          set settled_payload_lookup_pages = &settled_payload_lookup_target_left^.inner;
        } else {
          set settled_payload_lookup_pages = &settled_payload_lookup_target_right^.inner;
          set settled_payload_lookup_offset = settled_payload_lookup_offset -sat settled_payload_lookup_target_half;
        }
        set settled_payload_lookup_span = settled_payload_lookup_target_half;
      }
      Vacant() => {
        return unit;
      }
      Page(..) => {
        break;
      }
    }
  }
  let settled_payload = match settled_payload_lookup_pages^ {
    Page(values: settled_payload_lookup_values) => {
      let settled_payload_lookup_at = cvt::<u32, u64>(settled_payload_lookup_offset);
      if settled_payload_lookup_at < settled_payload_lookup_values^.inner.len {
        match settled_payload_lookup_values^.inner[settled_payload_lookup_at] {
          Some(value: settled_payload_lookup_value) => {
            give settled_payload_lookup_value;
          }
          None() => {
            return unit;
          }
        }
      } else {
        return unit;
      }
    }
    Vacant() => {
      return unit;
    }
    Fork(..) => {
      return unit;
    }
  }
  settle_child(child: settled_payload, result: result, before: before, unasked: unasked, marked_parent: marked_parent, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  return unit;
}
fn child_before(context: &Context, handle: EntryHandle) -> made: Before reads(context) {
  doc "Copies the update outputs of one owner-local child.";
  let child = child_value(context: context, handle: handle);
  let made = Before(space: child.laid, width: child.width, height: child.height, baseline: child.baseline, has_baseline: child.has_baseline, margin_top: child.margin_top, margin_right: child.margin_right, margin_bottom: child.margin_bottom, margin_left: child.margin_left);
  return made;
}
fn addressed_full_width(value: &Paragraph, a: &Styles, b: &FontSet, c: &FontPicks, d: &unit, e: &unit, state: &Bool) -> result: unit reads(value), reads(a), reads(b), reads(c), writes(state) {
  doc "Reads the line-width reuse predicate from one paragraph payload.";
  let full = full_width_lines(paragraph: value, styles: a, fonts: b, picks: c);
  set state^ = full;
  return unit;
}
fn full_width_handle(context: &Context, handle: EntryHandle, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> full: Bool reads(context), reads(styles), reads(fonts), reads(picks) {
  doc "Checks reusable full-width lines without copying owned paragraph state.";
  let state = False();
  let unused = unit;
  read_paragraph::<Styles, FontSet, FontPicks, unit, unit, Bool, fn addressed_full_width>(context: context, handle: handle, a: styles, b: fonts, c: picks, d: &unused, e: &unused, state: &state);
  return state;
}
struct BreakExclusions {
  doc "Immutable exclusion inputs separated from the paragraph being rebroken.";
  exclusions: Box<Array<Exclusion>>;
  origin_y: i32;
}

fn break_addressed_paragraph(value: &Paragraph, a: &Box<Array<ChildSnapshot>>, b: &Styles, c: &FontSet, d: &FontPicks, e: &BreakExclusions, state: &unit) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(value) {
  doc "Rebreaks one paragraph from independent child snapshots and BFC exclusions.";
  let children = a^.inner.len;
  let exclusions = e^.exclusions.inner.len;
  break_paragraph(paragraph: value, children: &a^.inner[0_u64..children], styles: b, fonts: c, picks: d, exclusions: &e^.exclusions.inner[0_u64..exclusions], origin_y: e^.origin_y);
  return unit;
}
fn break_paragraph_handle(context: &Context, handle: EntryHandle, children: &Box<Array<ChildSnapshot>>, styles: &Styles, fonts: &FontSet, picks: &FontPicks, exclusions: &[Exclusion], origin_y: i32) -> result: unit reads(children), reads(styles), reads(fonts), reads(picks), reads(exclusions), writes(context) {
  doc "Rebreaks a stable paragraph slot with the enclosing BFC float state kept intact.";
  let no = False();
  let empty = Exclusion(left: no, top: 0_i32, bottom: 0_i32, edge: 0_i32);
  let count = exclusions^.len;
  let copied = box_array_filled::<Exclusion>(count: count, value: empty);
  for (at in 0_u64..count) {
    set copied.inner[at] = exclusions^[at];
  }
  let request = BreakExclusions(exclusions: move copied, origin_y: origin_y);
  let unused = unit;
  edit_paragraph::<Box<Array<ChildSnapshot>>, Styles, FontSet, FontPicks, BreakExclusions, unit, fn break_addressed_paragraph>(context: context, handle: handle, a: children, b: styles, c: fonts, d: picks, e: &request, state: &unused);
  return unit;
}
fn intrinsic_addressed_paragraph(value: &Paragraph, a: &Box<Array<ChildSnapshot>>, b: &Styles, c: &Bool, d: &unit, e: &unit, state: &i32) -> result: unit reads(value), reads(a), reads(b), reads(c), writes(state) {
  doc "Reads one paragraph's intrinsic width using immutable atomic-inline geometry.";
  let count = a^.inner.len;
  let width = paragraph_intrinsic(paragraph: value, children: &a^.inner[0_u64..count], styles: b, minimum: c^);
  set state^ = width;
  return unit;
}
fn paragraph_intrinsic_handle(context: &Context, handle: EntryHandle, children: &Box<Array<ChildSnapshot>>, styles: &Styles, minimum: Bool) -> made: i32 reads(context), reads(children), reads(styles) {
  doc "Computes intrinsic width from one stable paragraph handle.";
  let state = 0_i32;
  let unused = unit;
  read_paragraph::<Box<Array<ChildSnapshot>>, Styles, Bool, unit, unit, i32, fn intrinsic_addressed_paragraph>(context: context, handle: handle, a: children, b: styles, c: &minimum, d: &unused, e: &unused, state: &state);
  return state;
}
fn read_same_child_outputs(value: &Context, a: &Before, b: &unit, c: &unit, d: &unit, e: &unit, state: &Bool) -> result: unit reads(value), reads(a), writes(state) {
  doc "Compares one child's outputs to its saved update snapshot.";
  let same = same_outputs(before: a^, context: value);
  set state^ = same;
  return unit;
}
fn same_child_outputs(context: &Context, handle: EntryHandle, before: Before) -> made: Bool reads(context) {
  doc "Reads the update cutoff predicate through an owner-local child handle.";
  let state = False();
  let unused = unit;
  read_child::<Before, unit, unit, unit, unit, Bool, fn read_same_child_outputs>(context: context, handle: handle, a: &before, b: &unused, c: &unused, d: &unused, e: &unused, state: &state);
  return state;
}
struct PlaceChildArgs {
  doc "Absolute publication origin and inherited column-map origin for one child.";
  x: i32;
  y: i32;
  map_y: i32;
}

fn place_child_handle(context: &Context, handle: EntryHandle, map: &Box<Array<ColumnPiece>>, placement: PlaceChildArgs, out: &Box<Slots<PlacedRect>>) -> result: unit reads(context), reads(map), writes(out) {
  doc "Publishes a checked child borrow without a generic callback in recursive publication.";
  let published_payload_lookup_handle = handle;
  let published_payload_lookup_path = owner_path(context: context, owner: published_payload_lookup_handle.owner);
  let published_payload_lookup_length = published_payload_lookup_path.inner.len;
  let published_payload_lookup_sequence = &context^.entries;
  for (published_payload_lookup_step in 0_u64..published_payload_lookup_length) {
    let published_payload_lookup_reverse = published_payload_lookup_length -sat 1_u64;
    let published_payload_lookup_index = published_payload_lookup_reverse -sat published_payload_lookup_step;
    if published_payload_lookup_index < published_payload_lookup_path.inner.len {
    } else {
      return unit;
    }
    let published_payload_lookup_block_slot = published_payload_lookup_path.inner[published_payload_lookup_index];
    let published_payload_lookup_node = sequence_node(sequence: published_payload_lookup_sequence, slot: published_payload_lookup_block_slot);
    if published_payload_lookup_node.live {
    } else {
      return unit;
    }
    let published_payload_lookup_blocks = &published_payload_lookup_sequence^.blocks;
    let published_payload_lookup_block_span = published_payload_lookup_sequence^.span;
    let published_payload_lookup_block_offset = published_payload_lookup_block_slot;
    loop {
      match published_payload_lookup_blocks^ {
        Vacant() => {
          return unit;
        }
        Fork(left: published_payload_lookup_left, right: published_payload_lookup_right) => {
          let published_payload_lookup_half = published_payload_lookup_block_span / 2_u32;
          if published_payload_lookup_block_offset < published_payload_lookup_half {
            set published_payload_lookup_blocks = &published_payload_lookup_left^.inner;
          } else {
            set published_payload_lookup_blocks = &published_payload_lookup_right^.inner;
            set published_payload_lookup_block_offset = published_payload_lookup_block_offset -sat published_payload_lookup_half;
          }
          set published_payload_lookup_block_span = published_payload_lookup_half;
        }
        Page(values: published_payload_lookup_block_values) => {
          let published_payload_lookup_block_at = cvt::<u32, u64>(published_payload_lookup_block_offset);
          if published_payload_lookup_block_at < published_payload_lookup_block_values^.inner.len {
            match published_payload_lookup_block_values^.inner[published_payload_lookup_block_at] {
              Some(value: published_payload_lookup_block) => {
                set published_payload_lookup_sequence = &published_payload_lookup_block^.entries;
              }
              None() => {
                return unit;
              }
            }
          } else {
            return unit;
          }
          break;
        }
      }
    }
  }
  let published_payload_lookup_target = sequence_node(sequence: published_payload_lookup_sequence, slot: published_payload_lookup_handle.slot);
  if published_payload_lookup_target.live {
  } else {
    return unit;
  }
  let published_payload_lookup_pages = &published_payload_lookup_sequence^.children;
  let published_payload_lookup_span = published_payload_lookup_sequence^.span;
  let published_payload_lookup_offset = published_payload_lookup_handle.slot;
  loop {
    match published_payload_lookup_pages^ {
      Fork(left: published_payload_lookup_target_left, right: published_payload_lookup_target_right) => {
        let published_payload_lookup_target_half = published_payload_lookup_span / 2_u32;
        if published_payload_lookup_offset < published_payload_lookup_target_half {
          set published_payload_lookup_pages = &published_payload_lookup_target_left^.inner;
        } else {
          set published_payload_lookup_pages = &published_payload_lookup_target_right^.inner;
          set published_payload_lookup_offset = published_payload_lookup_offset -sat published_payload_lookup_target_half;
        }
        set published_payload_lookup_span = published_payload_lookup_target_half;
      }
      Vacant() => {
        return unit;
      }
      Page(..) => {
        break;
      }
    }
  }
  let published_payload = match published_payload_lookup_pages^ {
    Page(values: published_payload_lookup_values) => {
      let published_payload_lookup_at = cvt::<u32, u64>(published_payload_lookup_offset);
      if published_payload_lookup_at < published_payload_lookup_values^.inner.len {
        match published_payload_lookup_values^.inner[published_payload_lookup_at] {
          Some(value: published_payload_lookup_value) => {
            give published_payload_lookup_value;
          }
          None() => {
            return unit;
          }
        }
      } else {
        return unit;
      }
    }
    Vacant() => {
      return unit;
    }
    Fork(..) => {
      return unit;
    }
  }
  let count = map^.inner.len;
  place_context(context: published_payload, x: placement.x, y: placement.y, map: &map^.inner[0_u64..count], map_y: placement.map_y, out: out);
  return unit;
}
fn flow_layout_visit_children_pages_owned(pages: &OwnedPages<Context>, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(pages) {
  doc "Visits independently owned children in counted leaf-slot loops; directory branches own disjoint subtrees.";
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      flow_layout_visit_children_pages_owned(pages: &left_page^.inner, a: a, b: b, c: c, d: d, e: e);
      flow_layout_visit_children_pages_owned(pages: &right_page^.inner, a: a, b: b, c: c, d: d, e: e);
    }
    Page(values: page) => {
      let count = page^.inner.len;
      for (at in 0_u64..count) {
        match page^.inner[at] {
          Some(value: payload) => {
            layout_owned_child(value: payload, a: a, b: b, c: c, d: d, e: e);
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn flow_layout_visit_children_blocks_owned(pages: &OwnedPages<Block>, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(pages) {
  doc "Descends independent block payload slots without a route-selected scatter or a new sibling dependency.";
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      flow_layout_visit_children_blocks_owned(pages: &left_page^.inner, a: a, b: b, c: c, d: d, e: e);
      flow_layout_visit_children_blocks_owned(pages: &right_page^.inner, a: a, b: b, c: c, d: d, e: e);
    }
    Page(values: page) => {
      let count = page^.inner.len;
      for (at in 0_u64..count) {
        match page^.inner[at] {
          Some(value: block) => {
            flow_layout_visit_children_sequence_owned(sequence: &block^.entries, a: a, b: b, c: c, d: d, e: e);
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn flow_layout_visit_children_sequence_owned(sequence: &EntrySequence, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(sequence) {
  doc "Walks physical owner-local payload storage, keeping each sibling operation on its own owned place.";
  flow_layout_visit_children_pages_owned(pages: &sequence^.children, a: a, b: b, c: c, d: d, e: e);
  flow_layout_visit_children_blocks_owned(pages: &sequence^.blocks, a: a, b: b, c: c, d: d, e: e);
  return unit;
}
fn flow_layout_visit_children_owned(context: &Context, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(context.entries) {
  doc "Full-build children traversal over actual owned slots; routes and compatibility ranks do not choose mutable payloads.";
  flow_layout_visit_children_sequence_owned(sequence: &context^.entries, a: a, b: b, c: c, d: d, e: e);
  return unit;
}

fn flow_intrinsic_visit_children_pages_owned(pages: &OwnedPages<Context>, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(pages) {
  doc "Visits independently owned children in counted leaf-slot loops; directory branches own disjoint subtrees.";
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      flow_intrinsic_visit_children_pages_owned(pages: &left_page^.inner, a: a, b: b, c: c, d: d, e: e);
      flow_intrinsic_visit_children_pages_owned(pages: &right_page^.inner, a: a, b: b, c: c, d: d, e: e);
    }
    Page(values: page) => {
      let count = page^.inner.len;
      for (at in 0_u64..count) {
        match page^.inner[at] {
          Some(value: payload) => {
            intrinsic_owned_child(value: payload, a: a, b: b, c: c, d: d, e: e);
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn flow_intrinsic_visit_children_blocks_owned(pages: &OwnedPages<Block>, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(pages) {
  doc "Descends independent block payload slots without a route-selected scatter or a new sibling dependency.";
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      flow_intrinsic_visit_children_blocks_owned(pages: &left_page^.inner, a: a, b: b, c: c, d: d, e: e);
      flow_intrinsic_visit_children_blocks_owned(pages: &right_page^.inner, a: a, b: b, c: c, d: d, e: e);
    }
    Page(values: page) => {
      let count = page^.inner.len;
      for (at in 0_u64..count) {
        match page^.inner[at] {
          Some(value: block) => {
            flow_intrinsic_visit_children_sequence_owned(sequence: &block^.entries, a: a, b: b, c: c, d: d, e: e);
          }
          None() => {
          }
        }
      }
    }
  }
  return unit;
}
fn flow_intrinsic_visit_children_sequence_owned(sequence: &EntrySequence, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(sequence) {
  doc "Walks physical owner-local payload storage, keeping each sibling operation on its own owned place.";
  flow_intrinsic_visit_children_pages_owned(pages: &sequence^.children, a: a, b: b, c: c, d: d, e: e);
  flow_intrinsic_visit_children_blocks_owned(pages: &sequence^.blocks, a: a, b: b, c: c, d: d, e: e);
  return unit;
}
fn flow_intrinsic_visit_children_owned(context: &Context, a: &Styles, b: &Document, c: &FontSet, d: &FontPicks, e: &Viewport) -> result: unit reads(a), reads(b), reads(c), reads(d), reads(e), writes(context.entries) {
  doc "Full-build children traversal over actual owned slots; routes and compatibility ranks do not choose mutable payloads.";
  flow_intrinsic_visit_children_sequence_owned(sequence: &context^.entries, a: a, b: b, c: c, d: d, e: e);
  return unit;
}

fn flow_break_visit_paragraphs_pages_owned(pages: &OwnedPages<Paragraph>, a: &Box<Array<ChildSnapshot>>, b: &Styles, c: &FontSet, d: &FontPicks, e: &unit) -> result: unit reads(a), reads(b), reads(c), reads(d), writes(pages) {
  doc "Visits independently owned paragraphs in counted leaf-slot loops; directory branches own disjoint subtrees.";
  match pages^ {
    Vacant() => {
    }
    Fork(left: left_page, right: right_page) => {
      flow_break_visit_paragraphs_pages_owned(pages: &left_page^.inner, a: a, b: b, c: c, d: d, e: e);
      flow_break_visit_paragraphs_pages_owned(pages: &right_page^.inner, a: a, b: b, c: c, d: d, e: e);
    }
    Page(values: page) => {
      let count = page^.inner.len;
