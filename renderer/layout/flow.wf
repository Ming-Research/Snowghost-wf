fn position_out_with(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, border: Edges) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
