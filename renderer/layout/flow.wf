fn sort_keys(keys: &Box<Array<u64>>) -> result: unit writes(keys) {
  doc "Sorts keys in increasing order, by a bottom-up merge sort through a second array of the same length: O(n log n).";
  let length = keys^.inner.len;
  let count = imin(length, item_ceiling);
  if count < 2_u64 {
    return unit;
  }
  let other = box_array_filled::<u64>(count: count, value: 0_u64);
  let width = 1_u64;
  let into_other = True();
  for (pass in 0_u64..64_u64) {
    if width >= count {
      break;
    }
    if into_other {
      merge_pass(source: keys, target: &other, width: width);
    } else {
      merge_pass(source: &other, target: keys, width: width);
    }
    set into_other = bnot(into_other);
    set width = width +sat width;
  }
  if into_other {
  } else {
    let copied = imin(count, other.inner.len);
    for (k in 0_u64..copied) {
      if k < keys^.inner.len {
        set keys^.inner[k] = other.inner[k];
      }
    }
  }
  return unit;
}

fn merge_pass(source: &Box<Array<u64>>, target: &Box<Array<u64>>, width: u64) -> result: unit reads(source), writes(target) {
  doc "One pass of sort_keys: merges each pair of sorted runs of width keys of source into target.";
  let count = source^.inner.len;
  let start = 0_u64;
  for (run in 0_u64..count) {
    if start >= count {
      break;
    }
    let middle_raw = start +sat width;
    let middle = imin(middle_raw, count);
    let end_raw = middle +sat width;
    let end = imin(end_raw, count);
    let left = start;
    let right = middle;
    let out = start;
    let span = end -sat start;
    for (step in 0_u64..span) {
      let take_left = if left < middle {
        if right < end {
          if left < source^.inner.len {
            if right < source^.inner.len {
              give source^.inner[left] <= source^.inner[right];
            } else {
              give True();
            }
          } else {
            give False();
          }
        } else {
          give True();
        }
      } else {
        give False();
      }
      if out < target^.inner.len {
        if take_left {
          if left < source^.inner.len {
            set target^.inner[out] = source^.inner[left];
          }
          set left = left +sat 1_u64;
        } else {
          if right < source^.inner.len {
            set target^.inner[out] = source^.inner[right];
          }
          set right = right +sat 1_u64;
        }
      }
      set out = out +sat 1_u64;
    }
    set start = end;
  }
  return unit;
}

