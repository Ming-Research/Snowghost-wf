      set dy = dy +sat own_y;
      let shifted = held_position.y -sat content_top;
      let y = shifted -sat dy;
      let good_placed = interior_position(value: held_position.y);
      let good_shifted = interior_position(value: shifted);
      let good_y = interior_position(value: y);
      let first_good = band(good_placed, good_shifted);
      let good = band(first_good, good_y);
      if good {
      } else {
        return False();
      }
      let saved = Frame(block: b, left: held.avail_left, width: held.avail_width, basis_height: context^.blocks.inner[at].output.basis_height, top_frame: top_frame, known: yes, dx: dx, dy: dy, lines: yes);
