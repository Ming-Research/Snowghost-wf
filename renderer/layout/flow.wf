fn narrow_beside(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, child: u64, room: i32, needed: i32) -> (narrowed: Bool, counts: UpdateCounts) reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out again, room wide, an in-flow child context of auto width that does not fit, needed wide, in the room floats leave beside it, as the reference narrows a box that establishes a formatting context beside floats (CSS 2.2 9.5); a table or replaced box keeps its width. Tells whether it did, with what the child's layout counted (lay_out_child).";
