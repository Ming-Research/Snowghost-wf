  reach: i32;
  old_reach: i32;
  any: Bool;
  uniform: Bool;
  shift: i32;
}

fn restack_settles(context: &Context, styles: &Styles, frames: &Box<Slots<Frame>>, plan: Restack, content_top: i32, old_travel: i64, floats: FloatShift, cursor: i32, old_cursor: i32, floor: i32, basis_height: i32) -> settles: Bool reads(context), reads(styles), reads(frames) {
  doc "Tells whether a re-stack may stop after a paragraph with lines whose previous placement also had lines, the rest of the flow moving by delta = cursor - old_cursor. Old root travel and the content origin must certify the proposed suffix movement before any translation. Every block still open must end delta lower than before, less what its top moved (frames_grow); the waiting margins are none after a paragraph with lines, in both passes. When every float placed again moved by delta (or none was placed again), the floats of the two passes after the edited entry differ by delta like the rest: with delta 0 the states are the same and the re-stack stops; otherwise the floats placed before the edited entry, which did not move, must not reach below floor (the lowest position any later entry started from before floats and clearance moved it in the previous pass: naturals) nor the previous flow's end (plan.old_flow_end), in either pass (moved by delta in this one). When floats moved by other amounts, no float of either pass may reach below those limits. Then nothing placed so far narrows, moves, clears or holds up anything later and the content height moves by delta.";
  let delta = cursor -sat old_cursor;
  let exact_suffix = reference_motion_fits(origin: content_top, travel: old_travel, delta: delta);
