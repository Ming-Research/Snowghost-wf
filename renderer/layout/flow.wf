alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;
alias NodeId = pkg::dom::NodeId;
alias atom_img = pkg::base::static_atoms::atom_img;
alias sizing_value = pkg::css::values::sizing_value;
alias break_mandatory = pkg::layout::text::break_mandatory;
alias break_allowed = pkg::layout::text::break_allowed;

struct Frame {
  doc "A block box open during a flow pass: its index, the left offset, width and definite height basis of its containing block, its top border and padding, and, in the stacking pass, whether its border-box top is known yet, its relative offset and whether a line box lies inside it.";
  block: u32;
  left: i32;
  width: i32;
  basis_height: i32;
  top_frame: i32;
  known: Bool;
  dx: i32;
  dy: i32;
  lines: Bool;
}

struct Stack {
  doc "The stacking pass's vertical state: the bottom of the last placed content (cursor), the margins waiting to collapse (the largest positive and the most negative), the floats placed so far, the lowest top any later float may take, and the lowest bottom of the floats placed so far (reach).";
  cursor: i32;
  positive: i32;
  negative: i32;
  floats: Box<Slots<Exclusion>>;
  float_floor: i32;
  reach: i32;
}

fn pending_margin(stack: &Stack) -> margin: i32 reads(stack) {
  doc "The collapsed value of the waiting margins.";
  let made = stack^.positive +sat stack^.negative;
  return made;
}

fn add_margin(stack: &Stack, margin: i32) -> result: unit writes(stack) {
  doc "Adds a margin to the waiting margins, which collapse to the largest positive plus the most negative.";
  if margin >= 0_i32 {
    set stack^.positive = imax(stack^.positive, margin);
  } else {
    set stack^.negative = imin(stack^.negative, margin);
  }
  return unit;
}

fn clear_margins(stack: &Stack) -> result: unit writes(stack) {
  doc "Forgets the waiting margins once something separates them from later content.";
  set stack^.positive = 0_i32;
  set stack^.negative = 0_i32;
  return unit;
}

fn float_bottom(stack: &Stack, side: u8) -> bottom: i32 reads(stack) {
  doc "The lowest bottom of the floats on side (clear_left, clear_right or clear_both), or minus infinity.";
  let lowest = -2147483647_i32;
  let count = stack^.floats.inner.len;
  for (k in 0_u64..count) {
    let float_box = stack^.floats.inner[k];
    let wanted_left = side == clear_left;
    let wanted_right = side == clear_right;
    let wanted_both = side == clear_both;
    let left_hit = band(wanted_left, float_box.left);
    let right_side = bnot(float_box.left);
    let right_hit = band(wanted_right, right_side);
    let hit_pair = bor(left_hit, right_hit);
    let hit = bor(hit_pair, wanted_both);
    if hit {
      set lowest = imax(lowest, float_box.bottom);
    }
  }
  return lowest;
}

fn block_width(styles: &Styles, style: StyleRef, available: i32) -> (width: i32, left: i32, margin_left: i32, margin_right: i32) reads(styles) {
  doc "The border-box width and the left offset of an in-flow block-level box in a containing block available wide (CSS 2.2 10.3.3): an auto width fills the space its margins leave; a given width keeps it, with auto margins sharing the rest equally, one auto margin taking it all (a box that leaves no rest takes its auto margins as zero), and with none auto the right margin taking the rest.";
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: available);
  let frame_border = horizontal(edges: border);
  let frame_padding = horizontal(edges: padding);
  let frame = frame_border +sat frame_padding;
  let margins = margin_edges(styles: styles, style: style, basis: available);
  let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
  let (minimum, maximum) = width_limits(styles: styles, style: style, basis: available, frame: frame);
  let specified = specified_width(styles: styles, style: style, basis: available, frame: frame);
  let around = horizontal(edges: margins);
  let natural = if specified >= 0_i32 {
    give specified;
  } else {
    give available -sat around;
  }
  let clamped = clamp_size(size: natural, minimum: minimum, maximum: maximum);
  let width = imax(clamped, frame);
  let free = available -sat width;
  let either = bor(auto_left, auto_right);
  let fixed_test = specified >= 0_i32;
  let fixed = band(fixed_test, either);
  let limited = clamped != natural;
  let centring_pair = band(limited, either);
  let wanted = bor(fixed, centring_pair);
  let spare = free -sat around;
  let fits = spare >= 0_i32;
  let centring = band(wanted, fits);
  if centring {
    let room = free -sat around;
    if auto_left {
      if auto_right {
        let half = room / 2_i32;
        let left = margins.left +sat half;
        let right = free -sat left;
        return width, left, left, right;
      }
      let left = free -sat margins.right;
      return width, left, left, margins.right;
    }
    let right = free -sat margins.left;
    return width, margins.left, margins.left, right;
  }
  return width, margins.left, margins.left, margins.right;
}

fn auto_margin_offset(styles: &Styles, style: StyleRef, room: i32, child_width: i32, margin_left: i32, margin_right: i32) -> offset: i32 reads(styles) {
  doc "The offset of an in-flow child context's margin box from the left of the room it sits in (CSS 2.2 10.3.3): the child's left margin, plus, when it has an auto margin, what the width and the other margins leave: all of it for one auto margin, half for each of two. A child wider than the room keeps its left margin.";
  let (auto_left, auto_right, auto_top, auto_bottom) = margin_auto(styles: styles, style: style);
  let used = child_width +sat margin_left;
  let all = used +sat margin_right;
  let free_raw = room -sat all;
  let free = imax(free_raw, 0_i32);
  if auto_left {
    if auto_right {
      let half = free / 2_i32;
      let made = margin_left +sat half;
      return made;
    }
    let made = margin_left +sat free;
    return made;
  }
  return margin_left;
}

fn relative_offset(styles: &Styles, style: StyleRef, basis_width: i32, basis_height: i32) -> (dx: i32, dy: i32) reads(styles) {
  doc "The offset position: relative gives a box (CSS 2.2 9.4.3): left, or minus right when left is auto; top, or minus bottom when top is auto; zero for every other position.";
  let group = box_of(styles: styles, style: style);
  if group.position == position_relative {
  } else {
    return 0_i32, 0_i32;
  }
  let sizes = size_of(styles: styles, style: style);
  let left = inset_value(value: sizes.left, basis: basis_width);
  let right = inset_value(value: sizes.right, basis: basis_width);
  let top = inset_value(value: sizes.top, basis: basis_height);
  let bottom = inset_value(value: sizes.bottom, basis: basis_height);
  let left_known = sizes.left.kind == sizing_value;
  let right_known = sizes.right.kind == sizing_value;
  let top_known = sizes.top.kind == sizing_value;
  let bottom_known = sizes.bottom.kind == sizing_value;
  let dx = if left_known {
    give left;
  } else if right_known {
    give 0_i32 -sat right;
  } else {
    give 0_i32;
  }
  let dy = if top_known {
    give top;
  } else if bottom_known {
    give 0_i32 -sat bottom;
  } else {
    give 0_i32;
  }
  return dx, dy;
}

fn flow_index(at: u64) -> index: u32 pure {
  doc "A flow position as the u32 the records keep, no_index past its range.";
  if at < 4294967295_u64 {
    let made = cvt::<u64, u32>(at);
    return made;
  }
  return no_index;
}

fn height_relative(styles: &Styles, style: StyleRef) -> relative: Bool reads(styles) {
  doc "Tells whether style's height, min-height or max-height is a percentage, which its containing block's height resolves.";
  let sizes = size_of(styles: styles, style: style);
  let height_value = sizes.height.kind == sizing_value;
  let min_value = sizes.min_height.kind == sizing_value;
  let max_value = sizes.max_height.kind == sizing_value;
  let height_percent = band(height_value, sizes.height.value.has_percent);
  let min_percent = band(min_value, sizes.min_height.value.has_percent);
  let max_percent = band(max_value, sizes.max_height.value.has_percent);
  let limits = bor(min_percent, max_percent);
  let made = bor(height_percent, limits);
  return made;
}

fn equivalent_space(styles: &Styles, style: StyleRef, first: Space, second: Space) -> same: Bool reads(styles) {
  doc "Tells whether a context styled style lays out the same in the two spaces: they are equal field by field, but for the height percentage basis when its height, min-height and max-height are not percentages, which is the only thing that reads it.";
  let relative = height_relative(styles: styles, style: style);
  if relative {
    let made = same_space(first: first, second: second);
    return made;
  }
  let rebased = Space(available: second.available, basis_width: second.basis_width, basis_height: first.basis_height, forced_width: second.forced_width, forced_height: second.forced_height, shrink: second.shrink);
  let made = same_space(first: first, second: rebased);
  return made;
}

fn innermost_block(frames: &Box<Slots<Frame>>) -> block: u32 reads(frames) {
  doc "The block of the innermost open frame, or no_index when none is open.";
  let count = frames^.inner.len;
  if count == 0_u64 {
    return no_index;
  }
  let last = count - 1_u64;
  let found = frames^.inner[last].block;
  return found;
}

fn definite_block_height(styles: &Styles, style: StyleRef, basis_width: i32, basis_height: i32) -> height: i32 reads(styles) {
  doc "The content height established before laying out an ordinary block's contents, or unknown for an auto/content-dependent height. Resolve each percentage against its immediate containing block, then apply its own limits and box conversion in the full height resolver's order.";
  let computed = computed_of(styles: styles, style: style);
  let (height_sizing, minimum_sizing, maximum_sizing) = height_sizings(styles: styles, style: style, size: computed.size);
  let declared = size_value(value: height_sizing, basis: basis_height);
  if declared < 0_i32 {
    return unknown;
  }
  let border = border_edges(styles: styles, style: style);
  let padding = padding_edges(styles: styles, style: style, basis: basis_width);
  let border_height = vertical(edges: border);
  let padding_height = vertical(edges: padding);
  let frame = border_height +sat padding_height;
  let specified = specified_height(styles: styles, style: style, basis: basis_height, frame: frame);
  if specified < 0_i32 {
    return unknown;
  }
  let (minimum, maximum) = height_limits(styles: styles, style: style, basis: basis_height, frame: frame);
  let constrained = clamp_size(size: specified, minimum: minimum, maximum: maximum);
  let content = constrained -sat frame;
  let height = imax(content, 0_i32);
  return height;
}

fn containing_height(context: &Context, styles: &Styles, owner: u32, context_height: i32) -> height: i32 reads(context), reads(styles) {
  doc "Reads the immediate containing block's definite content height. Its retained basis was resolved at Open, so nested percentages keep every intermediate operation and an auto-height block breaks the chain.";
  if owner == no_index {
    return context_height;
  }
  let at = cvt::<u32, u64>(owner);
  if at < context^.blocks.inner.len {
    let block = block_snapshot(block: &context^.blocks.inner[at]);
    let basis = context^.blocks.inner[at].output.basis_height;
    let height = definite_block_height(styles: styles, style: block.style, basis_width: block.avail_width, basis_height: basis);
    return height;
  }
  return unknown;
}

fn prepare_spaces(context: &Context, events: &[Flow], styles: &Styles, content_width: i32, content_height: i32) -> result: unit reads(events), reads(styles), writes(context) {
  doc "The pre-pass of a flow context: walks its flow with the containing widths of the open block boxes, sets each block's width and left offset, each paragraph's width and left offset, and each child context's space: in-flow children fill their containing block, floats, out-of-flow boxes and atomic inlines shrink to fit.";
  refresh_context_height_proof(context: context, styles: styles);
  let frames = box_slots_new::<Frame>(capacity: 8_u64);
  let flow_count = events^.len;
  let left = 0_i32;
  let width = content_width;
  let height = content_height;
  let next_split = 0_u64;
  set context^.has_out = False();
  let free = True();
  for (k in 0_u64..flow_count) {
    let flow_bound_232 = events^.len;
    if k >= flow_bound_232 {
      break;
    }
    let item = events^[k];
    set next_split = place_splits(context: context, from: next_split, flow: k, left: left, width: width);
    let around = innermost_block(frames: &frames);
    let here = flow_index(at: k);
    match item {
      Open(block: b) => {
        let at = cvt::<u32, u64>(b);
        if at < context^.blocks.inner.len {
          set context^.blocks.inner[at].parent = around;
          set context^.blocks.inner[at].output.basis_height = height;
          set context^.blocks.inner[at].flow_at = here;
          let style = context^.blocks.inner[at].style;
          let relative = height_relative(styles: styles, style: style);
          let proof = absent_height_proof();
          if relative {
            let basis_input = fresh_containing_proof(context: context, styles: styles, owner: around, height: height);
            let retained = read_height_record(record: &context^.blocks.inner[at].height_proof);
            set proof = renewed_height_proof(retained: retained, styles: styles, style: style, input: basis_input, width: width, height: height, forced: unknown);
            store_height_record(record: &context^.blocks.inner[at].height_proof, proof: proof);
          } else {
            set context^.blocks.inner[at].height_proof = None<Box<HeightProof>>();
            set proof.content_height = definite_block_height(styles: styles, style: style, basis_width: width, basis_height: height);
          }
          let absolute_height = bnot(relative);
          set free = band(free, absolute_height);
          let (box_width, offset, margin_left, margin_right) = block_width(styles: styles, style: style, available: width);
          let x = left +sat offset;
          set context^.blocks.inner[at].resolved_x = x;
          set context^.blocks.inner[at].inner_x = x;
          set context^.blocks.inner[at].width = box_width;
          set context^.blocks.inner[at].avail_left = left;
          set context^.blocks.inner[at].avail_width = width;
          let border = border_edges(styles: styles, style: style);
          let padding = padding_edges(styles: styles, style: style, basis: width);
          let unknown_top = False();
          let saved = Frame(block: b, left: left, width: width, basis_height: height, top_frame: 0_i32, known: unknown_top, dx: 0_i32, dy: 0_i32, lines: unknown_top);
          let pushed = push_item::<Frame>(cell: &frames, value: saved, ceiling: item_ceiling);
          let inner_left = x +sat border.left;
          set left = inner_left +sat padding.left;
          let frame_border = horizontal(edges: border);
          let frame_padding = horizontal(edges: padding);
          let frame = frame_border +sat frame_padding;
          let inner = box_width -sat frame;
          set width = imax(inner, 0_i32);
          set context^.blocks.inner[at].content_left = left;
          set context^.blocks.inner[at].content_width = width;
          set height = proof.content_height;
        }
      }
      Close(..) => {
        let depth = frames.inner.len;
        if depth > 0_u64 {
          let last = depth - 1_u64;
          set left = frames.inner[last].left;
          set width = frames.inner[last].width;
          set height = frames.inner[last].basis_height;
          let removed = take_back(window: &frames.inner);
        }
      }
      Text(paragraph: p) => {
        let at = cvt::<u32, u64>(p);
        if at < context^.paragraphs.inner.len {
          set context^.paragraphs.inner[at].width = width;
          set context^.paragraphs.inner[at].left = left;
          set context^.paragraphs.inner[at].flow_at = here;
          set context^.paragraphs.inner[at].block = around;
          let marks = context^.paragraphs.inner[at].marks.inner.len;
          for (m in 0_u64..marks) {
            let mark = context^.paragraphs.inner[at].marks.inner[m];
            match mark {
              Atomic(context: child, ..) => {
                let child_at = cvt::<u32, u64>(child);
                if child_at < context^.children.inner.len {
                  let yes = True();
                  let basis_input = fresh_containing_proof(context: context, styles: styles, owner: around, height: height);
                  set_height_input(child: &context^.children.inner[child_at], proof: basis_input);
                  set context^.children.inner[child_at].space = child_space(available: width, basis_width: width, basis_height: height, shrink: yes);
                  set context^.children.inner[child_at].flow_at = here;
                  set context^.children.inner[child_at].block = around;
                  set context^.children.inner[child_at].placement_paragraph = p;
                  let relative = height_relative(styles: styles, style: context^.children.inner[child_at].style);
                  let independent = bnot(relative);
                  set free = band(free, independent);
                }
              }
              Open(..) => {
              }
              Close(..) => {
              }
              Node(..) => {
              }
            }
          }
        }
      }
      Child(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let no = False();
          let kind = context^.children.inner[at].kind;
          let table = kind == ctx_table;
          let replaced = kind == ctx_replaced;
          let fits = bor(table, replaced);
          let basis_input = fresh_containing_proof(context: context, styles: styles, owner: around, height: height);
          set_height_input(child: &context^.children.inner[at], proof: basis_input);
          set context^.children.inner[at].space = child_space(available: width, basis_width: width, basis_height: height, shrink: fits);
          set context^.children.inner[at].normal_x = left;
          set context^.children.inner[at].x = left;
          set context^.children.inner[at].flow_at = here;
          set context^.children.inner[at].block = around;
          set context^.children.inner[at].placement_paragraph = no_index;
          let child_relative = height_relative(styles: styles, style: context^.children.inner[at].style);
          let child_absolute = bnot(child_relative);
          set free = band(free, child_absolute);
        }
      }
      Float(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let yes = True();
          let basis_input = fresh_containing_proof(context: context, styles: styles, owner: around, height: height);
          set_height_input(child: &context^.children.inner[at], proof: basis_input);
          set context^.children.inner[at].space = child_space(available: width, basis_width: width, basis_height: height, shrink: yes);
          set context^.children.inner[at].normal_x = left;
          set context^.children.inner[at].x = left;
          set context^.children.inner[at].flow_at = here;
          set context^.children.inner[at].block = around;
          set context^.children.inner[at].placement_paragraph = no_index;
          let child_relative = height_relative(styles: styles, style: context^.children.inner[at].style);
          let child_absolute = bnot(child_relative);
          set free = band(free, child_absolute);
        }
      }
      Out(context: c) => {
        let at = cvt::<u32, u64>(c);
        if at < context^.children.inner.len {
          let yes = True();
          set context^.children.inner[at].space = child_space(available: content_width, basis_width: content_width, basis_height: content_height, shrink: yes);
          set context^.children.inner[at].normal_x = left;
          set context^.children.inner[at].x = left;
          set context^.children.inner[at].flow_at = here;
          set context^.children.inner[at].block = around;
          set context^.children.inner[at].placement_paragraph = no_index;
          let child_relative = height_relative(styles: styles, style: context^.children.inner[at].style);
          let child_absolute = bnot(child_relative);
          set free = band(free, child_absolute);
          set context^.has_out = True();
        }
      }
    }
  }
  set context^.definite_free = free;
  return unit;
}

fn lay_out_child(child: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, updating: Bool) -> counts: UpdateCounts reads(styles), reads(document), reads(fonts), reads(picks), writes(child) {
  doc "Lays out one child context in the space its parent wrote, then resolves its margins against its containing block's width. When its parent is being updated (updating, pkg::layout's update), a child marked for update is updated (update_child), an unmarked one whose space is the one it was last laid out in keeps that layout, and an unmarked flow context in another space is updated in it from its last layout; any other child is laid out in full. Returns what the update did below the child: the update's own counts, a kept child's none, and a child laid out in full during an update its whole tree (count_tree); a full layout counts nothing.";
  let boundary_work = no_boundary_visits();
  let nothing = no_updates();
  if child^.retired {
    return nothing;
  }
  if updating {
    let marked = child^.dirty;
    let same = equivalent_space(styles: styles, style: child^.style, first: child^.laid, second: child^.space);
    if same {
      let provenance_kept = keep_height_proof(context: child, styles: styles);
      set same = provenance_kept;
    }
    let flowing = child^.kind == ctx_flow;
    let unmarked = bnot(marked);
    let kept = band(same, unmarked);
    if kept {
      resolve_margins(child: child, styles: styles);
      return nothing;
    }
    let incremental = bor(marked, flowing);
    if incremental {
      let held = before_of(context: child);
      let counted = update_child(child: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, before: held);
      return counted;
    }
  }
  lay_out_context(context: child, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  resolve_margins(child: child, styles: styles);
  if updating {
    let (contexts, paragraphs) = count_tree(context: child);
    return UpdateCounts(prepared: 0_u64, work: boundary_work, contexts: contexts, paragraphs: paragraphs, held_entries: 0_u64, entries: 0_u64);
  }
  return nothing;
}

fn resolve_margins(child: &Context, styles: &Styles) -> result: unit reads(styles), writes(child) {
  doc "Resolves a child context's margins against its containing block's width, the basis of the space its parent wrote.";
  let basis = child^.space.basis_width;
  let margins = margin_edges(styles: styles, style: child^.style, basis: basis);
  set child^.margin_top = margins.top;
  set child^.margin_right = margins.right;
  set child^.margin_bottom = margins.bottom;
  set child^.margin_left = margins.left;
  return unit;
}

fn lay_out_children(context: &Context, styles: &Styles, document: &Document, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: unit reads(styles), reads(document), reads(fonts), reads(picks), writes(context) {
  doc "Lays out every child context, one per iteration of a counted loop, each iteration writing only its own child.";
  let count = context^.children.inner.len;
  let whole = False();
  for (i in 0_u64..count) {
    let counted = lay_out_child(child: &context^.children.inner[i], styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport, updating: whole);
  }
  return unit;
}

fn break_paragraph(paragraph: &Paragraph, children: &[Context], styles: &Styles, fonts: &FontSet, picks: &FontPicks, exclusions: &[Exclusion], origin_y: i32) -> result: unit reads(children), reads(styles), reads(fonts), reads(picks), reads(exclusions), writes(paragraph) {
  doc "Breaks a paragraph into lines at its width beside exclusions (none for the speculative pass) and computes its lines' metrics and fragments.";
  let width = paragraph^.width;
  let sizes = measure(paragraph: paragraph, children: children, styles: styles, basis: width);
  let origin_x = paragraph^.left;
  break_lines(paragraph: paragraph, sizes: &sizes, styles: styles, fonts: fonts, picks: picks, exclusions: exclusions, origin_x: origin_x, origin_y: origin_y, width: width);
  finish_lines(paragraph: paragraph, sizes: &sizes, children: children, styles: styles, fonts: fonts, picks: picks, basis: width);
  set paragraph^.broken_width = width;
  set paragraph^.broken_left = origin_x;
  return unit;
}

fn break_all(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(styles), reads(fonts), reads(picks), writes(context) {
  doc "The speculative pass (design/pipeline/layout.md): breaks every paragraph at its full width in one counted loop, each iteration writing only its own paragraph.";
  let count = context^.paragraphs.inner.len;
  let children = context^.children.inner.len;
  let none = box_slots_new::<Exclusion>(capacity: 0_u64);
  for (i in 0_u64..count) {
    break_paragraph(paragraph: &context^.paragraphs.inner[i], children: &context^.children.inner[0_u64..children], styles: styles, fonts: fonts, picks: picks, exclusions: &none.inner[0_u64..0_u64], origin_y: 0_i32);
  }
  return unit;
}

fn place_float(context: &Context, stack: &Stack, child: u64, side_left: Bool, containing_left: i32, containing_width: i32, content_left: i32, content_top: i32) -> result: unit writes(context), writes(stack) {
  doc "Places a laid-out float (CSS 2.2 9.5.1): at the flow's current position or the previous float's top, whichever is lower, moved down past floats until its margin box fits beside them, against the left or right edge of the space they leave, and records it as an exclusion.";
  if child < context^.children.inner.len {
  } else {
    return unit;
  }
  let style = context^.children.inner[child].style;
  let width = context^.children.inner[child].width;
  let height = context^.children.inner[child].height;
  let margin_left = context^.children.inner[child].margin_left;
  let margin_right = context^.children.inner[child].margin_right;
  let margin_top = context^.children.inner[child].margin_top;
  let margin_bottom = context^.children.inner[child].margin_bottom;
  let box_width = width +sat margin_left;
  let outer_width = box_width +sat margin_right;
  let box_height = height +sat margin_top;
  let outer_height = box_height +sat margin_bottom;
  let start_term = pending_margin(stack: stack);
  let start = stack^.cursor +sat start_term;
  let y = imax(start, stack^.float_floor);
  let count = stack^.floats.inner.len;
  let containing_right = containing_left +sat containing_width;
  let x = containing_left;
  for (attempt in 0_u64..count) {
    let bottom = y +sat outer_height;
    let (left_edge, right_edge) = exclusion_room(exclusions: &stack^.floats.inner[0_u64..count], top: y, bottom: bottom, width: containing_right);
    let left_limit = imax(left_edge, containing_left);
    let right_limit = imin(right_edge, containing_right);
    let room = right_limit -sat left_limit;
    if room >= outer_width {
      if side_left {
        set x = left_limit;
      } else {
        set x = right_limit -sat outer_width;
      }
      break;
    }
    let next = lowest_bottom_above(exclusions: &stack^.floats.inner[0_u64..count], top: y);
    if next <= y {
      if side_left {
        set x = left_limit;
      } else {
        set x = right_limit -sat outer_width;
      }
      break;
    }
    set y = next;
  }
  if count == 0_u64 {
    if side_left {
      set x = containing_left;
    } else {
      set x = containing_right -sat outer_width;
    }
  }
  let x_box = x +sat margin_left;
  let y_box = y +sat margin_top;
  set context^.children.inner[child].normal_x = content_left +sat x_box;
  set context^.children.inner[child].x = content_left +sat x_box;
  set context^.children.inner[child].normal_y = content_top +sat y_box;
  set context^.children.inner[child].y = content_top +sat y_box;
  let edge = if side_left {
    give x +sat outer_width;
  } else {
    give x;
  }
  let bottom = y +sat outer_height;
  let made = Exclusion(left: side_left, top: y, bottom: bottom, edge: edge);
  let pushed = push_item::<Exclusion>(cell: &stack^.floats, value: made, ceiling: item_ceiling);
  set stack^.float_floor = imax(stack^.float_floor, y);
  set stack^.reach = imax(stack^.reach, bottom);
  return unit;
}

fn lowest_bottom_above(exclusions: &[Exclusion], top: i32) -> bottom: i32 reads(exclusions) {
  doc "The smallest float bottom below top, where the space beside the floats next changes, or top when none is.";
  let best = 2147483647_i32;
