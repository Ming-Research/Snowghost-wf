fn natural_size(natural: u8) -> (width: i32, height: i32) pure {
  doc "The natural size of a replaced box the stage does not load: 16 by 16 px for the broken-image icon, nothing for an empty img, and otherwise 300 by 150 px, as CSS 2.2 10.3.2 falls back to.";
  let icon = natural == natural_icon;
  let alt_icon = natural == natural_alt_icon;
  let either = bor(icon, alt_icon);
  if either {
    return 1024_i32, 1024_i32;
  }
  if natural == natural_empty {
    return 0_i32, 0_i32;
  }
  if natural == natural_toggle {
    return 832_i32, 832_i32;
  }
  return 19200_i32, 9600_i32;
}

fn replaced_size(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> (width: i32, height: i32) reads(context), reads(styles), reads(fonts), reads(picks) {
  doc "The natural content size of a replaced box: natural_size's, or for a text input, as the reference sizes one of the default twenty characters, about 13.27 times its font size wide and its line tall.";
  if context^.natural == natural_text_input {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: context^.style);
    let size = cvt::<i32, i64>(metrics.font_size);
    let scaled = size *sat 1327_i64;
    let wide = scaled / 100_i64;
    let bounded_low = imax(wide, 0_i64);
    let bounded = imin(bounded_low, 2147483647_i64);
    let width = cvt::<i64, i32>(bounded);
    let height = metrics.ascent +sat metrics.descent;
    return width, height;
  }
  let (width, height) = natural_size(natural: context^.natural);
  return width, height;
}

fn marker_width(metrics: Metrics) -> width: i32 pure {
  doc "The advance of an inside bullet marker of a font with metrics, as the reference sizes it: a symbol (a third of the rounded ascent, plus one, halved, plus 2 px), a -1 px start margin and an end margin of the font size.";
  let ascent_px = metrics.content_ascent / 64_i32;
  let doubled = ascent_px *sat 2_i32;
  let two_thirds = doubled / 3_i32;
  let raised = two_thirds +sat 1_i32;
  let half = raised / 2_i32;
  let bullet_px = half +sat 2_i32;
  let bullet = bullet_px *sat 64_i32;
  let outer = bullet +sat metrics.font_size;
  let made = outer -sat 64_i32;
  return made;
}

fn intrinsic_replaced(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> (minimum: i32, maximum: i32) reads(context), reads(styles), reads(fonts), reads(picks) {
  doc "A replaced box's content width is its natural width; an inside bullet marker's is its advance.";
  if context^.natural == natural_marker {
    let metrics = box_metrics(styles: styles, fonts: fonts, picks: picks, style: context^.style);
    let wide = marker_width(metrics: metrics);
    return wide, wide;
  }
  let (width, height) = replaced_size(context: context, styles: styles, fonts: fonts, picks: picks);
  return width, width;
}

fn lay_out_replaced(context: &Context, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(styles), reads(fonts), reads(picks), writes(context) {
  doc "Lays out a replaced box at its given size, or its natural size, keeping the natural ratio when only one dimension is given; the ratio of an img, video or svg element is that of its width and height attributes when it has both, and a replaced box without one takes the natural size on an axis that is auto (research/investigations/layout/runs/replaced-ratio.txt). The icon before an img's alt text sits on the text's bottom, as the reference draws it: its baseline lies the font's descent above its bottom. An inside bullet marker takes its advance and its font's content area. A block-level img showing the broken-image icon or nothing fills its line, as the reference draws it. A text input's baseline is its line's, centred in its content box.";
