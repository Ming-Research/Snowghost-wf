const unlisted: u32 = 4294967295_u32;

const roman_values: Array<u64, 13> =[1000_u64, 900_u64, 500_u64, 400_u64, 100_u64, 90_u64, 50_u64, 40_u64, 10_u64, 9_u64, 5_u64, 4_u64, 1_u64];

const roman_firsts: Array<u32, 13> =[109_u32, 99_u32, 100_u32, 99_u32, 99_u32, 120_u32, 108_u32, 120_u32, 120_u32, 105_u32, 118_u32, 105_u32, 105_u32];

const roman_seconds: Array<u32, 13> =[0_u32, 109_u32, 0_u32, 100_u32, 0_u32, 99_u32, 0_u32, 108_u32, 0_u32, 120_u32, 0_u32, 118_u32, 0_u32];

const list_item_word: Array<u8, 9> = "list-item";

const lower_roman_word: Array<u8, 11> = "lower-roman";

const upper_roman_word: Array<u8, 11> = "upper-roman";

