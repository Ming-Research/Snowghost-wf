const zero_width_space: u32 = 8203_u32;

const kind_body: u8 = 0_u8;

const kind_header: u8 = 1_u8;

const kind_footer: u8 = 2_u8;

struct Open {
  doc "The paragraph a flow context's walk is filling: its first piece in the context's pieces, a bound on its scalar values, the block container whose anonymous block it is, the inline boxes open around the walk (their Begin pieces emitted into this paragraph up to emitted).";
  first: u64;
  size: u64;
  style: StyleRef;
  inlines: Box<Slots<StyleRef>>;
  emitted: u64;
}

struct Counter {
  doc "One counter instance of the walk: its name's atom index, its value, and the depth of the element whose children and following siblings it is in scope for.";
  name: u32;
  value: i32;
  level: u64;
}

struct Walk {
  doc "The state the walk in tree order carries: each node's element index (unlisted for a node that is no element of the traversal), the counter instances in scope, the quote depth and the element depth.";
  order: Box<Array<u32>>;
  counters: Box<Slots<Counter>>;
  quote_depth: i32;
  depth: u64;
  list_item: u32;
}

fn refuse<T: drop>(failure: LayoutError) -> result: Result<T, LayoutError> pure {
  doc "Returns failure as a refusal.";
  return Err<T, LayoutError>(error: failure);
}

fn inconsistent<T: drop>() -> result: Result<T, LayoutError> pure {
  doc "Returns the Inconsistent refusal.";
  let failure = LayoutError::Inconsistent();
  return Err<T, LayoutError>(error: failure);
}

fn too_large<T: drop>() -> result: Result<T, LayoutError> pure {
  doc "Returns the TooLarge refusal.";
  let failure = LayoutError::TooLarge();
  return Err<T, LayoutError>(error: failure);
}

fn push_item<T: drop>(cell: &Box<Slots<T>>, value: T, ceiling: u64) -> pushed: Bool writes(cell) contract {
  requires ceiling <= 1073741824_u64;
} {
  doc "Appends value, doubling a full window (an empty one takes four slots) within ceiling; False, dropping value, when the window already holds ceiling items.";
  let length = cell^.inner.len;
  if length >= ceiling {
    return False();
  }
  let capacity = cell^.inner.cap;
  if length >= capacity {
    invariant below_ceiling: length < ceiling;
    invariant full: capacity <= length;
    let room = ceiling - capacity;
    if capacity < room {
      if capacity == 0_u64 {
        grow(cell: cell, capacity: 4_u64);
      } else {
        let doubled = capacity + capacity;
        grow(cell: cell, capacity: doubled);
      }
    } else {
      grow(cell: cell, capacity: ceiling);
    }
  }
  place_back(window: &cell^.inner, value: move value);
  return True();
}

fn push_or_fail<T: drop>(cell: &Box<Slots<T>>, value: T) -> result: Result<unit, LayoutError> writes(cell) {
  doc "Appends value within item_ceiling; TooLarge past it.";
  let pushed = push_item::<T>(cell: cell, value: move value, ceiling: item_ceiling);
  if pushed {
    return Ok<unit, LayoutError>(value: unit);
  }
  return too_large::<unit>();
}

fn element_ref(element: u32) -> made: StyleRef pure {
  doc "The style of the element at index element.";
  let no = False();
  return StyleRef(element: element, pseudo: no_pseudo, anonymous: no);
}

fn anonymous_of(style: StyleRef) -> made: StyleRef pure {
  doc "The style of an anonymous box inside the box styled style.";
  let yes = True();
  return StyleRef(element: style.element, pseudo: style.pseudo, anonymous: yes);
}

fn new_context(kind: u8, style: StyleRef) -> made: Context pure {
  doc "A context of kind and style that holds nothing and has not been laid out.";
  let flow = box_slots_new::<Flow>(capacity: 0_u64);
  let pieces = box_slots_new::<Piece>(capacity: 0_u64);
  let blocks = box_slots_new::<Block>(capacity: 0_u64);
  let paragraphs = box_slots_new::<Paragraph>(capacity: 0_u64);
  let children = box_slots_new::<Context>(capacity: 0_u64);
  let rows = box_slots_new::<TableRow>(capacity: 0_u64);
  let columns = box_slots_new::<TableColumn>(capacity: 0_u64);
  let cells = box_slots_new::<TableCell>(capacity: 0_u64);
  let captions = box_slots_new::<u32>(capacity: 0_u64);
  let fragments = box_slots_new::<Fragment>(capacity: 0_u64);
  let splits = box_slots_new::<Split>(capacity: 0_u64);
  let column_map = box_slots_new::<ColumnPiece>(capacity: 0_u64);
  let no = False();
  let space = Space(available: 0_i32, basis_width: 0_i32, basis_height: -1_i32, forced_width: -1_i32, forced_height: -1_i32, shrink: no);
  return Context(kind: kind, natural: natural_object, style: style, flow: move flow, pieces: move pieces, blocks: move blocks, paragraphs: move paragraphs, children: move children, rows: move rows, columns: move columns, cells: move cells, captions: move captions, fragments: move fragments, splits: move splits, column_map: move column_map, space: space, margin_top: 0_i32, margin_right: 0_i32, margin_bottom: 0_i32, margin_left: 0_i32, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32, baseline: 0_i32, has_baseline: no, viewport_origin: no, min_content: 0_i32, max_content: 0_i32, intrinsic_known: no, ratio_width: 0_i32, ratio_height: 0_i32);
}

fn new_open(style: StyleRef, first: u64) -> made: Open pure {
  doc "An empty open paragraph of the block container style, starting at piece first.";
  let inlines = box_slots_new::<StyleRef>(capacity: 0_u64);
  return Open(first: first, size: 0_u64, style: style, inlines: move inlines, emitted: 0_u64);
}

fn new_paragraph(style: StyleRef, first: u64, count: u64, reserve: u64) -> made: Paragraph pure contract {
  requires reserve <= 1073741824_u64;
} {
  doc "A paragraph of the block container style over count pieces from first, its text reserved at reserve scalar values.";
  let text = box_slots_new::<u32>(capacity: reserve);
  let runs = box_slots_new::<TextRun>(capacity: 0_u64);
  let run_styles = box_slots_new::<StyleRef>(capacity: 0_u64);
  let marks = box_slots_new::<Mark>(capacity: 0_u64);
  let shaped = shaped_empty();
  let lines = box_slots_new::<Line>(capacity: 0_u64);
  let fragments = box_slots_new::<Fragment>(capacity: 0_u64);
  let atomics = box_slots_new::<Atomic>(capacity: 0_u64);
  return Paragraph(style: style, first: first, count: count, text: move text, runs: move runs, run_styles: move run_styles, marks: move marks, shaped: move shaped, lines: move lines, fragments: move fragments, atomics: move atomics, width: 0_i32, left: 0_i32, top: 0_i32, height: 0_i32, min_content: 0_i32, max_content: 0_i32);
}

fn emit_begins(context: &Context, open: &Open) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Emits the Begin pieces of the inline boxes open around the open paragraph's next piece that this paragraph has not begun.";
  let open_count = open^.inlines.inner.len;
  let begun = open^.emitted;
  if begun < open_count {
    for (k in begun..open_count) {
      let style = open^.inlines.inner[k];
      let begin = Piece::Begin(style: style);
      let step = propagate push_or_fail::<Piece>(cell: &context^.pieces, value: begin);
    }
    set open^.emitted = open_count;
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn add_piece(context: &Context, open: &Open, piece: Piece, size: u64) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Appends piece, standing for at most size scalar values, to the open paragraph, first emitting the Begin pieces of the inline boxes open around it that this paragraph has not begun; TooLarge past scalar_ceiling.";
  let begun = propagate emit_begins(context: context, open: open);
  let big = size > scalar_ceiling;
  if big {
    return too_large::<unit>();
  }
  let total = open^.size +sat size;
  if total > scalar_ceiling {
    return too_large::<unit>();
  }
  let step = propagate push_or_fail::<Piece>(cell: &context^.pieces, value: piece);
  set open^.size = total;
  return Ok<unit, LayoutError>(value: unit);
}

fn end_paragraph(context: &Context, open: &Open) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Closes the inline boxes this paragraph began, moves the open paragraph into context's paragraphs and flow when it holds a piece, and starts an empty one after its pieces, whose inline boxes are begun again when content arrives.";
  let begun = open^.emitted;
  let open_count = open^.inlines.inner.len;
  let closing = imin(begun, open_count);
  for (step in 0_u64..closing) {
    let k_top = closing - 1_u64;
    let k = k_top - step;
    let inside = k < open^.inlines.inner.len;
    if inside {
      let style = open^.inlines.inner[k];
      let end = Piece::End(style: style);
      let pushed = propagate push_or_fail::<Piece>(cell: &context^.pieces, value: end);
    }
  }
  set open^.emitted = 0_u64;
  let recorded = context^.pieces.inner.len;
  let first = open^.first;
  if first < recorded {
  } else {
    set open^.first = recorded;
    set open^.size = 0_u64;
    return Ok<unit, LayoutError>(value: unit);
  }
  let count = recorded - first;
  let reserve = open^.size;
  if reserve > scalar_ceiling {
    return too_large::<unit>();
  }
  let index = context^.paragraphs.inner.len;
  let paragraph = new_paragraph(style: open^.style, first: first, count: count, reserve: reserve);
  let kept = propagate push_or_fail::<Paragraph>(cell: &context^.paragraphs, value: move paragraph);
  let small = index < 4294967295_u64;
  if small {
  } else {
    return too_large::<unit>();
  }
  let at = cvt::<u64, u32>(index);
  let item = Flow::Text(paragraph: at);
  let listed = propagate push_or_fail::<Flow>(cell: &context^.flow, value: item);
  set open^.first = recorded;
  set open^.size = 0_u64;
  return Ok<unit, LayoutError>(value: unit);
}

fn begin_inline(context: &Context, open: &Open, style: StyleRef) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Opens the inline box styled style: its Begin piece goes into the open paragraph at once, so an empty inline box still bounds a position.";
  let pushed = propagate push_or_fail::<StyleRef>(cell: &open^.inlines, value: style);
  let begun = propagate emit_begins(context: context, open: open);
  return Ok<unit, LayoutError>(value: unit);
}

fn end_inline(context: &Context, open: &Open) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Closes the innermost open inline box: its End piece goes into the open paragraph when this paragraph began it.";
  let open_count = open^.inlines.inner.len;
  if open_count == 0_u64 {
    return inconsistent::<unit>();
  }
  let last = open_count - 1_u64;
  let style = open^.inlines.inner[last];
  if open^.emitted >= open_count {
    let end = Piece::End(style: style);
    let pushed = propagate push_or_fail::<Piece>(cell: &context^.pieces, value: end);
    set open^.emitted = last;
  }
  let removed = take_back(window: &open^.inlines.inner);
  return Ok<unit, LayoutError>(value: unit);
}

fn current_style(open: &Open) -> style: StyleRef reads(open) {
  doc "The style of the innermost box open around the walk: the innermost inline box, or the block container.";
  let count = open^.inlines.inner.len;
  if count > 0_u64 {
    let last = count - 1_u64;
    let found = open^.inlines.inner[last];
    return found;
  }
  let block = open^.style;
  return block;
}

fn add_scalar_piece(context: &Context, open: &Open, value: u32, style: StyleRef) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Adds one inserted scalar value to the open paragraph.";
  let piece = Piece::Scalar(value: value, style: style);
  let added = propagate add_piece(context: context, open: open, piece: piece, size: 1_u64);
  return Ok<unit, LayoutError>(value: unit);
}

fn add_object(context: &Context, open: &Open, child: Context) -> result: Result<unit, LayoutError> writes(context), writes(open) {
  doc "Adds child as an atomic inline of the open paragraph: a child context and a U+FFFC that stands for it, in the style of the box around it.";
  let style = current_style(open: open);
  let index = context^.children.inner.len;
  let small = index < 4294967295_u64;
  if small {
  } else {
    return too_large::<unit>();
  }
  let kept = propagate push_or_fail::<Context>(cell: &context^.children, value: move child);
  let at = cvt::<u64, u32>(index);
  let piece = Piece::Object(context: at, style: style);
  let added = propagate add_piece(context: context, open: open, piece: piece, size: 1_u64);
  return Ok<unit, LayoutError>(value: unit);
}

fn stash_inlines(open: &Open) -> saved: Box<Slots<StyleRef>> writes(open) {
  doc "Takes the inline boxes open around a block-level box that interrupts them, so the block's own paragraphs do not begin them; restore_inlines gives them back after it.";
  let count = open^.inlines.inner.len;
  let reserve = imin(count, 4096_u64);
  let saved = box_slots_new::<StyleRef>(capacity: reserve);
  for (k in 0_u64..count) {
    let style = open^.inlines.inner[k];
    let pushed = push_item::<StyleRef>(cell: &saved, value: style, ceiling: 4096_u64);
  }
  for (step in 0_u64..count) {
    let length = open^.inlines.inner.len;
    if length == 0_u64 {
      break;
    }
    let removed = take_back(window: &open^.inlines.inner);
  }
  set open^.emitted = 0_u64;
  return move saved;
}

fn restore_inlines(open: &Open, saved: &Box<Slots<StyleRef>>) -> result: unit reads(saved), writes(open) {
  doc "Reopens the inline boxes stash_inlines took, to be begun again when content arrives.";
  let count = saved^.inner.len;
  for (k in 0_u64..count) {
    let style = saved^.inner[k];
    let pushed = push_item::<StyleRef>(cell: &open^.inlines, value: style, ceiling: 4096_u64);
  }
  set open^.emitted = 0_u64;
  return unit;
}

fn open_splits(context: &Context, saved: &Box<Slots<StyleRef>>, flow_open: u64) -> first: u64 reads(saved), writes(context) {
  doc "Records a block-in-inline for each element's inline box in saved around the block whose flow entry opens at flow_open, and returns the index of the first record, for close_splits.";
  let first = context^.splits.inner.len;
  let small = flow_open < 4294967295_u64;
  if small {
  } else {
    return first;
  }
  let at = cvt::<u64, u32>(flow_open);
  let count = saved^.inner.len;
  for (k in 0_u64..count) {
    let style = saved^.inner[k];
    let named = bnot(style.anonymous);
    let own = style.pseudo == no_pseudo;
    let shown = band(named, own);
    if shown {
      let made = Split(owner: style.element, open: at, close: at, left: 0_i32, width: 0_i32, line: 0_i32);
      let pushed = push_item::<Split>(cell: &context^.splits, value: made, ceiling: item_ceiling);
    }
  }
  return first;
}

fn close_splits(context: &Context, first: u64, end: u64, flow_close: u64) -> result: unit writes(context) {
  doc "Gives the block-in-inline records from first to end, which open_splits made for one block, the flow entry flow_close that closes the block.";
  let small = flow_close < 4294967295_u64;
  if small {
  } else {
    return unit;
  }
  let at = cvt::<u64, u32>(flow_close);
  for (k in first..end) {
    if k < context^.splits.inner.len {
      set context^.splits.inner[k].close = at;
    }
  }
  return unit;
}

fn add_child_flow(context: &Context, child: Context, kind: u8) -> result: Result<unit, LayoutError> writes(context) {
  doc "Adds child as a child context with a flow entry: 0 in flow, 1 floated, 2 out of flow.";
  let index = context^.children.inner.len;
  let small = index < 4294967295_u64;
  if small {
  } else {
    return too_large::<unit>();
  }
  let kept = propagate push_or_fail::<Context>(cell: &context^.children, value: move child);
  let at = cvt::<u64, u32>(index);
  let item = if kind == 0_u8 {
    give Flow::Child(context: at);
  } else if kind == 1_u8 {
    give Flow::Float(context: at);
  } else {
    give Flow::Out(context: at);
  }
  let listed = propagate push_or_fail::<Flow>(cell: &context^.flow, value: item);
  return Ok<unit, LayoutError>(value: unit);
}

fn pseudo_index(styles: &Styles, element: u32, kind: u8) -> pseudo: u32 reads(styles) {
  doc "Returns the index in the style stage's pseudo-element list, sorted by element and kind, of element's ::before (kind pseudo_before) or ::after, or no_pseudo when it has none, by binary search.";
  let count = styles^.pseudos.inner.len;
  let low = 0_u64;
  let high = count;
  for (step in 0_u64..64_u64) {
    if low >= high {
      return no_pseudo;
    }
    let span = high - low;
    let half = span / 2_u64;
    let middle = low + half;
    if middle < count {
      let listed_entry = styles^.pseudos.inner[middle];
      let before_element = listed_entry.element < element;
      let same_element = listed_entry.element == element;
      let before_kind = listed_entry.kind < kind;
      let earlier_kind = band(same_element, before_kind);
      let earlier = bor(before_element, earlier_kind);
      let same_kind = listed_entry.kind == kind;
      let found = band(same_element, same_kind);
      if found {
        let small = middle < 4294967295_u64;
        if small {
          let made = cvt::<u64, u32>(middle);
          return made;
        }
        return no_pseudo;
      }
      if earlier {
        set low = middle +sat 1_u64;
      } else {
        set high = middle;
      }
    } else {
      return no_pseudo;
    }
  }
  return no_pseudo;
}

fn pseudo_ref(element: u32, pseudo: u32) -> made: StyleRef pure {
  doc "The style of element's pseudo-element at index pseudo of the style stage's list.";
  let no = False();
  return StyleRef(element: element, pseudo: pseudo, anonymous: no);
}

fn find_counter(walk: &Walk, name: u32) -> found: Option<u64> reads(walk) {
  doc "Returns the position of the innermost counter instance named name in scope, or None.";
  let count = walk^.counters.inner.len;
  for (step in 0_u64..count) {
    let k_top = count - 1_u64;
    let k = k_top - step;
    if k < walk^.counters.inner.len {
      if walk^.counters.inner[k].name == name {
        return Some<u64>(value: k);
      }
    }
  }
  return None<u64>();
}

fn new_counter(walk: &Walk, name: u32, value: i32) -> result: Result<unit, LayoutError> writes(walk) {
  doc "Instantiates a counter named name with value, in scope for the current element, its descendants and its following siblings.";
  let parent_level = walk^.depth -sat 1_u64;
  let made = Counter(name: name, value: value, level: parent_level);
  let pushed = propagate push_or_fail::<Counter>(cell: &walk^.counters, value: made);
  return Ok<unit, LayoutError>(value: unit);
}

fn reset_list(document: &Document, walk: &Walk, node: NodeId) -> result: Result<unit, LayoutError> reads(document), writes(walk) {
  doc "Instantiates the list-item counter for an ol, ul or menu element, as the reference resets it implicitly for lists (CSS Lists 3, 4.6): at the ol's start attribute less one, otherwise 0.";
  let (name, html, svg) = local_name_of(document: document, node: node);
  if html {
  } else {
    return Ok<unit, LayoutError>(value: unit);
  }
  let ordered = name == atom_ol;
  let unordered = name == atom_ul;
  let menu = name == atom_menu;
  let plain = bor(unordered, menu);
  let listing = bor(ordered, plain);
  let named = walk^.list_item != unlisted;
  let resets = band(listing, named);
  if resets {
  } else {
    return Ok<unit, LayoutError>(value: unit);
  }
  let start = if ordered {
    give span_attribute(document: document, node: node, name: atom_start, fallback: 1_u32, least: 0_u32, most: 2147483647_u32);
  } else {
    give 1_u32;
  }
  let bounded = imin(start, 2147483647_u32);
  let first = cvt::<u32, i32>(bounded);
  let value = first -sat 1_i32;
  let name_atom = walk^.list_item;
  let made = propagate new_counter(walk: walk, name: name_atom, value: value);
  return Ok<unit, LayoutError>(value: unit);
}

fn apply_counters(styles: &Styles, walk: &Walk, style: StyleRef, list_item: Bool) -> result: Result<unit, LayoutError> reads(styles), writes(walk) {
  doc "Applies style's counter-reset, then counter-set, then counter-increment, as CSS Lists 3 orders them, instantiating a counter that is set or incremented without an instance in scope; a list item also increments list-item.";
  let group = content_of(styles: styles, style: style);
  let reset = cvt::<u32, u64>(group.counter_reset);
  if reset < styles^.counter_lists.inner.len {
    let list = styles^.counter_lists.inner[reset];
    let low = cvt::<u32, u64>(list.first);
    let high = cvt::<u32, u64>(list.end);
    for (k in low..high) {
      if k < styles^.counter_changes.inner.len {
        let change = styles^.counter_changes.inner[k];
        let made = propagate new_counter(walk: walk, name: change.name.index, value: change.value);
      }
    }
  }
  let assign = cvt::<u32, u64>(group.counter_set);
  if assign < styles^.counter_lists.inner.len {
    let list = styles^.counter_lists.inner[assign];
    let low = cvt::<u32, u64>(list.first);
    let high = cvt::<u32, u64>(list.end);
    for (k in low..high) {
      if k < styles^.counter_changes.inner.len {
        let change = styles^.counter_changes.inner[k];
        let found = find_counter(walk: walk, name: change.name.index);
        match found {
          Some(value: at) => {
            if at < walk^.counters.inner.len {
              set walk^.counters.inner[at].value = change.value;
            }
          }
          None() => {
            let made = propagate new_counter(walk: walk, name: change.name.index, value: change.value);
          }
        }
      }
    }
  }
  let increment = cvt::<u32, u64>(group.counter_increment);
  if increment < styles^.counter_lists.inner.len {
    let list = styles^.counter_lists.inner[increment];
    let low = cvt::<u32, u64>(list.first);
    let high = cvt::<u32, u64>(list.end);
    for (k in low..high) {
      if k < styles^.counter_changes.inner.len {
        let change = styles^.counter_changes.inner[k];
        let bumped = propagate bump_counter(walk: walk, name: change.name.index, by: change.value);
      }
    }
  }
  let named = walk^.list_item != unlisted;
  let counted = band(list_item, named);
  if counted {
    let name = walk^.list_item;
    let bumped = propagate bump_counter(walk: walk, name: name, by: 1_i32);
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn bump_counter(walk: &Walk, name: u32, by: i32) -> result: Result<unit, LayoutError> writes(walk) {
  doc "Adds by to the innermost counter named name, instantiating it at zero first when none is in scope.";
  let found = find_counter(walk: walk, name: name);
  match found {
    Some(value: at) => {
      if at < walk^.counters.inner.len {
        let old = walk^.counters.inner[at].value;
        set walk^.counters.inner[at].value = old +sat by;
      }
    }
    None() => {
      let made = propagate new_counter(walk: walk, name: name, value: by);
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn leave_scope(walk: &Walk) -> result: unit writes(walk) {
  doc "Ends the scope of the counters the current element's children instantiated, as the walk leaves the element.";
  let level = walk^.depth;
  let count = walk^.counters.inner.len;
  for (step in 0_u64..count) {
    let length = walk^.counters.inner.len;
    if length == 0_u64 {
      return unit;
    }
    let last = length - 1_u64;
    let inside = walk^.counters.inner[last].level >= level;
    if inside {
      let dropped = take_back(window: &walk^.counters.inner);
    } else {
      return unit;
    }
  }
  return unit;
}

fn atom_is(atoms: &AtomTable, atom: u32, word: &[u8]) -> same: Bool reads(atoms), reads(word) {
  doc "Tells whether the atom at index atom spells word exactly.";
  let at = cvt::<u32, u64>(atom);
  if at < atoms^.spans.inner.len {
    let span = atoms^.spans.inner[at];
    let start = cvt::<u32, u64>(span.start);
    let end = cvt::<u32, u64>(span.end);
    let ordered = start <= end;
    let inside = end <= atoms^.text.inner.len;
    let usable = band(ordered, inside);
    if usable {
      let length = end - start;
      if length != word^.len {
        return False();
      }
      for (k in 0_u64..length) {
        let position = start + k;
        if position < atoms^.text.inner.len {
          if atoms^.text.inner[position] != word^[k] {
            return False();
          }
        }
      }
      return True();
    }
  }
  return False();
}

fn attribute_of(document: &Document, node: NodeId, name: u32) -> value: Option<TextSpan> reads(document) {
  doc "The value of node's first attribute in no namespace whose name is the atom index name, or None.";
  let index = cvt::<u32, u64>(node.index);
  let count = document^.nodes.inner.len;
  if index < count {
  } else {
    return None<TextSpan>();
  }
  let data = &document^.nodes.inner[index].data;
  match data^ {
    Element(namespace: space, local_name: local, attributes: attrs, template_contents: held) => {
      let total = attrs^.inner.len;
      for (k in 0_u64..total) {
        let attribute = attrs^.inner[k];
        let plain = match attribute.namespace {
          NoNamespace() => {
            give True();
          }
          XLink() => {
            give False();
          }
          Xml() => {
            give False();
          }
          XmlNs() => {
            give False();
          }
        }
        let named = attribute.name.index == name;
        let both = band(plain, named);
        if both {
          return Some<TextSpan>(value: attribute.value);
        }
      }
    }
    DocumentRoot(..) => {
    }
    DocumentType(..) => {
    }
    Text(..) => {
    }
    Comment(..) => {
    }
    Fragment() => {
    }
  }
  return None<TextSpan>();
}

fn push_digits(out: &Box<Slots<u32>>, value: u64, width: u64) -> result: unit writes(out) {
  doc "Appends value in decimal digits, padded with zeros to width digits.";
  let digits = box_array_filled::<u32>(count: 20_u64, value: 48_u32);
  let count = 0_u64;
  let rest = value;
  for (k in 0_u64..20_u64) {
    let digit = rest % 10_u64;
    let small = cvt::<u64, u32>(digit);
    set digits.inner[k] = 48_u32 + small;
    set count = k +sat 1_u64;
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break;
    }
  }
  let shown = imax(count, width);
  let bounded = imin(shown, 20_u64);
  for (step in 0_u64..bounded) {
    let k_top = bounded - 1_u64;
    let k = k_top - step;
    if k < 20_u64 {
      let scalar = digits.inner[k];
      let pushed = push_item::<u32>(cell: out, value: scalar, ceiling: 64_u64);
    }
  }
  return unit;
}

fn push_roman(out: &Box<Slots<u32>>, value: u64, upper: Bool) -> result: unit writes(out) {
  doc "Appends value, 1 to 3999, in roman numerals, lower or upper case.";
  let rest = value;
  for (k in 0_u64..13_u64) {
    let size = roman_values[k];
    for (repeat in 0_u64..4_u64) {
      if rest >= size {
        set rest = rest - size;
        let lower = roman_firsts[k];
        let first = if upper {
          give lower -sat 32_u32;
        } else {
          give lower;
        }
        let pushed = push_item::<u32>(cell: out, value: first, ceiling: 64_u64);
        let second_raw = roman_seconds[k];
        if second_raw != 0_u32 {
          let second = if upper {
            give second_raw -sat 32_u32;
          } else {
            give second_raw;
          }
          let pushed_second = push_item::<u32>(cell: out, value: second, ceiling: 64_u64);
        }
      } else {
        break;
      }
    }
  }
  return unit;
}

fn push_alpha(out: &Box<Slots<u32>>, value: u64, upper: Bool) -> result: unit writes(out) {
  doc "Appends value, from 1, in the alphabetic counter style: a to z, then aa and on.";
  let letters = box_array_filled::<u32>(count: 16_u64, value: 97_u32);
  let count = 0_u64;
  let rest = value;
  for (k in 0_u64..16_u64) {
    if rest == 0_u64 {
      break;
    }
    let lowered = rest - 1_u64;
    let digit = lowered % 26_u64;
    let small = cvt::<u64, u32>(digit);
    let base = if upper {
      give 65_u32;
    } else {
      give 97_u32;
    }
    set letters.inner[k] = base + small;
    set count = k +sat 1_u64;
    set rest = lowered / 26_u64;
  }
  for (step in 0_u64..count) {
    let k_top = count - 1_u64;
    let k = k_top - step;
    if k < 16_u64 {
      let scalar = letters.inner[k];
      let pushed = push_item::<u32>(cell: out, value: scalar, ceiling: 64_u64);
    }
  }
  return unit;
}

fn format_counter(atoms: &AtomTable, value: i32, style: u32, out: &Box<Slots<u32>>) -> result: unit reads(atoms), writes(out) {
  doc "Appends value in the counter style named by the atom style: decimal (also for an unknown style), decimal-leading-zero, lower- and upper-roman within 1 to 3999, lower- and upper-alpha or -latin from 1, disc, circle and square bullets, or nothing for none; out of a style's range, decimal.";
  let negative = value < 0_i32;
  let wide = cvt::<i32, i64>(value);
  let magnitude_signed = if negative {
    give 0_i64 - wide;
  } else {
    give wide;
  }
  let magnitude = if magnitude_signed >= 0_i64 {
    give cvt::<i64, u64>(magnitude_signed);
  } else {
    give 0_u64;
  }
  let none_n = none_word.len;
  let is_none = atom_is(atoms: atoms, atom: style, word: &none_word[0_u64..none_n]);
  if is_none {
    return unit;
  }
  let disc_n = disc_word.len;
  let is_disc = atom_is(atoms: atoms, atom: style, word: &disc_word[0_u64..disc_n]);
  if is_disc {
    let pushed = push_item::<u32>(cell: out, value: 8226_u32, ceiling: 64_u64);
    return unit;
  }
  let circle_n = circle_word.len;
  let is_circle = atom_is(atoms: atoms, atom: style, word: &circle_word[0_u64..circle_n]);
  if is_circle {
    let pushed = push_item::<u32>(cell: out, value: 9702_u32, ceiling: 64_u64);
    return unit;
  }
  let square_n = square_word.len;
  let is_square = atom_is(atoms: atoms, atom: style, word: &square_word[0_u64..square_n]);
  if is_square {
    let pushed = push_item::<u32>(cell: out, value: 9642_u32, ceiling: 64_u64);
    return unit;
  }
  let positive = bnot(negative);
  let nonzero = magnitude > 0_u64;
  let counting = band(positive, nonzero);
  let roman_range = magnitude < 4000_u64;
  let roman_ok = band(counting, roman_range);
  let lr_n = lower_roman_word.len;
  let lower_roman = atom_is(atoms: atoms, atom: style, word: &lower_roman_word[0_u64..lr_n]);
  let ur_n = upper_roman_word.len;
  let upper_roman = atom_is(atoms: atoms, atom: style, word: &upper_roman_word[0_u64..ur_n]);
  let any_roman = bor(lower_roman, upper_roman);
  let roman = band(any_roman, roman_ok);
  if roman {
    push_roman(out: out, value: magnitude, upper: upper_roman);
    return unit;
  }
  let la_n = lower_alpha_word.len;
  let lower_alpha = atom_is(atoms: atoms, atom: style, word: &lower_alpha_word[0_u64..la_n]);
  let ll_n = lower_latin_word.len;
  let lower_latin = atom_is(atoms: atoms, atom: style, word: &lower_latin_word[0_u64..ll_n]);
  let ua_n = upper_alpha_word.len;
  let upper_alpha = atom_is(atoms: atoms, atom: style, word: &upper_alpha_word[0_u64..ua_n]);
  let ul_n = upper_latin_word.len;
  let upper_latin = atom_is(atoms: atoms, atom: style, word: &upper_latin_word[0_u64..ul_n]);
  let lower_any = bor(lower_alpha, lower_latin);
  let upper_any = bor(upper_alpha, upper_latin);
  let any_alpha = bor(lower_any, upper_any);
  let alpha = band(any_alpha, counting);
  if alpha {
    push_alpha(out: out, value: magnitude, upper: upper_any);
    return unit;
  }
  if negative {
    let pushed = push_item::<u32>(cell: out, value: 45_u32, ceiling: 64_u64);
  }
  let lz_n = leading_zero_word.len;
  let leading = atom_is(atoms: atoms, atom: style, word: &leading_zero_word[0_u64..lz_n]);
  let width = if leading {
    give 2_u64;
  } else {
    give 1_u64;
  }
  push_digits(out: out, value: magnitude, width: width);
  return unit;
}

fn add_scalars(context: &Context, open: &Open, scalars: &[u32], style: StyleRef) -> result: Result<unit, LayoutError> reads(scalars), writes(context), writes(open) {
  doc "Adds each scalar value to the open paragraph as an inserted one.";
  let count = scalars^.len;
  for (k in 0_u64..count) {
    let value = scalars^[k];
    let added = propagate add_scalar_piece(context: context, open: open, value: value, style: style);
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn add_quote(styles: &Styles, context: &Context, open: &Open, style: StyleRef, depth: i32, closing: Bool) -> result: Result<unit, LayoutError> reads(styles), writes(context), writes(open) {
  doc "Adds the open or closing quote of nesting level depth from style's quotes: auto gives the English quotes, double at level 0 and single deeper; a list repeats its last pair past its end; none gives nothing.";
  let group = content_of(styles: styles, style: style);
  if group.quotes == quotes_none {
    return Ok<unit, LayoutError>(value: unit);
  }
  let level = if depth < 0_i32 {
    give 0_u64;
  } else {
    give cvt::<i32, u64>(depth);
  }
  let list_at = cvt::<u32, u64>(group.quotes);
  let auto = group.quotes == quotes_auto;
  let listed = list_at < styles^.quote_lists.inner.len;
  let chosen = bnot(auto);
  let usable = band(chosen, listed);
  if usable {
    let list = styles^.quote_lists.inner[list_at];
    let low = cvt::<u32, u64>(list.first);
    let high = cvt::<u32, u64>(list.end);
    if low < high {
      let span = high - low;
      let last = span - 1_u64;
      let pick = imin(level, last);
      let at = low + pick;
      if at < styles^.quote_pairs.inner.len {
        let pair = styles^.quote_pairs.inner[at];
        let start = if closing {
          give pair.close_start;
        } else {
          give pair.open_start;
        }
        let end = if closing {
          give pair.close_end;
        } else {
          give pair.open_end;
        }
        let first = cvt::<u32, u64>(start);
        let stop = cvt::<u32, u64>(end);
        let size = stop -sat first;
        let piece = Piece::Generated(start: start, end: end, style: style);
        let added = propagate add_piece(context: context, open: open, piece: piece, size: size);
      }
    }
    return Ok<unit, LayoutError>(value: unit);
  }
  let outer = level == 0_u64;
  let outer_close = band(outer, closing);
  let inner_open = bnot(outer);
  let opening = bnot(closing);
  let outer_open = band(outer, opening);
  let inner_close = band(inner_open, closing);
  let value = if outer_close {
    give 8221_u32;
  } else if outer_open {
    give 8220_u32;
  } else if inner_close {
    give 8217_u32;
  } else {
    give 8216_u32;
  }
  let added = propagate add_scalar_piece(context: context, open: open, value: value, style: style);
  return Ok<unit, LayoutError>(value: unit);
}

fn add_content(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, style: StyleRef, context: &Context, open: &Open) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(context), writes(open) {
  doc "Adds the generated content of the pseudo-element styled style, of the element node, to the open paragraph: strings, counters in their counter styles, attribute values and quotes, which move the walk's quote depth.";
  let group = content_of(styles: styles, style: style);
  let id = cvt::<u32, u64>(group.content);
  if id <= 1_u64 {
    return Ok<unit, LayoutError>(value: unit);
  }
  if id < styles^.content_lists.inner.len {
  } else {
    return Ok<unit, LayoutError>(value: unit);
  }
  let list = styles^.content_lists.inner[id];
  let low = cvt::<u32, u64>(list.first);
  let high = cvt::<u32, u64>(list.end);
  for (k in low..high) {
    if k < styles^.content_items.inner.len {
      let item = styles^.content_items.inner[k];
      if item.kind == item_string {
        let first = cvt::<u32, u64>(item.text_start);
        let stop = cvt::<u32, u64>(item.text_end);
        let size = stop -sat first;
        let piece = Piece::Generated(start: item.text_start, end: item.text_end, style: style);
        let added = propagate add_piece(context: context, open: open, piece: piece, size: size);
      } else if item.kind == item_counter {
        let value = match find_counter(walk: walk, name: item.name.index) {
          Some(value: at) => {
            let count = walk^.counters.inner.len;
            if at < count {
              give walk^.counters.inner[at].value;
            } else {
              give 0_i32;
            }
          }
          None() => {
            give 0_i32;
          }
        }
        let scalars = box_slots_new::<u32>(capacity: 16_u64);
        format_counter(atoms: atoms, value: value, style: item.list_style.index, out: &scalars);
        let length = scalars.inner.len;
        let added = propagate add_scalars(context: context, open: open, scalars: &scalars.inner[0_u64..length], style: style);
      } else if item.kind == item_counters {
        let count = walk^.counters.inner.len;
        let shown = 0_u64;
        for (c in 0_u64..count) {
          if c < walk^.counters.inner.len {
            let instance = walk^.counters.inner[c];
            if instance.name == item.name.index {
              if shown > 0_u64 {
                let first = cvt::<u32, u64>(item.text_start);
                let stop = cvt::<u32, u64>(item.text_end);
                let size = stop -sat first;
                let separator = Piece::Generated(start: item.text_start, end: item.text_end, style: style);
                let added = propagate add_piece(context: context, open: open, piece: separator, size: size);
              }
              let scalars = box_slots_new::<u32>(capacity: 16_u64);
              format_counter(atoms: atoms, value: instance.value, style: item.list_style.index, out: &scalars);
              let length = scalars.inner.len;
              let added_value = propagate add_scalars(context: context, open: open, scalars: &scalars.inner[0_u64..length], style: style);
              set shown = shown +sat 1_u64;
            }
          }
        }
        if shown == 0_u64 {
          let scalars = box_slots_new::<u32>(capacity: 16_u64);
          format_counter(atoms: atoms, value: 0_i32, style: item.list_style.index, out: &scalars);
          let length = scalars.inner.len;
          let added = propagate add_scalars(context: context, open: open, scalars: &scalars.inner[0_u64..length], style: style);
        }
      } else if item.kind == item_attr {
        match attribute_of(document: document, node: node, name: item.name.index) {
          Some(value: span) => {
            let first = cvt::<u32, u64>(span.start);
            let stop = cvt::<u32, u64>(span.end);
            let size = stop -sat first;
            let piece = Piece::Bytes(start: span.start, end: span.end, style: style, node: no_index);
            let added = propagate add_piece(context: context, open: open, piece: piece, size: size);
          }
          None() => {
          }
        }
      } else if item.kind == item_open_quote {
        let depth = walk^.quote_depth;
        let no = False();
        let added = propagate add_quote(styles: styles, context: context, open: open, style: style, depth: depth, closing: no);
        set walk^.quote_depth = depth +sat 1_i32;
      } else if item.kind == item_close_quote {
        let raised = walk^.quote_depth;
        if raised > 0_i32 {
          let depth = raised - 1_i32;
          set walk^.quote_depth = depth;
          let yes = True();
          let added = propagate add_quote(styles: styles, context: context, open: open, style: style, depth: depth, closing: yes);
        }
      } else if item.kind == item_no_open_quote {
        let depth = walk^.quote_depth;
        set walk^.quote_depth = depth +sat 1_i32;
      } else if item.kind == item_no_close_quote {
        let raised = walk^.quote_depth;
        if raised > 0_i32 {
          set walk^.quote_depth = raised - 1_i32;
        }
      }
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn element_at(walk: &Walk, node: NodeId) -> element: u32 reads(walk) {
  doc "Returns node's element index in the traversal, or unlisted.";
  let at = cvt::<u32, u64>(node.index);
  if at < walk^.order.inner.len {
    let found = walk^.order.inner[at];
    return found;
  }
  return unlisted;
}

fn local_name_of(document: &Document, node: NodeId) -> (name: u32, html: Bool, svg: Bool) reads(document) {
  doc "Returns node's local name's atom index and whether it is in the HTML or the SVG namespace; unlisted for a node that is no element.";
  let at = cvt::<u32, u64>(node.index);
  if at < document^.nodes.inner.len {
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Element(namespace: space, local_name: local, ..) => {
        let html = match space^ {
          Html() => {
            give True();
          }
          Svg() => {
            give False();
          }
          MathMl() => {
            give False();
          }
        }
        let svg = match space^ {
          Html() => {
            give False();
          }
          Svg() => {
            give True();
          }
          MathMl() => {
            give False();
          }
        }
        return local^.index, html, svg;
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Text(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  let no = False();
  return unlisted, no, no;
}

fn is_replaced(name: u32, html: Bool, svg: Bool) -> replaced: Bool pure {
  doc "Tells whether an element named name is a replaced element whose inside the stage does not lay out: img, video, iframe, embed, audio, input, select, textarea, meter and progress in HTML, and svg (the outermost, since the walk does not enter it) in SVG. canvas and object are not: with scripting disabled canvas represents its fallback content (HTML 4.12.5), and an object whose resource the stage does not load shows its fallback content as an inline box.";
  if svg {
    return name == atom_svg;
  }
  if html {
  } else {
    return False();
  }
  let image = name == atom_img;
  let video = name == atom_video;
  let frame = name == atom_iframe;
  let embed = name == atom_embed;
  let audio = name == atom_audio;
  let input = name == atom_input;
  let select = name == atom_select;
  let area = name == atom_textarea;
  let meter = name == atom_meter;
  let progress = name == atom_progress;
  let pictures = bor(image, video);
  let media = bor(pictures, audio);
  let frames = bor(frame, embed);
  let fields = bor(input, select);
  let gauges = bor(meter, progress);
  let editable = bor(area, gauges);
  let controls = bor(fields, editable);
  let outside = bor(media, frames);
  let found = bor(outside, controls);
  return found;
}

fn attribute_word(document: &Document, node: NodeId, name: u32, word: &[u8]) -> same: Bool reads(document), reads(word) {
  doc "Tells whether node's attribute name equals word, ASCII case-insensitively.";
  match attribute_of(document: document, node: node, name: name) {
    Some(value: text) => {
      let start = cvt::<u32, u64>(text.start);
      let end = cvt::<u32, u64>(text.end);
      let ordered = start <= end;
      let inside = end <= document^.text.inner.len;
      let usable = band(ordered, inside);
      if usable {
      } else {
        return False();
      }
      let size = end - start;
      if size != word^.len {
        return False();
      }
      for (k in 0_u64..size) {
        let at = start +sat k;
        if at < document^.text.inner.len {
          let byte = document^.text.inner[at];
          let upper_low = byte >= 65_u8;
          let upper_high = byte <= 90_u8;
          let upper = band(upper_low, upper_high);
          let lowered = if upper {
            give byte +sat 32_u8;
          } else {
            give byte;
          }
          if lowered != word^[k] {
            return False();
          }
        }
      }
      return True();
    }
    None() => {
      return False();
    }
  }
}

fn text_input_type(document: &Document, node: NodeId) -> text: Bool reads(document) {
  doc "Tells whether an input element is a single-line text field: no type, or text, search, email, url, tel, password or number.";
  match attribute_of(document: document, node: node, name: atom_type) {
    Some(..) => {
    }
    None() => {
      return True();
    }
  }
  let total = text_input_words.len;
  let start = 0_u64;
  for (k in 0_u64..total) {
    let byte = text_input_words[k];
    if byte == 32_u8 {
      if start < k {
        let found = attribute_word(document: document, node: node, name: atom_type, word: &text_input_words[start..k]);
        if found {
          return True();
        }
      }
      set start = k +sat 1_u64;
    }
  }
  return False();
}

fn control_natural(document: &Document, node: NodeId) -> natural: u8 reads(document) {
  doc "What an input element shows, as far as the stage sizes form controls: a text field, a checkbox or radio button, or a replaced box of the default size.";
  let text = text_input_type(document: document, node: node);
  if text {
    return natural_text_input;
  }
  let checkbox_n = checkbox_word.len;
  let radio_n = radio_word.len;
  let checkbox = attribute_word(document: document, node: node, name: atom_type, word: &checkbox_word[0_u64..checkbox_n]);
  let radio = attribute_word(document: document, node: node, name: atom_type, word: &radio_word[0_u64..radio_n]);
  let toggle = bor(checkbox, radio);
  if toggle {
    return natural_toggle;
  }
  return natural_object;
}

fn image_natural(document: &Document, node: NodeId, name: u32, html: Bool) -> natural: u8 reads(document) {
  doc "What an element shows in place of an image the stage does not load, as the reference shows an img whose fetch failed: an img with a nonempty alt shows its alt text, one with an empty alt or no src nothing, any other img the broken-image icon; an input element its control_natural; any other element is natural_object.";
  let input_named = name == atom_input;
  let input = band(html, input_named);
  if input {
    let made = control_natural(document: document, node: node);
    return made;
  }
  let named = name == atom_img;
  let image = band(html, named);
  if image {
  } else {
    return natural_object;
  }
  match attribute_of(document: document, node: node, name: atom_alt) {
    Some(value: span) => {
      if span.end > span.start {
        return natural_alt_box;
      }
      return natural_empty;
    }
    None() => {
    }
  }
  match attribute_of(document: document, node: node, name: atom_src) {
    Some(..) => {
      return natural_icon;
    }
    None() => {
    }
  }
  return natural_empty;
}

fn build_alt(document: &Document, styles: &Styles, node: NodeId, style: StyleRef, context: &Context) -> result: Result<unit, LayoutError> reads(document), reads(styles), writes(context) {
  doc "Fills the flow context of an img showing its alt text with the broken-image icon followed by the text, as the reference does; an inline img's box ignores its width and height.";
  let group = box_of(styles: styles, style: style);
  let plain = is_plain_inline(display: group.display);
  if plain {
    set context^.natural = natural_alt_box;
  }
  let open = new_open(style: style, first: 0_u64);
  let icon_style = anonymous_of(style: style);
  let icon = new_context(kind: ctx_replaced, style: icon_style);
  let drawn = propagate add_object(context: context, open: &open, child: move icon);
  let last = context^.children.inner.len;
  if last > 0_u64 {
    let at = last - 1_u64;
    set context^.children.inner[at].natural = natural_alt_icon;
  }
  match attribute_of(document: document, node: node, name: atom_alt) {
    Some(value: span) => {
      let first = cvt::<u32, u64>(span.start);
      let stop = cvt::<u32, u64>(span.end);
      let size = stop -sat first;
      let piece = Piece::Bytes(start: span.start, end: span.end, style: style, node: no_index);
      let added = propagate add_piece(context: context, open: &open, piece: piece, size: size);
    }
    None() => {
    }
  }
  let ended = propagate end_paragraph(context: context, open: &open);
  return Ok<unit, LayoutError>(value: unit);
}

fn add_inside_marker(styles: &Styles, atoms: &AtomTable, walk: &Walk, style: StyleRef, context: &Context, open: &Open) -> result: Result<unit, LayoutError> reads(styles), reads(atoms), reads(walk), writes(context), writes(open) {
  doc "Adds the inside marker of the list item styled style at the start of its content: a disc, circle or square bullet box, or its list-item counter in its list-style-type followed by a full stop and a space, as the reference's markers read.";
  let content = content_of(styles: styles, style: style);
  if content.list_style_position == list_inside {
  } else {
    return Ok<unit, LayoutError>(value: unit);
  }
  let text = text_of(styles: styles, style: style);
  let kind = text.list_style_type.index;
  let none_n = none_word.len;
  let is_none = atom_is(atoms: atoms, atom: kind, word: &none_word[0_u64..none_n]);
  if is_none {
    return Ok<unit, LayoutError>(value: unit);
  }
  let marker_style = anonymous_of(style: style);
  let disc_n = disc_word.len;
  let circle_n = circle_word.len;
  let square_n = square_word.len;
  let is_disc = atom_is(atoms: atoms, atom: kind, word: &disc_word[0_u64..disc_n]);
  let is_circle = atom_is(atoms: atoms, atom: kind, word: &circle_word[0_u64..circle_n]);
  let is_square = atom_is(atoms: atoms, atom: kind, word: &square_word[0_u64..square_n]);
  let round = bor(is_disc, is_circle);
  let symbol = bor(round, is_square);
  if symbol {
    let bullet = new_context(kind: ctx_replaced, style: marker_style);
    let drawn = propagate add_object(context: context, open: open, child: move bullet);
    let last = context^.children.inner.len;
    if last > 0_u64 {
      let at = last - 1_u64;
      set context^.children.inner[at].natural = natural_marker;
    }
    return Ok<unit, LayoutError>(value: unit);
  }
  let name = walk^.list_item;
  let value = match find_counter(walk: walk, name: name) {
    Some(value: at) => {
      let count = walk^.counters.inner.len;
      if at < count {
        give walk^.counters.inner[at].value;
      } else {
        give 0_i32;
      }
    }
    None() => {
      give 0_i32;
    }
  }
  let scalars = box_slots_new::<u32>(capacity: 16_u64);
  format_counter(atoms: atoms, value: value, style: kind, out: &scalars);
  let stop = push_item::<u32>(cell: &scalars, value: 46_u32, ceiling: 64_u64);
  let space = push_item::<u32>(cell: &scalars, value: 32_u32, ceiling: 64_u64);
  let length = scalars.inner.len;
  let added = propagate add_scalars(context: context, open: open, scalars: &scalars.inner[0_u64..length], style: marker_style);
  return Ok<unit, LayoutError>(value: unit);
}

fn outside_marker(styles: &Styles, atoms: &AtomTable, style: StyleRef, display: u8) -> marker: Bool reads(styles), reads(atoms) {
  doc "Tells whether a box of display and style is a list item with an outside marker: list-style-position outside and a list-style-type other than none.";
  if display == display_list_item {
  } else {
    return False();
  }
  let content = content_of(styles: styles, style: style);
  if content.list_style_position == list_inside {
    return False();
  }
  let text = text_of(styles: styles, style: style);
  let n = none_word.len;
  let none = atom_is(atoms: atoms, atom: text.list_style_type.index, word: &none_word[0_u64..n]);
  let made = bnot(none);
  return made;
}

fn inner_kind(display: u8, replaced: Bool) -> kind: u8 pure {
  doc "The kind of context a box of display establishes: replaced, flex, grid, table, or a flow context.";
  if replaced {
    return ctx_replaced;
  }
  let flex = display == display_flex;
  let inline_flex = display == display_inline_flex;
  let webkit = display == display_webkit_box;
  let webkit_inline = display == display_webkit_inline_box;
  let modern = bor(flex, inline_flex);
  let legacy = bor(webkit, webkit_inline);
  let any_flex = bor(modern, legacy);
  if any_flex {
    return ctx_flex;
  }
  let grid = display == display_grid;
  let inline_grid = display == display_inline_grid;
  let any_grid = bor(grid, inline_grid);
  if any_grid {
    return ctx_grid;
  }
  let table = display == display_table;
  let inline_table = display == display_inline_table;
  let any_table = bor(table, inline_table);
  if any_table {
    return ctx_table;
  }
  return ctx_flow;
}

fn is_inline_level(display: u8) -> inline: Bool pure {
  doc "Tells whether display is inline-level: inline, the inline-block family, ruby and math.";
  let plain = display == display_inline;
  let block = display == display_inline_block;
  let table = display == display_inline_table;
  let flex = display == display_inline_flex;
  let grid = display == display_inline_grid;
  let webkit = display == display_webkit_inline_box;
  let ruby = display == display_ruby;
  let ruby_text = display == display_ruby_text;
  let math = display == display_math;
  let first = bor(plain, block);
  let second = bor(table, flex);
  let third = bor(grid, webkit);
  let rubies = bor(ruby, ruby_text);
  let fourth = bor(rubies, math);
  let early = bor(first, second);
  let late = bor(third, fourth);
  let found = bor(early, late);
  return found;
}

fn is_plain_inline(display: u8) -> plain: Bool pure {
  doc "Tells whether display makes an inline box rather than an atomic inline: inline, ruby, ruby-text and math.";
  let plain = display == display_inline;
  let ruby = display == display_ruby;
  let ruby_text = display == display_ruby_text;
  let math = display == display_math;
  let first = bor(plain, ruby);
  let second = bor(ruby_text, math);
  let found = bor(first, second);
  return found;
}

fn establishes(group: BoxGroup) -> own: Bool pure {
  doc "Tells whether a block-level flow box establishes an independent formatting context: flow-root, a scroll container (overflow other than visible and clip), or a box whose display is not a plain block or list item.";
  let block = group.display == display_block;
  let item = group.display == display_list_item;
  let plain = bor(block, item);
  if plain {
  } else {
    return True();
  }
  let x_visible = group.overflow_x == overflow_visible;
  let x_clip = group.overflow_x == overflow_clip;
  let y_visible = group.overflow_y == overflow_visible;
  let y_clip = group.overflow_y == overflow_clip;
  let x_plain = bor(x_visible, x_clip);
  let y_plain = bor(y_visible, y_clip);
  let both = band(x_plain, y_plain);
  return bnot(both);
}

fn add_pseudo(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, kind: u8, context: &Context, open: &Open) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(context), writes(open) {
  doc "Adds element's ::before or ::after box, when it has one with content, to context: an inline box, a block box, or an atomic inline, floated or positioned context holding the content.";
  let pseudo = pseudo_index(styles: styles, element: element, kind: kind);
  if pseudo == no_pseudo {
    return Ok<unit, LayoutError>(value: unit);
  }
  let style = pseudo_ref(element: element, pseudo: pseudo);
  let content = content_of(styles: styles, style: style);
  if content.content <= 1_u32 {
    return Ok<unit, LayoutError>(value: unit);
  }
  let group = box_of(styles: styles, style: style);
  if group.display == display_none {
    return Ok<unit, LayoutError>(value: unit);
  }
  set walk^.depth = walk^.depth +sat 1_u64;
  let item = group.display == display_list_item;
  let counted = propagate apply_counters(styles: styles, walk: walk, style: style, list_item: item);
  let out_absolute = group.position == position_absolute;
  let out_fixed = group.position == position_fixed;
  let out = bor(out_absolute, out_fixed);
  let floated = group.float != float_none;
  let own = bor(out, floated);
  let inline = is_inline_level(display: group.display);
  let plain = is_plain_inline(display: group.display);
  let flowing = bnot(own);
  let inline_plain = band(inline, plain);
  let inline_box = band(inline_plain, flowing);
  if inline_box {
    let begun = propagate begin_inline(context: context, open: open, style: style);
    let added = propagate add_content(document: document, styles: styles, atoms: atoms, walk: walk, node: node, style: style, context: context, open: open);
    let ended = propagate end_inline(context: context, open: open);
  } else {
    let unreplaced = False();
    let kind_of_box = inner_kind(display: group.display, replaced: unreplaced);
    let child = new_context(kind: kind_of_box, style: style);
    let inner = new_open(style: style, first: 0_u64);
    let added = propagate add_content(document: document, styles: styles, atoms: atoms, walk: walk, node: node, style: style, context: &child, open: &inner);
    let ended = propagate end_paragraph(context: &child, open: &inner);
    if out {
      let placed = propagate add_child_flow(context: context, child: move child, kind: 2_u8);
    } else if floated {
      let placed = propagate add_child_flow(context: context, child: move child, kind: 1_u8);
    } else if inline {
      let placed = propagate add_object(context: context, open: open, child: move child);
    } else {
      let closed = propagate end_paragraph(context: context, open: open);
      let placed = propagate add_child_flow(context: context, child: move child, kind: 0_u8);
    }
  }
  leave_scope(walk: walk);
  set walk^.depth = walk^.depth -sat 1_u64;
  return Ok<unit, LayoutError>(value: unit);
}

fn walk_children(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, parent: NodeId, context: &Context, open: &Open) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(context), writes(open) {
  doc "Adds the children of parent, in order, to the flow context and its open paragraph. The walk follows next siblings and takes at most one step per node; Inconsistent when a link names no node.";
  let nodes = document^.nodes.inner.len;
  let index = cvt::<u32, u64>(parent.index);
  if index < nodes {
  } else {
    return inconsistent::<unit>();
  }
  let cursor = document^.nodes.inner[index].links.first_child;
  for (step in 0_u64..nodes) {
    let node = match cursor {
      Some(value: found) => {
        give found;
      }
      None() => {
        return Ok<unit, LayoutError>(value: unit);
      }
    }
    let at = cvt::<u32, u64>(node.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Text(data: span) => {
        let start = cvt::<u32, u64>(span^.start);
        let end = cvt::<u32, u64>(span^.end);
        let size = end -sat start;
        if size > 0_u64 {
          let owner = current_style(open: open);
          let piece = Piece::Bytes(start: span^.start, end: span^.end, style: owner, node: node.index);
          let added = propagate add_piece(context: context, open: open, piece: piece, size: size);
        }
      }
      Element(..) => {
        let added = propagate walk_element(document: document, styles: styles, atoms: atoms, walk: walk, node: node, context: context, open: open);
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return inconsistent::<unit>();
}

fn walk_element(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, context: &Context, open: &Open) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(context), writes(open) {
  doc "Adds the element node and its subtree to the flow context by its computed display, float and position: nothing for display none; its children for display contents; an inline box; an atomic inline, floated or positioned child context; an in-flow child context for a block-level box that establishes one; otherwise a block box of the context, bracketing its content.";
  let element = element_at(walk: walk, node: node);
  if element == unlisted {
    return Ok<unit, LayoutError>(value: unit);
  }
  let style = element_ref(element: element);
  let group = box_of(styles: styles, style: style);
  if group.display == display_none {
    return Ok<unit, LayoutError>(value: unit);
  }
  set walk^.depth = walk^.depth +sat 1_u64;
  let item = group.display == display_list_item;
  let listed_reset = propagate reset_list(document: document, walk: walk, node: node);
  let counted = propagate apply_counters(styles: styles, walk: walk, style: style, list_item: item);
  let added = propagate place_element(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, style: style, group: group, context: context, open: open);
  leave_scope(walk: walk);
  set walk^.depth = walk^.depth -sat 1_u64;
  return Ok<unit, LayoutError>(value: unit);
}

fn place_element(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, style: StyleRef, group: BoxGroup, context: &Context, open: &Open) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(context), writes(open) {
  doc "The body of walk_element once counters are applied.";
  let (name, html, svg) = local_name_of(document: document, node: node);
  let owner_style = current_style(open: open);
  let named_br = name == atom_br;
  let is_br = band(html, named_br);
  if is_br {
    let begun = propagate begin_inline(context: context, open: open, style: style);
    let added = propagate add_scalar_piece(context: context, open: open, value: line_separator, style: owner_style);
    let ended = propagate end_inline(context: context, open: open);
    return Ok<unit, LayoutError>(value: unit);
  }
  let named_wbr = name == atom_wbr;
  let is_wbr = band(html, named_wbr);
  if is_wbr {
    let added = propagate add_scalar_piece(context: context, open: open, value: zero_width_space, style: owner_style);
    return Ok<unit, LayoutError>(value: unit);
  }
  if group.display == display_contents {
    let before = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_before, context: context, open: open);
    let inside = propagate walk_children(document: document, styles: styles, atoms: atoms, walk: walk, parent: node, context: context, open: open);
    let after = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_after, context: context, open: open);
    return Ok<unit, LayoutError>(value: unit);
  }
  let listed = is_replaced(name: name, html: html, svg: svg);
  let natural = image_natural(document: document, node: node, name: name, html: html);
  let fallback = natural == natural_alt_box;
  let image_shown = bnot(fallback);
  let replaced = band(listed, image_shown);
  let out_absolute = group.position == position_absolute;
  let out_fixed = group.position == position_fixed;
  let out = bor(out_absolute, out_fixed);
  let floated = group.float != float_none;
  let kind = inner_kind(display: group.display, replaced: replaced);
  if out {
    let child = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
    let placed = propagate add_child_flow(context: context, child: move child, kind: 2_u8);
    return Ok<unit, LayoutError>(value: unit);
  }
  if floated {
    let child = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
    let placed = propagate add_child_flow(context: context, child: move child, kind: 1_u8);
    return Ok<unit, LayoutError>(value: unit);
  }
  let inline = is_inline_level(display: group.display);
  if inline {
    let plain = is_plain_inline(display: group.display);
    let not_replaced = bnot(replaced);
    let plain_box = band(plain, not_replaced);
    let simple = band(plain_box, image_shown);
    if simple {
      let begun = propagate begin_inline(context: context, open: open, style: style);
      let before = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_before, context: context, open: open);
      let inside = propagate walk_children(document: document, styles: styles, atoms: atoms, walk: walk, parent: node, context: context, open: open);
      let after = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_after, context: context, open: open);
      let ended = propagate end_inline(context: context, open: open);
      return Ok<unit, LayoutError>(value: unit);
    }
    let child = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
    let placed = propagate add_object(context: context, open: open, child: move child);
    return Ok<unit, LayoutError>(value: unit);
  }
  let established = establishes(group: group);
  let root = element == 0_u32;
  let columned = multicol(styles: styles, style: style);
  let separate_root = bor(root, columned);
  let own = bor(established, separate_root);
  let other_kind = kind != ctx_flow;
  let separate = bor(other_kind, fallback);
  let independent = bor(own, separate);
  if independent {
    let closed = propagate end_paragraph(context: context, open: open);
    let flow_at = context^.flow.inner.len;
    let child = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
    let placed = propagate add_child_flow(context: context, child: move child, kind: 0_u8);
    let around = open^.inlines.inner.len;
    if around > 0_u64 {
      let saved = stash_inlines(open: open);
      let first = open_splits(context: context, saved: &saved, flow_open: flow_at);
      restore_inlines(open: open, saved: &saved);
    }
    return Ok<unit, LayoutError>(value: unit);
  }
  let closed = propagate end_paragraph(context: context, open: open);
  let saved = stash_inlines(open: open);
  let index = context^.blocks.inner.len;
  if index < 4294967295_u64 {
  } else {
    return too_large::<unit>();
  }
  let marker = outside_marker(styles: styles, atoms: atoms, style: style, display: group.display);
  let block = Block(style: style, x: 0_i32, y: 0_i32, width: 0_i32, height: 0_i32, marker: marker);
  let kept = propagate push_or_fail::<Block>(cell: &context^.blocks, value: block);
  let at = cvt::<u64, u32>(index);
  let flow_open = context^.flow.inner.len;
  let opening = Flow::Open(block: at);
  let opened = propagate push_or_fail::<Flow>(cell: &context^.flow, value: opening);
  let first_split = open_splits(context: context, saved: &saved, flow_open: flow_open);
  let split_end = context^.splits.inner.len;
  let outer = open^.style;
  set open^.style = style;
  let marked = propagate add_inside_marker(styles: styles, atoms: atoms, walk: walk, style: style, context: context, open: open);
  let before = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_before, context: context, open: open);
  let inside = propagate walk_children(document: document, styles: styles, atoms: atoms, walk: walk, parent: node, context: context, open: open);
  let after = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_after, context: context, open: open);
  let ended = propagate end_paragraph(context: context, open: open);
  set open^.style = outer;
  let flow_close = context^.flow.inner.len;
  let closing = Flow::Close(block: at);
  let closed_block = propagate push_or_fail::<Flow>(cell: &context^.flow, value: closing);
  close_splits(context: context, first: first_split, end: split_end, flow_close: flow_close);
  restore_inlines(open: open, saved: &saved);
  return Ok<unit, LayoutError>(value: unit);
}

fn build_box(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, style: StyleRef, kind: u8) -> result: Result<Context, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk) {
  doc "Builds the context of kind that the element node establishes: a flow context of its ::before, children and ::after, flex or grid items, a table, or a replaced box with no content.";
  let context = new_context(kind: kind, style: style);
  let (name, html, svg) = local_name_of(document: document, node: node);
  let natural = image_natural(document: document, node: node, name: name, html: html);
  if kind == ctx_replaced {
    set context.natural = natural;
    let wide = span_attribute(document: document, node: node, name: atom_width, fallback: 0_u32, least: 0_u32, most: 100000_u32);
    let tall = span_attribute(document: document, node: node, name: atom_height, fallback: 0_u32, least: 0_u32, most: 100000_u32);
    let wide_set = wide > 0_u32;
    let tall_set = tall > 0_u32;
    let both_set = band(wide_set, tall_set);
    let icon = natural == natural_icon;
    let empty = natural == natural_empty;
    let img = bor(icon, empty);
    let video = name == atom_video;
    let svg_named = name == atom_svg;
    let svg_root = band(svg, svg_named);
    let ratioed = bor(video, svg_root);
    let sized = bor(img, ratioed);
    let both = band(both_set, sized);
    if both {
      let wide_px = cvt::<u32, i64>(wide);
      let tall_px = cvt::<u32, i64>(tall);
      let wide_units = wide_px *sat 64_i64;
      let tall_units = tall_px *sat 64_i64;
      let wide_bounded = imin(wide_units, 2147483647_i64);
      let tall_bounded = imin(tall_units, 2147483647_i64);
      set context.ratio_width = cvt::<i64, i32>(wide_bounded);
      set context.ratio_height = cvt::<i64, i32>(tall_bounded);
    }
    return Ok<Context, LayoutError>(value: move context);
  }
  let fallback = natural == natural_alt_box;
  let flowing = kind == ctx_flow;
  let alt_text = band(fallback, flowing);
  if alt_text {
    let shown = propagate build_alt(document: document, styles: styles, node: node, style: style, context: &context);
    return Ok<Context, LayoutError>(value: move context);
  }
  let flex = kind == ctx_flex;
  let grid = kind == ctx_grid;
  let container = bor(flex, grid);
  if container {
    let built = propagate build_items(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, container: &context);
    return Ok<Context, LayoutError>(value: move context);
  }
  if kind == ctx_table {
    let built = propagate build_table(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, table: &context);
    return Ok<Context, LayoutError>(value: move context);
  }
  let open = new_open(style: style, first: 0_u64);
  let marked = propagate add_inside_marker(styles: styles, atoms: atoms, walk: walk, style: style, context: &context, open: &open);
  let before = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_before, context: &context, open: &open);
  let inside = propagate walk_children(document: document, styles: styles, atoms: atoms, walk: walk, parent: node, context: &context, open: &open);
  let after = propagate add_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_after, context: &context, open: &open);
  let ended = propagate end_paragraph(context: &context, open: &open);
  return Ok<Context, LayoutError>(value: move context);
}

fn is_blank(bytes: &[u8]) -> blank: Bool reads(bytes) {
  doc "Tells whether bytes hold only tab, line feed, form feed, carriage return and space.";
  let count = bytes^.len;
  for (k in 0_u64..count) {
    let byte = bytes^[k];
    let tab = byte == 9_u8;
    let feed = byte == 10_u8;
    let form = byte == 12_u8;
    let carriage = byte == 13_u8;
    let space = byte == 32_u8;
    let first = bor(tab, feed);
    let second = bor(form, carriage);
    let either = bor(first, second);
    let white = bor(either, space);
    if white {
    } else {
      return False();
    }
  }
  return True();
}

fn add_item_pseudo(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, kind: u8, container: &Context) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(container) {
  doc "Adds the container element's ::before or ::after box, when it has content, as a flex or grid item, or as an out-of-flow child when positioned.";
  let pseudo = pseudo_index(styles: styles, element: element, kind: kind);
  if pseudo == no_pseudo {
    return Ok<unit, LayoutError>(value: unit);
  }
  let style = pseudo_ref(element: element, pseudo: pseudo);
  let content = content_of(styles: styles, style: style);
  if content.content <= 1_u32 {
    return Ok<unit, LayoutError>(value: unit);
  }
  let group = box_of(styles: styles, style: style);
  if group.display == display_none {
    return Ok<unit, LayoutError>(value: unit);
  }
  set walk^.depth = walk^.depth +sat 1_u64;
  let item = group.display == display_list_item;
  let counted = propagate apply_counters(styles: styles, walk: walk, style: style, list_item: item);
  let unreplaced = False();
  let kind_of_box = inner_kind(display: group.display, replaced: unreplaced);
  let child = new_context(kind: kind_of_box, style: style);
  let inner = new_open(style: style, first: 0_u64);
  let added = propagate add_content(document: document, styles: styles, atoms: atoms, walk: walk, node: node, style: style, context: &child, open: &inner);
  let ended = propagate end_paragraph(context: &child, open: &inner);
  let out_absolute = group.position == position_absolute;
  let out_fixed = group.position == position_fixed;
  let out = bor(out_absolute, out_fixed);
  let flow_kind = if out {
    give 2_u8;
  } else {
    give 0_u8;
  }
  let placed = propagate add_child_flow(context: container, child: move child, kind: flow_kind);
  leave_scope(walk: walk);
  set walk^.depth = walk^.depth -sat 1_u64;
  return Ok<unit, LayoutError>(value: unit);
}

fn build_items(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, container: &Context) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(container) {
  doc "Adds the flex or grid items of the container element node to container in document order: its ::before and ::after, each element child (the style stage has blockified it) as a child context, the children of a display contents child in its place, each text node holding more than white space as an anonymous item, and each absolutely positioned child as an out-of-flow child.";
  let before = propagate add_item_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_before, container: container);
  let inside = propagate build_item_children(document: document, styles: styles, atoms: atoms, walk: walk, parent: node, container: container);
  let after = propagate add_item_pseudo(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, kind: pseudo_after, container: container);
  return Ok<unit, LayoutError>(value: unit);
}

fn build_item_children(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, parent: NodeId, container: &Context) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(container) {
  doc "Adds the children of parent as items of container, as build_items describes.";
  let nodes = document^.nodes.inner.len;
  let index = cvt::<u32, u64>(parent.index);
  if index < nodes {
  } else {
    return inconsistent::<unit>();
  }
  let cursor = document^.nodes.inner[index].links.first_child;
  for (step in 0_u64..nodes) {
    let node = match cursor {
      Some(value: found) => {
        give found;
      }
      None() => {
        return Ok<unit, LayoutError>(value: unit);
      }
    }
    let at = cvt::<u32, u64>(node.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Text(data: span) => {
        let start = cvt::<u32, u64>(span^.start);
        let end = cvt::<u32, u64>(span^.end);
        let ordered = start <= end;
        let inside = end <= document^.text.inner.len;
        let usable = band(ordered, inside);
        if usable {
          let blank = is_blank(bytes: &document^.text.inner[start..end]);
          if blank {
          } else {
            let style = anonymous_of(style: container^.style);
            let child = new_context(kind: ctx_flow, style: style);
            let open = new_open(style: style, first: 0_u64);
            let size = end - start;
            let piece = Piece::Bytes(start: span^.start, end: span^.end, style: style, node: node.index);
            let added = propagate add_piece(context: &child, open: &open, piece: piece, size: size);
            let ended = propagate end_paragraph(context: &child, open: &open);
            let placed = propagate add_child_flow(context: container, child: move child, kind: 0_u8);
          }
        }
      }
      Element(..) => {
        let element = element_at(walk: walk, node: node);
        if element != unlisted {
          let style = element_ref(element: element);
          let group = box_of(styles: styles, style: style);
          if group.display == display_none {
          } else if group.display == display_contents {
            set walk^.depth = walk^.depth +sat 1_u64;
            let not_item = False();
            let counted = propagate apply_counters(styles: styles, walk: walk, style: style, list_item: not_item);
            let built = propagate build_items(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, container: container);
            leave_scope(walk: walk);
            set walk^.depth = walk^.depth -sat 1_u64;
          } else {
            set walk^.depth = walk^.depth +sat 1_u64;
            let item = group.display == display_list_item;
            let listed_reset = propagate reset_list(document: document, walk: walk, node: node);
            let counted = propagate apply_counters(styles: styles, walk: walk, style: style, list_item: item);
            let (name, html, svg) = local_name_of(document: document, node: node);
            let listed = is_replaced(name: name, html: html, svg: svg);
            let natural = image_natural(document: document, node: node, name: name, html: html);
            let image_shown = natural != natural_alt_box;
            let replaced = band(listed, image_shown);
            let kind = inner_kind(display: group.display, replaced: replaced);
            let child = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: node, element: element, style: style, kind: kind);
            let out_absolute = group.position == position_absolute;
            let out_fixed = group.position == position_fixed;
            let out = bor(out_absolute, out_fixed);
            let flow_kind = if out {
              give 2_u8;
            } else {
              give 0_u8;
            }
            let placed = propagate add_child_flow(context: container, child: move child, kind: flow_kind);
            leave_scope(walk: walk);
            set walk^.depth = walk^.depth -sat 1_u64;
          }
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
  }
  return inconsistent::<unit>();
}

fn span_attribute(document: &Document, node: NodeId, name: u32, fallback: u32, least: u32, most: u32) -> span: u32 reads(document) {
  doc "Parses node's attribute name by the HTML Standard's rules for parsing non-negative integers (leading white space, an optional plus sign, digits), clamped to least and most; fallback when absent or not a number.";
  match attribute_of(document: document, node: node, name: name) {
    Some(value: text) => {
      let start = cvt::<u32, u64>(text.start);
      let end = cvt::<u32, u64>(text.end);
      let ordered = start <= end;
      let inside = end <= document^.text.inner.len;
      let usable = band(ordered, inside);
      if usable {
      } else {
        return fallback;
      }
      let value = 0_u64;
      let digits = 0_u64;
      let leading = True();
      for (k in start..end) {
        let byte = document^.text.inner[k];
        let space = byte == 32_u8;
        let tab = byte == 9_u8;
        let feed = byte == 10_u8;
        let form = byte == 12_u8;
        let carriage = byte == 13_u8;
        let first = bor(space, tab);
        let second = bor(feed, form);
        let either = bor(first, second);
        let white = bor(either, carriage);
        let skipping = band(leading, white);
        let plus = byte == 43_u8;
        let signed = band(leading, plus);
        let low = byte >= 48_u8;
        let high = byte <= 57_u8;
        let digit = band(low, high);
        if skipping {
        } else if signed {
          set leading = False();
        } else if digit {
          set leading = False();
          let wide = cvt::<u8, u64>(byte);
          let place = wide - 48_u64;
          let shifted = value *sat 10_u64;
          set value = shifted +sat place;
          set digits = digits +sat 1_u64;
        } else {
          break;
        }
      }
      if digits == 0_u64 {
        return fallback;
      }
      let least_wide = cvt::<u32, u64>(least);
      let most_wide = cvt::<u32, u64>(most);
      let above = imax(value, least_wide);
      let clamped = imin(above, most_wide);
      let made = cvt::<u64, u32>(clamped);
      return made;
    }
    None() => {
      return fallback;
    }
  }
}

fn add_columns(table: &Context, style: StyleRef, styled: Bool, group: StyleRef, count: u32) -> result: Result<unit, LayoutError> writes(table) {
  doc "Appends count columns of style to the table, held by the colgroup group when there is one.";
  let total = cvt::<u32, u64>(count);
  for (k in 0_u64..total) {
    let column = TableColumn(style: style, styled: styled, group: group, x: 0_i32, width: 0_i32);
    let pushed = propagate push_or_fail::<TableColumn>(cell: &table^.columns, value: column);
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn add_column_group(document: &Document, styles: &Styles, walk: &Walk, node: NodeId, style: StyleRef, table: &Context) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(walk), writes(table) {
  doc "Adds a column group's columns: one per span of each col child, or its own span of columns when it has no col child.";
  let nodes = document^.nodes.inner.len;
  let index = cvt::<u32, u64>(node.index);
  if index < nodes {
  } else {
    return inconsistent::<unit>();
  }
  let cursor = document^.nodes.inner[index].links.first_child;
  let found = 0_u64;
  for (step in 0_u64..nodes) {
    let child = match cursor {
      Some(value: next) => {
        give next;
      }
      None() => {
        break;
      }
    }
    let at = cvt::<u32, u64>(child.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
    let element = element_at(walk: walk, node: child);
    if element != unlisted {
      let child_style = element_ref(element: element);
      let group = box_of(styles: styles, style: child_style);
      if group.display == display_column {
        let span = span_attribute(document: document, node: child, name: atom_span, fallback: 1_u32, least: 1_u32, most: 1000_u32);
        let yes = True();
        let added = propagate add_columns(table: table, style: child_style, styled: yes, group: style, count: span);
        set found = found +sat 1_u64;
      }
    }
  }
  if found == 0_u64 {
    let span = span_attribute(document: document, node: node, name: atom_span, fallback: 1_u32, least: 1_u32, most: 1000_u32);
    let yes = True();
    let none = anonymous_of(style: table^.style);
    let added = propagate add_columns(table: table, style: style, styled: yes, group: none, count: span);
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn place_cell(table: &Context, busy: &Box<Slots<u32>>, row: u32, column: u64, content: Context, row_span: u32, column_span: u32) -> result: Result<u64, LayoutError> writes(table), writes(busy) {
  doc "Adds the cell content to the table in row row, at the first column from column that no cell of an earlier row spans into, with its spans (a cell occupies its columns for its rows: busy holds, for each column, the first row it is free again), and returns the column after it.";
  let column_here = column;
  let columns = busy^.inner.len;
  for (skip in 0_u64..columns) {
    if column_here < busy^.inner.len {
      let wide_row = cvt::<u32, u64>(row);
      let held = cvt::<u32, u64>(busy^.inner[column_here]);
      if held > wide_row {
        set column_here = column_here +sat 1_u64;
      } else {
        break;
      }
    } else {
      break;
    }
  }
  let child_index = table^.children.inner.len;
  if child_index < 4294967295_u64 {
  } else {
    return too_large::<u64>();
  }
  let kept = propagate push_or_fail::<Context>(cell: &table^.children, value: move content);
  if column_here < 4294967295_u64 {
  } else {
    return too_large::<u64>();
  }
  let child_at = cvt::<u64, u32>(child_index);
  let column_at = cvt::<u64, u32>(column_here);
  let placed = TableCell(context: child_at, row: row, column: column_at, row_span: row_span, column_span: column_span);
  let listed = propagate push_or_fail::<TableCell>(cell: &table^.cells, value: placed);
  let width = cvt::<u32, u64>(column_span);
  let free_from = row +sat row_span;
  for (k in 0_u64..width) {
    let target = column_here +sat k;
    let length = busy^.inner.len;
    if target >= length {
      let missing_gap = target - length;
      let missing = missing_gap + 1_u64;
      for (fill in 0_u64..missing) {
        let grown = propagate push_or_fail::<u32>(cell: busy, value: 0_u32);
      }
    }
    if target < busy^.inner.len {
      set busy^.inner[target] = free_from;
    }
  }
  let next = column_here +sat width;
  return Ok<u64, LayoutError>(value: next);
}

fn is_table_child(display: u8) -> part: Bool pure {
  doc "Tells whether a box of display is a proper child of a table: a caption, a column or column group, a row group or a row.";
  let caption = display == display_caption;
  let column = display == display_column;
  let column_group = display == display_column_group;
  let body = display == display_row_group;
  let header = display == display_header_group;
  let footer = display == display_footer_group;
  let row = display == display_row;
  let first = bor(caption, column);
  let second = bor(column_group, body);
  let third = bor(header, footer);
  let fourth = bor(first, second);
  let fifth = bor(third, row);
  let made = bor(fourth, fifth);
  return made;
}

fn walk_run(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, first: NodeId, context: &Context, open: &Open) -> result: Result<Option<NodeId>, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(context), writes(open) {
  doc "Adds the siblings from first on to the flow context and its open paragraph, as walk_children does the children of a parent, up to the first sibling that is a table part or a table cell, which is returned; None when the siblings end.";
  let nodes = document^.nodes.inner.len;
  let cursor = Some<NodeId>(value: first);
  for (step in 0_u64..nodes) {
    let node = match cursor {
      Some(value: found) => {
        give found;
      }
      None() => {
        let ended = None<NodeId>();
        return Ok<Option<NodeId>, LayoutError>(value: ended);
      }
    }
    let at = cvt::<u32, u64>(node.index);
    if at < nodes {
    } else {
      return inconsistent::<Option<NodeId>>();
    }
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Text(data: span) => {
        let start = cvt::<u32, u64>(span^.start);
        let end = cvt::<u32, u64>(span^.end);
        let size = end -sat start;
        if size > 0_u64 {
          let owner = current_style(open: open);
          let piece = Piece::Bytes(start: span^.start, end: span^.end, style: owner, node: node.index);
          let added = propagate add_piece(context: context, open: open, piece: piece, size: size);
        }
      }
      Element(..) => {
        let element = element_at(walk: walk, node: node);
        if element != unlisted {
          let style = element_ref(element: element);
          let group = box_of(styles: styles, style: style);
          let part = is_table_child(display: group.display);
          let cell = group.display == display_cell;
          let stop = bor(part, cell);
          if stop {
            let found_at = Some<NodeId>(value: node);
            return Ok<Option<NodeId>, LayoutError>(value: found_at);
          }
          let added = propagate walk_element(document: document, styles: styles, atoms: atoms, walk: walk, node: node, context: context, open: open);
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
  }
  return inconsistent::<Option<NodeId>>();
}

fn add_anonymous_row(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, first: NodeId, group: StyleRef, group_kind: u8, table: &Context, busy: &Box<Slots<u32>>) -> result: Result<Option<NodeId>, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(table), writes(busy) {
  doc "Adds the anonymous table-row (CSS 2.2 17.2.1) around the siblings from first on that are not proper children of a table or row group: each cell element among them is a cell of the row, and each run of other content (text with more than white space, inline and block boxes) is the content of an anonymous cell. Returns the first sibling that is a proper child, None when the siblings end.";
  let row_index = table^.rows.inner.len;
  if row_index < 4294967295_u64 {
  } else {
    return too_large::<Option<NodeId>>();
  }
  let row = cvt::<u64, u32>(row_index);
  let row_style = anonymous_of(style: table^.style);
  let made = TableRow(style: row_style, group: group, group_kind: group_kind, y: 0_i32, height: 0_i32);
  let pushed = propagate push_or_fail::<TableRow>(cell: &table^.rows, value: made);
  let nodes = document^.nodes.inner.len;
  let cursor = Some<NodeId>(value: first);
  let column = 0_u64;
  for (step in 0_u64..nodes) {
    let child = match cursor {
      Some(value: found) => {
        give found;
      }
      None() => {
        let ended = None<NodeId>();
        return Ok<Option<NodeId>, LayoutError>(value: ended);
      }
    }
    let at = cvt::<u32, u64>(child.index);
    if at < nodes {
    } else {
      return inconsistent::<Option<NodeId>>();
    }
    let next_sibling = document^.nodes.inner[at].links.next_sibling;
    let next_cursor = next_sibling;
    let data = &document^.nodes.inner[at].data;
    match data^ {
      Text(data: span) => {
        let start = cvt::<u32, u64>(span^.start);
        let end = cvt::<u32, u64>(span^.end);
        let ordered = start <= end;
        let inside = end <= document^.text.inner.len;
        let usable = band(ordered, inside);
        if usable {
          let blank = is_blank(bytes: &document^.text.inner[start..end]);
          if blank {
          } else {
            let content = new_context(kind: ctx_flow, style: row_style);
            let open = new_open(style: row_style, first: 0_u64);
            let rest = propagate walk_run(document: document, styles: styles, atoms: atoms, walk: walk, first: child, context: &content, open: &open);
            let ended = propagate end_paragraph(context: &content, open: &open);
            let next = propagate place_cell(table: table, busy: busy, row: row, column: column, content: move content, row_span: 1_u32, column_span: 1_u32);
            set column = next;
            set next_cursor = rest;
          }
        }
      }
      Element(..) => {
        let element = element_at(walk: walk, node: child);
        if element != unlisted {
          let style = element_ref(element: element);
          let box_group = box_of(styles: styles, style: style);
          let part = is_table_child(display: box_group.display);
          if part {
            let found_at = Some<NodeId>(value: child);
            return Ok<Option<NodeId>, LayoutError>(value: found_at);
          }
          if box_group.display == display_none {
          } else if box_group.display == display_cell {
            let column_span = span_attribute(document: document, node: child, name: atom_colspan, fallback: 1_u32, least: 1_u32, most: 1000_u32);
            let raw_rows = span_attribute(document: document, node: child, name: atom_rowspan, fallback: 1_u32, least: 0_u32, most: 65534_u32);
            let row_span = if raw_rows == 0_u32 {
              give 65534_u32;
            } else {
              give raw_rows;
            }
            set walk^.depth = walk^.depth +sat 1_u64;
            let not_item = False();
            let counted = propagate apply_counters(styles: styles, walk: walk, style: style, list_item: not_item);
            let content = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: child, element: element, style: style, kind: ctx_flow);
            leave_scope(walk: walk);
            set walk^.depth = walk^.depth -sat 1_u64;
            let next = propagate place_cell(table: table, busy: busy, row: row, column: column, content: move content, row_span: row_span, column_span: column_span);
            set column = next;
          } else {
            let content = new_context(kind: ctx_flow, style: row_style);
            let open = new_open(style: row_style, first: 0_u64);
            let rest = propagate walk_run(document: document, styles: styles, atoms: atoms, walk: walk, first: child, context: &content, open: &open);
            let ended = propagate end_paragraph(context: &content, open: &open);
            let next = propagate place_cell(table: table, busy: busy, row: row, column: column, content: move content, row_span: 1_u32, column_span: 1_u32);
            set column = next;
            set next_cursor = rest;
          }
        }
      }
      DocumentRoot(..) => {
      }
      DocumentType(..) => {
      }
      Comment(..) => {
      }
      Fragment() => {
      }
    }
    set cursor = next_cursor;
  }
  return inconsistent::<Option<NodeId>>();
}

fn add_row(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, style: StyleRef, group: StyleRef, group_kind: u8, table: &Context, busy: &Box<Slots<u32>>) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(table), writes(busy) {
  doc "Adds the row node and its cells: each cell takes the first column, from the left, that no cell of an earlier row spans into, and occupies its colspan columns for its rowspan rows; busy holds, for each column, the first row it is free again.";
  let row_index = table^.rows.inner.len;
  if row_index < 4294967295_u64 {
  } else {
    return too_large::<unit>();
  }
  let row = cvt::<u64, u32>(row_index);
  let made = TableRow(style: style, group: group, group_kind: group_kind, y: 0_i32, height: 0_i32);
  let pushed = propagate push_or_fail::<TableRow>(cell: &table^.rows, value: made);
  let nodes = document^.nodes.inner.len;
  let index = cvt::<u32, u64>(node.index);
  if index < nodes {
  } else {
    return inconsistent::<unit>();
  }
  let cursor = document^.nodes.inner[index].links.first_child;
  let column = 0_u64;
  for (step in 0_u64..nodes) {
    let child = match cursor {
      Some(value: next) => {
        give next;
      }
      None() => {
        break;
      }
    }
    let at = cvt::<u32, u64>(child.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
    let element = element_at(walk: walk, node: child);
    if element != unlisted {
      let cell_style = element_ref(element: element);
      let cell_group = box_of(styles: styles, style: cell_style);
      if cell_group.display == display_cell {
        let column_span = span_attribute(document: document, node: child, name: atom_colspan, fallback: 1_u32, least: 1_u32, most: 1000_u32);
        let raw_rows = span_attribute(document: document, node: child, name: atom_rowspan, fallback: 1_u32, least: 0_u32, most: 65534_u32);
        let row_span = if raw_rows == 0_u32 {
          give 65534_u32;
        } else {
          give raw_rows;
        }
        set walk^.depth = walk^.depth +sat 1_u64;
        let not_item = False();
        let counted = propagate apply_counters(styles: styles, walk: walk, style: cell_style, list_item: not_item);
        let content = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: child, element: element, style: cell_style, kind: ctx_flow);
        leave_scope(walk: walk);
        set walk^.depth = walk^.depth -sat 1_u64;
        let next = propagate place_cell(table: table, busy: busy, row: row, column: column, content: move content, row_span: row_span, column_span: column_span);
        set column = next;
      }
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn add_group(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, style: StyleRef, group_kind: u8, table: &Context, busy: &Box<Slots<u32>>) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(table), writes(busy) {
  doc "Adds the rows of the row group node.";
  let nodes = document^.nodes.inner.len;
  let index = cvt::<u32, u64>(node.index);
  if index < nodes {
  } else {
    return inconsistent::<unit>();
  }
  let cursor = document^.nodes.inner[index].links.first_child;
  for (step in 0_u64..nodes) {
    let child = match cursor {
      Some(value: next) => {
        give next;
      }
      None() => {
        break;
      }
    }
    let at = cvt::<u32, u64>(child.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
    let element = element_at(walk: walk, node: child);
    if element != unlisted {
      let row_style = element_ref(element: element);
      let row_group = box_of(styles: styles, style: row_style);
      if row_group.display == display_row {
        set walk^.depth = walk^.depth +sat 1_u64;
        let not_item = False();
        let counted = propagate apply_counters(styles: styles, walk: walk, style: row_style, list_item: not_item);
        let added = propagate add_row(document: document, styles: styles, atoms: atoms, walk: walk, node: child, style: row_style, group: style, group_kind: group_kind, table: table, busy: busy);
        leave_scope(walk: walk);
        set walk^.depth = walk^.depth -sat 1_u64;
      } else if row_group.display == display_none {
      } else {
        let part = is_table_child(display: row_group.display);
        if part {
        } else {
          let rest = propagate add_anonymous_row(document: document, styles: styles, atoms: atoms, walk: walk, first: child, group: style, group_kind: group_kind, table: table, busy: busy);
          set cursor = rest;
        }
      }
    } else {
      let data = &document^.nodes.inner[at].data;
      match data^ {
        Text(data: span) => {
          let start = cvt::<u32, u64>(span^.start);
          let end = cvt::<u32, u64>(span^.end);
          let ordered = start <= end;
          let inside = end <= document^.text.inner.len;
          let usable = band(ordered, inside);
          if usable {
            let blank = is_blank(bytes: &document^.text.inner[start..end]);
            if blank {
            } else {
              let rest = propagate add_anonymous_row(document: document, styles: styles, atoms: atoms, walk: walk, first: child, group: style, group_kind: group_kind, table: table, busy: busy);
              set cursor = rest;
            }
          }
        }
        Element(..) => {
        }
        DocumentRoot(..) => {
        }
        DocumentType(..) => {
        }
        Comment(..) => {
        }
        Fragment() => {
        }
      }
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn build_table(document: &Document, styles: &Styles, atoms: &AtomTable, walk: &Walk, node: NodeId, element: u32, table: &Context) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(atoms), writes(walk), writes(table) {
  doc "Builds a table's structure: captions as child contexts listed in captions; columns from col and colgroup; rows from the first header group, then the body groups and bare rows in order (further header and footer groups count as body groups), then the first footer group; each cell a child context listed in cells. Cells and other content that are children of the table or of a row group, not of a row, are in an anonymous row, other content in an anonymous cell of it (CSS 2.2 17.2.1).";
  let nodes = document^.nodes.inner.len;
  let index = cvt::<u32, u64>(node.index);
  if index < nodes {
  } else {
    return inconsistent::<unit>();
  }
  let first_child = document^.nodes.inner[index].links.first_child;
  let header = no_index;
  let footer = no_index;
  let scan = first_child;
  for (step in 0_u64..nodes) {
    let child = match scan {
      Some(value: next) => {
        give next;
      }
      None() => {
        break;
      }
    }
    let at = cvt::<u32, u64>(child.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set scan = document^.nodes.inner[at].links.next_sibling;
    let child_element = element_at(walk: walk, node: child);
    if child_element != unlisted {
      let child_style = element_ref(element: child_element);
      let group = box_of(styles: styles, style: child_style);
      let unset_header = header == no_index;
      let is_header = group.display == display_header_group;
      let take_header = band(unset_header, is_header);
      if take_header {
        set header = child.index;
      }
      let unset_footer = footer == no_index;
      let is_footer = group.display == display_footer_group;
      let take_footer = band(unset_footer, is_footer);
      if take_footer {
        set footer = child.index;
      }
    }
  }
  let busy = box_slots_new::<u32>(capacity: 0_u64);
  if header != no_index {
    let header_node = NodeId(index: header);
    let header_element = element_at(walk: walk, node: header_node);
    let header_style = element_ref(element: header_element);
    set walk^.depth = walk^.depth +sat 1_u64;
    let added = propagate add_group(document: document, styles: styles, atoms: atoms, walk: walk, node: header_node, style: header_style, group_kind: kind_header, table: table, busy: &busy);
    set walk^.depth = walk^.depth -sat 1_u64;
  }
  let cursor = first_child;
  for (step in 0_u64..nodes) {
    let child = match cursor {
      Some(value: next) => {
        give next;
      }
      None() => {
        break;
      }
    }
    let at = cvt::<u32, u64>(child.index);
    if at < nodes {
    } else {
      return inconsistent::<unit>();
    }
    set cursor = document^.nodes.inner[at].links.next_sibling;
    let chosen_header = child.index == header;
    let chosen_footer = child.index == footer;
    let chosen = bor(chosen_header, chosen_footer);
    let child_element = element_at(walk: walk, node: child);
    let listed = child_element != unlisted;
    let fresh = bnot(chosen);
    let usable = band(listed, fresh);
    if usable {
      let child_style = element_ref(element: child_element);
      let group = box_of(styles: styles, style: child_style);
      let display = group.display;
      if display == display_caption {
        set walk^.depth = walk^.depth +sat 1_u64;
        let caption = propagate build_box(document: document, styles: styles, atoms: atoms, walk: walk, node: child, element: child_element, style: child_style, kind: ctx_flow);
        set walk^.depth = walk^.depth -sat 1_u64;
        let caption_index = table^.children.inner.len;
        if caption_index < 4294967295_u64 {
        } else {
          return too_large::<unit>();
        }
        let kept = propagate push_or_fail::<Context>(cell: &table^.children, value: move caption);
        let caption_at = cvt::<u64, u32>(caption_index);
        let listed_caption = propagate push_or_fail::<u32>(cell: &table^.captions, value: caption_at);
      } else if display == display_column_group {
        let added = propagate add_column_group(document: document, styles: styles, walk: walk, node: child, style: child_style, table: table);
      } else if display == display_column {
        let span = span_attribute(document: document, node: child, name: atom_span, fallback: 1_u32, least: 1_u32, most: 1000_u32);
        let yes = True();
        let none = anonymous_of(style: table^.style);
        let added = propagate add_columns(table: table, style: child_style, styled: yes, group: none, count: span);
      } else if display == display_row {
        let group_style = anonymous_of(style: table^.style);
        set walk^.depth = walk^.depth +sat 1_u64;
        let added = propagate add_row(document: document, styles: styles, atoms: atoms, walk: walk, node: child, style: child_style, group: group_style, group_kind: kind_body, table: table, busy: &busy);
        set walk^.depth = walk^.depth -sat 1_u64;
      } else {
        let body = display == display_row_group;
        let extra_header = display == display_header_group;
        let extra_footer = display == display_footer_group;
        let extra = bor(extra_header, extra_footer);
        let any_group = bor(body, extra);
        if any_group {
          set walk^.depth = walk^.depth +sat 1_u64;
          let added = propagate add_group(document: document, styles: styles, atoms: atoms, walk: walk, node: child, style: child_style, group_kind: kind_body, table: table, busy: &busy);
          set walk^.depth = walk^.depth -sat 1_u64;
        } else if display == display_none {
        } else {
          let none = anonymous_of(style: table^.style);
          let rest = propagate add_anonymous_row(document: document, styles: styles, atoms: atoms, walk: walk, first: child, group: none, group_kind: kind_body, table: table, busy: &busy);
          set cursor = rest;
        }
      }
    } else if fresh {
      let data = &document^.nodes.inner[at].data;
      match data^ {
        Text(data: span) => {
          let start = cvt::<u32, u64>(span^.start);
          let end = cvt::<u32, u64>(span^.end);
          let ordered = start <= end;
          let inside = end <= document^.text.inner.len;
          let usable_text = band(ordered, inside);
          if usable_text {
            let blank = is_blank(bytes: &document^.text.inner[start..end]);
            if blank {
            } else {
              let none = anonymous_of(style: table^.style);
              let rest = propagate add_anonymous_row(document: document, styles: styles, atoms: atoms, walk: walk, first: child, group: none, group_kind: kind_body, table: table, busy: &busy);
              set cursor = rest;
            }
          }
        }
        Element(..) => {
        }
        DocumentRoot(..) => {
        }
        DocumentType(..) => {
        }
        Comment(..) => {
        }
        Fragment() => {
        }
      }
    }
  }
  if footer != no_index {
    let footer_node = NodeId(index: footer);
    let footer_element = element_at(walk: walk, node: footer_node);
    let footer_style = element_ref(element: footer_element);
    set walk^.depth = walk^.depth +sat 1_u64;
    let added = propagate add_group(document: document, styles: styles, atoms: atoms, walk: walk, node: footer_node, style: footer_style, group_kind: kind_footer, table: table, busy: &busy);
    set walk^.depth = walk^.depth -sat 1_u64;
  }
  let used = busy.inner.len;
  let have = table^.columns.inner.len;
  if used > have {
    let missing = used - have;
    if missing < 4294967295_u64 {
      let anonymous = anonymous_of(style: table^.style);
      let no = False();
      let missing_count = cvt::<u64, u32>(missing);
      let added = propagate add_columns(table: table, style: anonymous, styled: no, group: anonymous, count: missing_count);
    }
  }
  return Ok<unit, LayoutError>(value: unit);
}

fn count_tree(context: &Context) -> (contexts: u64, paragraphs: u64) reads(context) {
  doc "Counts the contexts and paragraphs of the tree rooted at context.";
  let contexts = 1_u64;
  let paragraphs = context^.paragraphs.inner.len;
  let count = context^.children.inner.len;
  for (k in 0_u64..count) {
    let (inner_contexts, inner_paragraphs) = count_tree(context: &context^.children.inner[k]);
    set contexts = contexts +sat inner_contexts;
    set paragraphs = paragraphs +sat inner_paragraphs;
  }
  return contexts, paragraphs;
}

fn build_layout(document: &Document, traversal: &Traversal, styles: &Styles, atoms: &AtomTable, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: Result<Layout, LayoutError> reads(document), reads(traversal), reads(styles), reads(atoms), reads(fonts), reads(picks) {
  doc "Maps each element's node to its preorder index, walks the document from its root into the initial containing block, a flow context whose root element is a child context of it, since the root element's margins do not collapse with its children's (CSS 2.2 8.3.1), and prepares every paragraph.";
  let nodes = document^.nodes.inner.len;
  if nodes <= item_ceiling {
  } else {
    return too_large::<Layout>();
  }
  let order = box_array_filled::<u32>(count: nodes, value: unlisted);
  let count = traversal^.elements.inner.len;
  if count < 4294967295_u64 {
  } else {
    return too_large::<Layout>();
  }
  for (position in 0_u64..count) {
    let element = traversal^.elements.inner[position];
    let at = cvt::<u32, u64>(element.index);
    if at < nodes {
      set order.inner[at] = cvt::<u64, u32>(position);
    } else {
      return inconsistent::<Layout>();
    }
  }
  let word_n = list_item_word.len;
  let list_item_atom = atom_find(table: atoms, name: &list_item_word[0_u64..word_n]);
  let list_item = match list_item_atom {
    Some(value: atom) => {
      give atom.index;
    }
    None() => {
      give unlisted;
    }
  }
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  let walk = Walk(order: move order, counters: move counters, quote_depth: 0_i32, depth: 0_u64, list_item: list_item);
  let root_element = element_ref(element: 0_u32);
  let style = anonymous_of(style: root_element);
  let initial = new_context(kind: ctx_flow, style: style);
  let open = new_open(style: style, first: 0_u64);
  let root = NodeId(index: 0_u32);
  let walked = propagate walk_children(document: document, styles: styles, atoms: atoms, walk: &walk, parent: root, context: &initial, open: &open);
  let ended = propagate end_paragraph(context: &initial, open: &open);
  let prepared = prepare_context(context: &initial, document: document, styles: styles, fonts: fonts, picks: picks);
  if prepared {
  } else {
    let failure = LayoutError::Text();
    return Err<Layout, LayoutError>(error: failure);
  }
  let (contexts, paragraphs) = count_tree(context: &initial);
  let made = Layout(root: move initial, viewport: viewport, paragraphs: paragraphs, contexts: contexts);
  return Ok<Layout, LayoutError>(value: move made);
}

fn layout_counts(layout: &Layout) -> (contexts: u64, paragraphs: u64) reads(layout) {
  doc "The counts build_layout recorded.";
  return layout^.contexts, layout^.paragraphs;
}
