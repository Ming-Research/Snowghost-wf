fn splice_payload(storage: &EntryStorage, sequence: &EntrySequence, slot: u32, visits: &BoundaryVisits) -> made: Flow reads(storage), reads(sequence.span), writes(visits) {
  doc "Opens a direct payload with its live-slot check included in physical index visits; the caller counts its semantic payload operation.";
  let missing = Flow::Close(block: no_index);
  let held = boundary_node(storage: storage, sequence: sequence, slot: slot, visits: visits);
  if held.live {
    let payload = slot_read::<Flow>(pages: &storage^.payloads, slot: slot, span: sequence^.span, missing: missing);
    return payload;
  }
  return missing;
}

fn direct_slot(storage: &EntryStorage, sequence: &EntrySequence, rank: u64, visits: &BoundaryVisits) -> slot: u32 reads(storage), reads(sequence.root), reads(sequence.span), writes(visits) {
  doc "Selects one direct stable slot by a transient rank, opening only index metadata.";
  let cursor = sequence^.root;
  let remaining = rank;
  for (level in 0_u64..64_u64) {
    let held = boundary_node(storage: storage, sequence: sequence, slot: cursor, visits: visits);
    if held.live {
    } else {
      return no_index;
    }
    let left = boundary_node(storage: storage, sequence: sequence, slot: held.left, visits: visits);
    if remaining < left.total_count {
      set cursor = held.left;
    } else if remaining == left.total_count {
      return cursor;
    } else {
      let preceding = left.total_count +sat 1_u64;
      set remaining = remaining -sat preceding;
      set cursor = held.right;
    }
  }
  return no_index;
}

fn range_output(storage: &EntryStorage, sequence: &EntrySequence, root: u32, from: u64, until: u64, visits: &BoundaryVisits) -> made: SequenceOutput reads(storage), reads(sequence.span), writes(visits) {
  doc "Reduces a direct rank interval using cached subtrees, with no payload reads. Only the two interval boundary paths are opened.";
  let empty = empty_output();
  if from >= until {
    return empty;
  }
  let node = boundary_node(storage: storage, sequence: sequence, slot: root, visits: visits);
  if node.live {
  } else {
    return empty;
  }
  if from >= node.total_count {
    return empty;
  }
  let total_field = False();
  let own_field = True();
  if from == 0_u64 {
    if until >= node.total_count {
      let total = boundary_output(storage: storage, sequence: sequence, slot: root, own: total_field, visits: visits);
      return total;
    }
  }
  let left = boundary_node(storage: storage, sequence: sequence, slot: node.left, visits: visits);
  let prefix = range_output(storage: storage, sequence: sequence, root: node.left, from: from, until: until, visits: visits);
  let through = prefix;
  if from <= left.total_count {
    if left.total_count < until {
      let own = boundary_output(storage: storage, sequence: sequence, slot: root, own: own_field, visits: visits);
      let joined = join_output(left: &prefix, right: &own);
      set through = joined;
    }
  }
  let after = left.total_count +sat 1_u64;
  let right_from = from -sat after;
  let right_until = until -sat after;
  let suffix = range_output(storage: storage, sequence: sequence, root: node.right, from: right_from, until: right_until, visits: visits);
  let output = join_output(left: &through, right: &suffix);
  return output;
}

fn splice_edges_equal(first: SequenceOutput, second: SequenceOutput) -> same: Bool pure {
  doc "The existing step-4 propagation requires unchanged exposed struts and solid content; height and baseline may change.";
  if first.through {
    return False();
  }
  if second.through {
    return False();
  }
  if first.leading_positive != second.leading_positive {
    return False();
  }
  if first.leading_negative != second.leading_negative {
    return False();
  }
  if first.trailing_positive != second.trailing_positive {
    return False();
  }
  if first.trailing_negative != second.trailing_negative {
    return False();
  }
  return True();
}

fn splice_edge(prefix: SequenceOutput, own: SequenceOutput) -> origin: i64 pure {
  doc "Resolves the preceding collapsing edge from both extrema. A leading through prefix shares the owner's first resolved edge.";
  if prefix.through {
    return 0_i64;
  }
  let positive = imax(prefix.trailing_positive, own.leading_positive);
  let negative = imin(prefix.trailing_negative, own.leading_negative);
  let wide_positive = cvt::<i32, i64>(positive);
  let wide_negative = cvt::<i32, i64>(negative);
  let gap = wide_positive +sat wide_negative;
  let origin = prefix.advance +sat gap;
  return origin;
}

fn relocate_handle(handle: EntryHandle, block_base: u32, entry_base: u32, owner: u32, slot: u32) -> made: EntryHandle pure {
  doc "Rebases only private handles; retained handles and absent sentinels are unchanged.";
  if handle.slot == no_index {
    return handle;
  }
  if handle.owner == no_index {
    return EntryHandle(owner: owner, slot: slot);
  }
  let parent = handle.owner +sat block_base;
  let rebased = handle.slot +sat entry_base;
  return EntryHandle(owner: parent, slot: rebased);
}

fn relocate_output(output: SequenceOutput, block_base: u32, entry_base: u32, owner: u32, slot: u32) -> made: SequenceOutput pure {
  doc "Rebases the four handles in one private transfer without changing its geometry or algebra.";
  let made = output;
  let first = relocate_handle(handle: output.first_line, block_base: block_base, entry_base: entry_base, owner: owner, slot: slot);
  let last = relocate_handle(handle: output.last_line, block_base: block_base, entry_base: entry_base, owner: owner, slot: slot);
  let first_float = relocate_handle(handle: output.first_float, block_base: block_base, entry_base: entry_base, owner: owner, slot: slot);
  let last_float = relocate_handle(handle: output.last_float, block_base: block_base, entry_base: entry_base, owner: owner, slot: slot);
  set made.first_line = first;
  set made.last_line = last;
  set made.first_float = first_float;
  set made.last_float = last_float;
  return made;
}

fn relocate_flow(item: Flow, blocks: u32, paragraphs: u32, children: u32) -> made: Flow pure {
  doc "Rebases one private payload reference into its context-wide stable pool.";
  match item {
    Open(block: b) => {
      let at = b +sat blocks;
      return Flow::Open(block: at);
    }
    Close(block: b) => {
      let at = b +sat blocks;
      return Flow::Close(block: at);
    }
    Text(paragraph: p) => {
      let at = p +sat paragraphs;
      return Flow::Text(paragraph: at);
    }
    Child(context: c) => {
      let at = c +sat children;
      return Flow::Child(context: at);
    }
    Float(context: c) => {
      let at = c +sat children;
      return Flow::Float(context: at);
    }
    Out(context: c) => {
      let at = c +sat children;
      return Flow::Out(context: at);
    }
  }
}

fn rebased_slot(slot: u32, base: u32) -> made: u32 pure {
  doc "Rebases a private stable slot while preserving absent links.";
  if slot == no_index {
    return no_index;
  }
  return slot +sat base;
}

fn relocate_storage(storage: &EntryStorage, input: SpliceInput) -> result: unit writes(storage) {
  doc "Rebases private pool slots and payload identifiers before their one-time publication.";
  let base = input.allocated +sat 1_u32;
  for (s in 0_u64..storage^.payloads.inner.len) {
    let value = relocate_flow(item: storage^.payloads.inner[s], blocks: input.blocks, paragraphs: input.paragraphs, children: input.children);
    set storage^.payloads.inner[s] = value;
  }
  for (s in 0_u64..storage^.links.inner.len) {
    let left = rebased_slot(slot: storage^.links.inner[s].left, base: base);
    let right = rebased_slot(slot: storage^.links.inner[s].right, base: base);
    let parent = rebased_slot(slot: storage^.links.inner[s].parent, base: base);
    set storage^.links.inner[s].left = left;
    set storage^.links.inner[s].right = right;
    set storage^.links.inner[s].parent = parent;
  }
  for (s in 0_u64..storage^.own.inner.len) {
    let value = relocate_output(output: storage^.own.inner[s], block_base: input.blocks, entry_base: base, owner: input.owner, slot: input.allocated);
    set storage^.own.inner[s] = value;
  }
  for (s in 0_u64..storage^.total.inner.len) {
    let value = relocate_output(output: storage^.total.inner[s], block_base: input.blocks, entry_base: base, owner: input.owner, slot: input.allocated);
    set storage^.total.inner[s] = value;
  }
  return unit;
}
