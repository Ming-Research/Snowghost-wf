alias changed_boxes_only = pkg::style::changed_boxes_only;
alias atom_find = pkg::base::atom::atom_find;
alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias NodeId = pkg::dom::NodeId;
alias Styles = pkg::style::Styles;
alias Traversal = pkg::style::Traversal;

struct SpliceOwner {
  doc "A DOM parent's single stable block owner in a live formatting context.";
  serial: u32;
  block: u32;
}

struct SpliceFrontier {
  doc "The certified following sibling's private top-margin replacement at its old origin; an absent slot denotes an unchanged retained frontier.";
  block: u32;
  slot: u32;
  output: SequenceOutput;
  margin_top: i32;
}

fn empty_splice_frontier() -> made: SpliceFrontier pure {
  doc "No retained sibling transfer needs replacement.";
  let output = empty_output();
  return SpliceFrontier(block: no_index, slot: no_index, output: output, margin_top: 0_i32);
}

struct SpliceInput {
  doc "Copied owner inputs and stable seam identities; no retained references cross private construction.";
  serial: u32;
  owner: u32;
  height_proof: HeightProof;
  frontier: SpliceFrontier;
  before: u32;
  removed: u32;
  allocated: u32;
  style: StyleRef;
  width: i32;
  left: i32;
  local_left: i64;
  first_edge: i64;
  basis_height: i32;
  blocks: u32;
  paragraphs: u32;
  children: u32;
}

struct SplicePlan {
  doc "A validated owner replacement, private direct-origin writes, its projected size change and the stationary float reach at the original seam. Publication consumes this plan once.";
  output: SequenceOutput;
  added: SequenceOutput;
  delta: i32;
  fixed_reach: i64;
  moves: Box<Array<SpliceMove>>;
  inserted_y: i64;
}

fn splice_owner(layout: &Layout, node: NodeId) -> made: SpliceOwner reads(layout) {
  doc "Resolves a DOM parent through exact context and block style uses, rejecting a parent represented by multiple block uses.";
  let at = cvt::<u32, u64>(node.index);
  let context_slot = route_read::<u32>(table: &layout^.context_of, at: at);
  if context_slot != no_index {
    return SpliceOwner(serial: context_slot, block: no_index);
  }
  let head = route_read::<StyleUse>(table: &layout^.uses, at: at);
  let cursor = head.head;
  let found = SpliceOwner(serial: no_index, block: no_index);
  let limit = layout^.routes.len;
  for (step in 0_u64..limit) {
    if cursor == no_index {
      return found;
    }
    let index = cvt::<u32, u64>(cursor);
    let route = route_read::<StyleRoute>(table: &layout^.routes, at: index);
    if route.block != no_index {
      if found.serial != no_index {
        return SpliceOwner(serial: no_index, block: no_index);
      }
      set found = SpliceOwner(serial: route.serial, block: route.block);
    }
    set cursor = route.next;
  }
  return SpliceOwner(serial: no_index, block: no_index);
}

fn splice_source(layout: &Layout, node: Option<NodeId>, serial: u32) -> made: Flow reads(layout) {
  doc "Resolves a sibling or removed node to one direct block, paragraph or child-context payload, using stable directories only.";
  let absent = Flow::Close(block: no_index);
  let source = match node {
    Some(value: present) => {
      give present;
    }
    None() => {
      return absent;
    }
  }
  let at = cvt::<u32, u64>(source.index);
  let text = route_read::<TextUnit>(table: &layout^.text_units, at: at);
  if text.serial == serial {
    return Flow::Text(paragraph: text.paragraph);
  }
  let owner = splice_owner(layout: layout, node: source);
  if owner.serial == serial {
    if owner.block != no_index {
      return Flow::Open(block: owner.block);
    }
  }
  if owner.block == no_index {
    let directory = cvt::<u32, u64>(owner.serial);
    let path = route_read::<ContextPath>(table: &layout^.paths, at: directory);
    if path.live {
      if path.parent == serial {
        return Flow::Child(context: path.child);
      }
    }
  }
  return absent;
}

fn splice_handle(context: &Context, item: Flow, visits: &BoundaryVisits) -> made: EntryHandle reads(context), writes(visits) {
  doc "Opens one routed payload and returns its stable owner/entry pair; malformed or non-flow sources cannot alias an entry.";
  set visits^.entries = visits^.entries +sat 1_u64;
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        set visits^.blocks = visits^.blocks +sat 1_u64;
        return EntryHandle(owner: context^.blocks.inner[at].parent, slot: context^.blocks.inner[at].entry_slot);
      }
    }
    Text(paragraph: p) => {
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        return EntryHandle(owner: context^.paragraphs.inner[at].block, slot: context^.paragraphs.inner[at].entry_slot);
      }
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        return EntryHandle(owner: context^.children.inner[at].block, slot: context^.children.inner[at].entry_slot);
      }
    }
    Close(..) => {
    }
    Float(..) => {
    }
    Out(..) => {
    }
  }
  let absent = absent_handle();
  return absent;
}

fn splice_boundary(context: &Context, item: Flow, removing: Bool, visits: &BoundaryVisits) -> reason: u32 reads(context), writes(visits) {
  doc "Accepts complete block entries, retained float boundaries and transparent lineless whitespace, refusing mixed inline boundaries and non-neutral removals. Float movement is separately certified against stationary reach.";
  set visits^.entries = visits^.entries +sat 1_u64;
  match item {
    Open(block: b) => {
      let at = cvt::<u32, u64>(b);
      if at < context^.blocks.inner.len {
        set visits^.blocks = visits^.blocks +sat 1_u64;
        if removing {
          if context^.blocks.inner[at].neutral {
          } else {
            return 5_u32;
          }
        }
        return 0_u32;
      }
    }
    Child(context: c) => {
      let at = cvt::<u32, u64>(c);
      if at < context^.children.inner.len {
        if removing {
          if context^.children.inner[at].neutral {
          } else {
            return 5_u32;
          }
        }
        return 0_u32;
      }
    }
    Text(paragraph: p) => {
      if removing {
        return 3_u32;
      }
      let at = cvt::<u32, u64>(p);
      if at < context^.paragraphs.inner.len {
        let lines = context^.paragraphs.inner[at].lines.inner.len;
        let marks = context^.paragraphs.inner[at].marks.inner.len;
        let no_lines = lines == 0_u64;
        let no_fragments = context^.paragraphs.inner[at].fragments.inner.len == 0_u64;
        let empty = band(no_lines, no_fragments);
        if empty {
          for (m in 0_u64..marks) {
            let mark = context^.paragraphs.inner[at].marks.inner[m];
            match mark {
              Node(..) => {
              }
              Open(..) => {
                return 3_u32;
              }
              Close(..) => {
                return 3_u32;
              }
              Atomic(..) => {
                return 3_u32;
              }
            }
          }
          return 0_u32;
        }
      }
    }
    Close(..) => {
    }
    Float(..) => {
      if removing {
        return 9_u32;
      } else {
        return 0_u32;
      }
    }
    Out(..) => {
    }
  }
  return 3_u32;
}

fn splice_context_ready(context: &Context, styles: &Styles, visits: &BoundaryVisits) -> reason: u32 reads(context), reads(styles), writes(visits) {
  doc "Checks step-4's ordinary-context requirements without changing retained marks or geometry.";
  if context^.kind == ctx_grid {
    let ready = splice_grid_ready(context: context, styles: styles);
    if ready {
      let heights = context_height_summary(context: context, styles: styles);
      if heights.unproved != 0_u32 {
        return 7_u32;
      }
      return 0_u32;
    }
    return 11_u32;
  }
  if context^.kind == ctx_flex {
    let ready = splice_container_ready(context: context);
    if ready {
      let heights = context_height_summary(context: context, styles: styles);
      if heights.unproved != 0_u32 {
        return 7_u32;
      }
      return 0_u32;
    }
    return 2_u32;
  }
  if context^.kind != ctx_flow {
    return 2_u32;
  }
  if context^.fragments_valid {
  } else {
    return 3_u32;
  }
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  if frame.columned {
    return 2_u32;
  }
  if context^.local_geometry {
  } else {
    return 7_u32;
  }
  let heights = context_height_summary(context: context, styles: styles);
  if heights.unproved != 0_u32 {
    return 7_u32;
  }
  let width_stable = splice_width_stable(context: context, styles: styles);
  if width_stable {
  } else {
    return 7_u32;
  }
  let unavailable = bor(context^.dirty, context^.restyled);
  if unavailable {
    return 7_u32;
  }
  let total_field = False();
  let output = boundary_output(sequence: &context^.entries, slot: context^.entries.root, own: total_field, visits: visits);
  if output.through {
    return 7_u32;
  }
  let origin = cvt::<i32, i64>(frame.content_top);
  let bounded = transfer_fits(origin: origin, travel: output.travel);
  if bounded {
  } else {
    return 7_u32;
  }
  return 0_u32;
}

fn splice_inputs(context: &Context, steps: &[ContextStep], depth: u64, owner: u32, before: Flow, removed: Flow, ending: Bool, removing: Bool, grid_inline_stable: Bool, styles: &Styles, visits: &BoundaryVisits) -> result: Result<SpliceInput, u32> reads(context), reads(steps), reads(styles), writes(visits) {
  doc "One checked descent resolves all owner inputs and the two stable seam handles before private construction. A nonterminal route's identity and supported live entry class precede its context preflight: in a flow parent, an atomic, floated or positioned route is reason 2 even when that parent's transfer is Through. A grid requires an existing item entry and proved incoming inline stability, otherwise reason 11. Every supported parent and the target still pass the full context preflight; this precedence admits no additional cases.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
    } else {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
    if context^.slot != route.parent {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
    if context^.children.inner[child].slot != route.slot {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
    if context^.kind == ctx_flow {
      let in_flow = splice_child_entry(context: context, child: child, visits: visits);
      if in_flow {
      } else {
        return Err<SpliceInput, u32>(error: 2_u32);
      }
    }
    if context^.kind == ctx_grid {
      if grid_inline_stable {
      } else {
        return Err<SpliceInput, u32>(error: 11_u32);
      }
      let in_flow = splice_child_entry(context: context, child: child, visits: visits);
      if in_flow {
      } else {
        return Err<SpliceInput, u32>(error: 11_u32);
      }
    }
  } else if context^.kind == ctx_grid {
    return Err<SpliceInput, u32>(error: 11_u32);
  }
  let ready = splice_context_ready(context: context, styles: styles, visits: visits);
  if ready != 0_u32 {
    return Err<SpliceInput, u32>(error: ready);
  }
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      if context^.slot == route.parent {
        if context^.children.inner[child].slot == route.slot {
          let next = depth +sat 1_u64;
          let inside_stable = if context^.kind == ctx_flex {
            let active = splice_child_entry(context: context, child: child, visits: visits);
            let edge = splice_grid_flex_width(context: context, child: &context^.children.inner[child], styles: styles);
            set edge = band(edge, active);
            give band(grid_inline_stable, edge);
          } else {
            give grid_inline_stable;
          }
          let found = splice_inputs(context: &context^.children.inner[child], steps: steps, depth: next, owner: owner, before: before, removed: removed, ending: ending, removing: removing, grid_inline_stable: inside_stable, styles: styles, visits: visits);
          return found;
        }
      }
    }
    return Err<SpliceInput, u32>(error: 1_u32);
  }
  let frame = flow_frame(styles: styles, style: context^.style, space: context^.space, width: context^.width);
  if context^.kind != ctx_flow {
    return Err<SpliceInput, u32>(error: 2_u32);
  }
  let root_style = context^.style;
  let wide_left = cvt::<i32, i64>(frame.content_left);
  let wide_top = cvt::<i32, i64>(frame.content_top);
  let blocks = cvt.wrap::<u64, u32>(context^.blocks.inner.len);
  let paragraphs = cvt.wrap::<u64, u32>(context^.paragraphs.inner.len);
  let children = cvt.wrap::<u64, u32>(context^.children.inner.len);
  let frontier = empty_splice_frontier();
  let basis_input = containing_height_proof(context: context, styles: styles, owner: no_index, height: frame.definite);
  let input = SpliceInput(serial: context^.slot, owner: owner, height_proof: basis_input, frontier: frontier, before: no_index, removed: no_index, allocated: context^.entries.allocated, style: root_style, width: frame.flow_width, left: 0_i32, local_left: wide_left, first_edge: wide_top, basis_height: frame.definite, blocks: blocks, paragraphs: paragraphs, children: children);
  let total_field = False();
  let total = boundary_output(sequence: &context^.entries, slot: context^.entries.root, own: total_field, visits: visits);
  if owner != no_index {
    let at = cvt::<u32, u64>(owner);
    if at < context^.blocks.inner.len {
      set visits^.blocks = visits^.blocks +sat 1_u64;
      let snapshot = block_snapshot(block: &context^.blocks.inner[at]);
      let output = context^.blocks.inner[at].output;
      set input.style = snapshot.style;
      let owner_height = definite_block_height(styles: styles, style: snapshot.style, basis_width: snapshot.avail_width, basis_height: output.basis_height);
      set input.basis_height = owner_height;
      set input.height_proof = containing_height_proof(context: context, styles: styles, owner: owner, height: owner_height);
      set input.width = snapshot.content_width;
      set input.left = snapshot.content_left;
      let local = snapshot.content_left -sat snapshot.inner_x;
      let wide_local = cvt::<i32, i64>(local);
      set input.local_left = wide_local;
      let top = cvt::<i32, i64>(output.top_frame);
      set input.first_edge = top;
      set input.allocated = context^.blocks.inner[at].entries.allocated;
      let owned_total = boundary_output(sequence: &context^.blocks.inner[at].entries, slot: context^.blocks.inner[at].entries.root, own: total_field, visits: visits);
      set total = owned_total;
      if output.top_frame == 0_i32 {
        set input.first_edge = 0_i64;
      } else {
        let margin = total.leading_positive +sat total.leading_negative;
        let wide_margin = cvt::<i32, i64>(margin);
        set input.first_edge = input.first_edge +sat wide_margin;
      }
    } else {
      return Err<SpliceInput, u32>(error: 1_u32);
    }
  } else {
    let margin = total.leading_positive +sat total.leading_negative;
    let wide_margin = cvt::<i32, i64>(margin);
    set input.first_edge = input.first_edge +sat wide_margin;
  }
  if ending {
  } else {
    let target = splice_handle(context: context, item: before, visits: visits);
    if target.owner != owner {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    if target.slot == no_index {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    set input.before = target.slot;
  }
  if removing {
    let target = splice_handle(context: context, item: removed, visits: visits);
    if target.owner != owner {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    if target.slot == no_index {
      return Err<SpliceInput, u32>(error: 3_u32);
    }
    let reason = splice_boundary(context: context, item: removed, removing: removing, visits: visits);
    if reason != 0_u32 {
      return Err<SpliceInput, u32>(error: reason);
    }
    set input.removed = target.slot;
  }
  return Ok<SpliceInput, u32>(value: input);
}

fn build_splice(document: &Document, styles: &Styles, atoms: &AtomTable, node: NodeId, input: SpliceInput, fonts: &FontSet, picks: &FontPicks, viewport: Viewport, skipped_nodes: &Box<Slots<u32>>) -> result: Result<Context, LayoutError> reads(document), reads(styles), reads(atoms), reads(fonts), reads(picks), writes(skipped_nodes) {
  doc "Builds only the inserted subtree in private storage. Child contexts and paragraph preparation retain the ordinary independent counted loops; the document walk orders only construction and counter state.";
  let counters = box_slots_new::<Counter>(capacity: 0_u64);
  let skipped = box_slots_new::<u32>(capacity: 0_u64);
  let list_item = match atom_find(table: atoms, name: &list_item_word[0_u64..list_item_word.len]) {
    Some(value: found) => {
      give found.index;
    }
    None() => {
      give no_index;
    }
  }
  let walk = Walk(effects: 0_u64, counters: move counters, quote_depth: 0_i32, depth: 0_u64, list_item: list_item, skipped: move skipped);
  let style = anonymous_of(style: input.style);
  let fresh = new_context(kind: ctx_flow, style: style);
  let open = new_open(style: style);
  let built = propagate walk_element(document: document, styles: styles, atoms: atoms, walk: &walk, node: node, context: &fresh, open: &open);
  let closed = propagate end_paragraph(context: &fresh, open: &open);
  let neutral = walk.effects == 0_u64;
  set fresh.neutral = neutral;
  finish_tree_sequences(context: &fresh);
  let no = False();
  let space = Space(available: input.width, basis_width: input.width, basis_height: input.basis_height, forced_width: input.width, forced_height: input.basis_height, shrink: no);
  set fresh.space = space;
  let external = input.height_proof;
  set external.source_kind = 4_u8;
  set_height_input(child: &fresh, proof: external);
  let prepared = prepare_context(context: &fresh, document: document, styles: styles, fonts: fonts, picks: picks);
  if prepared {
  } else {
    let failure = LayoutError::Text();
    return Err<Context, LayoutError>(error: failure);
  }
  lay_out_context(context: &fresh, styles: styles, document: document, fonts: fonts, picks: picks, viewport: viewport);
  forget_splice_points(context: &fresh);
  swap(first: skipped_nodes, second: &walk.skipped);
  return Ok<Context, LayoutError>(value: move fresh);
}

fn splice_sibling_ready(context: &Context, steps: &[ContextStep], depth: u64, owner: u32, sibling: u32, styles: &Styles, visits: &BoundaryVisits) -> ready: Bool reads(context), reads(steps), reads(styles), writes(visits) {
  doc "Certifies a retained direct ordinary block whose only changed layout input is its top margin. The boxes-only flag excludes text consumers, while the current display, float, overflow and column state must still construct a neutral plain flow block; horizontal geometry, frames, relative displacement and height constraints must retain their old inputs. Its replacement joins the private seam plan before validation and is published with the direct suffix moves.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      if context^.slot == route.parent {
        if context^.children.inner[child].slot == route.slot {
          let next = depth +sat 1_u64;
          let found = splice_sibling_ready(context: &context^.children.inner[child], steps: steps, depth: next, owner: owner, sibling: sibling, styles: styles, visits: visits);
          return found;
        }
      }
    }
    return False();
  }
  let at = cvt::<u32, u64>(sibling);
  if at < context^.blocks.inner.len {
  } else {
    return False();
  }
  set visits^.blocks = visits^.blocks +sat 1_u64;
  if context^.blocks.inner[at].parent != owner {
    return False();
  }
  let previous = block_measured(context: context, at: at);
  let boundary = block_boundary(context: context, at: at);
  if previous.valid {
  } else {
    return False();
  }
  if boundary.ordinary {
  } else {
    return False();
  }
  let snapshot = block_snapshot(block: &context^.blocks.inner[at]);
  let width_kept = snapshot_keeps_width(block: snapshot, styles: styles);
  if width_kept {
  } else {
    return False();
  }
  let lined = True();
  let grows = snapshot_grows(block: snapshot, styles: styles, delta: 0_i32, basis_height: previous.basis_height, lines: lined);
  if grows {
  } else {
    return False();
  }
  let border = border_edges(styles: styles, style: snapshot.style);
  let padding = padding_edges(styles: styles, style: snapshot.style, basis: snapshot.avail_width);
  let margins = margin_edges(styles: styles, style: snapshot.style, basis: snapshot.avail_width);
  let top = border.top +sat padding.top;
  let bottom = border.bottom +sat padding.bottom;
  if top != previous.top_frame {
    return False();
  }
  if bottom != previous.bottom_frame {
    return False();
  }
  if margins.bottom != previous.margin_bottom {
    return False();
  }
  let group = box_of(styles: styles, style: snapshot.style);
  if group.display != display_block {
    return False();
  }
  if group.float != float_none {
    return False();
  }
  let independent = establishes(group: group);
  if independent {
    return False();
  }
  let columned = multicol(styles: styles, style: snapshot.style);
  if columned {
    return False();
  }
  if context^.blocks.inner[at].neutral {
  } else {
    return False();
  }
  if group.position != position_static {
    return False();
  }
  if group.clear != clear_none {
    return False();
  }
  return True();
}

fn splice_sibling_frontier(context: &Context, steps: &[ContextStep], depth: u64, sibling: u32, styles: &Styles, visits: &BoundaryVisits) -> made: SpliceFrontier reads(context), reads(steps), reads(styles), writes(visits) {
  doc "Copies the certified sibling's new top-margin transfer without changing retained summaries or geometry. Its interior and measured geometry remain unchanged at this stage.";
  if depth < steps^.len {
    let route = steps^[depth];
    let child = cvt::<u32, u64>(route.child);
    if child < context^.children.inner.len {
      let next = depth +sat 1_u64;
      let found = splice_sibling_frontier(context: &context^.children.inner[child], steps: steps, depth: next, sibling: sibling, styles: styles, visits: visits);
      return found;
    }
  } else {
    let at = cvt::<u32, u64>(sibling);
    if at < context^.blocks.inner.len {
      set visits^.blocks = visits^.blocks +sat 1_u64;
      let measured = block_measured(context: context, at: at);
      let style = context^.blocks.inner[at].style;
      let margins = margin_edges(styles: styles, style: style, basis: measured.available);
      set measured.margin_top = margins.top;
      let total_field = False();
      let inside = boundary_output(sequence: &context^.blocks.inner[at].entries, slot: context^.blocks.inner[at].entries.root, own: total_field, visits: visits);
      if measured.natural != 0_i64 {
        let unsupported = empty_splice_frontier();
        return unsupported;
      }
      if measured.top_frame == 0_i32 {
        let positive = inside.leading_positive != 0_i32;
        let negative = inside.leading_negative != 0_i32;
        let collapsing = bor(positive, negative);
        if collapsing {
          let unsupported = empty_splice_frontier();
          return unsupported;
        }
      }
      let output = lift_block_output(inside: &inside, measured: measured);
      let slot = context^.blocks.inner[at].entry_slot;
      return SpliceFrontier(block: sibling, slot: slot, output: output, margin_top: margins.top);
    }
  }
  let empty = empty_splice_frontier();
  return empty;
}

fn structure_splice(layout: &Layout, document: &Document, styles: &Styles, traversal: &Traversal, atoms: &AtomTable, changed: &[u32], parent: NodeId, before: Option<NodeId>, inserted: Option<NodeId>, removed: Option<NodeId>, references_stable: Bool, fonts: &FontSet, picks: &FontPicks) -> result: Result<u32, LayoutError> reads(document), reads(styles), reads(traversal), reads(atoms), reads(changed), reads(fonts), reads(picks), writes(layout) {
  doc "Attempts a neutral complete-block seam transaction. Zero means published locally; codes 1 owner/route, 2 container, 3 inline seam, 4 generated references, 5 counters/quotes, 6 retained style frontier, 7 boundary dependency, 8 storage ceiling and 9 float suffix dependency refuse before retained geometry or routing changes. Reason 10 completes a published splice through reference layout after a flex output fails its outer certificate; the caller reconstructs from that complete current state. Private construction errors leave retained state untouched.";
  if references_stable {
  } else {
    return Ok<u32, LayoutError>(value: 4_u32);
  }
  if document^.nodes.inner.len > item_ceiling {
    return Ok<u32, LayoutError>(value: 8_u32);
  }
  let parent_style = element_ref(element: parent.index);
  let parent_group = box_of(styles: styles, style: parent_style);
  if parent_group.display == display_contents {
    return Ok<u32, LayoutError>(value: 1_u32);
  }
  let owner = splice_owner(layout: layout, node: parent);
  if owner.serial == no_index {
    return Ok<u32, LayoutError>(value: 1_u32);
  }
  let removing = match removed {
    Some(..) => {
      give True();
    }
    None() => {
      give False();
    }
  }
  let inserting = match inserted {
    Some(..) => {
      give True();
    }
    None() => {
      give False();
    }
  }
  let same_kind = removing == inserting;
  if same_kind {
    return Ok<u32, LayoutError>(value: 1_u32);
  }
  let steps = propagate path_steps(layout: layout, serial: owner.serial);
  let depth = steps.inner.len;
  let visits = no_boundary_visits();
  let frontier_block = no_index;
  let changes = changed^.len;
  for (k in 0_u64..changes) {
    let bare = iand(changed^[k], 2147483647_u32);
    let at = cvt::<u32, u64>(bare);
    if at < traversal^.elements.inner.len {
      let node = traversal^.elements.inner[at];
      let within = match inserted {
        Some(value: root) => {
          let index = cvt::<u32, u64>(node.index);
          let ancestor = cvt::<u32, u64>(root.index);
          let inside = inside_element(document: document, node: index, element: ancestor);
          give inside;
        }
        None() => {
          give False();
        }
      }
      if within {
      } else {
        let boxes = iand(changed^[k], changed_boxes_only);
        if boxes == 0_u32 {
          return Ok<u32, LayoutError>(value: 6_u32);
        }
        let sibling = splice_owner(layout: layout, node: node);
        if sibling.serial != owner.serial {
          return Ok<u32, LayoutError>(value: 6_u32);
        }
        let sibling_ready = splice_sibling_ready(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, owner: owner.block, sibling: sibling.block, styles: styles, visits: &visits);
        if sibling_ready {
        } else {
          return Ok<u32, LayoutError>(value: 6_u32);
        }
        if frontier_block != no_index {
          return Ok<u32, LayoutError>(value: 6_u32);
        }
        set frontier_block = sibling.block;
      }
    } else {
      return Ok<u32, LayoutError>(value: 1_u32);
    }
  }
  let ending = match before {
    Some(..) => {
      give False();
    }
    None() => {
      give True();
    }
  }
  let before_item = splice_source(layout: layout, node: before, serial: owner.serial);
  let removed_item = splice_source(layout: layout, node: removed, serial: owner.serial);
  let inline_stable = True();
  let input = match splice_inputs(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, owner: owner.block, before: before_item, removed: removed_item, ending: ending, removing: removing, grid_inline_stable: inline_stable, styles: styles, visits: &visits) {
    Ok(value: found) => {
      give found;
    }
    Err(error: reason) => {
      return Ok<u32, LayoutError>(value: reason);
    }
  }
  if frontier_block != no_index {
    let frontier = splice_sibling_frontier(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, sibling: frontier_block, styles: styles, visits: &visits);
    if frontier.slot != input.before {
      return Ok<u32, LayoutError>(value: 6_u32);
    }
    if frontier.slot == no_index {
      return Ok<u32, LayoutError>(value: 6_u32);
    }
    set input.frontier = frontier;
  }
  let private_style = anonymous_of(style: input.style);
  let skipped_nodes = box_slots_new::<u32>(capacity: 0_u64);
  let fresh = match inserted {
    Some(value: node) => {
      let built = propagate build_splice(document: document, styles: styles, atoms: atoms, node: node, input: input, fonts: fonts, picks: picks, viewport: layout^.viewport, skipped_nodes: &skipped_nodes);
      give move built;
    }
    None() => {
      let empty = new_context(kind: ctx_flow, style: private_style);
      set empty.definite_free = True();
      give move empty;
    }
  }
  let added = empty_output();
  let item = Flow::Close(block: no_index);
  if inserting {
    if fresh.neutral {
    } else {
      return Ok<u32, LayoutError>(value: 5_u32);
    }
    if fresh.splits.inner.len > 0_u64 {
      return Ok<u32, LayoutError>(value: 3_u32);
    }
    if fresh.fragments.inner.len > 0_u64 {
      return Ok<u32, LayoutError>(value: 7_u32);
    }
    if fresh.empty_fragment_sources > 0_u64 {
      return Ok<u32, LayoutError>(value: 7_u32);
    }
    let total_field = False();
    let output = boundary_output(sequence: &fresh.entries, slot: fresh.entries.root, own: total_field, visits: &visits);
    if output.count != 1_u64 {
      return Ok<u32, LayoutError>(value: 3_u32);
    }
    if output.through {
      return Ok<u32, LayoutError>(value: 7_u32);
    }
    if output.heights.unproved != 0_u32 {
      return Ok<u32, LayoutError>(value: 7_u32);
    }
    let first = splice_payload(sequence: &fresh.entries, slot: fresh.entries.root, visits: &visits);
    let reason = splice_boundary(context: &fresh, item: first, removing: removing, visits: &visits);
    if reason != 0_u32 {
      return Ok<u32, LayoutError>(value: reason);
    }
    let remapped_output = relocate_output(output: output, block_base: input.blocks, owner: input.owner, slot: input.allocated);
    let old_y = splice_payload_y(context: &fresh, item: first);
    let reverse_y = 0_i64 -sat old_y;
    let normalized = shift_motion(output: remapped_output, delta: reverse_y);
    set added = normalized;
    let remapped_item = relocate_flow(item: first, blocks: input.blocks, paragraphs: input.paragraphs, children: input.children);
    set item = remapped_item;
  }
  let new_blocks = layout_pool_fits(base: input.blocks, added: fresh.blocks.inner.len);
  let new_paragraphs = layout_pool_fits(base: input.paragraphs, added: fresh.paragraphs.inner.len);
  let new_children = layout_pool_fits(base: input.children, added: fresh.children.inner.len);
  let first_pools = band(new_blocks, new_paragraphs);
  let fits = band(first_pools, new_children);
  if fits {
  } else {
    return Ok<u32, LayoutError>(value: 8_u32);
  }
  let plan = match splice_plan_at(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, input: input, added: added, removing: removing, visits: &visits) {
    Ok(value: found) => {
      give move found;
    }
    Err(error: reason) => {
      return Ok<u32, LayoutError>(value: reason);
    }
  }
  let (ready, preview_height, preview_baseline, preview_first_baseline, preview_has_first_baseline, deferred) = splice_path_ready(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, owner: input.owner, output: plan.output, delta: plan.delta, fixed_reach: plan.fixed_reach, styles: styles, visits: &visits);
  if ready {
  } else {
    return Ok<u32, LayoutError>(value: 7_u32);
  }
  let root = if 0_u64 < traversal^.elements.inner.len {
    give traversal^.elements.inner[0_u64].index;
  } else {
    give no_index;
  }
  let skipped_count = skipped_nodes.inner.len;
  let patch = propagate splice_routes(fresh: &fresh, input: input, serial: owner.serial, document: document, node: inserted, root: root, route_base: layout^.routes.len, path_base: layout^.paths.len, skipped: &skipped_nodes.inner[0_u64..skipped_count]);
  let removed_nodes = box_slots_new::<u32>(capacity: 0_u64);
  match removed {
    Some(value: node) => {
      let listed = propagate splice_dom_nodes(document: document, node: node, nodes: &removed_nodes);
    }
    None() => {
    }
  }
  let (private_contexts, added_paragraphs) = count_tree(context: &fresh);
  let added_contexts = private_contexts -sat 1_u64;
  relocate_splice(fresh: &fresh, input: input, y: plan.inserted_y);
  let (lost_contexts, lost_paragraphs, published_work, extra_counts) = publish_splice_at(context: &layout^.root, steps: &steps.inner[0_u64..depth], depth: 0_u64, input: input, fresh: &fresh, item: item, added: added, plan: &plan, removed: removed_item, removing: removing, paths: &layout^.paths, styles: styles, document: document, fonts: fonts, picks: picks, viewport: layout^.viewport);
  let removed_count = removed_nodes.inner.len;
  publish_splice_routes(layout: layout, patch: &patch, removed_nodes: &removed_nodes.inner[0_u64..removed_count]);
  let kept_contexts = layout^.contexts -sat lost_contexts;
  let kept_paragraphs = layout^.paragraphs -sat lost_paragraphs;
  set layout^.contexts = kept_contexts +sat added_contexts;
  set layout^.paragraphs = kept_paragraphs +sat added_paragraphs;
  let work = add_boundary_visits(first: visits, second: published_work);
  let contexts = added_contexts +sat depth;
  let touched = contexts +sat 1_u64;
  let counts = UpdateCounts(prepared: added_paragraphs, work: work, contexts: touched, paragraphs: added_paragraphs, held_entries: 0_u64, entries: added.events);
  let total_counts = add_counts(first: counts, second: extra_counts);
  set layout^.pending_structure = total_counts;
  set layout^.last_structure = StructureCounts(contexts: added_contexts, paragraphs: added_paragraphs, reused: 0_u64);
  if published_work.fallbacks > 0_u64 {
    return Ok<u32, LayoutError>(value: 10_u32);
  }
  return Ok<u32, LayoutError>(value: 0_u32);
}

fn layout_pool_fits(base: u32, added: u64) -> fits: Bool pure {
  doc "Checks context-wide append-only payload capacity before any publication.";
  let wide = cvt::<u32, u64>(base);
  let total = wide +sat added;
  let fits = total <= item_ceiling;
  return fits;
}

fn forget_splice_points(context: &Context) -> result: unit writes(context) {
  doc "Neutral construction needs no counter input, but its synthetic checkpoint must never seed a later stateful rebuild. Q86 ascends to the nearest exact enclosing checkpoint instead.";
  set context^.walk_exact = False();
  let children = context^.children.inner.len;
  for (at in 0_u64..children) {
    forget_splice_points(context: &context^.children.inner[at]);
  }
  return unit;
}
