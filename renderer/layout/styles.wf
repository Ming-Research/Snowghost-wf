  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.container);
  if at < styles^.containers.inner.len {
    let found = styles^.containers.inner[at];
    return found;
  }
  let made = initial_container();
  return made;
}

fn initial_line() -> made: GridLine pure {
  doc "The grid line auto.";
  let no = False();
  let no_atom = Atom(index: 4294967295_u32);
  return GridLine(kind: line_auto, number: 0_i32, name: no_atom, named: no);
}

fn initial_item() -> made: ItemGroup pure {
  doc "The initial flex and grid item values.";
  let auto = auto_sizing();
  let line = initial_line();
  return ItemGroup(order: 0_i32, grow: 0.0_f32, shrink: 1.0_f32, basis: auto, align_self: align_auto, justify_self: align_auto, row_start: line, row_end: line, column_start: line, column_end: line);
}

fn item_of(styles: &Styles, style: StyleRef) -> group: ItemGroup reads(styles) {
  doc "Returns style's flex and grid item group; an anonymous box's is the initial one.";
  if style.anonymous {
    let made = initial_item();
    return made;
  }
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.item);
  if at < styles^.items.inner.len {
    let found = styles^.items.inner[at];
    return found;
  }
  let made = initial_item();
  return made;
}

fn table_of(styles: &Styles, style: StyleRef) -> group: TableGroup reads(styles) {
  doc "Returns style's table group: inherited border-collapse, border-spacing and caption-side, and table-layout, auto for an anonymous box.";
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.table);
  let found = if at < styles^.tables.inner.len {
    give styles^.tables.inner[at];
  } else {
    give TableGroup(border_collapse: 0_u8, spacing_horizontal: 0.0_f32, spacing_vertical: 0.0_f32, table_layout: 0_u8, caption_side: 0_u8);
  }
  if style.anonymous {
    let made = TableGroup(border_collapse: found.border_collapse, spacing_horizontal: found.spacing_horizontal, spacing_vertical: found.spacing_vertical, table_layout: 0_u8, caption_side: found.caption_side);
    return made;
  }
  return found;
}

fn content_of(styles: &Styles, style: StyleRef) -> group: ContentGroup reads(styles) {
  doc "Returns style's generated-content group; an anonymous box has content normal, no counters and its parent's quotes and list-style-position.";
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.content);
  let found = if at < styles^.contents.inner.len {
    give styles^.contents.inner[at];
  } else {
    give ContentGroup(content: 0_u32, counter_reset: 0_u32, counter_increment: 0_u32, counter_set: 0_u32, quotes: 0_u32, list_style_position: 0_u8);
  }
  if style.anonymous {
    let made = ContentGroup(content: 0_u32, counter_reset: 0_u32, counter_increment: 0_u32, counter_set: 0_u32, quotes: found.quotes, list_style_position: found.list_style_position);
    return made;
  }
  return found;
}

fn units(px: f32) -> raw: i32 pure {
  doc "Returns px CSS pixels as layout units, 1/64 px, truncated toward zero as the reference converts a computed length (Q54), saturating at the representable range; NaN gives zero.";
  let scaled = fmul.strict(px, unit_scale);
  let same = feq(scaled, scaled);
  let nan = bnot(same);
  if nan {
    return 0_i32;
  }
  let high = fgt(px, unit_ceiling);
  if high {
    return 2147483647_i32;
  }
  let floor_value = fneg(unit_ceiling);
  let low = flt(px, floor_value);
  if low {
    return -2147483647_i32;
  }
  let whole = ftrunc(scaled);
  let fits = cvt.defined::<f32, i32>(whole);
  if fits {
    let made = cvt::<f32, i32>(whole);
    return made;
  }
  return 0_i32;
}

fn units_nearest(px: f32) -> raw: i32 pure {
  doc "Returns px CSS pixels as layout units rounded to the nearest, as the reference rounds a line-height given as a length (research/investigations/layout/runs/line-height-rounding.txt), saturating; NaN gives zero.";
  let scaled = fmul.strict(px, unit_scale);
  let same = feq(scaled, scaled);
  let nan = bnot(same);
  if nan {
    return 0_i32;
  }
  let high = fgt(px, unit_ceiling);
  if high {
    return 2147483647_i32;
  }
  let floor_value = fneg(unit_ceiling);
  let low = flt(px, floor_value);
  if low {
    return -2147483647_i32;
  }
  let half = fadd.strict(scaled, 0.5_f32);
  let whole = ffloor(half);
  let fits = cvt.defined::<f32, i32>(whole);
  if fits {
    let made = cvt::<f32, i32>(whole);
    return made;
  }
  return 0_i32;
}

fn units_up(px: f32) -> raw: i32 pure {
  doc "Returns px CSS pixels as layout units rounded up, as the reference rounds a text fragment's width (Q54), saturating; NaN gives zero.";
  let scaled = fmul.strict(px, unit_scale);
  let same = feq(scaled, scaled);
  let nan = bnot(same);
  if nan {
    return 0_i32;
  }
  let high = fgt(px, unit_ceiling);
  if high {
    return 2147483647_i32;
  }
  let floor_value = fneg(unit_ceiling);
  let low = flt(px, floor_value);
  if low {
    return -2147483647_i32;
  }
  let whole = fceil(scaled);
  let fits = cvt.defined::<f32, i32>(whole);
  if fits {
    let made = cvt::<f32, i32>(whole);
    return made;
  }
  return 0_i32;
}

fn pixels(raw: i32) -> px: f32 pure {
  doc "Returns raw layout units as CSS pixels.";
  let wide = cvt.nearest::<i32, f32>(raw);
  let made = fdiv.strict(wide, unit_scale);
  return made;
}

fn resolve_lp(value: LengthPercentage, basis: i32) -> raw: i32 pure {
  doc "Resolves a computed length-percentage against basis, in layout units, computing in single precision as the reference does and truncating once (Q54).";
  if value.has_percent {
    let base = pixels(raw: basis);
    let share = fdiv.strict(value.percent, 1.0e2_f32);
    let part = fmul.strict(base, share);
    let total = fadd.strict(value.px, part);
    let made = units(px: total);
    return made;
  }
  let made = units(px: value.px);
  return made;
}

fn add_units(left: i32, right: i32) -> sum: i32 pure {
  doc "Returns left plus right, saturating.";
  let made = left +sat right;
  return made;
}

fn sub_units(left: i32, right: i32) -> difference: i32 pure {
  doc "Returns left minus right, saturating.";
  let made = left -sat right;
  return made;
}

fn max_units(left: i32, right: i32) -> greatest: i32 pure {
  doc "Returns the larger of left and right.";
  let made = imax(left, right);
  return made;
}

fn min_units(left: i32, right: i32) -> least: i32 pure {
  doc "Returns the smaller of left and right.";
  let made = imin(left, right);
  return made;
}
