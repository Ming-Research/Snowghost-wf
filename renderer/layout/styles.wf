alias align_auto = pkg::css::values::align_auto;
alias Atom = pkg::base::atom::Atom;
alias sizing_keyword = pkg::css::values::sizing_keyword;
alias sizing_normal = pkg::css::values::sizing_normal;

const display_inline: u8 = 0_u8;

const display_block: u8 = 1_u8;

const display_none: u8 = 2_u8;

const display_contents: u8 = 3_u8;

const display_list_item: u8 = 4_u8;

const display_inline_block: u8 = 5_u8;

const display_flow_root: u8 = 6_u8;

const display_table: u8 = 7_u8;

const display_inline_table: u8 = 8_u8;

const display_row_group: u8 = 9_u8;

const display_header_group: u8 = 10_u8;

const display_footer_group: u8 = 11_u8;

const display_row: u8 = 12_u8;

const display_cell: u8 = 13_u8;

const display_column_group: u8 = 14_u8;

const display_column: u8 = 15_u8;

const display_caption: u8 = 16_u8;

const display_flex: u8 = 17_u8;

const display_inline_flex: u8 = 18_u8;

const display_grid: u8 = 19_u8;

const display_inline_grid: u8 = 20_u8;

const display_ruby: u8 = 21_u8;

const display_ruby_text: u8 = 22_u8;

const display_math: u8 = 23_u8;

const display_webkit_box: u8 = 24_u8;

const display_webkit_inline_box: u8 = 25_u8;

const position_static: u8 = 0_u8;

const position_relative: u8 = 1_u8;

const position_absolute: u8 = 2_u8;

const position_fixed: u8 = 3_u8;

const position_sticky: u8 = 4_u8;

const float_none: u8 = 0_u8;

const float_left: u8 = 1_u8;

const float_right: u8 = 2_u8;

const clear_none: u8 = 0_u8;

const clear_left: u8 = 1_u8;

const clear_right: u8 = 2_u8;

const clear_both: u8 = 3_u8;

const overflow_visible: u8 = 0_u8;

const overflow_clip: u8 = 2_u8;

const box_sizing_border: u8 = 1_u8;

const align_start_text: u8 = 0_u8;

const align_end_text: u8 = 1_u8;

const align_left_text: u8 = 2_u8;

const align_right_text: u8 = 3_u8;

const align_center_text: u8 = 4_u8;

const align_justify_text: u8 = 5_u8;

const align_webkit_left: u8 = 7_u8;

const align_webkit_right: u8 = 8_u8;

const align_webkit_center: u8 = 9_u8;

const white_normal: u8 = 0_u8;

const white_pre: u8 = 1_u8;

const white_nowrap: u8 = 2_u8;

const white_pre_wrap: u8 = 3_u8;

const white_pre_line: u8 = 4_u8;

const white_break_spaces: u8 = 5_u8;

const unit_scale: f32 = 64.0_f32;

const unit_ceiling: f32 = 33554431.0_f32;

fn computed_of(styles: &Styles, style: StyleRef) -> computed: ComputedStyle reads(styles) {
  doc "Returns the computed style ids style names: the element's, or its pseudo-element's when pseudo is set; the first element's for an index outside the lists.";
  if style.pseudo != no_pseudo {
    let at = cvt::<u32, u64>(style.pseudo);
    if at < styles^.pseudos.inner.len {
      let made = styles^.pseudos.inner[at].style;
      return made;
    }
  }
  let at = cvt::<u32, u64>(style.element);
  if at < styles^.elements.inner.len {
    let made = styles^.elements.inner[at];
    return made;
  }
  let fallback = ComputedStyle(box: 0_u32, size: 0_u32, spacing: 0_u32, border: 0_u32, font: 0_u32, text: 0_u32, background: 0_u32, custom: 0_u32, container: 0_u32, item: 0_u32, table: 0_u32, content: 0_u32);
  return fallback;
}

fn initial_box() -> made: BoxGroup pure {
  doc "The box group of an anonymous block: block display, static, no float or clear, visible overflow, content-box.";
  let no = False();
  let auto = True();
  return BoxGroup(display: display_block, position: position_static, float: float_none, clear: clear_none, overflow_x: overflow_visible, overflow_y: overflow_visible, box_sizing: 0_u8, visibility: 0_u8, z_auto: auto, z_index: 0_i32, unicode_bidi: 0_u8);
}

fn box_of(styles: &Styles, style: StyleRef) -> group: BoxGroup reads(styles) {
  doc "Returns style's box group; an anonymous box's is the initial one, its visibility inherited.";
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.box);
  let found = if at < styles^.boxes.inner.len {
    give styles^.boxes.inner[at];
  } else {
    let made = initial_box();
    give made;
  }
  if style.anonymous {
    let made = initial_box();
    let visible = BoxGroup(display: made.display, position: made.position, float: made.float, clear: made.clear, overflow_x: made.overflow_x, overflow_y: made.overflow_y, box_sizing: made.box_sizing, visibility: found.visibility, z_auto: made.z_auto, z_index: made.z_index, unicode_bidi: made.unicode_bidi);
    return visible;
  }
  return found;
}

fn auto_sizing() -> made: Sizing pure {
  doc "The sizing value auto.";
  let no = False();
  let zero = LengthPercentage(px: 0.0_f32, percent: 0.0_f32, has_percent: no);
  return Sizing(kind: sizing_auto, keyword: 0_u8, value: zero);
}

fn none_sizing() -> made: Sizing pure {
  doc "The sizing value none.";
  let no = False();
  let zero = LengthPercentage(px: 0.0_f32, percent: 0.0_f32, has_percent: no);
  return Sizing(kind: sizing_none, keyword: 0_u8, value: zero);
}

fn zero_sizing() -> made: Sizing pure {
  doc "The sizing value 0px.";
  let no = False();
  let zero = LengthPercentage(px: 0.0_f32, percent: 0.0_f32, has_percent: no);
  return Sizing(kind: sizing_value, keyword: 0_u8, value: zero);
}

fn zero_lp() -> made: LengthPercentage pure {
  doc "The length-percentage 0px.";
  let no = False();
  return LengthPercentage(px: 0.0_f32, percent: 0.0_f32, has_percent: no);
}

fn initial_size() -> made: SizeGroup pure {
  doc "The size group of an anonymous box: auto sizes, no maximum, auto offsets, no aspect ratio.";
  let auto = auto_sizing();
  let none = none_sizing();
  let yes = True();
  return SizeGroup(width: auto, height: auto, min_width: auto, min_height: auto, max_width: none, max_height: none, aspect_auto: yes, aspect_width: 0.0_f32, aspect_height: 0.0_f32, top: auto, right: auto, bottom: auto, left: auto);
}

fn size_of(styles: &Styles, style: StyleRef) -> group: SizeGroup reads(styles) {
  doc "Returns style's size group; an anonymous box's is the initial one.";
  if style.anonymous {
    let made = initial_size();
    return made;
  }
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.size);
  if at < styles^.sizes.inner.len {
    let found = styles^.sizes.inner[at];
    return found;
  }
  let made = initial_size();
  return made;
}

fn initial_spacing() -> made: SpacingGroup pure {
  doc "The spacing group of an anonymous box: no margin or padding.";
  let zero = zero_sizing();
  let lp = zero_lp();
  return SpacingGroup(margin_top: zero, margin_right: zero, margin_bottom: zero, margin_left: zero, padding_top: lp, padding_right: lp, padding_bottom: lp, padding_left: lp);
}

fn spacing_of(styles: &Styles, style: StyleRef) -> group: SpacingGroup reads(styles) {
  doc "Returns style's spacing group; an anonymous box's is the initial one.";
  if style.anonymous {
    let made = initial_spacing();
    return made;
  }
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.spacing);
  if at < styles^.spacings.inner.len {
    let found = styles^.spacings.inner[at];
    return found;
  }
  let made = initial_spacing();
  return made;
}

fn black_ref() -> made: ColorRef pure {
  doc "currentcolor over black, the fallback color of a group outside its table.";
  let space = ColorSpace::Rgb();
  let color = Color(space: space, first: 0.0_f32, second: 0.0_f32, third: 0.0_f32, alpha: 1.0_f32, missing: 0_u8);
  let yes = True();
  return ColorRef(current: yes, color: color);
}

fn no_border() -> made: BorderGroup pure {
  doc "A border group with no border on any side.";
  let color = black_ref();
  return BorderGroup(top_width: 0.0_f32, right_width: 0.0_f32, bottom_width: 0.0_f32, left_width: 0.0_f32, top_style: 0_u8, right_style: 0_u8, bottom_style: 0_u8, left_style: 0_u8, top_color: color, right_color: color, bottom_color: color, left_color: color);
}

fn border_widths_of(styles: &Styles, style: StyleRef) -> group: BorderGroup reads(styles) {
  doc "Returns style's border group, whose widths are already zero for the styles none and hidden; an anonymous box has no border.";
  if style.anonymous {
    let none = no_border();
    return none;
  }
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.border);
  if at < styles^.borders.inner.len {
    let found = styles^.borders.inner[at];
    return found;
  }
  let none = no_border();
  return none;
}

fn font_index(styles: &Styles, style: StyleRef) -> font: u32 reads(styles) {
  doc "Returns the index of style's font group, which pkg::layout::text's picks are indexed by; an anonymous box inherits its parent's.";
  let computed = computed_of(styles: styles, style: style);
  return computed.font;
}

fn font_of(styles: &Styles, style: StyleRef) -> group: FontGroup reads(styles) {
  doc "Returns style's font group.";
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.font);
  if at < styles^.fonts.inner.len {
    let found = styles^.fonts.inner[at];
    return found;
  }
  if 0_u64 < styles^.fonts.inner.len {
    let first = styles^.fonts.inner[0_u64];
    return first;
  }
  let no_percent = False();
  let none = LengthPercentage(px: 0.0_f32, percent: 0.0_f32, has_percent: no_percent);
  let normal = Sizing(kind: sizing_normal, keyword: 0_u8, value: none);
  let made = FontGroup(families_start: 0_u32, families_end: 0_u32, size: 16.0_f32, weight: 4.0e2_f32, style: 0_u8, line_height: normal);
  return made;
}

fn text_of(styles: &Styles, style: StyleRef) -> group: TextGroup reads(styles) {
  doc "Returns style's text group (all inherited, so an anonymous box's is its parent's), with vertical-align and text-decoration-line, which are not inherited, at their initial values for an anonymous box.";
  let computed = computed_of(styles: styles, style: style);
  let at = cvt::<u32, u64>(computed.text);
  let found = if at < styles^.texts.inner.len {
    give styles^.texts.inner[at];
  } else {
    let made = initial_text();
    give made;
  }
  if style.anonymous {
    let zero_value = zero_lp();
    let keyword_baseline = Sizing(kind: sizing_keyword, keyword: 0_u8, value: zero_value);
    let made = TextGroup(color: found.color, text_align: found.text_align, text_indent: found.text_indent, text_transform: found.text_transform, white_space: found.white_space, letter_spacing: found.letter_spacing, word_spacing: found.word_spacing, vertical_align: keyword_baseline, decoration_line: 0_u8, list_style_type: found.list_style_type, overflow_wrap: found.overflow_wrap, word_break: found.word_break);
    return made;
  }
  return found;
}

fn initial_text() -> made: TextGroup pure {
  doc "The initial text group, for a text group outside its table.";
  let color = black_ref();
  let zero = zero_lp();
  let normal = Sizing(kind: sizing_normal, keyword: 0_u8, value: zero);
  let baseline = Sizing(kind: sizing_keyword, keyword: 0_u8, value: zero);
  let no_atom = Atom(index: 4294967295_u32);
  return TextGroup(color: color.color, text_align: 0_u8, text_indent: zero, text_transform: 0_u8, white_space: 0_u8, letter_spacing: normal, word_spacing: normal, vertical_align: baseline, decoration_line: 0_u8, list_style_type: no_atom, overflow_wrap: 0_u8, word_break: 0_u8);
}

fn initial_container() -> made: ContainerGroup pure {
  doc "The initial flex and grid container values.";
  let zero_value = zero_lp();
  let normal = Sizing(kind: sizing_normal, keyword: 0_u8, value: zero_value);
  return ContainerGroup(flex_direction: 0_u8, flex_wrap: 0_u8, justify_content: align_normal, align_items: align_normal, align_content: align_normal, justify_items: align_normal, row_gap: normal, column_gap: normal, template_columns: 0_u32, template_rows: 0_u32, template_areas: 0_u32, auto_flow: 0_u8, auto_columns: 0_u32, auto_rows: 0_u32);
}

fn zero_lp_value() -> made: LengthPercentage pure {
  doc "The length-percentage 0px.";
  let made = zero_lp();
  return made;
}

fn container_of(styles: &Styles, style: StyleRef) -> group: ContainerGroup reads(styles) {
  doc "Returns style's flex and grid container group; an anonymous box's is the initial one.";
  if style.anonymous {
    let made = initial_container();
    return made;
