alias AtomTable = pkg::base::atom::AtomTable;
alias Document = pkg::dom::Document;
alias NodeId = pkg::dom::NodeId;
alias FontPicks = pkg::layout::text::FontPicks;
alias FontSet = pkg::layout::text::FontSet;
alias Styles = pkg::style::Styles;
alias Traversal = pkg::style::Traversal;
alias ShapedText = pkg::layout::text::ShapedText;
alias TextRun = pkg::layout::text::TextRun;

public const placed_element: u8 = 0_u8;

public const placed_text: u8 = 1_u8;

public enum LayoutError {
  TooLarge();
  Inconsistent();
  Text();
}

public struct Viewport {
  public width: f32;
  public height: f32;
}

const ctx_flow: u8 = 0_u8;

const ctx_flex: u8 = 1_u8;

const ctx_grid: u8 = 2_u8;

const ctx_table: u8 = 3_u8;

const ctx_replaced: u8 = 4_u8;

const natural_object: u8 = 0_u8;

const natural_icon: u8 = 1_u8;

const natural_empty: u8 = 2_u8;

const natural_alt_icon: u8 = 3_u8;

const natural_alt_box: u8 = 4_u8;

const natural_marker: u8 = 5_u8;

const natural_text_input: u8 = 6_u8;

const natural_toggle: u8 = 7_u8;

const no_pseudo: u32 = 4294967295_u32;

const no_index: u32 = 4294967295_u32;

const laid_never: i32 = -2147483647_i32;

const object_mark: u32 = 65532_u32;

const line_separator: u32 = 8232_u32;

const scalar_ceiling: u64 = 1073741824_u64;

const item_ceiling: u64 = 1073741824_u64;

struct StyleRef {
  doc "The style a box takes: element's computed style, or the computed style of entry pseudo of the style stage's pseudo-element list when pseudo is not no_pseudo. An anonymous box inherits from that style and takes the initial value of every property that is not inherited: no margin, border or padding, and auto sizes.";
  element: u32;
  pseudo: u32;
  anonymous: Bool;
}

enum Flow {
  doc "One entry of a flow context's content in tree order. Open and Close bracket a block-level box of the context's blocks; Text is a paragraph; Child is an in-flow block-level child context; Float is a floated child context, anchored where it occurs; Out is an absolutely or fixed positioned child context, whose static position is where it occurs.";
  Open(block: u32);
  Close(block: u32);
  Text(paragraph: u32);
  Child(context: u32);
  Float(context: u32);
  Out(context: u32);
}

struct Block {
  doc "A block-level box inside a flow context that establishes no context of its own, with its laid-out border box relative to the context's border box; marker holds for a list item with an outside marker, whose marker makes a line when its content has none; parent is the block it sits in (no_index when it sits directly in the context) and flow_at its Open entry, which the pre-pass records.";
  style: StyleRef;
  x: i32;
  y: i32;
  width: i32;
  height: i32;
  marker: Bool;
  parent: u32;
  flow_at: u32;
}

enum Mark {
  doc "One entry of a paragraph's inline structure, at text index at: Open and Close bracket the inline box of an element or generated box; Atomic is an atomic inline, the child context drawn at the U+FFFC at at; Node maps the text from at to end to the text node node (its NodeId index), or to no node for generated content and inserted characters.";
  Open(at: u32, style: StyleRef);
  Close(at: u32, style: StyleRef);
  Atomic(at: u32, context: u32);
  Node(at: u32, end: u32, node: u32);
}

enum Piece {
  doc "The source of a paragraph's text before white-space processing, in tree order: the bytes start to end of the document's text, a text node's data (node its NodeId index) or an attribute value read by generated content (node no_index); the bytes start to end of the style stage's generated text; one inserted scalar value (U+FFFC for an atomic inline, U+2028 for br, or a generated character); the start and end of an inline box; and an atomic inline, the child context drawn at its U+FFFC. Each carries the style whose white-space and text-transform govern it.";
  Bytes(start: u32, end: u32, style: StyleRef, node: u32);
  Generated(start: u32, end: u32, style: StyleRef);
  Scalar(value: u32, style: StyleRef);
  Begin(style: StyleRef);
  End(style: StyleRef);
  Object(context: u32, style: StyleRef);
}

struct Line {
  doc "One line box of a paragraph: the text from start to end (end excluded, trailing collapsible spaces not counted in width), its offset x and width of content inside the line box, its top and height relative to the paragraph's first line top, its baseline from the line box's top, and the least top it may take, which the floats beside the lines before it leave it.";
  start: u32;
  end: u32;
  x: i32;
  width: i32;
  room: i32;
  top: i32;
  height: i32;
  baseline: i32;
  least_top: i32;
}

struct Atomic {
  doc "Where a paragraph's line layout put an atomic inline: the child context's index and its border box's offset from the paragraph's origin.";
  context: u32;
  x: i32;
  y: i32;
}

struct Exclusion {
  doc "A float's margin box as later content sees it, relative to the context's content box: its vertical extent, whether it floats left, and its inner edge (a left float's right edge, a right float's left edge).";
  left: Bool;
  top: i32;
  bottom: i32;
  edge: i32;
}

struct ColumnPiece {
  doc "One column of a multi-column context's column map: the content between from and to (layout units, in the context's border box, as laid out in one column) moves by dx and dy; bottom is the column's bottom edge after the move, where a box that continues in the next column ends.";
  from: i32;
  to: i32;
  dx: i32;
  dy: i32;
  bottom: i32;
}

struct Split {
  doc "A block-level box inside an open inline box, the block-in-inline of CSS 2.2 9.2.1.1: the inline box's element owner, the flow entries open and close of the block (one entry for a child context), the left offset and width of the content box it sits in, which the reference reports as one of owner's rectangles, and the top of the line the inline box would continue on before the block, after the margins before it collapse.";
  owner: u32;
  open: u32;
  close: u32;
  left: i32;
  width: i32;
  line: i32;
}

struct Fragment {
  doc "One rectangle a box or text node reports, relative to the border box of the context that holds it: kind is pkg::layout's placed_element or placed_text, owner the element's index or the text node's NodeId index.";
  kind: u8;
  owner: u32;
  x: i32;
  y: i32;
  width: i32;
  height: i32;
}

struct Paragraph {
  doc "An inline formatting context's content inside a flow context, its anonymous block: the pieces from first, count of them, in its context's pieces, recorded by the walk, become text, runs, run_styles and marks in the preparation loop, which also shapes the text; layout fills lines, its fragments relative to its origin, and its height. The pre-pass gives it width and left, the content-box offset its lines break at, and records its flow entry (flow_at) and the block it sits in (block, no_index for none); the stacking pass gives it its origin x and top in the context's border box when it has lines, and beside, whether a float placed before it reaches below its top.";
  style: StyleRef;
  first: u64;
  count: u64;
  text: Box<Slots<u32>>;
  runs: Box<Slots<TextRun>>;
  run_styles: Box<Slots<StyleRef>>;
  marks: Box<Slots<Mark>>;
  shaped: ShapedText;
  lines: Box<Slots<Line>>;
  fragments: Box<Slots<Fragment>>;
  atomics: Box<Slots<Atomic>>;
  width: i32;
  left: i32;
  top: i32;
  height: i32;
  min_content: i32;
  max_content: i32;
  dirty: Bool;
  x: i32;
  flow_at: u32;
  block: u32;
  beside: Bool;
}

struct TableCell {
  doc "A cell of a table context: the child context holding its content, its first row and column and its spans.";
  context: u32;
  row: u32;
  column: u32;
  row_span: u32;
  column_span: u32;
}

struct TableRow {
  doc "A row of a table context: the style of its row box and of its row group (anonymous when generated), and its group's kind: 0 body, 1 header, 2 footer.";
  style: StyleRef;
  group: StyleRef;
  group_kind: u8;
  y: i32;
  height: i32;
}

struct TableColumn {
  doc "A column of a table context, from a col element, a colgroup's span or a cell: the style of its column box when it has one, the style of the colgroup that holds the col element (anonymous when there is none), and its laid-out offset and width.";
  style: StyleRef;
  styled: Bool;
  group: StyleRef;
  x: i32;
  width: i32;
}

struct Space {
  doc "What a parent gives a child context to lay out in: the inline space available to its margin box, the percentage bases of widths (and margins and paddings) and of heights (-1 when indefinite), a border-box width and height the parent imposes (-1 when none), and whether an auto width shrinks to fit its content.";
  available: i32;
  basis_width: i32;
  basis_height: i32;
  forced_width: i32;
  forced_height: i32;
  shrink: Bool;
}

struct Context {
  doc "A box that establishes an independent formatting context, owning the boxes inside it and its child contexts. kind is ctx_flow for a block container, ctx_flex, ctx_grid, ctx_table for a table wrapper (its captions are children listed in captions, its cells children listed in cells), or ctx_replaced. natural says what an image the stage does not load shows, as the reference draws an image whose fetch failed: natural_object is any other context (a replaced one 300 by 150 px); natural_icon the 16 px broken-image icon of an img without alt; natural_empty the nothing of an img with an empty alt or no source; natural_alt_icon the icon before an img's alt text; natural_alt_box an inline img showing its alt text, a flow context that ignores its width and height; natural_marker the bullet of an inside disc, circle or square list marker; natural_text_input a single-line text input, as wide as twenty characters of its font and as tall as its line; and natural_toggle a checkbox or radio button, 13 px square. splits lists the blocks inside open inline boxes in its flow, in the order they open; column_map, for a multi-column context, moves its content from the one column it is laid out in to its columns. Layout writes its border box size, its position relative to its parent context's border box, its fragments and, when a parent asked, its intrinsic sizes. ratio_width and ratio_height are the width and height attributes of an img, video or svg the stage does not load (HTML Standard, 15.5.4: they give its aspect ratio), in layout units, or 0 when it lacks either. For pkg::layout's update: laid is the space of its last finished layout (laid_never before the first), flow_at and block the flow entry its parent's pre-pass gives it (its paragraph's for an atomic inline) and the parent's block it sits in, beside whether a float placed before it in its parent's flow reaches below its top; a flow context's stacking pass records the content height it returned before used_height (content_raw), the flow entry whose baseline is the context's (no_index for none) and whether its flow holds an out-of-flow child (has_out); intrinsic_basis is the percentage basis its intrinsic sizes were computed against when they became known; definite_free, which a flow context's pre-pass records, holds when no block or child context of its flow takes a percentage height, min-height or max-height, so that its content height being definite or not changes nothing but its own height. text_changed counts the paragraphs and the child contexts it marks in it (marked_paragraphs, marked_children) and records the last of each it marked (marked_paragraph, marked_child), so that an update with one of each finds it without a search; when an update prepares a marked context again it records whether its intrinsic sizes were known from the previous layout (intrinsic_held) and what they were (held_min, held_max), which a flex or grid container's update compares.";
  kind: u8;
  natural: u8;
  style: StyleRef;
  flow: Box<Slots<Flow>>;
  pieces: Box<Slots<Piece>>;
  blocks: Box<Slots<Block>>;
  paragraphs: Box<Slots<Paragraph>>;
  children: Box<Slots<Context>>;
  rows: Box<Slots<TableRow>>;
  columns: Box<Slots<TableColumn>>;
  cells: Box<Slots<TableCell>>;
  captions: Box<Slots<u32>>;
  fragments: Box<Slots<Fragment>>;
  splits: Box<Slots<Split>>;
  column_map: Box<Slots<ColumnPiece>>;
  space: Space;
  margin_top: i32;
  margin_right: i32;
  margin_bottom: i32;
  margin_left: i32;
  x: i32;
  y: i32;
  width: i32;
  height: i32;
  baseline: i32;
  has_baseline: Bool;
  viewport_origin: Bool;
  min_content: i32;
  max_content: i32;
  intrinsic_known: Bool;
  ratio_width: i32;
  ratio_height: i32;
  dirty: Bool;
  laid: Space;
  flow_at: u32;
  block: u32;
  beside: Bool;
  content_raw: i32;
  baseline_entry: u32;
  has_out: Bool;
  intrinsic_basis: i32;
  definite_free: Bool;
  marked_paragraphs: u32;
  marked_paragraph: u32;
  marked_children: u32;
  marked_child: u32;
  intrinsic_held: Bool;
  held_min: i32;
  held_max: i32;
}

struct TextUnit {
  doc "Where a text node's data enters the layout: the serial of the context whose pieces hold it, the first of its pieces there and how many, and the paragraph those pieces belong to; serial is no_index for a node that feeds no paragraph, and skipped_text (pkg::layout's build.wf) for one the walk met where its data made no piece, so that data which would make one is a box-tree change.";
  serial: u32;
  piece: u32;
  count: u32;
  paragraph: u32;
}

struct ContextPath {
  doc "Where a context sits in the owned tree, by its serial (its position in a preorder walk of the tree, the initial containing block 0): its parent's serial (no_index for the initial containing block) and its index among its parent's children.";
  parent: u32;
  child: u32;
}

struct UpdateCounts {
  doc "What one update did: the paragraphs it prepared again, the contexts it laid out again (a context laid out in full counting with every context below it), the paragraphs it broke into lines again, the flow entries the stacking pass walked in the contexts holding a paragraph it prepared again, and the flow entries every stacking pass it ran walked.";
  prepared: u64;
  contexts: u64;
  paragraphs: u64;
  held_entries: u64;
  entries: u64;
}

public struct Layout {
  root: Context;
  viewport: Viewport;
  paragraphs: u64;
  contexts: u64;
  text_units: Box<Array<TextUnit>>;
  paths: Box<Slots<ContextPath>>;
  dirty: Bool;
  last_update: UpdateCounts;
}

public struct PlacedRect {
  public kind: u8;
  public owner: u32;
  public x: f32;
  public y: f32;
  public width: f32;
  public height: f32;
}

public fn build_boxes(document: &Document, traversal: &Traversal, styles: &Styles, atoms: &AtomTable, viewport: Viewport) -> result: Result<Layout, LayoutError> reads(document), reads(traversal), reads(styles), reads(atoms) doc "Builds the owned tree of formatting contexts of document (design/pipeline/layout.md) from its computed styles, which pkg::style::compute_styles returns for traversal's elements and their ::before and ::after boxes, in the viewport: one walk in tree order generates the boxes, with CSS Display 3's and CSS 2.2's anonymous boxes, generated content whose counters and quotes the walk resolves as it visits each element in tree order (Q63), and each paragraph's text as pieces. It also records, for text_changed and update, where each text node enters the layout (text_units, indexed by NodeId index) and where each context sits (paths, by serial), with no mark set. No paragraph is prepared: pkg::layout::prepare_text does that, and lay_out needs a prepared layout. TooLarge past the storage limits; Inconsistent when the document, traversal and styles disagree.";

public fn prepare_text(layout: &Layout, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(fonts), reads(picks), writes(layout) doc "Prepares every paragraph of layout, which build_boxes returned: in each context, one counted loop turns each paragraph's pieces into its text, after CSS Text 3's white-space processing and text-transform, and shapes it with pkg::layout::text::shape_paragraph (Q53). picks is pkg::layout::text::pick_fonts for the font groups of the styles layout was built from. Text when shaping refuses a paragraph.";

public fn build_layout(document: &Document, traversal: &Traversal, styles: &Styles, atoms: &AtomTable, fonts: &FontSet, picks: &FontPicks, viewport: Viewport) -> result: Result<Layout, LayoutError> reads(document), reads(traversal), reads(styles), reads(atoms), reads(fonts), reads(picks) doc "Builds the layout of document with build_boxes and prepares its text with prepare_text, so that lay_out can run on it. picks is pkg::layout::text::pick_fonts for styles' font groups. TooLarge, Inconsistent and Text as those two functions return them.";

public fn lay_out(layout: &Layout, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: unit reads(document), reads(styles), reads(fonts), reads(picks), writes(layout) doc "Lays out every context of the prepared layout in the viewport given to build_boxes: CSS 2.2's block and inline formatting with floats and positioning, CSS Flexbox 1, CSS Grid 1 without subgrid and CSS Tables 3's table layout, each context writing its boxes and fragments with offsets from its own border box (Q55) and computing intrinsic sizes when a parent's algorithm needs them (Q56); computed lengths become LayoutUnit when read by the reference's conversion for their use (a line height given as a length rounds to the nearest unit, one given as a number is the font size rounded to the nearest unit times the number, truncated, every other length truncates) and a text fragment's width is its advances' sum rounded up (Q54).";

public fn place_boxes(layout: &Layout) -> placed: Box<Slots<PlacedRect>> reads(layout) doc "Returns every box of the laid-out layout in viewport coordinates: for each element, the border box of each of its fragments, the rectangles getClientRects reports, and for each text node, each of its line fragments, as a Range's getClientRects reports them, with kind placed_element and owner the element's index in the traversal, or kind placed_text and owner the text node's NodeId index. Rectangles of one owner appear in fragment order; owners appear in no particular order.";

public fn layout_counts(layout: &Layout) -> (contexts: u64, paragraphs: u64) reads(layout) doc "Returns how many contexts and paragraphs build_boxes made.";

public fn text_changed(layout: &Layout, document: &Document, node: NodeId) -> result: Result<unit, LayoutError> reads(document), writes(layout) doc "Records that the data of the Text node changed (pkg::dom::set_text) in the laid-out layout: the pieces that read it take its new data, and its paragraph and every context from the initial containing block down to the one holding it are marked for update; a node that feeds no paragraph changes nothing. Inconsistent when the node is not a Text node the layout was built from, or when its new data would change the box tree (a text node that was only white space and no longer is, or the reverse), which update cannot follow and a new build_layout must.";

public fn update(layout: &Layout, document: &Document, styles: &Styles, fonts: &FontSet, picks: &FontPicks) -> result: Result<unit, LayoutError> reads(document), reads(styles), reads(fonts), reads(picks), writes(layout) doc "Brings the laid-out layout up to date with the changes marked since it was last laid out or updated: prepares again each marked paragraph, and lays out again each marked context, keeping every unmarked child context whose space comes out unchanged and every unmarked paragraph whose width and left edge come out unchanged, and stopping at a context whose border-box size, baseline and margins come out unchanged; then clears the marks. The layout it leaves places the same boxes as lay_out on the layout build_layout makes from the same document, styles and fonts (place_boxes returns the same rectangles). A layout with no mark costs one test. Text when shaping refuses a paragraph.";

public fn update_counts(layout: &Layout) -> (prepared: u64, contexts: u64, paragraphs: u64, held_entries: u64, entries: u64) reads(layout) doc "Returns what the last update did, as pkg::layout's UpdateCounts records it: the paragraphs it prepared again, the contexts it laid out again, the paragraphs it broke into lines again, the flow entries the stacking pass walked in the contexts holding a paragraph it prepared again, and those every stacking pass it ran walked; all zero before the first update and for an update with no mark.";
