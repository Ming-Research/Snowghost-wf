alias Atom = pkg::base::atom::Atom;

public struct NodeId {
  public index: u32;
}

public struct TextSpan {
  public start: u32;
  public end: u32;
}

public enum Namespace {
  Html();
  Svg();
  MathMl();
}

public enum AttributeNamespace {
  NoNamespace();
  XLink();
  Xml();
  XmlNs();
}

public struct Attribute {
  public namespace: AttributeNamespace;
  public name: Atom;
  public value: TextSpan;
}

public enum QuirksMode {
  NoQuirks();
  LimitedQuirks();
  Quirks();
}

public enum NodeData {
  DocumentRoot(public quirks: QuirksMode);
  DocumentType(public name: TextSpan, public public_id: TextSpan, public system_id: TextSpan);
  Element(public namespace: Namespace, public local_name: Atom, public attributes: Box<Slots<Attribute>>, public template_contents: Option<NodeId>);
  Text(public data: TextSpan);
  Comment(public data: TextSpan);
  Fragment();
}

public struct Links {
  public parent: Option<NodeId>;
  public first_child: Option<NodeId>;
  public last_child: Option<NodeId>;
  public previous_sibling: Option<NodeId>;
  public next_sibling: Option<NodeId>;
}

public struct Node {
  public data: NodeData;
  public links: Links;
}

public struct Document {
  public readonly nodes: Box<Slots<Node>>;
  public readonly text: Box<Slots<u8>>;
}

public enum DomError {
  InvalidNode();
  WrongKind();
  TooLarge();
}

public fn document_new(quirks: QuirksMode) -> made: Document pure doc "Returns a document whose only node, at index 0, is its DocumentRoot.";

public fn set_quirks_mode(document: &Document, quirks: QuirksMode) -> result: unit writes(document) doc "Sets the quirks mode that the document root carries, as the parser does once the DOCTYPE token decides it.";

public fn store_text(document: &Document, text: &[u8]) -> result: Result<TextSpan, DomError> reads(text), writes(document) contract {
  requires text^.len <= 1073741824_u64;
} doc "Copies text into the document's text storage and returns its span; TooLarge when the storage would reach 2^32 bytes.";

public fn create_node(document: &Document, data: NodeData) -> result: Result<NodeId, DomError> writes(document) doc "Adds a node holding data with no parent, children or siblings, and returns its identifier; TooLarge when the document would pass 2^32 - 1 nodes. The spans data names must already be in the document's text storage; they are not checked here, and readers bound-check spans. InvalidNode when data is an Element whose template_contents names no node.";

public fn append_child(document: &Document, parent: NodeId, child: NodeId) -> result: Result<unit, DomError> writes(document) doc "Removes child from its parent, if any, and makes it the last child of parent. InvalidNode when either identifier names no node, or when child is parent or one of its ancestors.";

public fn insert_before(document: &Document, parent: NodeId, child: NodeId, reference: NodeId) -> result: Result<unit, DomError> writes(document) doc "Removes child from its parent, if any, and inserts it into parent immediately before reference. InvalidNode when an identifier names no node, reference is not a child of parent, or child is parent or one of its ancestors.";

public fn detach(document: &Document, node: NodeId) -> result: Result<unit, DomError> writes(document) doc "Removes node from its parent, if any; the node and its descendants stay in the document without a parent. InvalidNode when the identifier names no node.";

public fn insert_text(document: &Document, parent: NodeId, before: Option<NodeId>, text: &[u8]) -> result: Result<unit, DomError> reads(text), writes(document) contract {
  requires text^.len <= 1073741824_u64;
} doc "Inserts text into parent at the position before names (the end when None), appending it to the Text node that would precede it when there is one, as the HTML tree construction rules insert characters, and creating a Text node otherwise. InvalidNode when parent names no node or before is not a child of parent; TooLarge when the text storage or the node count would pass its limit.";

public fn add_attribute(document: &Document, element: NodeId, attribute: Attribute) -> result: Result<unit, DomError> writes(document) doc "Adds attribute to element unless it already has an attribute with the same namespace and name, as the parser adds the attributes of a repeated html or body tag. InvalidNode when element names no node; WrongKind when it names a node that is not an Element; TooLarge when the element's attributes would pass 2^16.";

public fn set_text(document: &Document, node: NodeId, data: TextSpan) -> result: Result<unit, DomError> writes(document) doc "Makes data the data of the Text or Comment node, as a script's assignment to its data does, keeping the node's identifier. The span must already be in the document's text storage; it is not checked here, and readers bound-check spans. InvalidNode when node names no node; WrongKind when it names a node that is neither Text nor Comment.";

public fn set_attribute(document: &Document, element: NodeId, attribute: Attribute) -> result: Result<unit, DomError> writes(document) doc "Sets attribute on element as setAttribute does: replaces the value of the element's attribute with the same namespace and name, or adds attribute after the others when it has none. InvalidNode when element names no node; WrongKind when it names a node that is not an Element; TooLarge when the element's attributes would pass 2^16.";
