const not_scalar_class: u8 = 23_u8;

fn count_le_step(starts: &[u32], lower: u64, upper: u64, value: u32) -> (next_lower: u64, next_upper: u64) reads(starts) contract {
  requires lower < upper;
  requires upper <= starts^.len;
  ensures next_lower <= next_upper;
  ensures next_upper <= starts^.len;
} {
  doc "One bisection step toward the partition point of starts[0..upper) at value: every entry below next_lower is at or below value, and every entry at or above next_upper is above value.";
  let last = upper - 1_u64;
  let span = last - lower;
  let half = span / 2_u64;
  let middle = lower + half;
  let candidate = starts^[middle];
  let fits = candidate <= value;
  if fits {
    let next = middle + 1_u64;
    return next, upper;
  }
  return lower, middle;
}

fn count_le(starts: &[u32], value: u32) -> result: u64 reads(starts) contract {
  ensures result <= starts^.len;
} {
  doc "Returns the number of entries of the ascending array starts that are at or below value, by bisection.";
  let lower = 0_u64;
  let upper = starts^.len;
  loop (
    invariant ordered: lower <= upper,
    invariant bounded: upper <= starts^.len
  ) {
    if lower >= upper {
      return lower;
    }
    let (next_lower, next_upper) = count_le_step(starts: starts, lower: lower, upper: upper, value: value);
    set lower = next_lower;
    set upper = next_upper;
  }
  return lower;
}

fn class_of(cp: u32) -> result: u8 pure {
  doc "Returns the runtime line-break class (0 to 45; see runs.wf for the numbering) of code point cp by binary search over class_starts/class_values. A value that is not a Unicode scalar value (a surrogate D800..DFFF, or past 10FFFF) reports AL (not_scalar_class), matching the module's XX default for values outside the property tables' domain.";
  let is_surrogate_low = cp >= 55296_u32;
  let is_surrogate_high = cp <= 57343_u32;
  let is_surrogate = band(is_surrogate_low, is_surrogate_high);
  let too_large = cp > 1114111_u32;
  let invalid = bor(is_surrogate, too_large);
  if invalid {
    return not_scalar_class;
  }
  let count = class_starts.len;
  let starts_slice = &class_starts[0_u64..count];
  let found = count_le(starts: starts_slice, value: cp);
  let has_any = found > 0_u64;
  if has_any {
  } else {
    return not_scalar_class;
  }
  let index = found - 1_u64;
  let value_slice = &class_values[0_u64..count];
  let result = value_slice^[index];
  return result;
}

fn toggle_state(starts: &[u32], value: u32) -> result: Bool reads(starts) {
  doc "Reports the state of a toggle-encoded boolean property at value: the count of entries of the ascending array starts at or below value, taken modulo two.";
  let found = count_le(starts: starts, value: value);
  let is_odd = odd_u64(value: found);
  return is_odd;
}

fn is_ea_wide(cp: u32) -> result: Bool pure {
  doc "Tells whether cp has East_Asian_Width F, W or H: the $EastAsian set LB19a and LB30 use.";
  let count = ea_wide_starts.len;
  let slice = &ea_wide_starts[0_u64..count];
  let odd = toggle_state(starts: slice, value: cp);
  return odd;
}

fn is_ext_pict_cn(cp: u32) -> result: Bool pure {
  doc "Tells whether cp is General_Category Cn intersected with Extended_Pictographic: LB30b's second, unassigned-emoji clause.";
  let count = ext_pict_cn_starts.len;
  let slice = &ext_pict_cn_starts[0_u64..count];
  let odd = toggle_state(starts: slice, value: cp);
  return odd;
}

fn odd_u64(value: u64) -> result: Bool pure {
  doc "Tells whether value is odd.";
  let bit = iand(value, 1_u64);
  let is_one = bit == 1_u64;
  return is_one;
}
