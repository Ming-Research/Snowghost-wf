const not_scalar_class: u8 = 23_u8;

const class_mask: u8 = 63_u8;

const wide_bit: u8 = 64_u8;

const pict_bit: u8 = 128_u8;

const block_size: u64 = 256_u64;

fn packed_byte_at(cp: u32) -> result: u8 pure {
  doc "Looks up the packed class/EA-wide/ext-pict-Cn byte for cp via the two-stage block table class_block_index and class_block_bytes hold: class_block_index names, per 256-code-point block, which deduplicated block of class_block_bytes holds that block's 256 bytes, so a lookup is one block-index read and one packed-byte read. A value that is not a Unicode scalar value (a surrogate D800..DFFF, or past 10FFFF), or one whose block or position falls outside the generated tables, reports not_scalar_class with neither flag bit set, matching class_of's XX default.";
  let is_surrogate_low = cp >= 55296_u32;
  let is_surrogate_high = cp <= 57343_u32;
  let is_surrogate = band(is_surrogate_low, is_surrogate_high);
  let too_large = cp > 1114111_u32;
  let invalid = bor(is_surrogate, too_large);
  if invalid {
    return not_scalar_class;
  }
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / block_size;
  let offset = cp64 % block_size;
  let index_len = class_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return not_scalar_class;
  }
  let dedup = class_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap block_size;
  let position = base +wrap offset;
  let bytes_len = class_block_bytes.len;
  let position_ok = position < bytes_len;
  if position_ok {
  } else {
    return not_scalar_class;
  }
  let packed = class_block_bytes[position];
  return packed;
}

fn class_of(cp: u32) -> result: u8 pure {
  doc "Returns the runtime line-break class (0 to 45; see runs.wf for the numbering) of code point cp via the two-stage block table (packed_byte_at), masked to its low 6 bits.";
  let packed = packed_byte_at(cp: cp);
  let class = iand(packed, class_mask);
  return class;
}

fn is_ea_wide(cp: u32) -> result: Bool pure {
  doc "Tells whether cp has East_Asian_Width F, W or H: the $EastAsian set LB19a and LB30 use, packed into bit 6 of packed_byte_at's byte.";
  let packed = packed_byte_at(cp: cp);
  let flag = iand(packed, wide_bit);
  let result = flag != 0_u8;
  return result;
}

fn is_ext_pict_cn(cp: u32) -> result: Bool pure {
  doc "Tells whether cp is General_Category Cn intersected with Extended_Pictographic: LB30b's second, unassigned-emoji clause, packed into bit 7 of packed_byte_at's byte.";
  let packed = packed_byte_at(cp: cp);
  let flag = iand(packed, pict_bit);
  let result = flag != 0_u8;
  return result;
}
