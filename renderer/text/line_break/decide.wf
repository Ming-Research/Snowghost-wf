const index_none: u64 = 18446744073709551615_u64;

fn prior_index(j: u64) -> result: u64 pure {
  doc "Returns j - 1, or index_none when j is 0 (so a lookup at it reports the class_none/False defaults that stand for sot).";
  let at_start = j == 0_u64;
  if at_start {
    return index_none;
  }
  let result = j - 1_u64;
  return result;
}

fn is_ak_as_dotted_run(runs: &Runs, index: u64) -> result: Bool reads(runs) {
  doc "AK, AS, or based on U+25CC DOTTED CIRCLE: the left member of most of LB28a's groups.";
  let class = run_class_at(runs: runs, index: index);
  let is_ak = class == class_ak;
  let is_as = class == class_as;
  let akas = bor(is_ak, is_as);
  if akas {
    return True();
  }
  let base = run_base_at(runs: runs, index: index);
  let dotted = base == dotted_circle;
  return dotted;
}

fn is_ak_dotted_run(runs: &Runs, index: u64) -> result: Bool reads(runs) {
  doc "AK, or based on U+25CC DOTTED CIRCLE, without AS: the right member of LB28a's third group.";
  let class = run_class_at(runs: runs, index: index);
  let is_ak = class == class_ak;
  if is_ak {
    return True();
  }
  let base = run_base_at(runs: runs, index: index);
  let dotted = base == dotted_circle;
  return dotted;
}

fn not_wide_at(runs: &Runs, index: u64) -> result: Bool reads(runs) {
  doc "Tells whether the run at index is not East Asian wide; an out-of-range index (past the end, or index_none for before the start) reports True, matching LB19a's eot and sot alternatives.";
  let wide = run_wide_at(runs: runs, index: index);
  let result = bnot(wide);
  return result;
}

fn decide_boundary(runs: &Runs, j: u64, state: SpaceState) -> result: u8 reads(runs) {
  doc "Decides the break opportunity between run j and run j + 1, applying Unicode Standard Annex #14's rules LB4 through LB31 in order; the first rule whose pattern matches decides. LB1 through LB3 and LB9/LB10 are handled elsewhere: LB1 and LB9/LB10 in run construction, LB2/LB3 by the caller at the text's edges. The lookahead offsets (j +wrap up to 3) wrap rather than requiring an externally proved ceiling on j: run_class_at and its siblings already resolve any out-of-range run index to their sot/eot defaults, so a wrapped offset is exactly as safe as an in-range one, and j is never actually large enough to wrap for real input.";
  let l = run_class_at(runs: runs, index: j);
  let r_index = j +wrap 1_u64;
  let r = run_class_at(runs: runs, index: r_index);
  if l == class_bk {
    return opp_mandatory;
  }
  if l == class_cr {
    if r == class_lf {
      return opp_prohibited;
    }
    return opp_mandatory;
  }
  if l == class_lf {
    return opp_mandatory;
  }
  if l == class_nl {
    return opp_mandatory;
  }
  let r_hard = is_hard_break(class: r);
  if r_hard {
    return opp_prohibited;
  }
  if r == class_sp {
    return opp_prohibited;
  }
  if r == class_zw {
    return opp_prohibited;
  }
  if state.pre_space_class == class_zw {
    return opp_allowed;
  }
  let l_ends_zwj = run_ends_zwj_at(runs: runs, index: j);
  if l_ends_zwj {
    return opp_prohibited;
  }
  if r == class_wj {
    return opp_prohibited;
  }
  if l == class_wj {
    return opp_prohibited;
  }
  if l == class_gl {
    return opp_prohibited;
  }
  if r == class_gl {
    let l_is_sp = l == class_sp;
    let l_is_ba = l == class_ba;
    let l_is_hy = l == class_hy;
    let l_is_hh = l == class_hh;
    let excl_a = bor(l_is_sp, l_is_ba);
    let excl_b = bor(l_is_hy, l_is_hh);
    let excl = bor(excl_a, excl_b);
    if excl {
    } else {
      return opp_prohibited;
    }
  }
  if r == class_cl {
    return opp_prohibited;
  }
  if r == class_cp {
    return opp_prohibited;
  }
  if r == class_ex {
    return opp_prohibited;
  }
  if r == class_sy {
    return opp_prohibited;
  }
  if state.pre_space_class == class_op {
    return opp_prohibited;
  }
  if state.pre_space_class == class_qu_pi {
    if state.pre_space_quote_pi_ok {
      return opp_prohibited;
    }
  }
  if r == class_qu_pf {
    let after_index = j +wrap 2_u64;
    let after = run_class_at(runs: runs, index: after_index);
    let ok = in_lb15b_context(class: after);
    if ok {
      return opp_prohibited;
    }
  }
  if l == class_sp {
    if r == class_is {
      let after_index2 = j +wrap 2_u64;
      let after2 = run_class_at(runs: runs, index: after_index2);
      if after2 == class_nu {
        return opp_allowed;
      }
    }
  }
  if r == class_is {
    return opp_prohibited;
  }
  if r == class_ns {
    let base_close = is_cl_cp(class: state.pre_space_class);
    if base_close {
      return opp_prohibited;
    }
  }
  if r == class_b2 {
    if state.pre_space_class == class_b2 {
      return opp_prohibited;
    }
  }
  if l == class_sp {
    return opp_allowed;
  }
  let r_is_qu_pf = r == class_qu_pf;
  let r_is_qu_other = r == class_qu_other;
  let r_qu_not_pi = bor(r_is_qu_pf, r_is_qu_other);
  if r_qu_not_pi {
    return opp_prohibited;
  }
  let l_is_qu_pi = l == class_qu_pi;
  let l_is_qu_other = l == class_qu_other;
  let l_qu_not_pf = bor(l_is_qu_pi, l_is_qu_other);
  if l_qu_not_pf {
    return opp_prohibited;
  }
  let r_is_quote = is_quote(class: r);
  if r_is_quote {
    let l_narrow = not_wide_at(runs: runs, index: j);
    let after_r_index = j +wrap 2_u64;
    let after_r_narrow = not_wide_at(runs: runs, index: after_r_index);
    let fires = bor(l_narrow, after_r_narrow);
    if fires {
      return opp_prohibited;
    }
  }
  let l_is_quote = is_quote(class: l);
  if l_is_quote {
    let r_narrow = not_wide_at(runs: runs, index: r_index);
    let before_l_index = prior_index(j: j);
    let before_l_narrow = not_wide_at(runs: runs, index: before_l_index);
    let fires2 = bor(r_narrow, before_l_narrow);
    if fires2 {
      return opp_prohibited;
    }
  }
  if r == class_cb {
    return opp_allowed;
  }
  if l == class_cb {
    return opp_allowed;
  }
  let l_is_hy2 = l == class_hy;
  let l_is_hh2 = l == class_hh;
  let l_hyhh = bor(l_is_hy2, l_is_hh2);
  if l_hyhh {
    let r_alhl = is_al_hl(class: r);
    if r_alhl {
      let prev_index = prior_index(j: j);
      let prev_class = run_class_at(runs: runs, index: prev_index);
      let ctx_ok = in_lb20a_context(class: prev_class);
      if ctx_ok {
        return opp_prohibited;
      }
    }
  }
  if r == class_ba {
    return opp_prohibited;
  }
  if r == class_hh {
    return opp_prohibited;
  }
  if r == class_hy {
    return opp_prohibited;
  }
  if r == class_ns {
    return opp_prohibited;
  }
  if l == class_bb {
    return opp_prohibited;
  }
  if l_hyhh {
    let prev_index2 = prior_index(j: j);
    let prev_class2 = run_class_at(runs: runs, index: prev_index2);
    if prev_class2 == class_hl {
      let r_is_hl = r == class_hl;
      if r_is_hl {
      } else {
        return opp_prohibited;
      }
    }
  }
  if l == class_sy {
    if r == class_hl {
      return opp_prohibited;
    }
  }
  if r == class_in {
    return opp_prohibited;
  }
  let l_alhl = is_al_hl(class: l);
  if l_alhl {
    if r == class_nu {
      return opp_prohibited;
    }
  }
  if l == class_nu {
    let r_alhl2 = is_al_hl(class: r);
    if r_alhl2 {
      return opp_prohibited;
    }
  }
  if l == class_pr {
    let r_ideb = is_id_eb_em(class: r);
    if r_ideb {
      return opp_prohibited;
    }
  }
  let l_ideb = is_id_eb_em(class: l);
  if l_ideb {
    if r == class_po {
      return opp_prohibited;
    }
  }
  let l_prpo = is_pr_po(class: l);
  if l_prpo {
    let r_alhl3 = is_al_hl(class: r);
    if r_alhl3 {
      return opp_prohibited;
    }
  }
  if l_alhl {
    let r_prpo = is_pr_po(class: r);
    if r_prpo {
      return opp_prohibited;
    }
  }
  if state.num_close {
    if r == class_po {
      return opp_prohibited;
    }
    if r == class_pr {
      return opp_prohibited;
    }
  }
  if state.num_tail {
    if r == class_po {
      return opp_prohibited;
    }
    if r == class_pr {
      return opp_prohibited;
    }
    if r == class_nu {
      return opp_prohibited;
    }
  }
  if l == class_po {
    if r == class_nu {
      return opp_prohibited;
    }
    if r == class_op {
      let a1 = j +wrap 2_u64;
      let after1 = run_class_at(runs: runs, index: a1);
      if after1 == class_nu {
        return opp_prohibited;
      }
      if after1 == class_is {
        let a2 = j +wrap 3_u64;
        let after2 = run_class_at(runs: runs, index: a2);
        if after2 == class_nu {
          return opp_prohibited;
        }
      }
    }
  }
  if l == class_pr {
    if r == class_nu {
      return opp_prohibited;
    }
    if r == class_op {
      let b1 = j +wrap 2_u64;
      let after1b = run_class_at(runs: runs, index: b1);
      if after1b == class_nu {
        return opp_prohibited;
      }
      if after1b == class_is {
        let b2 = j +wrap 3_u64;
        let after2b = run_class_at(runs: runs, index: b2);
        if after2b == class_nu {
          return opp_prohibited;
        }
      }
    }
  }
  if l == class_hy {
    if r == class_nu {
      return opp_prohibited;
    }
  }
  if l == class_is {
    if r == class_nu {
      return opp_prohibited;
    }
  }
  if l == class_jl {
    let r_jl = r == class_jl;
    let r_jv = r == class_jv;
    let r_h2 = r == class_h2;
    let r_h3 = r == class_h3;
    let x1 = bor(r_jl, r_jv);
    let x2 = bor(r_h2, r_h3);
    let match1 = bor(x1, x2);
    if match1 {
      return opp_prohibited;
    }
  }
  let l_jv = l == class_jv;
  let l_h2 = l == class_h2;
  let l_jv_h2 = bor(l_jv, l_h2);
  if l_jv_h2 {
    let r_jv2 = r == class_jv;
    let r_jt2 = r == class_jt;
    let match2 = bor(r_jv2, r_jt2);
    if match2 {
      return opp_prohibited;
    }
  }
  let l_jt = l == class_jt;
  let l_h3 = l == class_h3;
  let l_jt_h3 = bor(l_jt, l_h3);
  if l_jt_h3 {
    if r == class_jt {
      return opp_prohibited;
    }
  }
  let l_syllable = is_jamo_or_syllable(class: l);
  if l_syllable {
    if r == class_po {
      return opp_prohibited;
    }
  }
  if l == class_pr {
    let r_syllable = is_jamo_or_syllable(class: r);
    if r_syllable {
      return opp_prohibited;
    }
  }
  if l_alhl {
    let r_alhl4 = is_al_hl(class: r);
    if r_alhl4 {
      return opp_prohibited;
    }
  }
  if l == class_ap {
    let r_akas = is_ak_as_dotted_run(runs: runs, index: r_index);
    if r_akas {
      return opp_prohibited;
    }
  }
  let l_akas = is_ak_as_dotted_run(runs: runs, index: j);
  if l_akas {
    let r_is_vf = r == class_vf;
    let r_is_vi = r == class_vi;
    let r_vf_vi = bor(r_is_vf, r_is_vi);
    if r_vf_vi {
      return opp_prohibited;
    }
  }
  if l == class_vi {
    let prev_index3 = prior_index(j: j);
    let prev_akas = is_ak_as_dotted_run(runs: runs, index: prev_index3);
    if prev_akas {
      let r_ak_dotted = is_ak_dotted_run(runs: runs, index: r_index);
      if r_ak_dotted {
        return opp_prohibited;
      }
    }
  }
  if l_akas {
    let r_akas2 = is_ak_as_dotted_run(runs: runs, index: r_index);
    if r_akas2 {
      let c2 = j +wrap 2_u64;
      let after_vf = run_class_at(runs: runs, index: c2);
      if after_vf == class_vf {
        return opp_prohibited;
      }
    }
  }
  if l == class_is {
    let r_alhl5 = is_al_hl(class: r);
    if r_alhl5 {
      return opp_prohibited;
    }
  }
  let l_is_nu_here = l == class_nu;
  let l_alhlnu = bor(l_alhl, l_is_nu_here);
  if l_alhlnu {
    if r == class_op {
      let r_wide = run_wide_at(runs: runs, index: r_index);
      if r_wide {
      } else {
        return opp_prohibited;
      }
    }
  }
  if l == class_cp {
    let l_wide = run_wide_at(runs: runs, index: j);
    if l_wide {
    } else {
      let r_al_hl_here = is_al_hl(class: r);
      let r_is_nu_here = r == class_nu;
      let r_alhlnu2 = bor(r_al_hl_here, r_is_nu_here);
      if r_alhlnu2 {
        return opp_prohibited;
      }
    }
  }
  if l == class_ri {
    if r == class_ri {
      if state.ri_odd {
        return opp_prohibited;
      }
      return opp_allowed;
    }
  }
  if r == class_em {
    if l == class_eb {
      return opp_prohibited;
    }
    let l_base = run_base_at(runs: runs, index: j);
    let l_pict_cn = is_ext_pict_cn(cp: l_base);
    if l_pict_cn {
      return opp_prohibited;
    }
  }
  return opp_allowed;
}
