public enum BreakOpportunity {
  Prohibited();
  Allowed();
  Mandatory();
}

public fn find_line_breaks(text: &[u32], opportunities: &[BreakOpportunity]) -> result: unit reads(text), writes(opportunities) contract {
  requires opportunities^.len == text^.len;
  requires text^.len <= 1073741824_u64;
} doc "Writes the line break opportunity after each code point of text into the same position of opportunities: opportunities[i] lies between text[i] and text[i + 1], and the last one at the end of text. The algorithm is Unicode Standard Annex #14 for Unicode 17.0.0, untailored, with the default LB1 resolution: AI, SG and XX resolve to AL; SA resolves to CM when its General_Category is Mn or Mc and to AL otherwise; CJ resolves to NS. An opportunity is Mandatory where LB3, LB4 or LB5 breaks, Allowed where any other rule, LB31 included, breaks, and Prohibited where a rule forbids a break. A value that is not a Unicode scalar value has class XX. Property values come from the Unicode 17.0.0 character database files the annex names.";
