fn gc_variant_of(index: u8) -> result: GeneralCategory pure {
  doc "Converts a 0-based General_Category index (gc_block_bytes' low 5 bits, in the Unicode Standard's listed order: Lu, Ll, Lt, Lm, Lo, Mn, Mc, Me, Nd, Nl, No, Pc, Pd, Ps, Pe, Pi, Pf, Po, Sm, Sc, Sk, So, Zs, Zl, Zp, Cc, Cf, Cs, Co, Cn) to its GeneralCategory variant. An index past 29 (Cn), which the generated tables never produce, also returns Unassigned.";
  let is_0 = index == 0_u8;
  if is_0 {
    let value = GeneralCategory::UppercaseLetter();
    return value;
  }
  let is_1 = index == 1_u8;
  if is_1 {
    let value = GeneralCategory::LowercaseLetter();
    return value;
  }
  let is_2 = index == 2_u8;
  if is_2 {
    let value = GeneralCategory::TitlecaseLetter();
    return value;
  }
  let is_3 = index == 3_u8;
  if is_3 {
    let value = GeneralCategory::ModifierLetter();
    return value;
  }
  let is_4 = index == 4_u8;
  if is_4 {
    let value = GeneralCategory::OtherLetter();
    return value;
  }
  let is_5 = index == 5_u8;
  if is_5 {
    let value = GeneralCategory::NonspacingMark();
    return value;
  }
  let is_6 = index == 6_u8;
  if is_6 {
    let value = GeneralCategory::SpacingMark();
    return value;
  }
  let is_7 = index == 7_u8;
  if is_7 {
    let value = GeneralCategory::EnclosingMark();
    return value;
  }
  let is_8 = index == 8_u8;
  if is_8 {
    let value = GeneralCategory::DecimalNumber();
    return value;
  }
  let is_9 = index == 9_u8;
  if is_9 {
    let value = GeneralCategory::LetterNumber();
    return value;
  }
  let is_10 = index == 10_u8;
  if is_10 {
    let value = GeneralCategory::OtherNumber();
    return value;
  }
  let is_11 = index == 11_u8;
  if is_11 {
    let value = GeneralCategory::ConnectorPunctuation();
    return value;
  }
  let is_12 = index == 12_u8;
  if is_12 {
    let value = GeneralCategory::DashPunctuation();
    return value;
  }
  let is_13 = index == 13_u8;
  if is_13 {
    let value = GeneralCategory::OpenPunctuation();
    return value;
  }
  let is_14 = index == 14_u8;
  if is_14 {
    let value = GeneralCategory::ClosePunctuation();
    return value;
  }
  let is_15 = index == 15_u8;
  if is_15 {
    let value = GeneralCategory::InitialPunctuation();
    return value;
  }
  let is_16 = index == 16_u8;
  if is_16 {
    let value = GeneralCategory::FinalPunctuation();
    return value;
  }
  let is_17 = index == 17_u8;
  if is_17 {
    let value = GeneralCategory::OtherPunctuation();
    return value;
  }
  let is_18 = index == 18_u8;
  if is_18 {
    let value = GeneralCategory::MathSymbol();
    return value;
  }
  let is_19 = index == 19_u8;
  if is_19 {
    let value = GeneralCategory::CurrencySymbol();
    return value;
  }
  let is_20 = index == 20_u8;
  if is_20 {
    let value = GeneralCategory::ModifierSymbol();
    return value;
  }
  let is_21 = index == 21_u8;
  if is_21 {
    let value = GeneralCategory::OtherSymbol();
    return value;
  }
  let is_22 = index == 22_u8;
  if is_22 {
    let value = GeneralCategory::SpaceSeparator();
    return value;
  }
  let is_23 = index == 23_u8;
  if is_23 {
    let value = GeneralCategory::LineSeparator();
    return value;
  }
  let is_24 = index == 24_u8;
  if is_24 {
    let value = GeneralCategory::ParagraphSeparator();
    return value;
  }
  let is_25 = index == 25_u8;
  if is_25 {
    let value = GeneralCategory::Control();
    return value;
  }
  let is_26 = index == 26_u8;
  if is_26 {
    let value = GeneralCategory::Format();
    return value;
  }
  let is_27 = index == 27_u8;
  if is_27 {
    let value = GeneralCategory::Surrogate();
    return value;
  }
  let is_28 = index == 28_u8;
  if is_28 {
    let value = GeneralCategory::PrivateUse();
    return value;
  }
  let is_29 = index == 29_u8;
  if is_29 {
    let value = GeneralCategory::Unassigned();
    return value;
  }
  let value = GeneralCategory::Unassigned();
  return value;
}

fn general_category(scalar: u32) -> result: GeneralCategory pure {
  doc "Looks up scalar's packed byte via packed_byte_of and converts its low 5 bits (iand with 31) to a GeneralCategory variant with gc_variant_of. See module.wfm for the full contract.";
  let byte = packed_byte_of(cp: scalar);
  let index = iand(byte, 31_u8);
  let category = gc_variant_of(index: index);
  return category;
}

fn is_extended_pictographic(scalar: u32) -> result: Bool pure {
  doc "Looks up scalar's packed byte via packed_byte_of, the same table general_category reads, and tests bit 7 (iand with 128). See module.wfm for the full contract.";
  let byte = packed_byte_of(cp: scalar);
  let bit = iand(byte, 128_u8);
  let flagged = bit != 0_u8;
  return flagged;
}
