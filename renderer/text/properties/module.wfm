public enum GeneralCategory {
  UppercaseLetter();
  LowercaseLetter();
  TitlecaseLetter();
  ModifierLetter();
  OtherLetter();
  NonspacingMark();
  SpacingMark();
  EnclosingMark();
  DecimalNumber();
  LetterNumber();
  OtherNumber();
  ConnectorPunctuation();
  DashPunctuation();
  OpenPunctuation();
  ClosePunctuation();
  InitialPunctuation();
  FinalPunctuation();
  OtherPunctuation();
  MathSymbol();
  CurrencySymbol();
  ModifierSymbol();
  OtherSymbol();
  SpaceSeparator();
  LineSeparator();
  ParagraphSeparator();
  Control();
  Format();
  Surrogate();
  PrivateUse();
  Unassigned();
}

public fn general_category(scalar: u32) -> result: GeneralCategory pure doc "Returns the General_Category of scalar in Unicode 17.0.0's extracted/DerivedGeneralCategory.txt, the variants in the order the Unicode Standard lists the values (Lu, Ll, Lt, Lm, Lo, Mn, Mc, Me, Nd, Nl, No, Pc, Pd, Ps, Pe, Pi, Pf, Po, Sm, Sc, Sk, So, Zs, Zl, Zp, Cc, Cf, Cs, Co, Cn): Surrogate for U+D800 to U+DFFF, Unassigned for a code point the file lists as Cn, and Unassigned for a value past U+10FFFF. Constant time: the tables are generated by pkg::tools::properties_tables from the pinned data and checked in.";

public fn is_extended_pictographic(scalar: u32) -> result: Bool pure doc "Returns whether scalar has the Extended_Pictographic property in Unicode 17.0.0's emoji/emoji-data.txt, and False for a value past U+10FFFF. Constant time, from the same generated tables as general_category.";
