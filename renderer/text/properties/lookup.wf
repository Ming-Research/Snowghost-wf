const table_block_size: u64 = 256_u64;

const default_packed: u8 = 29_u8;

fn packed_byte_of(cp: u32) -> result: u8 pure {
  doc "Looks up cp's packed byte (General_Category index in the low 5 bits, Extended_Pictographic in bit 7) via the two-stage block table gc_block_index/gc_block_bytes: one block-index read and one byte read. Reports default_packed (Cn, not Extended_Pictographic) for a value outside the generated tables, which includes every value past U+10FFFF.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = gc_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return default_packed;
  }
  let dedup = gc_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = gc_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return default_packed;
  }
  let value = gc_block_bytes[pos];
  return value;
}
