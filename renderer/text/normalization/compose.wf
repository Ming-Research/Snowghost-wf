fn try_compose_pair(starter: u32, candidate: u32) -> result: Option<u32> pure {
  doc "Tries to compose starter with candidate: Hangul arithmetic composition first (UAX #15's conjoining jamo behavior), then the primary canonical composition table. None when neither applies.";
  match compose_hangul(starter: starter, candidate: candidate) {
    Some(value: composed) => {
      return Some<u32>(value: composed);
    }
    None() => {
    }
  }
  let table_result = composition_lookup(starter: starter, mark: candidate);
  return table_result;
}

fn canonical_compose(output: &Box<Slots<u32>>, start: u64) -> result: unit writes(output) {
  doc "Applies UAX #15's canonical composition algorithm to output[start..output's length), which must already be canonically decomposed and ordered, compacting the composed result in place from start and truncating output to its new length. A starter position tracks the most recent character not itself composed away; unblocked is the algorithm's -1 sentinel, True exactly when nothing has intervened since that starter that could block a further composition, reset True on every fresh starter and False on any other value that gets appended rather than absorbed.";
  let write_pos = start;
  let read_pos = start;
  let has_starter = False();
  let starter_pos = start;
  let unblocked = False();
  let last_class = 0_u8;
  loop @scan {
    let total = output^.inner.len;
    let more = read_pos < total;
    if more {
    } else {
      break @scan;
    }
    let read_ok = read_pos < output^.inner.len;
    let value = if read_ok {
      let piece = output^.inner[read_pos];
      give piece;
    } else {
      give 0_u32;
    }
    let class = ccc_of(cp: value);
    let eligible = if has_starter {
      let by_sentinel = unblocked;
      let by_class = last_class < class;
      let ready = bor(by_sentinel, by_class);
      give ready;
    } else {
      give False();
    }
    let composed_opt = if eligible {
      let starter_ok = starter_pos < output^.inner.len;
      let starter_value = if starter_ok {
        let piece = output^.inner[starter_pos];
        give piece;
      } else {
        give 0_u32;
      }
      let attempt = try_compose_pair(starter: starter_value, candidate: value);
      give attempt;
    } else {
      give None<u32>();
    }
    match composed_opt {
      Some(value: composed) => {
        let starter_write_ok = starter_pos < output^.inner.len;
        if starter_write_ok {
          set output^.inner[starter_pos] = composed;
        }
      }
      None() => {
        let write_ok = write_pos < output^.inner.len;
        if write_ok {
          set output^.inner[write_pos] = value;
        }
        let is_starter = class == 0_u8;
        if is_starter {
          set starter_pos = write_pos;
          set has_starter = True();
          set unblocked = True();
        } else {
          set unblocked = False();
          set last_class = class;
        }
        let next_write = write_pos +wrap 1_u64;
        set write_pos = next_write;
      }
    }
    let next_read = read_pos +wrap 1_u64;
    set read_pos = next_read;
  }
  truncate_to(output: output, length: write_pos);
  return unit;
}
