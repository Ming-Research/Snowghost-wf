const table_block_size: u64 = 256_u64;

fn ccc_of(cp: u32) -> result: u8 pure {
  doc "Looks up the canonical combining class of cp via the two-stage block table ccc_block_index/ccc_block_bytes: one block-index read and one byte read. Reports 0 (a starter) for a value outside the generated tables, which includes every value that is not a Unicode scalar value.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = ccc_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return 0_u8;
  }
  let dedup = ccc_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = ccc_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return 0_u8;
  }
  let value = ccc_block_bytes[pos];
  return value;
}

fn decomposition_of(cp: u32) -> (found: Bool, offset: u64, length: u64) pure {
  doc "Looks up cp's full recursive canonical decomposition via the two-stage block table decomposition_block_index/decomposition_block_ids: found False and offset/length 0 when cp has none (including every value that is not a Unicode scalar value, and every Hangul syllable, which the caller decomposes arithmetically instead); otherwise the span [offset, offset + length) of decomposition_values holding its code points, in order.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = decomposition_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let dedup = decomposition_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset_in_block = cp64 % table_block_size;
  let pos = base +wrap offset_in_block;
  let ids_len = decomposition_block_ids.len;
  let pos_ok = pos < ids_len;
  if pos_ok {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let id = decomposition_block_ids[pos];
  let has = id > 0_u16;
  if has {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let id64 = cvt::<u16, u64>(id);
  let idx = id64 -wrap 1_u64;
  let offsets_len = decomposition_offsets.len;
  let lengths_len = decomposition_lengths.len;
  let idx_ok_offsets = idx < offsets_len;
  let idx_ok_lengths = idx < lengths_len;
  let idx_ok = band(idx_ok_offsets, idx_ok_lengths);
  if idx_ok {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let off32 = decomposition_offsets[idx];
  let len8 = decomposition_lengths[idx];
  let off64 = cvt::<u32, u64>(off32);
  let len64 = cvt::<u8, u64>(len8);
  let yes = True();
  return yes, off64, len64;
}

fn raw_decomposition_of(cp: u32) -> (found: Bool, first: u32, second: u32) pure {
  doc "Looks up cp's raw one-step canonical decomposition (UnicodeData.txt's Decomposition_Mapping before recursive expansion) via the same two-stage block table as decomposition_of, decomposition_block_index/decomposition_block_ids, reading raw_decomposition_first/raw_decomposition_second at the same id in place of decomposition_offsets/decomposition_lengths. found False, with first/second 0, when cp has none, including every value that is not a Unicode scalar value and every Hangul syllable, which the caller splits arithmetically instead.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = decomposition_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    let no = False();
    return no, 0_u32, 0_u32;
  }
  let dedup = decomposition_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset_in_block = cp64 % table_block_size;
  let pos = base +wrap offset_in_block;
  let ids_len = decomposition_block_ids.len;
  let pos_ok = pos < ids_len;
  if pos_ok {
  } else {
    let no = False();
    return no, 0_u32, 0_u32;
  }
  let id = decomposition_block_ids[pos];
  let has = id > 0_u16;
  if has {
  } else {
    let no = False();
    return no, 0_u32, 0_u32;
  }
  let id64 = cvt::<u16, u64>(id);
  let idx = id64 -wrap 1_u64;
  let first_len = raw_decomposition_first.len;
  let second_len = raw_decomposition_second.len;
  let idx_ok_first = idx < first_len;
  let idx_ok_second = idx < second_len;
  let idx_ok = band(idx_ok_first, idx_ok_second);
  if idx_ok {
  } else {
    let no = False();
    return no, 0_u32, 0_u32;
  }
  let first = raw_decomposition_first[idx];
  let second = raw_decomposition_second[idx];
  let yes = True();
  return yes, first, second;
}

fn decomposition_value_at(k: u64) -> result: Option<u32> pure {
  doc "Reads one code point of decomposition_values at k, bounds-checked.";
  let values_len = decomposition_values.len;
  let ok = k < values_len;
  if ok {
  } else {
    return None<u32>();
  }
  let value = decomposition_values[k];
  return Some<u32>(value: value);
}

fn composition_lookup(starter: u32, mark: u32) -> result: Option<u32> pure {
  doc "Looks up the primary canonical composite of (starter, mark) via the two-stage block table composition_block_index/composition_block_ids, keyed by the starter code point: None when starter has no composition pairs; otherwise a bounded linear scan (at most composition_counts's value for starter, small and fixed by Unicode 17.0.0's data) of its combining/composed pair run.";
  let starter64 = cvt::<u32, u64>(starter);
  let block = starter64 / table_block_size;
  let index_len = composition_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return None<u32>();
  }
  let dedup = composition_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset_in_block = starter64 % table_block_size;
  let pos = base +wrap offset_in_block;
  let ids_len = composition_block_ids.len;
  let pos_ok = pos < ids_len;
  if pos_ok {
  } else {
    return None<u32>();
  }
  let id = composition_block_ids[pos];
  let has = id > 0_u16;
  if has {
  } else {
    return None<u32>();
  }
  let id64 = cvt::<u16, u64>(id);
  let slot = id64 -wrap 1_u64;
  let offsets_len = composition_offsets.len;
  let counts_len = composition_counts.len;
  let slot_ok_offsets = slot < offsets_len;
  let slot_ok_counts = slot < counts_len;
  let slot_ok = band(slot_ok_offsets, slot_ok_counts);
  if slot_ok {
  } else {
    return None<u32>();
  }
  let pair_base32 = composition_offsets[slot];
  let pair_count8 = composition_counts[slot];
  let pair_base = cvt::<u32, u64>(pair_base32);
  let pair_count = cvt::<u8, u64>(pair_count8);
  let combining_len = composition_combining.len;
  let composed_len = composition_composed.len;
  for (k in 0_u64..pair_count) {
    let idx = pair_base +wrap k;
    let idx_ok_combining = idx < combining_len;
    let idx_ok_composed = idx < composed_len;
    let idx_ok = band(idx_ok_combining, idx_ok_composed);
    if idx_ok {
      let candidate = composition_combining[idx];
      let same = candidate == mark;
      if same {
        let result_cp = composition_composed[idx];
        return Some<u32>(value: result_cp);
      }
    }
  }
  return None<u32>();
}
