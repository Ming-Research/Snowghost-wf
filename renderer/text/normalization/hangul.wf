const hangul_s_base: u32 = 44032_u32;

const hangul_l_base: u32 = 4352_u32;

const hangul_v_base: u32 = 4449_u32;

const hangul_t_base: u32 = 4519_u32;

const hangul_l_count: u32 = 19_u32;

const hangul_v_count: u32 = 21_u32;

const hangul_t_count: u32 = 28_u32;

const hangul_n_count: u32 = 588_u32;

const hangul_s_count: u32 = 11172_u32;

const hangul_l_end: u32 = 4370_u32;

const hangul_v_end: u32 = 4469_u32;

const hangul_t_end: u32 = 4546_u32;

fn is_hangul_syllable(cp: u32) -> result: Bool pure {
  doc "Tells whether cp is a precomposed Hangul syllable (AC00..D7A3).";
  let low = cp >= hangul_s_base;
  let bound = hangul_s_base +wrap hangul_s_count;
  let high = cp < bound;
  let result = band(low, high);
  return result;
}

fn decompose_hangul(cp: u32) -> (is_hangul: Bool, l: u32, v: u32, has_t: Bool, t: u32) pure {
  doc "Arithmetically decomposes a Hangul syllable into its leading, vowel and (when present) trailing jamo, per UAX #15's Hangul decomposition. is_hangul False when cp is not a Hangul syllable, with the other results 0/False.";
  let syllable = is_hangul_syllable(cp: cp);
  if syllable {
  } else {
    let no = False();
    return no, 0_u32, 0_u32, no, 0_u32;
  }
  let s_index = cp -wrap hangul_s_base;
  let l_index = s_index / hangul_n_count;
  let rem = s_index % hangul_n_count;
  let v_index = rem / hangul_t_count;
  let t_index = rem % hangul_t_count;
  let l = hangul_l_base +wrap l_index;
  let v = hangul_v_base +wrap v_index;
  let has_t = t_index > 0_u32;
  let t = if has_t {
    let value = hangul_t_base +wrap t_index;
    give value;
  } else {
    give 0_u32;
  }
  let yes = True();
  return yes, l, v, has_t, t;
}

fn decompose_hangul_step(cp: u32) -> (is_hangul: Bool, first: u32, second: u32) pure {
  doc "Splits a Hangul syllable one step, per the Unicode Standard's section 3.12: an LVT syllable into its LV syllable and trailing jamo, an LV syllable into its leading and vowel jamo. is_hangul False when cp is not a Hangul syllable, with first/second 0.";
  let syllable = is_hangul_syllable(cp: cp);
  if syllable {
  } else {
    let no = False();
    return no, 0_u32, 0_u32;
  }
  let s_index = cp -wrap hangul_s_base;
  let l_index = s_index / hangul_n_count;
  let rem = s_index % hangul_n_count;
  let v_index = rem / hangul_t_count;
  let t_index = rem % hangul_t_count;
  let is_lv = t_index == 0_u32;
  if is_lv {
    let l = hangul_l_base +wrap l_index;
    let v = hangul_v_base +wrap v_index;
    let yes = True();
    return yes, l, v;
  }
  let lv_index = l_index *wrap hangul_v_count;
  let lv_combined = lv_index +wrap v_index;
  let n_index = lv_combined *wrap hangul_t_count;
  let lv_syllable = hangul_s_base +wrap n_index;
  let t = hangul_t_base +wrap t_index;
  let yes = True();
  return yes, lv_syllable, t;
}

fn compose_hangul(starter: u32, candidate: u32) -> result: Option<u32> pure {
  doc "Arithmetically composes a Hangul leading jamo with a following vowel jamo into an LV syllable, or an LV syllable with a following trailing jamo into an LVT syllable, per UAX #15's Hangul composition. None for any other pair.";
  let starter_low = starter >= hangul_l_base;
  let starter_high = starter <= hangul_l_end;
  let starter_is_l = band(starter_low, starter_high);
  let candidate_low = candidate >= hangul_v_base;
  let candidate_high = candidate <= hangul_v_end;
  let candidate_is_v = band(candidate_low, candidate_high);
  let case_lv = band(starter_is_l, candidate_is_v);
  if case_lv {
    let l_index = starter -wrap hangul_l_base;
    let v_index = candidate -wrap hangul_v_base;
    let scaled_l = l_index *wrap hangul_v_count;
    let lv_index = scaled_l +wrap v_index;
    let n_index = lv_index *wrap hangul_t_count;
    let composed = hangul_s_base +wrap n_index;
    return Some<u32>(value: composed);
  }
  let starter_is_syllable = is_hangul_syllable(cp: starter);
  if starter_is_syllable {
    let s_index = starter -wrap hangul_s_base;
    let t_slot = s_index % hangul_t_count;
    let is_lv = t_slot == 0_u32;
    let candidate_low_t = candidate > hangul_t_base;
    let candidate_high_t = candidate <= hangul_t_end;
    let candidate_is_t = band(candidate_low_t, candidate_high_t);
    let case_lvt = band(is_lv, candidate_is_t);
    if case_lvt {
      let t_index = candidate -wrap hangul_t_base;
      let composed = starter +wrap t_index;
      return Some<u32>(value: composed);
    }
  }
  return None<u32>();
}
