fn canonical_combining_class(scalar: u32) -> result: u8 pure {
  doc "Returns scalar's canonical combining class via ccc_of, the same table normalize's canonical ordering reads. See module.wfm for the full contract.";
  let value = ccc_of(cp: scalar);
  return value;
}

fn canonical_decomposition(scalar: u32) -> result: Option<Decomposition> pure {
  doc "Returns scalar's one-step canonical decomposition: a Hangul syllable's arithmetic one-step split (decompose_hangul_step), or, for any other code point, its raw one-step mapping from raw_decomposition_of, kept from before recursive expansion at the same id decomposition_of uses for normalize's full form. See module.wfm for the full contract.";
  let (is_hangul, hangul_first, hangul_second) = decompose_hangul_step(cp: scalar);
  if is_hangul {
    let made = Decomposition(first: hangul_first, second: hangul_second);
    return Some<Decomposition>(value: made);
  }
  let (found, first, second) = raw_decomposition_of(cp: scalar);
  if found {
    let made = Decomposition(first: first, second: second);
    return Some<Decomposition>(value: made);
  }
  return None<Decomposition>();
}

fn canonical_composition(first: u32, second: u32) -> result: Option<u32> pure {
  doc "Returns the primary composite of first and second via try_compose_pair, the same Hangul arithmetic and composition table normalize's canonical_compose reads. See module.wfm for the full contract.";
  let result = try_compose_pair(starter: first, candidate: second);
  return result;
}
