public enum NormalizationForm {
  Composed();
  Decomposed();
}

public enum NormalizationError {
  TooLarge();
}

public fn normalize(form: NormalizationForm, text: &[u32], output: &Box<Slots<u32>>) -> result: Result<unit, NormalizationError> reads(text), writes(output) contract {
  requires text^.len <= 268435456_u64;
} doc "Appends the normalization of text to output, after output's existing contents: Normalization Form C for Composed and Normalization Form D for Decomposed, as Unicode Standard Annex #15 defines them for Unicode 17.0.0, with decompositions, canonical combining classes and composition exclusions from that version's UnicodeData.txt and DerivedNormalizationProps.txt, and Hangul syllables composed and decomposed arithmetically. A value in text that is not a Unicode scalar value is copied unchanged and acts as a starter with no decomposition. The time is linear in the length of text, a long run of combining marks included. TooLarge when output would pass its storage limit; output then holds exactly its prior contents.";

public struct Decomposition {
  public first: u32;
  public second: u32;
}

public fn canonical_combining_class(scalar: u32) -> result: u8 pure doc "Returns the Canonical_Combining_Class of scalar in Unicode 17.0.0's UnicodeData.txt, and 0 for a value that is not a Unicode scalar value. It reads the same data normalize reads, in constant time.";

public fn canonical_decomposition(scalar: u32) -> result: Option<Decomposition> pure doc "Returns scalar's one-step canonical decomposition in Unicode 17.0.0: its UnicodeData.txt Decomposition_Mapping when that mapping has no compatibility tag, first and second in order and second 0 for a mapping to one character, and for a Hangul syllable the arithmetic split of the Unicode Standard's section 3.12 taken one step, an LVT syllable into its LV syllable and trailing jamo and an LV syllable into its leading and vowel jamo. None when scalar has no canonical decomposition or is not a Unicode scalar value. It reads the same data normalize reads, in constant time.";

public fn canonical_composition(first: u32, second: u32) -> result: Option<u32> pure doc "Returns the primary composite of first followed by second in Unicode 17.0.0: the character whose one-step canonical decomposition is exactly that pair and that is not in DerivedNormalizationProps.txt's Full_Composition_Exclusion, the arithmetic Hangul LV and LVT compositions included. None when there is no such character, which covers every composition exclusion, singleton and non-starter decomposition, and a pair holding a value that is not a Unicode scalar value. It reads the same data normalize reads, in time logarithmic in the number of primary composites at most.";
