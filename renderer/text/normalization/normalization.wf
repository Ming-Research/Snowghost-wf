fn normalize(form: NormalizationForm, text: &[u32], output: &Box<Slots<u32>>) -> result: Result<unit, NormalizationError> reads(text), writes(output) contract {
  requires text^.len <= 268435456_u64;
} {
  doc "Appends the normalization of text to output, after output's existing contents: Normalization Form C for Composed and Normalization Form D for Decomposed. Decomposes text (canonically, Hangul arithmetically), canonically orders the result by combining class, and, for Composed, canonically composes it in place. On TooLarge, output holds exactly its prior contents.";
  let entry_len = output^.inner.len;
  let ok = decompose_all(text: text, output: output);
  if ok {
  } else {
    truncate_to(output: output, length: entry_len);
    let too_large = NormalizationError::TooLarge();
    return Err<unit, NormalizationError>(error: too_large);
  }
  canonical_order(output: output, start: entry_len);
  match form {
    Composed() => {
      canonical_compose(output: output, start: entry_len);
    }
    Decomposed() => {
    }
  }
  return Ok<unit, NormalizationError>(value: unit);
}
