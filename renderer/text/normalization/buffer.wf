const output_ceiling: u64 = 1073741824_u64;

const initial_output_capacity: u64 = 64_u64;

fn append_scalar(output: &Box<Slots<u32>>, value: u32) -> result: Bool writes(output) {
  doc "Appends value to output, doubling its capacity (or taking initial_output_capacity from empty) first when it is full, within output_ceiling. Returns False, leaving output unchanged, when appending would need output's capacity to pass output_ceiling.";
  let length = output^.inner.len;
  let capacity = output^.inner.cap;
  let full = length >= capacity;
  if full {
    let empty = capacity == 0_u64;
    let doubled = if empty {
      give initial_output_capacity;
    } else {
      let value2 = capacity +wrap capacity;
      give value2;
    }
    let at_least = length +wrap 1_u64;
    let target = if doubled >= at_least {
      give doubled;
    } else {
      give at_least;
    }
    let fits = target <= output_ceiling;
    if fits {
    } else {
      return False();
    }
    let grows = target > capacity;
    if grows {
      grow(cell: output, capacity: target);
    }
  }
  let room = output^.inner.len < output^.inner.cap;
  if room {
    place_back(window: &output^.inner, value: value);
    return True();
  }
  return False();
}

fn truncate_to(output: &Box<Slots<u32>>, length: u64) -> result: unit writes(output) {
  doc "Takes values off the back of output until its len is at most length.";
  loop @shrink {
    let current = output^.inner.len;
    let over = current > length;
    if over {
      let dropped = take_back(window: &output^.inner);
    } else {
      break @shrink;
    }
  }
  return unit;
}
