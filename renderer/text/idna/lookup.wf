const table_block_size: u64 = 256_u64;

const status_valid: u8 = 0_u8;

const status_mapped: u8 = 1_u8;

const status_disallowed: u8 = 2_u8;

const bidi_other: u8 = 0_u8;

const bidi_l: u8 = 1_u8;

const bidi_r: u8 = 2_u8;

const bidi_al: u8 = 3_u8;

const bidi_en: u8 = 4_u8;

const bidi_es: u8 = 5_u8;

const bidi_cs: u8 = 6_u8;

const bidi_et: u8 = 7_u8;

const bidi_on: u8 = 8_u8;

const bidi_bn: u8 = 9_u8;

const bidi_nsm: u8 = 10_u8;

const bidi_an: u8 = 11_u8;

const joining_u: u8 = 0_u8;

const joining_c: u8 = 1_u8;

const joining_d: u8 = 2_u8;

const joining_l: u8 = 3_u8;

const joining_r: u8 = 4_u8;

const joining_t: u8 = 5_u8;

fn status_of(cp: u32) -> result: u8 pure {
  doc "Looks up the reduced IDNA mapping status of cp (status_valid, status_mapped or status_disallowed) via idna_status_block_index/idna_status_block_bytes. Reports status_disallowed for a value outside the generated tables, which includes every value that is not a Unicode scalar value.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = idna_status_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return status_disallowed;
  }
  let dedup = idna_status_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = idna_status_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return status_disallowed;
  }
  let value = idna_status_block_bytes[pos];
  return value;
}

fn mapping_of(cp: u32) -> (found: Bool, offset: u64, length: u64) pure {
  doc "Looks up cp's IDNA mapping target sequence via idna_mapping_block_index/idna_mapping_block_ids: found False and offset/length 0 when cp has none (including every value that is not a Unicode scalar value, and every value whose status is not status_mapped); otherwise the span [offset, offset + length) of idna_mapping_values holding its target code points, in order (length 0 for an ignored code point).";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = idna_mapping_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let dedup = idna_mapping_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset_in_block = cp64 % table_block_size;
  let pos = base +wrap offset_in_block;
  let ids_len = idna_mapping_block_ids.len;
  let pos_ok = pos < ids_len;
  if pos_ok {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let id = idna_mapping_block_ids[pos];
  let has = id > 0_u16;
  if has {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let id64 = cvt::<u16, u64>(id);
  let idx = id64 -wrap 1_u64;
  let offsets_len = idna_mapping_offsets.len;
  let lengths_len = idna_mapping_lengths.len;
  let idx_ok_offsets = idx < offsets_len;
  let idx_ok_lengths = idx < lengths_len;
  let idx_ok = band(idx_ok_offsets, idx_ok_lengths);
  if idx_ok {
  } else {
    let no = False();
    return no, 0_u64, 0_u64;
  }
  let off32 = idna_mapping_offsets[idx];
  let len8 = idna_mapping_lengths[idx];
  let off64 = cvt::<u32, u64>(off32);
  let len64 = cvt::<u8, u64>(len8);
  let yes = True();
  return yes, off64, len64;
}

fn mapping_value_at(k: u64) -> result: Option<u32> pure {
  doc "Reads one code point of idna_mapping_values at k, bounds-checked.";
  let values_len = idna_mapping_values.len;
  let ok = k < values_len;
  if ok {
  } else {
    return None<u32>();
  }
  let value = idna_mapping_values[k];
  return Some<u32>(value: value);
}

fn bidi_class_of(cp: u32) -> result: u8 pure {
  doc "Looks up the reduced Bidi_Class id of cp via idna_bidi_block_index/idna_bidi_block_bytes. Reports bidi_other for a value outside the generated tables, which includes every value that is not a Unicode scalar value.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = idna_bidi_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return bidi_other;
  }
  let dedup = idna_bidi_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = idna_bidi_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return bidi_other;
  }
  let value = idna_bidi_block_bytes[pos];
  return value;
}

fn joining_type_of(cp: u32) -> result: u8 pure {
  doc "Looks up the Joining_Type id of cp via idna_joining_block_index/idna_joining_block_bytes. Reports joining_u (Non_Joining) for a value outside the generated tables, which includes every value that is not a Unicode scalar value.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = idna_joining_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return joining_u;
  }
  let dedup = idna_joining_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = idna_joining_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return joining_u;
  }
  let value = idna_joining_block_bytes[pos];
  return value;
}

fn is_mark_of(cp: u32) -> result: Bool pure {
  doc "Tells whether cp's General_Category is Mn, Mc, or Me, via idna_mark_block_index/idna_mark_block_bytes. False for a value outside the generated tables, which includes every value that is not a Unicode scalar value.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = idna_mark_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return False();
  }
  let dedup = idna_mark_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = idna_mark_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return False();
  }
  let value = idna_mark_block_bytes[pos];
  let marked = value > 0_u8;
  return marked;
}

fn is_virama_of(cp: u32) -> result: Bool pure {
  doc "Tells whether cp's canonical combining class is 9 (Virama), via idna_virama_block_index/idna_virama_block_bytes. False for a value outside the generated tables, which includes every value that is not a Unicode scalar value.";
  let cp64 = cvt::<u32, u64>(cp);
  let block = cp64 / table_block_size;
  let index_len = idna_virama_block_index.len;
  let block_ok = block < index_len;
  if block_ok {
  } else {
    return False();
  }
  let dedup = idna_virama_block_index[block];
  let dedup64 = cvt::<u16, u64>(dedup);
  let base = dedup64 *wrap table_block_size;
  let offset = cp64 % table_block_size;
  let pos = base +wrap offset;
  let bytes_len = idna_virama_block_bytes.len;
  let pos_ok = pos < bytes_len;
  if pos_ok {
  } else {
    return False();
  }
  let value = idna_virama_block_bytes[pos];
  let is_virama = value > 0_u8;
  return is_virama;
}
