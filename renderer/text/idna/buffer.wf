const codepoint_ceiling: u64 = 268435456_u64;

const byte_ceiling: u64 = 1073741824_u64;

const initial_codepoint_capacity: u64 = 64_u64;

const initial_byte_capacity: u64 = 64_u64;

fn append_codepoint(buffer: &Box<Slots<u32>>, value: u32) -> result: Bool writes(buffer) {
  doc "Appends value to buffer, doubling its capacity (or taking initial_codepoint_capacity from empty) first when it is full, within codepoint_ceiling. Returns False, leaving buffer unchanged, when appending would need buffer's capacity to pass codepoint_ceiling.";
  let length = buffer^.inner.len;
  let capacity = buffer^.inner.cap;
  let full = length >= capacity;
  if full {
    let empty = capacity == 0_u64;
    let doubled = if empty {
      give initial_codepoint_capacity;
    } else {
      let value2 = capacity +wrap capacity;
      give value2;
    }
    let at_least = length +wrap 1_u64;
    let target = if doubled >= at_least {
      give doubled;
    } else {
      give at_least;
    }
    let fits = target <= codepoint_ceiling;
    if fits {
    } else {
      return False();
    }
    let grows = target > capacity;
    if grows {
      grow(cell: buffer, capacity: target);
    }
  }
  let room = buffer^.inner.len < buffer^.inner.cap;
  if room {
    place_back(window: &buffer^.inner, value: value);
    return True();
  }
  return False();
}

fn truncate_codepoints_to(buffer: &Box<Slots<u32>>, length: u64) -> result: unit writes(buffer) {
  doc "Takes values off the back of buffer until its len is at most length.";
  loop @shrink {
    let current = buffer^.inner.len;
    let over = current > length;
    if over {
      let dropped = take_back(window: &buffer^.inner);
    } else {
      break @shrink;
    }
  }
  return unit;
}

fn append_byte(buffer: &Box<Slots<u8>>, value: u8) -> result: Bool writes(buffer) {
  doc "Appends value to buffer, doubling its capacity (or taking initial_byte_capacity from empty) first when it is full, within byte_ceiling. Returns False, leaving buffer unchanged, when appending would need buffer's capacity to pass byte_ceiling.";
  let length = buffer^.inner.len;
  let capacity = buffer^.inner.cap;
  let full = length >= capacity;
  if full {
    let empty = capacity == 0_u64;
    let doubled = if empty {
      give initial_byte_capacity;
    } else {
      let value2 = capacity +wrap capacity;
      give value2;
    }
    let at_least = length +wrap 1_u64;
    let target = if doubled >= at_least {
      give doubled;
    } else {
      give at_least;
    }
    let fits = target <= byte_ceiling;
    if fits {
    } else {
      return False();
    }
    let grows = target > capacity;
    if grows {
      grow(cell: buffer, capacity: target);
    }
  }
  let room = buffer^.inner.len < buffer^.inner.cap;
  if room {
    place_back(window: &buffer^.inner, value: value);
    return True();
  }
  return False();
}

fn truncate_bytes_to(buffer: &Box<Slots<u8>>, length: u64) -> result: unit writes(buffer) {
  doc "Takes bytes off the back of buffer until its len is at most length.";
  loop @shrink {
    let current = buffer^.inner.len;
    let over = current > length;
    if over {
      let dropped = take_back(window: &buffer^.inner);
    } else {
      break @shrink;
    }
  }
  return unit;
}
