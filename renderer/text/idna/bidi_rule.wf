fn label_has_rtl(content: &[u32]) -> result: Bool reads(content) {
  doc "Tells whether content has at least one code point with Bidi_Class R, AL, or AN, which RFC 5893 section 1.4 makes it an RTL label.";
  let length = content^.len;
  for (at in 0_u64..length) {
    let value = content^[at];
    let class = bidi_class_of(cp: value);
    let is_r = class == bidi_r;
    let is_al = class == bidi_al;
    let is_an = class == bidi_an;
    let rtl_ral = bor(is_r, is_al);
    let rtl = bor(rtl_ral, is_an);
    if rtl {
      return True();
    }
  }
  return False();
}

fn rtl_chars_ok(content: &[u32]) -> result: Bool reads(content) {
  doc "RFC 5893 rule 2: in an RTL label, only Bidi_Class R, AL, AN, EN, ES, CS, ET, ON, BN, or NSM are allowed.";
  let length = content^.len;
  for (at in 0_u64..length) {
    let value = content^[at];
    let class = bidi_class_of(cp: value);
    let is_l = class == bidi_l;
    let is_other = class == bidi_other;
    let disallowed = bor(is_l, is_other);
    if disallowed {
      return False();
    }
  }
  return True();
}

fn rtl_end_ok(content: &[u32]) -> result: Bool reads(content) {
  doc "RFC 5893 rule 3: in an RTL label, the end of the label, after any trailing NSM run, must be R, AL, EN, or AN.";
  let length = content^.len;
  let at = length;
  loop @trim (
    invariant bounded: at <= length
  ) {
    let has_more = at > 0_u64;
    if has_more {
    } else {
      return False();
    }
    let prev = at -wrap 1_u64;
    invariant prev_bounded: prev <= length;
    let value = content^[prev];
    let class = bidi_class_of(cp: value);
    let is_nsm = class == bidi_nsm;
    if is_nsm {
      set at = prev;
    } else {
      let is_r = class == bidi_r;
      let is_al = class == bidi_al;
      let is_en = class == bidi_en;
      let is_an = class == bidi_an;
      let ok_ral = bor(is_r, is_al);
      let ok_enan = bor(is_en, is_an);
      let ok = bor(ok_ral, ok_enan);
      return ok;
    }
  }
  return False();
}

fn rtl_digits_ok(content: &[u32]) -> result: Bool reads(content) {
  doc "RFC 5893 rule 4: in an RTL label, EN and AN do not both occur.";
  let length = content^.len;
  let has_en = False();
  let has_an = False();
  for (at in 0_u64..length) {
    let value = content^[at];
    let class = bidi_class_of(cp: value);
    let is_en = class == bidi_en;
    if is_en {
      set has_en = True();
    }
    let is_an = class == bidi_an;
    if is_an {
      set has_an = True();
    }
  }
  let both = band(has_en, has_an);
  let ok = bnot(both);
  return ok;
}

fn ltr_chars_ok(content: &[u32]) -> result: Bool reads(content) {
  doc "RFC 5893 rule 5: in an LTR label, only Bidi_Class L, EN, ES, CS, ET, ON, BN, or NSM are allowed.";
  let length = content^.len;
  for (at in 0_u64..length) {
    let value = content^[at];
    let class = bidi_class_of(cp: value);
    let is_r = class == bidi_r;
    let is_al = class == bidi_al;
    let is_an = class == bidi_an;
    let is_other = class == bidi_other;
    let dis_ral = bor(is_r, is_al);
    let dis_anoth = bor(is_an, is_other);
    let disallowed = bor(dis_ral, dis_anoth);
    if disallowed {
      return False();
    }
  }
  return True();
}

fn ltr_end_ok(content: &[u32]) -> result: Bool reads(content) {
  doc "RFC 5893 rule 6: in an LTR label, the end of the label, after any trailing NSM run, must be L or EN.";
  let length = content^.len;
  let at = length;
  loop @trim (
    invariant bounded: at <= length
  ) {
    let has_more = at > 0_u64;
    if has_more {
    } else {
      return False();
    }
    let prev = at -wrap 1_u64;
    invariant prev_bounded: prev <= length;
    let value = content^[prev];
    let class = bidi_class_of(cp: value);
    let is_nsm = class == bidi_nsm;
    if is_nsm {
      set at = prev;
    } else {
      let is_l = class == bidi_l;
      let is_en = class == bidi_en;
      let ok = bor(is_l, is_en);
      return ok;
    }
  }
  return False();
}

fn check_bidi_label(content: &[u32]) -> result: Bool reads(content) {
  doc "RFC 5893 section 2's six conditions for one non-empty label of a Bidi domain name.";
  let length = content^.len;
  let has_first = length > 0_u64;
  if has_first {
  } else {
    return False();
  }
  let first = content^[0_u64];
  let first_class = bidi_class_of(cp: first);
  let first_is_l = first_class == bidi_l;
  if first_is_l {
    let chars_ok = ltr_chars_ok(content: content);
    if chars_ok {
    } else {
      return False();
    }
    let end_ok = ltr_end_ok(content: content);
    return end_ok;
  }
  let first_is_r = first_class == bidi_r;
  let first_is_al = first_class == bidi_al;
  let first_rtl = bor(first_is_r, first_is_al);
  if first_rtl {
    let chars_ok = rtl_chars_ok(content: content);
    if chars_ok {
    } else {
      return False();
    }
    let end_ok = rtl_end_ok(content: content);
    if end_ok {
    } else {
      return False();
    }
    let digits_ok = rtl_digits_ok(content: content);
    return digits_ok;
  }
  return False();
}
