const full_stop: u32 = 46_u32;

const xn_x: u32 = 120_u32;

const xn_n: u32 = 110_u32;

const xn_hyphen: u32 = 45_u32;

const xn_prefix_len: u64 = 4_u64;

const ascii_ceiling: u32 = 128_u32;

fn label_end(text: &[u32], from: u64) -> result: u64 reads(text) contract {
  requires from <= text^.len;
  ensures result >= from;
  ensures result <= text^.len;
} {
  doc "Returns the index of the next U+002E FULL STOP at or after from in text, or text's length.";
  let length = text^.len;
  let at = from;
  loop @scan (
    invariant lower: at >= from
  ) {
    let inside = at < length;
    if inside {
    } else {
      return length;
    }
    let value = text^[at];
    let found = value == full_stop;
    if found {
      return at;
    }
    let next = at +wrap 1_u64;
    invariant next_lower: next >= from;
    set at = next;
  }
  return length;
}

fn begins_with_xn(content: &[u32]) -> result: Bool reads(content) {
  doc "Tells whether content begins with the four code points x, n, -, - (the label already mapped, so any ASCII letter is already lowercase).";
  let length = content^.len;
  let long_enough = length >= xn_prefix_len;
  if long_enough {
  } else {
    return False();
  }
  let c0 = content^[0_u64];
  let c1 = content^[1_u64];
  let c2 = content^[2_u64];
  let c3 = content^[3_u64];
  let ok0 = c0 == xn_x;
  let ok1 = c1 == xn_n;
  let ok2 = c2 == xn_hyphen;
  let ok3 = c3 == xn_hyphen;
  let ok01 = band(ok0, ok1);
  let ok23 = band(ok2, ok3);
  let ok = band(ok01, ok23);
  return ok;
}

fn all_ascii(content: &[u32]) -> result: Bool reads(content) {
  doc "Tells whether every code point of content is below 0x80.";
  let length = content^.len;
  for (at in 0_u64..length) {
    let value = content^[at];
    let ascii = value < ascii_ceiling;
    if ascii {
    } else {
      return False();
    }
  }
  return True();
}

fn sequences_equal(a: &[u32], b: &[u32]) -> result: Bool reads(a), reads(b) {
  doc "Tells whether a and b hold the same code points in the same order.";
  let a_len = a^.len;
  let b_len = b^.len;
  let same_len = a_len == b_len;
  if same_len {
  } else {
    return False();
  }
  for (at in 0_u64..a_len) {
    let av = a^[at];
    let bv = b^[at];
    let same = av == bv;
    if same {
    } else {
      return False();
    }
  }
  return True();
}
