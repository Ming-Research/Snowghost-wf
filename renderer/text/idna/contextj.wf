const zwnj: u32 = 8204_u32;

const zwj: u32 = 8205_u32;

fn before_is_virama(content: &[u32], pos: u64) -> result: Bool reads(content) {
  doc "Tells whether pos has a preceding code point in content whose canonical combining class is Virama.";
  let has_before = pos > 0_u64;
  if has_before {
  } else {
    return False();
  }
  let before = pos -wrap 1_u64;
  let length = content^.len;
  let in_range = before < length;
  if in_range {
  } else {
    return False();
  }
  let value = content^[before];
  let is_virama = is_virama_of(cp: value);
  return is_virama;
}

fn joining_scan_backward_ok(content: &[u32], pos: u64) -> result: Bool reads(content) {
  doc "Scans content backward from just before pos, skipping Transparent-joining-type code points, and tells whether the first non-Transparent one found has joining type L or D. False when pos is 0 or every preceding code point is Transparent.";
  let at = pos;
  loop @scan {
    let has_more = at > 0_u64;
    if has_more {
    } else {
      return False();
    }
    let prev = at -wrap 1_u64;
    let length = content^.len;
    let in_range = prev < length;
    if in_range {
    } else {
      return False();
    }
    let value = content^[prev];
    let jt = joining_type_of(cp: value);
    let transparent = jt == joining_t;
    if transparent {
      set at = prev;
    } else {
      let is_l = jt == joining_l;
      let is_d = jt == joining_d;
      let ok = bor(is_l, is_d);
      return ok;
    }
  }
  return False();
}

fn joining_scan_forward_ok(content: &[u32], pos: u64) -> result: Bool reads(content) {
  doc "Scans content forward from just after pos, skipping Transparent-joining-type code points, and tells whether the first non-Transparent one found has joining type R or D. False when pos is content's last position or every following code point is Transparent.";
  let length = content^.len;
  let at = pos +wrap 1_u64;
  loop @scan {
    let inside = at < length;
    if inside {
    } else {
      return False();
    }
    let value = content^[at];
    let jt = joining_type_of(cp: value);
    let transparent = jt == joining_t;
    if transparent {
      let next = at +wrap 1_u64;
      set at = next;
    } else {
      let is_r = jt == joining_r;
      let is_d = jt == joining_d;
      let ok = bor(is_r, is_d);
      return ok;
    }
  }
  return False();
}

fn context_zwnj_ok(content: &[u32], pos: u64) -> result: Bool reads(content) {
  doc "RFC 5892 Appendix A.1: a ZERO WIDTH NON-JOINER at pos is allowed when the preceding code point has canonical combining class Virama, or when the surrounding joining-type run matches (L|D) T* ZWNJ T* (R|D).";
  let by_virama = before_is_virama(content: content, pos: pos);
  if by_virama {
    return True();
  }
  let backward_ok = joining_scan_backward_ok(content: content, pos: pos);
  if backward_ok {
  } else {
    return False();
  }
  let forward_ok = joining_scan_forward_ok(content: content, pos: pos);
  return forward_ok;
}

fn context_zwj_ok(content: &[u32], pos: u64) -> result: Bool reads(content) {
  doc "RFC 5892 Appendix A.2: a ZERO WIDTH JOINER at pos is allowed only when the preceding code point has canonical combining class Virama.";
  let by_virama = before_is_virama(content: content, pos: pos);
  return by_virama;
}

fn check_contextj(content: &[u32]) -> result: Bool reads(content) {
  doc "Applies RFC 5892 Appendix A.1 and A.2 to every ZERO WIDTH NON-JOINER and ZERO WIDTH JOINER of content.";
  let length = content^.len;
  for (at in 0_u64..length) {
    let value = content^[at];
    let is_zwnj = value == zwnj;
    if is_zwnj {
      let ok = context_zwnj_ok(content: content, pos: at);
      if ok {
      } else {
        return False();
      }
    }
    let is_zwj = value == zwj;
    if is_zwj {
      let ok = context_zwj_ok(content: content, pos: at);
      if ok {
      } else {
        return False();
      }
    }
  }
  return True();
}
