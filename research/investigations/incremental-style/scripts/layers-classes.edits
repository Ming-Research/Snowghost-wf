S @layer retained-base, retained-overrides;
S @layer retained-base { .lc-flex { display: flex; width: 300px; --basis: 40px; } .lc-flex > div { flex: 0 0 var(--basis); height: 20px; } .lc-grid { display: grid; width: 300px; --track: 60px; grid-template-columns: var(--track) 100px; } .lc-grid > div { height: 20px; } }
S @layer retained-overrides { .lc-flex.probe { --basis: 80px; gap: 16px; } .lc-grid.probe { --track: 120px; gap: 12px; } }
S @layer retained-base.cells { #retained-flex.probe > div { flex-basis: 10px; } #retained-grid.probe { grid-template-columns: 10px 10px; } }
