S @layer retained-base, retained-overrides;
S @layer retained-base { .lc-flex { display: flex; width: 300px; --basis: 40px; } .lc-flex > div, .lc-flex > p { flex: 0 0 var(--basis); height: 20px; margin: 0; } .lc-grid { display: grid; width: 300px; grid-template-columns: 60px 100px; } .lc-grid > div, .lc-grid > p { height: 20px; margin: 0; } }
S @layer retained-base.cells { #retained-flex > :first-child { --basis: 90px; } #retained-grid > :first-child { grid-column: 2; } }
S @layer retained-overrides { #retained-flex > :first-child { --basis: 70px; } #retained-grid > :first-child { grid-column: 1; } }
