S #nth li:nth-child(2n) { color: red; }
S #first > i:first-child { color: red; }
S #last > i:last-child { color: red; }
S #adjacent h2 + p { color: red; }
S #general h2 ~ p { color: red; }
S .a + .b .c { color: red; }
S #empty:empty { color: red; }
S #pseudos b:first-child::before { content: "before"; }
S #pseudos b::after { content: "after"; color: blue; }
S #pseudos b:first-child::after { color: red; }
S #custom b:first-child { --probe: red; }
