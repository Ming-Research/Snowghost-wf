S #nlc li:nth-last-child(2n) { color: red; }
S #lot p:last-of-type { color: red; }
S #fot p:first-of-type { color: red; }
S #only i:only-child { color: red; }
S #oot p:only-of-type { color: red; }
S #wide i:first-child ~ em { color: red; }
S #nlot p:nth-last-of-type(2) { color: red; }
S #deep div:nth-last-child(3) b { color: red; }
S #far em + em { color: red; }
S #far em:nth-child(odd) { text-decoration: underline; }
S .ctx p:first-child + p > a { color: red; }
