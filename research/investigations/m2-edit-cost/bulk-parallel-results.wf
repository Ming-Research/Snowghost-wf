fn count(values: &[u64]) -> (total: u64, valid: Bool) reads(values) {
  let size = values^.len;
  if size == 0_u64 {
    return 0_u64, True();
  }
  let middle = size / 2_u64;
  if middle >= size {
    return 0_u64, False();
  }
  let following = middle + 1_u64;
  let (left, left_valid) = count(values: &values^[0_u64..middle]);
  let (right, right_valid) = count(values: &values^[following..size]);
  let own = values^[middle];
  let prefix = left +sat own;
  let total = prefix +sat right;
  let valid = band(left_valid, right_valid);
  return total, valid;
}

fn main() -> status: std::process::ExitStatus pure {
  let values = array_filled::<u64, 4>(value: 1_u64);
  let (total, valid) = count(values: &values[0_u64..4_u64]);
  if valid {
    if total == 4_u64 {
      return std::process::exit_status(code: 0_u8);
    }
  }
  return std::process::exit_status(code: 1_u8);
}
