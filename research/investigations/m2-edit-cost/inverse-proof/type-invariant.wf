struct Block {
  entry_slot: u32;
  normal_y: i32;
}

enum Flow {
  Open(block: u32);
}

struct Context {
  order: Box<Array<Flow>>;
  targets: Box<Array<Block>>;
  invariant(c): forall inv(k in 0_u64..c^.order.inner.len) when c^.order.inner[k].Open.block < c^.targets.inner.len: c^.targets.inner[c^.order.inner[k].Open.block].entry_slot == k;
}

fn translate_owner_suffix(c: &Context, delta: i32) -> result: unit reads(c.order), writes(c.targets) contract {
  ensures c^.targets.inner.len == entry(c)^.targets.inner.len;
} {
  let count = c^.order.inner.len;
  for (
    k in 0_u64..count,
    apart(i, j) {
    }
  ) {
    let item = c^.order.inner[k];
    match item {
      Open(block: b) => {
        let at = cvt::<u32, u64>(b);
        if at < c^.targets.inner.len {
          set c^.targets.inner[at].normal_y = c^.targets.inner[at].normal_y +sat delta;
        }
      }
    }
  }
  return unit;
}

fn forward(c: &Context, delta: i32) -> result: unit reads(c.order), writes(c.targets) contract {
  ensures c^.targets.inner.len == entry(c)^.targets.inner.len;
} {
  translate_owner_suffix(c: c, delta: delta);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let opening = Flow::Open(block: 0_u32);
  let order = box_array_filled::<Flow>(count: 2_u64, value: opening);
  set order.inner[1_u64] = Flow::Open(block: 1_u32);
  let block = Block(entry_slot: 0_u32, normal_y: 0_i32);
  let targets = box_array_filled::<Block>(count: 2_u64, value: block);
  set targets.inner[1_u64].entry_slot = 1_u32;
  let context = Context(order: move order, targets: move targets);
  forward(c: &context, delta: 1_i32);
  if context.targets.inner[0_u64].normal_y != 1_i32 {
    return std::process::exit_status(code: 1_u8);
  }
  if context.targets.inner[1_u64].normal_y != 1_i32 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
