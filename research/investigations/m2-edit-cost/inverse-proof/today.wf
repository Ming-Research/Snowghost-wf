struct Block {
  entry_slot: u32;
  normal_y: i32;
}

enum Flow {
  Open(block: u32);
}

fn translate_owner_suffix(order: &[Flow], targets: &[Block], first: u64, delta: i32) -> result: unit reads(order), writes(targets) {
  let count = order^.len;
  for (k in first..count) {
    let item = order^[k];
    match item {
      Open(block: b) => {
        let at = cvt::<u32, u64>(b);
        if at < targets^.len {
          set targets^[at].normal_y = targets^[at].normal_y +sat delta;
        }
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
