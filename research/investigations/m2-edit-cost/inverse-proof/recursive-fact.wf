struct Block {
  entry_slot: u32;
  normal_y: i32;
}

enum Flow {
  Open(block: u32);
  Close(block: u32);
}

enum SlotPages<T> {
  Vacant();
  Fork(left: Box<SlotPages<T>>, right: Box<SlotPages<T>>);
  Page(values: Box<Array<T>>);
}

fn target_slot(pages: &SlotPages<Flow>, targets: &[Block], slot: u32, span: u32) -> result: u32 reads(pages), reads(targets) {
  if slot >= span {
    return 4294967295_u32;
  }
  match pages^ {
    Vacant() => {
      return 4294967295_u32;
    }
    Page(values: page) => {
      let at = cvt::<u32, u64>(slot);
      if at < page^.inner.len {
        let item = page^.inner[at];
        match item {
          Open(block: b) => {
            let target = cvt::<u32, u64>(b);
            if target < targets^.len {
              return targets^[target].entry_slot;
            }
          }
          Close(..) => {
          }
        }
      }
      return 4294967295_u32;
    }
    Fork(left: left_page, right: right_page) => {
      let half = span / 2_u32;
      if slot < half {
        let found = target_slot(pages: &left_page^.inner, targets: targets, slot: slot, span: half);
        return found;
      }
      let later = slot - half;
      let found = target_slot(pages: &right_page^.inner, targets: targets, slot: later, span: half);
      return found;
    }
  }
}

fn need(pages: &SlotPages<Flow>, targets: &[Block], span: u32) -> result: unit pure contract {
  requires forall inv(k in 0_u32..span): target_slot(pages: pages, targets: targets, slot: k, span: span) == k;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
