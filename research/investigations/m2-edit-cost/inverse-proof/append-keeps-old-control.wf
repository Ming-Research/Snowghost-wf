struct Block {
  slot: u64;
}

fn push_item<T: drop>(cell: &Box<Slots<T>>, value: T, ceiling: u64) -> pushed: Bool writes(cell) contract {
  requires ceiling <= 1073741824_u64;
  ensures cell^.inner.len >= entry(cell)^.inner.len;
  ensures cell^.inner.len <= entry(cell)^.inner.len + 1_u64;
} {
  let length = cell^.inner.len;
  if length >= ceiling {
    return False();
  }
  let capacity = cell^.inner.cap;
  if length >= capacity {
    invariant below_ceiling: length < ceiling;
    invariant full: capacity <= length;
    let room = ceiling - capacity;
    if capacity < room {
      if capacity == 0_u64 {
        grow(cell: cell, capacity: 4_u64);
      } else {
        let doubled = capacity + capacity;
        grow(cell: cell, capacity: doubled);
      }
    } else {
      grow(cell: cell, capacity: ceiling);
    }
  }
  place_back(window: &cell^.inner, value: move value);
  return True();
}

fn need_equal(value: u64, expected: u64) -> result: unit pure contract {
  requires value == expected;
} {
  return unit;
}

fn append_then_read_old(cell: &Box<Slots<Block>>, value: Block) -> appended: Bool writes(cell) contract {
  requires cell^.inner.len > 0_u64;
  requires forall indexed(k in 0_u64..cell^.inner.len): cell^.inner[k].slot == k;
} {
  doc "Negative control: push_item states no unchanged postcondition, so the fact about index 0 is lost and need_equal below owes a range fact that is not proved.";
  let stored = push_item::<Block>(cell: cell, value: value, ceiling: 1073741824_u64);
  need_equal(value: cell^.inner[0_u64].slot, expected: 0_u64);
  return stored;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
