struct BoundedSource {
  values: Box<Array<u32>>;
  invariant limit(owner): owner.values.inner.len <= 1073741824_u64;
}

fn source_length(source: &BoundedSource) -> length: u64 reads(source) {
  return source^.values.inner.len;
}

fn make_source(nested: Bool) -> made: Result<BoundedSource, u32> pure {
  doc "A recursive producer. Every exit returns a constructed or forwarded valid source, but its own Ok-routed invariant is a summary of its own call-graph component, so the recursive call's payload carries no invariant to the next ordinary call.";
  if nested {
    let no = False();
    let inner = propagate make_source(nested: no);
    let length = source_length(source: &inner);
    return Ok<BoundedSource, u32>(value: move inner);
  }
  let values = box_array_filled::<u32>(count: 1_u64, value: 0_u32);
  let source = BoundedSource(values: move values);
  return Ok<BoundedSource, u32>(value: move source);
}
