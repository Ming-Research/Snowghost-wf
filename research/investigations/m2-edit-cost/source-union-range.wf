fn source_union_range(first: &[u32], second: &[u32]) -> made: Option<Box<Array<u32>>> reads(first), reads(second) {
  doc "Minimal natural independent concatenation from source_route_owners: k is below second.len, so first.len plus k is below the allocated first.len plus second.len. No runtime bounds or uniqueness guard replaces this obligation.";
  let first_count = first^.len;
  let second_count = second^.len;
  let total = first_count +sat second_count;
  if total > 1073741824_u64 {
    return None<Box<Array<u32>>>();
  }
  let made = box_array_filled::<u32>(count: total, value: 0_u32);
  for (k in 0_u64..second_count) {
    let at = first_count +sat k;
    set made.inner[at] = second^[k];
  }
  return Some<Box<Array<u32>>>(value: move made);
}
