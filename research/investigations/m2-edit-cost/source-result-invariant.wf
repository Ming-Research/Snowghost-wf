struct BoundedSource {
  values: Box<Array<u32>>;
  invariant limit(owner): owner.values.inner.len <= 1073741824_u64;
}

fn make_source() -> made: Result<BoundedSource, u32> pure {
  doc "The constructor proves the source invariant; the enclosing Result has no explicit routed postcondition.";
  let values = box_array_filled::<u32>(count: 1_u64, value: 0_u32);
  let source = BoundedSource(values: move values);
  return Ok<BoundedSource, u32>(value: move source);
}

fn source_length(source: &BoundedSource) -> length: u64 reads(source) {
  return source^.values.inner.len;
}

fn use_source() -> result: Result<u64, u32> pure {
  doc "A propagated valid source should satisfy its type invariant at the next ordinary call.";
  let source = propagate make_source();
  let length = source_length(source: &source);
  return Ok<u64, u32>(value: length);
}
