alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Unit {
  width: u64;
  height: u64;
  children: Box<Slots<Unit>>;
}

fn lay_out_unit(node: &Unit, available: u64) -> height: u64 writes(node) {
  doc "Lays out one unit: its children in parallel, then its own height.";
  let inner = node^.children.inner.len;
  let kids = lay_out_run(units: &node^.children.inner[0_u64..inner], available: available);
  let own = kids +wrap 1_u64;
  set node^.height = own;
  set node^.width = available;
  return own;
}

fn lay_out_run(units: &[Unit], available: u64) -> height: u64 writes(units) {
  doc "Lays out a run of sibling units by halves; the halves are disjoint range steps.";
  let count = units^.len;
  let empty = count == 0_u64;
  if empty {
    return 0_u64;
  }
  let single = count == 1_u64;
  if single {
    let one = lay_out_unit(node: &units^[0_u64], available: available);
    return one;
  }
  let half = count / 2_u64;
  let a = lay_out_run(units: &units^[0_u64..half], available: available);
  let b = lay_out_run(units: &units^[half..count], available: available);
  let sum = a +wrap b;
  return sum;
}

fn main() -> status: ExitStatus pure {
  let none = box_slots_new::<Unit>(capacity: 0_u64);
  let root = Unit(width: 0_u64, height: 0_u64, children: move none);
  let h = lay_out_unit(node: &root, available: 800_u64);
  let code = cvt.wrap::<u64, u8>(h);
  return exit_status(code: code);
}
