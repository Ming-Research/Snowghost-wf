alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn cascade_one(specified: u64, inherited: u64) -> computed: u64 pure {
  doc "Stands for one element's cascade: a pure function of its own inputs.";
  let mixed = specified *wrap 31_u64;
  let result = mixed +wrap inherited;
  return result;
}

fn cascade_level(specified: &[u64], parents: &[u64], computed: &[u64]) -> result: unit reads(specified), reads(parents), writes(computed) contract {
  requires parents^.len == specified^.len;
  requires computed^.len == specified^.len;
} {
  doc "Computes one tree level: element k reads its parent's already computed value from the previous level and writes its own slot.";
  let count = specified^.len;
  for (k in 0_u64..count) {
    let own = specified^[k];
    let inherited = parents^[k];
    let value = cascade_one(specified: own, inherited: inherited);
    set computed^[k] = value;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  let a = box_slots_new::<u64>(capacity: 4_u64);
  let b = box_slots_new::<u64>(capacity: 4_u64);
  let c = box_slots_new::<u64>(capacity: 4_u64);
  for (i in 0_u64..4_u64) {
    let ra = a.inner.len < a.inner.cap;
    if ra {
      place_back(window: &a.inner, value: i);
    }
    let rb = b.inner.len < b.inner.cap;
    if rb {
      place_back(window: &b.inner, value: 1_u64);
    }
    let rc = c.inner.len < c.inner.cap;
    if rc {
      place_back(window: &c.inner, value: 0_u64);
    }
  }
  let na = a.inner.len;
  let nb = b.inner.len;
  let nc = c.inner.len;
  let ab = na == nb;
  let bc = nb == nc;
  let same = band(ab, bc);
  if same {
    let n = na;
    let fits = n <= 4_u64;
    if fits {
      let sa = &a.inner[0_u64..n];
      let sb = &b.inner[0_u64..n];
      let sc = &c.inner[0_u64..n];
      cascade_level(specified: sa, parents: sb, computed: sc);
    }
  }
  return exit_status(code: 0_u8);
}
