fn fill(ids: &[u64], value: u64) -> result: unit writes(ids) {
  let count = ids^.len;
  for (k in 0_u64..count) {
    set ids^[k] = value;
  }
  return unit;
}

fn fixed_stride(ids: &[u64], rows: u64) -> result: unit writes(ids) contract {
  requires rows <= 1048576_u64;
  requires ids^.len == rows * 16_u64;
} {
  for (u in 0_u64..rows) {
    let start = u * 16_u64;
    let end = start + 16_u64;
    if end <= ids^.len {
      let value = u + 1_u64;
      fill(ids: &ids^[start..end], value: value);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let ids = array_filled::<u64, 48>(value: 0_u64);
  fixed_stride(ids: &ids[0_u64..48_u64], rows: 3_u64);
  for (k in 0_u64..48_u64) {
    let row = k / 16_u64;
    let expected = row + 1_u64;
    if ids[k] != expected {
      return std::process::exit_status(code: 1_u8);
    }
  }
  let empty = array_filled::<u64, 0>(value: 0_u64);
  fixed_stride(ids: &empty[0_u64..0_u64], rows: 0_u64);
  return std::process::exit_status(code: 0_u8);
}
