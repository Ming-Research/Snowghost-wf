struct Record {
  back: u64;
  field: u64;
}

fn scatter(slots: &[u64], records: &[Record]) -> result: unit reads(slots), writes(records) contract {
  requires forall inverse(k in 0_u64..slots^.len) when slots^[k] < records^.len: records^[slots^[k]].back == k;
} {
  let count = slots^.len;
  for (
    k in 0_u64..count,
    apart(i, j) {
    }
  ) {
    let at = slots^[k];
    if at < records^.len {
      set records^[at].field = k;
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let slots = array_filled::<u64, 1>(value: 0_u64);
  let record = Record(back: 0_u64, field: 9_u64);
  let records = array_filled::<Record, 1>(value: record);
  scatter(slots: &slots[0_u64..1_u64], records: &records[0_u64..1_u64]);
  return std::process::exit_status(code: 0_u8);
}
