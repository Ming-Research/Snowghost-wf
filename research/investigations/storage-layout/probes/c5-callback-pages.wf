struct Slot {
  field: u64;
  children: Box<Slots<Box<Slots<Slot>>>>;
}

fn with_slot<fn visit(value: &Slot) -> result: unit writes(value)>(pages: &Box<Slots<Box<Slots<Slot>>>>, p: u64, o: u64) -> result: Bool writes(pages) {
  if p < pages^.inner.len {
    if o < pages^.inner[p].inner.len {
      visit(value: &pages^.inner[p].inner[o]);
      return True();
    }
  }
  return False();
}

fn increment(value: &Slot) -> result: unit writes(value) {
  set value^.field = value^.field +wrap 1_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let children = box_slots_new::<Box<Slots<Slot>>>(capacity: 0_u64);
  let slot = Slot(field: 41_u64, children: move children);
  let page = box_slots_new::<Slot>(capacity: 4_u64);
  place_back(window: &page.inner, value: move slot);
  let pages = box_slots_new::<Box<Slots<Slot>>>(capacity: 1_u64);
  place_back(window: &pages.inner, value: move page);
  let found = with_slot::<fn increment>(pages: &pages, p: 0_u64, o: 0_u64);
  if found {
  } else {
    return std::process::exit_status(code: 1_u8);
  }
  if 0_u64 < pages.inner.len {
    if 0_u64 < pages.inner[0_u64].inner.len {
      if pages.inner[0_u64].inner[0_u64].field != 42_u64 {
        return std::process::exit_status(code: 2_u8);
      }
    } else {
      return std::process::exit_status(code: 3_u8);
    }
  } else {
    return std::process::exit_status(code: 4_u8);
  }
  let missing = with_slot::<fn increment>(pages: &pages, p: 1_u64, o: 0_u64);
  if missing {
    return std::process::exit_status(code: 5_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
