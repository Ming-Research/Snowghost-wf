struct PagedPair {
  ranks: Box<Paged<u64>>;
  values: Box<Paged<u64>>;
}

struct SlotsPair {
  ranks: Box<Slots<u64>>;
  values: Box<Slots<u64>>;
}

struct Cell {
  rank: u64;
  value: u64;
  owned: Box<Slots<u64>>;
}

fn make_paged_values(value: u64) -> result: Box<Paged<u64>> pure {
  doc "Build eight scalar values for the Paged control without assuming initialized range facts.";
  let values = box_paged_new::<u64>(capacity: 8_u64);
  for (s in 0_u64..8_u64) {
    if values.inner.len < values.inner.cap {
      place_back(window: &values.inner, value: value);
    }
  }
  return move values;
}

fn make_paged_cells(value: u64) -> result: Box<Paged<Cell>> pure {
  doc "Build eight noncopy elements, each owning a distinct empty box.";
  let values = box_paged_new::<Cell>(capacity: 8_u64);
  for (s in 0_u64..8_u64) {
    if values.inner.len < values.inner.cap {
      let owned = box_slots_new::<u64>(capacity: 0_u64);
      let cell = Cell(rank: 3_u64, value: value, owned: move owned);
      place_back(window: &values.inner, value: move cell);
    }
  }
  return move values;
}

fn gather_paged(store: &PagedPair, reduced: &[u64]) -> result: unit reads(reduced), writes(store) {
  doc "Read arbitrary ranks from one field pool and write only the matching flat slot in another.";
  for (s in 0_u64..store^.ranks.inner.len) {
    let rank = store^.ranks.inner[s];
    if rank < reduced^.len {
      if s < store^.values.inner.len {
        set store^.values.inner[s] = reduced^[rank];
      }
    }
  }
  return unit;
}

fn write_paged_cells(cells: &Box<Paged<Cell>>, reduced: &[u64]) -> result: unit reads(reduced), writes(cells) {
  doc "Project a narrow helper row onto a flat element that owns a box.";
  for (s in 0_u64..cells^.inner.len) {
    store_cell(cell: &cells^.inner[s], reduced: reduced);
  }
  return unit;
}

fn direct_paged_cells(cells: &Box<Paged<Cell>>) -> result: unit writes(cells) {
  doc "Write one scalar field directly in each noncopy element as the helper control.";
  for (s in 0_u64..cells^.inner.len) {
    let before = cells^.inner[s].value;
    set cells^.inner[s].value = before +wrap 9_u64;
  }
  return unit;
}

fn check_paged_values(values: &Box<Paged<u64>>, expected: u64) -> result: Bool reads(values) {
  doc "Check the literal eight-element scalar result independently of the update helpers.";
  if values^.inner.len != 8_u64 {
    return False();
  }
  for (s in 0_u64..values^.inner.len) {
    if values^.inner[s] != expected {
      return False();
    }
  }
  return True();
}

fn check_paged_cells(values: &Box<Paged<Cell>>, expected: u64) -> result: Bool reads(values) {
  doc "Check each noncopy element's scalar result and the untouched rank and owned window.";
  if values^.inner.len != 8_u64 {
    return False();
  }
  for (s in 0_u64..values^.inner.len) {
    if values^.inner[s].value != expected {
      return False();
    }
    if values^.inner[s].rank != 3_u64 {
      return False();
    }
    if values^.inner[s].owned.inner.len != 0_u64 {
      return False();
    }
  }
  return True();
}

fn make_slots_values(value: u64) -> result: Box<Slots<u64>> pure {
  doc "Build eight scalar values for the Slots control without assuming initialized range facts.";
  let values = box_slots_new::<u64>(capacity: 8_u64);
  for (s in 0_u64..8_u64) {
    if values.inner.len < values.inner.cap {
      place_back(window: &values.inner, value: value);
    }
  }
  return move values;
}

fn make_slots_cells(value: u64) -> result: Box<Slots<Cell>> pure {
  doc "Build eight noncopy elements, each owning a distinct empty box.";
  let values = box_slots_new::<Cell>(capacity: 8_u64);
  for (s in 0_u64..8_u64) {
    if values.inner.len < values.inner.cap {
      let owned = box_slots_new::<u64>(capacity: 0_u64);
      let cell = Cell(rank: 3_u64, value: value, owned: move owned);
      place_back(window: &values.inner, value: move cell);
    }
  }
  return move values;
}

fn gather_slots(store: &SlotsPair, reduced: &[u64]) -> result: unit reads(reduced), writes(store) {
  doc "Read arbitrary ranks from one field pool and write only the matching flat slot in another.";
  for (s in 0_u64..store^.ranks.inner.len) {
    let rank = store^.ranks.inner[s];
    if rank < reduced^.len {
      if s < store^.values.inner.len {
        set store^.values.inner[s] = reduced^[rank];
      }
    }
  }
  return unit;
}

fn write_slots_cells(cells: &Box<Slots<Cell>>, reduced: &[u64]) -> result: unit reads(reduced), writes(cells) {
  doc "Project a narrow helper row onto a flat element that owns a box.";
  for (s in 0_u64..cells^.inner.len) {
    store_cell(cell: &cells^.inner[s], reduced: reduced);
  }
  return unit;
}

fn direct_slots_cells(cells: &Box<Slots<Cell>>) -> result: unit writes(cells) {
  doc "Write one scalar field directly in each noncopy element as the helper control.";
  for (s in 0_u64..cells^.inner.len) {
    let before = cells^.inner[s].value;
    set cells^.inner[s].value = before +wrap 9_u64;
  }
  return unit;
}

fn check_slots_values(values: &Box<Slots<u64>>, expected: u64) -> result: Bool reads(values) {
  doc "Check the literal eight-element scalar result independently of the update helpers.";
  if values^.inner.len != 8_u64 {
    return False();
  }
  for (s in 0_u64..values^.inner.len) {
    if values^.inner[s] != expected {
      return False();
    }
  }
  return True();
}

fn check_slots_cells(values: &Box<Slots<Cell>>, expected: u64) -> result: Bool reads(values) {
  doc "Check each noncopy element's scalar result and the untouched rank and owned window.";
  if values^.inner.len != 8_u64 {
    return False();
  }
  for (s in 0_u64..values^.inner.len) {
    if values^.inner[s].value != expected {
      return False();
    }
    if values^.inner[s].rank != 3_u64 {
      return False();
    }
    if values^.inner[s].owned.inner.len != 0_u64 {
      return False();
    }
  }
  return True();
}

fn store_cell(cell: &Cell, reduced: &[u64]) -> result: unit reads(cell.rank), reads(reduced), writes(cell.value) {
  doc "Store the selected reduction while preserving the element's owned box.";
  let rank = cell^.rank;
  if rank < reduced^.len {
    set cell^.value = reduced^[rank];
  }
  return unit;
}

fn swap_runs<T>(target: &Run<T>, source: &Run<T>) -> result: unit writes(target), writes(source) {
  doc "Swap corresponding elements of two disjoint parameter runs without copying either value.";
  for (s in 0_u64..source^.len) {
    if s < target^.len {
      swap(first: &target^[s], second: &source^[s]);
    }
  }
  return unit;
}

fn swap_slices<T>(target: &[T], source: &[T]) -> result: unit writes(target), writes(source) {
  doc "Swap corresponding elements of two disjoint parameter runs without copying either value.";
  for (s in 0_u64..source^.len) {
    if s < target^.len {
      swap(first: &target^[s], second: &source^[s]);
    }
  }
  return unit;
}

fn swap_runs_u64(target: &Run<u64>, source: &Run<u64>) -> result: unit writes(target), writes(source) {
  doc "Specialized scalar control for the generic run swap.";
  for (s in 0_u64..source^.len) {
    if s < target^.len {
      swap(first: &target^[s], second: &source^[s]);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Compare Paged and Slots permissions with the same literal gather, noncopy-field and swap results.";
  let reduced = box_array_filled::<u64>(count: 8_u64, value: 53_u64);
  let paged_ranks = make_paged_values(value: 3_u64);
  let paged_values = make_paged_values(value: 0_u64);
  let paged = PagedPair(ranks: move paged_ranks, values: move paged_values);
  let slots_ranks = make_slots_values(value: 3_u64);
  let slots_values = make_slots_values(value: 0_u64);
  let slots = SlotsPair(ranks: move slots_ranks, values: move slots_values);
  gather_paged(store: &paged, reduced: &reduced.inner[0_u64..8_u64]);
  gather_slots(store: &slots, reduced: &reduced.inner[0_u64..8_u64]);
  let gather_paged_ok = check_paged_values(values: &paged.values, expected: 53_u64);
  let gather_slots_ok = check_slots_values(values: &slots.values, expected: 53_u64);
  let gathers_ok = band(gather_paged_ok, gather_slots_ok);
  let paged_cells = make_paged_cells(value: 0_u64);
  let slots_cells = make_slots_cells(value: 0_u64);
  write_paged_cells(cells: &paged_cells, reduced: &reduced.inner[0_u64..8_u64]);
  write_slots_cells(cells: &slots_cells, reduced: &reduced.inner[0_u64..8_u64]);
  let helper_paged_ok = check_paged_cells(values: &paged_cells, expected: 53_u64);
  let helper_slots_ok = check_slots_cells(values: &slots_cells, expected: 53_u64);
  let helpers_ok = band(helper_paged_ok, helper_slots_ok);
  direct_paged_cells(cells: &paged_cells);
  direct_slots_cells(cells: &slots_cells);
  let direct_paged_ok = check_paged_cells(values: &paged_cells, expected: 62_u64);
  let direct_slots_ok = check_slots_cells(values: &slots_cells, expected: 62_u64);
  let directs_ok = band(direct_paged_ok, direct_slots_ok);
  let first = make_paged_values(value: 11_u64);
  let second = make_paged_values(value: 29_u64);
  let first_count = first.inner.len;
  let second_count = second.inner.len;
  swap_runs::<u64>(target: &first.inner[0_u64..first_count], source: &second.inner[0_u64..second_count]);
  let generic_first_ok = check_paged_values(values: &first, expected: 29_u64);
  let generic_second_ok = check_paged_values(values: &second, expected: 11_u64);
  let generic_ok = band(generic_first_ok, generic_second_ok);
  let refreshed_first_count = first.inner.len;
  let refreshed_second_count = second.inner.len;
  swap_runs_u64(target: &first.inner[0_u64..refreshed_first_count], source: &second.inner[0_u64..refreshed_second_count]);
  let scalar_first_ok = check_paged_values(values: &first, expected: 11_u64);
  let scalar_second_ok = check_paged_values(values: &second, expected: 29_u64);
  let scalar_ok = band(scalar_first_ok, scalar_second_ok);
  let paged_other = make_paged_cells(value: 7_u64);
  let paged_cell_count = paged_cells.inner.len;
  let paged_other_count = paged_other.inner.len;
  swap_runs::<Cell>(target: &paged_cells.inner[0_u64..paged_cell_count], source: &paged_other.inner[0_u64..paged_other_count]);
  let cell_first_ok = check_paged_cells(values: &paged_cells, expected: 7_u64);
  let cell_second_ok = check_paged_cells(values: &paged_other, expected: 62_u64);
  let cell_swap_ok = band(cell_first_ok, cell_second_ok);
  let slots_other = make_slots_cells(value: 7_u64);
  let slots_cell_count = slots_cells.inner.len;
  let slots_other_count = slots_other.inner.len;
  swap_slices::<Cell>(target: &slots_cells.inner[0_u64..slots_cell_count], source: &slots_other.inner[0_u64..slots_other_count]);
  let slice_first_ok = check_slots_cells(values: &slots_cells, expected: 7_u64);
  let slice_second_ok = check_slots_cells(values: &slots_other, expected: 62_u64);
  let slice_swap_ok = band(slice_first_ok, slice_second_ok);
  let updates_ok = band(gathers_ok, helpers_ok);
  let fields_ok = band(updates_ok, directs_ok);
  let value_swaps_ok = band(generic_ok, scalar_ok);
  let owned_swaps_ok = band(cell_swap_ok, slice_swap_ok);
  let swaps_ok = band(value_swaps_ok, owned_swaps_ok);
  let all_ok = band(fields_ok, swaps_ok);
  if all_ok {
    let success = std::process::exit_status(code: 0_u8);
    return move success;
  } else {
    let failure = std::process::exit_status(code: 1_u8);
    return move failure;
  }
}
