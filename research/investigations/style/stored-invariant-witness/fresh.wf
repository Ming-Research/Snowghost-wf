struct Order {
  rank: u32;
  count: u32;
  invariant bounded(o): o.rank <= o.count;
}

fn gap(o: Order) -> r: u32 pure {
  return o.count - o.rank;
}

fn main() -> status: std::process::ExitStatus pure {
  let o = Order(rank: 0_u32, count: 0_u32);
  let r = gap(o: o);
  return std::process::exit_status(code: 0_u8);
}
