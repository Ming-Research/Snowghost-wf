alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Id {
  index: u64;
}

struct Context {
  first: Option<Id>;
  second: Option<Id>;
}

struct Item {
  kind: u64;
  start: u64;
  end: u64;
}

struct Items {
  list: Box<Array<Item>>;
}

struct Words {
  list: Box<Array<u64>>;
}

fn test_with(items: &Items, words: &Words, keys: &Words, table: &[u64], at: u64, id: Id, context: Context) -> result: Bool reads(items), reads(words), reads(keys), reads(table) {
  doc "One simple test of the chain: kind 9 runs a nested range through step_with and negates it, kind 7 reads the table's length, kind 8 compares the context's first id, and every other kind compares a word with the id's key.";
  let count = items^.list.inner.len;
  if at < count {
  } else {
    return False();
  }
  let item = items^.list.inner[at];
  if item.kind == 9_u64 {
    let inner = step_with(items: items, words: words, keys: keys, table: table, start: item.start, end: item.end, id: id, context: context);
    let negated = bnot(inner);
    return negated;
  }
  if item.kind == 7_u64 {
    let length = table^.len;
    let some = length > 0_u64;
    return some;
  }
  if item.kind == 8_u64 {
    match context.first {
      Some(value: first) => {
        let same_id = first.index == id.index;
        return same_id;
      }
      None() => {
        return False();
      }
    }
  }
  let word_at = item.start;
  let key_at = id.index;
  if word_at < words^.list.inner.len {
  } else {
    return False();
  }
  if key_at < keys^.list.inner.len {
  } else {
    return False();
  }
  let word = words^.list.inner[word_at];
  let key = keys^.list.inner[key_at];
  let same = word == key;
  return same;
}

fn step_with(items: &Items, words: &Words, keys: &Words, table: &[u64], start: u64, end: u64, id: Id, context: Context) -> result: Bool reads(items), reads(words), reads(keys), reads(table) {
  doc "True when every item of [start, end) passes test_with, tested in order and stopping at the first failure, as compound_matches tests a compound.";
  let has_any = start < end;
  if has_any {
  } else {
    return True();
  }
  for (at in start..end) {
    let ok = test_with(items: items, words: words, keys: keys, table: table, at: at, id: id, context: context);
    if ok {
    } else {
      return False();
    }
  }
  return True();
}

fn test_without(items: &Items, words: &Words, keys: &Words, at: u64, id: Id, context: Context) -> result: Bool reads(items), reads(words), reads(keys) {
  doc "test_with without the table: kind 7 answers False, as test_with does on an empty table.";
  let count = items^.list.inner.len;
  if at < count {
  } else {
    return False();
  }
  let item = items^.list.inner[at];
  if item.kind == 9_u64 {
    let inner = step_without(items: items, words: words, keys: keys, start: item.start, end: item.end, id: id, context: context);
    let negated = bnot(inner);
    return negated;
  }
  if item.kind == 7_u64 {
    return False();
  }
  if item.kind == 8_u64 {
    match context.first {
      Some(value: first) => {
        let same_id = first.index == id.index;
        return same_id;
      }
      None() => {
        return False();
      }
    }
  }
  let word_at = item.start;
  let key_at = id.index;
  if word_at < words^.list.inner.len {
  } else {
    return False();
  }
  if key_at < keys^.list.inner.len {
  } else {
    return False();
  }
  let word = words^.list.inner[word_at];
  let key = keys^.list.inner[key_at];
  let same = word == key;
  return same;
}

fn step_without(items: &Items, words: &Words, keys: &Words, start: u64, end: u64, id: Id, context: Context) -> result: Bool reads(items), reads(words), reads(keys) {
  doc "step_with without the table.";
  let has_any = start < end;
  if has_any {
  } else {
    return True();
  }
  for (at in start..end) {
    let ok = test_without(items: items, words: words, keys: keys, at: at, id: id, context: context);
    if ok {
    } else {
      return False();
    }
  }
  return True();
}

fn main() -> status: ExitStatus pure {
  doc "Witness of the scan-cost experiment (research/investigations/style/DESIGN.md, Where the scanning entry's extra time goes): the matcher chain's shape reduced to two mutually recursive read-only functions that thread three borrowed inputs, a small id and a small context, and in the with copy a borrowed table they only forward. Builds 256 two-item rules and 512 words, runs every rule against 4096 ids through each copy, and exits 0 when both copies count the same matches; under callgrind, the per-call instructions of step_with over step_without and of test_with over test_without are what one forwarded range reference costs on every call.";
  let blank = Item(kind: 0_u64, start: 0_u64, end: 0_u64);
  let item_list = box_array_filled::<Item>(count: 512_u64, value: blank);
  for (rule in 0_u64..256_u64) {
    let first_at = rule +wrap rule;
    let second_at = first_at +wrap 1_u64;
    let shape = iand(rule, 15_u64);
    let after = second_at +wrap 1_u64;
    let nested = shape == 5_u64;
    let reads_table = shape == 7_u64;
    let compares = Item(kind: 0_u64, start: rule, end: 0_u64);
    let first = if nested {
      give Item(kind: 9_u64, start: second_at, end: after);
    } else {
      let plain = if reads_table {
        give Item(kind: 7_u64, start: 0_u64, end: 0_u64);
      } else {
        give compares;
      }
      give plain;
    }
    let second = Item(kind: 8_u64, start: 0_u64, end: 0_u64);
    if first_at < item_list.inner.len {
      set item_list.inner[first_at] = first;
    }
    if second_at < item_list.inner.len {
      set item_list.inner[second_at] = second;
    }
  }
  let items = Items(list: move item_list);
  let word_list = box_array_filled::<u64>(count: 512_u64, value: 0_u64);
  for (at in 0_u64..512_u64) {
    if at < word_list.inner.len {
      set word_list.inner[at] = at;
    }
  }
  let words = Words(list: move word_list);
  let key_list = box_array_filled::<u64>(count: 4096_u64, value: 0_u64);
  for (at in 0_u64..4096_u64) {
    let key = iand(at, 511_u64);
    if at < key_list.inner.len {
      set key_list.inner[at] = key;
    }
  }
  let keys = Words(list: move key_list);
  let none = array_filled::<u64, 1>(value: 0_u64);
  let with_count = 0_u64;
  for (index in 0_u64..4096_u64) {
    let id = Id(index: index);
    let first_id = Some<Id>(value: id);
    let no_id = None<Id>();
    let context = Context(first: first_id, second: no_id);
    for (rule in 0_u64..256_u64) {
      let start = rule +wrap rule;
      let end = start +wrap 2_u64;
      let matched = step_with(items: &items, words: &words, keys: &keys, table: &none[0_u64..0_u64], start: start, end: end, id: id, context: context);
      if matched {
        let advanced = with_count +wrap 1_u64;
        set with_count = advanced;
      }
    }
  }
  let without_count = 0_u64;
  for (index in 0_u64..4096_u64) {
    let id = Id(index: index);
    let first_id = Some<Id>(value: id);
    let no_id = None<Id>();
    let context = Context(first: first_id, second: no_id);
    for (rule in 0_u64..256_u64) {
      let start = rule +wrap rule;
      let end = start +wrap 2_u64;
      let matched = step_without(items: &items, words: &words, keys: &keys, start: start, end: end, id: id, context: context);
      if matched {
        let advanced = without_count +wrap 1_u64;
        set without_count = advanced;
      }
    }
  }
  if with_count == without_count {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
