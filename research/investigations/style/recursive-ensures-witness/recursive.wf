fn halves(n: u64) -> total: u64 pure contract {
  ensures total <= n;
} {
  if n <= 1_u64 {
    return n;
  }
  let half = n / 2_u64;
  let rest = n - half;
  let a = halves(n: half);
  let b = halves(n: rest);
  let total = a + b;
  return total;
}

fn main() -> status: std::process::ExitStatus pure {
  let t = halves(n: 8_u64);
  return std::process::exit_status(code: 0_u8);
}
