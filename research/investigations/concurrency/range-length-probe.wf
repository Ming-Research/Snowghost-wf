alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn same_length(first: &[u32], second: &[u64]) -> total: u64 reads(first.len), reads(second.len) contract {
  requires first^.len == second^.len;
} {
  doc "Requires its two ranges to be equally long.";
  let sum = first^.len +wrap second^.len;
  return sum;
}

fn probe(low: u64, high: u64) -> total: u64 pure {
  doc "Forms two ranges with the same bounds over two arrays and passes them to same_length. whitefootc rejects the call with FN-8 UndischargedCallRequirement, disposition Unproved, although both lengths are high - low; a proved `invariant equal: first^.len == second^.len;` before the call does not change that. It accepts the call when both ranges start at 0_u64 instead of low, and when same_length requires first^.len <= second^.len and first^.len >= second^.len instead of the equality.";
  let a = box_array_filled::<u32>(count: 16_u64, value: 0_u32);
  let b = box_array_filled::<u64>(count: 16_u64, value: 0_u64);
  let ordered = low <= high;
  let inside = high <= 16_u64;
  let located = band(ordered, inside);
  if located {
  } else {
    return 0_u64;
  }
  let first = &a.inner[low..high];
  let second = &b.inner[low..high];
  let got = same_length(first: first, second: second);
  return got;
}

fn main() -> status: ExitStatus pure {
  let total = probe(low: 3_u64, high: 9_u64);
  let code = cvt.wrap::<u64, u8>(total);
  return exit_status(code: code);
}
