alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum MathNode<L: copy> {
  Leaf(value: L);
  Min(left: u32, right: u32);
}

struct LengthMath<L: copy> {
  nodes: Box<Array<MathNode<L>>>;
  root: u32;
  invariant valid_root(v): v.root < v.nodes.inner.len;
  invariant(v): forall left(k in 0_u64..v^.nodes.inner.len): v^.nodes.inner[k].Min.left < k;
  invariant(v): forall right(k in 0_u64..v^.nodes.inner.len): v^.nodes.inner[k].Min.right < k;
}

fn eval(value: &LengthMath<f32>, at: u32) -> result: f32 reads(value) contract {
  requires at < value^.nodes.inner.len;
} {
  match value^.nodes.inner[at] {
    Leaf(value: v) => {
      return v^;
    }
    Min(left: l, right: r) => {
      let first = eval(value: value, at: l^);
      let second = eval(value: value, at: r^);
      return fmin(first, second);
    }
  }
}

fn main() -> status: ExitStatus pure {
  let zero = MathNode<f32>::Leaf(value: 0.0_f32);
  let nodes = box_array_filled::<MathNode<f32>>(count: 3_u64, value: zero);
  let low = MathNode<f32>::Leaf(value: 10.0_f32);
  let high = MathNode<f32>::Leaf(value: 20.0_f32);
  let root = MathNode<f32>::Min(left: 0_u32, right: 1_u32);
  set nodes.inner[0_u64] = low;
  set nodes.inner[1_u64] = high;
  set nodes.inner[2_u64] = root;
  let value = LengthMath<f32>(nodes: move nodes, root: 2_u32);
  let result = eval(value: &value, at: value.root);
  let ok = feq(result, 10.0_f32);
  if ok {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
