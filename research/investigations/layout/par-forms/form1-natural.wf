struct Item {
  doc "One flex item along its line's main axis: its outer main size and the offset alignment gives it.";
  size: i32;
  position: i32;
}

struct Line {
  doc "One flex line over the ordered items first to end, end excluded, as FlexLine in renderer/layout/flex.wf.";
  first: u64;
  end: u64;
}

fn align_run(part: &[Item], origin: i32, gap: i32) -> result: unit writes(part) {
  doc "Places the items of one line one after another from origin, gap apart, as flex_align_main does for one line. Its own loop carries the running offset, a true dependency, and is not the witness.";
  let count = part^.len;
  let at = origin;
  for (k in 0_u64..count) {
    set part^[k].position = at;
    let size = part^[k].size;
    let after = at +sat size;
    set at = after +sat gap;
  }
  return unit;
}

fn align_lines(lines: &[Line], items: &[Item], origin: i32, gap: i32) -> result: unit reads(lines), writes(items) contract {
  requires forall ordered(a in 0_u64..lines^.len, b in 0_u64..lines^.len) when a < b: lines^[a].end <= lines^[b].first;
} {
  doc "Form 1, the witness loop: each iteration aligns the run of items of one line, whose endpoints are read from lines, and ordered keeps the runs of two lines apart. Mirrors the line loops of lay_out_flex in renderer/layout/flex.wf, which hand each line's run lines.inner[l].first..lines.inner[l].end to flex_resolve, flex_align_main and flex_align_cross. The guard discharges the range formation, which a range fact cannot.";
  let count = lines^.len;
  for (
    l in 0_u64..count,
    apart(i, j) {
    }
  ) {
    let first = lines^[l].first;
    let end = lines^[l].end;
    if first <= end {
      if end <= items^.len {
        align_run(part: &items^[first..end], origin: origin, gap: gap);
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Two lines over five items of sizes 10 to 50: the first line holds items 0 and 1, the second items 2 to 4. Every position is checked against the index-order result.";
  let blank = Item(size: 0_i32, position: 0_i32);
  let items = box_array_filled::<Item>(count: 5_u64, value: blank);
  set items.inner[0_u64].size = 10_i32;
  set items.inner[1_u64].size = 20_i32;
  set items.inner[2_u64].size = 30_i32;
  set items.inner[3_u64].size = 40_i32;
  set items.inner[4_u64].size = 50_i32;
  let empty = Line(first: 0_u64, end: 0_u64);
  let lines = box_array_filled::<Line>(count: 2_u64, value: empty);
  set lines.inner[0_u64] = Line(first: 0_u64, end: 2_u64);
  set lines.inner[1_u64] = Line(first: 2_u64, end: 5_u64);
  align_lines(lines: &lines.inner[0_u64..2_u64], items: &items.inner[0_u64..5_u64], origin: 100_i32, gap: 1_i32);
  if items.inner[0_u64].position != 100_i32 {
    return std::process::exit_status(code: 1_u8);
  }
  if items.inner[1_u64].position != 111_i32 {
    return std::process::exit_status(code: 2_u8);
  }
  if items.inner[2_u64].position != 100_i32 {
    return std::process::exit_status(code: 3_u8);
  }
  if items.inner[3_u64].position != 131_i32 {
    return std::process::exit_status(code: 4_u8);
  }
  if items.inner[4_u64].position != 172_i32 {
    return std::process::exit_status(code: 5_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
