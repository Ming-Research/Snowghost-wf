struct Line {
  doc "One line of a paragraph: the text positions it starts and ends at.";
  start: u32;
  end: u32;
}

fn keep_lines(lines: &Box<Slots<Line>>, kept: u64) -> result: unit writes(lines) contract {
  requires kept <= lines^.inner.len;
} {
  doc "Form 6, today's spelling: with no truncate, the lines after the first kept are taken back one at a time, in the loop-with-break shape break_lines and finish_lines in renderer/layout/inline.wf, lay_out_context in renderer/layout/box.wf and clear_column_map in renderer/layout/flow.wf use to clear to zero.";
  let length = lines^.inner.len;
  let extra = length - kept;
  for (step in 0_u64..extra) {
    let held = lines^.inner.len;
    if held <= kept {
      break;
    }
    let dropped = take_back(window: &lines^.inner);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Three lines, truncated to one and then to none; the kept line is unchanged.";
  let lines = box_slots_new::<Line>(capacity: 4_u64);
  let one = Line(start: 0_u32, end: 3_u32);
  place_back(window: &lines.inner, value: one);
  let two = Line(start: 3_u32, end: 8_u32);
  place_back(window: &lines.inner, value: two);
  let three = Line(start: 8_u32, end: 9_u32);
  place_back(window: &lines.inner, value: three);
  keep_lines(lines: &lines, kept: 1_u64);
  if lines.inner.len != 1_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if lines.inner[0_u64].end != 3_u32 {
    return std::process::exit_status(code: 2_u8);
  }
  keep_lines(lines: &lines, kept: 0_u64);
  if lines.inner.len != 0_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
