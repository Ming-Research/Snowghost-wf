struct Pending {
  doc "One fragment a line collected before its height is known: the inline box or text it belongs to and its width.";
  owner: u32;
  from: i32;
  to: i32;
}

struct Fragment {
  doc "One finished fragment: its owner, its x in the paragraph and its width.";
  owner: u32;
  x: i32;
  width: i32;
}

fn emit_fragments(pending: &[Pending], out: &Box<Slots<Fragment>>, line_x: i32) -> result: unit reads(pending), writes(out) contract {
  requires out^.inner.len + pending^.len <= out^.inner.cap;
} {
  doc "Form 5, the dependent variant: each iteration still appends exactly one fragment, but places it after the fragment the previous iteration appended, reading that slot, so iteration k needs iteration k - 1's result. It must stay refused.";
  let base = out^.inner.len;
  let count = pending^.len;
  for (
    k in 0_u64..count,
    invariant filled: out^.inner.len == base + k
  ) {
    let item = pending^[k];
    let width = item.to -sat item.from;
    let length = out^.inner.len;
    let x = if length > base {
      let last = length - 1_u64;
      let before = out^.inner[last];
      give before.x +sat before.width;
    } else {
      give line_x;
    }
    let made = Fragment(owner: item.owner, x: x, width: width);
    place_back(window: &out^.inner, value: made);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Widths 5, 2 and 9 from x 100: in index order the fragments start at 100, 105 and 107.";
  let none = Pending(owner: 0_u32, from: 0_i32, to: 0_i32);
  let pending = box_array_filled::<Pending>(count: 3_u64, value: none);
  set pending.inner[0_u64] = Pending(owner: 7_u32, from: 0_i32, to: 5_i32);
  set pending.inner[1_u64] = Pending(owner: 8_u32, from: 10_i32, to: 12_i32);
  set pending.inner[2_u64] = Pending(owner: 9_u32, from: 20_i32, to: 29_i32);
  let out = box_slots_new::<Fragment>(capacity: 4_u64);
  emit_fragments(pending: &pending.inner[0_u64..3_u64], out: &out, line_x: 100_i32);
  if out.inner.len != 3_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if out.inner[0_u64].x != 100_i32 {
    return std::process::exit_status(code: 2_u8);
  }
  if out.inner[1_u64].x != 105_i32 {
    return std::process::exit_status(code: 3_u8);
  }
  if out.inner[2_u64].x != 107_i32 {
    return std::process::exit_status(code: 4_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
