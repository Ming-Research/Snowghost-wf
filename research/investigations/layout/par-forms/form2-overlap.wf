struct Pending {
  doc "One fragment a line collected before its height is known: the inline box or text it belongs to and its horizontal extent on the line.";
  owner: u32;
  from: i32;
  to: i32;
}

struct Fragment {
  doc "One finished fragment: its owner, its x in the paragraph and its width.";
  owner: u32;
  x: i32;
  width: i32;
}

struct Span {
  doc "Where one line's fragments come from and go: its pending fragments start at source, and its finished ones fill out from first to end, end excluded.";
  source: u64;
  first: u64;
  end: u64;
}

fn place_lines(spans: &[Span], pending: &[Pending], out: &[Fragment], line_x: i32) -> result: unit reads(spans), reads(pending), writes(out) contract {
  requires forall sorted(a in 0_u64..spans^.len, b in 0_u64..spans^.len) when a < b: spans^[a].first <= spans^[b].first;
} {
  doc "Form 2, the overlapping variant: the same loop as form2-natural, but sorted only orders the lines' first offsets, so a line's output may run into the next line's and two iterations may write one fragment. It must stay refused.";
  let count = spans^.len;
  for (
    l in 0_u64..count,
    apart(i, j) {
    }
  ) {
    let source = spans^[l].source;
    let first = spans^[l].first;
    let end = spans^[l].end;
    for (slot in first..end) {
      let offset = slot - first;
      let from = source +sat offset;
      if from < pending^.len {
        if slot < out^.len {
          let item = pending^[from];
          let x = line_x +sat item.from;
          let width = item.to -sat item.from;
          set out^[slot] = Fragment(owner: item.owner, x: x, width: width);
        }
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The first line fills out 0 to 2 from pending 3 to 5, the second out 2 to 4 from pending 0 to 2, so both write out 2. In line order the second line writes it last, with pending 0; overlapped iterations could leave the first line's fragment of pending 5.";
  let none = Pending(owner: 0_u32, from: 0_i32, to: 0_i32);
  let pending = box_array_filled::<Pending>(count: 6_u64, value: none);
  set pending.inner[0_u64] = Pending(owner: 0_u32, from: 0_i32, to: 5_i32);
  set pending.inner[1_u64] = Pending(owner: 1_u32, from: 10_i32, to: 15_i32);
  set pending.inner[2_u64] = Pending(owner: 2_u32, from: 20_i32, to: 25_i32);
  set pending.inner[3_u64] = Pending(owner: 3_u32, from: 30_i32, to: 35_i32);
  set pending.inner[4_u64] = Pending(owner: 4_u32, from: 40_i32, to: 45_i32);
  set pending.inner[5_u64] = Pending(owner: 5_u32, from: 50_i32, to: 55_i32);
  let empty = Span(source: 0_u64, first: 0_u64, end: 0_u64);
  let spans = box_array_filled::<Span>(count: 2_u64, value: empty);
  set spans.inner[0_u64] = Span(source: 3_u64, first: 0_u64, end: 3_u64);
  set spans.inner[1_u64] = Span(source: 0_u64, first: 2_u64, end: 5_u64);
  let blank = Fragment(owner: 9_u32, x: 0_i32, width: 0_i32);
  let out = box_array_filled::<Fragment>(count: 5_u64, value: blank);
  place_lines(spans: &spans.inner[0_u64..2_u64], pending: &pending.inner[0_u64..6_u64], out: &out.inner[0_u64..5_u64], line_x: 1000_i32);
  if out.inner[0_u64].owner != 3_u32 {
    return std::process::exit_status(code: 1_u8);
  }
  if out.inner[1_u64].owner != 4_u32 {
    return std::process::exit_status(code: 2_u8);
  }
  if out.inner[2_u64].owner != 0_u32 {
    return std::process::exit_status(code: 3_u8);
  }
  if out.inner[3_u64].owner != 1_u32 {
    return std::process::exit_status(code: 4_u8);
  }
  if out.inner[4_u64].owner != 2_u32 {
    return std::process::exit_status(code: 5_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
