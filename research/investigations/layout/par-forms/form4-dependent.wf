struct Counts {
  doc "What one child's update counted: contexts and paragraphs laid out, and flow entries visited.";
  contexts: u64;
  paragraphs: u64;
  entries: u64;
}

fn sum_scalars(results: &[Counts]) -> counts: Counts reads(results) {
  doc "Form 4 with scalar accumulators, the dependent variant: entries adds the running contexts total after each child, so its contribution reads another accumulator's partial value and depends on iteration order. It must stay refused.";
  let count = results^.len;
  let contexts = 0_u64;
  let paragraphs = 0_u64;
  let entries = 0_u64;
  for (k in 0_u64..count) {
    let got = results^[k];
    set contexts = contexts +sat got.contexts;
    set paragraphs = paragraphs +sat got.paragraphs;
    set entries = entries +sat contexts;
  }
  return Counts(contexts: contexts, paragraphs: paragraphs, entries: entries);
}

fn sum_fields(results: &[Counts]) -> counts: Counts reads(results) {
  doc "Form 4 with one record accumulator, the dependent variant: total.entries adds the running total.contexts, another field's partial value. It must stay refused.";
  let count = results^.len;
  let total = Counts(contexts: 0_u64, paragraphs: 0_u64, entries: 0_u64);
  for (k in 0_u64..count) {
    let got = results^[k];
    set total.contexts = total.contexts +sat got.contexts;
    set total.paragraphs = total.paragraphs +sat got.paragraphs;
    set total.entries = total.entries +sat total.contexts;
  }
  return total;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Contexts 1, 2 and 3: in index order the running totals are 1, 3 and 6, so entries is 10; another order or grouping of the iterations gives another value.";
  let zero = Counts(contexts: 0_u64, paragraphs: 0_u64, entries: 0_u64);
  let results = box_array_filled::<Counts>(count: 3_u64, value: zero);
  set results.inner[0_u64] = Counts(contexts: 1_u64, paragraphs: 4_u64, entries: 7_u64);
  set results.inner[1_u64] = Counts(contexts: 2_u64, paragraphs: 5_u64, entries: 8_u64);
  set results.inner[2_u64] = Counts(contexts: 3_u64, paragraphs: 6_u64, entries: 9_u64);
  let scalars = sum_scalars(results: &results.inner[0_u64..3_u64]);
  if scalars.contexts != 6_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if scalars.paragraphs != 15_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if scalars.entries != 10_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  let fields = sum_fields(results: &results.inner[0_u64..3_u64]);
  if fields.contexts != 6_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  if fields.paragraphs != 15_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  if fields.entries != 10_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
