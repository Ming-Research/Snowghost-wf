const no_index: u32 = 4294967295_u32;

enum Flow {
  Open(block: u32);
}

struct Block {
  entries: Box<Paged<Flow>>;
  entry_slot: u32;
  parent: u32;
  normal_y: i32;
}

struct Context {
  order: Box<Paged<Flow>>;
  blocks: Box<Slots<Block>>;
  invariant(c): forall root_bounds(k in 0_u64..c^.order.inner.len): c^.order.inner[k].Open.block < c^.blocks.inner.len;
  invariant(c): forall root_inverse(k in 0_u64..c^.order.inner.len): c^.blocks.inner[c^.order.inner[k].Open.block].entry_slot == k, c^.blocks.inner[c^.order.inner[k].Open.block].parent == no_index;
}

fn relocate_borrowed(fresh: &Context, destination_slot: u32) -> result: unit writes(fresh.blocks.inner) contract {
  requires fresh^.order.inner.len == 1_u64;
  requires fresh^.blocks.inner.len == 1_u64;
  requires destination_slot > 0_u32;
} {
  doc "The private root remains live at slot zero while its Block is rebased for a later destination slot. This is the genuinely invalid source-Context exit in the current borrowed relocation boundary, rather than a sound writer whose preservation proof was lost.";
  set fresh^.blocks.inner[0_u64].entry_slot = destination_slot;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
