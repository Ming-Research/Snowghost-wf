struct Block {
  entry_slot: u32;
}

enum Flow {
  Open(block: u32);
}

struct SequenceCursor {
  live: Bool;
}

struct SequenceNode {
  links: SequenceCursor;
}

struct EntrySequence {
  payloads: Box<Paged<Flow>>;
  nodes: Box<Paged<SequenceNode>>;
}

struct Context {
  order: EntrySequence;
  targets: Box<Slots<Block>>;
  invariant(c): forall inv(k in 0_u64..c^.order.payloads.inner.len) when k < c^.order.nodes.inner.len, c^.order.nodes.inner[k].links.live == True(), c^.order.payloads.inner[k].Open.block < c^.targets.inner.len: c^.targets.inner[c^.order.payloads.inner[k].Open.block].entry_slot == k;
}

fn preserve(c: &Context) -> result: unit reads(c) {
  doc "Tests the same Boolean liveness guard written as equality with True, without adding a truth field or changing storage.";
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
