// Semantic witness for the directory/element separation gap.
// Acceptance and current unverified compilation status: MECHANISM.md.
struct Cell {
  x: u64;
  y: u64;
}

fn touch(p: &Box<Paged<Cell>>, at: u64, x: u64, y: u64) -> result: unit writes(p) {
  if at < p^.inner.len {
    set p^.inner[at].x = x;
    set p^.inner[at].y = y;
  }
  return unit;
}
