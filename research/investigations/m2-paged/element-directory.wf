// Semantic witness for the directory/element separation gap.
// Acceptance: check-element-directory.py and the paged-alias-check CI job.
struct Cell {
  x: u64;
  y: u64;
}

fn touch(p: &Box<Paged<Cell>>, at: u64, x: u64, y: u64) -> result: unit writes(p) {
  if at < p^.inner.len {
    set p^.inner[at].x = x;
    set p^.inner[at].y = y;
  }
  return unit;
}

// Growth may replace the directory cell, while preserving existing elements.
// The second lookup must use the current directory after that write.
fn touch_grow(p: &Box<Paged<Cell>>, at: u64, x: u64, y: u64, capacity: u64) -> result: unit writes(p) contract {
  requires capacity >= p^.inner.cap;
} {
  if at < p^.inner.len {
    set p^.inner[at].x = x;
    grow_paged(cell: p, capacity: capacity);
    set p^.inner[at].y = y;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let p = box_paged_new::<Cell>(capacity: 1_u64);
  let first = Cell(x: 0_u64, y: 0_u64);
  place_back(window: &p.inner, value: first);
  touch(p: &p, at: 0_u64, x: 1_u64, y: 2_u64);
  if p.inner.cap <= 257_u64 {
    touch_grow(p: &p, at: 0_u64, x: 3_u64, y: 4_u64, capacity: 257_u64);
  }
  return std::process::exit_status(code: 0_u8);
}
