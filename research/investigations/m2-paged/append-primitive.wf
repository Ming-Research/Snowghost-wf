struct Block {
  entry_slot: u32;
}

enum Flow {
  Open(block: u32);
}

struct Context {
  order: Box<Paged<Flow>>;
  targets: Box<Slots<Block>>;
  invariant(c): forall inverse(k in 0_u64..c^.order.inner.len): c^.order.inner[k].Open.block < c^.targets.inner.len, c^.targets.inner[c^.order.inner[k].Open.block].entry_slot == k;
}

fn append_target(c: &Context, value: Block, capacity: u64) -> result: unit writes(c.targets) contract {
  requires forall existing(k in 0_u64..c^.order.inner.len): c^.order.inner[k].Open.block < c^.targets.inner.len;
  requires capacity >= c^.targets.inner.cap;
  requires capacity > c^.targets.inner.len;
  requires capacity <= 1073741824_u64;
} {
  grow(cell: &c^.targets, capacity: capacity);
  place_back(window: &c^.targets.inner, value: value);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
